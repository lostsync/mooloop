#!/usr/bin/env bash
# Print a release's notes as Markdown: its curated section of CHANGELOG.md,
# or the commits since the previous release tag.
#
#   scripts/release-notes --changelog v0.1.5   # CHANGELOG.md's `## 0.1.5` section
#   scripts/release-notes            # commits: HEAD against the latest tag, a preview
#   scripts/release-notes v0.1.5     # commits v0.1.5 has that the tag before it lacks
#
# The release workflow publishes the CHANGELOG.md section as the GitHub
# Release's text and as `mooloop-<version>-CHANGELOG.md`, and the commit list
# as `mooloop-<version>-commits.md` (MOO-265).
#
# `--changelog` prints from the `## <version>` heading (a leading `v` is
# dropped, so a tag name works) up to the next `## ` heading, less the blank
# lines before that heading. It fails, and says why, if CHANGELOG.md has no
# such section or if the section's heading still says "unreleased": date the
# heading before tagging. It reads CHANGELOG.md at the top of the working
# tree, which in the workflow is the tagged commit.
#
# The commit list exists because GitHub's generated notes list pull
# requests, and most of this project's commits land on main without one:
# v0.1.4's listed 7 pull requests for 347 commits.
#
# Commits are grouped by their conventional-commit type (`feat(ui): ...`):
# features, fixes and performance are listed; everything else (docs, reports,
# refactors, CI, and subjects with no type) is folded under "Other changes".
# Merge commits are left out, because the commits they bring in are listed
# themselves. The previous release is the nearest `vX.Y.Z` tag strictly before
# the one named; with none, every commit is listed.
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  awk 'NR>1 && !/^#/ { exit } NR>1 { sub(/^# ?/, ""); print }' "$0"
  exit 0
fi

if [[ "${1:-}" == "--changelog" ]]; then
  version="${2:?release-notes: --changelog needs a version, such as v0.1.5}"
  version="${version#v}"
  changelog="$(git rev-parse --show-toplevel)/CHANGELOG.md"
  if [[ ! -f "$changelog" ]]; then
    echo "release-notes: no CHANGELOG.md at $changelog" >&2
    exit 1
  fi
  # The heading is `## <version>` alone or followed by a space (`## 0.1.4 —
  # 2026-09-18`), so 0.1.1 never matches 0.1.10. `### ` subheadings stay in.
  # Blank lines are held back and printed only before more text, which drops
  # the ones between the section and the next heading.
  section="$(awk -v want="## $version" '
    /^## / {
      if (found) exit
      if ($0 == want || index($0, want " ") == 1) found = 1
    }
    found {
      if ($0 == "") { blanks++; next }
      for (; blanks > 0; blanks--) print ""
      print
    }
  ' "$changelog")"
  if [[ -z "$section" ]]; then
    echo "release-notes: CHANGELOG.md has no '## $version' section. Write one, dated, before tagging." >&2
    exit 1
  fi
  heading="${section%%$'\n'*}"
  if [[ "${heading,,}" == *unreleased* ]]; then
    echo "release-notes: CHANGELOG.md's heading for $version still says unreleased:" >&2
    echo "  $heading" >&2
    echo "Date it (## $version — YYYY-MM-DD) and commit that before tagging." >&2
    exit 1
  fi
  printf '%s\n' "$section"
  exit 0
fi

ref="${1:-HEAD}"
if ! git rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
  echo "release-notes: no such commit: $ref" >&2
  exit 2
fi

previous="$(git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' "$ref^" 2>/dev/null || true)"
range="$ref"
[[ -n "$previous" ]] && range="$previous..$ref"

features=()
fixes=()
performance=()
other=()

# `<` would open an HTML tag in GitHub's Markdown and swallow the rest of the
# line; nothing else in a commit subject needs escaping to read correctly.
# (sed rather than `${x//</&lt;}`, because bash 5.2 expands a `&` in the
# replacement to the matched text.)
escape() {
  printf '%s' "$1" | sed 's/</\&lt;/g'
}

conventional='^([A-Za-z]+)(\(([^)]*)\))?!?: (.*)$'
while IFS=$'\t' read -r sha subject; do
  if [[ "$subject" =~ $conventional ]]; then
    type="$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]')"
    scope="${BASH_REMATCH[3]}"
    text="${BASH_REMATCH[4]}"
  else
    type=""
    scope=""
    text="$subject"
  fi
  line="- "
  [[ -n "$scope" ]] && line+="**$(escape "$scope"):** "
  line+="$(escape "$text") ($sha)"
  case "$type" in
    feat) features+=("$line") ;;
    fix) fixes+=("$line") ;;
    perf) performance+=("$line") ;;
    *)
      # An unconventional subject keeps its own wording, type and all.
      [[ -n "$type" ]] && line="- $(escape "$subject") ($sha)"
      other+=("$line")
      ;;
  esac
done < <(git log --no-merges --format='%h%x09%s' "$range")

total=$(( ${#features[@]} + ${#fixes[@]} + ${#performance[@]} + ${#other[@]} ))
if [[ -n "$previous" ]]; then
  echo "$total commits since $previous."
else
  echo "$total commits."
fi

section() {
  local title="$1"
  shift
  [[ $# -eq 0 ]] && return 0
  printf '\n## %s\n\n' "$title"
  printf '%s\n' "$@"
}

section "Features" "${features[@]+"${features[@]}"}"
section "Fixes" "${fixes[@]+"${fixes[@]}"}"
section "Performance" "${performance[@]+"${performance[@]}"}"

if [[ ${#other[@]} -gt 0 ]]; then
  printf '\n<details>\n<summary>Other changes (%d)</summary>\n\n' "${#other[@]}"
  printf '%s\n' "${other[@]}"
  printf '\n</details>\n'
fi
