#!/usr/bin/env bash
set -euo pipefail

if ! command -v gh >/dev/null; then
  echo "GitHub CLI (gh) is required: https://cli.github.com/" >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Commit or stash local changes before requesting a remote RPM build." >&2
  exit 1
fi

RPM_BRANCH="$(git branch --show-current)"
if [[ -z "$RPM_BRANCH" ]]; then
  echo "A checked-out branch is required to request a remote RPM build." >&2
  exit 1
fi

git fetch origin "$RPM_BRANCH" >/dev/null

RPM_LOCAL_SHA="$(git rev-parse HEAD)"
RPM_REMOTE_SHA="$(git rev-parse "origin/$RPM_BRANCH")"
if [[ "$RPM_LOCAL_SHA" != "$RPM_REMOTE_SHA" ]]; then
  echo "Push $RPM_BRANCH before requesting a remote RPM build." >&2
  exit 1
fi

RPM_REPOSITORY="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
RPM_REQUEST_ID="local-$(date -u +%Y%m%dT%H%M%SZ)-$$"

gh workflow run build-rpm.yml \
  --repo "$RPM_REPOSITORY" \
  --ref "$RPM_BRANCH" \
  -f "request_id=$RPM_REQUEST_ID"

echo "Waiting for GitHub to create the RPM build..."
RPM_RUN_ID=""
for _ in {1..60}; do
  RPM_RUN_ID="$(gh run list \
    --repo "$RPM_REPOSITORY" \
    --workflow build-rpm.yml \
    --branch "$RPM_BRANCH" \
    --event workflow_dispatch \
    --limit 20 \
    --json databaseId,displayTitle \
    --jq ".[] | select(.displayTitle == \"Build RPM ($RPM_REQUEST_ID)\") | .databaseId" \
    | head -n 1)"
  if [[ -n "$RPM_RUN_ID" ]]; then
    break
  fi
  sleep 2
done

if [[ -z "$RPM_RUN_ID" ]]; then
  echo "GitHub did not expose the requested workflow run within two minutes." >&2
  exit 1
fi

gh run watch "$RPM_RUN_ID" --repo "$RPM_REPOSITORY" --exit-status

RPM_OUTPUT_DIR=".tmp/rpm/$RPM_LOCAL_SHA-$RPM_RUN_ID"
mkdir -p "$RPM_OUTPUT_DIR"
gh run download "$RPM_RUN_ID" \
  --repo "$RPM_REPOSITORY" \
  --name mooloop-rpm \
  --dir "$RPM_OUTPUT_DIR"

echo "RPM downloaded to $RPM_OUTPUT_DIR"
