#!/usr/bin/env bash
# Turn the current edit into a running application, in one command.
#
#   scripts/mooloop-run                 # dev build on the box, run it here
#   scripts/mooloop-run --release       # release build instead
#   scripts/mooloop-run --local         # skip the box; build on this machine
#   scripts/mooloop-run -- --some-flag  # everything after -- goes to mooloop
#
# The build happens on the remote box because this laptop has 15 GB and a
# `mooloop-ui` build needs 3.2-3.4 GB in a single rustc process; the run
# happens here because this is where JACK and the audio interface are.
#
# The dev profile is the default because it is arranged to be playable:
# opt-level = 1 workspace-wide keeps mooloop-dsp and mooloop-engine meeting
# JACK deadlines, and only mooloop-ui drops to 0, where optimising Slint's
# generated glue buys nothing. Reach for --release to judge performance.
#
# The box is not mandatory. If it is unreachable, full, or busy, this falls
# back to building locally under `scripts/cargo-capped` rather than failing --
# slower, but never a dead end.
set -euo pipefail

cd "$(dirname "$0")/.."

PROFILE=dev
LOCAL=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --release) PROFILE=release; shift ;;
    --dev) PROFILE=dev; shift ;;
    --local) LOCAL=1; shift ;;
    -h|--help)
      awk 'NR>1 && !/^#/ { exit } NR>1 { sub(/^# ?/, ""); print }' "$0"
      exit 0
      ;;
    --) shift; break ;;
    *) echo "mooloop-run: unknown option $1" >&2; exit 2 ;;
  esac
done

if [[ "$PROFILE" == release ]]; then
  BIN="bin/mooloop-test"
  REMOTE_FLAG="--release-bin"
  LOCAL_FLAGS=(--release)
  LOCAL_BIN="target/release/mooloop"
else
  BIN="bin/mooloop-dev"
  REMOTE_FLAG="--dev-bin"
  LOCAL_FLAGS=()
  LOCAL_BIN="target/debug/mooloop"
fi

built=""
if [[ $LOCAL -eq 0 ]]; then
  if scripts/antibox "$REMOTE_FLAG"; then
    built="$BIN"
  else
    echo "mooloop-run: the box did not produce a binary; building locally" >&2
  fi
fi

if [[ -z "$built" ]]; then
  # cargo-capped keeps a local build from taking the desktop down with it.
  scripts/cargo-capped build "${LOCAL_FLAGS[@]+"${LOCAL_FLAGS[@]}"}" -p mooloop-app --bin mooloop
  built="$LOCAL_BIN"
fi

echo "mooloop-run: running $built" >&2
exec "./$built" "$@"
