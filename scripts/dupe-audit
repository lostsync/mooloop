#!/usr/bin/env python3
"""Find values and policies that have been written down more than once.

    scripts/dupe-audit                  # every check, ranked
    scripts/dupe-audit shared-constant  # one check
    scripts/dupe-audit --list           # what the checks are

This is the search that a 2026-09-10 detail pass kept re-deriving by hand.
Ten of the defects it found were one fault wearing different clothes: a
number or a rule written in two places, the copies drifting, and nothing
able to notice. Five of them had reached the screen -- a meter scale reading
`+2` where it meant `-12`, a formatter that had never produced its own
documented format, a lane that could not show the range it was editing.

**What it is not.** It does not find duplicated *formulas*. Four synths
computing `sin(2*pi*phi)` will agree forever, because a sine has no
parameters to drift. Copied arithmetic is mostly waste; copied numbers and
copied policies are what diverge silently. Every check here is aimed at the
second kind, which is why the list is short.

Expect false positives and read the output as leads rather than as findings.
Two of the checks are deliberately noisy at the edges, because the failure
that matters -- a guard that has quietly stopped guarding -- looks like
nothing at all until somebody goes and looks.
"""

from __future__ import annotations

import collections
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CRATES = ROOT / "crates"

# Lines that repeat for reasons nobody should be asked to look at.
BORING = re.compile(
    r"^\s*(\}|\{|\)|\);|\},|use |mod |pub mod |//|/\*|\*|#\[|let mut |return;|$)"
)


def rust_sources():
    for path in sorted(CRATES.glob("*/src/**/*.rs")):
        yield path


def rust_tests():
    for path in sorted(CRATES.glob("*/tests/**/*.rs")):
        yield path


def slint_sources():
    for path in sorted(CRATES.glob("*/ui/*.slint")):
        yield path


def rel(path: pathlib.Path) -> str:
    return str(path.relative_to(ROOT))


# --- 1 -----------------------------------------------------------------
def shared_constant():
    """A local `const NAME` shadowing a `pub const NAME` from a crate.

    The sharpest of these checks, and the one with a scalp. `piano_tools.rs`
    and `piano_drag.rs` each declared `const TICKS_PER_STEP: i32 = 24`
    beside a `mooloop_core` that already exported it. Those suites work by
    computing where a tick belongs on screen and clicking there, so a local
    copy made them agree with the markup *by construction*: had the engine's
    value moved, the roll would have drawn every note in the wrong place and
    both suites would have gone on passing. A test that shares the drift it
    exists to catch cannot report it.
    """
    published = {}
    for path in rust_sources():
        for match in re.finditer(
            r"^\s*pub const ([A-Z][A-Z0-9_]*)\s*:\s*[^=]+=\s*([^;]+);",
            path.read_text(),
            re.M,
        ):
            published.setdefault(match.group(1), (rel(path), match.group(2).strip()))

    hits = []
    for path in list(rust_sources()) + list(rust_tests()):
        text = path.read_text()
        for match in re.finditer(
            r"^\s*(?:pub\s+)?const ([A-Z][A-Z0-9_]*)\s*:\s*[^=]+=\s*([^;]+);", text, re.M
        ):
            name, value = match.group(1), match.group(2).strip()
            if name not in published:
                continue
            owner, owner_value = published[name]
            if owner == rel(path):
                continue
            # A copy that derives from the original is the fix, not the fault.
            if "::" in value or any(c.isalpha() for c in value.replace("_", "")):
                continue
            # Same name, different value, is two facts that happen to share a
            # word -- `PARAM_LEVEL` means one thing to DS-01 and another to
            # Aux In. Only an equal value is a copy.
            if value.rstrip("0").rstrip(".") != owner_value.rstrip("0").rstrip("."):
                continue
            # Same crate, same name, same value is usually deliberate
            # namespacing: `OSC_OFFSET_WAVE` is 0 in two device tables
            # because both count from zero. The copies that rot are the ones
            # that cross a crate, where the owner is somewhere you would have
            # to go looking.
            if rel(path).split("/")[1] == owner.split("/")[1]:
                continue
            line = text[: match.start()].count("\n") + 1
            hits.append(
                (
                    f"{rel(path)}:{line}",
                    f"{name} = {value} re-declared; {owner} publishes it as {owner_value}",
                )
            )
    return hits


# --- 2 -----------------------------------------------------------------
def repeated_line():
    """One non-trivial line, byte-identical, in three or more files.

    Found four synths computing glide with the same twelve tokens --
    `(-1.0 / (params.glide.max(MIN_GLIDE_S) * sr as f32)).exp()` -- while
    all four already imported `MIN_GLIDE_S` from the module the helper
    belongs in. The constant had been shared and the formula had not, which
    is the shape to look for: the fix is usually one function in a file
    every offender already depends on.
    """
    seen = collections.defaultdict(set)
    where = {}
    for path in rust_sources():
        for number, line in enumerate(path.read_text().split("\n"), 1):
            stripped = line.strip()
            if len(stripped) < 40 or BORING.match(line):
                continue
            # A signature repeats because several types implement one trait,
            # which is the opposite of the problem. Only statements and
            # expressions carry a value somebody had to type twice.
            if stripped.endswith("{") or stripped.startswith(("fn ", "pub fn ", "impl ")):
                continue
            # A duplicated *computation* is the target: it carries a literal
            # and does arithmetic on it. A duplicated *call* -- `self
            # .apply_param(id, value)` in sixteen devices -- is a shared
            # idiom, which is the thing working correctly.
            body = re.sub(r'"[^"]*"', "", stripped)
            if not (re.search(r"\d", body) and re.search(r"[*/+]|\s-\s", body)):
                continue
            seen[stripped].add(rel(path))
            where.setdefault(stripped, f"{rel(path)}:{number}")

    hits = []
    for line, files in seen.items():
        if len(files) >= 3:
            hits.append((len(files), where[line], f"in {len(files)} files: {line[:88]}"))
    return [hit[1:] for hit in sorted(hits, reverse=True)]


# --- 3 -----------------------------------------------------------------
def unit_spelling():
    """The same unit appended two ways in the markup.

    A readout's unit is a house convention, not a per-file choice: the Rust
    side attaches every unit with a space and `%` without one. Two faces
    spelled percent `50 %` against ninety-four writing `50%`, and one shelf
    caption said `150ms` where its own knob said `150 ms`. Minority
    spellings are reported; a minority of one, six lines from its majority,
    is how the last two were found.
    """
    counts = collections.defaultdict(collections.Counter)
    where = collections.defaultdict(dict)
    for path in slint_sources():
        for number, line in enumerate(path.read_text().split("\n"), 1):
            for match in re.finditer(r'\+\s*"(\s?)([%a-zA-Z]{1,4})"', line):
                space, unit = match.group(1), match.group(2)
                counts[unit][space] += 1
                where[unit].setdefault(space, f"{rel(path)}:{number}")

    hits = []
    for unit, spellings in counts.items():
        if len(spellings) < 2:
            continue
        ranked = spellings.most_common()
        majority, majority_n = ranked[0]
        for space, n in ranked[1:]:
            hits.append(
                (
                    n,
                    where[unit][space],
                    f'"{space}{unit}" used {n}x against "{majority}{unit}" {majority_n}x',
                )
            )
    return [hit[1:] for hit in sorted(hits)]


# --- 4 -----------------------------------------------------------------
def twin_names():
    """Two functions whose names say the same thing.

    Written for `mooloop_core::gain::linear_to_db`, which floors at -60 dB
    and whose inverse returns silence below that, and the former
    `mooloop_dsp::dynamics::lin_to_db`, which floored at 1e-9, about
    -180 dB, and whose inverse had no floor at all. A hundred and twenty
    decibels apart at silence, in crates where one depends on the other. The
    difference is deliberate -- a compressor's detector needs range a fader
    does not -- and nothing said so, which made it a trap for whoever decided
    to tidy the duplicate away. Since 2026-09-17 both pairs live in
    `gain.rs` under names that say which policy they are
    (`*_unfloored` for the detector's).

    The key sorts a name's words, so an inverse pair in one file
    (`db_to_linear`/`linear_to_db`) is reported too. Those are usually
    deliberate; the cross-crate families are the ones worth reading first.
    """
    words = {"lin": "linear", "db": "decibels", "ms": "milliseconds", "freq": "frequency",
             "amp": "amplitude", "pos": "position", "norm": "normalized", "val": "value"}

    def key(name: str) -> tuple:
        parts = [words.get(part, part) for part in name.split("_") if part]
        return tuple(sorted(parts))

    families = collections.defaultdict(list)
    for path in rust_sources():
        text = path.read_text()
        for match in re.finditer(r"^\s*(?:pub(?:\([^)]*\))?\s+)?fn ([a-z][a-z0-9_]*)\s*\(", text, re.M):
            name = match.group(1)
            if len(name) < 5:
                continue
            line = text[: match.start()].count("\n") + 1
            families[key(name)].append((name, f"{rel(path)}:{line}"))

    hits = []
    for members in families.values():
        distinct = {name for name, _ in members}
        if len(distinct) < 2:
            continue
        listed = ", ".join(f"{name} ({place})" for name, place in sorted(members))
        # Two spellings inside one file are usually a deliberate inverse
        # pair. Two that live in different crates are the ones nobody can
        # see at once, which is where a quiet disagreement survives.
        crates = {place.split("/")[1] for _, place in members}
        hits.append(
            (len(crates), len(members), sorted(members)[0][1],
             f"names agree, bodies may not: {listed}")
        )
    return [hit[2:] for hit in sorted(hits, reverse=True)]


# --- 5 -----------------------------------------------------------------
def unchecked_face():
    """A face that spells a range in markup where no test reads it back.

    A knob and an automation lane are two views of one value, and a face that
    writes its own `default-value: 0.9` has stated a number the descriptor
    table already states. `slint_face_agreement.rs` exists to hold the two
    together, and it works from a hand-written list -- for a reason it gives
    itself, that a derivation would move with whichever side it was derived
    from. A hand-written list then has a hand-written list's failure, which
    `AGENTS.md` records as recurring here: the generator faces were covered
    for months while the effect faces were not.

    The rule is *a literal in a face the test does not include*. Both halves
    matter:

    - A face the test never `include_str!`s has none of its knobs checked,
      whatever they say.
    - A `default-value: root.defaults[root.param]` is not a second copy of
      anything. That face reads the table at run time, so it cannot drift, and
      DS-01's whole paged face is built this way. Only a literal is a copy.

    A literal here is not automatically a defect -- a control that is not
    descriptor-backed at all has nowhere else for its number to live. What the
    list is for is the other kind.

    **A default is not the only number a face copies, and until 2026-09-18 it
    was the only one this looked for.** A knob states its *bounds* as well,
    and the two are written independently: `device-oscillator.slint`'s Semi
    knob reads its default from the table (`root.param-defaults[...]`, so
    nothing to drift) while spelling `minimum: -48; maximum: 48` inline --
    the same two numbers that `generator.rs` and `mlp8.rs` each held a copy
    of, with no test on any pair. Keying on `default-value:` alone made that
    face invisible here: the one property it did not copy was the one being
    searched for. So `minimum:` and `maximum:` are searched too, and every
    match on a line counts rather than the first, because these faces put a
    knob's whole control block on one line.

    Bounds are searched only inside an instantiated widget. A `minimum:` in a
    `component X inherits Y { .. }` body is the component's own travel, not a
    copy of a descriptor's -- DS-01 declares `minimum: 0; maximum: 1` because
    its paged knobs work in normalized space whatever parameter they show --
    and a lead that can never be acted on is worse than a narrow check,
    because a check that is never clean stops being read.

    **It also reports what the guard cannot reach.** The agreement test walks
    `ParameterKnob` blocks and nothing else, so a number stated by a
    `MiniKnob`, a `MixerFader` or any other widget cannot be added to it
    without widening `face_knobs`. Nothing else says so, so the detail below
    names that shape where it appears. (Until 2026-09-13 this said the test
    could only reach a knob whose binding and `default-value:` shared one
    line, which was true of the line-based parser it was written against and
    stopped being true when that parser became block-based -- the sort of
    staleness a lead message can carry for a long time unnoticed, because a
    lead is read as a hint rather than a claim.)
    """
    agreement = ROOT / "crates/mooloop-ui/tests/slint_face_agreement.rs"
    if not agreement.exists():
        return [(rel(agreement), "the face-agreement test is gone; nothing checks any face")]
    covered = set(
        re.findall(r'include_str!\("\.\./ui/([a-z0-9-]+\.slint)"\)', agreement.read_text())
    )

    # These draw no device parameter of their own: the rack, the drag harness,
    # the shared displays, the concepts sheet.
    NOT_A_FACE = {
        "device-concepts.slint",
        "device-displays.slint",
        "device-drag-harness.slint",
        "device-rack.slint",
    }

    # `default-value:` states a number the descriptor table already states;
    # `minimum:`/`maximum:` state its *range*, which the table states too. Both
    # are searched, because a face can spell a literal range while reading its
    # default from the table -- which is how `device-oscillator.slint`'s
    # -48..48 semitones stayed invisible to this check until 2026-09-18, with
    # the same numbers in two Rust tables and no test on any pair.
    literal = re.compile(r"(default-value|minimum|maximum):\s*(-?[0-9][0-9_.]*)\s*;")
    # The widget a literal sits inside: the nearest `Name {` above it. This is
    # what decides reachability, because `face_knobs` walks `ParameterKnob`
    # blocks and ignores every other widget.
    opener = re.compile(r"^\s*([A-Z][A-Za-z0-9]*)\s*\{")

    hits = []
    for path in slint_sources():
        if "device" not in path.name or path.name in NOT_A_FACE or path.name in covered:
            continue
        lines = path.read_text().splitlines()
        spelled = []
        for index, line in enumerate(lines, start=1):
            # Every match on the line, not the first: these faces put a knob's
            # whole control block on one line, so a `search` for `minimum:`
            # stops before the `maximum:` beside it and counts one copy where
            # there are two.
            matches = list(literal.finditer(line))
            if not matches:
                continue
            widget = next(
                (m.group(1) for above in reversed(lines[:index]) if (m := opener.match(above))),
                "?",
            )
            for match in matches:
                # A bound stated where no widget encloses it belongs to the
                # component being *defined*, not to an instance of one, and a
                # component's own travel is not a copy of a descriptor's: DS-01
                # declares `minimum: 0; maximum: 1` because its paged knobs
                # work in normalized space whatever parameter they are showing.
                # Reporting that every run is how a check stops being read.
                if match.group(1) != "default-value" and widget == "?":
                    continue
                spelled.append((index, match.group(2), widget))
        if not spelled:
            continue
        unreachable = sorted({w for _, _, w in spelled if w != "ParameterKnob"})
        detail = f"{len(spelled)} range(s) spelled in markup that no test reads back"
        if unreachable:
            detail += (
                f"; stated by {', '.join(unreachable)} rather than ParameterKnob, which"
                " the agreement test's block walk cannot reach as it stands"
            )
        hits.append((f"{rel(path)}:{spelled[0][0]}", detail))
    return sorted(hits, key=lambda hit: -int(hit[1].split()[0]))


# --- 6 -----------------------------------------------------------------
def one_sided_test():
    """A test named for a markup file that never reads one.

    Six faults of one shape turned up in the 2026-09-12 audit, and this is the
    only one of them a search can find. `dupe-audit`'s other checks look for a
    value written twice; this looks for the *guard* over a value written twice
    having quietly come off it.

    The instance it is built from:
    `musical_divisions_match_the_snap_table_in_main_slint` was named for
    `snap-ticks()` in `main.slint`, its comment warned that a drift "would set
    the wrong length silently", and it compared `MUSICAL_DIVISIONS` to a literal
    `[384, 192, 96, ...]` written inside the test. A third spelling of the same
    eleven numbers, in the one place whose job was to notice a second. Editing
    the markup could not have failed it.

    **A mention is not a read, and that distinction is the whole check.** The
    first version of this looked for the filename anywhere in the function and
    found nothing, because the broken test *talked about* `main.slint` in its
    own comment. So a read means the `include_str!` const for that file
    appearing in the body, or the body calling `include_str!` itself. Verified
    against `7024b2b~1`, where it reports the defect, and against the tree,
    where it reports nothing.

    Zero hits is the expected result. This is a regression guard for a fault
    class, not a lead generator -- unlike the checks above it, an empty run here
    is the answer rather than an absence of evidence.
    """
    hits = []
    for path in sorted((ROOT / "crates/mooloop-ui").rglob("*.rs")):
        text = path.read_text(errors="replace")
        consts = {
            match.group(1): match.group(2)
            for match in re.finditer(
                r'const ([A-Z0-9_]+): &str = include_str!\("\.\./ui/([a-z0-9-]+)\.slint"\)',
                text,
            )
        }
        opened = set(consts.values()) | set(
            re.findall(r'include_str!\("\.\./ui/([a-z0-9-]+)\.slint"\)', text)
        )
        for match in re.finditer(r"fn ([a-z0-9_]+)\(\)", text):
            name = match.group(1)
            named = re.search(
                r"(main|controls|gain|mixer|toolbar|strip|meters|theme|piano-grid)_slint", name
            )
            if not named:
                continue
            stem = named.group(1)
            body = _brace_body(text, match.end())
            if body is None:
                continue
            reads = any(const in body for const, owned in consts.items() if owned == stem)
            reads = reads or f'include_str!("../ui/{stem}.slint")' in body
            if reads:
                continue
            why = (
                f"the file opens {stem}.slint but this test does not read it"
                if stem in opened
                else f"nothing in this file opens {stem}.slint"
            )
            line = text[: match.start()].count("\n") + 1
            hits.append(
                (f"{rel(path)}:{line}", f"{name} is named for {stem}.slint; {why}")
            )
    return hits


# --- 7 -----------------------------------------------------------------
def bar_arithmetic():
    """Lines that mean "four beats to a bar" outside the one file allowed to.

    Written for `docs/plans/musical-time/`, whose survey found the fact
    spelled nine times across six crates and the comment *"assumes 4/4 for
    now"* written independently in three of them. `frames_per_bar`'s doc
    comment claimed it followed "the convention the buffer device already
    uses" while the buffer device spelled its own `240.0` -- prose doing the
    compiler's job. Run it against the tree at `b97561d` and it reports every
    site the plan lists; that is what it was validated on.

    Excluded by name, with the reason:

    - `crates/mooloop-core/src/time.rs` -- the home. `BEATS_PER_BAR` lives
      there and `Ticks::beat_in_bar` divides by it, so "this file may say
      four" stays a claim about one file rather than a category others can
      join.

    What it deliberately misses, because every check here misses something:

    - **Lines that say `% 4` or `/ 4` about a beat or a tick without saying
      `bar`.** The plan asked for those too; sweeping them reports
      `MidiMessage::song_position_ticks`, whose `ppq / 4` is the MIDI spec's
      sixteenth-note beat and is a *different* four -- it must not move if
      mooloop's grid does. One permanent false positive is worse than a
      narrow check, because a check that is never clean stops being read.
    - `Project::beats_per_bar`'s declaration. A field is not arithmetic; what
      makes it honest is its doc comment, which no search can judge.
    - A four reached by multiplying two other numbers, a renamed local, and
      `f64::from(BEATS_PER_BAR)` written out as `f64::from(4)`.
    - Anything inside a multi-line raw string. This reads a line at a time, so
      it strips `"..."` and `//` and cannot see that a line belongs to an
      `r#"..."#` fixture -- which is why the `beats_per_bar` rule matches Rust
      syntax rather than the bare TOML assignment those fixtures contain.
    """
    home = "crates/mooloop-core/src/time.rs"
    # A line's meaning lives in its code. Strings carry labels like "1/4 bar"
    # and comments carry "a bar of 4/4", and neither is arithmetic.
    strings = re.compile(r'"(?:[^"\\]|\\.)*"')
    comment = re.compile(r"//.*$")
    bar_word = re.compile(r"bar", re.I)
    by_four = re.compile(r"[%/]\s*4(?![0-9._])")
    magic = re.compile(r"(?<![0-9._])240(?:\.0*|_f\d+)?(?![0-9_])")
    tempo_word = re.compile(r"bpm|tempo|bar", re.I)
    per_bar_const = re.compile(
        r"const\s+([A-Z][A-Z0-9_]*_PER_BAR)\s*:[^=]+=\s*([0-9][0-9_]*(?:\.[0-9]*)?)\s*;"
    )
    named_const = re.compile(r"const\s+[A-Z0-9_]*BEATS_PER_BAR\b")
    # `.beats_per_bar != 4` is Rust holding the field to a number; a bare
    # `beats_per_bar = 4` is TOML in a format fixture, which is the contract
    # itself and is supposed to be spelled out.
    field_literal = re.compile(
        r"(?:\.beats_per_bar\s*(?:!=|==|=)|beats_per_bar\s*:)\s*4(?![0-9._])"
    )

    hits = []
    for path in list(rust_sources()) + list(rust_tests()):
        where = rel(path)
        if where == home:
            continue
        for number, raw in enumerate(path.read_text().splitlines(), 1):
            line = comment.sub("", strings.sub('""', raw)).strip()
            if not line:
                continue
            why = None
            if magic.search(line) and tempo_word.search(line):
                why = "240 is 60 * 4 beats; call mooloop_core::frames_per_bar"
            elif "rem_euclid(4)" in line:
                why = "rem_euclid(4) over beats; use BEATS_PER_BAR"
            elif by_four.search(line) and bar_word.search(line):
                why = "divides or wraps by a literal 4 on a line about bars"
            elif named_const.search(line):
                why = f"BEATS_PER_BAR is declared here; {home} owns it"
            elif field_literal.search(line):
                why = "project.beats_per_bar held to a literal 4; hold it to BEATS_PER_BAR"
            else:
                match = per_bar_const.search(line)
                if match:
                    why = (
                        f"{match.group(1)} is spelled {match.group(2)}; "
                        "derive it from BEATS_PER_BAR"
                    )
            if why:
                hits.append((f"{where}:{number}", why))
    return hits


def _brace_body(text: str, after: int) -> str | None:
    """The `{ ... }` that follows `after`, brace-matched."""
    start = text.find("{", after)
    if start == -1:
        return None
    depth = 0
    for index in range(start, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                return text[start : index + 1]
    return None


# A sixth check was written and thrown away: Rust constants whose *value*
# appears as a bare number in the markup. `TICKS_PER_STEP` really is spelled
# `24` twenty-five times in the roll, and finding that automatically would be
# worth having. But a bare number in markup carries no identity -- every
# parameter id that happens to equal 24, 60 or 100 collides with every
# unrelated 24, 60 or 100 -- and the check produced a hundred and two leads
# for the one real answer. A tool that is wrong ninety-nine times in a
# hundred does not get read the hundredth. That gap is recorded in
# `LOOSE_ENDS.md` instead, where a human sentence can say which number
# matters and why.


def popup_close_order():
    """Popup rows that close the menu before they report the choice.

    Not a duplicate: a *sequence*, and the one this interface keeps writing.
    Closing a `PopupWindow` tears down the repeater item whose handler is
    still running, so the callback after the `close()` never lands. The menu
    opens, draws correctly, and does nothing -- which is indistinguishable
    from a handler that was never wired, and costs the same half hour every
    time.

    Found four times now, each independently: `mixer.slint`'s `BusPicker`,
    `device-rack.slint`'s preset menu, `controls.slint`'s `MenuField`, and
    `channel-rack.slint`'s add-channel menu, which is MOO-53 and shipped
    High. Three of the four have a pointer-event test behind them now
    (`tests/picker_chip.rs`, `tests/effect_preset_menu.rs`,
    `tests/add_source_menu.rs`); none of them had one before it broke, and
    the add-channel menu had a *markup* test that was entirely correct about
    a menu that added no channel.

    Written before the fix, against `21524ff`, where it reports the
    add-channel menu along with the four below. A check written after its fix
    is shaped to report what its author already knows about.

    **Read the hits, do not fix them blind.** Two orderings are reported and
    only one is known to fail:

    - The row is a **repeated** one -- a `for` inside the popup -- and it
      closes first. That is the defect; report first and let `close-policy`
      or a later `close()` dismiss the menu.
    - The row is **written out**. `DeviceAddSlot`'s insert menu closes first
      and works, because there is no repeater item to tear down. It is listed
      anyway: it is one row-list refactor away from being the defect, and
      that refactor is exactly what happened to the add-channel menu.

    What it misses: a close and a callback that reach each other through a
    component boundary, where the `for` is in one file and the `close()` in
    another. `main.slint`'s `lane-menu` is that shape and is reported here
    only because its close and its callback share a handler; a menu that
    closed itself from inside a sub-component would not be seen at all.
    """
    popup = re.compile(r"([\w-]+)\s*:=\s*PopupWindow\s*\{")
    call = re.compile(r"root\.[\w-]+\s*\(")
    # Comments are blanked rather than dropped, so every offset below is
    # still an offset into the real file and the line numbers stay right.
    # `preset-menu.close()` is *written in a comment* explaining why it is not
    # written in the code, and the first version of this check reported it --
    # the fixed site, quoted back as the defect.
    comment = re.compile(r"//[^\n]*")

    hits = []
    for path in slint_sources():
        text = comment.sub(lambda m: " " * len(m.group(0)), path.read_text())
        for match in popup.finditer(text):
            name = match.group(1)
            body = balanced(text, match.start())
            repeated = re.search(r"\bfor\b[^\n]*\bin\b", body) is not None
            closer = re.compile(re.escape(name) + r"\.close\s*\(\s*\)")
            for found in closer.finditer(body):
                # The rest of the handler the close sits in: everything up to
                # the brace that ends it. A callback after that brace is a
                # different click.
                rest = balanced_tail(body, found.end())
                after = call.search(rest)
                if not after:
                    continue
                number = text.count("\n", 0, match.start() + found.start()) + 1
                shape = (
                    "a `for` in the popup"
                    if repeated
                    else "no `for` here -- read the rows' own component"
                )
                hits.append(
                    (
                        f"{rel(path)}:{number}",
                        f"{name}.close() before {rest[after.start():].strip().splitlines()[0]}"
                        f"  ({shape})",
                    )
                )
    return hits


def navigation_sends():
    """Selection handlers that reach the audio thread.

    **Looking at something is not an edit.** Selecting a pattern, a channel, a
    bus, a device or a track changes what is drawn and what the next edit will
    address; none of it changes what is scheduled, so none of it may cost a
    voice, a parameter jump or a block of work in the callback.

    That rule was broken once and it cost every sounding voice on every
    channel: `on_pattern_selected` sent `SetCurrentPattern`, which set
    `seeked`, which choked every live channel -- in Song mode, where the
    selection is not what is playing. MOO-57, and
    `docs/plans/transport-discontinuity/`.

    Written before the rename below and run against that tree, where -- with
    the allowance below removed -- it reports exactly the two handlers the
    plan predicted: `on_pattern_selected` and `on_automation_lane_selected`.
    A check written after its fix is shaped by what its author already knows
    about. The first draft matched `EngineCommand::` constructors and reported
    *nothing*, because the automation handler sends a command a session method
    built; that is what the run-it-first rule is for.

    **One send is sanctioned and is not a hit.** The active pattern is also
    the record target -- `recording_tick` reads it -- so `SetCurrentPattern`
    has to be sent, and step 01 made the engine charge for what changed rather
    than for the fact that a command arrived. So this reports a selection
    handler sending *anything else*, which is the shape the bug actually had:
    a new selection callback wired to the engine by somebody who did not know
    the rule.

    The plan expected zero hits after step 01 and a rename, which was wrong in
    a way worth recording: step 01 was an engine change and left the send in
    place, so without the allowance above `on_pattern_selected` would be a
    permanent false positive -- and a check that is never clean stops being
    read.

    What it misses: a gesture that violates the rule under a name that is not
    `on_*_selected`, and a send that reaches the channel through a helper. The
    `repeated-line` limit restated -- a rename hides a copy from a byte search
    completely.
    """
    handler = re.compile(r"window\.(on_[\w]+_selected)\s*\(")
    # Any send on the command channel, not only a literal `EngineCommand::`
    # one. `on_automation_lane_selected` hands over a command a session method
    # built -- `tx.send(command)` -- and matching constructors alone missed it
    # entirely, which is the check reporting nothing against a tree the plan
    # said had two.
    send = re.compile(r"\.send\(\s*([^,\n]+?)\s*\)")
    allowed = {
        # The record target, not a view: `recording_tick` reads it. The
        # engine charges for what changed -- see step 01.
        "on_pattern_selected": {"SetCurrentPattern"},
    }

    def named(expression):
        """The variant name where there is one, else the expression itself."""
        variant = re.match(r"(?:Engine|Structural)Command::(\w+)", expression)
        return variant.group(1) if variant else expression

    hits = []
    for path in rust_sources():
        text = path.read_text(encoding="utf-8", errors="ignore")
        for match in handler.finditer(text):
            name = match.group(1)
            body = balanced(text, text.index("{", match.end() - 1))
            sent = {named(command) for command in send.findall(body)}
            unsanctioned = sorted(sent - allowed.get(name, set()))
            if not unsanctioned:
                continue
            line = text.count("\n", 0, match.start()) + 1
            hits.append(
                (
                    f"{rel(path)}:{line}",
                    f"{name} sends {', '.join(unsanctioned)}; looking at "
                    f"something is not an edit. If it really is an edit, say "
                    f"so in the name -- `_opened`, `_armed`, `_moved` -- and "
                    f"this stops reporting it.",
                )
            )
    return hits


# --- 10 ----------------------------------------------------------------
def unrecorded_edit():
    """Callbacks whose handler edits the document without recording it.

    **An unrecorded edit is not merely un-undoable, it is destroyed.** Undo
    installs a whole-project snapshot taken when the edit it undoes happened,
    so anything that changed the document since, without reaching the
    history, is thrown away by the next Ctrl+Z with no redo path. Turn a
    filter cutoff, draw a note, undo the note: the cutoff goes too, silently,
    and nothing in the interface said it would.
    `docs/plans/gesture-undo/` is the plan that closes that, this check is
    its progress bar, and step 07 is where it reads zero.

    Written against the unfixed tree, which `AGENTS.md` asks for twice over:
    `bar-arithmetic` written first found ten sites where the survey that
    commissioned it had found eight, and `navigation-sends`' first draft
    reported *nothing* against a tree with two violations. Validated by
    running it at `4bef6dc~1`, before the eleven mixer and rack verbs were
    recorded, where it reports those eleven -- with the four transport ones
    for company, because `edits_document` arrived in that same commit. A
    version that cannot see the eleven would print a zero that meant
    nothing.

    **It resolves a callback to its handler rather than grepping a line.**
    `window.on_channel_muted(...)` is the wiring and the recording happens
    inside the closure -- often inside something the closure calls, since
    `on_channel_added` records in `add_channel_with_history` and the six step
    verbs send their commands from `UiState::apply_step_edit`. So the closure
    body is brace-matched and followed three calls deep.

    **And more callbacks are wired by a macro than by a `window.on_`.** A
    hundred and fifty of them read
    `wire_unit_param!(on_filter_cutoff_changed, filter_cutoff)`, whose
    expansion is `window.$on(...)` and which no search for `window.on_` can
    see. The first version that resolved handlers properly still reported 89
    where the tree had 176: it called the sampler's filter, every oscillator
    and every drum parameter clean, and would have gone on saying so after
    this plan had missed them. Macro bodies are indexed like functions, macro
    invocations are followed like calls, and a macro that wires through
    another macro resolves the same way.

    **A name defined twice is not followed at all.** The first draft indexed
    every `fn` by name and concatenated the duplicates, so `X::new(`
    resolved to thirty unrelated constructors at once -- one of which
    records -- and *every* rename and device parameter came back reading as
    recorded. The check reported a clean tree because it had followed itself
    into the wiring. An ambiguous name is dropped instead, which is why
    `new`, `len` and `get` cost nothing here.

    **What counts as editing the document is a send or a `mark_dirty`, and
    both are load-bearing.** A note edit reaches the audio thread; a rename
    does not reach it at all, because the name is not in the render graph, so
    a check that knew only about sends would call every rename clean. And a
    send is matched as a *send*, not as an `EngineCommand::` constructor:
    `apply_step_edit` hands over a command the session built, which is the
    same shape that made `navigation-sends`' first draft silent.

    **The four that are not edits are read from the code that declares
    them.** `EngineCommand::edits_document` (`mooloop-core/src/bridge.rs`) is
    the only copy of the transport, record-arm, monitor and seek rule, and
    finding 6 of `reports/fable-2026-09-21.md` is what a second copy cost.
    This parses that function rather than restating its list -- and the three
    audition commands below are exempted here because that same function's
    doc comment says in so many words that they belong to the set and are
    left out of it deliberately.

    Selection and view callbacks need no exemption at all, which is worth
    saying: MOO-57's rule is that looking at something is not an edit, so
    they send nothing and dirty nothing and fall out on their own. The named
    exemptions are the handlers that really do reach the document and are
    right not to record.

    What it misses: a `MainWindow` callback wired nowhere in Rust -- about a
    hundred are declared for a sub-component to invoke, and a callback with
    no handler is not an unrecorded edit; a handler that reaches the document
    through a name defined twice, per above; and the `repeated-line` limit
    restated -- this matches names, so a recorder reached under an alias is
    invisible to it.
    """
    ui = ROOT / "crates" / "mooloop-ui" / "src"

    # Every recorder. `with_gesture_history` is the general one
    # `docs/plans/gesture-undo/` step 02 adds; naming it before it exists is
    # deliberate, so this does not have to be edited by the commit that makes
    # it read zero.
    recorders = (
        "record_project_history",
        "with_project_history",
        "with_continuous_history",
        "with_gesture_history",
        "queue_project_edit",
        "queue_structural_edit",
        "queue_history_target",
    )

    # Handlers that reach the document and are right not to record.
    exempt = {
        "on_undo": "undo is how the history is read, not something in it",
        "on_redo": "redo is how the history is read, not something in it",
        "on_pattern_selected": (
            "the active pattern is also the record target, so `SetCurrentPattern`"
            " has to cross -- the one send `navigation-sends` sanctions, for the"
            " same reason and in the same words"
        ),
        "on_slice_auditioned": "auditioning a slice changes nothing that is saved",
        "on_slice_audition_released": "the release of an audition, likewise",
        "on_sampler_record_clicked": (
            "arms and starts a take; what a take changes is the recording it"
            " lands, which is recorded where it lands"
        ),
    }

    # The "not an edit" set, read from the function that declares it rather
    # than copied, plus the three the same function's doc comment says are
    # arguable members left out of it on purpose. Those three are the
    # auditions: a note played to hear it changes no saved state, so a
    # handler whose only commands are these is not an unrecorded edit.
    bridge = (CRATES / "mooloop-core" / "src" / "bridge.rs").read_text()
    at = bridge.find("pub fn edits_document")
    # A tree that has no such function has no such rule, and the check says
    # so by reporting the transport verbs rather than by carrying a list of
    # them. That is what the validation run at `4bef6dc~1` looks like: the
    # predicate arrived in `4bef6dc` itself, so the eleven mixer verbs it
    # must report come back with the four transport ones for company.
    declaring = (_brace_body(bridge, at) or "") if at >= 0 else ""
    not_an_edit = set(re.findall(r"Self::(\w+)", declaring))
    not_an_edit |= {"TriggerChannelNote", "ReleaseChannelNote", "StopTake"}

    # Two indexes, and the difference between them is what keeps this
    # honest. `helpers` is the module-level functions of `mooloop-ui`, which
    # is where a handler's recording is done for it --
    # `add_channel_with_history` records for `on_channel_added`. `owned` is
    # every method of `Session` and `UiState`, which is where a handler's
    # *editing* is done for it: the six step verbs send their commands from
    # `UiState::apply_step_edit`, and `on_record_armed_toggled` sends
    # whatever `Session::set_record_armed` returned -- only that method knows
    # it is a `SetRecordArmed` and so not an edit.
    #
    # A name defined twice is dropped rather than merged, and a call is
    # followed only where its *receiver* says which index it belongs to. The
    # two drafts that got this wrong are worth knowing about, because both
    # made the check read cleaner than the tree. Merging duplicates resolved
    # `X::new(` to thirty constructors at once, one of which records, so
    # every rename and every device parameter came back recorded. Following
    # any `.name(` resolved `window.set_source_preset_name(...)` -- a Slint
    # setter -- to `Session::set_source_preset_name`, and `.remove(` on a
    # `Vec` to a note-removal method, so pure selection handlers came back
    # sending `RemoveNote`. A receiver of `window` is markup; a receiver of
    # `st`, `state`, `guard` or `self` is ours.
    sources = {path: path.read_text() for path in sorted(ui.glob("*.rs"))}
    macros: dict[str, str | None] = {}
    for text in sources.values():
        for match in re.finditer(r"macro_rules!\s+(\w+)", text):
            found = _brace_body(text, match.end())
            if found is not None:
                macros[match.group(1)] = None if match.group(1) in macros else found
    helpers: dict[str, str | None] = {}
    for text in sources.values():
        for match in re.finditer(r"^(?:pub(?:\([\w:]+\))? )?fn ([a-z_][\w]*)\s*[(<]", text, re.M):
            found = _brace_body(text, match.end())
            if found is not None:
                helpers[match.group(1)] = None if match.group(1) in helpers else found

    owned: dict[str, str | None] = {}
    session_src = sorted((CRATES / "mooloop-session" / "src").glob("*.rs"))
    for path in list(sources) + session_src:
        text = sources.get(path) or path.read_text()
        for match in re.finditer(r"^    (?:pub(?:\([\w:]+\))? )?fn ([a-z_][\w]*)\s*[(<]", text, re.M):
            found = _brace_body(text, match.end())
            if found is not None:
                owned[match.group(1)] = None if match.group(1) in owned else found

    # A free call: not a method, not a path. A method call on something of
    # ours: `st.`, `state.`, `guard.`, `self.`, any of them through
    # `.session`. Anything else is markup, a collection, or a crate we do not
    # index, and is not followed.
    free = re.compile(r"(?<![.\w:])([a-z_][\w]*)\s*\(")
    ours = re.compile(r"\b(?:st|state|guard|self|session)(?:\.session)?\.([a-z_][\w]*)\s*\(")
    # A macro invocation, so a macro that wires through another macro is
    # followed the same way a function that calls another function is.
    invoked = re.compile(r"\b([a-z_][\w]*)!\s*\(")
    # A send of a command the session built carries no constructor to match,
    # which is the shape that made `navigation-sends`' first draft silent
    # against a tree it was written for: `UiState::apply_step_edit` hands
    # over what `Session::toggle_step` returned. It is matched by the name
    # the command is held under rather than by any `.send(`, because the UI
    # sends plenty of things that are not commands -- a chosen folder, a save
    # request, an export -- down channels of their own, and counting those
    # made every file verb an unrecorded edit.
    opaque = re.compile(r"\.send\(\s*&?(?:command|cmd)\b")

    def survey(body: str, depth: int, seen: frozenset) -> tuple[bool, set[str]]:
        """Whether `body` records, and what it puts into the document."""
        records = any(name in body for name in recorders)
        edits = set(re.findall(r"(?:Engine|Structural)Command::(\w+)", body))
        if "mark_dirty(" in body or re.search(r"\.dirty\s*=\s*true", body):
            edits.add("mark_dirty")
        unresolved = opaque.search(body) is not None
        if depth:
            reachable = [(name, helpers) for name in set(free.findall(body))]
            reachable += [(name, owned) for name in set(ours.findall(body))]
            reachable += [(name, macros) for name in set(invoked.findall(body))]
            for name, index in reachable:
                if name in recorders or name in seen or index.get(name) is None:
                    continue
                deeper, deeper_edits = survey(index[name], depth - 1, seen | {name})
                records = records or deeper
                if deeper_edits:
                    unresolved = False
                edits |= deeper_edits
        if unresolved and not edits:
            edits.add("a command built where this cannot follow")
        return records, edits

    slint = (ROOT / "crates" / "mooloop-ui" / "ui" / "main.slint").read_text()
    window = balanced(slint, slint.index("export component MainWindow"))
    declared = {
        "on_" + match.group(1).replace("-", "_")
        for match in re.finditer(r"^\s*(?:pure\s+)?callback ([a-z][\w-]*)", window, re.M)
    }

    def wirings(text):
        """Every (callback, handler body, offset) this file wires.

        Two shapes, and **the second is the larger of the two.** A hundred
        and fifty of these callbacks are wired by a `wire_*!` macro --
        `wire_unit_param!(on_filter_cutoff_changed, filter_cutoff)` -- whose
        expansion is `window.$on(...)`, which no search for `window.on_` can
        see. A check that knew only the first shape called the sampler's
        filter, every oscillator and every drum parameter clean, and would
        have gone on saying so after this plan had missed them.
        """
        for match in re.finditer(r"\bwindow\.(on_[\w]+)\s*\(", text):
            body = _brace_body(text, match.end())
            if body is not None:
                yield match.group(1), body, match.start()
        for match in re.finditer(r"\b([a-z_][\w]*)!\s*\(", text):
            body = macros.get(match.group(1))
            if body is None:
                continue
            for callback in re.findall(r"\b(on_[a-z0-9_]+)\b", _parens(text, match.end() - 1)):
                yield callback, body, match.start()

    hits = []
    seen_wiring = set()
    for path, text in sources.items():
        for name, handler, at in wirings(text):
            if name not in declared or name in exempt or name in seen_wiring:
                continue
            seen_wiring.add(name)
            records, edits = survey(handler, 3, frozenset({name}))
            if records or not edits or edits <= not_an_edit:
                continue
            line = text.count("\n", 0, at) + 1
            hits.append(
                (
                    f"{rel(path)}:{line}",
                    f"{name} edits the document ({', '.join(sorted(edits))}) and "
                    f"records nothing, so the next undo destroys it",
                )
            )
    return hits


def _parens(text: str, start: int) -> str:
    """The `( ... )` opening at `start`, paren-matched."""
    depth = 0
    for index in range(start, len(text)):
        if text[index] == "(":
            depth += 1
        elif text[index] == ")":
            depth -= 1
            if depth == 0:
                return text[start : index + 1]
    return text[start:]


def balanced(text, start):
    """The brace-balanced block opening at or after `start`."""
    depth = 0
    for offset in range(start, len(text)):
        if text[offset] == "{":
            depth += 1
        elif text[offset] == "}":
            depth -= 1
            if depth == 0:
                return text[start : offset + 1]
    return text[start:]


def balanced_tail(text, start):
    """What is left of the innermost block `start` sits in."""
    depth = 0
    for offset in range(start, len(text)):
        if text[offset] == "{":
            depth += 1
        elif text[offset] == "}":
            if depth == 0:
                return text[start:offset]
            depth -= 1
    return text[start:]


CHECKS = {
    "shared-constant": shared_constant,
    "repeated-line": repeated_line,
    "unit-spelling": unit_spelling,
    "twin-names": twin_names,
    "unchecked-face": unchecked_face,
    "one-sided-test": one_sided_test,
    "bar-arithmetic": bar_arithmetic,
    "popup-close-order": popup_close_order,
    "navigation-sends": navigation_sends,
    "unrecorded-edit": unrecorded_edit,
}


def main(argv):
    if "--list" in argv:
        for name, check in CHECKS.items():
            summary = (check.__doc__ or "").strip().split("\n")[0]
            print(f"{name:<18}{summary}")
        return 0

    wanted = [a for a in argv if not a.startswith("-")] or list(CHECKS)
    unknown = [name for name in wanted if name not in CHECKS]
    if unknown:
        print(f"unknown check: {', '.join(unknown)}", file=sys.stderr)
        print(f"try one of: {', '.join(CHECKS)}", file=sys.stderr)
        return 2

    total = 0
    for name in wanted:
        hits = CHECKS[name]()
        total += len(hits)
        print(f"\n=== {name} ({len(hits)}) ===")
        if not hits:
            print("  nothing")
        for place, detail in hits:
            print(f"  {place}\n      {detail}")

    print(f"\n{total} leads. None of them is a finding until you have read the code.")
    # Leads are not failures: this reports, it does not gate. CI stays green.
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
