#!/usr/bin/env python3
"""Find values and policies that have been written down more than once.

    scripts/dupe-audit                  # every check, ranked
    scripts/dupe-audit shared-constant  # one check
    scripts/dupe-audit --list           # what the checks are

This is the search that a 2026-09-10 detail pass kept re-deriving by hand.
Ten of the defects it found were one fault wearing different clothes: a
number or a rule written in two places, the copies drifting, and nothing
able to notice. Five of them had reached the screen -- a meter scale reading
`+2` where it meant `-12`, a formatter that had never produced its own
documented format, a lane that could not show the range it was editing.

**What it is not.** It does not find duplicated *formulas*. Four synths
computing `sin(2*pi*phi)` will agree forever, because a sine has no
parameters to drift. Copied arithmetic is mostly waste; copied numbers and
copied policies are what diverge silently. Every check here is aimed at the
second kind, which is why the list is short.

Expect false positives and read the output as leads rather than as findings.
Two of the checks are deliberately noisy at the edges, because the failure
that matters -- a guard that has quietly stopped guarding -- looks like
nothing at all until somebody goes and looks.
"""

from __future__ import annotations

import collections
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CRATES = ROOT / "crates"

# Lines that repeat for reasons nobody should be asked to look at.
BORING = re.compile(
    r"^\s*(\}|\{|\)|\);|\},|use |mod |pub mod |//|/\*|\*|#\[|let mut |return;|$)"
)


def rust_sources():
    for path in sorted(CRATES.glob("*/src/**/*.rs")):
        yield path


def rust_tests():
    for path in sorted(CRATES.glob("*/tests/**/*.rs")):
        yield path


def slint_sources():
    for path in sorted(CRATES.glob("*/ui/*.slint")):
        yield path


def rel(path: pathlib.Path) -> str:
    return str(path.relative_to(ROOT))


# --- 1 -----------------------------------------------------------------
def shared_constant():
    """A local `const NAME` shadowing a `pub const NAME` from a crate.

    The sharpest of these checks, and the one with a scalp. `piano_tools.rs`
    and `piano_drag.rs` each declared `const TICKS_PER_STEP: i32 = 24`
    beside a `mooloop_core` that already exported it. Those suites work by
    computing where a tick belongs on screen and clicking there, so a local
    copy made them agree with the markup *by construction*: had the engine's
    value moved, the roll would have drawn every note in the wrong place and
    both suites would have gone on passing. A test that shares the drift it
    exists to catch cannot report it.
    """
    published = {}
    for path in rust_sources():
        for match in re.finditer(
            r"^\s*pub const ([A-Z][A-Z0-9_]*)\s*:\s*[^=]+=\s*([^;]+);",
            path.read_text(),
            re.M,
        ):
            published.setdefault(match.group(1), (rel(path), match.group(2).strip()))

    hits = []
    for path in list(rust_sources()) + list(rust_tests()):
        text = path.read_text()
        for match in re.finditer(
            r"^\s*(?:pub\s+)?const ([A-Z][A-Z0-9_]*)\s*:\s*[^=]+=\s*([^;]+);", text, re.M
        ):
            name, value = match.group(1), match.group(2).strip()
            if name not in published:
                continue
            owner, owner_value = published[name]
            if owner == rel(path):
                continue
            # A copy that derives from the original is the fix, not the fault.
            if "::" in value or any(c.isalpha() for c in value.replace("_", "")):
                continue
            # Same name, different value, is two facts that happen to share a
            # word -- `PARAM_LEVEL` means one thing to DS-01 and another to
            # Aux In. Only an equal value is a copy.
            if value.rstrip("0").rstrip(".") != owner_value.rstrip("0").rstrip("."):
                continue
            # Same crate, same name, same value is usually deliberate
            # namespacing: `OSC_OFFSET_WAVE` is 0 in two device tables
            # because both count from zero. The copies that rot are the ones
            # that cross a crate, where the owner is somewhere you would have
            # to go looking.
            if rel(path).split("/")[1] == owner.split("/")[1]:
                continue
            line = text[: match.start()].count("\n") + 1
            hits.append(
                (
                    f"{rel(path)}:{line}",
                    f"{name} = {value} re-declared; {owner} publishes it as {owner_value}",
                )
            )
    return hits


# --- 2 -----------------------------------------------------------------
def repeated_line():
    """One non-trivial line, byte-identical, in three or more files.

    Found four synths computing glide with the same twelve tokens --
    `(-1.0 / (params.glide.max(MIN_GLIDE_S) * sr as f32)).exp()` -- while
    all four already imported `MIN_GLIDE_S` from the module the helper
    belongs in. The constant had been shared and the formula had not, which
    is the shape to look for: the fix is usually one function in a file
    every offender already depends on.
    """
    seen = collections.defaultdict(set)
    where = {}
    for path in rust_sources():
        for number, line in enumerate(path.read_text().split("\n"), 1):
            stripped = line.strip()
            if len(stripped) < 40 or BORING.match(line):
                continue
            # A signature repeats because several types implement one trait,
            # which is the opposite of the problem. Only statements and
            # expressions carry a value somebody had to type twice.
            if stripped.endswith("{") or stripped.startswith(("fn ", "pub fn ", "impl ")):
                continue
            # A duplicated *computation* is the target: it carries a literal
            # and does arithmetic on it. A duplicated *call* -- `self
            # .apply_param(id, value)` in sixteen devices -- is a shared
            # idiom, which is the thing working correctly.
            body = re.sub(r'"[^"]*"', "", stripped)
            if not (re.search(r"\d", body) and re.search(r"[*/+]|\s-\s", body)):
                continue
            seen[stripped].add(rel(path))
            where.setdefault(stripped, f"{rel(path)}:{number}")

    hits = []
    for line, files in seen.items():
        if len(files) >= 3:
            hits.append((len(files), where[line], f"in {len(files)} files: {line[:88]}"))
    return [hit[1:] for hit in sorted(hits, reverse=True)]


# --- 3 -----------------------------------------------------------------
def unit_spelling():
    """The same unit appended two ways in the markup.

    A readout's unit is a house convention, not a per-file choice: the Rust
    side attaches every unit with a space and `%` without one. Two faces
    spelled percent `50 %` against ninety-four writing `50%`, and one shelf
    caption said `150ms` where its own knob said `150 ms`. Minority
    spellings are reported; a minority of one, six lines from its majority,
    is how the last two were found.
    """
    counts = collections.defaultdict(collections.Counter)
    where = collections.defaultdict(dict)
    for path in slint_sources():
        for number, line in enumerate(path.read_text().split("\n"), 1):
            for match in re.finditer(r'\+\s*"(\s?)([%a-zA-Z]{1,4})"', line):
                space, unit = match.group(1), match.group(2)
                counts[unit][space] += 1
                where[unit].setdefault(space, f"{rel(path)}:{number}")

    hits = []
    for unit, spellings in counts.items():
        if len(spellings) < 2:
            continue
        ranked = spellings.most_common()
        majority, majority_n = ranked[0]
        for space, n in ranked[1:]:
            hits.append(
                (
                    n,
                    where[unit][space],
                    f'"{space}{unit}" used {n}x against "{majority}{unit}" {majority_n}x',
                )
            )
    return [hit[1:] for hit in sorted(hits)]


# --- 4 -----------------------------------------------------------------
def twin_names():
    """Two functions whose names say the same thing.

    `mooloop_core::gain::linear_to_db` floors at -60 dB and its inverse
    returns silence below that; `mooloop_dsp::dynamics::lin_to_db` floors at
    1e-9, about -180 dB, and its inverse has no floor at all. A hundred and
    twenty decibels apart at silence, in crates where one depends on the
    other. The difference is deliberate -- a compressor's detector needs
    range a fader does not -- and nothing anywhere says so, which is what
    makes it a trap for whoever decides to tidy the duplicate away.
    """
    words = {"lin": "linear", "db": "decibels", "ms": "milliseconds", "freq": "frequency",
             "amp": "amplitude", "pos": "position", "norm": "normalized", "val": "value"}

    def key(name: str) -> tuple:
        parts = [words.get(part, part) for part in name.split("_") if part]
        return tuple(sorted(parts))

    families = collections.defaultdict(list)
    for path in rust_sources():
        text = path.read_text()
        for match in re.finditer(r"^\s*(?:pub(?:\([^)]*\))?\s+)?fn ([a-z][a-z0-9_]*)\s*\(", text, re.M):
            name = match.group(1)
            if len(name) < 5:
                continue
            line = text[: match.start()].count("\n") + 1
            families[key(name)].append((name, f"{rel(path)}:{line}"))

    hits = []
    for members in families.values():
        distinct = {name for name, _ in members}
        if len(distinct) < 2:
            continue
        listed = ", ".join(f"{name} ({place})" for name, place in sorted(members))
        # Two spellings inside one file are usually a deliberate inverse
        # pair. Two that live in different crates are the ones nobody can
        # see at once, which is where a quiet disagreement survives.
        crates = {place.split("/")[1] for _, place in members}
        hits.append(
            (len(crates), len(members), sorted(members)[0][1],
             f"names agree, bodies may not: {listed}")
        )
    return [hit[2:] for hit in sorted(hits, reverse=True)]


# --- 5 -----------------------------------------------------------------
def unchecked_face():
    """A face that spells a range in markup where no test reads it back.

    A knob and an automation lane are two views of one value, and a face that
    writes its own `default-value: 0.9` has stated a number the descriptor
    table already states. `slint_face_agreement.rs` exists to hold the two
    together, and it works from a hand-written list -- for a reason it gives
    itself, that a derivation would move with whichever side it was derived
    from. A hand-written list then has a hand-written list's failure, which
    `AGENTS.md` records as recurring here: the generator faces were covered
    for months while the effect faces were not.

    The rule is *a literal in a face the test does not include*. Both halves
    matter:

    - A face the test never `include_str!`s has none of its knobs checked,
      whatever they say.
    - A `default-value: root.defaults[root.param]` is not a second copy of
      anything. That face reads the table at run time, so it cannot drift, and
      DS-01's whole paged face is built this way. Only a literal is a copy.

    A literal here is not automatically a defect -- a control that is not
    descriptor-backed at all has nowhere else for its number to live. What the
    list is for is the other kind.

    **It also reports what the guard cannot reach.** The agreement test finds a
    knob by looking for one line carrying both the property binding and
    `default-value:`. A face written with those on separate lines cannot be
    added to it without changing the parser, and nothing else says so, so the
    detail below names that shape where it appears.
    """
    agreement = ROOT / "crates/mooloop-ui/tests/slint_face_agreement.rs"
    if not agreement.exists():
        return [(rel(agreement), "the face-agreement test is gone; nothing checks any face")]
    covered = set(
        re.findall(r'include_str!\("\.\./ui/([a-z0-9-]+\.slint)"\)', agreement.read_text())
    )

    # These draw no device parameter of their own: the rack, the drag harness,
    # the shared displays, the concepts sheet.
    NOT_A_FACE = {
        "device-concepts.slint",
        "device-displays.slint",
        "device-drag-harness.slint",
        "device-rack.slint",
    }

    literal = re.compile(r"default-value:\s*(-?[0-9][0-9_.]*)\s*;")
    binding = re.compile(r"root\.([a-z0-9-]+);")

    hits = []
    for path in slint_sources():
        if "device" not in path.name or path.name in NOT_A_FACE or path.name in covered:
            continue
        lines = path.read_text().splitlines()
        spelled = [
            (index, match.group(1), binding.search(line) is not None)
            for index, line in enumerate(lines, start=1)
            if (match := literal.search(line))
        ]
        if not spelled:
            continue
        reachable = sum(1 for _, _, same_line in spelled if same_line)
        detail = f"{len(spelled)} range(s) spelled in markup that no test reads back"
        if reachable < len(spelled):
            detail += (
                f"; {len(spelled) - reachable} of them declare the binding on a separate"
                " line, which the agreement test's one-line parser cannot reach as it stands"
            )
        hits.append((f"{rel(path)}:{spelled[0][0]}", detail))
    return sorted(hits, key=lambda hit: -int(hit[1].split()[0]))


# --- 6 -----------------------------------------------------------------
def one_sided_test():
    """A test named for a markup file that never reads one.

    Six faults of one shape turned up in the 2026-09-12 audit, and this is the
    only one of them a search can find. `dupe-audit`'s other checks look for a
    value written twice; this looks for the *guard* over a value written twice
    having quietly come off it.

    The instance it is built from:
    `musical_divisions_match_the_snap_table_in_main_slint` was named for
    `snap-ticks()` in `main.slint`, its comment warned that a drift "would set
    the wrong length silently", and it compared `MUSICAL_DIVISIONS` to a literal
    `[384, 192, 96, ...]` written inside the test. A third spelling of the same
    eleven numbers, in the one place whose job was to notice a second. Editing
    the markup could not have failed it.

    **A mention is not a read, and that distinction is the whole check.** The
    first version of this looked for the filename anywhere in the function and
    found nothing, because the broken test *talked about* `main.slint` in its
    own comment. So a read means the `include_str!` const for that file
    appearing in the body, or the body calling `include_str!` itself. Verified
    against `7024b2b~1`, where it reports the defect, and against the tree,
    where it reports nothing.

    Zero hits is the expected result. This is a regression guard for a fault
    class, not a lead generator -- unlike the checks above it, an empty run here
    is the answer rather than an absence of evidence.
    """
    hits = []
    for path in sorted((ROOT / "crates/mooloop-ui").rglob("*.rs")):
        text = path.read_text(errors="replace")
        consts = {
            match.group(1): match.group(2)
            for match in re.finditer(
                r'const ([A-Z0-9_]+): &str = include_str!\("\.\./ui/([a-z0-9-]+)\.slint"\)',
                text,
            )
        }
        opened = set(consts.values()) | set(
            re.findall(r'include_str!\("\.\./ui/([a-z0-9-]+)\.slint"\)', text)
        )
        for match in re.finditer(r"fn ([a-z0-9_]+)\(\)", text):
            name = match.group(1)
            named = re.search(
                r"(main|controls|gain|mixer|toolbar|strip|meters|theme|piano-grid)_slint", name
            )
            if not named:
                continue
            stem = named.group(1)
            body = _brace_body(text, match.end())
            if body is None:
                continue
            reads = any(const in body for const, owned in consts.items() if owned == stem)
            reads = reads or f'include_str!("../ui/{stem}.slint")' in body
            if reads:
                continue
            why = (
                f"the file opens {stem}.slint but this test does not read it"
                if stem in opened
                else f"nothing in this file opens {stem}.slint"
            )
            line = text[: match.start()].count("\n") + 1
            hits.append(
                (f"{rel(path)}:{line}", f"{name} is named for {stem}.slint; {why}")
            )
    return hits


def _brace_body(text: str, after: int) -> str | None:
    """The `{ ... }` that follows `after`, brace-matched."""
    start = text.find("{", after)
    if start == -1:
        return None
    depth = 0
    for index in range(start, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                return text[start : index + 1]
    return None


# A sixth check was written and thrown away: Rust constants whose *value*
# appears as a bare number in the markup. `TICKS_PER_STEP` really is spelled
# `24` twenty-five times in the roll, and finding that automatically would be
# worth having. But a bare number in markup carries no identity -- every
# parameter id that happens to equal 24, 60 or 100 collides with every
# unrelated 24, 60 or 100 -- and the check produced a hundred and two leads
# for the one real answer. A tool that is wrong ninety-nine times in a
# hundred does not get read the hundredth. That gap is recorded in
# `LOOSE_ENDS.md` instead, where a human sentence can say which number
# matters and why.


CHECKS = {
    "shared-constant": shared_constant,
    "repeated-line": repeated_line,
    "unit-spelling": unit_spelling,
    "twin-names": twin_names,
    "unchecked-face": unchecked_face,
    "one-sided-test": one_sided_test,
}


def main(argv):
    if "--list" in argv:
        for name, check in CHECKS.items():
            summary = (check.__doc__ or "").strip().split("\n")[0]
            print(f"{name:<18}{summary}")
        return 0

    wanted = [a for a in argv if not a.startswith("-")] or list(CHECKS)
    unknown = [name for name in wanted if name not in CHECKS]
    if unknown:
        print(f"unknown check: {', '.join(unknown)}", file=sys.stderr)
        print(f"try one of: {', '.join(CHECKS)}", file=sys.stderr)
        return 2

    total = 0
    for name in wanted:
        hits = CHECKS[name]()
        total += len(hits)
        print(f"\n=== {name} ({len(hits)}) ===")
        if not hits:
            print("  nothing")
        for place, detail in hits:
            print(f"  {place}\n      {detail}")

    print(f"\n{total} leads. None of them is a finding until you have read the code.")
    # Leads are not failures: this reports, it does not gate. CI stays green.
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
