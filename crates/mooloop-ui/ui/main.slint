    in-out property <bool> poly-mono-mode;
    in-out property <int> poly-env-trigger; in-out property <int> poly-note-priority;
    callback poly-osc1-wave-changed(int); callback poly-osc1-semitones-changed(float); callback poly-osc1-cents-changed(float); callback poly-osc1-level-changed(float); callback poly-osc1-pulse-width-changed(float);
    callback poly-osc2-wave-changed(int); callback poly-osc2-semitones-changed(float); callback poly-osc2-cents-changed(float); callback poly-osc2-level-changed(float); callback poly-osc2-pulse-width-changed(float);
    callback poly-osc3-wave-changed(int); callback poly-osc3-semitones-changed(float); callback poly-osc3-cents-changed(float); callback poly-osc3-level-changed(float); callback poly-osc3-pulse-width-changed(float);
    callback poly-glide-changed(float); callback poly-attack-changed(float); callback poly-decay-changed(float); callback poly-sustain-changed(float); callback poly-release-changed(float);
    callback poly-filter-cutoff-changed(float); callback poly-filter-resonance-changed(float); callback poly-filter-env-changed(float); callback poly-drive-changed(float);
    callback poly-lfo-wave-changed(int); callback poly-lfo-rate-changed(float); callback poly-lfo-retrigger-changed(bool);
    callback poly-lfo-pitch-changed(float); callback poly-lfo-filter-changed(float); callback poly-lfo-pulse-width-changed(float); callback poly-lfo-amp-changed(float);
    callback poly-polyphony-changed(int); callback poly-spread-changed(float);
    callback poly-mono-mode-changed(bool);
    callback poly-env-trigger-changed(int); callback poly-note-priority-changed(int);

    // ---- transport callbacks ----
    callback new-song();
    callback play-clicked();
    callback stop-clicked();
    callback bpm-changed(int);
    callback swing-changed(int);
    callback toggle-play();

    // Every action a shortcut can target is named and looked up in Rust
    // (see `actions.rs`); this window only decodes a raw key event into a
    // canonical (key, ctrl, shift, alt, meta) tuple and hands it off. The
    // return value says whether some action consumed it. See
    // `docs/ACTIONS.md`.
    callback shortcut-key(string, bool, bool, bool, bool) -> bool;
    callback pattern-remove-requested();
    callback pattern-clone-requested();
    callback pattern-clear-requested();
    callback select-all-requested();
    callback delete-selected-notes-requested();

    // Only the piano roll actually zooms today (the playlist has a snap
    // picker but no zoom, and the step grid/mixer aren't zoomable), so
    // these implement themselves here rather than round-tripping through
    // Rust: `piano-step-width` is a private view property, not exposed to
    // Rust. Same 1.15/0.87 factor the existing Ctrl+Shift+wheel handler on
    // the piano roll's time scrollbar uses. Unlike that pointer-centered
    // version, this doesn't re-center the scroll position -- doing so needs
    // the `piano-scroll` id, which (unlike `root.piano-step-width`) isn't
    // reachable from this root-level callback, only from within its own
    // nested scroll area -- so a keyboard zoom just changes scale in place.
    callback zoom-in-requested();
    zoom-in-requested => {
        if (root.showing-notes) {
            root.piano-step-width = clamp(root.piano-step-width * 1.15, 20px, 72px);
        }
    }
    callback zoom-out-requested();
    zoom-out-requested => {
        if (root.showing-notes) {
            root.piano-step-width = clamp(root.piano-step-width * 0.87, 20px, 72px);
        }
    }

    forward-focus: keys;
    keys := FocusScope {
        // Deliberately does NOT take focus on click, even though it now
        // surrounds the whole window. A FocusScope without focus swallows the
        // pointer press that would focus it (i-slint-core `input_items.rs`
        // `FocusScope::input_event`), which is the two-clicks-per-control bug
        // `tests/first_click.rs` exists to pin down. It does not need focus:
        // surrounding the UI is what gets it the keys.
        focus-on-click: false;
        key-pressed(event) => {
            if (root.preferences-open) {
                // The Shortcuts prefpane owns key capture for (re)binding
                // while it's open; no global action should fire underneath it.
                reject
            // Up and Down used to pick a channel here, guarded by a
            // hand-written "unless the roll has a selection". That branch
            // could only ever know about two answers; the browser is a
            // third, so all four arrows go to the dispatcher now and
            // `Scope::Focused` decides. See `actions.rs`.
            //
            // Space carries its real modifiers. It did not until
            // 2026-09-14, when it was forwarded with all four flags
            // hardcoded `false` -- which made Shift+Space and Space one
            // chord and left `transport.stop` unbindable.
            } else if (event.text == " ") {
                root.shortcut-key("space", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.LeftArrow) {
                root.shortcut-key("left", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.RightArrow) {
                root.shortcut-key("right", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.UpArrow) {
                root.shortcut-key("up", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.DownArrow) {
                root.shortcut-key("down", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Delete) {
                root.shortcut-key("delete", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Backspace) {
                root.shortcut-key("backspace", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            // Esc leaves zoom and nothing else. It is the least specific
            // meaning Esc can have here, so it loses to every dialog and does
            // not consume the key when nothing is zoomed -- whatever else
            // gets bound to Esc still receives it.
            } else if (event.text == Key.Escape && root.zoomed >= 0
                    && !root.save-error-open && !root.export-open
                    && !root.save-preset-open && !root.about-open
                    && !root.question-open && !root.takes-open) {
                root.zoomed = -1;
                accept
            } else if (event.text == Key.Escape) {
                root.shortcut-key("escape", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Tab) {
                root.shortcut-key("tab", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Return) {
                root.shortcut-key("return", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Home) {
                root.shortcut-key("home", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.End) {
                root.shortcut-key("end", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.PageUp) {
                root.shortcut-key("pageup", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.PageDown) {
                root.shortcut-key("pagedown", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Insert) {
                root.shortcut-key("insert", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            // A bare modifier keypress (pressing Ctrl down, before whatever
            // it's chorded with) reports `event.text` as that modifier's own
            // key code -- and Slint's codes for Shift/Control/Alt/AltGr/
            // CapsLock/ShiftR/ControlR/Meta/MetaR (0x10-0x18) land exactly on
            // top of the Ctrl+P..Ctrl+X sentinel range below. Left
            // unguarded, pressing Ctrl alone was resolving as Ctrl+Q (quit)
            // on every single Ctrl+<something> shortcut. Reject these
            // outright before the sentinel ladder gets a chance to
            // misread them.
            } else if (event.text == Key.Shift || event.text == Key.Control
                    || event.text == Key.Alt || event.text == Key.AltGr
                    || event.text == Key.CapsLock || event.text == Key.ShiftR
                    || event.text == Key.ControlR || event.text == Key.Meta
                    || event.text == Key.MetaR) {
                reject
            // Ctrl+<letter> arrives as the raw ASCII control code for that
            // letter (0x01 = Ctrl+A .. 0x1A = Ctrl+Z) on some backends,
            // rather than as plain text with `event.modifiers.control` set
            // -- a terminal-era convention, not a Slint quirk. `shift` stays
            // reliable from `event.modifiers` either way. Written out once,
            // mechanically; a new Ctrl+letter action never needs a new
            // branch here, only a new `actions.rs` entry. Ctrl+H/I/J are
            // not decoded here because their control codes (0x08/0x09/0x0A)
            // are indistinguishable from Backspace/Tab/Return, which are
            // handled above.
            } else if (event.text == "\u{1}") {
                root.shortcut-key("a", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{2}") {
                root.shortcut-key("b", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{3}") {
                root.shortcut-key("c", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{4}") {
                root.shortcut-key("d", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{5}") {
                root.shortcut-key("e", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{6}") {
                root.shortcut-key("f", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{7}") {
                root.shortcut-key("g", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{b}") {
                root.shortcut-key("k", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{c}") {
                root.shortcut-key("l", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{d}") {
                root.shortcut-key("m", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{e}") {
                root.shortcut-key("n", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{f}") {
                root.shortcut-key("o", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{10}") {
                root.shortcut-key("p", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{11}") {
                root.shortcut-key("q", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{12}") {
                root.shortcut-key("r", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{13}") {
                root.shortcut-key("s", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{14}") {
                root.shortcut-key("t", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{15}") {
                root.shortcut-key("u", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{16}") {
                root.shortcut-key("v", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{17}") {
                root.shortcut-key("w", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{18}") {
                root.shortcut-key("x", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{19}") {
                root.shortcut-key("y", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{1a}") {
                root.shortcut-key("z", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.modifiers.control) {
                // Non-letter Ctrl combos (digits, `=`, `-`, ...) are
                // reported reliably via `event.modifiers.control` on this
                // backend, so no sentinel decoding is needed for them.
                root.shortcut-key(event.text.to-lowercase(), true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            // Everything else, unmodified, lowercased. This was a list of
            // six digits until 2026-09-14 and the list was the bug:
            // `transport.loop-toggle` had shipped on a bare L since
            // 2026-09-07, the Shortcuts page drew it, the recorder in
            // `appearance-dialog.slint` could capture it -- and no L ever
            // reached the dispatcher, because no branch here forwarded a
            // bare letter. `actions.rs`'s `decoding` module now fails if
            // any registry default is a chord this ladder cannot produce.
            //
            // Safe to forward unconditionally, for the reason the digits
            // already were: a focused text field consumes the key before
            // this scope sees it, and an unbound chord resolves to nothing
            // and falls through to whatever else wants it.
            } else {
                root.shortcut-key(event.text.to-lowercase(), false, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            }
        }

        VerticalBox {
            spacing: 0px;

            // ===== Menu bar =====
            //
            // The concrete menus live here, where every root callback is in
            // scope: an item is one MenuRow line, a new action is one callback
            // on the window plus one line. Rows whose feature does not exist
            // yet are kept disabled on purpose so the menu documents what is
            // being built toward.
            menu-bar := MenuBar {
                MenuBarItem {
                    title: "File";
                    menu-id: 0;
                    open-menu <=> menu-bar.open-menu;
                    titles: menu-bar.titles;
                    bar-width: menu-bar.width;
                    enabled: !root.document-busy;

                    // A fresh starter song. The handler asks before
                    // discarding unsaved work, as Open Song does.
                    MenuRow {
                        text: "New Song";
                        shortcut: "Ctrl+N";
                        selected => { root.new-song(); }
                    }
                    MenuRow {
                        text: "Open Song...";
                        shortcut: "Ctrl+O";
                        selected => { root.open-song(); }
                    }
                    MenuRow {
                        text: "Save Song";
                        shortcut: "Ctrl+S";
                        selected => { root.save-song(); }
                    }
                    MenuRow {
                        text: "Save Song As...";
                        shortcut: "Ctrl+Shift+S";
                        selected => { root.save-song-as(); }
                    }
                    MenuSeparator {}
                    MenuRow { text: "Load Kit..."; selected => { root.load-kit(); } }
                    MenuRow { text: "Save Kit..."; selected => { root.save-kit(); } }
                    MenuRow { text: "Load Channel..."; selected => { root.load-channel(); } }
                    MenuRow { text: "Save Channel..."; selected => { root.save-channel(); } }
                    MenuSeparator {}
                    MenuRow {
                        text: "Embed samples";
                        checked: root.embed-assets;
                        selected => { root.embed-assets = !root.embed-assets; }
                    }
                    MenuSeparator {}
                    MenuRow {
                        text: "Export Audio...";
                        shortcut: "Ctrl+E";
                        selected => { root.export-audio(); }
                    }
                    // Takes nothing refers to any more (MOO-38).
                    MenuRow {
                        text: "Clean Up Takes...";
                        selected => { root.clean-up-takes(); }
                    }
                    MenuSeparator {}
                    MenuRow {
                        text: "Quit";
                        shortcut: "Ctrl+Q";
                        selected => { root.quit-requested(); }
                    }
                }

                MenuBarItem {
                    title: "Edit";
                    menu-id: 1;
                    open-menu <=> menu-bar.open-menu;
                    titles: menu-bar.titles;
                    bar-width: menu-bar.width;
                    MenuRow { text: "Undo"; shortcut: "Ctrl+Z"; enabled: root.can-undo; selected => { root.edit-command-requested(0, root.selected-channel); } }
                    MenuRow { text: "Redo"; shortcut: "Ctrl+Shift+Z"; enabled: root.can-redo; selected => { root.edit-command-requested(1, root.selected-channel); } }
                    MenuSeparator {}
                    MenuRow { text: "Cut Channel"; shortcut: "Ctrl+X"; enabled: !root.project-edit-pending && root.channels.length > 1; selected => { root.edit-command-requested(2, root.selected-channel); } }
                    MenuRow { text: "Copy Channel"; shortcut: "Ctrl+C"; selected => { root.edit-command-requested(3, root.selected-channel); } }
                    MenuRow { text: "Paste Channel"; shortcut: "Ctrl+V"; enabled: !root.project-edit-pending && root.channel-clipboard-available && root.channels.length < root.max-channels; selected => { root.edit-command-requested(4, root.selected-channel); } }
                    MenuSeparator {}
                    MenuRow { text: "Select All Notes"; shortcut: "Ctrl+A"; enabled: root.showing-notes && root.notes.length > 0; selected => { root.select-all-requested(); } }
                    MenuRow { text: "Delete Selected Notes"; shortcut: "Delete"; enabled: root.has-note-selection; selected => { root.delete-selected-notes-requested(); } }
                }

                MenuBarItem {
                    title: "Pattern";
                    menu-id: 2;
                    open-menu <=> menu-bar.open-menu;
                    titles: menu-bar.titles;
                    bar-width: menu-bar.width;
                    MenuRow {
                        text: "New Pattern";
                        shortcut: "Ctrl+Shift+P";
                        enabled: !root.project-edit-pending && root.pattern-count < root.max-patterns;
                        selected => { root.add-pattern-clicked(); }
                    }
                    MenuRow {
                        text: "Clone Pattern";
                        shortcut: "Ctrl+Alt+D";
                        enabled: !root.project-edit-pending && root.pattern-count < root.max-patterns;
                        selected => { root.pattern-clone-requested(); }
                    }
                    MenuSeparator {}
                    MenuRow { text: "Clear Pattern"; enabled: !root.project-edit-pending; selected => { root.pattern-clear-requested(); } }
                    MenuRow {
                        text: "Delete Pattern";
                        shortcut: "Ctrl+Shift+Delete";
                        enabled: !root.project-edit-pending && root.pattern-count > 1;
                        selected => { root.pattern-remove-requested(); }
                    }
                }

                MenuBarItem {
                    title: "Channel";
                    menu-id: 3;
                    open-menu <=> menu-bar.open-menu;
                    titles: menu-bar.titles;
                    bar-width: menu-bar.width;
                    MenuRow {
                        text: "Add Channel";
                        enabled: !root.project-edit-pending && root.channels.length < root.max-channels;
                        selected => { root.add-channel-clicked(0); }
                    }
                    MenuRow {
                        text: "Delete Selected Channel";
                        enabled: !root.project-edit-pending && root.channels.length > 1;
                        selected => { root.edit-command-requested(6, root.selected-channel); }
                    }
                    MenuSeparator {}
                    MenuRow { text: "Clone Channel"; enabled: !root.project-edit-pending && root.channels.length < root.max-channels; selected => { root.edit-command-requested(5, root.selected-channel); } }
                    MenuRow { text: "Copy Channel"; selected => { root.edit-command-requested(3, root.selected-channel); } }
                    MenuRow { text: "Paste Channel"; enabled: !root.project-edit-pending && root.channel-clipboard-available && root.channels.length < root.max-channels; selected => { root.edit-command-requested(4, root.selected-channel); } }
                }

                // The mixer's list, as Channel is the rack's. The move rows
                // are the named form of dragging a strip's name plate, and
                // say which track they move rather than "the current one".
                MenuBarItem {
                    title: "Track";
                    menu-id: 4;
                    open-menu <=> menu-bar.open-menu;
                    titles: menu-bar.titles;
                    bar-width: menu-bar.width;
                    MenuRow {
                        text: "Add Track";
                        enabled: !root.project-edit-pending && root.can-add-track;
                        selected => { root.track-added(); }
                    }
                    MenuSeparator {}
                    MenuRow {
                        text: "Move " + (root.editing-bus ? root.editing-bus-name : "Track") + " Left";
                        enabled: !root.project-edit-pending && root.editing-bus
                            && root.editing-bus-can-move-left;
                        selected => {
                            root.track-reorder-requested(root.editing-bus-index, root.editing-bus-index - 1);
                        }
                    }
                    MenuRow {
                        text: "Move " + (root.editing-bus ? root.editing-bus-name : "Track") + " Right";
                        enabled: !root.project-edit-pending && root.editing-bus
                            && root.editing-bus-can-move-right;
                        selected => {
                            root.track-reorder-requested(root.editing-bus-index, root.editing-bus-index + 1);
                        }
                    }
                }

                MenuBarItem {
                    title: "View";
                    menu-id: 5;
                    open-menu <=> menu-bar.open-menu;
                    titles: menu-bar.titles;
                    bar-width: menu-bar.width;
                    // One row per view, checked when that view is showing
                    // wherever it lives. "Devices" is named for the view
                    // rather than for one of the eight instruments that can
                    // head the chain: a row saying "Sampler" over a chain
                    // headed by DS-01 said the wrong thing.
                    MenuRow {
                        text: "Steps";
                        shortcut: "Ctrl+1";
                        checked: root.showing-steps;
                        selected => { root.show-view(PaneViews.steps); }
                    }
                    MenuRow {
                        text: "Mixer";
                        shortcut: "Ctrl+2";
                        checked: root.showing-mixer;
                        selected => { root.show-view(PaneViews.mixer); }
                    }
                    MenuRow {
                        text: "Devices";
                        shortcut: "Ctrl+3";
                        checked: root.showing-devices;
                        selected => { root.show-view(PaneViews.devices); }
                    }
                    MenuRow {
                        text: "Notes";
                        shortcut: "Ctrl+4";
                        checked: root.showing-notes;
                        selected => { root.show-view(PaneViews.notes); }
                    }
                    MenuRow {
                        text: "Playlist";
                        shortcut: "Ctrl+5";
                        checked: root.showing-playlist;
                        selected => { root.show-view(PaneViews.playlist); }
                    }
                    MenuSeparator {}
                    MenuRow {
                        text: "Channel Sidebar";
                        shortcut: "Ctrl+[";
                        checked: root.channel-sidebar-visible;
                        selected => { root.toggle-channel-sidebar(); }
                    }
                    MenuRow {
                        text: "Split Top Pane";
                        shortcut: "Ctrl+\\";
                        checked: root.split-active >= 0;
                        enabled: root.split-active >= 0 || root.other-main-view() >= 0;
                        selected => { root.toggle-split(); }
                    }
                    MenuRow {
                        text: "Zoom Pane";
                        shortcut: "Ctrl+Shift+\\";
                        checked: root.zoomed >= 0;
                        selected => { root.toggle-zoom-active(); }
                    }
                    MenuSeparator {}
                    // Moving a view is a tab drag; these are the same
                    // operation for someone who has not discovered that, and
                    // the reason the drag is allowed to be a gesture. They
                    // name the view rather than saying "current view",
                    // because a row that does not say what it acts on is a
                    // row you have to try.
                    //
                    // A `Move To >` submenu would be the usual shape and the
                    // menu bar has no submenus; three rows for the view you
                    // last revealed is smaller than fifteen flat ones.
                    MenuRow {
                        text: "Move " + PaneViews.names[root.slot-active(root.active-slot)]
                            + " to Top Pane";
                        enabled: root.slot-active(root.active-slot) >= 0
                            && root.active-slot != 0;
                        selected => { root.move-view(root.slot-active(root.active-slot), 0); }
                    }
                    MenuRow {
                        text: "Move " + PaneViews.names[root.slot-active(root.active-slot)]
                            + " to Split";
                        enabled: root.slot-active(root.active-slot) >= 0
                            && root.active-slot != 1
                            && !(root.active-slot == 0 && root.main-view-count() <= 1);
                        selected => { root.move-view(root.slot-active(root.active-slot), 1); }
                    }
                    MenuRow {
                        text: "Move " + PaneViews.names[root.slot-active(root.active-slot)]
                            + " to Bottom Pane";
                        enabled: root.slot-active(root.active-slot) >= 0
                            && root.active-slot != 2
                            && !(root.active-slot == 0 && root.main-view-count() <= 1);
                        selected => { root.move-view(root.slot-active(root.active-slot), 2); }
                    }
                    MenuSeparator {}
                    MenuRow {
                        text: "Preferences...";
                        selected => {
                            root.preferences-opened();
                            root.preferences-open = true;
                        }
                    }
                }

                MenuBarItem {
                    title: "Help";
                    menu-id: 6;
                    open-menu <=> menu-bar.open-menu;
                    titles: menu-bar.titles;
                    bar-width: menu-bar.width;
                    MenuRow { text: "About mooloop"; selected => { root.about-open = true; } }
                }
            }

            // ===== Toolbar =====
            //
            // Two rows, split by what they answer. The transport row is the state
            // of playback and never changes meaning; the edit row is what the
            // current click will do. Mixing the two into one strip is what made
            // the old bar read as a row of unrelated buttons.
            // The transport row and the hairline under it. The work-surface
            // row used to be the rest of this block, above the work area
            // entirely -- which is why there could only ever be one of it.
            // It is a view's toolbar now and lives in the slot that view is
            // in. The hairline stays here so the boundary looks the same.
            Rectangle {
                height: 33px;
                background: Theme.surface;

                VerticalLayout {
                    spacing: 0px;

                    // --- Transport row -----------------------------------------
                    Rectangle {
                        height: 32px;
                        HorizontalBox {
                            padding-left: 6px;
                            padding-right: 6px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 3px;

                            TransportButton {
                                text: root.playing ? "⏸" : "▶";
                                tooltip: root.playing ? "Pause (Space)" : "Play (Space)";
                                role: "play";
                                active: root.playing;
                                clicked => { root.toggle-play(); }
                            }
                            TransportButton {
                                text: "■";
                                tooltip: "Stop";
                                enabled: root.playing || root.current-step > 0;
                                clicked => { root.stop-clicked(); }
                            }
                            // Arm, not record: it arms and the transport does
                            // the recording, which is how every recorder is
                            // operated and is why arming while stopped works.
                            TransportButton {
                                text: "●";
                                tooltip: root.record-armed
                                    ? "Recording armed — MIDI is captured while playing"
                                    : "Arm MIDI recording";
                                role: "record";
                                active: root.record-armed;
                                clicked => { root.record-armed-toggled(); }
                            }
                            // The arm for controller mapping. It lives here
                            // rather than in Preferences because the gesture
                            // it arms is a press on a control in the main
                            // window, which a modal dialog is covering.
                            ToolButton {
                                // The label carries the *pending* target as
                                // well as the arm, because the status bar
                                // cannot: a hover hint outranks a status
                                // message there, so the moment the pointer
                                // crosses a control the sentence naming what
                                // is being mapped is covered by that
                                // control's own.
                                text: root.midi-learn-target == "" ? "LEARN" : "LISTENING";
                                width: 72px;
                                tooltip: root.midi-learn-target != ""
                                    ? "Move a control on your controller to map " + root.midi-learn-target
                                    : root.midi-learn-armed
                                        ? "Press a control to map it, then move a knob on your controller"
                                        : "MIDI Learn: map a control to a controller";
                                hint: root.midi-learn-target != ""
                                    ? "Waiting for a control. Move the knob, fader or pad you want to map to " + root.midi-learn-target + "."
                                    : root.midi-learn-armed
                                        ? "MIDI Learn is on. Press any knob or fader, then move the control you want to map to it."
                                        : "Turn on MIDI Learn, then press a control to map it to your controller.";
                                active: root.midi-learn-armed;
                                clicked => { root.midi-learn-toggled(); }
                            }

                            ToolbarRule {}

                            SegmentedControl {
                                width: 96px;
                                height: 24px;
                                options: ["PAT", "SONG"];
                                selected-index: root.song-mode ? 1 : 0;
                                selected(i) => {
                                    if ((i == 1) != root.song-mode) {
                                        root.song-mode = i == 1;
                                        root.playback-mode-changed(root.song-mode);
                                    }
                                }
                            }

                            ToolbarRule {}

                            PositionReadout {
                                bar: root.position-bar;
                                beat: root.position-beat;
                                tick: root.position-tick;
                                changed hovered => {
                                    root.hover-hint = self.hovered ? "Position as bar:beat:tick"
                                        : root.hover-hint == "Position as bar:beat:tick" ? "" : root.hover-hint;
                                }
                            }
                            BeatLamps {
                                current: root.beat-in-bar;
                                running: root.playing;
                            }

                            ToolbarRule {}

                            TempoField {
                                controlled: false;
                                bpm <=> root.bpm;
                                changed(v) => { root.bpm-changed(v); }
                                changed hovered => {
                                    root.hover-hint = self.hovered
                                        ? "Drag to change, double-click to type."
                                        : root.hover-hint == "Drag to change, double-click to type."
                                            ? "" : root.hover-hint;
                                }
                            }

                            StepperField {
                                controlled: false;
                                label: "SWING";
                                tooltip: "Swing";
                                hint: "Global sixteenth-note swing; 50% is straight";
                                value <=> root.swing-percent;
                                minimum: 50;
                                maximum: 75;
                                display-text: root.swing-percent + "%";
                                value-width: 28px;
                                changed(v) => { root.swing-changed(v); }
                            }

                            Rectangle { horizontal-stretch: 1; min-width: 8px; }

                            MasterMeter {
                                width: 200px;
                                left-db: root.meter-l-db;
                                right-db: root.meter-r-db;
                                held-left-db: root.meter-l-held-db;
                                held-right-db: root.meter-r-held-db;
                                left-clipping: root.meter-l-clipping;
                                right-clipping: root.meter-r-clipping;
                                clip-reset => { root.master-clip-reset(); }
                            }

                            IconButton {
                                text: "⚙";
                                tooltip: "Preferences";
                                clicked => {
                                    root.preferences-opened();
                                    root.preferences-open = true;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border; opacity: 0.6; }

                }
            }


            // ===== Work area =====
            //
            // Everything between the toolbar and the status bar, as one column
            // with the browser sidebar docked on the right. The sidebar sits in
            // flow, so the work surface narrows around it instead of hiding
            // under it.
            HorizontalLayout {
                spacing: 0px;

                // ===== Channel sidebar =====
                //
                // The mirror of the browser on the other side of the window,
                // and deliberately the same mechanism: always in flow so
                // hide/show animates the width rather than snapping the
                // layout, clipped content so the panel can reach zero, and
                // the grip outside the clip because pointer events are cut
                // along with pixels. What differs is the side: this grip
                // rides the panel's *right* edge, so dragging right widens.
                Rectangle {
                    width: root.channel-sidebar-visible ? root.channel-sidebar-width : 0px;
                    background: Theme.panel;
                    animate width {
                        duration: Motion.duration;
                        easing: Motion.curve;
                        enabled: !Motion.gesture-active;
                    }

                    Rectangle {
                        clip: true;
                        x: 0;
                        width: parent.width;
                        height: parent.height;

                        ChannelSidebar {
                            width: root.channel-sidebar-width;
                            height: parent.height;
                            // **The selection the rack already has.** A track
                            // is being edited exactly when the rack says so,
                            // so the panel and the device face below it cannot
                            // end up describing two different things.
                            is-track: root.editing-bus;
                            channel-name: root.editing-bus
                                ? root.editing-bus-name : root.selected-channel-name;
                            channel-number: (root.editing-bus
                                ? root.editing-bus-index : root.selected-channel) + 1;
                            has-color: root.editing-bus
                                ? root.editing-bus-has-color : root.selected-channel-has-color;
                            tint: root.editing-bus
                                ? root.editing-bus-color : root.selected-channel-color;
                            color-hex: root.editing-bus
                                ? root.editing-bus-color-hex : root.selected-channel-color-hex;
                            color-choices: root.color-choices;
                            midi-input-options: root.midi-input-options;
                            midi-input-index: root.midi-input-index;
                            midi-input-missing: root.midi-input-missing;
                            midi-input-missing-name: root.midi-input-missing-name;
                            midi-channel-options: root.midi-channel-options;
                            midi-channel-index: root.midi-channel-index;
                            audio-input-options: root.audio-input-options;
                            audio-input-index: root.audio-input-index;
                            audio-input-missing: root.audio-input-missing;
                            audio-input-is-hardware: root.audio-input-is-hardware;
                            audio-monitor: root.audio-monitor;
                            audio-input-level-db: root.audio-input-level-db;
                            audio-input-held-db: root.audio-input-held-db;
                            audio-monitor-toggled(on) => { root.audio-monitor-toggled(on); }
                            midi-input-picked(row) => { root.midi-input-picked(row); }
                            midi-channel-picked(row) => { root.midi-channel-picked(row); }
                            audio-input-picked(row) => { root.audio-input-picked(row); }
                            // The renames the rest of the interface already
                            // does. A second callback for either would be a
                            // second way to rename the same thing, and they
                            // would drift.
                            renamed(value) => {
                                if (root.editing-bus) {
                                    root.track-renamed(root.editing-bus-index, value);
                                } else {
                                    root.channel-renamed(root.selected-channel, value);
                                }
                            }
                            color-chosen(value) => {
                                if (root.editing-bus) {
                                    root.track-color-chosen(root.editing-bus-index, value);
                                } else {
                                    root.channel-color-chosen(value);
                                }
                            }
                            // The sends of whichever track is selected. The
                            // same model the mixer strip draws from, and the
                            // same callbacks the face used to raise.
                            sends: root.editing-bus-sends;
                            bus-names: root.bus-names;
                            // The channel's mixer destination, read out of
                            // the rack's own row rather than published a
                            // second time: `sync_row_flags` already keeps
                            // `bus` current for the picker the rack row
                            // draws, and two publishes of one routing
                            // decision is how the copies in this codebase
                            // start.
                            channel-bus: root.channels[root.selected-channel].bus;
                            bus-picked(b) => {
                                root.channel-bus-changed(root.selected-channel, b);
                            }
                            send-allowed: root.editing-bus-send-allowed;
                            track-index: root.editing-bus-index;
                            is-master: root.editing-bus-is-master;
                            send-added(t) => { root.send-added(root.editing-bus-index, t); }
                            send-removed(i) => { root.send-removed(root.editing-bus-index, i); }
                            send-level-changed(i, v) => {
                                root.send-level-changed(root.editing-bus-index, i, v);
                            }
                            send-tap-picked(i, t) => {
                                root.send-tap-picked(root.editing-bus-index, i, t);
                            }
                            send-enable-toggled(i) => {
                                root.send-enable-toggled(root.editing-bus-index, i);
                            }
                            // MIX: the rack row's four for a channel, the
                            // track face's four for a track -- the same rows
                            // and the same verbs, so two views of one edit.
                            muted: root.editing-bus
                                ? root.editing-bus-muted : root.channels[root.selected-channel].muted;
                            soloed: root.editing-bus
                                ? root.editing-bus-solo : root.channels[root.selected-channel].solo;
                            solo-enabled: !(root.editing-bus && root.editing-bus-is-master);
                            volume-db: root.editing-bus
                                ? GainMath.linear-to-db(root.editing-bus-volume)
                                : root.channels[root.selected-channel].volume-db;
                            pan: root.editing-bus
                                ? root.editing-bus-pan : root.channels[root.selected-channel].pan;
                            mute-toggled => {
                                if (root.editing-bus) {
                                    root.bus-muted(root.editing-bus-index);
                                } else {
                                    root.channel-muted(root.selected-channel);
                                }
                            }
                            solo-toggled => {
                                if (root.editing-bus) {
                                    root.bus-solo-toggled(root.editing-bus-index);
                                } else {
                                    root.channel-soloed(root.selected-channel);
                                }
                            }
                            volume-changed(db) => {
                                if (root.editing-bus) {
                                    root.bus-volume-changed(root.editing-bus-index, GainMath.db-to-linear(db));
                                } else {
                                    root.channel-volume-changed(root.selected-channel, GainMath.db-to-linear(db));
                                }
                            }
                            pan-changed(v) => {
                                if (root.editing-bus) {
                                    root.bus-pan-changed(root.editing-bus-index, v);
                                } else {
                                    root.channel-pan-changed(root.selected-channel, v);
                                }
                            }
                        }

                        // The panel's own right edge, drawn inside the clip so
                        // it disappears with the panel.
                        Rectangle {
                            x: parent.width - 1px;
                            y: 0;
                            width: 1px;
                            height: parent.height;
                            background: channel-grip.has-hover || channel-grip.pressed
                                ? Theme.focus : Theme.border;
                        }
                    }

                    channel-grip := TouchArea {
                        x: parent.width - 1px;
                        width: 6px;
                        height: parent.height;
                        enabled: root.channel-sidebar-visible;
                        mouse-cursor: ew-resize;
                        property <length> grab-x;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                Motion.gesture-active = true;
                                self.grab-x = self.mouse-x;
                            } else if (e.kind == PointerEventKind.move && self.pressed) {
                                // Dragging right widens, so the offset adds
                                // where the browser's subtracts. The moving
                                // origin is the same: the grip travels with
                                // the edge it sets, so each event folds its
                                // own offset into the current width.
                                let target = root.channel-sidebar-width
                                    + (self.mouse-x - self.grab-x);
                                let clamped = max(180px, min(target,
                                    root.sidebar-ceiling(root.sidebar-visible
                                        ? root.sidebar-width : 0px)));
                                if (clamped != target) {
                                    // A bound swallowed the move; re-anchor so
                                    // reversing direction responds immediately
                                    // instead of unwinding the overshoot.
                                    self.grab-x = self.mouse-x;
                                }
                                root.channel-sidebar-width = clamped;
                            } else if (e.kind == PointerEventKind.up
                                    || e.kind == PointerEventKind.cancel) {
                                Motion.gesture-active = false;
                                root.layout-changed();
                            }
                        }
                    }
                }

                // The work container. Every slot rectangle is computed here rather
                // than nested in layouts, because a view lives in exactly one slot
                // and therefore needs exactly one instance: what changes when a view
                // moves is where it is drawn, not which subtree draws it.
                //
                // The explicit `preferred-*` is load-bearing. Without it the
                // Rectangle sizes to its children while its children read their size
                // back off it, and the layout closes a loop through `layoutinfo-v`.
                work := Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    preferred-width: 0px;
                    preferred-height: 0px;
                    background: Theme.background;

                    // 0 main, 1 split, 2 bottom. The 1px is the divider each pair of
                    // slots is separated by; it collapses with the dock.
                    property <length> gap: root.bottom-pane-visible ? 1px : 0px;
                    property <length> top-h: self.height - root.bottom-extent - self.gap;
                    property <length> main-w: root.split-active >= 0
                        ? (self.width - 1px) * root.split-fraction
                        : self.width;
                    // The landing. Worked out here, from this element's own
                    // bounds, because the tab that started the drag knows
                    // nothing about them -- the split of labour `RackDrag`
                    // records. A plain derived property rather than something
                    // written into the global on every move: there is nothing
                    // to keep in sync if the answer is simply computed.
                    property <length> ptr-x: PaneDrag.pointer-x - self.absolute-position.x;
                    property <length> ptr-y: PaneDrag.pointer-y - self.absolute-position.y;
                    // -1 when no drag is live or the pointer is nowhere it may
                    // land. Dropping on the right edge of an unsplit top pane
                    // opens the split, which is how the split gets made
                    // without knowing the chip exists.
                    property <bool> would-open-split: PaneDrag.active
                        && root.split-active < 0
                        && self.ptr-y <= self.top-h
                        && self.ptr-x > self.width * 0.72;
                    property <int> drop-slot:
                        !PaneDrag.active ? -1
                        : (root.bottom-pane-visible && self.ptr-y > self.top-h) ? 2
                        : root.split-active >= 0
                            ? (self.ptr-x < self.main-w ? 0 : 1)
                        : self.would-open-split ? 1
                        : 0;

                    function slot-rect(s: int) -> PaneRect {
                        // A zoomed slot is the work area. Everything else is
                        // not drawn at all, so its rectangle never matters.
                        return root.zoomed >= 0
                            ? { x: 0px, y: 0px, width: self.width, height: self.height }
                            : s == 0
                            ? { x: 0px, y: 0px, width: self.main-w, height: self.top-h }
                            : s == 1
                            ? { x: self.main-w + 1px, y: 0px,
                                width: self.width - self.main-w - 1px, height: self.top-h }
                            : { x: 0px, y: self.top-h + self.gap,
                                width: self.width, height: root.bottom-extent };
                    }

                    // ===== STEPS =====
                    // The channel rack, and the row that used to sit in the toolbar
                    // block above the work area -- which is exactly why there could
                    // only ever be one of it.
                    ViewSlot {
                        rect: work.slot-rect(root.steps-slot);
                        shown: root.view-showing(PaneViews.steps, root.steps-slot);
                        VerticalLayout {
                            spacing: 0px;
                            PaneToolbar {
                                PaneTabs {
                                    view-slots: root.view-slots;
                                    slot: root.steps-slot;
                                    can-leave: root.steps-slot != 0
                                        || root.main-view-count() > 1;
                                    active: root.slot-active(root.steps-slot);
                                    zoomed: root.zoomed == root.steps-slot;
                                    picked(v) => { root.view-picked(v); }
                                    zoom-toggled() => { root.toggle-zoom(root.steps-slot); }
                                    drag-started(v) => { root.view-drag-started(v); }
                                    drag-dropped(v) => { root.view-drag-dropped(v); }
                                    move-requested(v, s) => { root.move-view(v, s); }
                                }
                                // The rule separates the tab strip from the
                                // controls the selected view owns. MIXER has
                                // none, so its row omits the rule rather than
                                // leaving one to separate nothing.
                                ToolbarRule {}

                                // Pattern selection is a stepper plus a jump list, so
                                // it costs the same width at 2 patterns and at 200.
                                ToolbarLabel { text: "PAT"; }
                                Rectangle {
                                    height: 24px;
                                    width: pattern-group.preferred-width;
                                    border-radius: Theme.radius-md;
                                    background: Theme.surface-raised;
                                    pattern-group := HorizontalLayout {
                                        spacing: 0px;
                                        StepperField {
                                            value: root.current-pattern + 1;
                                            minimum: 1;
                                            maximum: root.pattern-count;
                                            tooltip: "Selected pattern";
                                            value-width: 26px;
                                            field-background: transparent;
                                            changed(v) => { root.pattern-selected(v - 1); }
                                        }
                                        MenuField {
                                            options: root.pattern-menu-options;
                                            selected-index: root.current-pattern;
                                            display-text: "";
                                            field-width: 0px;
                                            menu-width: 180px;
                                            tooltip: "Jump to pattern";
                                            field-background: transparent;
                                            selected(i) => { root.pattern-selected(i); }
                                        }
                                    }
                                }
                                NameField {
                                    text: root.current-pattern-name;
                                    placeholder: root.pattern-label(root.current-pattern);
                                    tooltip: "Name this pattern";
                                    edited(t) => { root.pattern-renamed(root.current-pattern, t); }
                                }
                                // Beside the name, because they are the same
                                // kind of fact about a pattern and the panel
                                // that holds the channel's pair is a channel
                                // panel. A chip and a popup rather than the
                                // swatches outright: this is a toolbar.
                                ColorChipButton {
                                    choices: root.color-choices;
                                    has-color: root.current-pattern-has-color;
                                    tint: root.current-pattern-color;
                                    color-hex: root.current-pattern-color-hex;
                                    tooltip: "Color this pattern";
                                    chosen(value) => {
                                        root.pattern-color-chosen(root.current-pattern, value);
                                    }
                                }
                                IconButton {
                                    text: "+";
                                    tooltip: "Add Pattern";
                                    size: 24px;
                                    enabled: !root.project-edit-pending && root.pattern-count < root.max-patterns;
                                    clicked => { root.add-pattern-clicked(); }
                                }

                                ToolbarRule {}

                                // Tool modes. The glyph row is the answer to "what
                                // will my next drag across the grid do".
                                ToolModeButton {
                                    icon: ToolIcons.select; name: "Select";
                                    hint: "Click toggles a step. Ctrl-drag sets velocity.";
                                    active: root.tool-mode == 0;
                                    clicked => { root.tool-mode = 0; }
                                }
                                ToolModeButton {
                                    icon: ToolIcons.paint; name: "Paint";
                                    hint: "Drag to fill steps. Right-drag to clear.";
                                    active: root.tool-mode == 1;
                                    clicked => { root.tool-mode = 1; }
                                }
                                ToolModeButton {
                                    icon: ToolIcons.slice; name: "Slice";
                                    hint: "Click a step to ratchet it into even hits.";
                                    active: root.tool-mode == 2;
                                    clicked => { root.tool-mode = 2; }
                                }
                                ToolModeButton {
                                    icon: ToolIcons.stretch; name: "Stretch";
                                    hint: "Drag a step sideways to set its length.";
                                    active: root.tool-mode == 3;
                                    clicked => { root.tool-mode = 3; }
                                }
                                if root.tool-mode == 2 : StepperField {
                                    controlled: false;
                                    label: "×";
                                    value <=> root.slice-divisions;
                                    minimum: 2;
                                    maximum: 4;
                                    tooltip: "Hits per sliced step";
                                    value-width: 18px;
                                }

                                ToolbarRule {}

                                StepperField {
                                    controlled: false;
                                    label: "STEPS";
                                    value <=> root.pattern-length;
                                    minimum: 1;
                                    maximum: 256;
                                    // A beat at a time with Shift, which is the
                                    // unit the grid is drawn in: sixteen steps to
                                    // thirty-two is four shift-clicks rather than
                                    // sixteen.
                                    coarse-step: 4;
                                    tooltip: "Steps";
                                    hint: "Length of the selected pattern in 16th-note steps. Shift moves a beat at a time.";
                                    changed(v) => { root.pattern-length-changed(v); }
                                }
                                MenuField {
                                    label: "GROUP";
                                    options: root.step-group-options;
                                    selected-index: root.step-group-index;
                                    field-width: 22px;
                                    menu-width: 90px;
                                    tooltip: "Group";
                                    hint: "Cells between accents on the rack grid";
                                    selected(i) => {
                                        root.step-group-index = i;
                                        root.step-group = i == 0 ? 2 : i == 1 ? 3 : i == 2 ? 4
                                            : i == 3 ? 6 : i == 4 ? 8 : i == 5 ? 12 : 16;
                                    }
                                }
                                // Snap is not here. It belongs to whichever
                                // editor is open in the *bottom* dock, which is
                                // why the one that used to sit here had to ask
                                // `editor-page` which of two indices it was
                                // editing -- while the piano roll and the
                                // playlist each carried a snap control of their
                                // own. Three controls, one setting, in two
                                // halves of the window.
                                Rectangle { horizontal-stretch: 1; }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                viewport-width: max(self.visible-width, 340px + root.pattern-length * 27px);
                                viewport-height: max(self.visible-height, root.channels.length * 32px + 48px);

                                VerticalBox {
                                    spacing: 2px;
                                    padding: 8px;

                                    // The row keeps its seat in the layout and its
                                    // *contents* slide, which is how the device rack
                                    // does it and is not a stylistic echo: `hot` is
                                    // answered from `absolute-position`, so the thing
                                    // that answers it must not be the thing that moves.
                                    for row[ch] in root.channels : channel-row := Rectangle {
                                        // A row is as tall as its contents and no
                                        // taller. This wrapper replaced a bare
                                        // `HorizontalBox` when the drag landed, and a
                                        // `Rectangle` stretches by default where a
                                        // layout does not -- four channels in a tall
                                        // rack became four 80px slabs.
                                        //
                                        // Three things had to be true, and refusing to
                                        // stretch is only the first. A `VerticalBox`
                                        // whose children *all* refuse divides the slack
                                        // between them anyway, which the spacer below
                                        // the add row absorbs. And a wrapper with
                                        // nothing to size to collapses to nothing: the
                                        // contents carry an explicit `y` so the drag
                                        // can slide them, and an explicitly positioned
                                        // child does not report a height to its parent.
                                        // Hence the height is asked for by name. The
                                        // rows drew four names on one line before this
                                        // line existed.
                                        vertical-stretch: 0;
                                        height: row-content.preferred-height;
                                        property <bool> dragging: ChannelDrag.source == ch;
                                        // Which row the pointer is over, answered by the
                                        // row itself from its own bounds. One row is hot
                                        // at a time because the rows tile the rack.
                                        property <bool> hot: ChannelDrag.active
                                            && ChannelDrag.pointer-y >= self.absolute-position.y
                                            && ChannelDrag.pointer-y < self.absolute-position.y + self.height;
                                        changed hot => { if (self.hot) { ChannelDrag.target = ch; } }
                                        changed dragging => {
                                            if (self.dragging) { ChannelDrag.source-height = self.height; }
                                        }
                                        // The rows between the grab and the landing slide
                                        // aside. The gap *is* the drop indicator: it opens
                                        // exactly one row's pitch, where the dragged row is
                                        // about to sit, so there is nothing to reconcile
                                        // between a marker and the result.
                                        property <length> shift: ReorderMath.shift(
                                            ch, ChannelDrag.source, ChannelDrag.target, ChannelDrag.source-height);
                                        animate shift { duration: Motion.duration; easing: Motion.curve; }
                                        // No `z` here to lift the dragged row over the ones
                                        // it passes: Slint 1.17 requires `z` to be a number
                                        // *literal*, so it cannot be conditional. The device
                                        // rack has the same constraint and answers it the
                                        // same way -- the held row is marked out by its own
                                        // chrome (the plate's shadow below) rather than by
                                        // stacking order, and the gap that opens under it is
                                        // the drop indicator either way.

                                        row-content := HorizontalBox {
                                        y: channel-row.shift + (channel-row.dragging ? ChannelDrag.dy : 0px);
                                        opacity: channel-row.dragging ? 0.95 : 1.0;
                                        padding: 2px;
                                        spacing: 6px;
                                        alignment: start;

                                        // Channel name selects the channel for the bottom editor.
                                        Rectangle {
                                            width: 88px;
                                            min-height: 24px;
                                            border-radius: Theme.radius-md;
                                            // **A wash, where the channel's own
                                            // colour is a bar.** Twelve per cent
                                            // of the track's colour over
                                            // whichever base the selection asks
                                            // for -- enough to group a drum bus
                                            // at a glance, little enough that the
                                            // selected plate still reads as
                                            // selected and the channel's own bar
                                            // still reads as its own. Chosen by
                                            // rendering 0, 6, 12 and 20 per cent
                                            // side by side: at 20 the tint starts
                                            // arguing with the selection.
                                            background: row.has-track-color
                                                ? (row.selected ? Theme.surface-active : Theme.surface)
                                                    .mix(row.track-color, 0.88)
                                                : (row.selected ? Theme.surface-active : Theme.surface);
                                            // The plate is what the pointer is holding, so it
                                            // is what says it is being held.
                                            drop-shadow-blur: channel-row.dragging ? 16px : 0px;
                                            drop-shadow-color: #00000099;
                                            drop-shadow-offset-y: channel-row.dragging ? 6px : 0px;
                                            // The channel's colour, as the
                                            // plate's left edge. A bar rather
                                            // than a tinted plate: the plate
                                            // already says whether the channel
                                            // is selected, and a background
                                            // carrying two meanings can say
                                            // neither clearly. It holds its
                                            // 3px whether or not there is a
                                            // colour, so naming a channel does
                                            // not shift its name sideways.
                                            if row.has-color : Rectangle {
                                                x: 0;
                                                width: 3px;
                                                height: parent.height;
                                                background: row.color;
                                                border-top-left-radius: Theme.radius-md;
                                                border-bottom-left-radius: Theme.radius-md;
                                            }
                                            Text {
                                                text: row.name;
                                                // Dimmed while somebody else's solo is
                                                // silencing this channel, the way a mixer
                                                // strip's name is: the channel is still
                                                // there and still set up, it is just not
                                                // being heard, which is a different thing
                                                // from being muted and should not look the
                                                // same.
                                                color: row.solo-silenced
                                                    ? Theme.text-faint
                                                    : row.selected ? Theme.text : Theme.text-muted;
                                                font-size: Theme.text-xl;
                                                horizontal-alignment: left;
                                                vertical-alignment: center;
                                                x: 6px;
                                            }
                                            // Selects on press and reorders on release, the
                                            // way the device rack's header handle does. A press
                                            // that never left its own row is a selection and
                                            // nothing else: the row under the pointer *is* the
                                            // answer, so staying put already means "no move"
                                            // however far the pointer wandered inside it.
                                            TouchArea {
                                                mouse-cursor: move;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down) {
                                                        root.channel-selected(ch);
                                                        if (e.button == PointerEventButton.right) {
                                                            channel-context-menu.show();
                                                        } else if (!root.project-edit-pending) {
                                                            ChannelDrag.source = ch;
                                                            ChannelDrag.target = ch;
                                                            ChannelDrag.dy = 0px;
                                                            // Seeded here as well as in `moved`, so
                                                            // the rows do not decide who is under
                                                            // the pointer from the last drag's
                                                            // position before this one has moved.
                                                            ChannelDrag.grab-y = self.absolute-position.y + self.mouse-y;
                                                            ChannelDrag.pointer-y = ChannelDrag.grab-y;
                                                            ChannelDrag.active = true;
                                                        }
                                                    }
                                                    if (e.kind == PointerEventKind.up && ChannelDrag.active) {
                                                        if (ChannelDrag.target != ch && ChannelDrag.target >= 0) {
                                                            root.channel-reorder-requested(ch,
                                                                clamp(ChannelDrag.target, 0, root.channels.length - 1));
                                                        }
                                                        ChannelDrag.end();
                                                    }
                                                }
                                                moved => {
                                                    if (ChannelDrag.active) {
                                                        ChannelDrag.pointer-y = self.absolute-position.y + self.mouse-y;
                                                        ChannelDrag.dy = ChannelDrag.pointer-y - ChannelDrag.grab-y;
                                                    }
                                                }
                                            }

                                            // The menu is anchored to the channel name, so it
                                            // opens beside the row that owns its commands instead
                                            // of at a disconnected fixed screen coordinate.
                                            channel-context-menu := PopupWindow {
                                                x: 0px;
                                                y: parent.height + 2px;
                                                width: 172px;
                                                height: context-frame.preferred-height;
                                                close-policy: close-on-click;
                                                context-frame := Rectangle {
                                                    background: Theme.surface;
                                                    border-width: Theme.hairline;
                                                    border-color: Theme.border;
                                                    border-radius: Theme.radius-md;
                                                    VerticalLayout {
                                                        padding: 4px;
                                                        MenuRow { text: "Cut Channel"; shortcut: "Ctrl+X"; enabled: !root.project-edit-pending && root.channels.length > 1; selected => { root.edit-command-requested(2, ch); } }
                                                        MenuRow { text: "Copy Channel"; shortcut: "Ctrl+C"; selected => { root.edit-command-requested(3, ch); } }
                                                        MenuRow { text: "Paste Channel"; shortcut: "Ctrl+V"; enabled: !root.project-edit-pending && root.channel-clipboard-available && root.channels.length < root.max-channels; selected => { root.edit-command-requested(4, ch); } }
                                                        MenuSeparator {}
                                                        MenuRow { text: "Clone Channel"; enabled: !root.project-edit-pending && root.channels.length < root.max-channels; selected => { root.edit-command-requested(5, ch); } }
                                                        MenuRow { text: "Delete Channel"; enabled: !root.project-edit-pending && root.channels.length > 1; selected => { root.edit-command-requested(6, ch); } }
                                                    }
                                                }
                                            }
                                        }

                                        ChannelMuteSolo {
                                            muted: row.muted;
                                            soloed: row.solo;
                                            mute-hint: "Silence this channel. Its devices keep running, so tails decay rather than freeze.";
                                            solo-hint: "Hear this channel alone. Solo is in place: the other channels go quiet and this one keeps its own level, pan and mute.";
                                            mute-toggled => { root.channel-muted(ch); }
                                            solo-toggled => { root.channel-soloed(ch); }
                                        }

                                        // Volume and pan are knobs here, not faders: the rack row
                                        // is for steps, and a pair of 22px knobs costs a fifth of
                                        // the width a labelled fader did. Names and values live in
                                        // the tooltips.
                                        TrimKnob {
                                            label: "Volume";
                                            value: row.volume-db;
                                            // The mixer fader's ceiling, which is the volume
                                            // descriptor's: no control reaches a gain another
                                            // cannot (MOO-131).
                                            maximum: GainMath.fader-db[0];
                                            changed(v) => { root.channel-volume-changed(ch, GainMath.db-to-linear(v)); }
                                        }

                                        MiniKnob {
                                            label: "Pan";
                                            value: row.pan;
                                            minimum: -1;
                                            maximum: 1;
                                            default-value: 0;
                                            bipolar: true;
                                            value-text: abs(row.pan) < 0.01 ? "Center"
                                                : row.pan < 0 ? "L " + round(abs(row.pan) * 100)
                                                : "R " + round(row.pan * 100);
                                            changed(v) => { root.channel-pan-changed(ch, v); }
                                        }

                                        // Where this channel lands in the mixer. It sits with the
                                        // other output controls rather than in the mixer pane,
                                        // because it is a property of the channel.
                                        BusPicker {
                                            bus-names: root.bus-names;
                                            value: row.bus;
                                            tooltip: "Mixer bus for this channel";
                                            picked(b) => { root.channel-bus-changed(ch, b); }
                                        }

                                        // Beat grouping remains visible at any pattern length.
                                        //
                                        // One hit area covers the whole run of steps and derives
                                        // the cell from mouse-x. Per-cell TouchAreas cannot support
                                        // a drag: the cell where the press landed keeps the grab,
                                        // so the pointer never reaches its neighbours.
                                        Rectangle {
                                            property <length> cell-pitch: 27px;
                                            property <int> step-count: row.steps.length;
                                            width: self.step-count * self.cell-pitch - 3px;
                                            height: 24px;

                                            pure function step-at(x: length) -> int {
                                                return clamp(floor(x / self.cell-pitch), 0, self.step-count - 1);
                                            }

                                            HorizontalLayout {
                                                spacing: 3px;
                                                for cell[i] in row.steps : Rectangle {
                                                    width: 24px;
                                                    height: 24px;
                                                    border-radius: Theme.radius-sm;
                                                    clip: true;
                                                    border-width: root.playing && root.current-step == i ? Theme.hairline : 0px;
                                                    border-color: Theme.text;
                                                    background: mod(i, root.step-group) == 0
                                                        ? Theme.surface-active : Theme.surface-raised;
                                                    for sub in 4 : Rectangle {
                                                        property <int> divisor: sub == 0 ? 1 : sub == 1 ? 2 : sub == 2 ? 4 : 8;
                                                        property <bool> onset: mod(floor(cell.onsets / self.divisor), 2) == 1;
                                                        visible: mod(floor(cell.substeps / self.divisor), 2) == 1;
                                                        x: sub * parent.width / 4;
                                                        y: parent.height - self.height;
                                                        width: parent.width / 4;
                                                        height: max(3px, parent.height * cell.velocity / 127);
                                                        border-radius: 0px;
                                                        background: Theme.accent;
                                                        // A struck slot is solid; one that is only
                                                        // being held stays dim, so a ratchet reads
                                                        // differently from a single sustained note.
                                                        opacity: (self.onset ? 1.0 : 0.3)
                                                            * (0.55 + 0.45 * cell.velocity / 127);
                                                    }
                                                }
                                            }

                                            grid-touch := TouchArea {
                                                // -1 means "no drag in progress"; it is not a step.
                                                property <int> last-step: -1;
                                                property <int> stretch-origin: -1;
                                                property <bool> paint-on;
                                                property <bool> velocity-drag;
                                                // TouchArea.pressed only tracks the left button, so
                                                // a right-drag would report its first cell and then
                                                // go silent. Track the held button ourselves; this
                                                // also stops hover moves from painting.
                                                property <int> drag-button: -1;
                                                mouse-cursor: root.tool-mode == 1 ? crosshair
                                                    : root.tool-mode == 3 ? ew-resize : pointer;

                                                function paint-to(step: int) {
                                                    if (step != self.last-step) {
                                                        self.last-step = step;
                                                        root.step-painted(ch, step, self.paint-on);
                                                    }
                                                }

                                                pointer-event(e) => {
                                                    let step = parent.step-at(self.mouse-x);
                                                    if (e.kind == PointerEventKind.down) {
                                                        Gesture.begin();
                                                        self.drag-button =
                                                            e.button == PointerEventButton.right ? 1 : 0;
                                                        if (root.tool-mode == 1) {
                                                            // Left fills, right clears, for the
                                                            // whole drag. Toggling per cell would
                                                            // invert whatever it crossed.
                                                            self.paint-on = e.button == PointerEventButton.left;
                                                            self.last-step = -1;
                                                            self.paint-to(step);
                                                        } else if (root.tool-mode == 2) {
                                                            if (e.button == PointerEventButton.right) {
                                                                root.step-removed(ch, step);
                                                            } else {
                                                                root.step-sliced(ch, step, root.slice-divisions);
                                                            }
                                                        } else if (root.tool-mode == 3) {
                                                            if (e.button == PointerEventButton.right) {
                                                                root.step-length-dragged(ch, step, 1);
                                                            } else {
                                                                self.stretch-origin = step;
                                                                root.step-length-dragged(ch, step, 1);
                                                            }
                                                        } else if (e.button == PointerEventButton.right) {
                                                            root.step-removed(ch, step);
                                                        } else {
                                                            self.velocity-drag = e.modifiers.control;
                                                            if (self.velocity-drag) {
                                                                root.step-velocity-edited(ch, step,
                                                                    clamp(1 - self.mouse-y / self.height, 0, 1));
                                                            } else {
                                                                root.step-clicked(ch, step);
                                                            }
                                                        }
                                                    } else if (e.kind == PointerEventKind.move && self.drag-button >= 0) {
                                                        if (root.tool-mode == 1) {
                                                            self.paint-to(step);
                                                        } else if (root.tool-mode == 3 && self.stretch-origin >= 0) {
                                                            root.step-length-dragged(ch, self.stretch-origin,
                                                                max(1, step - self.stretch-origin + 1));
                                                        } else if (self.velocity-drag) {
                                                            root.step-velocity-edited(ch, step,
                                                                clamp(1 - self.mouse-y / self.height, 0, 1));
                                                        }
                                                    } else if (e.kind == PointerEventKind.up) {
                                                        self.drag-button = -1;
                                                        self.velocity-drag = false;
                                                        self.last-step = -1;
                                                        self.stretch-origin = -1;
                                                        Gesture.end();
                                                    }
                                                }
                                                // A pointer bubble cannot follow a drag across a
                                                // whole row, and a sentence explaining a gesture is
                                                // status-bar material rather than tooltip material
                                                // (`docs/UI_DESIGN.md`). The strip renders plain
                                                // text, so no markdown here.
                                                property <string> hint: root.tool-mode == 1
                                                    ? "Paint: drag to fill, right-drag to clear."
                                                    : root.tool-mode == 2
                                                    ? "Slice: click to ratchet into \{root.slice-divisions} hits, right-click clears."
                                                    : root.tool-mode == 3
                                                    ? "Stretch: drag right to lengthen, right-click resets."
                                                    : "Click to toggle. Ctrl-drag for velocity, right-click to clear.";
                                                changed has-hover => {
                                                    root.hover-hint = self.has-hover ? self.hint
                                                        : root.hover-hint == self.hint ? "" : root.hover-hint;
                                                }
                                            }
                                        }
                                        }
                                    }

                                    HorizontalBox {
                                        height: 28px;
                                        padding: 0px;
                                        spacing: 4px;
                                        alignment: start;
                                        AddSourceButton {
                                            enabled: !root.project-edit-pending && root.channels.length < root.max-channels;
                                            picked(i) => { root.add-channel-clicked(i); }
                                        }
                                        FlatButton {
                                            text: "−";
                                            tooltip: "Remove channel";
                                            enabled: !root.project-edit-pending && root.channels.length > 1;
                                            min-width: 28px; max-width: 28px;
                                            min-height: 24px; max-height: 24px;
                                            clicked => { root.remove-channel-clicked(); }
                                        }
                                    }

                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                    }

                    // ===== MIXER =====
                    // The one view with no controls of its own, so its row is the tab
                    // strip and nothing else. The rule that would have separated the
                    // strip from its controls is omitted rather than left to separate
                    // nothing.
                    ViewSlot {
                        rect: work.slot-rect(root.mixer-slot);
                        shown: root.view-showing(PaneViews.mixer, root.mixer-slot);
                        VerticalLayout {
                            spacing: 0px;
                            PaneToolbar {
                                PaneTabs {
                                    view-slots: root.view-slots;
                                    slot: root.mixer-slot;
                                    can-leave: root.mixer-slot != 0
                                        || root.main-view-count() > 1;
                                    active: root.slot-active(root.mixer-slot);
                                    zoomed: root.zoomed == root.mixer-slot;
                                    picked(v) => { root.view-picked(v); }
                                    zoom-toggled() => { root.toggle-zoom(root.mixer-slot); }
                                    drag-started(v) => { root.view-drag-started(v); }
                                    drag-dropped(v) => { root.view-drag-dropped(v); }
                                    move-requested(v, s) => { root.move-view(v, s); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            MixerPane {
                                strips: root.mixer-strips;
                                bus-names: root.bus-names;
                                bus-selected(i) => { root.bus-selected(i); }
                                bus-muted(i) => { root.bus-muted(i); }
                                bus-volume-changed(i, v) => { root.bus-volume-changed(i, v); }
                                bus-pan-changed(i, v) => { root.bus-pan-changed(i, v); }
                                bus-output-changed(i, o) => { root.bus-output-changed(i, o); }
                                bus-console-toggled(i) => { root.bus-console-toggled(i); }
                                bus-polarity-toggled(i) => { root.bus-polarity-toggled(i); }
                                bus-solo-toggled(i) => { root.bus-solo-toggled(i); }
                                bus-clip-reset(i) => { root.bus-clip-reset(i); }
                                bus-strip-param(i, id, v) => { root.bus-strip-param(i, id, v); }
                                bus-strip-point-dragged(i, band, hz, gain) => {
                                    root.bus-strip-point-dragged(i, band, hz, gain);
                                }
                                bus-voicing-picked(i, voicing) => { root.bus-voicing-picked(i, voicing); }
                                bus-send-added(i, t) => { root.send-added(i, t); }
                                bus-send-removed(i, send) => { root.send-removed(i, send); }
                                bus-send-level-changed(i, send, v) => { root.send-level-changed(i, send, v); }
                                bus-send-enable-toggled(i, send) => { root.send-enable-toggled(i, send); }
                                can-add-track: root.can-add-track;
                                track-added => { root.track-added(); }
                                project-edit-pending: root.project-edit-pending;
                                track-reorder-requested(from, to) => { root.track-reorder-requested(from, to); }
                            }
                        }
                    }

                    // ===== DEVICES =====
                    // The device chain. It keeps the channel preset browser, because
                    // a channel preset is the channel's sound and this is the view
                    // whose subject is the channel's sound.
                    ViewSlot {
                        rect: work.slot-rect(root.devices-slot);
                        shown: root.view-showing(PaneViews.devices, root.devices-slot);
                        VerticalLayout {
                            spacing: 0px;
                            PaneToolbar {
                                PaneTabs {
                                    view-slots: root.view-slots;
                                    slot: root.devices-slot;
                                    can-leave: root.devices-slot != 0
                                        || root.main-view-count() > 1;
                                    active: root.slot-active(root.devices-slot);
                                    zoomed: root.zoomed == root.devices-slot;
                                    picked(v) => { root.view-picked(v); }
                                    zoom-toggled() => { root.toggle-zoom(root.devices-slot); }
                                    drag-started(v) => { root.view-drag-started(v); }
                                    drag-dropped(v) => { root.view-drag-dropped(v); }
                                    move-requested(v, s) => { root.move-view(v, s); }
                                }
                                ToolbarRule {}
                                Text {
                                    text: "DEVICE CHAIN";
                                    color: Theme.text-faint;
                                    font-size: Theme.text-md;
                                    vertical-alignment: center;
                                }
                                // A picker rather than a bank of
                                // eight chips. Adam: "a toolbar
                                // button per instrument doesn't
                                // really make sense past
                                // prototyping" -- the bank cost
                                // 384px and grew by 48 with every
                                // instrument, and this is the
                                // widget the inventory already
                                // names for "an option set past
                                // what a segmented bank can
                                // carry".
                                if !root.editing-bus : PickerChip {
                                    width: 96px;
                                    height: 22px;
                                    options: SourceKinds.labels;
                                    hidden: SourceKinds.retired;
                                    selected-index: root.source-kind;
                                    tooltip: "Source device";
                                    picked(i) => {
                                        root.source-kind = i;
                                        root.channel-source-changed(i);
                                    }
                                }
                                // A bus has no generator and no generator
                                // preset, so the row states what it is instead.
                                if root.editing-bus : Text {
                                    text: root.editing-bus-name;
                                    color: Theme.text;
                                    font-size: Theme.text-xl;
                                    vertical-alignment: center;
                                }
                                if root.editing-bus : Text {
                                    text: root.editing-bus-is-master
                                        ? "Everything lands here"
                                        : "Effects here shape every channel routed to this bus";
                                    color: Theme.text-faint;
                                    font-size: Theme.text-md;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                // The channel this chain belongs to, and the whole-channel preset.
                                // It is here rather than on every view in the slot: a channel preset
                                // is the channel's sound, and this is the view whose subject is the
                                // channel's sound. On the piano roll it was noise.
                                Rectangle { horizontal-stretch: 1; }
                                // A bus reads its name here and renames it on its
                                // own face, which has room for a labelled field. A
                                // channel has no face of its own -- the face in this
                                // slot belongs to its *source* -- so the field is
                                // here, on the one view whose subject is the channel.
                                // Until this it could not be renamed at all: the name
                                // saved, loaded and drew on the rack plate, and the
                                // only way to change it was to make a different
                                // channel. Same gap `rename_track` closed for tracks.
                                if root.editing-bus : Text {
                                    text: root.editing-bus-name;
                                    color: Theme.text-muted;
                                    font-size: Theme.text-lg;
                                    vertical-alignment: center;
                                }
                                if !root.editing-bus : NameField {
                                    text: root.selected-channel-name;
                                    placeholder: "Channel";
                                    width: 96px;
                                    tooltip: "Rename this channel";
                                    edited(value) => {
                                        root.channel-renamed(root.selected-channel, value);
                                    }
                                }
                                if !root.editing-bus : MenuField {
                                    label: "CHANNEL PRESET";
                                    options: root.channel-preset-options;
                                    selected-index: -1;
                                    display-text: "Browse...";
                                    field-width: 90px;
                                    menu-width: 220px;
                                    tooltip: "Channel preset";
                                    hint: "Load a saved whole-channel preset (source + mixer)";
                                    selected(i) => { root.channel-preset-selected(i); }
                                }
                                if !root.editing-bus : IconButton {
                                    text: "💾";
                                    tooltip: "Save preset";
                                    hint: "Save this channel (source + mixer) as a preset";
                                    size: 24px;
                                    clicked => { root.save-channel-preset-requested(); }
                                }
                            }

                            device-chain-scroll := ScrollView {
                                vertical-stretch: 1;
                                // A preset dragged out of the browser lands here
                                // (MOO-9): the scroll answers from its own bounds
                                // whether the pointer is over it.
                                property <bool> drop-hot: BrowserDrag.active
                                    && BrowserDrag.pointer-x >= self.absolute-position.x
                                    && BrowserDrag.pointer-x < self.absolute-position.x + self.width
                                    && BrowserDrag.pointer-y >= self.absolute-position.y
                                    && BrowserDrag.pointer-y < self.absolute-position.y + self.height;
                                changed drop-hot => { BrowserDrag.over-rack = self.drop-hot; }
                                // Sized from the rack row's own intrinsic width, not
                                // a constant: the chain grows as devices are added,
                                // and faces are width-quantized in rack units, so a
                                // fixed figure leaves later devices unreachable.
                                viewport-width: max(self.visible-width, rack-row.preferred-width);
                                viewport-height: max(self.visible-height, DeviceRackMetrics.rack-height);

                                Rectangle {
                                    width: max(device-chain-scroll.visible-width, rack-row.preferred-width);
                                    // The panel fills whatever the scroll shows.
                                    // The chain itself is one face plus its
                                    // padding and no longer carries the shelf, so
                                    // a rectangle sized to the chain alone would
                                    // leave the window showing through below it.
                                    height: max(device-chain-scroll.visible-height,
                                        DeviceRackMetrics.rack-height);
                                    background: Theme.panel;
                                    // Where a dragged preset would land, lit.
                                    border-width: device-chain-scroll.drop-hot ? 2px : 0px;
                                    border-color: Theme.accent;

                                    // Centred in whatever the scroll shows rather
                                    // than pinned to its top: the shelf used to
                                    // ride inside this rectangle, and centring is
                                    // where the chain has always sat, so taking
                                    // the shelf out does not move a face.
                                    rack-row := HorizontalLayout {
                                        y: (parent.height - DeviceRackMetrics.rack-height) / 2;
                                        height: DeviceRackMetrics.rack-height;
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        // Vertical room for a container's box, which is
                                        // drawn around the faces rather than inside them.
                                        padding-top: DeviceRackMetrics.rack-padding;
                                        padding-bottom: DeviceRackMetrics.rack-padding;
                                        spacing: 0px;
                                        alignment: start;

                                        // The head of the chain: a channel's
                                        // generator, or the bus's own output stage
                                        // when the rack is following the mixer.
                                        source-device := DeviceFrame {
                                            // A device declares its own width in units, the
                                            // same way an effect slot does. DS-01 and the
                                            // ML-P8 are four: both spend pages rather than
                                            // one dense screen, and four is the width at
                                            // which a page holds three modules of 34px
                                            // dials without shrinking one. DS-01 was five
                                            // while it was one screen with no pages; the
                                            // pages gave that unit back.
                                            // Aux In is two: a source, an
                                            // outlet and a level is the whole
                                            // device, and a wider face would
                                            // be empty rather than generous.
                                            // A bus's head is 2U on its own -- a
                                            // destination and a name -- and 3U
                                            // when `STRIP_PIN` also pins the
                                            // strip's drive/EQ/comp here, the
                                            // same unit the EQ's response plot
                                            // gave back on 2026-09-11, spent on
                                            // the merged content instead of
                                            // margin.
                                            property <int> source-units: root.editing-bus
                                                ? (root.strip-pin-head ? 3 : 2)
                                                : root.source-kind == 7 ? 2
                                                : (root.source-kind == 6 || root.source-kind == 5 ? 4 : 3);
                                            width: DeviceRackMetrics.unit-width * self.source-units
                                                + DeviceRackMetrics.half-gap
                                                + DeviceRackMetrics.rail-width * 2;
                                            height: DeviceRackMetrics.face-height;
                                            input-left-db: root.editing-bus ? root.editing-bus-input-left-db : GainMath.min-db;
                                            input-right-db: root.editing-bus ? root.editing-bus-input-right-db : GainMath.min-db;
                                            output-left-db: root.editing-bus ? root.editing-bus-left-db : root.source-output-left-db;
                                            output-right-db: root.editing-bus ? root.editing-bus-right-db : root.source-output-right-db;
                                            output-trim-enabled: !root.editing-bus;
                                            output-trim: root.selected-channel-volume-db;
                                            output-trim-maximum-db: GainMath.fader-db[0];
                                            output-trim-changed(v) => {
                                                root.channel-volume-changed(root.selected-channel, GainMath.db-to-linear(v));
                                            }
                                            // The generator's presets belong on the generator,
                                            // in the same rail position an effect row keeps
                                            // them: one device, one place to save and load it.
                                            // A bus has no generator, so its rail has none.
                                            preset-enabled: !root.editing-bus;
                                            preset-options: root.generator-preset-options;
                                            preset-selected(i) => { root.generator-preset-selected(i); }
                                            save-preset-requested => { root.save-generator-preset-requested(); }
                                            // The generator can be selected like any rack row,
                                            // and wears the same border for it. A bus's output
                                            // stage cannot: it is not a device anything acts on.
                                            header-select-enabled: !root.editing-bus;
                                            header-clicked => { root.source-select-toggled(); }
                                            selected: root.source-selected;

                                            if root.editing-bus : BusDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                name: root.editing-bus-name;
                                                is-master: root.editing-bus-is-master;
                                                muted: root.editing-bus-muted;
                                                output: root.editing-bus-output;
                                                index: root.editing-bus-index;
                                                feed-count: root.editing-bus-feed-count;
                                                bus-names: root.bus-names;
                                                allowed: root.editing-bus-allowed;
                                                console: root.editing-bus-console;
                                                polarity: root.editing-bus-polarity;
                                                polarity-toggled => { root.bus-polarity-toggled(root.editing-bus-index); }
                                                can-remove: root.editing-bus-can-remove;
                                                output-picked(o) => { root.bus-output-changed(root.editing-bus-index, o); }
                                                console-toggled => { root.bus-console-toggled(root.editing-bus-index); }
                                                renamed(v) => { root.track-renamed(root.editing-bus-index, v); }
                                                removed => { root.track-removed(root.editing-bus-index); }
                                                // The strip's own drive/EQ/comp, bundled
                                                // in here exactly when `STRIP_PIN` pins
                                                // it to the head -- the same guard the
                                                // tail instance past the chain uses, so
                                                // the two positions stay mutually
                                                // exclusive.
                                                show-strip: root.strip-pin-head;
                                                units: source-device.source-units;
                                                strip: root.editing-bus-strip;
                                                track: root.editing-bus-index;
                                                moved(id, v) => { root.bus-strip-param(root.editing-bus-index, id, v); }
                                                switched(id, on) => { root.bus-strip-param(root.editing-bus-index, id, on ? 1 : 0); }
                                                voicing-picked(voicing) => { root.bus-voicing-picked(root.editing-bus-index, voicing); }
                                                point-dragged(band, hz, gain) => {
                                                    root.bus-strip-point-dragged(root.editing-bus-index, band, hz, gain);
                                                }
                                                // The *incoming* count stays: how many
                                                // sends feed this track is a fact about
                                                // it, where the sends it makes are edited
                                                // in the channel sidebar.
                                                send-feed-count: root.editing-bus-send-feed-count;
                                            }

                                            if !root.editing-bus && root.source-kind == 0 : SamplerDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: DeviceRackMetrics.header-height;
                                                width: parent.content-width;
                                                height: parent.height - DeviceRackMetrics.header-height;
                                                page <=> root.sampler-device-page;
                                                attack <=> root.attack;
                                                decay <=> root.decay;
                                                sustain <=> root.sustain;
                                                release <=> root.release;
                                                start-pos <=> root.start-pos;
                                                end-pos <=> root.end-pos;
                                                loop-start <=> root.loop-start;
                                                loop-end <=> root.loop-end;
                                                snap-to-zero <=> root.snap-to-zero;
                                                record-state: root.sampler-record-state;
                                                record-elapsed: root.sampler-record-elapsed;
                                                record-peaks: root.sampler-record-peaks;
                                                record-fill: root.sampler-record-fill;
                                                record-source: root.sampler-record-source;
                                                record-clip <=> root.sampler-record-clip;
                                                record-bars <=> root.sampler-record-bars;
                                                record-max-bars: root.sampler-record-max-bars;
                                                record-clicked() => { root.sampler-record-clicked(); }
                                                record-clip-changed(on) => { root.sampler-record-clip-changed(on); }
                                                record-bars-changed(bars) => { root.sampler-record-bars-changed(bars); }
                                                reverse-playback <=> root.reverse-playback;
                                                root-note <=> root.root-note;
                                                tune-semitones <=> root.tune-semitones;
                                                tune-cents <=> root.tune-cents;
                                                tune-label <=> root.tune-label;
                                                retune-live <=> root.retune-live;
                                                filter-cutoff <=> root.filter-cutoff;
                                                filter-resonance <=> root.filter-resonance;
                                                filter-env <=> root.filter-env;
                                                drive <=> root.sampler-drive;
                                                modulation-armed: root.modulation-armed-slot >= 0;
                                                modulation-depths: root.source-modulation-depths;
                                                modulation-allowed: root.source-modulation-allowed;
                                                modulation-offsets: root.source-modulation-offsets;
                                                modulation-route-counts: root.source-modulation-route-counts;
                                                bit-reduction <=> root.bit-reduction;
                                                rate-reduction <=> root.rate-reduction;
                                                output-gain <=> root.sampler-output-gain;
                                                filter-attack <=> root.sampler-filter-attack;
                                                filter-decay <=> root.sampler-filter-decay;
                                                filter-sustain <=> root.sampler-filter-sustain;
                                                filter-release <=> root.sampler-filter-release;
                                                filter-view <=> root.sampler-filter-view;
                                                loop-mode <=> root.loop-mode;
                                                loop-fade <=> root.sampler-loop-fade;
                                                loop-fade-label: root.sampler-loop-fade-label;
                                                loop-fade-start: root.sampler-loop-fade-start;
                                                loop-fade-end: root.sampler-loop-fade-end;
                                                loop-fade-shown: root.sampler-loop-fade-shown;
                                                loop-grid: root.sampler-loop-grid;
                                                loop-grid-options: root.sampler-loop-grid-options;
                                                loop-band-start: root.sampler-loop-band-start;
                                                loop-band-end: root.sampler-loop-band-end;
                                                play-mode <=> root.play-mode;
                                                slice-base-note <=> root.slice-base-note;
                                                slice-markers <=> root.slice-markers;
                                                slice-count <=> root.slice-count;
                                                committed <=> root.sample-committed;
                                                commit-label <=> root.commit-label;
                                                commit-stale <=> root.commit-stale;
                                                voice-mode <=> root.voice-mode;
                                                polyphony <=> root.sampler-polyphony;
                                                retrigger-mode <=> root.retrigger-mode;
                                                choke-group <=> root.choke-group;
                                                stretch-enabled <=> root.stretch-enabled;
                                                stretch-mode <=> root.stretch-mode;
                                                stretch-ratio <=> root.stretch-ratio;
                                                stretch-ratio-label <=> root.stretch-ratio-label;
                                                stretch-grain <=> root.stretch-grain;
                                                stretch-grain-label <=> root.stretch-grain-label;
                                                stretch-ratio-clean <=> root.stretch-ratio-clean;
                                                stretch-sync <=> root.stretch-sync;
                                                stretch-bars <=> root.stretch-bars;
                                                stretch-bars-label <=> root.stretch-bars-label;
                                                stretch-fit-label: root.stretch-fit-label;
                                                stretch-fit-warning: root.stretch-fit-warning;
                                                stretch-fit-hint: root.stretch-fit-hint;
                                                sample-name <=> root.sample-name;
                                                sample-description <=> root.sample-description;
                                                waveform <=> root.waveform;
                                                playhead-positions <=> root.playhead-positions;
                                                sample-frames <=> root.sample-frames;
                                                can-previous-sample <=> root.can-previous-sample;
                                                can-next-sample <=> root.can-next-sample;
                                                waveform-view-offset <=> root.waveform-view-offset;
                                                waveform-view-visible-fraction <=> root.waveform-view-visible-fraction;
                                                waveform-view-changed(o, f) => { root.waveform-view-changed(o, f); }
                                                attack-changed(v) => { root.attack-changed(v); }
                                                decay-changed(v) => { root.decay-changed(v); }
                                                sustain-changed(v) => { root.sustain-changed(v); }
                                                release-changed(v) => { root.release-changed(v); }
                                                start-pos-changed(v) => { root.start-pos-changed(v); }
                                                end-pos-changed(v) => { root.end-pos-changed(v); }
                                                loop-start-changed(v) => { root.loop-start-changed(v); }
                                                loop-end-changed(v) => { root.loop-end-changed(v); }
                                                snap-to-zero-changed(v) => { root.snap-to-zero-changed(v); }
                                                snap-markers-clicked() => { root.snap-markers-clicked(); }
                                                reverse-playback-changed(v) => { root.reverse-playback-changed(v); }
                                                root-note-changed(v) => { root.root-note-changed(v); }
                                                tune-semitones-changed(v) => { root.tune-semitones-changed(v); }
                                                tune-cents-changed(v) => { root.tune-cents-changed(v); }
                                                retune-live-changed(v) => { root.retune-live-changed(v); }
                                                loop-mode-changed(v) => { root.loop-mode-changed(v); }
                                                loop-fade-changed(v) => { root.sampler-loop-fade-changed(v); }
                                                loop-grid-changed(i) => { root.sampler-loop-grid-changed(i); }
                                                play-mode-changed(v) => { root.play-mode-changed(v); }
                                                slice-base-note-changed(v) => { root.slice-base-note-changed(v); }
                                                slice-added(p) => { root.slice-added(p); }
                                                slice-moved(i, p) => { root.slice-moved(i, p); }
                                                slice-removed(i) => { root.slice-removed(i); }
                                                slice-auditioned(i) => { root.slice-auditioned(i); }
                                                slice-audition-released(i) => { root.slice-audition-released(i); }
                                                slices-divided(n) => { root.slices-divided(n); }
                                                slices-cleared() => { root.slices-cleared(); }
                                                slice-preview: root.slice-preview;
                                                slice-preview-markers: root.slice-preview-markers;
                                                slices-detect(sensitivity, spacing) => { root.slices-detect(sensitivity, spacing); }
                                                slices-accept(how) => { root.slices-accept(how); }
                                                slices-cancel() => { root.slices-cancel(); }
                                                slices-to-pattern(replace, grid) => { root.slices-to-pattern(replace, grid); }
                                                slice-drag-started() => { root.slice-drag-started(); }
                                                slice-drag-finished() => { root.slice-drag-finished(); }
                                                commit-clicked() => { root.commit-clicked(); }
                                                revert-clicked() => { root.revert-clicked(); }
                                                voice-mode-changed(v) => { root.voice-mode-changed(v); }
                                                polyphony-changed(v) => { root.sampler-polyphony-changed(v); }
                                                retrigger-mode-changed(v) => { root.retrigger-mode-changed(v); }
                                                choke-group-changed(v) => { root.choke-group-changed(v); }
                                                stretch-enabled-changed(v) => { root.stretch-enabled-changed(v); }
                                                stretch-mode-changed(v) => { root.stretch-mode-changed(v); }
                                                stretch-ratio-changed(v) => { root.stretch-ratio-changed(v); }
                                                stretch-grain-changed(v) => { root.stretch-grain-changed(v); }
                                                stretch-sync-changed(v) => { root.stretch-sync-changed(v); }
                                                stretch-bars-changed(v) => { root.stretch-bars-changed(v); }
                                                stretch-ratio-typed(t) => { root.stretch-ratio-typed(t); }
                                                stretch-bars-typed(t) => { root.stretch-bars-typed(t); }
                                                stretch-grain-typed(t) => { root.stretch-grain-typed(t); }
                                                tune-typed(t) => { root.tune-typed(t); }
                                                filter-cutoff-changed(v) => { root.filter-cutoff-changed(v); }
                                                modulation-depth-changed(p, v) => { root.source-modulation-depth-changed(p, v); }
                                                modulation-edit-started(p) => { root.source-modulation-edit-started(p); }
                                                modulation-edit-finished(p) => { root.source-modulation-edit-finished(p); }
                                                filter-resonance-changed(v) => { root.filter-resonance-changed(v); }
                                                filter-env-changed(v) => { root.filter-env-changed(v); }
                                                drive-changed(v) => { root.sampler-drive-changed(v); }
                                                bit-reduction-changed(v) => { root.bit-reduction-changed(v); }
                                                rate-reduction-changed(v) => { root.rate-reduction-changed(v); }
                                                output-gain-changed(v) => { root.sampler-output-gain-changed(v); }
                                                filter-attack-changed(v) => { root.sampler-filter-attack-changed(v); }
                                                filter-decay-changed(v) => { root.sampler-filter-decay-changed(v); }
                                                filter-sustain-changed(v) => { root.sampler-filter-sustain-changed(v); }
                                                filter-release-changed(v) => { root.sampler-filter-release-changed(v); }
