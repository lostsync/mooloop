                                                        select-requested => { root.layer-branch-selected(index, branch.slot); }
                                                        // Ids 2 and 3, `CONTAINER_PARAM_MUTE` and
                                                        // `_SOLO`, on the branch head's own row.
                                                        mute-toggled => {
