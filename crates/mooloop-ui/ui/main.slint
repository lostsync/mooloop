} from "toolbar.slint";
import { MasterMeter } from "meters.slint";
import { EnvelopeEditor } from "envelope.slint";
import { AppearanceDialog } from "appearance-dialog.slint";
import { SavePresetDialog } from "save-preset-dialog.slint";
