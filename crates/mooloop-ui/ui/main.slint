                                                    x: DeviceRackMetrics.rail-width;
                                                    y: 0px;
                                                    width: parent.content-width;
                                                    height: parent.height;
                                                    slot-index: index;
                                                    slot-count: root.effect-slots.length;
                                                    bypassed: slot.bypassed;
                                                    preset-name: slot.preset-name;
                                                    seams: slot.buffer-collisions;
                                                    peaks: slot.buffer-peaks;
                                                    head-fraction: slot.buffer-head;
                                                    write-fraction: slot.buffer-write;
                                                    region-start: slot.buffer-window-start;
                                                    region-end: slot.buffer-window-end;
                                                    frozen: slot.buffer-frozen;
                                                    armed-freeze: slot.buffer-armed-freeze;
                                                    armed-gesture: slot.buffer-armed-gesture;
                                                    history-bars: slot.buffer-history-bars;
                                                    position-bar: slot.buffer-position-bar;
                                                    position-beat: slot.buffer-position-beat;
                                                    position-tick: slot.buffer-position-tick;
