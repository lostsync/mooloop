// How much a held status-bar notice weighs. Info is not here: it is
// `status-message`, which the next event is allowed to overwrite.
export enum NoticeLevel { warning, error }

// One step cell used in the step-grid models.
struct StepCell {
    active: bool,
    velocity: int,
    // Which 64th slots a note covers, and which ones a note actually starts on.
    // Coverage alone cannot tell a ratcheted step from one long note: both fill
    // all four slots. Onsets are what make a slice visible.
    substeps: int,
    onsets: int,
}

// One breakpoint in the piano roll's automation lane. `value` is normalised
// 0..1 against the destination's descriptor, matching how the lane is stored
// and sent to the engine; the readout converts to natural units for display.
struct AutomationPointCell {
    id: int,
    tick: int,
    value: float,
    selected: bool,
}

// One selectable automation destination in the lane picker. Rust builds the
// whole catalogue — every param of every effect on the selected channel and on
// every bus — because only Rust has the descriptor tables.
struct AutomationTargetRow {
    // "Cutoff". Displayed in the menu row and, with `device`, in the header.
    param-name: string,
    // "Filter 1" or "Bus 2 · Delay 1". Menu rows are grouped by this.
    device: string,
    // First row of a device's group draws the header above itself. Precomputed
    // in Rust because Slint's `for` has no access to the previous element.
    starts-group: bool,
    // Already has a lane in this clip, so it sorts to the top level and offers
    // clear/remove rather than just "open".
    open: bool,
    // True when this is the lane currently shown.
    current: bool,
}

// One channel row in the rack.
struct ChannelRow {
    name: string,
    // The colour the user gave this channel, and whether there is one. Two
    // fields because Slint has no `Option` and a `color` has no absent value
    // -- a transparent one would draw the same as no bar and mean something
    // different.
    color: color,
    has-color: bool,
    // The colour of the *track* this channel feeds, which is a different
    // fact and gets a different indicator: the bar above is what this
    // channel was given, this is the group it belongs to. Keeping them
    // apart is what stops either one having two possible sources.
    track-color: color,
    has-track-color: bool,
    muted: bool,
    solo: bool,
    // Whether a solo on *another* channel is silencing this one. Derived from
    // the whole bank on the Rust side and pushed like any other row fact, for
    // the reason a track's `solo-silenced` is: the markup must not be the
    // second place that rule is written down.
    solo-silenced: bool,
    // Channel gain in dB from unity; the Rust side stores linear.
    volume-db: float,
    pan: float,
    selected: bool,
    // Mixer bus this channel feeds; 0 is the master.
    bus: int,
    steps: [StepCell],
}

// What a pattern is called and what colour it was given, for the surfaces
// that draw a row or a clip per pattern.
//
// `ink` is carried rather than derived in markup: a clip is a filled shape
// with a label on it, so the label needs a colour that can be read on top of
// whatever the user picked, and that is a luminance decision `ProjectColor`
// owns and has a test for. Slint would have to spell the weights a second
// time.
struct PatternInfo {
    name: string,
    color: color,
    has-color: bool,
    ink: color,
}

// One pattern instance in the song playlist.
struct PlaylistClip {
    pattern: int,
    start-tick: int,
    length-steps: int,
}

// One row of the sample browser's tree, flattened from the folder hierarchy
// in Rust: folders first, then the audio files beside them, children of an
// expanded folder immediately following their parent.
struct BrowserRow {
    depth: int,
    // 0 = folder, 1 = sample file, 2 = preset group, 3 = preset.
    //
    // One model serves both tabs. A group behaves like a folder (it expands)
    // and a preset behaves like a sample (it is the leaf you act on), so the
    // tree needs no second shape -- only a second vocabulary.
    kind: int,
    name: string,
    // Absolute path; toggling, removal and loading hand it back to Rust
    // verbatim. A preset group's path is its directory, which is what lets
    // the sample tree's expansion set hold one without knowing what it is.
    path: string,
    expanded: bool,
    // Right-aligned trailing text: a preset's category and tags when they say
    // something its group does not, or a group's preset count. Empty for
    // samples and folders.
    detail: string,
    // Whether acting on this row would do anything. False only for a
    // generator preset whose device is not the selected channel's; an effect
    // preset is always loadable because loading one *adds* a device.
    loadable: bool,
    // An effect preset: one that can be added as a new device whatever is
    // selected, which the row's menu offers (MOO-9).
    effect: bool,
}

// One effect slot in the selected channel's chain, in signal order.
//
// Parameters are positional and normalized: `p0` is the first entry in this
// kind's descriptor table in mooloop-core, `p1` the second, and so on, each
// in 0..1. Faces convert to natural units for display using the same mapping
// the descriptor defines. Delay additionally uses `p6`/`p7` for its persisted
// tempo-sync input mode and beat-division selection; its DSP parameter stays
// at `p0` in milliseconds.
struct EffectSlotRow {
    // Matches EffectKind: 0=Filter, 1=Drive, 2=Bitcrush, 3=Delay,
    // 4=Gate, 5=Compressor, 6=Limiter, 7=EQ, 8=Reverb, 9=Mod,
    // 10=Plate, 11=Buffer, 12=Preamp, 13=Chain, 14=Layer, 15=Plugin,
    // 16=Bus Comp.
    //
    // This numbering is `effect_kind_index` in `lib.rs` and it is a *runtime*
    // binding: a project persists the `EffectKind` by name, and the index is
    // recomputed on every publish. So it can be renumbered -- but every arm
    // below, and every `kind-selected` in the insert menu, has to move with
    // it, and `the_insert_menu_offers_every_kind` clicks every row of that
    // menu and requires every kind's number back exactly once. A container
    // is drawn by `is-container`, not by its number.
    kind: int,
    // Rack units this device's face occupies. Devices with more working
    // controls get more width rather than compressing their controls.
    units: int,
    // Whether the keyboard's clipboard actions act on this row. Carried on
    // the row rather than as a window property holding a slot index: Rust
    // keeps the selection as a `DeviceId` and rebuilds these rows on every
    // structural edit, so this follows a reorder for free and there is no
    // second thing to keep in step.
    selected: bool,
    // The presets saved for this row's kind, as menu labels, in the order
    // the Rust side resolves an index back to a bundle.
    preset-options: [string],
    // The preset this row was last loaded from or saved as, for its header.
    preset-name: string,
    bypassed: bool,
    // Normalized parameter values, **indexed by descriptor id** -- the same
    // number `modulation-allowed[n]` uses and the same number a saved lane
    // stores. Position and id used to be the same thing; the Buffer retiring
    // `Offset` parted them, so its `p0` is a hole and its Position is `p2`.
    p0: float,
    p1: float,
    p2: float,
    p3: float,
    p4: float,
    p5: float,
    p6: float,
    p7: float,
    p8: float,
    p9: float,
    p10: float,
    p11: float,
    p12: float,
    p13: float,
    p14: float,
    p15: float,
    // Past the sixteen a descriptor table fills. These carry what a device
    // keeps *beside* its parameters: the delay and the modulation effect each
    // hold a tempo-sync flag and a musical division, which are not continuous
    // values and are not addressable, so they are not descriptors. The delay
    // fits inside its own ids; the modulation effect has eight of them and
    // does not.
    p16: float,
    p17: float,
    // One entry per descriptor, in descriptor order: the armed source's
    // route depth, and whether that parameter accepts modulation at all.
    // Indexed rather than named so a face exposes every eligible control.
    modulation-depths: [float],
    modulation-allowed: [bool],
    modulation-offsets: [float],
    modulation-route-counts: [int],
    // EQ-only, and all three are `EqResponseDisplay`'s conventions rather
    // than parameter values: three floats a band and two a pass filter to
    // place the handles, and the bank's magnitude response in decibels,
    // sampled by `mooloop_dsp::effects::eq_response_db` over the plot's own
    // frequency axis. The curve is the filter evaluated, not a shape drawn to
    // resemble it -- see `docs/plans/eq-v2/02-the-curve-tells-the-truth.md`.
    eq-band-data: [float],
    // Each band's `EqBandKind`, as `EqBandKind::to_index` numbers it. Its own
    // field rather than a fourth float in `eq-band-data`, because that array
    // is what *places a handle* and a kind places nothing: it is what the
    // target row draws a shelf's glyph from.
    eq-band-kinds: [int],
    eq-pass-data: [float],
    eq-curve-db: [float],
    eq-spectrum-data: [float],
    eq-analyzer-enabled: bool,
    // Per-band decibels the preamp *added*, already gated and normalized by
    // `mooloop_dsp::effects::preamp`. Not a spectrum: a difference between
    // two of them, which is why it is its own field rather than a second
    // reader of `eq-spectrum-data`.
    preamp-deviation: [float],
    preamp-display-enabled: bool,
    wet-dry: float,
    // Trims are carried in dB from unity; the Rust side stores linear gain.
    input-trim-db: float,
    output-trim-db: float,
    input-left-db: float,
    input-right-db: float,
    output-left-db: float,
    output-right-db: float,
    // Buffer-only: wraps and cuts counted by the inserted device. It was a
    // count of forced *returns to live*, which is a failure the turntable
    // model could have and this one cannot: every head wraps instead, so what
    // is worth reporting is how often it did.
    buffer-collisions: int,
    // Buffer-only: the picture its face draws. Peaks over the retained
    // history and the marks on top of them, published as display telemetry
    // and therefore latest-available rather than timed. The bars-beats-ticks
    // numbers are computed in Rust: the markup formats and never derives.
    buffer-peaks: [float],
    buffer-head: float,
    buffer-write: float,
    buffer-window-start: float,
    buffer-window-end: float,
    buffer-frozen: bool,
    buffer-armed-freeze: int,
    buffer-armed-gesture: bool,
    buffer-history-bars: int,
    buffer-position-bar: int,
    buffer-position-beat: int,
    buffer-position-tick: int,
    // Dynamics-only: the level this device's sidechain detector reached and
    // the gain reduction it applied. Both are the device's own state, not a
    // difference of the meters above -- the meters are block peaks, these
    // carry the attack and release the device is actually running.
    detector-db: float,
    gain-reduction-db: float,
    // Bus Comp only (MOO-216): its settings as the master section's face
    // takes them, positions and natural units, so the one panel draws both;
    // and the needle's held mark as a positive depth. On a Bus Comp row
    // `gain-reduction-db` is the needle, through `ReductionBallistics`,
    // rather than the block's raw extreme.
    bus-comp: MasterRow,
    held-reduction-db: float,
    // Container-only: how many of the rows after this one are inside it, and
    // how deeply this row is nested. `children` is structure rather than a
    // parameter, which is why it is not one of the `pN` fields. The frame the
    // pair is really for is step 04 of `docs/plans/archive/containers/`; `depth` is
    // carried now so the row model and the face contract cross `main.slint`
    // once rather than twice.
    children: int,
    depth: int,
    // Whether this row holds a run of the rows after it.
    //
    // The markup used to ask `kind == 13`, seven times. That is the Rust
    // predicate `EffectParams::is_container` re-derived from a number which
    // the comment above `kind` describes as a runtime binding that may be
    // renumbered -- so the renumbering it invites would have had to find all
    // seven, and a second container kind would have had to be added to all
    // seven as `|| kind == 14`. Carried here for the same reason `closing` is.
    is-container: bool,
    // The kind's display name, `EffectKind::label`. Read by the container
    // face, which draws both container kinds and would otherwise title a
    // layer "Chain" -- or have to tell the two apart by `kind`'s number,
    // which is the comparison `is-container` exists to retire.
    label: string,
    // Whether wrapping this row would leave every container inside
    // `MAX_CONTAINER_DEPTH`. A bool and not a comparison against `depth`,
    // because the cap is an engine number and spelling it here would be a
    // fifth copy -- `mooloop_core::can_wrap` answers this and the gesture.
    wrap-enabled: bool,
    // The containers whose run *ends* at this row, innermost first, as rack
    // indices. Each one draws its output rail here, past everything it holds,
    // so a container's chrome encloses its devices instead of sitting beside
    // them. Usually empty; an empty container closes on its own row.
    //
    // Derived in Rust rather than in the rack, because "the last row of this
    // box" cannot be read off one row: `depth` and `children` say what a row
    // is inside, not what ends at it. Since `containers/09` it is the last
    // *drawn* row, because a layer hides the branches it is not showing.
    closing: [int],
    // Whether this row is a layer, which draws `LayerDeviceFace` rather than
    // the chain's face. A bool for `is-container`'s reason: the markup asks
    // what a row is, not what number its kind has this frame.
    is-layer: bool,
    // The row lies in a branch its layer is not showing, so the rack draws
    // nothing of it and it takes no width (`containers/09`).
    hidden: bool,
    // The depth of the next row that is drawn. The box's right cap asks it;
    // it was `effect-slots[index + 1].depth` until hidden rows meant the next
    // row might not be drawn.
    next-depth: int,
    // The row the join after this one inserts before: the next *drawn* row,
    // or the chain's length past the last. -1 where that join adds nothing
    // (right after a layer's head, where a new branch is the layer face's
    // job). Rust's, because a layer may be hiding the next row (MOO-218).
    join-before: int,
    // Layer-only: its branches, in rack order, and the rack index of the one
    // it is showing (-1 for none). S, M and each branch's meter are read from
    // the branch head's own row, `effect-slots[branch.slot]`.
    branches: [LayerBranchRow],
    selected-branch: int,
    // The row lies in the branch its innermost layer is showing, and its
    // first and last drawn rows: where the bracket over that branch is drawn.
    bracket: bool,
    bracket-start: bool,
    bracket-end: bool,
}

// The selected channel's generator, addressed the way `EffectSlotRow`
// addresses an effect: `kind` is `device_kind_to_int`'s number for it (the
// same one `source-kind` below already carries), and `p0..p35` are its
// normalized parameter values, **indexed by descriptor id** -- the same
// number a saved automation lane and the modulation arrays below use.
//
// Sized to the widest declared generator table, the sampler's
// (`SAMPLER_PARAM_SLICE_BASE_NOTE`, id 35 in `mooloop-core/src/generator.rs`);
// a generator whose ids run past that needs this struct widened, the same
// way `EFFECT_ROW_PARAMS` grew for the Reverb.
//
// This is the pilot from `docs/plans/generator-face-rows/`: only Aux In
// reads it today (its Level, id 2, in `p2`) and writes back through
// `source-param-changed`. Every other generator face still reads its own
// flat properties below, so this row goes unfilled and unread for them.
struct SourceRow {
    kind: int,
    p0: float,
    p1: float,
    p2: float,
    p3: float,
    p4: float,
    p5: float,
    p6: float,
    p7: float,
    p8: float,
    p9: float,
    p10: float,
    p11: float,
    p12: float,
    p13: float,
    p14: float,
    p15: float,
    p16: float,
    p17: float,
    p18: float,
    p19: float,
    p20: float,
    p21: float,
    p22: float,
    p23: float,
    p24: float,
    p25: float,
    p26: float,
    p27: float,
    p28: float,
    p29: float,
    p30: float,
    p31: float,
    p32: float,
    p33: float,
    p34: float,
    p35: float,
}

// One selectable destination inside the automation lane picker.
component AutomationMenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> current: false;
    callback selected();
    height: 20px;
    min-width: 150px;
    background: touch.has-hover ? Theme.surface-raised : transparent;
    Text {
        x: 8px;
        text: root.text;
        color: root.current ? Theme.accent : Theme.text;
        font-size: Theme.text-lg;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

// The lane picker. Every parameter of every device the selected clip can
// reach, grouped by device, with the lane-level actions on top when one is
// already open.
component AutomationLaneMenu inherits VerticalLayout {
    in property <[AutomationTargetRow]> targets;
    in property <bool> has-lane: false;
    callback picked(int);
    callback cleared();
    callback closed();
    padding: 4px;
    spacing: 1px;
    if root.has-lane : AutomationMenuRow {
        text: "Clear points";
        selected => { root.cleared(); }
    }
    if root.has-lane : AutomationMenuRow {
        text: "Remove lane";
        selected => { root.closed(); }
    }
    if root.has-lane : Rectangle {
        height: 5px;
        Rectangle {
            y: 2px;
            height: 1px;
            width: parent.width;
            background: Theme.border;
        }
    }
    ScrollView {
        height: min(280px, list.preferred-height);
        width: max(170px, list.preferred-width);
        list := VerticalLayout {
            spacing: 1px;
            for row[index] in root.targets : VerticalLayout {
                spacing: 1px;
                // Rust marks the first row of each device so the header can be
                // drawn here; Slint's `for` cannot see the previous element.
                if row.starts-group : Text {
                    height: 16px;
                    text: row.device;
                    color: Theme.text-faint;
                    font-size: Theme.text-sm;
                    vertical-alignment: bottom;
                    x: 6px;
                }
                AutomationMenuRow {
                    text: row.open ? "● " + row.param-name : row.param-name;
                    current: row.current;
                    selected => { root.picked(index); }
                }
            }
        }
    }
}

component FlatButton inherits ToolButton { }

// One end of the playlist loop, as something a pointer can catch.
//
// **Two pixels of paint and nine of target.** The line has to stay thin to
// read as an edge of the section rather than as a block on top of it, and two
// pixels is not a thing anybody can hit; so the paint is centred in a hit area
// four pixels wider on each side, and the `ew-resize` cursor is what says so
// before the press rather than after it.
//
// The target overhangs the strip by four pixels at bar 1, where the loop a new
// song opens with begins. That sliver lands on empty canvas beside the
// "PATTERN" gutter and catches nothing, which is cheaper than clamping the
// target and taking the paint off the edge it is marking.
component PlaylistLoopHandle inherits Rectangle {
    // Whether the loop this end belongs to is running. The same distinction
    // the section behind it draws: the points are kept when looping is off, so
    // the handle stays grabbable and goes quiet rather than disappearing.
    in property <bool> live;
    /// Where the pointer is along the *strip*, not along the handle. Only the
    /// handle knows how wide its own target is, and the caller only wants a
    /// tick, so the conversion happens here and the tick happens there.
    callback moved(length);

    property <string> hint: "Drag this end of the loop. Right-click the strip clears it.";

    width: 9px;

    Rectangle {
        width: 2px;
        x: (parent.width - self.width) / 2;
        height: 100%;
        background: root.live ? Theme.text : Theme.text-muted;
    }

    TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { Gesture.begin(); }
            else if (e.kind == PointerEventKind.up) { Gesture.end(); }
        }
        moved => {
            if (self.pressed) { root.moved(self.mouse-x + root.x); }
        }
        changed has-hover => {
            if (self.has-hover) { StatusHint.show(root.hint); }
            else { StatusHint.clear(root.hint); }
        }
    }
}

// ===== Panes =====
//
// Five views and three slots. `main` and `split` divide the top of the work
// area; `bottom` is the dock below it. **A view lives in exactly one slot at
// a time**, which is the rule the whole arrangement rests on: a slot's tab
// strip is a partition of the view set, so no strip can lie about what is on
// screen, a tab drag can only mean "move", and Ctrl+2 has one answer to
// "which mixer".
//
// The consequence worth stating, because it is what keeps this affordable:
// a view needs exactly **one** instance. What changes when a view moves is
// where it is drawn, not which subtree draws it. So the work area computes
// rectangles and each view is positioned into one, rather than every view
// becoming a component instantiated once per slot.
//
// View ids are the order Ctrl+1..5 already uses in `actions.rs`, so a chord
// is `Ctrl+(id + 1)` and the tab strips render in a stable order without
// carrying one.
global PaneViews {
    out property <[string]> names: ["STEPS", "MIXER", "DEVICES", "NOTES", "PLAYLIST"];
    out property <int> steps: 0;
    out property <int> mixer: 1;
    out property <int> devices: 2;
    out property <int> notes: 3;
    out property <int> playlist: 4;
    // DEVICES is the only view with an intrinsic height -- a face is a fixed
    // 268px and does not stretch -- which is the whole of "the bottom pane
    // resizes except on the devices page".
    out property <[bool]> fixed-height: [false, false, true, false, false];
}

// Live state of a pane-tab drag.
//
// A global for the reason `RackDrag` is one, and in the same shape: the two
// halves of the drag sit in different places and neither contains the other.
// The **grab** is in a tab strip, which knows which view it is holding and
// nothing about the work area's geometry; the **landing** is worked out by
// the work area, which knows its own bounds and nothing about the grab.
//
// The pointer is kept in *window* coordinates, `absolute-position + mouse-x`,
// which is the lesson `RackDrag.dx` records at length: a touch area's
// `mouse-x` is measured against a ruler that the previous frame already slid,
// so it reports each move's increment rather than the travel.
global PaneDrag {
    // The view being dragged, or -1 for no drag in progress.
    in-out property <int> view: -1;
    // The slot it would land in, or -1 for "nowhere it may go".
    in-out property <int> target: -1;
    in-out property <bool> active;
    in-out property <length> pointer-x;
    in-out property <length> pointer-y;
    public function end() {
        root.view = -1;
        root.target = -1;
        root.active = false;
    }
}

// One slot's computed rectangle, plus whether the slot is on screen at all.
struct PaneRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

// A view's frame. Takes its geometry from its slot rather than from a layout,
// and is drawn only when it is the active view of that slot.
component ViewSlot inherits Rectangle {
    in property <PaneRect> rect;
    in property <bool> shown;
    x: self.rect.x;
    y: self.rect.y;
    width: self.rect.width;
    height: self.rect.height;
    visible: self.shown;
    clip: true;
}

// Every view's one toolbar row.
//
// One row per view, whichever slot the view is in, because a pane's toolbar
// should not change shape when the pane moves. It replaces three different
// rows -- a 29px `Theme.panel` strip above the work area, a 30px
// `Theme.surface` slot header, and a 34px `Theme.surface-raised` page row
// under it -- two of which used to be stacked. Its controls are 24px, which
// is `ToolbarMetrics.control-height`, so nothing shrank to fit.
component PaneToolbar inherits Rectangle {
    height: 30px;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 6px;
        @children
    }
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
}

// A slot's tab strip: the same shape the two panes' `SegmentedControl`
// switchers already have, with its membership as state instead of markup.
// It leads its view's toolbar, and it is deliberately the part of that row
// that never clips -- it is the way out of the pane.
component PaneTabs inherits Rectangle {
    // Which slot each view is in, indexed by view id. The index is the view,
    // so iterating this renders the slot's members in view order.
    in property <[int]> view-slots;
    in property <int> slot;
    in property <int> active;
    // Drawn on the active tab, because the gesture that sets it is on the
    // active tab: the full accent rather than the muted active fill.
    in property <bool> zoomed;
    callback picked(int);
    callback zoom-toggled();
    callback drag-started(int);
    callback drag-dropped(int);
    callback move-requested(int, int);
    /// False when this strip's slot would be left with nothing, which the
    /// main slot is not allowed to be. Greys the move rows rather than
    /// letting them fail silently.
    in property <bool> can-leave: true;

    height: 24px;
    width: strip.preferred-width + 2px;
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: Theme.hairline;
    border-color: Theme.border;

    strip := HorizontalLayout {
        x: 1px;
        y: 1px;
        height: parent.height - 2px;
        // No spacing, and a view that lives elsewhere collapses to nothing.
        // Slint will not take an `if` as a `for` body, and a zero-width child
        // still earns its gap, so the membership test is the width. The gaps
        // are not missed: only one tab is ever tinted, and an untinted tab is
        // already the strip's own colour, so a 1px rule between two of them
        // would draw nothing.
        spacing: 0px;
        for home[view] in root.view-slots : Rectangle {
            width: home == root.slot ? 66px : 0px;
            visible: home == root.slot;
            border-radius: Theme.radius-sm;
            // The tab being dragged stays where it is, dimmed, the way the
            // rack leaves an outline at a dragged device's origin.
            opacity: PaneDrag.view == view ? 0.4 : 1.0;
            background: root.active == view
                ? (root.zoomed ? Theme.accent : Theme.accent-active)
                : tab-touch.has-hover ? Theme.surface-active : transparent;
            Text {
                text: PaneViews.names[view];
                font-size: Theme.text-md;
                letter-spacing: 0.5px;
                color: root.active == view
                    ? (root.zoomed ? Theme.background : Theme.text)
                    : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            // A press is a pick; a press that travels is a move. The
            // threshold is what keeps a slightly wobbly click from becoming a
            // drag, and the pick is resolved on *release* so a drag that ends
            // where it started still just selects the tab.
            tab-touch := TouchArea {
                mouse-cursor: PaneDrag.view == view ? MouseCursor.grabbing : MouseCursor.pointer;
                property <length> grab-x;
                property <length> grab-y;
                property <bool> travelled;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down
                            && e.button == PointerEventButton.right) {
                        root.picked(view);
                        tab-menu.show();
                    } else if (e.kind == PointerEventKind.down) {
                        self.grab-x = self.absolute-position.x + self.mouse-x;
                        self.grab-y = self.absolute-position.y + self.mouse-y;
                        self.travelled = false;
                        PaneDrag.pointer-x = self.grab-x;
                        PaneDrag.pointer-y = self.grab-y;
                    } else if (e.kind == PointerEventKind.move && self.pressed) {
                        PaneDrag.pointer-x = self.absolute-position.x + self.mouse-x;
                        PaneDrag.pointer-y = self.absolute-position.y + self.mouse-y;
                        if (!self.travelled
                                && (abs(PaneDrag.pointer-x - self.grab-x) > 5px
                                 || abs(PaneDrag.pointer-y - self.grab-y) > 5px)) {
                            self.travelled = true;
                            root.drag-started(view);
                        }
                    } else if (e.kind == PointerEventKind.up) {
                        if (self.travelled) { root.drag-dropped(view); }
                        else { root.picked(view); }
                        self.travelled = false;
                    } else if (e.kind == PointerEventKind.cancel) {
                        self.travelled = false;
                        PaneDrag.end();
                    }
                }
                // Double-click the thing that names the pane to make the pane
                // the window, which is the maximise gesture a title bar has.
                double-clicked => { root.picked(view); root.zoom-toggled(); }
            }
            // Right-click is where a tab says what can be done to it. Every
            // row here is otherwise a gesture with no affordance -- a drag,
            // a double-click -- or a `View` row that acts on the last view
            // revealed rather than on the tab under the pointer, which
            // cannot answer "what about *this* one".
            tab-menu := PopupWindow {
                x: 0px;
                y: parent.height + 2px;
                width: 176px;
                height: tab-menu-frame.preferred-height;
                close-policy: close-on-click;
                tab-menu-frame := Rectangle {
                    background: Theme.surface;
                    border-width: Theme.hairline;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    VerticalLayout {
                        padding: 4px;
                        MenuRow {
                            text: "Move to Top Pane";
                            enabled: root.slot != 0;
                            selected => { root.move-requested(view, 0); }
                        }
                        MenuRow {
                            text: "Move to Split";
                            enabled: root.slot != 1 && root.can-leave;
                            selected => { root.move-requested(view, 1); }
                        }
                        MenuRow {
                            text: "Move to Bottom Pane";
                            enabled: root.slot != 2 && root.can-leave;
                            selected => { root.move-requested(view, 2); }
                        }
                        MenuSeparator {}
                        MenuRow {
                            text: root.zoomed ? "Restore Pane" : "Zoom Pane";
                            shortcut: "Ctrl+Shift+\\";
                            selected => { root.picked(view); root.zoom-toggled(); }
                        }
                    }
                }
            }
            accessible-role: tab;
            accessible-label: PaneViews.names[view];
            accessible-checked: root.active == view;
        }
    }
}

export component MainWindow inherits Window {
    title: root.document-title;
    preferred-width: 1280px;
    preferred-height: 760px;
    background: Theme.background;

    // The whole reason a theme's font reaches anything. Slint resolves an
    // element's `font-*` against the window's `default-font-*`, so binding the
    // tokens here is what themes the three hundred `Text` elements that never
    // name a family -- and it is why no face should name one except when the
    // content needs the mono family.
    default-font-family: Theme.font-family;
    default-font-size: Theme.text-md;
    default-font-weight: Theme.font-weight;

    // ---- transport / state exchanged with Rust ----
    in-out property <bool>  playing;
    in-out property <int>   bpm;
    in-out property <int>   swing-percent: 50;
    in-out property <int>   beat-in-bar;
    in-out property <float> meter-l-db: GainMath.min-db;
    in-out property <float> meter-r-db: GainMath.min-db;
    in-out property <float> meter-l-held-db: GainMath.min-db;
    in-out property <float> meter-r-held-db: GainMath.min-db;
    in-out property <bool> meter-l-clipping;
    in-out property <bool> meter-r-clipping;
    // Both latches at once: the light is one lamp over a stereo pair, so
    // clearing it clears what it was reporting.
    callback master-clip-reset();
    in-out property <float> source-output-left-db: GainMath.min-db;
    in-out property <float> source-output-right-db: GainMath.min-db;
    in-out property <float> selected-channel-volume-db: 0;

    // ---- preferences ----
    in-out property <bool> preferences-open;
    in-out property <string> preferences-appearance-theme: "Mooloop";
    // A colour has been edited away from the theme above. The name is kept so
    // that saving keeps the variant nobody was looking at.
    in-out property <bool> preferences-appearance-customized;
    // 0 dark, 1 light, 2 follow the desktop. `theme::Mode` owns the order.
    in-out property <int> preferences-appearance-mode;
    in-out property <[AppearanceSchemeRow]> preferences-appearance-schemes;
    // The sixteen slots of the ramp in force, drawn as a strip under the list.
    in-out property <[color]> preferences-appearance-ramp;
    // Whether the variant on screen was worked out rather than written down,
    // which the page says out loud: a derived Snow Storm is not Snow Storm.
    in-out property <bool> preferences-appearance-variant-derived;
    // WCAG contrast ratios for the palette on screen: body text against the
    // surface it sits on, and the accent against the same.
    in-out property <float> preferences-appearance-text-ratio: 1.0;
    in-out property <float> preferences-appearance-accent-ratio: 1.0;
    in-out property <[ColorChoice]> preferences-appearance-base-choices;
    in-out property <[ColorChoice]> preferences-appearance-hue-choices;
    in-out property <string> preferences-appearance-base: "#18181B";
    in-out property <string> preferences-appearance-accent: "#84CC16";
    in-out property <string> preferences-appearance-alert: "#EAB308";
    in-out property <float> preferences-appearance-contrast: 1.0;
    in-out property <float> preferences-appearance-roundness: 1.0;
    in-out property <float> preferences-appearance-type-scale: 1.0;
    in-out property <float> preferences-appearance-density: 1.0;
    in-out property <string> preferences-appearance-font-family;
    in-out property <string> preferences-appearance-font-family-mono: "monospace";
    in-out property <int> preferences-appearance-font-weight: 400;
    in-out property <float> preferences-appearance-hairline: 1.0;
    in-out property <float> preferences-appearance-stroke-emphasis: 2.0;
    in-out property <int> preferences-appearance-relief;
    in-out property <float> preferences-appearance-relief-depth: 1.0;
    in-out property <string> preferences-appearance-theme-name;
    in-out property <bool> preferences-developer-mode;
    // False unless the build carries the `mockup` Cargo feature, in which
    // case the Developer page hides the row rather than offering a button
    // that opens nothing.
    in-out property <bool> preferences-mockup-tool-available;
    in-out property <string> preferences-log-path;
    in-out property <bool> preferences-smooth-curves;
    in-out property <string> preferences-error;
    in property <[OutputTargetRow]> preferences-audio-output-targets;
    in property <int> preferences-audio-buffer-size-index;
    in property <string> preferences-audio-sample-rate-text;
    in property <bool> preferences-audio-auto-reconnect;
    in property <string> preferences-audio-error;
    in property <AudioDriverCopy> preferences-audio-driver;
    in property <[ShortcutRow]> preferences-shortcut-rows;
    in property <[GestureRow]> preferences-gesture-rows;
    in property <[string]> preferences-gesture-choices;
    // Filled once at startup from `SuperKeyMode::ALL`, so the page never
    // spells the option names a second time.
    in property <[string]> preferences-shortcut-super-key-choices;
    in-out property <int> preferences-shortcut-super-key;
    // Filled once at startup from `meter::falloff_options`, which builds each
    // label out of the rate it selects.
    in property <[string]> preferences-meter-falloff-options;
    in-out property <string> preferences-shortcut-capturing-id;
    callback preferences-opened();
    // No arguments: every value the preview needs is one of the two-way bound
    // properties above, and a fourteen-argument callback is a place for two
    // of them to be passed in the wrong order.
    callback preferences-appearance-preview();
    callback preferences-appearance-mode-changed(int);
    // The desktop's light/dark preference as the platform reports it, live:
    // on Linux Slint's winit backend subscribes to the XDG portal's
    // `org.freedesktop.appearance color-scheme` and its `SettingChanged`
    // signal, and on macOS winit reports the system appearance. Nothing here
    // sets `Palette.color-scheme`, so it is the platform's own answer.
    // 0 while the platform has not said, 1 dark, 2 light. Rust follows it
    // when the appearance mode is Auto (MOO-156).
    out property <int> desktop-color-scheme: Palette.color-scheme == ColorScheme.dark ? 1
        : Palette.color-scheme == ColorScheme.light ? 2 : 0;
    callback desktop-color-scheme-changed(int);
    changed desktop-color-scheme => {
        root.desktop-color-scheme-changed(root.desktop-color-scheme);
    }
    callback preferences-appearance-select-theme(string);
    callback preferences-appearance-save-theme(string);
    callback preferences-appearance-remove-theme(string);
    callback preferences-save() -> bool;
    callback preferences-cancelled();
    callback preferences-audio-refresh-targets();
    callback preferences-audio-select-output(string, string, string);
    callback preferences-audio-select-buffer-size(int);
    callback preferences-audio-auto-reconnect-toggled(bool);
    callback preferences-shortcut-rebind-key(string, string, bool, bool, bool, bool);
    callback preferences-shortcut-reset(string);
    callback preferences-shortcut-reset-all();
    callback preferences-gesture-rebound(string, int);
    callback preferences-shortcut-super-key-changed(int);
    callback preferences-open-mockup-tool();

    // ---- document lifecycle ----
    in-out property <string> document-title: "Untitled - mooloop";
    in-out property <bool> embed-assets: true;
    in-out property <bool> document-busy;
    in-out property <string> status-message;
    // Live hover hint: gesture/interaction explanations that used to live in
    // a Tooltip now show here instead, so nothing hover-lingers over a
    // large always-under-the-pointer area (the piano roll, in particular).
    // Takes priority over status-message while non-empty.
    in-out property <string> hover-hint;
    // The held notice: a warning or an error that stays in the status bar
    // until it is clicked away or a notice of at least its weight replaces
    // it. `status-message` is the other half, and anything the next "Device
    // selected" may overwrite goes there instead. Written from Rust only
    // through `status_bar::notify`, which owns the replacement rule; empty
    // means there is none.
    in-out property <string> status-notice;
    in-out property <NoticeLevel> status-notice-level;
    // The audio callback, as the pump read it over the last second. `load`
    // and `peak` are shares of the block budget, 1.0 being all of it, and
    // negative until a window has rendered anything. `dropouts` counts up
    // until the readout is clicked; `time-shared` is the callback running on
    // an ordinary thread rather than a realtime one.
    in-out property <float> audio-load: -1;
    in-out property <float> audio-load-peak;
    in-out property <int> audio-dropouts;
    in-out property <bool> audio-time-shared;
    in-out property <bool> save-error-open;
    in-out property <string> save-error-title;
    in-out property <string> save-error-detail;
    in-out property <string> save-error-report;
    callback save-error-dismissed();
    in-out property <bool> export-open;
    in-out property <int> export-format;
    in-out property <int> export-bitrate: 2;
    // A cap: the render stops when every device has fallen silent (MOO-125).
    in-out property <int> export-tail-seconds: 10;
    // The dialog's phase -- 0 settings, 1 rendering, 2 result -- and what it
    // shows in the last two. Written by the export launch and the pump.
    in-out property <int> export-phase;
    in-out property <float> export-progress: -1;
    in-out property <string> export-result-title;
    in-out property <string> export-result-detail;
    callback open-song();
    callback save-song();
    callback save-song-as();
    callback load-kit();
    callback save-kit();
    callback load-channel();
    callback save-channel();
    callback export-audio();
    callback export-confirmed(int, int, int);
    callback export-cancel-render();
    callback quit-requested();

    // ---- questions the app asks itself (MOO-91) ----
    // Unsaved changes, a preset name that is taken, a kit that drops
    // channels. `question-answered` carries 0 for Cancel, 1 for the primary
    // button and 2 for the secondary one; Rust remembers what was asked.
    in-out property <bool> question-open;
    in property <string> question-title;
    in property <string> question-detail;
    in property <string> question-primary;
    in property <string> question-secondary;
    callback question-answered(int);

    // ---- unused takes (`audio-recording/06`, MOO-38) ----
    // File > Clean Up Takes, and a quit that leaves this session's takes
    // unused. Rust owns the ticks: `take-toggled(earlier, index)` asks it to
    // flip one, and it sends the rows and the total back.
    in-out property <bool> takes-open;
    in property <string> takes-title;
    in property <string> takes-intro;
    in property <[TakeRow]> takes-session-rows;
    in property <[TakeRow]> takes-earlier-rows;
    in property <string> takes-earlier-note;
    in property <string> takes-total;
    in property <bool> takes-can-confirm;
    in property <string> takes-confirm-label;
    in property <string> takes-cancel-label;
    callback take-toggled(bool, int);
    callback takes-confirmed();
    callback takes-cancelled();
    callback clean-up-takes();

    // ---- presets (per-generator and whole-channel) ----
    in-out property <[string]> generator-preset-options;
    in-out property <[string]> channel-preset-options;
    callback generator-preset-selected(int);
    callback channel-preset-selected(int);
    callback save-generator-preset-requested();
    callback save-channel-preset-requested();
    // The preset the source device was last loaded from or saved as, for its
    // header. Empty when it did not come from one.
    in property <string> source-preset-name;
    in-out property <bool> save-preset-open;
    in property <string> save-preset-title;
    in-out property <string> save-preset-name;
    in-out property <string> save-preset-category;
    callback save-preset-confirmed(string, string);
    callback save-preset-cancelled();

    // ---- about ----
    in-out property <bool> about-open;
    in property <string> app-version;

    // ---- channels / patterns ----
    // The real ceilings, set once from `mooloop_core::MAX_CHANNELS` and
    // `MAX_PATTERNS`. Written-out literals here went stale the day the core
    // raised its cap and left every Add Channel row dead at sixteen while the
    // engine would happily have taken two hundred and forty more; see
    // `docs/CAPACITY_POLICY.md`. Nothing in this file may spell a limit out.
    // The defaults are only what a bare `MainWindow` in a test harness sees;
    // `AppUi::new` overwrites both before the window is shown.
    in property <int> max-channels: 256;
    in property <int> max-patterns: 256;
    in-out property <[ChannelRow]> channels;
    in-out property <int> current-pattern;
    in-out property <int> pattern-count: 1;
    in-out property <int> pattern-length;
    in-out property <int> current-step;
    in-out property <int> selected-channel;
    in-out property <[NoteCell]> notes;
    in-out property <bool> song-mode;
    in-out property <[PlaylistClip]> playlist-clips;
    in-out property <int> playlist-position-ticks;
    in-out property <int> playlist-song-length-ticks: RollMetrics.ticks-per-bar;
    in-out property <int> playlist-bars: 64;
    in-out property <length> playlist-bar-width: 24px;
    property <int> playlist-bar-ticks: RollMetrics.ticks-per-bar;
    property <[string]> musical-snap-options: [
        "1 Bar", "1/2", "1/4", "1/4T", "1/8", "1/8T",
        "1/16", "1/16T", "1/32", "1/32T", "1/64",
    ];
    in-out property <int> playlist-snap-index: 0;
    in-out property <int> piano-snap-index: 6;

    // The section of the arrangement the transport repeats, in absolute PPQ
    // ticks. The points survive being switched off, so the toggle has
    // something to switch back on and the strip keeps drawing the section
    // that will come back.
    in-out property <int> playlist-loop-start-ticks;
    in-out property <int> playlist-loop-end-ticks;
    in-out property <bool> playlist-loop-enabled;
    property <bool> playlist-has-loop:
        root.playlist-loop-end-ticks > root.playlist-loop-start-ticks;

    // Transport position, computed engine-side because it depends on PPQ and
    // on whether the playlist or the pattern is driving.
    in-out property <int> position-bar: 1;
    in-out property <int> position-beat: 1;
    in-out property <int> position-tick;

    // Pattern identity. Names are optional; the selector falls back to the
    // number so an unnamed pattern is never blank.
    in-out property <string> current-pattern-name;
    in-out property <[string]> pattern-menu-options;
    // The raw names, one per pattern, for the surfaces that draw a row per
    // pattern rather than a menu. `pattern-menu-options` cannot serve them:
    // it is decorated with the two-digit index a menu needs and would read
    // "05  Chorus" in a playlist gutter that already numbers its own rows.
    // One entry per pattern, and one list rather than a name list beside a
    // colour list: two parallel models are two lengths that can disagree,
    // which is this codebase's characteristic fault wearing a Slint costume.
    in-out property <[PatternInfo]> pattern-info;
    callback pattern-renamed(int, string);

    // The name to draw for a pattern, or its number when it has none. The
    // fallback lives here rather than at each call site so the playlist, the
    // menu and the toolbar placeholder cannot drift apart.
    pure function pattern-label(index: int) -> string {
        root.pattern-info[index].name == ""
            ? "Pattern " + (index + 1)
            : root.pattern-info[index].name
    }

    // Editing tool: 0=Select 1=Paint 2=Slice 3=Stretch.
    in-out property <int> tool-mode;
    // How many cells the rack grid accents on. It was a hardcoded four --
    // Adam: "its 1 bright 3 dim static" -- which is a 4/4 sixteenth grid and
    // nothing else. View state, like the two snap indices beside it, and not
    // persisted for the same reason.
    in-out property <int> step-group: 4;
    in-out property <[string]> step-group-options: ["2", "3", "4", "6", "8", "12", "16"];
    in-out property <int> step-group-index: 2;
    in-out property <int> slice-divisions: 2;
    // Paint and stretch are drags, so they report a target state rather than
    // toggling: a drag across mixed steps must not invert each one.
    callback step-painted(int, int, bool);   // channel, step, on
    callback step-sliced(int, int, int);     // channel, step, divisions
    callback step-length-dragged(int, int, int); // channel, step, length in steps
    property <int> playlist-snap-ticks: root.snap-ticks(root.playlist-snap-index);
    // `out` so the shortcut dispatcher can size an arrow-key nudge.
    out property <int> piano-snap-ticks: root.snap-ticks(root.piano-snap-index);
    // Whether the roll quantises at all. The snap-override gesture inverts
    // this for a single drag, in either direction.
    in-out property <bool> piano-snap-enabled: true;
    // Which pointer tool the note grid is in: 0 select, 1 draw, 2 paint,
    // 3 slice, 4 erase. Select is the default because it is the only one
    // that is safe to land on by accident.
    in-out property <int> piano-tool;

    pure function snap-ticks(index: int) -> int {
        index == 0 ? 384 : index == 1 ? 192 : index == 2 ? 96
            : index == 3 ? 64 : index == 4 ? 48 : index == 5 ? 32
            : index == 6 ? 24 : index == 7 ? 16 : index == 8 ? 12
            : index == 9 ? 8 : 6
    }

    // Playlist timeline geometry. The timeline starts 104px into the canvas,
    // past the pattern-name gutter, and every one of these is measured from
    // its left edge rather than the canvas's.
    pure function playlist-tick-at(x: length) -> int {
        clamp(floor(x * root.playlist-bar-ticks / root.playlist-bar-width),
            0, root.playlist-bars * root.playlist-bar-ticks - 1)
    }
    pure function playlist-snapped-tick-at(x: length) -> int {
        floor(root.playlist-tick-at(x) / root.playlist-snap-ticks)
            * root.playlist-snap-ticks
    }
    pure function playlist-tick-x(tick: int) -> length {
        tick * root.playlist-bar-width / root.playlist-bar-ticks
    }
    // The loop as bar numbers, for the sentence the status bar shows.
    //
    // The last bar the loop *touches*, counted from the tick before its
    // exclusive end so a section ending mid-bar still names that bar, and so
    // the arithmetic reads the same whether the division truncates or not.
    pure function playlist-loop-bars() -> string {
        (floor(root.playlist-loop-start-ticks / root.playlist-bar-ticks) + 1)
            + "\u{2013}"
            + (floor((root.playlist-loop-end-ticks - 1) / root.playlist-bar-ticks) + 1)
    }

    callback step-clicked(int, int);       // channel, step
    callback step-removed(int, int);       // channel, step
    callback step-velocity-edited(int, int, float); // channel, step, normalised velocity
    callback channel-selected(int);
    callback channel-muted(int);
    callback channel-soloed(int);
    callback channel-volume-changed(int, float);
    callback channel-pan-changed(int, float);
    callback channel-bus-changed(int, int); // channel, bus
    callback add-channel-clicked(int); // a `SourceKinds.labels` index
    callback remove-channel-clicked();
    // A channel was dragged from one row to another. Both indices, because a
    // reorder is a relationship between two seats and the drag knows both --
    // the alternative, "move the selected channel to here", would make the
    // gesture depend on a selection that the same press is setting.
    callback channel-reorder-requested(int, int); // from, to
    // A channel was renamed. It carries the index rather than acting on the
    // selection for the same reason `track-renamed` does: the field edits a
    // named thing, and which thing that is must not depend on what happens to
    // be selected when the keystroke lands.
    callback channel-renamed(int, string);
    // The row that was picked, never a value: Rust owns both lists.
    callback midi-input-picked(int);
    callback midi-channel-picked(int);
    callback audio-input-picked(int);
    callback audio-monitor-toggled(bool);
    callback sampler-record-clicked();
    callback sampler-record-clip-changed(bool);
    callback sampler-record-bars-changed(int);
    callback record-armed-toggled();
    // Channel structure is a project edit, so these callbacks carry the
    // clicked row rather than relying on whichever row was selected before a
    // context menu opened.
    in-out property <bool> channel-clipboard-available: false;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> project-edit-pending: false;
    // 0=Undo, 1=Redo, 2=Cut channel, 3=Copy channel, 4=Paste channel,
    // 5=Clone channel, 6=Delete channel.  Menu, keyboard, and context menus
    // intentionally route through this one command surface.
    callback edit-command-requested(int, int);
    callback add-pattern-clicked();
    callback pattern-selected(int);
    callback pattern-length-changed(int);
    callback playback-mode-changed(bool);
    callback playlist-placement-added(int, int);   // pattern, absolute start tick
    callback playlist-placement-removed(int, int); // pattern, tick covered by clip
    callback playlist-seek(int);                   // absolute tick to play from
    callback playlist-loop-set(int, int);          // two ticks, in either order
    // The same two ticks, from an edge handle rather than a drag across the
    // empty strip. Separate because the two gestures disagree about one
    // thing: `-set` turns looping on, being the gesture that asks for a loop,
    // and `-adjusted` leaves the toggle alone. See `Session::adjust_loop_range`.
    callback playlist-loop-adjusted(int, int);
    callback playlist-loop-enabled-changed(bool);
    callback playlist-loop-cleared();

    // ---- mixer ----
    // The work surface shows either the step grid or the mixer; the bottom
    // device rack follows whichever strip is selected in the visible one.
    in property <[MixerStripRow]> mixer-strips;
    // Full bus names, master first, indexed by bus. Shared by every picker.
    in property <[string]> bus-names;
    callback bus-selected(int);
    callback bus-muted(int);
    callback bus-volume-changed(int, float);
    callback bus-pan-changed(int, float);
    callback bus-output-changed(int, int);
    callback bus-console-toggled(int);
    callback bus-polarity-toggled(int);
    callback bus-solo-toggled(int);
    callback bus-clip-reset(int);
    // One callback for the whole channel strip, carrying the parameter id
    // `mooloop_core::strip` gave it. The markup reads that id from the
    // `StripSpec` global, which Rust fills from the same constants, so
    // neither side spells a number and there is no per-section verb to keep
    // in step. The voicing is separate only because it is an index into a
    // named set rather than a value.
    callback bus-strip-param(int, int, float);
    /// A point dragged on the EQ's response plot, as a track, a band, and
    /// the hertz and decibels it landed on. Rust snaps the hertz to the
    /// nearest of the band's positions, which is where that arithmetic
    /// lives.
    callback bus-strip-point-dragged(int, int, float, float);
    callback bus-voicing-picked(int, int);
    // Track structure. One `+`; routing decides what a track is.
    callback track-added();
    callback track-renamed(int, string);
    callback track-removed(int);
    // A track dragged by its name plate, or moved a seat by the Track menu:
    // `(from, to)`, never the master's seat at either end.
    callback track-reorder-requested(int, int);
    in property <bool> can-add-track: true;

    // ---- the bus the device rack is editing, when it is editing one ----
    in property <bool> editing-bus;
    in property <int> editing-bus-index;
    in property <string> editing-bus-name;
    in property <bool> editing-bus-is-master;
    in property <bool> editing-bus-muted;
    in property <float> editing-bus-volume: 1.0;
    in property <float> editing-bus-pan;
    in property <int> editing-bus-output;
    in property <int> editing-bus-feed-count;
    in property <bool> editing-bus-console;
    in property <bool> editing-bus-polarity;
    in property <bool> editing-bus-solo;
    // The edited track's colour, in the three shapes a face needs. Same
    // reason as the channel's: Slint has no `Option`, and the hex is what a
    // swatch is matched against.
    in property <bool> editing-bus-has-color;
    in property <color> editing-bus-color;
    in property <string> editing-bus-color-hex;
    callback track-color-chosen(int, string);
    // The strip of the track the rack is following, for the pinned row.
    in property <StripRow> editing-bus-strip;
    // Whether that row draws before the track's own devices or after them.
    // `mooloop_core::mixer::STRIP_PIN` decides, and the engine's block loop
    // reads the same constant -- so the rack cannot draw the strip in a
    // place the audio does not run it.
    in property <bool> strip-pin-head: true;
    in property <bool> editing-bus-can-remove;
    // Whether the edited track can move a seat each way. From
    // `Session::can_move_track`, which is `Project::move_track`'s own rule.
    in property <bool> editing-bus-can-move-left;
    in property <bool> editing-bus-can-move-right;
    in property <[bool]> editing-bus-allowed;
    in property <float> editing-bus-left-db: GainMath.min-db;
    in property <float> editing-bus-right-db: GainMath.min-db;
    /// Peak hold and the clip latch for the track being edited, so its fader
    /// row's meter behaves like its mixer strip's. The pump has had these in
    /// hand all along -- they come off the same `MeterReading` -- and set
    /// only the two levels until 2026-09-14.
    in property <float> editing-bus-held-left-db: GainMath.min-db;
    in property <float> editing-bus-held-right-db: GainMath.min-db;
    in property <bool> editing-bus-clipping;
    in property <float> editing-bus-input-left-db: GainMath.min-db;
    in property <float> editing-bus-input-right-db: GainMath.min-db;
    // The sends this track has, and which tracks it may gain one to. Exactly
    // the sends that exist: the face draws no empty bays and there is no
    // drawn ceiling on how many there are.
    in property <int> editing-bus-send-feed-count;
    in property <[MixerSendRow]> editing-bus-sends;
    in property <[bool]> editing-bus-send-allowed;
    callback send-added(int, int);
    callback send-removed(int, int);
    callback send-level-changed(int, int, float);
    callback send-tap-picked(int, int, int);
    callback send-enable-toggled(int, int);

    // ---- lower editor ----
    //
    // **Each view remembers its own dock height**, so switching tabs restores
    // the height that view was left at rather than sharing one number across
    // three editors. This used to be a conditional chain that hardcoded three
    // of them; they are the same three, now said once each and writable.
    //
    // `DEVICES` is absent on purpose: it is the one view with an intrinsic
    // height, since a face is a fixed 268px and does not stretch. That single
    // fact is the whole of "the bottom pane resizes except on the devices
    // page" -- the grip is live unless the bottom view declares its own size.
    in-out property <length> notes-dock-height: 410px;
    in-out property <length> playlist-dock-height: 376px;
    in-out property <length> steps-dock-height: 300px;
    in-out property <length> mixer-dock-height: 300px;
    function dock-height(v: int) -> length {
        return v == PaneViews.notes ? root.notes-dock-height
            : v == PaneViews.playlist ? root.playlist-dock-height
            : v == PaneViews.steps ? root.steps-dock-height
            : root.mixer-dock-height;
    }
    function set-dock-height(v: int, h: length) {
        if (v == PaneViews.notes) { root.notes-dock-height = h; }
        else if (v == PaneViews.playlist) { root.playlist-dock-height = h; }
        else if (v == PaneViews.steps) { root.steps-dock-height = h; }
        else if (v == PaneViews.mixer) { root.mixer-dock-height = h; }
    }
    // Where the top pane's divider sits, as a fraction of the work area's
    // width. Nothing drives it until step 02 opens the split.
    in-out property <float> split-fraction: 0.5;
    // The whole lower dock (splitter included) can collapse to give the work
    // surface the full column; the status bar's panel button restores it.
    in-out property <bool> bottom-pane-visible: true;

    // ---- panes ----
    //
    // Which slot each view lives in, indexed by view id: 0 main, 1 split,
    // 2 bottom. These are the defaults the interface has today, which is the
    // point -- step 01 changes the mechanism and not the arrangement. Step 02
    // makes them move.
    // Membership is five scalars rather than one array, because a slot is
    // assigned to and Slint has no way to write into an array element. The
    // array below exists only so a tab strip can iterate its members.
    in-out property <int> steps-slot: 0;
    in-out property <int> mixer-slot: 0;
    in-out property <int> devices-slot: 2;
    in-out property <int> notes-slot: 2;
    in-out property <int> playlist-slot: 2;
    property <[int]> view-slots: [
        root.steps-slot, root.mixer-slot, root.devices-slot,
        root.notes-slot, root.playlist-slot,
    ];
    /// The arrangement changed and is worth remembering. Fired on discrete
    /// changes and at the *end* of a drag, never per frame: a divider drag
    /// would otherwise rewrite `settings.toml` on every pointer move.
    callback layout-changed();

    // A tab click.
    callback view-picked(int);
    view-picked(v) => { root.show-view(v); }

    // A tab drag. The tab publishes the grab, the work area publishes the
    // landing, and these two resolve it.
    callback view-drag-started(int);
    view-drag-started(v) => {
        // The last view in the main slot is not draggable out; refusing at
        // the grab is clearer than accepting the drag and snapping it back.
        if (root.slot-of(v) == 0 && root.main-view-count() <= 1) { return; }
        PaneDrag.view = v;
        PaneDrag.active = true;
    }
    callback view-drag-dropped(int);
    view-drag-dropped(v) => {
        if (PaneDrag.active && work.drop-slot >= 0) {
            root.move-view(v, work.drop-slot);
        }
        PaneDrag.end();
    }

    function slot-of(v: int) -> int {
        return v == PaneViews.steps ? root.steps-slot
            : v == PaneViews.mixer ? root.mixer-slot
            : v == PaneViews.devices ? root.devices-slot
            : v == PaneViews.notes ? root.notes-slot
            : root.playlist-slot;
    }
    function set-view-slot(v: int, s: int) {
        if (v == PaneViews.steps) { root.steps-slot = s; }
        else if (v == PaneViews.mixer) { root.mixer-slot = s; }
        else if (v == PaneViews.devices) { root.devices-slot = s; }
        else if (v == PaneViews.notes) { root.notes-slot = s; }
        else { root.playlist-slot = s; }
    }
    function set-slot-active(s: int, v: int) {
        if (s == 0) { root.main-active = v; }
        else if (s == 1) { root.split-active = v; }
        else { root.bottom-active = v; }
    }
    // Reveal a view where it lives. Rust calls this; so does every tab.
    public function show-view(v: int) {
        root.set-slot-active(root.slot-of(v), v);
        root.active-slot = root.slot-of(v);
        root.layout-changed();
    }

    // The main slot's other view -- the one the split opens with, so opening
    // it needs no prompt and no menu. Written out rather than looped because
    // Slint functions have no loop and there are five views; the order is the
    // tab order, so it is "the next tab along" as read.
    function other-main-view() -> int {
        return (root.steps-slot == 0 && root.main-active != PaneViews.steps) ? PaneViews.steps
            : (root.mixer-slot == 0 && root.main-active != PaneViews.mixer) ? PaneViews.mixer
            : (root.devices-slot == 0 && root.main-active != PaneViews.devices) ? PaneViews.devices
            : (root.notes-slot == 0 && root.main-active != PaneViews.notes) ? PaneViews.notes
            : (root.playlist-slot == 0 && root.main-active != PaneViews.playlist) ? PaneViews.playlist
            : -1;
    }
    // Open or close the split. Closing folds its views back into the main
    // slot rather than losing them, which is also what the divider does when
    // it is dragged to an edge -- one behaviour, two ways to ask for it.
    // The left sidebar's one switch (MOO-8): the status-bar chip, the View
    // menu row and `view.channel-sidebar-toggle` all come through here, so
    // there is one place that knows showing it is a layout change to save.
    public function toggle-channel-sidebar() {
        root.channel-sidebar-visible = !root.channel-sidebar-visible;
        root.layout-changed();
    }

    public function toggle-split() {
        if (root.split-active >= 0) {
            if (root.steps-slot == 1) { root.steps-slot = 0; }
            if (root.mixer-slot == 1) { root.mixer-slot = 0; }
            if (root.devices-slot == 1) { root.devices-slot = 0; }
            if (root.notes-slot == 1) { root.notes-slot = 0; }
            if (root.playlist-slot == 1) { root.playlist-slot = 0; }
            // `main-active` is deliberately left alone: closing the split
            // takes a pane away, it does not change what the pane you kept
            // was showing.
            root.split-active = -1;
        } else if (root.other-main-view() >= 0) {
            root.split-active = root.other-main-view();
            root.set-view-slot(root.split-active, 1);
            root.split-fraction = 0.5;
        }
        root.layout-changed();
    }
    // Which view is active in each slot, or -1 for a slot holding nothing.
    // This is the state now: `editor-page` and `mixer-visible` are gone,
    // because a page index cannot name a view that has moved to another pane.
    // Rust reveals a view with `show-view` and asks after one with the
    // `showing-*` properties below.
    // Which slot fills the window, or -1 for the ordinary arrangement.
    //
    // Zoom does not *move* a view: leaving it puts everything back exactly
    // where it was, which is what makes it safe to reach for at a glance.
    // Entered and left by double-clicking a pane's active tab -- the gesture
    // a title bar has, on the control that names the pane -- and by Esc,
    // `View > Zoom Pane`, and the `view.zoom-pane` action.
    in-out property <int> zoomed: -1;
    public function toggle-zoom(s: int) {
        root.zoomed = root.zoomed == s ? -1 : s;
    }
    // The last slot a view was revealed in -- by a tab, a chord or a menu
    // row. It is not a focus model and does not pretend to be one; it is the
    // only honest answer available to "which pane did you mean" for the
    // gestures that are not aimed with a pointer. Starts at the dock, which
    // is where the editors are and what is showing at launch.
    in-out property <int> active-slot: 2;
    // How many views the main slot holds. Main is never allowed to empty --
    // there would be no pane left to drop anything back onto -- so the last
    // view in it refuses to be dragged out rather than snapping back.
    function main-view-count() -> int {
        return (root.steps-slot == 0 ? 1 : 0) + (root.mixer-slot == 0 ? 1 : 0)
            + (root.devices-slot == 0 ? 1 : 0) + (root.notes-slot == 0 ? 1 : 0)
            + (root.playlist-slot == 0 ? 1 : 0);
    }
    // Give a slot back an active view after one has left it.
    //
    // Two things this has to get right, and the first version got both wrong.
    // **The main slot needs this too**: it may not run out of *views*, but the
    // view it was *showing* can certainly leave, and the pane then draws
    // nothing with no tab left to click. And it must only act when the active
    // view has actually gone -- moving some other view out of a three-tab pane
    // must not throw away the one you were looking at.
    function reseat-slot(s: int) {
        // The active view still lives here. Nothing to do.
        if (root.slot-active(s) >= 0 && root.slot-of(root.slot-active(s)) == s) { return; }
        if (root.steps-slot == s) { root.set-slot-active(s, PaneViews.steps); }
        else if (root.mixer-slot == s) { root.set-slot-active(s, PaneViews.mixer); }
        else if (root.devices-slot == s) { root.set-slot-active(s, PaneViews.devices); }
        else if (root.notes-slot == s) { root.set-slot-active(s, PaneViews.notes); }
        else if (root.playlist-slot == s) { root.set-slot-active(s, PaneViews.playlist); }
        else { root.set-slot-active(s, -1); }
    }
    // Move a view to a slot and make it the active one there. Dropping into
    // slot 1 while there is no split is what opens the split -- the gesture
    // people arrive already knowing, and the reason the chip is a
    // convenience rather than the only way in.
    public function move-view(v: int, s: int) {
        if (root.slot-of(v) == s) { root.show-view(v); return; }
        if (root.slot-of(v) == 0 && root.main-view-count() <= 1) { return; }
        let from = root.slot-of(v);
        root.set-view-slot(v, s);
        root.set-slot-active(s, v);
        root.active-slot = s;
        root.reseat-slot(from);
        root.layout-changed();
    }
    public function toggle-zoom-active() {
        root.toggle-zoom(root.zoomed >= 0 ? root.zoomed : root.active-slot);
    }

    in-out property <int> main-active: PaneViews.steps;
    in-out property <int> split-active: -1;
    in-out property <int> bottom-active: PaneViews.devices;
    // Which view is active in a slot, and whether a given view is the one.
    // Functions rather than an indexed array: a nested model access --
    // `slot-active[view-slots[v]]` -- reads as the obvious spelling and does
    // not evaluate, which cost an afternoon and is worth a comment.
    function slot-active(s: int) -> int {
        return s == 0 ? root.main-active
            : s == 1 ? root.split-active
            : root.bottom-active;
    }
    function view-showing(v: int, s: int) -> bool {
        return root.slot-active(s) == v && (root.zoomed < 0 || root.zoomed == s);
    }
    // What Rust asks instead of comparing a page index. Each is "this view is
    // the active view of whichever slot holds it", which stays true however
    // the panes are arranged.
    out property <bool> showing-steps: root.view-showing(PaneViews.steps, root.steps-slot);
    out property <bool> showing-mixer: root.view-showing(PaneViews.mixer, root.mixer-slot);
    out property <bool> showing-devices: root.view-showing(PaneViews.devices, root.devices-slot);
    out property <bool> showing-notes: root.view-showing(PaneViews.notes, root.notes-slot);
    out property <bool> showing-playlist: root.view-showing(PaneViews.playlist, root.playlist-slot);
    // How much room the bottom slot takes. DEVICES declares its own height;
    // every other view is given one. The three numbers were a conditional
    // chain on `editor-page` -- they are the same three, said once each.
    property <length> devices-extent: 408px
        + (root.modulation-shelf-open && !root.editing-bus
            ? ModulationShelfMetrics.open-height - ModulationShelfMetrics.closed-height
            : 0px);
    property <length> bottom-extent: !root.bottom-pane-visible || root.bottom-active < 0 ? 0px
        : PaneViews.fixed-height[root.bottom-active] ? root.devices-extent
        : root.dock-height(root.bottom-active);
    // Hide and show ease, as the dock's own height used to. The grip steps
    // the animation aside while it owns the value, which is what
    // `Motion.gesture-active` is for.
    animate bottom-extent {
        duration: Motion.duration;
        easing: Motion.curve;
        enabled: !Motion.gesture-active;
    }
    // The grip clamps while dragging, but only this catches the window
    // itself shrinking under a tall dock. Kept out of the dock's height
    // binding: reading root.height there loops through the layout.
    changed height => {
        if (root.bottom-active >= 0 && !PaneViews.fixed-height[root.bottom-active]) {
            root.set-dock-height(root.bottom-active, max(140px,
                min(root.dock-height(root.bottom-active), root.height - 220px)));
        }
    }
    // Browser sidebar. Hidden by default; the status bar's panel icon
    // toggles it. Width bounds: a 180px floor, a 400px ceiling, and never
    // wider than the window minus room for the work surface.
    in-out property <bool> sidebar-visible;
    in-out property <length> sidebar-width: 260px;
    // The channel sidebar on the left: the selected channel's name, its
    // colour, and the MIDI rows it will one day configure. A separate panel
    // from the browser with its own width, and hidden by default for the same
    // reason -- a first run should show the work rather than the chrome.
    in-out property <bool> channel-sidebar-visible;
    in-out property <length> channel-sidebar-width: 220px;
    // What is left for the work surface once the *other* panel has had its
    // share. Two panels sharing one window cannot each clamp against the
    // whole of it: at 1000px they would agree on 400px apiece and leave 200
    // for the editor. Each therefore measures against the window minus its
    // sibling, which is why this is a function rather than a constant.
    pure function sidebar-ceiling(other: length) -> length {
        return max(180px, min(400px, root.width - 280px - other));
    }
    changed width => {
        if (root.sidebar-visible) {
            root.sidebar-width = max(180px, min(root.sidebar-width,
                root.sidebar-ceiling(root.channel-sidebar-visible
                    ? root.channel-sidebar-width : 0px)));
        }
        if (root.channel-sidebar-visible) {
            root.channel-sidebar-width = max(180px, min(root.channel-sidebar-width,
                root.sidebar-ceiling(root.sidebar-visible ? root.sidebar-width : 0px)));
        }
    }
    // The status bar's layout chips, as a property so the row's arithmetic
    // can count them. **They read in the screen order of the regions they
    // toggle**, by each region's left edge: the channel sidebar at x 0, the
    // dock below it, the split at the divider, the browser at the right
    // sidebar's edge. Adam asked for that ordering on 2026-09-08, and it is
    // why the channel sidebar's chip goes first rather than last -- and why
    // it draws `panel-left`, which is the glyph the browser chip wrongly wore
    // until that pass.
    property <[{ on: bool, fill: string, line: string, label: string }]> layout-chips: [
        { on: root.channel-sidebar-visible, fill: ToolIcons.panel-left-fill,
          line: ToolIcons.panel-left, label: "Toggle channel sidebar" },
        { on: root.bottom-pane-visible, fill: ToolIcons.panel-bottom-fill,
          line: ToolIcons.panel-bottom, label: "Toggle bottom pane" },
        { on: root.split-active >= 0, fill: "",
          line: ToolIcons.panel-split, label: "Split top pane" },
        { on: root.sidebar-visible, fill: ToolIcons.panel-right-fill,
          line: ToolIcons.panel-right, label: "Toggle browser" },
    ];
    // The selected channel's colour, in the three shapes the face needs
    // because Slint has no `Option`: whether it has one, the colour to draw,
    // and the canonical `#RRGGBB` to store and to match a swatch against.
    in-out property <bool> selected-channel-has-color;
    in-out property <color> selected-channel-color;
    in-out property <string> selected-channel-color-hex;
    // The swatch palette, handed over once by Rust. Markup cannot hold it:
    // Slint cannot parse a hex string into a colour, so a swatch cannot
    // derive its tint from the value it writes. Not the *channel's* palette:
    // one set of suggested colours serves channels and patterns alike.
    in-out property <[ColorChoice]> color-choices;
    // The colour the selected channel should take, or "" for none. Rust
    // parses it, ignores what is not a colour, and pushes the result back.
    callback channel-color-chosen(string);
    // The current pattern's colour, in the same three shapes and for the same
    // reason. It shares the channel's swatch palette: one set of suggested
    // colours across the application, because a song that colours its Kick
    // and its Chorus from two different elevens is harder to read, not richer.
    in-out property <bool> current-pattern-has-color;
    in-out property <color> current-pattern-color;
    in-out property <string> current-pattern-color-hex;
    callback pattern-color-chosen(int, string);
    // Sample browser tree, flattened by Rust into one row per visible
    // folder/file. Adding a location opens the folder picker on a worker
    // thread; toggling expands or collapses that folder in place. Clicking
    // a sample row fills the info pane and, with autoplay armed, plays it.
    in-out property <[BrowserRow]> browser-rows;
    // Which panel a contextual action resolves against: one of the names in
    // `actions.rs`'s `Surface`, held as a string so neither side spells an
    // index. Written from Rust whenever a click says where the user is, and
    // read back by the dispatcher for `Scope::Focused` actions.
    // `actions.rs`'s `focused_surface_names_match_the_markup` holds the four
    // names together.
    in-out property <string> focused-surface: "channels";
    // Which row the keyboard is on, or -1 for none. The browser has no
    // `FocusScope` of its own and deliberately does not get one: a nested
    // scope swallows the pointer press that focuses it, which is the
    // two-clicks-per-control bug the root scope's comment and
    // `tests/first_click.rs` are both about. The root scope already hears
    // every key; what the browser was missing was somewhere for them to be
    // *aimed*, which is this plus `focused-surface`.
    in-out property <int> browser-focus-index: -1;
    callback browser-add-location();
    callback browser-row-toggled(string);
    callback browser-location-removed(string);
    callback browser-row-previewed(string);
    // Right-click menu on a sample row: load it into the selected channel
    // as-is, or into a fresh sampler channel.
    callback browser-sample-loaded(string);
    callback browser-sample-loaded-new-channel(string);
    // Which half of the browser panel is showing: 0 samples, 1 presets.
    // Rust owns the rows, so it has to be told; the property is the view's
    // and the callback is what makes the model match it.
    in-out property <int> browser-tab;
    callback browser-tab-changed(int);
    callback browser-preset-loaded(string);
    // Always a new device, from the preset row's menu (MOO-9).
    callback browser-preset-appended(string);
    // A preset dropped on a join: a new device before that row (MOO-218).
    callback browser-preset-dropped(string, int);
    // The browser's filter field, both tabs (MOO-9).
    in-out property <string> browser-filter;
    callback browser-filter-changed(string);
    callback device-selected(int);
    // The generator at the head of the chain, selected or unselected by
    // clicking its header. Separate from `device-selected` because a
    // generator has no rack index to name it by -- there is only ever one,
    // and it is the one belonging to the chain now being edited.
    callback source-select-toggled();
    in property <bool> source-selected: false;
    callback duplicate-effect-clicked(int);
    // 0 copy, 1 cut, 2 paste, 3 duplicate -- all acting on the selected
    // device. One callback rather than four, because the shortcut dispatcher
    // is the only caller and the verb is already an integer by the time it
    // gets here.
    callback device-clipboard-action(int);
    // Preview voice controls: the toggle arms click-to-play, the knob is
    // the preview's own gain in dB (the callback carries linear gain). It
    // starts at the operating level, matching the engine's preview cell:
    // auditioning a full-scale file should not be louder than the project.
    in-out property <bool> browser-autoplay: true;
    in-out property <float> browser-preview-gain-db: GainMath.reference-peak-dbfs;
    callback browser-preview-gain-changed(float);
    // Info pane for the last-clicked sample. Empty waveform = nothing
    // inspected yet.
    in-out property <[float]> browser-info-waveform;
    in-out property <string> browser-info-name;
    in-out property <string> browser-info-stats;
    in-out property <int> source-kind;      // 0=Sampler, 1=Drum, 2=Mono, 3=Poly, 4=ML-M1, 5=ML-P8, 6=DS-01, 7=Aux In

    // The selected channel's generator as one row (`SourceRow`, above) --
    // the pilot for the flat per-parameter properties every other generator
    // still uses below. Only filled for Aux In today; see the struct's own
    // comment.
    in property <SourceRow> source;
    callback source-param-changed(int, float);

    // ---- Aux In of the selected channel ----
    // "None" plus every channel that publishes audio. Already filtered, so a
    // row is not a channel index and the callbacks report the row.
    in property <[string]> aux-in-source-names;
    in-out property <int> aux-in-source-index;
    in property <[string]> aux-in-outlet-names;
    in-out property <int> aux-in-outlet-index;
    in property <string> aux-in-level-text;
    in property <string> aux-in-tap-text;
    in property <string> aux-in-refusal-text;
    callback aux-in-source-picked(int);
    callback aux-in-outlet-picked(int);
    in-out property <int> sampler-device-page;
    in-out property <int> mono-device-page;
    in-out property <int> poly-device-page;
    callback channel-source-changed(int);

    // ---- effect chain of the selected channel ----
    in property <[EffectSlotRow]> effect-slots;
    // EffectKind index, then the slot it must precede. `effect-slots.length`
    // means append; every device shell can therefore insert into the chain.
    callback add-effect-clicked(int, int);
    // Insert a device as the first thing inside the container in this slot.
    callback add-effect-into-container(int, int);   // kind, container slot
    // A layer's list (`containers/09`): show this branch in the rack, which
    // is looking rather than an edit and reaches no engine; and add an empty
    // branch at the end of the layer.
    callback layer-branch-selected(int, int);       // layer slot, branch head slot
    callback layer-branch-added(int);               // layer slot
    callback remove-effect-clicked(int);            // slot
    // Wrap the device in `slot` -- and its run, when it is already a
    // container -- in a new container. Unwrap takes a container out and
    // leaves what was inside it where it is.
    callback wrap-effect-clicked(int, int);         // slot, kind to wrap in
    callback unwrap-effect-clicked(int);            // slot
    callback effect-bypass-toggled(int);            // slot
    // Slot, then an index into that row's preset-options.
    callback effect-preset-selected(int, int);
    callback save-effect-preset-requested(int);     // slot
    callback effect-wet-dry-changed(int, float);
    callback effect-input-trim-changed(int, float);
    callback effect-output-trim-changed(int, float);
    // slot, descriptor index within the kind, normalized 0..1. One callback
    // covers every parameter of every effect kind.
    callback effect-param-changed(int, int, float);
    callback delay-tempo-sync-changed(int, bool);
    callback modulation-tempo-sync-changed(int, bool);
    callback modulation-rate-division-changed(int, int);
    callback delay-time-division-changed(int, int);
    // Slot, the gate parameter's position in the descriptor table, and
    // whether it is down. One
    // callback for all three gestures, because a gate is a gate: what the
    // face knows is which parameter it is holding, and a fourth gesture
    // would need no new wiring at all.
    callback effect-buffer-gate(int, int, bool);
    callback effect-buffer-quantize(int, bool);
    callback effect-buffer-freeze(int, bool);
    // Slot and bars. Not a parameter write: the ring is reallocated for it.
    callback effect-buffer-history-bars(int, int);
    callback eq-analyzer-changed(int, bool);
    callback preamp-display-changed(int, bool);
    // A Bus Comp insert's control moved (MOO-216): the rack slot, the master
    // section's id for it, and the value in natural units. Rust maps it onto
    // the insert's own id and normalizes it through that descriptor.
    callback bus-comp-param-changed(int, int, float);
    callback reorder-effect(int, int);              // from slot, to slot

    // ---- channel modulation shelf ----
    // The shelf belongs to the selected channel, never the bus chain. Values
    // are plain UI rows; Rust owns their `ModRack` / `ParamAddr` conversion.
    in property <[ModulationSourceRow]> modulation-sources;
    in property <[ModulationOutletRow]> modulation-outlets;
    in property <[ModulationRouteRow]> modulation-routes;
    in-out property <bool> modulation-shelf-open;
    in-out property <int> modulation-selected-slot: -1;
    in-out property <int> modulation-armed-slot: -1;
    in property <int> modulation-selected-kind: -1;
    // Selection chooses the source editor. Arming is a separate, deliberate
    // assignment mode, so inspecting an LFO never changes what a knob drag
    // means. The selected source's values and the rack capacity come from
    // Rust rather than being inferred by the shelf.
    // The selected source's parameters, indexed by descriptor id; the shelf's
    // editors are the sole consumer.
    in property <[float]> modulation-selected-values;
    in property <float> modulation-selected-preview-fade-cycles;
    in property <float> modulation-selected-preview-smoothing-cycles;
    in property <[string]> modulation-input-channels;
    in property <int> modulation-selected-envelope-input-channel;
    in property <float> modulation-selected-envelope-preview-attack;
    in property <float> modulation-selected-envelope-preview-decay;
    in property <float> modulation-selected-envelope-preview-release;
    in property <int> modulation-max-sources;
    in property <[string]> modulation-slot-names;
    in property <string> modulation-outlet-device;
    in property <string> modulation-armed-name;
    in property <string> modulation-selected-outlet-name;
    in property <string> modulation-selected-outlet-signal;
    callback modulation-shelf-toggled();
    callback modulation-source-selected(int);
    callback modulation-source-moved(int, int);
    callback modulation-assignment-toggled();
    callback modulation-source-added(int);
    callback modulation-param-changed(int, int, float);
    callback modulation-param-edit-started();
    callback modulation-param-edit-finished();
    callback modulation-source-removed(int);
    callback modulation-envelope-input-channel-changed(int, int);
    callback modulation-route-polarity-changed(int, int);
    callback modulation-route-removed(int);
    // Generator and strip destinations, indexed by descriptor position the
    // same way `EffectSlotRow` indexes an insert's.
    in property <[float]> source-modulation-depths;
    in property <[float]> source-param-defaults;
    in property <[bool]> source-modulation-allowed;
    in property <[float]> source-modulation-offsets;
    in property <[int]> source-modulation-route-counts;
    in property <[float]> strip-modulation-depths;
    in property <[bool]> strip-modulation-allowed;
    callback source-modulation-depth-changed(int, float);
    callback source-modulation-edit-started(int);
    callback source-modulation-edit-finished(int);
    callback strip-modulation-depth-changed(int, float);
    callback strip-modulation-edit-started(int);
    callback strip-modulation-edit-finished(int);
    callback effect-modulation-depth-changed(int, int, float);
    callback effect-modulation-edit-started(int, int);
    callback effect-modulation-edit-finished(int, int);
    in-out property <int> selected-note-step;
    in-out property <int> selected-note;
    in-out property <int> selected-velocity;
    in-out property <bool> has-selected-note;
    in-out property <bool> has-note-selection;
    // The piano roll is a MIDI editor, rather than a C2–C6 drum-only view.
    // Keep the bounds and every pixel extent derived from this range so the
    // pitch scrollbar can reach notes below C2 too.
    property <int> piano-low-note: 0;
    property <int> piano-high-note: 127;
    property <int> piano-note-count: root.piano-high-note - root.piano-low-note + 1;
    // Starts three pitch-zoom steps above the old 5px minimum: that is where
    // Adam kept landing after clicking zoom-in, so start there.
    property <length> piano-row-height: 8px;
    property <length> piano-step-width: 32px;
    // Full scrollable extent of the piano-roll grid in pixels; the zoom
    // scrollbars work against these.
    property <length> piano-content-w: root.pattern-length * root.piano-step-width;
    property <length> piano-content-h: root.piano-note-count * root.piano-row-height;

    // A pointer gesture reports an edit on every move frame. Bracketing the
    // gesture lets the history collapse those frames into the one undo step
    // the user thinks they performed; without it a single note drag costs
    // twenty undos.
    // Resolved from `gestures.rs` plus the user's Preferences overrides.
    in property <PianoGestures> piano-gestures;
    // The selection's bounding box, for the grid's selection frame and its
    // scale handles. Zero count means no frame.
    in property <int> selection-count;
    in property <int> selection-start-tick;
    in property <int> selection-end-tick;
    in property <int> selection-low-note;
    in property <int> selection-high-note;
    // Time-scaling the selection. Begin caches the pre-drag geometry in Rust
    // so every frame scales the original rather than compounding on the
    // previous frame's rounding.
    callback piano-scale-begin(bool);   // true when dragging the left handle
    callback piano-selection-scaled(float);
    callback piano-notes-nudged(int, int); // tick delta, semitone delta
    callback piano-notes-copied(bool);     // true to cut
    callback piano-notes-pasted();
    callback piano-gesture-begin();
    callback piano-gesture-end();
    callback piano-note-created(int, int, int) -> int;  // start tick, MIDI note, duration ticks -> stable note ID
    callback piano-note-selected(int, int); // stable note ID, 0 replace / 1 add / 2 remove
    // ID, start tick, MIDI note. The ID names the note under the pointer; the
    // whole selection moves with it, by the delta this note implies.
    callback piano-note-moved(int, int, int);
    // Copy the current selection in place and return the copy of the note the
    // caller names, so a Ctrl-drag can continue on the duplicate. -1 when
    // nothing was duplicated.
    callback piano-selection-duplicated(int) -> int;
    callback piano-note-resized(int, int);  // ID, duration ticks
    // Left-edge resize: the end tick stays put and the start moves.
    callback piano-note-start-resized(int, int); // ID, start tick
    callback piano-note-removed(int);       // stable note ID
    // Marquee selection. Begin snapshots the base selection in Rust, because
    // the band updates live and would otherwise clobber its own base every
    // frame when adding to or removing from an existing selection.
    callback piano-marquee-begin(int);      // 0 replace / 1 add / 2 remove
    callback piano-marquee-updated(int, int, int, int); // start tick, end tick, low note, high note
    callback piano-note-sliced(int, int);   // stable note ID, tick to cut at
    callback piano-selection-joined();
    callback piano-cell-painted(int, int, int); // start tick, MIDI note, duration ticks
    // Pure so it can be read from the cursor-shape binding below. Rust owns the
    // note list, so the scan lives there.
    pure callback piano-note-hit-test(int, int) -> NoteHit; // tick, MIDI note -> note under it, if any
    callback velocity-edited(int, float);   // stable note ID, normalised value

    // ---- editor lanes below the piano roll ----
    // Velocity and automation toggle independently: the roll alone, the roll
    // plus either, or all three are all reasonable working layouts.
    in-out property <bool> velocity-lane-visible: true;
    in-out property <bool> automation-lane-visible: false;
    in property <[AutomationTargetRow]> automation-targets;
    in property <[AutomationPointCell]> automation-points;
    // Empty when no lane is open, which is what makes the lane draw its
    // "pick a destination" prompt instead of a curve.
    in property <string> automation-lane-name;
    // Natural-units readout of the point under the pointer, e.g. "1.2 kHz".
    in property <string> automation-value-text;
    // Index into `automation-targets`.
    // `-opened` and not `-selected`: this is an edit. It mutates the
    // document, marks it dirty and records undo history, and the session
    // method it calls is already `open_automation_lane`. The name is what
    // makes `scripts/dupe-audit navigation-sends` able to be clean --
    // a selection handler that sends is the shape MOO-57 had.
    callback automation-lane-opened(int);
    callback automation-lane-cleared();
    callback automation-lane-closed();
    // tick, normalised value -> stable point ID (-1 when the lane is full or
    // no destination is open).
    callback automation-point-created(int, float) -> int;
    callback automation-point-moved(int, int, float);  // ID, tick, value
    callback automation-point-removed(int);
    // Point under a tick/value cell, if any. Same reason as the note hit test:
    // the scan needs a loop, which Slint's expression language cannot express.
    // tick, normalised value, and the grab radius in ticks -> point ID, or -1.
    // The radius comes from the view because only the view knows the current
    // time zoom; Rust would otherwise guess at what "near" means on screen.
    pure callback automation-point-hit-test(int, float, int) -> int;

    callback selected-note-changed(int);
    callback selected-velocity-changed(int);
    // Length as a musical division. `selected-duration-index` is -1 when the
    // selection's length matches no listed division, or when the selection
    // is not all one length; the text beside it always shows the truth.
    in property <int> selected-duration-index: -1;
    in property <string> selected-duration-text;
    callback selected-duration-picked(int);

    // ---- sampler params of the selected channel ----
    in-out property <float> attack;
    in-out property <float> decay;
    in-out property <float> sustain;
    in-out property <float> release;
    in-out property <float> start-pos;
    in-out property <float> end-pos: 1;
    in-out property <float> loop-start;
    in-out property <float> loop-end;
    in-out property <bool> snap-to-zero;
    in-out property <bool> reverse-playback;
    in-out property <int> root-note: 60;
    in-out property <float> tune-semitones;
    in-out property <float> tune-cents;
    in-out property <string> tune-label;
    in-out property <bool> retune-live;
    in-out property <float> filter-cutoff;
    in-out property <float> filter-resonance;
    in-out property <float> filter-env;
    in-out property <float> sampler-drive;
    in-out property <float> bit-reduction;
    in-out property <float> rate-reduction;
    // Linear, as the engine stores it; the sampler face's knob does the dB.
    in-out property <float> sampler-output-gain: 1.0;
    in-out property <float> sampler-filter-attack;
    in-out property <float> sampler-filter-decay;
    in-out property <float> sampler-filter-sustain: 1.0;
    in-out property <float> sampler-filter-release;
    in-out property <int> sampler-filter-view;
    in-out property <int>   loop-mode;     // 0=Off 1=Fwd 2=Pong
    // The loop seam's crossfade (MOO-43): normalized, its readout, and the
    // span it covers as fractions of the sample, all published by Rust.
    in-out property <float> sampler-loop-fade;
    in-out property <string> sampler-loop-fade-label;
    in-out property <float> sampler-loop-fade-start;
    in-out property <float> sampler-loop-fade-end;
    in-out property <bool> sampler-loop-fade-shown;
    // The loop grid (MOO-47), and the bounds the loop plays once snapped.
    in-out property <int> sampler-loop-grid;
    in-out property <[string]> sampler-loop-grid-options;
    in-out property <float> sampler-loop-band-start;
    in-out property <float> sampler-loop-band-end: 1;
    in-out property <int> play-mode;        // 0=Pitched 1=Slice
    in-out property <int> slice-base-note: 36;
    in-out property <[float]> slice-markers;
    in-out property <int> slice-count: 8;
    // Transient detection's preview (MOO-44).
    in-out property <bool> slice-preview;
    in-out property <[float]> slice-preview-markers;
    in-out property <bool> sample-committed;
    in-out property <string> commit-label;
    in-out property <bool> commit-stale;
    in-out property <int> voice-mode;       // 0=One Shot 1=Gate
    in-out property <int> sampler-polyphony: 1;
    in-out property <int> retrigger-mode;   // 0=Restart 1=Layer
    in-out property <int> choke-group;
    in-out property <bool> stretch-enabled;
    in-out property <int> stretch-mode;
    in-out property <float> stretch-ratio: 0.3333;
    in-out property <string> stretch-ratio-label;
    in-out property <float> stretch-grain: 0.6667;
    in-out property <string> stretch-grain-label;
    in-out property <bool> stretch-ratio-clean: true;
    in-out property <bool> stretch-sync;
    in-out property <float> stretch-bars: 0.4;
    in-out property <string> stretch-bars-label;
    // Fit-to-tempo's readout (MOO-39), written by Rust.
    in-out property <string> stretch-fit-label;
    in-out property <bool> stretch-fit-warning;
    in-out property <string> stretch-fit-hint;
    in-out property <string> sample-name;
    in-out property <string> sample-description;
    in-out property <float> sample-duration;
    in-out property <int> audio-sample-rate: 48000;
    in-out property <string> selected-channel-name;
    // The selected channel's MIDI input, for the sidebar's IN and CH rows.
    // Both option lists are built in Rust -- `MidiInputSource::picker_rows`
    // and `MidiChannelFilter` own the rows and the index-to-value mapping, so
    // this markup never spells a list it would then have to keep in step.
    in-out property <[string]> midi-input-options;
    in-out property <int> midi-input-index;
    in-out property <bool> midi-input-missing;
    in-out property <string> midi-input-missing-name;
    in-out property <[string]> midi-channel-options;
    in-out property <int> midi-channel-index;
    in-out property <[string]> audio-input-options;
    in-out property <int> audio-input-index;
    in-out property <bool> audio-input-missing;
    in-out property <bool> audio-input-is-hardware;
    in-out property <bool> audio-monitor;
    in-out property <float> audio-input-level-db: -96;
    in-out property <float> audio-input-held-db: -96;
    // The selected sampler's RECORD page; see `sampler-device.slint`.
    in-out property <int> sampler-record-state;
    in-out property <string> sampler-record-elapsed;
    in-out property <[float]> sampler-record-peaks;
    in-out property <float> sampler-record-fill: 1;
    in-out property <string> sampler-record-source;
    in-out property <bool> sampler-record-clip;
    in-out property <int> sampler-record-bars: 1;
    in-out property <int> sampler-record-max-bars;
    // Whether recording is armed. A transport state rather than a document
    // one: opening a song and pressing play must not record.
    in-out property <bool> record-armed;

    // ---- controller mapping ----
    // The toolbar arm. Rust owns it, because it also ends when a binding
    // lands or a project is loaded; `ControlAssign.midi-learn` is the copy
    // every control reads and is set from the same place.
