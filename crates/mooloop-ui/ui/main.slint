import { HorizontalBox, VerticalBox } from "std-widgets.slint";

// Dense dark palette. A global so later widgets inherit the same look.
export global Palette {
    out property <color> bg:        #18181b;
    out property <color> surface:   #232328;
    out property <color> surface-2: #2a2a2e;
    out property <color> edge:      #3f3f46;
    out property <color> text:      #e4e4e7;
    out property <color> text-dim:  #a1a1aa;
    out property <color> text-faint:#52525b;
    out property <color> accent:    #84cc16;
    out property <color> accent-on: #2d6a3e;
    out property <color> warn:      #ef4444;
}

// One step cell used in the step-grid model.
struct StepCell {
    active: bool,
}

// A small flat button with a label.
component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <color> text-color: Palette.text;
    callback clicked;

    min-width: 44px;
    min-height: 24px;
    border-radius: 3px;
    background: active ? Palette.accent-on : Palette.surface-2;

    Text {
        text: root.text;
        color: root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 11px;
    }

    tap := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A horizontal fader with click-and-drag value setting. `value` is normalised
// to [0, 1]; the Rust side maps it to the underlying parameter unit.
component Fader inherits Rectangle {
    in property <string> label;
    in-out property <float> value;      // [0, 1]
    in property <color> fill: Palette.accent;
    in property <color> text-color: Palette.text-dim;
    callback changed(float);

    property <length> track-height: 4px;
    min-height: 22px;
    min-width: 120px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;

        Text {
            text: root.label;
            color: root.text-color;
            font-size: 10px;
            vertical-alignment: center;
            width: 34px;
        }

        track := Rectangle {
            vertical-stretch: 1;
            background: transparent;

            Rectangle {
                y: (parent.height - root.track-height) / 2;
                height: root.track-height;
                width: parent.width;
                background: Palette.edge;
                border-radius: root.track-height / 2;
            }
            Rectangle {
                y: (parent.height - root.track-height) / 2;
                height: root.track-height;
                width: parent.width * clamp(root.value, 0, 1);
                background: root.fill;
                border-radius: root.track-height / 2;
            }

            TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down
                        || (e.kind == PointerEventKind.move && self.pressed)) {
                        root.value = clamp(self.mouse-x / self.width, 0, 1);
                        root.changed(root.value);
                    }
                }
            }
        }
    }
}

// A horizontal LED-style peak meter.
component Meter inherits Rectangle {
    in property <float> level;          // 0..1
    min-width: 64px;
    height: 6px;
    border-radius: 2px;
    background: Palette.edge;

    Rectangle {
        width: parent.width * clamp(root.level, 0, 1);
        height: parent.height;
        border-radius: 2px;
        background: root.level > 0.85 ? Palette.warn : Palette.accent;
    }
}

// A labelled section header used in the bottom strip.
component SectionLabel inherits Text {
    color: Palette.text-faint;
    font-size: 9px;
    height: 12px;
}

export component MainWindow inherits Window {
    title: "mooloop";
    preferred-width: 1280px;
    preferred-height: 760px;
    background: Palette.bg;

    // ---- transport / state exchanged with Rust ----
    in-out property <bool>  playing;
    in-out property <int>   bpm;
    in-out property <int>   beat-in-bar;
    in-out property <float> peak-l;
    in-out property <float> peak-r;

    // ---- step grid ----
    in-out property <[StepCell]> steps;
    callback step-clicked(int);

    // ---- sampler params (normalised 0..1; Rust maps units) ----
    in-out property <float> attack;
    in-out property <float> decay;
    in-out property <float> sustain;
    in-out property <float> release;
    in-out property <float> start-pos;
    in-out property <float> loop-start;
    in-out property <float> loop-end;
    in-out property <int>   loop-mode;     // 0=Off 1=Fwd 2=Pong
    in-out property <string> sample-name;

    callback attack-changed(float);
    callback decay-changed(float);
    callback sustain-changed(float);
    callback release-changed(float);
    callback start-pos-changed(float);
    callback loop-start-changed(float);
    callback loop-end-changed(float);
    callback loop-mode-changed(int);
    callback load-sample-clicked();

    // ---- transport callbacks ----
    callback play-clicked();
    callback stop-clicked();
    callback bpm-changed(int);
    callback toggle-play();

    // Keyboard transport: Space toggles play/pause. Gives an input path
    // independent of mouse clicks (also useful for diagnosing input issues).
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-play();
                accept
            } else {
                reject
            }
        }
    }

    VerticalBox {
        spacing: 0px;

        // ===== Toolbar =====
        Rectangle {
            height: 34px;
            background: Palette.surface;
            HorizontalBox {
                padding: 4px;
                spacing: 4px;
                alignment: start;

                FlatButton {
                    text: "Play";
                    active: root.playing;
                    clicked => { root.play-clicked(); }
                }
                FlatButton {
                    text: "Stop";
                    text-color: root.playing ? Palette.text-dim : Palette.text;
                    clicked => { root.stop-clicked(); }
                }

                Rectangle { width: 6px; }

                Rectangle {
                    width: 104px;
                    height: 24px;
                    background: Palette.surface-2;
                    border-radius: 3px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 0px;
                        alignment: center;
                        Text {
                            text: "-"; color: Palette.text-dim;
                            width: 22px;
                            horizontal-alignment: center; vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    root.bpm = max(1, root.bpm - 1);
                                    root.bpm-changed(root.bpm);
                                }
                            }
                        }
                        Text {
                            text: root.bpm; color: Palette.text;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: 56px;
                        }
                        Text {
                            text: "+"; color: Palette.text-dim;
                            width: 22px;
                            horizontal-alignment: center; vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    root.bpm = min(999, root.bpm + 1);
                                    root.bpm-changed(root.bpm);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 60px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 4px;
                        alignment: center;
                        for i in 4 : Rectangle {
                            width: 10px; height: 10px;
                            border-radius: 5px;
                            background: (root.beat-in-bar == i) ? Palette.accent : Palette.edge;
                        }
                    }
                }

                Meter { level: root.peak-l; }
                Meter { level: root.peak-r; }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        Rectangle { height: 1px; background: Palette.edge; }

        // ===== Channel rack: step grid =====
        VerticalBox {
            vertical-stretch: 1;
            spacing: 0px;
            padding: 8px;

            // One channel row.
            HorizontalBox {
                padding: 2px;
                spacing: 6px;
                alignment: start;

                // Channel label
                Rectangle {
                    width: 80px;
                    Text {
                        text: "Sampler";
                        color: Palette.text-dim;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                // 16 step cells. Every 4th gets a slightly brighter "off"
                // shade so the beats group visually (FL-style).
                HorizontalLayout {
                    spacing: 3px;
                    for cell[i] in root.steps : Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 2px;
                        background: cell.active
                            ? Palette.accent
                            : (mod(i, 4) == 0 ? #33333a : Palette.surface-2);
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.step-clicked(i); }
                        }
                    }
                }
            }

            // Flexible spacer pushes the rack to the top.
            Rectangle { vertical-stretch: 1; }
        }

        Rectangle { height: 1px; background: Palette.edge; }

        // ===== Bottom strip: sampler editor =====
        Rectangle {
            height: 180px;
            background: #131316;
            HorizontalBox {
                padding: 8px;
                spacing: 16px;
                alignment: start;

                // --- Sample section ---
                VerticalLayout {
                    spacing: 6px;
                    SectionLabel { text: "SAMPLE"; }
                    FlatButton {
                        text: "Load Sample...";
                        clicked => { root.load-sample-clicked(); }
                    }
                    Text {
                        text: root.sample-name;
                        color: Palette.text-dim;
                        font-size: 10px;
                        wrap: word-wrap;
                        max-width: 150px;
                    }
                }

                // --- Envelope section ---
                VerticalLayout {
                    spacing: 4px;
                    SectionLabel { text: "ENVELOPE"; }
                    Fader {
                        label: "A";
                        value <=> root.attack;
                        changed(v) => { root.attack-changed(v); }
                    }
                    Fader {
                        label: "D";
                        value <=> root.decay;
                        changed(v) => { root.decay-changed(v); }
                    }
                    Fader {
                        label: "S";
                        value <=> root.sustain;
                        changed(v) => { root.sustain-changed(v); }
                    }
                    Fader {
                        label: "R";
                        value <=> root.release;
                        changed(v) => { root.release-changed(v); }
                    }
                }

                // --- Start / loop section ---
                VerticalLayout {
                    spacing: 4px;
                    SectionLabel { text: "START / LOOP"; }
                    Fader {
                        label: "St";
                        value <=> root.start-pos;
                        changed(v) => { root.start-pos-changed(v); }
                    }
                    Fader {
                        label: "LS";
                        value <=> root.loop-start;
                        changed(v) => { root.loop-start-changed(v); }
                    }
                    Fader {
                        label: "LE";
                        value <=> root.loop-end;
                        changed(v) => { root.loop-end-changed(v); }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        FlatButton {
                            text: "Off";
                            active: root.loop-mode == 0;
                            clicked => { root.loop-mode-changed(0); }
                        }
                        FlatButton {
                            text: "Fwd";
                            active: root.loop-mode == 1;
                            clicked => { root.loop-mode-changed(1); }
                        }
                        FlatButton {
                            text: "Pong";
                            active: root.loop-mode == 2;
                            clicked => { root.loop-mode-changed(2); }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
