                                                        // leaf branch p2 and p3 are its own knobs.
                                                        muted: branch.controls && root.effect-slots[branch.slot].p2 >= 0.5;
                                                        soloed: branch.controls && root.effect-slots[branch.slot].p3 >= 0.5;
