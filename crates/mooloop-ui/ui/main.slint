import { HorizontalBox, VerticalBox } from "std-widgets.slint";

// Dense dark palette. A global so later widgets inherit the same look.
export global Palette {
    out property <color> bg:        #18181b;
    out property <color> surface:   #232328;
    out property <color> surface-2: #2a2a2e;
    out property <color> surface-3: #33333a;
    out property <color> edge:      #3f3f46;
    out property <color> text:      #e4e4e7;
    out property <color> text-dim:  #a1a1aa;
    out property <color> text-faint:#52525b;
    out property <color> accent:    #84cc16;
    out property <color> accent-on: #2d6a3e;
    out property <color> warn:      #ef4444;
    out property <color> mute-on:   #7f1d1d;
}

// One step cell used in the step-grid models.
struct StepCell {
    active: bool,
}

// One channel row in the rack.
struct ChannelRow {
    name: string,
    muted: bool,
    selected: bool,
    steps: [StepCell],
}

// A small flat button with a label.
component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <color> text-color: Palette.text;
    callback clicked;

    min-width: 44px;
    min-height: 24px;
    border-radius: 3px;
    background: active ? Palette.accent-on : Palette.surface-2;

    Text {
        text: root.text;
        color: root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 11px;
    }

    tap := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A horizontal fader with click-and-drag value setting. `value` is normalised
// to [0, 1]; the Rust side maps it to the underlying parameter unit.
component Fader inherits Rectangle {
    in property <string> label;
    in-out property <float> value;      // [0, 1]
    in property <color> fill: Palette.accent;
    in property <color> text-color: Palette.text-dim;
    callback changed(float);

    property <length> track-height: 4px;
    min-height: 22px;
    min-width: 120px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;

        Text {
            text: root.label;
            color: root.text-color;
            font-size: 10px;
            vertical-alignment: center;
            width: 34px;
        }

        track := Rectangle {
            vertical-stretch: 1;
            background: transparent;

            Rectangle {
                y: (parent.height - root.track-height) / 2;
                height: root.track-height;
                width: parent.width;
                background: Palette.edge;
                border-radius: root.track-height / 2;
            }
            Rectangle {
                y: (parent.height - root.track-height) / 2;
                height: root.track-height;
                width: parent.width * clamp(root.value, 0, 1);
                background: root.fill;
                border-radius: root.track-height / 2;
            }

            TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down
                        || (e.kind == PointerEventKind.move && self.pressed)) {
                        root.value = clamp(self.mouse-x / self.width, 0, 1);
                        root.changed(root.value);
                    }
                }
            }
        }
    }
}

// A horizontal LED-style peak meter.
component Meter inherits Rectangle {
    in property <float> level;          // 0..1
    min-width: 64px;
    height: 6px;
    border-radius: 2px;
    background: Palette.edge;

    Rectangle {
        width: parent.width * clamp(root.level, 0, 1);
        height: parent.height;
        border-radius: 2px;
        background: root.level > 0.85 ? Palette.warn : Palette.accent;
    }
}

// A labelled section header used in the bottom strip.
component SectionLabel inherits Text {
    color: Palette.text-faint;
    font-size: 9px;
    height: 12px;
}

// A tiny square mute LED button.
component MuteButton inherits Rectangle {
    in property <bool> muted;
    callback clicked;

    width: 18px;
    height: 18px;
    border-radius: 3px;
    background: muted ? Palette.mute-on : Palette.surface-2;

    Text {
        text: "M";
        color: root.muted ? #fecaca : Palette.text-faint;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    tap := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "mooloop";
    preferred-width: 1280px;
    preferred-height: 760px;
    background: Palette.bg;

    // ---- transport / state exchanged with Rust ----
    in-out property <bool>  playing;
    in-out property <int>   bpm;
    in-out property <int>   beat-in-bar;
    in-out property <float> peak-l;
    in-out property <float> peak-r;

    // ---- channels / patterns ----
    in-out property <[ChannelRow]> channels;
    in-out property <int> current-pattern;
    in-out property <int> selected-channel;

    callback step-clicked(int, int);       // channel, step
    callback channel-selected(int);
    callback channel-muted(int);
    callback add-channel-clicked();
    callback remove-channel-clicked();
    callback pattern-selected(int);

    // ---- sampler params of the selected channel (normalised 0..1) ----
    in-out property <float> attack;
    in-out property <float> decay;
    in-out property <float> sustain;
    in-out property <float> release;
    in-out property <float> start-pos;
    in-out property <float> loop-start;
    in-out property <float> loop-end;
    in-out property <int>   loop-mode;     // 0=Off 1=Fwd 2=Pong
    in-out property <string> sample-name;
    in-out property <string> selected-channel-name;

    callback attack-changed(float);
    callback decay-changed(float);
    callback sustain-changed(float);
    callback release-changed(float);
    callback start-pos-changed(float);
    callback loop-start-changed(float);
    callback loop-end-changed(float);
    callback loop-mode-changed(int);
    callback load-sample-clicked();

    // ---- transport callbacks ----
    callback play-clicked();
    callback stop-clicked();
    callback bpm-changed(int);
    callback toggle-play();

    // Keyboard transport: Space toggles play/pause. Gives an input path
    // independent of mouse clicks (also useful for diagnosing input issues).
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-play();
                accept
            } else {
                reject
            }
        }
    }

    VerticalBox {
        spacing: 0px;

        // ===== Toolbar =====
        Rectangle {
            height: 34px;
            background: Palette.surface;
            HorizontalBox {
                padding: 4px;
                spacing: 4px;
                alignment: start;

                FlatButton {
                    text: "Play";
                    active: root.playing;
                    clicked => { root.play-clicked(); }
                }
                FlatButton {
                    text: "Stop";
                    text-color: root.playing ? Palette.text-dim : Palette.text;
                    clicked => { root.stop-clicked(); }
                }

                Rectangle { width: 6px; }

                // Pattern selector: buttons 1..8
                HorizontalBox {
                    padding: 0px;
                    spacing: 2px;
                    for p in 8 : FlatButton {
                        text: p + 1;
                        active: root.current-pattern == p;
                        min-width: 26px;
                        clicked => { root.pattern-selected(p); }
                    }
                }

                Rectangle { width: 6px; }

                Rectangle {
                    width: 104px;
                    height: 24px;
                    background: Palette.surface-2;
                    border-radius: 3px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 0px;
                        alignment: center;
                        Text {
                            text: "-"; color: Palette.text-dim;
                            width: 22px;
                            horizontal-alignment: center; vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    root.bpm = max(1, root.bpm - 1);
                                    root.bpm-changed(root.bpm);
                                }
                            }
                        }
                        Text {
                            text: root.bpm; color: Palette.text;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: 56px;
                        }
                        Text {
                            text: "+"; color: Palette.text-dim;
                            width: 22px;
                            horizontal-alignment: center; vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    root.bpm = min(999, root.bpm + 1);
                                    root.bpm-changed(root.bpm);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 60px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 4px;
                        alignment: center;
                        for i in 4 : Rectangle {
                            width: 10px; height: 10px;
                            border-radius: 5px;
                            background: (root.beat-in-bar == i) ? Palette.accent : Palette.edge;
                        }
                    }
                }

                Meter { level: root.peak-l; }
                Meter { level: root.peak-r; }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        Rectangle { height: 1px; background: Palette.edge; }

        // ===== Channel rack: one step-grid row per channel =====
        VerticalBox {
            vertical-stretch: 1;
            spacing: 2px;
            padding: 8px;

            for row[ch] in root.channels : HorizontalBox {
                padding: 2px;
                spacing: 6px;
                alignment: start;

                // Channel name (selects the channel for the bottom editor)
                Rectangle {
                    width: 88px;
                    min-height: 24px;
                    border-radius: 3px;
                    background: row.selected ? Palette.surface-3 : Palette.surface;
                    Text {
                        text: row.name;
                        color: row.selected ? Palette.text : Palette.text-dim;
                        font-size: 11px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        x: 6px;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.channel-selected(ch); }
                    }
                }

                MuteButton {
                    muted: row.muted;
                    clicked => { root.channel-muted(ch); }
                }

                // 16 step cells. Every 4th gets a slightly brighter "off"
                // shade so the beats group visually (FL-style).
                HorizontalLayout {
                    spacing: 3px;
                    for cell[i] in row.steps : Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 2px;
                        background: cell.active
                            ? Palette.accent
                            : (mod(i, 4) == 0 ? Palette.surface-3 : Palette.surface-2);
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.step-clicked(ch, i); }
                        }
                    }
                }
            }

            // Add / remove channel row.
            HorizontalBox {
                padding: 0px;
                spacing: 4px;
                alignment: start;
                FlatButton {
                    text: "+ Channel";
                    clicked => { root.add-channel-clicked(); }
                }
                FlatButton {
                    text: "- Channel";
                    clicked => { root.remove-channel-clicked(); }
                }
            }

            // Flexible spacer pushes the rack to the top.
            Rectangle { vertical-stretch: 1; }
        }

        Rectangle { height: 1px; background: Palette.edge; }

        // ===== Bottom strip: sampler editor for the selected channel =====
        Rectangle {
            height: 180px;
            background: #131316;
            HorizontalBox {
                padding: 8px;
                spacing: 16px;
                alignment: start;

                // --- Sample section ---
                VerticalLayout {
                    spacing: 6px;
                    SectionLabel { text: "SAMPLE"; }
                    Text {
                        text: root.selected-channel-name;
                        color: Palette.text;
                        font-size: 11px;
                        height: 14px;
                    }
                    FlatButton {
                        text: "Load Sample...";
                        clicked => { root.load-sample-clicked(); }
                    }
                    Text {
                        text: root.sample-name;
                        color: Palette.text-dim;
                        font-size: 10px;
                        wrap: word-wrap;
                        max-width: 150px;
                    }
                }

                // --- Envelope section ---
                VerticalLayout {
                    spacing: 4px;
                    SectionLabel { text: "ENVELOPE"; }
                    Fader {
                        label: "A";
                        value <=> root.attack;
                        changed(v) => { root.attack-changed(v); }
                    }
                    Fader {
                        label: "D";
                        value <=> root.decay;
                        changed(v) => { root.decay-changed(v); }
                    }
                    Fader {
                        label: "S";
                        value <=> root.sustain;
                        changed(v) => { root.sustain-changed(v); }
                    }
                    Fader {
                        label: "R";
                        value <=> root.release;
                        changed(v) => { root.release-changed(v); }
                    }
                }

                // --- Start / loop section ---
                VerticalLayout {
                    spacing: 4px;
                    SectionLabel { text: "START / LOOP"; }
                    Fader {
                        label: "St";
                        value <=> root.start-pos;
                        changed(v) => { root.start-pos-changed(v); }
                    }
                    Fader {
                        label: "LS";
                        value <=> root.loop-start;
                        changed(v) => { root.loop-start-changed(v); }
                    }
                    Fader {
                        label: "LE";
                        value <=> root.loop-end;
                        changed(v) => { root.loop-end-changed(v); }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        FlatButton {
                            text: "Off";
                            active: root.loop-mode == 0;
                            clicked => { root.loop-mode-changed(0); }
                        }
                        FlatButton {
                            text: "Fwd";
                            active: root.loop-mode == 1;
                            clicked => { root.loop-mode-changed(1); }
                        }
                        FlatButton {
                            text: "Pong";
                            active: root.loop-mode == 2;
                            clicked => { root.loop-mode-changed(2); }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
