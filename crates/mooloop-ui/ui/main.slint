                                                                root.effect-slots[branch.slot].p3 >= 0.5 ? 0.0 : 1.0);
                                                        }
                                                    }
                                                }
                                                if slot.is-container && !slot.is-layer : ContainerDeviceFace {
                                                    x: DeviceRackMetrics.rail-width;
                                                    y: 0px;
                                                    width: parent.content-width;
                                                    height: parent.height;
                                                    name: slot.label;
                                                    slot-index: index;
                                                    slot-count: root.effect-slots.length;
                                                    bypassed: slot.bypassed;
                                                    preset-name: slot.preset-name;
                                                    children: slot.children;
                                                    mix: slot.p0;
                                                    level: slot.p1;
                                                    mix-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                    level-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                    reorder-requested(target) => { root.reorder-effect(index, target); }
                                                    select-requested => { root.device-selected(index); }
                                                }
                                            }
                                            // The output rail of each box ending here, past
                                            // everything that box holds. Wired to the
                                            // container's own row rather than this one: it is
                                            // that device's control, standing at the far end
                                            // of its own run.
                                            for container[tail] in slot.closing : DeviceOutputRail {
                                                x: cell.shift + cell.frame-width + cell.inner-width
                                                    + tail * DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                height: DeviceRackMetrics.face-height;
                                                container-chrome: true;
                                                removal-enabled: true;
                                                unwrap-enabled: true;
                                                is-container: true;
                                                container-children: root.effect-slots[container].children;
                                                output-trim-enabled: true;
                                                output-trim: root.effect-slots[container].output-trim-db;
                                                output-left-db: root.effect-slots[container].output-left-db;
                                                output-right-db: root.effect-slots[container].output-right-db;
                                                remove-requested => { root.remove-effect-clicked(container); }
                                                unwrap-requested => { root.unwrap-effect-clicked(container); }
                                                output-trim-changed(v) => {
                                                    root.effect-output-trim-changed(container, v);
                                                }
                                            }
                                            // An empty box's own join, inside it: the one
                                            // place a device can be added *into* a container
                                            // that holds nothing. Its own callback rather
                                            // than an index, because the position just
                                            // after an empty container is also the position
                                            // just after it, and no index can mean both.
                                            if cell.inner-join : DeviceJoin {
                                                x: cell.shift + cell.frame-width;
                                                y: 0px;
                                                kind-selected(kind) => { root.add-effect-into-container(kind, index); }
                                            }
                                            // The join leading out of this row, and past any
                                            // box that ends here: a device added from it lands
                                            // before the next drawn row, at that row's depth.
                                            DeviceJoin {
                                                x: cell.shift + cell.frame-width + cell.inner-width + cell.tail-width;
                                                y: 0px;
                                                enabled: slot.join-before >= 0;
                                                drop-before: slot.join-before;
                                                kind-selected(kind) => { root.add-effect-clicked(kind, slot.join-before); }
                                            }
                                        }

                                        // **The output stage, last.** The rack
                                        // now reads in the order the engine
                                        // runs: the strip at the head, the
                                        // track's own devices as inserts, the
                                        // fader at the end. It was drawn first
                                        // until 2026-09-13 because this face
                                        // sits in the seat a channel's
                                        // generator has -- the start of a
                                        // channel's path, and the wrong end of
                                        // a track's.
                                        // **The master bus compressor**, where the
                                        // engine runs it: after the master's own
                                        // devices, before its fader. The master's
                                        // section rather than an insert, so it has
                                        // no rails and cannot be moved (MOO-13).
                                        if root.editing-bus && root.editing-bus-is-master : MasterCompFace {
                                            section: MasterSection.row;
                                            reduction-db: MasterSection.reduction-db;
                                            held-reduction-db: MasterSection.held-reduction-db;
                                            muted: root.editing-bus-muted;
                                            moved(id, v) => { root.bus-strip-param(root.editing-bus-index, id, v); }
                                        }
                                        if root.editing-bus : BusFaderRow {
                                            name: root.editing-bus-name;
                                            is-master: root.editing-bus-is-master;
                                            lookahead-ms: MasterSection.row.lookahead-ms;
                                            lookahead-changed(v) => {
                                                root.bus-strip-param(root.editing-bus-index, MasterSpec.lookahead-ms, v);
                                            }
                                            volume: root.editing-bus-volume;
                                            pan: root.editing-bus-pan;
                                            muted: root.editing-bus-muted;
                                            solo: root.editing-bus-solo;
                                            left-db: root.editing-bus-left-db;
                                            right-db: root.editing-bus-right-db;
                                            held-left-db: root.editing-bus-held-left-db;
                                            held-right-db: root.editing-bus-held-right-db;
                                            clipping: root.editing-bus-clipping;
                                            // The same callback the mixer strip's lamp
                                            // uses: one latch per track, cleared from
                                            // whichever face the user happens to click.
                                            clip-reset => { root.bus-clip-reset(root.editing-bus-index); }
                                            volume-changed(v) => { root.bus-volume-changed(root.editing-bus-index, v); }
                                            pan-changed(v) => { root.bus-pan-changed(root.editing-bus-index, v); }
                                            mute-toggled => { root.bus-muted(root.editing-bus-index); }
                                            solo-toggled => { root.bus-solo-toggled(root.editing-bus-index); }
                                        }

                                        // The other position the pin can take:
                                        // after the track's own devices, standing
                                        // alone rather than bundled into
                                        // `BusDeviceFace` -- the head keeps its
                                        // identity content either way, so a
                                        // moved pin only moves the processing.
                                        if root.editing-bus && !root.strip-pin-head : StripRackRow {
                                            strip: root.editing-bus-strip;
                                            track: root.editing-bus-index;
                                            name: root.editing-bus-name;
                                            muted: root.editing-bus-muted;
                                            moved(id, v) => { root.bus-strip-param(root.editing-bus-index, id, v); }
                                            switched(id, on) => { root.bus-strip-param(root.editing-bus-index, id, on ? 1 : 0); }
                                            voicing-picked(voicing) => { root.bus-voicing-picked(root.editing-bus-index, voicing); }
                                            point-dragged(band, hz, gain) => {
                                                root.bus-strip-point-dragged(root.editing-bus-index, band, hz, gain);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                            // The shelf is pinned to the bottom of the dock rather than
                            // scrolling with the rack. It is one surface for the whole
                            // channel, but inside the scroll content it inherited the
                            // chain's width, so past a few devices its module grid and
                            // Assign button sat screens to the right of the window. Out
                            // here it is never wider than the frame, and the chain's
                            // horizontal scrollbar sits above it rather than below.
                            if !root.editing-bus : HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                ModulationShelf {
                                    open: root.modulation-shelf-open;
                                    sources: root.modulation-sources;
                                    outlets: root.modulation-outlets;
                                    routes: root.modulation-routes;
                                    selected-slot: root.modulation-selected-slot;
                                    armed-slot: root.modulation-armed-slot;
                                    selected-kind: root.modulation-selected-kind;
                                    selected-values: root.modulation-selected-values;
                                    selected-preview-fade-cycles: root.modulation-selected-preview-fade-cycles;
                                    selected-preview-smoothing-cycles: root.modulation-selected-preview-smoothing-cycles;
                                    input-channels: root.modulation-input-channels;
                                    selected-envelope-input-channel: root.modulation-selected-envelope-input-channel;
                                    selected-envelope-preview-attack: root.modulation-selected-envelope-preview-attack;
                                    selected-envelope-preview-decay: root.modulation-selected-envelope-preview-decay;
                                    selected-envelope-preview-release: root.modulation-selected-envelope-preview-release;
                                    max-sources: root.modulation-max-sources;
                                    slot-names: root.modulation-slot-names;
                                    outlet-device: root.modulation-outlet-device;
                                    armed-name: root.modulation-armed-name;
                                    selected-outlet-name: root.modulation-selected-outlet-name;
                                    selected-outlet-signal: root.modulation-selected-outlet-signal;
                                    toggled => { root.modulation-shelf-toggled(); }
                                    source-selected(slot) => { root.modulation-source-selected(slot); }
                                    source-moved(slot, target) => { root.modulation-source-moved(slot, target); }
                                    assignment-toggled => { root.modulation-assignment-toggled(); }
                                    source-added(kind) => { root.modulation-source-added(kind); }
                                    param-changed(slot, id, value) => { root.modulation-param-changed(slot, id, value); }
                                    param-edit-started => { root.modulation-param-edit-started(); }
                                    param-edit-finished => { root.modulation-param-edit-finished(); }
                                    source-removed(slot) => { root.modulation-source-removed(slot); }
                                    envelope-input-channel-changed(slot, value) => { root.modulation-envelope-input-channel-changed(slot, value); }
                                    route-polarity-changed(index, polarity) => {
                                        root.modulation-route-polarity-changed(index, polarity);
                                    }
                                    route-removed(index) => {
                                        root.modulation-route-removed(index);
                                    }
                                }
                            }
                        }
                    }

                    // ===== NOTES =====
                    // The piano roll.
                    ViewSlot {
                        rect: work.slot-rect(root.notes-slot);
                        shown: root.view-showing(PaneViews.notes, root.notes-slot);
                        VerticalLayout {
                            spacing: 0px;
                            PaneToolbar {
                                PaneTabs {
                                    view-slots: root.view-slots;
                                    slot: root.notes-slot;
                                    can-leave: root.notes-slot != 0
                                        || root.main-view-count() > 1;
                                    active: root.slot-active(root.notes-slot);
                                    zoomed: root.zoomed == root.notes-slot;
                                    picked(v) => { root.view-picked(v); }
                                    zoom-toggled() => { root.toggle-zoom(root.notes-slot); }
                                    drag-started(v) => { root.view-drag-started(v); }
                                    drag-dropped(v) => { root.view-drag-dropped(v); }
                                    move-requested(v, s) => { root.move-view(v, s); }
                                }
                                ToolbarRule {}
                                SegmentedControl {
                                    controlled: false;
                                    options: ["SEL", "DRAW", "PAINT", "SLICE", "ERASE"];
                                    selected-index <=> root.piano-tool;
                                    width: 232px;
                                    height: 24px;
                                }
                                ToggleButton {
                                    text: "SNAP";
                                    checked: root.piano-snap-enabled;
                                    width: 50px;
                                    height: 24px;
                                    toggled => { root.piano-snap-enabled = !root.piano-snap-enabled; }
                                    hint: "Quantise edits to the grid. Hold the snap-override modifier to invert this for one drag.";
                                }
                                MenuField {
                                    options: root.musical-snap-options;
                                    selected-index: root.piano-snap-index;
                                    enabled: root.piano-snap-enabled;
                                    field-width: 62px;
                                    menu-width: 120px;
                                    tooltip: "Snap";
                                    hint: "Grid note edits quantise to";
                                    selected(i) => { root.piano-snap-index = i; }
                                }
                                Rectangle { width: 8px; }
                                Text {
                                    text: root.has-selected-note ? "TICK " + root.selected-note-step : "NO NOTE";
                                    color: Theme.text-muted;
                                    font-size: Theme.text-md;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "NOTE";
                                    color: Theme.text-faint;
                                    font-size: Theme.text-md;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-note;
                                    minimum: root.piano-low-note;
                                    maximum: root.piano-high-note;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-note-changed(value); }
                                    Tooltip { text: @markdown("Selected step MIDI note"); }
                                }
                                Text {
                                    text: "VEL";
                                    color: Theme.text-faint;
                                    font-size: Theme.text-md;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-velocity;
                                    minimum: 1;
                                    maximum: 127;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-velocity-changed(value); }
                                    Tooltip { text: @markdown("Selected step velocity"); }
                                }
                                Text {
                                    text: "LEN";
                                    color: Theme.text-faint;
                                    font-size: Theme.text-md;
                                    vertical-alignment: center;
                                }
                                // Musical divisions rather than raw
                                // ticks: a length is a note value,
                                // and PPQ ticks made every ordinary
                                // edit an arithmetic problem. Applies
                                // to the whole selection.
                                ComboBox {
                                    enabled: root.has-note-selection;
                                    model: root.musical-snap-options;
                                    current-index: root.selected-duration-index;
                                    width: 84px;
                                    height: 24px;
                                    selected(value) => {
                                        root.selected-duration-picked(self.current-index);
                                    }
                                }
                                // The exact value, for lengths that
                                // are not a listed division -- an
                                // unsnapped drag can land anywhere,
                                // and the picker alone would hide it.
                                Text {
                                    text: root.selected-duration-text;
                                    color: Theme.text-muted;
                                    font-size: Theme.text-md;
                                    width: 56px;
                                    vertical-alignment: center;
                                }
                                Rectangle { width: 8px; }
                                ToggleButton {
                                    text: "VEL";
                                    checked: root.velocity-lane-visible;
                                    width: 46px;
                                    height: 24px;
                                    toggled => { root.velocity-lane-visible = !root.velocity-lane-visible; }
                                    Tooltip { text: @markdown("Velocity lane"); }
                                }
                                ToggleButton {
                                    text: "AUTO";
                                    checked: root.automation-lane-visible;
                                    width: 52px;
                                    height: 24px;
                                    toggled => { root.automation-lane-visible = !root.automation-lane-visible; }
                                    Tooltip { text: @markdown("Automation lane"); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                // Which channel these notes belong to. The two views that edit a
                                // channel say so; the playlist and the mixer do not, because they
                                // do not.
                                Text {
                                    text: root.editing-bus ? root.editing-bus-name : root.selected-channel-name;
                                    color: Theme.text-muted;
                                    font-size: Theme.text-lg;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                vertical-stretch: 1;

                                Rectangle {
                                    width: 46px;
                                    background: Theme.panel;
                                    VerticalLayout {
                                        spacing: 0px;
                                        Rectangle {
                                            vertical-stretch: 1;
                                            clip: true;
                                            Rectangle {
                                                y: piano-scroll.viewport-y;
                                                width: parent.width;
                                                height: root.piano-note-count * root.piano-row-height;
                                                for key in root.piano-note-count : Rectangle {
                                                    y: key * root.piano-row-height;
                                                    height: root.piano-row-height;
                                                    width: parent.width;
                                                    property <int> note-number: root.piano-high-note - key;
                                                    background: (mod(note-number, 12) == 1
                                                        || mod(note-number, 12) == 3
                                                        || mod(note-number, 12) == 6
                                                        || mod(note-number, 12) == 8
                                                        || mod(note-number, 12) == 10)
                                                        ? Theme.panel : Theme.surface;
                                                    if mod(note-number, 12) == 0 : Text {
                                                        // Through the shared namer, which already
                                                        // knows that middle C is C4 -- the same
                                                        // convention `note_to_freq` puts A4 at MIDI
                                                        // 69. Spelled out here, the octave was that
                                                        // convention written a second time, and the
                                                        // copy that would not move if it ever did.
                                                        text: NoteFormat.midi-name(note-number);
                                                        color: Theme.text-muted;
                                                        font-size: min(Theme.text-md, root.piano-row-height - 1px);
                                                        vertical-alignment: center;
                                                        x: 3px;
                                                    }
                                                }
                                            }
                                        }
                                        // Matches the time scrollbar below the grid
                                        // so the keyboard's parameter labels stay
                                        // aligned with the lanes on the right. Each
                                        // label spans its lane's header and body
                                        // together, so the two columns cannot drift
                                        // as lanes are toggled.
                                        Rectangle { height: 14px; background: Theme.panel; }
                                        if root.velocity-lane-visible : Rectangle {
                                            height: 72px;
                                            background: Theme.panel;
                                            Text {
                                                text: "VEL";
                                                color: Theme.text-muted;
                                                font-size: Theme.text-sm;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        if root.automation-lane-visible : Rectangle {
                                            height: 89px;
                                            background: Theme.panel;
                                            Text {
                                                text: "AUTO";
                                                color: Theme.text-muted;
                                                font-size: Theme.text-sm;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 0px;
                                    HorizontalLayout {
                                        spacing: 2px;
                                        piano-scroll := ScrollView {
                                            // The zoom scrollbars own panning and
                                            // zooming for both axes; the built-in
                                            // bars would only duplicate them.
                                            horizontal-scrollbar-policy: always-off;
                                            vertical-scrollbar-policy: always-off;
                                            vertical-stretch: 1;
                                            horizontal-stretch: 1;
                                        viewport-width: max(self.visible-width,
                                            root.pattern-length * root.piano-step-width);
                                        viewport-height: max(self.visible-height,
                                            root.piano-note-count * root.piano-row-height);
                                        // Start around the working register (C6 at
                                        // the top) even though the canvas spans the
                                        // full MIDI range. Subsequent pan/zoom
                                        // interactions take ownership of this value.
                                        viewport-y: -(root.piano-high-note - 84) * root.piano-row-height;
                                        PianoGrid {
                                            pattern-length: root.pattern-length;
                                            notes: root.notes;
                                            gestures: root.piano-gestures;
                                            selection-count: root.selection-count;
                                            selection-start-tick: root.selection-start-tick;
                                            selection-end-tick: root.selection-end-tick;
                                            selection-low-note: root.selection-low-note;
                                            selection-high-note: root.selection-high-note;
                                            low-note: root.piano-low-note;
                                            high-note: root.piano-high-note;
                                            note-count: root.piano-note-count;
                                            snap-ticks: root.piano-snap-ticks;
                                            snap-enabled: root.piano-snap-enabled;
                                            tool: root.piano-tool;
                                            step-width <=> root.piano-step-width;
                                            row-height <=> root.piano-row-height;
                                            content-w: root.piano-content-w;
                                            content-h: root.piano-content-h;
                                            scroll-x: piano-scroll.viewport-x;
                                            scroll-y: piano-scroll.viewport-y;
                                            visible-w: piano-scroll.visible-width;
                                            visible-h: piano-scroll.visible-height;
                                            hover-hint <=> root.hover-hint;
                                            note-hit-test(tick, note) => { return root.piano-note-hit-test(tick, note); }
                                            focus-requested => { keys.focus(); }
                                            gesture-begin() => { root.piano-gesture-begin(); }
                                            gesture-end() => { root.piano-gesture-end(); }
                                            note-created(start, note, duration) => {
                                                return root.piano-note-created(start, note, duration);
                                            }
                                            note-selected(id, mode) => { root.piano-note-selected(id, mode); }
                                            note-moved(id, start, note) => { root.piano-note-moved(id, start, note); }
                                            selection-duplicated(id) => { return root.piano-selection-duplicated(id); }
                                            note-resized(id, duration) => { root.piano-note-resized(id, duration); }
                                            note-start-resized(id, start) => {
                                                root.piano-note-start-resized(id, start);
                                            }
                                            note-removed(id) => { root.piano-note-removed(id); }
                                            scale-begin(from-left) => { root.piano-scale-begin(from-left); }
                                            selection-scaled(factor) => { root.piano-selection-scaled(factor); }
                                            marquee-begin(mode) => { root.piano-marquee-begin(mode); }
                                            marquee-updated(a, b, lo, hi) => {
                                                root.piano-marquee-updated(a, b, lo, hi);
                                            }
                                            note-sliced(id, tick) => { root.piano-note-sliced(id, tick); }
                                            selection-joined => { root.piano-selection-joined(); }
                                            cell-painted(start, note, duration) => {
                                                root.piano-cell-painted(start, note, duration);
                                            }
                                            // Assigning over `viewport-y`'s initial binding is deliberate and
                                            // is what the inline handler did before: the first pan or zoom
                                            // takes ownership of the scroll position from the default
                                            // register the roll opens on.
                                            pan(x, y) => {
                                                piano-scroll.viewport-x = x;
                                                piano-scroll.viewport-y = y;
                                            }
                                        }
                                        }

                                        // Pitch axis: same idiom vertically. The
                                        // keyboard column follows viewport-y, so
                                        // keys stay in sync while dragging.
                                        ZoomScrollBar {
                                            vertical: true;
                                            width: 12px;
                                            offset: clamp(-piano-scroll.viewport-y
                                                / max(1px, root.piano-content-h - piano-scroll.visible-height), 0, 1);
                                            visible-fraction: clamp(
                                                piano-scroll.visible-height / max(1px, root.piano-content-h), 0, 1);
                                            scrolled(v) => {
                                                piano-scroll.viewport-y = -v * max(0px,
                                                    root.piano-content-h - piano-scroll.visible-height);
                                            }
                                            zoomed(o, f) => {
                                                root.piano-row-height = clamp(
                                                    piano-scroll.visible-height / max(1, root.piano-note-count * f),
                                                    5px, 16px);
                                                piano-scroll.viewport-y = -o * max(0px,
                                                    root.piano-content-h - piano-scroll.visible-height);
                                            }
                                            changed hovered => {
                                                root.hover-hint = self.hovered
                                                    ? "Drag to scroll pitch. Drag an end grip to zoom."
                                                    : root.hover-hint == "Drag to scroll pitch. Drag an end grip to zoom."
                                                        ? "" : root.hover-hint;
                                            }
                                        }
                                    }

                                    // The bottom edge is the time scrollbar: drag
                                    // its body to pan and either marked end to zoom.
                                    HorizontalLayout {
                                        height: 14px;
                                        spacing: 2px;
                                        ZoomScrollBar {
                                            height: 14px;
                                            horizontal-stretch: 1;
                                            offset: clamp(-piano-scroll.viewport-x
                                                / max(1px, root.piano-content-w - piano-scroll.visible-width), 0, 1);
                                            visible-fraction: clamp(
                                                piano-scroll.visible-width / max(1px, root.piano-content-w), 0, 1);
                                            scrolled(v) => {
                                                piano-scroll.viewport-x = -v * max(0px,
                                                    root.piano-content-w - piano-scroll.visible-width);
                                            }
                                            zoomed(o, f) => {
                                                root.piano-step-width = clamp(
                                                    piano-scroll.visible-width / max(1, root.pattern-length * f),
                                                    20px, 72px);
                                                piano-scroll.viewport-x = -o * max(0px,
                                                    root.piano-content-w - piano-scroll.visible-width);
                                            }
                                            changed hovered => {
                                                root.hover-hint = self.hovered
                                                    ? "Drag to scroll time. Drag an end grip to zoom."
                                                    : root.hover-hint == "Drag to scroll time. Drag an end grip to zoom."
                                                        ? "" : root.hover-hint;
                                            }
                                        }
                                        Rectangle { width: 12px; }
                                    }

                                    if root.velocity-lane-visible : Rectangle {
                                        height: 17px;
                                        background: Theme.panel;
                                        Text {
                                            text: "Velocity";
                                            color: Theme.text-faint;
                                            font-size: Theme.text-sm;
                                            x: 4px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if root.velocity-lane-visible : Rectangle {
                                        height: 55px;
                                        background: Theme.surface;
                                        clip: true;
                                        Rectangle {
                                            x: -piano-scroll.viewport-x;
                                            width: root.pattern-length * root.piano-step-width;
                                            height: parent.height;
                                            background: transparent;
                                            // A stem with a drag head rather than a
                                            // filled box: a box's width encodes note
                                            // length, which reads as though velocity
                                            // had a duration, and long notes then
                                            // hide short ones underneath them.
                                            for cell in root.notes : Rectangle {
                                                property <length> head-size: 7px;
                                                property <length> level:
                                                    (parent.height - self.head-size)
                                                    * (127 - cell.velocity) / 127;
                                                x: cell.start-tick * root.piano-step-width / RollMetrics.ticks-per-step;
                                                width: max(root.piano-step-width / 4, 9px);
                                                height: parent.height;
                                                background: transparent;
                                                Rectangle {
                                                    x: (parent.width - 2px) / 2;
                                                    y: parent.level + parent.head-size / 2;
                                                    width: 2px;
                                                    height: parent.height - self.y;
                                                    background: cell.selected ? Theme.focus : Theme.accent;
                                                    opacity: cell.selected ? 1.0 : 0.7;
                                                }
                                                Rectangle {
                                                    x: (parent.width - parent.head-size) / 2;
                                                    y: parent.level;
                                                    width: parent.head-size;
                                                    height: parent.head-size;
                                                    border-radius: parent.head-size / 2;
                                                    background: cell.selected ? Theme.focus : Theme.accent;
                                                    border-width: Theme.hairline;
                                                    border-color: velocity-touch.has-hover
                                                        ? Theme.text : transparent;
                                                }
                                                velocity-touch := TouchArea {
                                                    mouse-cursor: ns-resize;
                                                    pointer-event(e) => {
                                                        if (e.button == PointerEventButton.left
                                                            && (e.kind == PointerEventKind.down
                                                            || (e.kind == PointerEventKind.move && self.pressed))) {
                                                            root.velocity-edited(
                                                                cell.id,
                                                                clamp(1 - self.mouse-y / self.height, 0, 1)
                                                            );
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.automation-lane-visible : Rectangle {
                                        height: 17px;
                                        background: Theme.panel;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            spacing: 6px;
                                            alignment: start;
                                            lane-picker := Rectangle {
                                                width: 168px;
                                                background: picker-touch.has-hover
                                                    ? Theme.surface-raised : transparent;
                                                Text {
                                                    text: root.automation-lane-name == ""
                                                        ? "Pick a parameter  ▾"
                                                        : root.automation-lane-name + "  ▾";
                                                    color: root.automation-lane-name == ""
                                                        ? Theme.text-faint : Theme.text;
                                                    font-size: Theme.text-sm;
                                                    x: 2px;
                                                    vertical-alignment: center;
                                                }
                                                picker-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { lane-menu.show(); }
                                                }
                                                lane-menu := PopupWindow {
                                                    x: 0px;
                                                    // Opens upward: the lane sits at
                                                    // the bottom of the window, so a
                                                    // downward menu would be clipped.
                                                    y: -menu-content.preferred-height - 2px;
                                                    width: menu-content.preferred-width;
                                                    height: menu-content.preferred-height;
                                                    close-policy: close-on-click-outside;
                                                    Rectangle {
                                                        background: Theme.surface;
                                                        border-width: Theme.hairline;
                                                        border-color: Theme.border;
                                                        border-radius: Theme.radius-md;
                                                        menu-content := AutomationLaneMenu {
                                                            targets: root.automation-targets;
                                                            has-lane: root.automation-lane-name != "";
                                                            picked(index) => {
                                                                lane-menu.close();
                                                                root.automation-lane-opened(index);
                                                            }
                                                            cleared => {
                                                                lane-menu.close();
                                                                root.automation-lane-cleared();
                                                            }
                                                            closed => {
                                                                lane-menu.close();
                                                                root.automation-lane-closed();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            Text {
                                                text: root.automation-value-text;
                                                color: Theme.text-muted;
                                                font-size: Theme.text-sm;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.automation-lane-visible : Rectangle {
                                        height: 72px;
                                        background: Theme.surface;
                                        clip: true;
                                        automation-body := Rectangle {
                                            x: -piano-scroll.viewport-x;
                                            width: root.pattern-length * root.piano-step-width;
                                            height: parent.height;
                                            background: transparent;
                                            // Points are drawn inset by half a head
                                            // so a point at 0 or 1 is still fully
                                            // visible and still grabbable.
                                            property <length> inset: 5px;
                                            pure function value-y(value: float) -> length {
                                                return self.inset
                                                    + (self.height - self.inset * 2) * (1 - clamp(value, 0, 1));
                                            }
                                            pure function y-value(y: length) -> float {
                                                return clamp(1 - (y - self.inset)
                                                    / max(1px, self.height - self.inset * 2), 0, 1);
                                            }
                                            pure function tick-x(tick: int) -> length {
                                                return tick * root.piano-step-width / RollMetrics.ticks-per-step;
                                            }
                                            // Grid-snapped tick under `x`, unless
                                            // `free` (Shift held), matching the note
                                            // grid's modifier.
                                            // Grab radius in ticks for a ~7px reach
                                            // at the current time zoom.
                                            pure function grab-ticks() -> int {
                                                return max(1, round(7px * RollMetrics.ticks-per-step / root.piano-step-width));
                                            }
                                            pure function snap(x: length, free: bool) -> int {
                                                let tick = x * RollMetrics.ticks-per-step / root.piano-step-width;
                                                let limit = root.pattern-length * RollMetrics.ticks-per-step;
                                                if (free) {
                                                    return clamp(round(tick), 0, limit);
                                                }
                                                return clamp(round(tick / root.piano-snap-ticks)
                                                    * root.piano-snap-ticks, 0, limit);
                                            }

                                            for division in root.pattern-length * RollMetrics.ticks-per-step / root.piano-snap-ticks : Rectangle {
                                                x: division * root.piano-snap-ticks
                                                    * root.piano-step-width / RollMetrics.ticks-per-step;
                                                width: 1px;
                                                height: parent.height;
                                                background: mod(division * root.piano-snap-ticks, RollMetrics.ticks-per-step) == 0
                                                    ? Theme.text-faint : Theme.border;
                                                opacity: mod(division * root.piano-snap-ticks, RollMetrics.ticks-per-step) == 0
                                                    ? 0.5 : 0.3;
                                            }

                                            // One straight segment per adjacent pair.
                                            // A single Path over the whole lane is
                                            // not expressible: Slint's path elements
                                            // are static children, not a model.
                                            for point[i] in root.automation-points : Path {
                                                visible: i > 0;
                                                width: parent.width;
                                                height: parent.height;
                                                // Without an explicit viewbox each
                                                // Path scales its own commands to
                                                // fill the element, so every segment
                                                // would stretch across the whole
                                                // lane and the curve would read as a
                                                // sheaf of crossing lines.
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: parent.width / 1px;
                                                viewbox-height: parent.height / 1px;
                                                stroke: Theme.accent;
                                                stroke-width: 1.5px;
                                                MoveTo {
                                                    x: automation-body.tick-x(root.automation-points[max(0, i - 1)].tick) / 1px;
                                                    y: automation-body.value-y(root.automation-points[max(0, i - 1)].value) / 1px;
                                                }
                                                LineTo {
                                                    x: automation-body.tick-x(point.tick) / 1px;
                                                    y: automation-body.value-y(point.value) / 1px;
                                                }
                                            }

                                            for point in root.automation-points : Rectangle {
                                                x: parent.tick-x(point.tick) - 4px;
                                                y: parent.value-y(point.value) - 4px;
                                                width: 8px;
                                                height: 8px;
                                                border-radius: Theme.radius-lg;
                                                background: point.selected ? Theme.focus : Theme.accent;
                                                border-width: Theme.hairline;
                                                border-color: Theme.surface;
                                            }

                                            if root.automation-lane-name == "" : Text {
                                                x: 6px;
                                                text: "No parameter selected";
                                                color: Theme.text-faint;
                                                font-size: Theme.text-md;
                                                vertical-alignment: center;
                                            }

                                            // One hit area for the whole lane, for
                                            // the same reason the note grid has one:
                                            // a per-point TouchArea moves out from
                                            // under the cursor on the first drag
                                            // update and the drag collapses.
                                            automation-touch := TouchArea {
                                                property <int> grabbed-id: -1;
                                                property <bool> gesture-open: false;
                                                enabled: root.automation-lane-name != "";
                                                mouse-cursor: root.automation-point-hit-test(
                                                        parent.snap(self.mouse-x, true),
                                                        parent.y-value(self.mouse-y),
                                                        parent.grab-ticks()) >= 0
                                                    ? move : crosshair;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down) {
                                                        let tick = parent.snap(self.mouse-x, e.modifiers.shift);
                                                        let value = parent.y-value(self.mouse-y);
                                                        let hit = root.automation-point-hit-test(
                                                            parent.snap(self.mouse-x, true),
                                                            value,
                                                            parent.grab-ticks());
                                                        if (e.button == PointerEventButton.right) {
                                                            if (hit >= 0) {
                                                                root.automation-point-removed(hit);
                                                            }
                                                        } else if (e.button == PointerEventButton.left) {
                                                            // One press, one undo entry: the
                                                            // point it creates and every move
                                                            // of the drag that follows land as
                                                            // a single edit, the way a knob's
                                                            // drag does. Opened before the
                                                            // create so a click-and-drag on
                                                            // empty lane is one entry too.
                                                            Gesture.begin();
                                                            self.gesture-open = true;
                                                            self.grabbed-id = hit >= 0
                                                                ? hit
                                                                : root.automation-point-created(tick, value);
                                                        }
                                                    } else if (e.kind == PointerEventKind.move
                                                            && self.pressed && self.grabbed-id >= 0) {
                                                        root.automation-point-moved(
                                                            self.grabbed-id,
                                                            parent.snap(self.mouse-x, e.modifiers.shift),
                                                            parent.y-value(self.mouse-y));
                                                    } else if (e.kind == PointerEventKind.up
                                                            || e.kind == PointerEventKind.cancel) {
                                                        self.grabbed-id = -1;
                                                        // Only the button that opened it
                                                        // closes it: a right-click's release
                                                        // has nothing open.
                                                        if (self.gesture-open) {
                                                            self.gesture-open = false;
                                                            Gesture.end();
                                                        }
                                                    }
                                                }
                                                changed has-hover => {
                                                    root.hover-hint = self.has-hover
                                                        ? "Click to add a point, drag to move it, right-click to remove. Shift defeats snap."
                                                        : root.hover-hint == "Click to add a point, drag to move it, right-click to remove. Shift defeats snap."
                                                            ? "" : root.hover-hint;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ===== PLAYLIST =====
                    // The song arrangement.
                    ViewSlot {
                        rect: work.slot-rect(root.playlist-slot);
                        shown: root.view-showing(PaneViews.playlist, root.playlist-slot);
                        VerticalLayout {
                            spacing: 0px;
                            PaneToolbar {
                                PaneTabs {
                                    view-slots: root.view-slots;
                                    slot: root.playlist-slot;
                                    can-leave: root.playlist-slot != 0
                                        || root.main-view-count() > 1;
                                    active: root.slot-active(root.playlist-slot);
                                    zoomed: root.zoomed == root.playlist-slot;
                                    picked(v) => { root.view-picked(v); }
                                    zoom-toggled() => { root.toggle-zoom(root.playlist-slot); }
                                    drag-started(v) => { root.view-drag-started(v); }
                                    drag-dropped(v) => { root.view-drag-dropped(v); }
                                    move-requested(v, s) => { root.move-view(v, s); }
                                }
                                ToolbarRule {}
                                // The same pair the piano roll
                                // carries, in the same order, so
                                // snap is one control in one
                                // place per editor rather than a
                                // label and a ComboBox here, a
                                // toggle and a ComboBox there,
                                // and a MenuField in the toolbar
                                // above deciding which of the two
                                // indices it meant.
                                ToolbarLabel { text: "SNAP"; }
                                MenuField {
                                    options: root.musical-snap-options;
                                    selected-index: root.playlist-snap-index;
                                    field-width: 62px;
                                    menu-width: 120px;
                                    tooltip: "Snap";
                                    hint: "Grid the playlist quantises clips and the loop to";
                                    selected(i) => { root.playlist-snap-index = i; }
                                }
                                Rectangle { width: 4px; }
                                // A toggle the width of a toggle.
                                //
                                // It was a 44px `Loop` with a sentence of
                                // grey text beside it, and between them they
                                // took a fifth of the bar to say something
                                // that is true of one button. The icon is the
                                // transport's repeat sign, lit when the loop
                                // is running; the sentence -- including which
                                // bars are marked, which is the part actually
                                // worth reading -- is the status bar's job on
                                // hover, which is what `hint` is for
                                // everywhere else in this interface.
                                loop-toggle := Rectangle {
                                    width: 26px;
                                    // The sentence, once, with two readers.
                                    //
                                    // A `ToolButton` shows its own `hint`
                                    // from its own TouchArea, and that
                                    // TouchArea is switched off along with
                                    // the button -- so the one state where
                                    // the sentence is worth reading, "there
                                    // is no loop, and here is how to make
                                    // one", was the state you could not
                                    // reach it from. The TouchArea below
                                    // covers exactly that gap, and reads the
                                    // same property rather than holding a
                                    // second copy of the words.
                                    property <string> hint: root.playlist-has-loop
                                        ? "Repeat bars " + root.playlist-loop-bars()
                                            + ". Drag either end of the marked strip to move it."
                                        : "Drag the strip above the bar numbers to mark a section to repeat.";

                                    if !root.playlist-has-loop : TouchArea {
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                StatusHint.show(loop-toggle.hint);
                                            } else {
                                                StatusHint.clear(loop-toggle.hint);
                                            }
                                        }
                                    }
                                    FlatButton {
                                        width: 100%;
                                        height: 100%;
                                        icon: ToolIcons.loop;
                                        tooltip: "Loop (L)";
                                        hint: loop-toggle.hint;
                                        active: root.playlist-loop-enabled;
                                        enabled: root.playlist-has-loop;
                                        clicked => {
                                            root.playlist-loop-enabled-changed(
                                                !root.playlist-loop-enabled);
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "↔"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom Out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.playlist-bar-width > 12px;
                                    clicked => { root.playlist-bar-width = max(12px, root.playlist-bar-width - 4px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom In";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.playlist-bar-width < 96px;
                                    clicked => { root.playlist-bar-width = min(96px, root.playlist-bar-width + 4px); }
                                }
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                viewport-width: max(self.visible-width,
                                    104px + root.playlist-bars * root.playlist-bar-width);
                                viewport-height: max(self.visible-height,
                                    30px + root.pattern-count * 28px);

                                playlist-canvas := Rectangle {
                                    // Pinned, because a sized child of an unsized
                                    // parent is *centred* in Slint, not placed at the
                                    // origin. The canvas is shorter than the viewport
                                    // whenever there are few patterns, and the song
                                    // started at bar 1 somewhere down the middle of
                                    // the pane with the ruler floating away from the
                                    // toolbar above it.
                                    x: 0px;
                                    y: 0px;
                                    width: 104px + root.playlist-bars * root.playlist-bar-width;
                                    height: max(346px, 30px + root.pattern-count * 28px);

                                    Text {
                                        x: 8px; y: 5px;
                                        width: 88px; height: 18px;
                                        text: "PATTERN";
                                        color: Theme.text-faint;
                                        font-size: Theme.text-md;
                                        vertical-alignment: center;
                                    }

                                    // The header is two strips over
                                    // one timeline, and they are
                                    // separate because the two
                                    // gestures are. A loop is a
                                    // section and is dragged out; the
                                    // playhead is a position and is
                                    // dragged along. Sharing one
                                    // strip would have made every
                                    // drag ambiguous and forced a
                                    // modifier onto one of them.
                                    loop-strip := Rectangle {
                                        // Which tick the current drag
                                        // started on. -1 while no
                                        // drag is in progress, so a
                                        // release with no press
                                        // behind it -- the pointer
                                        // entering mid-gesture --
                                        // sets nothing.
                                        property <int> drag-anchor-tick: -1;
                                        x: 104px; y: 0px;
                                        width: root.playlist-bars * root.playlist-bar-width;
                                        height: 10px;
                                        // Darker than the bar numbers
                                        // below it rather than the
                                        // same tone: with no loop set
                                        // this strip is empty, and an
                                        // empty strip that matches
                                        // its neighbour reads as
                                        // padding rather than as
                                        // somewhere to drag.
                                        background: Theme.panel;

                                        if root.playlist-has-loop : Rectangle {
                                            x: root.playlist-tick-x(root.playlist-loop-start-ticks);
                                            width: root.playlist-tick-x(
                                                root.playlist-loop-end-ticks
                                                    - root.playlist-loop-start-ticks);
                                            height: parent.height;
                                            // Drawn whether or not it
                                            // is live, dimmed when it
                                            // is not: the points are
                                            // kept when looping is
                                            // switched off, and a
                                            // strip that went blank
                                            // would say they were not.
                                            background: root.playlist-loop-enabled
                                                ? Theme.accent : Theme.text-faint;
                                            opacity: root.playlist-loop-enabled ? 1 : 0.5;
                                        }

                                        TouchArea {
                                            mouse-cursor: col-resize;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down
                                                    && e.button == PointerEventButton.right) {
                                                    root.playlist-loop-cleared();
                                                } else if (e.kind == PointerEventKind.down
                                                    && e.button == PointerEventButton.left) {
                                                    loop-strip.drag-anchor-tick =
                                                        root.playlist-snapped-tick-at(self.mouse-x);
                                                } else if (e.kind == PointerEventKind.up
                                                    && e.button == PointerEventButton.left
                                                    && loop-strip.drag-anchor-tick >= 0) {
                                                    // Both ends snap
                                                    // down and the
                                                    // range runs to
                                                    // the end of the
                                                    // last unit
                                                    // touched, so a
                                                    // click loops the
                                                    // bar clicked
                                                    // rather than
                                                    // nothing, and a
                                                    // drag loops
                                                    // everything it
                                                    // crossed.
                                                    let released =
                                                        root.playlist-snapped-tick-at(self.mouse-x);
                                                    root.playlist-loop-set(
                                                        min(loop-strip.drag-anchor-tick, released),
                                                        max(loop-strip.drag-anchor-tick, released)
                                                            + root.playlist-snap-ticks);
                                                    loop-strip.drag-anchor-tick = -1;
                                                }
                                            }
                                            changed has-hover => {
                                                root.hover-hint = self.has-hover
                                                    ? "Drag to loop a section. Right-click clears the loop."
                                                    : root.hover-hint == "Drag to loop a section. Right-click clears the loop."
                                                        ? "" : root.hover-hint;
                                            }
                                        }

                                        // The two ends, as grab handles, and
                                        // *after* the drag-out TouchArea
                                        // above rather than beside the
                                        // section they belong to: last
                                        // sibling is topmost, and a handle
                                        // underneath that TouchArea would
                                        // have started a new loop on top of
                                        // the one being adjusted instead of
                                        // moving its edge.
                                        //
                                        // Each end reports its own tick and
                                        // passes the other through unchanged,
                                        // so a handle dragged past its
                                        // partner swaps the two rather than
                                        // collapsing the loop --
                                        // `LoopRange::from_drag` takes them
                                        // in either order and always has.
                                        if root.playlist-has-loop : PlaylistLoopHandle {
                                            x: root.playlist-tick-x(root.playlist-loop-start-ticks)
                                                - self.width / 2;
                                            height: parent.height;
                                            live: root.playlist-loop-enabled;
                                            moved(at) => {
                                                root.playlist-loop-adjusted(
                                                    root.playlist-snapped-tick-at(at),
                                                    root.playlist-loop-end-ticks);
                                            }
                                        }
                                        if root.playlist-has-loop : PlaylistLoopHandle {
                                            x: root.playlist-tick-x(root.playlist-loop-end-ticks)
                                                - self.width / 2;
                                            height: parent.height;
                                            live: root.playlist-loop-enabled;
                                            moved(at) => {
                                                root.playlist-loop-adjusted(
                                                    root.playlist-loop-start-ticks,
                                                    root.playlist-snapped-tick-at(at));
                                            }
                                        }
                                    }

                                    Rectangle {
                                        x: 104px; y: 10px;
                                        width: root.playlist-bars * root.playlist-bar-width;
                                        height: 20px;
                                        background: Theme.surface;
                                        for bar in root.playlist-bars : Rectangle {
                                            x: bar * root.playlist-bar-width;
                                            width: root.playlist-bar-width;
                                            height: parent.height;
                                            border-width: Theme.hairline;
                                            border-color: Theme.border;
                                            Text {
                                                text: bar + 1;
                                                color: Theme.text-faint;
                                                font-size: Theme.text-sm;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down
                                                    && e.button == PointerEventButton.left) {
                                                    root.playlist-seek(
                                                        root.playlist-snapped-tick-at(self.mouse-x));
                                                }
                                            }
                                            // The grab: the playhead
                                            // follows the pointer for
                                            // as long as the button
                                            // is down, rather than
                                            // jumping once per click.
                                            moved => {
                                                if (self.pressed) {
                                                    root.playlist-seek(
                                                        root.playlist-snapped-tick-at(self.mouse-x));
                                                }
                                            }
                                            changed has-hover => {
                                                root.hover-hint = self.has-hover
                                                    ? "Drag to move the playhead."
                                                    : root.hover-hint == "Drag to move the playhead."
                                                        ? "" : root.hover-hint;
                                            }
                                        }
                                    }

                                    for pattern in root.pattern-count : Rectangle {
                                        x: 0px;
                                        y: 30px + pattern * 28px;
                                        width: playlist-canvas.width;
                                        height: 26px;

                                        Rectangle {
                                            x: 8px;
                                            width: 88px;
                                            height: parent.height;
                                            border-radius: Theme.radius-md;
                                            background: root.current-pattern == pattern
                                                ? Theme.surface-active : Theme.surface;
                                            // The channel rack plate's bar, on
                                            // the plate that is its opposite
                                            // number. Same rule and same 3px:
                                            // this fill already means "current
                                            // pattern", so the colour is a mark
                                            // beside it rather than a tint of
                                            // it.
                                            if root.pattern-info[pattern].has-color : Rectangle {
                                                x: 0;
                                                width: 3px;
                                                height: parent.height;
                                                background: root.pattern-info[pattern].color;
                                                border-top-left-radius: Theme.radius-md;
                                                border-bottom-left-radius: Theme.radius-md;
                                            }
                                            Text {
                                                x: 6px;
                                                width: parent.width - 12px;
                                                text: root.pattern-label(pattern);
                                                color: root.current-pattern == pattern
                                                    ? Theme.text : Theme.text-muted;
                                                font-size: Theme.text-lg;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down) {
                                                        root.pattern-selected(pattern);
                                                        if (e.button == PointerEventButton.right) {
                                                            pattern-context-menu.show();
                                                        }
                                                    }
                                                }
                                            }

                                            // Right-click selects the pattern first --
                                            // Clone/Clear/Delete all act on current-pattern,
                                            // not an explicit index -- then opens the menu
                                            // beside the row that owns those commands.
                                            pattern-context-menu := PopupWindow {
                                                x: 0px;
                                                y: parent.height + 2px;
                                                width: 150px;
                                                height: pattern-context-frame.preferred-height;
                                                close-policy: close-on-click;
                                                pattern-context-frame := Rectangle {
                                                    background: Theme.surface;
                                                    border-width: Theme.hairline;
                                                    border-color: Theme.border;
                                                    border-radius: Theme.radius-md;
                                                    VerticalLayout {
                                                        padding: 4px;
                                                        MenuRow { text: "Clone Pattern"; shortcut: "Ctrl+Alt+D"; enabled: !root.project-edit-pending && root.pattern-count < root.max-patterns; selected => { root.pattern-clone-requested(); } }
                                                        MenuRow { text: "Clear Pattern"; enabled: !root.project-edit-pending; selected => { root.pattern-clear-requested(); } }
                                                        MenuSeparator {}
                                                        MenuRow { text: "Delete Pattern"; shortcut: "Ctrl+Shift+Delete"; enabled: !root.project-edit-pending && root.pattern-count > 1; selected => { root.pattern-remove-requested(); } }
                                                    }
                                                }
                                            }
                                        }

                                        timeline := Rectangle {
                                            x: 104px;
                                            width: root.playlist-bars * root.playlist-bar-width;
                                            height: parent.height;
                                            background: Theme.background;

                                            for bar in root.playlist-bars : Rectangle {
                                                x: bar * root.playlist-bar-width;
                                                width: root.playlist-bar-width;
                                                height: parent.height;
                                                background: mod(bar, 4) == 0
                                                    ? Theme.surface : Theme.background;
                                                border-width: Theme.hairline;
                                                border-color: Theme.border;
                                                for division in root.playlist-bar-ticks / root.playlist-snap-ticks : Rectangle {
                                                    visible: division > 0;
                                                    x: division * parent.width
                                                        / (root.playlist-bar-ticks / root.playlist-snap-ticks);
                                                    width: 1px;
                                                    height: parent.height;
                                                    background: Theme.border;
                                                    opacity: 0.48;
                                                }
                                            }

                                            for clip in root.playlist-clips : Rectangle {
                                                visible: clip.pattern == pattern;
                                                property <int> clip-end-tick:
                                                    clip.start-tick + clip.length-steps * RollMetrics.ticks-per-step;
                                                x: clip.start-tick * root.playlist-bar-width
                                                    / root.playlist-bar-ticks;
                                                y: 2px;
                                                width: max(4px,
                                                    clip.length-steps * root.playlist-bar-width / 16);
                                                height: parent.height - 4px;
                                                border-radius: Theme.radius-sm;
                                                border-width: root.playing && root.song-mode
                                                    && root.playlist-position-ticks >= clip.start-tick
                                                    && root.playlist-position-ticks < self.clip-end-tick ? Theme.hairline : 0px;
                                                border-color: Theme.text;
                                                // **The clip is filled, so here
                                                // the colour replaces the fill
                                                // rather than marking it.** The
                                                // distinction is what the shape
                                                // already says: a rack plate's
                                                // fill means "selected", where a
                                                // clip's means "a clip is here"
                                                // -- and a coloured clip still
                                                // says that. What it must not
                                                // lose is its label, which is
                                                // why the ink comes with the
                                                // colour.
                                                background: root.pattern-info[pattern].has-color
                                                    ? root.pattern-info[pattern].color : Theme.accent;
                                                opacity: root.current-pattern == pattern ? 1 : 0.62;
                                                Text {
                                                    text: pattern + 1;
                                                    color: root.pattern-info[pattern].has-color
                                                        ? root.pattern-info[pattern].ink
                                                        : Theme.background;
                                                    font-size: Theme.text-md;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            Rectangle {
                                                x: root.playlist-song-length-ticks * root.playlist-bar-width
                                                    / root.playlist-bar-ticks - 1px;
                                                width: 1px;
                                                height: parent.height;
                                                background: Theme.text-faint;
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down) {
                                                        let raw-tick = clamp(floor(self.mouse-x
                                                            * root.playlist-bar-ticks / root.playlist-bar-width),
                                                            0, root.playlist-bars * root.playlist-bar-ticks - 1);
                                                        if (e.button == PointerEventButton.right) {
                                                            root.playlist-placement-removed(pattern, raw-tick);
                                                        } else if (e.button == PointerEventButton.left) {
                                                            root.playlist-placement-added(pattern,
                                                                floor(raw-tick / root.playlist-snap-ticks)
                                                                    * root.playlist-snap-ticks);
                                                        }
                                                    }
                                                }
                                                // Same hover-linger problem as the piano roll's
                                                // canvas: this one TouchArea spans the whole
                                                // timeline row, so a Tooltip here would show for
                                                // as long as the playlist is in use.
                                                changed has-hover => {
                                                    root.hover-hint = self.has-hover
                                                        ? "Click to place on the playlist grid. Right-click removes a clip."
                                                        : root.hover-hint == "Click to place on the playlist grid. Right-click removes a clip."
                                                            ? "" : root.hover-hint;
                                                }
                                            }
                                        }
                                    }

                                    // Last in the canvas, so both
                                    // draw over the clips rather than
                                    // under them, and neither takes a
                                    // pointer: the strips above own
                                    // those gestures.
                                    if root.playlist-has-loop
                                        && root.playlist-loop-enabled : Rectangle {
                                        x: 104px + root.playlist-tick-x(root.playlist-loop-start-ticks);
                                        // Below the header, not
                                        // across it: the band in the
                                        // loop strip already says
                                        // where the section is, and a
                                        // tint over the bar numbers
                                        // only makes them harder to
                                        // read.
                                        y: 30px;
                                        width: root.playlist-tick-x(
                                            root.playlist-loop-end-ticks
                                                - root.playlist-loop-start-ticks);
                                        height: parent.height - 30px;
                                        background: Theme.accent;
                                        opacity: 0.08;
                                    }

                                    // Always drawn in song mode, not
                                    // only while playing: it is a
                                    // position that can be set now,
                                    // and a playhead that vanished on
                                    // stop would be one there was no
                                    // way to aim.
                                    if root.song-mode : Rectangle {
                                        x: 104px + root.playlist-tick-x(root.playlist-position-ticks);
                                        y: 10px;
                                        width: 1px;
                                        height: parent.height - 10px;
                                        background: Theme.text;
                                        // The grip. Centred on the
                                        // line and sitting in the bar
                                        // ruler, which is the strip
                                        // that moves it.
                                        Rectangle {
                                            x: -4px;
                                            y: 0px;
                                            width: 9px;
                                            height: 8px;
                                            border-radius: 2px;
                                            background: Theme.text;
                                        }
                                    }
                                }
                            }
                        }
                    }


                    // Where the drag would land. Drawn over the slots and
                    // under the dividers, and only while a drag is live.
                    //
                    // A tint plus an edge rather than an animated gap: the
                    // rack opens a gap between rows because a reorder has to
                    // say *where in a sequence*, and a pane drop only has to
                    // say *which pane*.
                    if PaneDrag.active && work.drop-slot >= 0 : Rectangle {
                        property <PaneRect> r: work.would-open-split
                            ? { x: work.width * 0.72, y: 0px,
                                width: work.width * 0.28, height: work.top-h }
                            : work.slot-rect(work.drop-slot);
                        x: self.r.x;
                        y: self.r.y;
                        width: self.r.width;
                        height: self.r.height;
                        background: Theme.accent;
                        opacity: 0.12;
                        border-width: Theme.hairline;
                        border-color: Theme.focus;
                    }

                    // The divider between the two top slots. Same idiom as the
                    // dock's, turned ninety degrees, and drawn only while
                    // there is a split to divide.
                    //
                    // Dragging it to either bound closes the split and folds
                    // its views back into the main slot. That is the same
                    // behaviour as the status bar's chip and the View menu
                    // row, reached by the gesture people already try.
                    if root.split-active >= 0 && root.zoomed < 0 : Rectangle {
                        x: work.main-w;
                        y: 0px;
                        width: 1px;
                        height: work.top-h;
                        background: split-grip.has-hover || split-grip.pressed
                            ? Theme.focus : Theme.border;

                        split-grip := TouchArea {
                            x: -3px;
                            width: 7px;
                            height: parent.height;
                            mouse-cursor: ew-resize;
                            property <length> grab-x;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    Motion.gesture-active = true;
                                    self.grab-x = self.mouse-x;
                                } else if (e.kind == PointerEventKind.move && self.pressed) {
                                    // Moving-origin arithmetic, for the reason
                                    // the dock's grip records: the grip travels
                                    // with the edge it is setting.
                                    let target = root.split-fraction
                                        + (self.mouse-x - self.grab-x) / work.width;
                                    let clamped = clamp(target, 0.15, 0.85);
                                    if (clamped != target) {
                                        self.grab-x = self.mouse-x;
                                    }
                                    root.split-fraction = clamped;
                                } else if (e.kind == PointerEventKind.up
                                        || e.kind == PointerEventKind.cancel) {
                                    Motion.gesture-active = false;
                                    // Dragged hard against a bound: the pane
                                    // being squeezed out is being closed.
                                    if (root.split-fraction <= 0.16
                                            || root.split-fraction >= 0.84) {
                                        if (root.split-fraction <= 0.16) {
                                            // The main slot lost; what survives
                                            // is what the split was showing.
                                            root.main-active = root.split-active;
                                        }
                                        root.toggle-split();
                                        root.split-fraction = 0.5;
                                    }
                                    root.layout-changed();
                                }
                            }
                            double-clicked => { root.split-fraction = 0.5; }
                        }
                    }

                    // The divider between the top slots and the dock. The 1px
                    // line is the visual; the grab zone is 6px and reaches
                    // up. Declared after every slot on purpose: the zone
                    // reaches into both, and the last element to claim a
                    // point is the one that gets the press.
                    //
                    // Live on the notes view only, exactly as before. Step 03
                    // is what generalises that to "any view that does not
                    // declare its own height", which is DEVICES and nothing
                    // else.
                    if root.bottom-pane-visible && root.zoomed < 0 : Rectangle {
                        x: 0px;
                        y: work.top-h;
                        width: work.width;
                        height: 1px;
                        background: dock-grip.has-hover || dock-grip.pressed
                            ? Theme.focus : Theme.border;

                        dock-grip := TouchArea {
                            // 5px up into the pane above and 1px down, not a
                            // zone centred on the line: 3px down would reach
                            // the tab strip below, whose tabs begin 4px past
                            // the divider once the row's padding is counted.
                            y: -5px;
                            width: parent.width;
                            height: 6px;
                            // Live unless the bottom view declares its own
                            // height, which only DEVICES does.
                            enabled: root.zoomed < 0 && root.bottom-active >= 0
                                && !PaneViews.fixed-height[root.bottom-active];
                            mouse-cursor: ns-resize;
                            property <length> grab-y;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    Motion.gesture-active = true;
                                    self.grab-y = self.mouse-y;
                                } else if (e.kind == PointerEventKind.move && self.pressed) {
                                    // The grip travels with the edge it moves, so
                                    // mouse-y is measured against a moving origin:
                                    // fold each event's offset into the current
                                    // height rather than replaying from the press.
                                    let target = root.dock-height(root.bottom-active)
                                        - (self.mouse-y - self.grab-y);
                                    let clamped = max(140px,
                                        min(target, root.height - 220px));
                                    if (clamped != target) {
                                        // A bound swallowed the move; re-anchor so
                                        // reversing direction responds immediately
                                        // instead of unwinding the overshoot.
                                        self.grab-y = self.mouse-y;
                                    }
                                    root.set-dock-height(root.bottom-active, clamped);
                                } else if (e.kind == PointerEventKind.up
                                        || e.kind == PointerEventKind.cancel) {
                                    Motion.gesture-active = false;
                                }
                            }
                        }
                    }
                }

                // ===== Browser sidebar =====
                //
                // Sample (and later, preset) browsing. Its left edge carries the
                // same moving-origin drag integrator as the dock splitter: the
                // grip rides the edge it moves, so each event folds its offset
                // into the current width. Dragging left widens. The tree itself
                // is flattened by Rust; rows toggle and top-level folders are
                // removed by path.
                // Always in flow so hide/show can animate: the width eases to the
                // stored sidebar-width or to 0 (clipped), instead of the old
                // instant `if`. The resize grip steps the animation aside while
                // it owns the value.
                Rectangle {
                    width: root.sidebar-visible ? root.sidebar-width : 0px;
                    background: Theme.panel;
                    animate width {
                        duration: Motion.duration;
                        easing: Motion.curve;
                        enabled: !Motion.gesture-active;
                    }

                    // Clipped content holder. The resize grip below stays
                    // outside this subtree on purpose: 5 of its 6px reach left
                    // of the sidebar's edge, and `clip` cuts pointer events
                    // along with pixels.
                    Rectangle {
                        clip: true;
                        x: 0;
                        width: parent.width;
                        height: parent.height;

                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 24px;
                            background: Theme.surface;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 3px;
                                padding-top: 2px;
                                padding-bottom: 2px;
                                spacing: 4px;
                                // Two tabs over one row model. A text tab
                                // rather than a ToolButton: these sit in a
                                // 24px header beside 18px squares, and a
                                // button's minimum height is larger than the
                                // bar they live in.
                                for tab[i] in ["SAMPLES", "PRESETS"] : Rectangle {
                                    width: browser-tab-label.preferred-width + 10px;
                                    border-radius: Theme.radius-sm;
                                    background: root.browser-tab == i
                                        ? Theme.surface-active
                                        : browser-tab-touch.has-hover
                                            ? Theme.surface-raised : transparent;
                                    browser-tab-label := Text {
                                        text: tab;
                                        color: root.browser-tab == i
                                            ? Theme.text : Theme.text-faint;
                                        font-size: Theme.text-md;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    browser-tab-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.focused-surface = "browser";
                                            root.browser-tab = i;
                                            root.browser-tab-changed(i);
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                // Autoplay arm: when tinted, clicking a sample
                                // row plays it. Sample-side only, along with
                                // the preview trim and the add-folder button:
                                // none of the three means anything to a
                                // preset, and a control that is present but
                                // inert is worse than one that is absent.
                                if root.browser-tab == 0 : Rectangle {
                                    width: 18px;
                                    border-radius: Theme.radius-sm;
                                    background: root.browser-autoplay
                                        ? Theme.accent-active
                                        : browser-autoplay-touch.has-hover
                                            ? Theme.surface-active : Theme.surface-raised;
                                    Text {
                                        width: parent.width;
                                        text: "♪";
                                        color: root.browser-autoplay
                                            ? Theme.text : Theme.text-muted;
                                        font-size: Theme.text-lg;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                    browser-autoplay-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.browser-autoplay = !root.browser-autoplay;
                                        }
                                    }
                                }
                                if root.browser-tab == 0 : TrimKnob {
                                    controlled: false;
                                    label: "Preview volume";
                                    diameter: 20px;
                                    value <=> root.browser-preview-gain-db;
                                    changed(v) => {
                                        root.browser-preview-gain-changed(GainMath.db-to-linear(v));
                                    }
                                }
                                if root.browser-tab == 0 : Rectangle {
                                    width: 18px;
                                    border-radius: Theme.radius-sm;
                                    background: browser-add-touch.pressed
                                        || browser-add-touch.has-hover
                                        ? Theme.surface-active : Theme.surface-raised;
                                    Text {
                                        width: parent.width;
                                        text: "+";
                                        color: Theme.text-muted;
                                        font-size: Theme.text-xl;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                    browser-add-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.browser-add-location(); }
                                    }
                                }
                            }
                        }

                        // The filter (MOO-9). One field for both tabs: it
                        // narrows whichever tree is showing, by name --
                        // and for a preset by its category, tags and group.
                        Rectangle {
                            height: 26px;
                            background: Theme.panel;
                            browser-filter-field := SearchField {
                                x: 6px;
                                y: 3px;
                                width: parent.width - 12px;
                                text: root.browser-filter;
                                placeholder: root.browser-tab == 0 ? "Filter samples" : "Filter presets";
                                edited(value) => {
                                    root.browser-filter = value;
                                    root.browser-filter-changed(value);
                                }
                            }
                        }

                        if root.browser-rows.length == 0 : Text {
                            text: root.browser-filter != "" ? "Nothing matches"
                                : root.browser-tab == 0
                                ? "Click + to add a folder of samples"
                                : "No presets saved yet";
                            color: Theme.text-faint;
                            font-size: Theme.text-md;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        browser-scroll := ScrollView {
                            vertical-stretch: 1;
                            viewport-height: root.browser-rows.length * ROW;

                            property <length> ROW: 20px;
                            // Keep the keyboard's row on screen. A local
                            // alias plus `changed` is how movement in a root
                            // property is observed from inside the element
                            // that can read its own viewport -- Rust knows
                            // the index but not how many rows fit.
                            property <int> focused: root.browser-focus-index;
                            changed focused => {
                                if (self.focused >= 0) {
                                    if (self.focused * self.ROW < -self.viewport-y) {
                                        self.viewport-y = -self.focused * self.ROW;
                                    } else if ((self.focused + 1) * self.ROW
                                            > -self.viewport-y + self.visible-height) {
                                        self.viewport-y = self.visible-height
                                            - (self.focused + 1) * self.ROW;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 0px;
                                for row[index] in root.browser-rows : Rectangle {
                                    height: browser-scroll.ROW;
                                    accessible-role: list-item;
                                    accessible-label: row.name;
                                    accessible-item-selectable: true;
                                    accessible-item-selected: index == root.browser-focus-index;
                                    // The keyboard's row reads as selected
                                    // even when the pointer is elsewhere;
                                    // hover still lights whatever is under
                                    // the pointer, so the two are legible
                                    // apart.
                                    background: index == root.browser-focus-index
                                        ? Theme.surface-active
                                        : browser-row-touch.has-hover
                                            ? Theme.surface-active : transparent;
                                    if index == root.browser-focus-index : Rectangle {
                                        x: 0;
                                        width: 2px;
                                        height: 100%;
                                        background: Theme.accent;
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px + row.depth * 12px;
                                        padding-right: 6px;
                                        spacing: 5px;
                                        Text {
                                            width: 10px;
                                            // A group expands like a folder; a
                                            // preset is a leaf like a sample.
                                            text: (row.kind == 0 || row.kind == 2)
                                                ? (row.expanded ? "▾" : "▸")
                                                : row.kind == 1 ? "♪" : "◈";
                                            color: (row.kind == 0 || row.kind == 2)
                                                ? Theme.text-muted
                                                : row.loadable ? Theme.accent : Theme.text-faint;
                                            font-size: Theme.text-md;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.name;
                                            color: (row.kind == 0 || row.kind == 2)
                                                ? Theme.text-muted
                                                : row.loadable ? Theme.text : Theme.text-faint;
                                            font-size: Theme.text-lg;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        // A preset's category and tags, or a
                                        // group's count. Takes what is left
                                        // after the name rather than a fixed
                                        // column, so a long name wins.
                                        Rectangle { horizontal-stretch: 1; }
                                        if row.detail != "" : Text {
                                            text: row.detail;
                                            color: Theme.text-faint;
                                            font-size: Theme.text-md;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    browser-row-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        // Where a left press landed, in window
                                        // coordinates, so a drag is told from a
                                        // click by how far it has gone.
                                        property <length> press-x;
                                        property <length> press-y;
                                        clicked => {
                                            // A click is also where the
                                            // keyboard now is, so the arrows
                                            // carry on from the row that was
                                            // just pressed.
                                            root.focused-surface = "browser";
                                            root.browser-focus-index = index;
                                            // A preset is only *selected* by a
                                            // click (Adam, MOO-9): loading one is
                                            // a double-click, Enter, or a drag.
                                            if (row.kind == 0 || row.kind == 2) {
                                                root.browser-row-toggled(row.path);
                                            } else if (row.kind == 1) {
                                                root.browser-row-previewed(row.path);
                                            }
                                        }
                                        double-clicked => {
                                            if (row.kind == 1) {
                                                root.browser-sample-loaded(row.path);
                                            } else if (row.kind == 3 && row.loadable) {
                                                root.browser-preset-loaded(row.path);
                                            }
                                        }
                                        moved => {
                                            if (!self.pressed || row.kind != 3 || !row.loadable) { return; }
                                            let x = self.absolute-position.x + self.mouse-x;
                                            let y = self.absolute-position.y + self.mouse-y;
                                            if (!BrowserDrag.active
                                                    && abs(x - self.press-x) + abs(y - self.press-y) > 6px) {
                                                BrowserDrag.path = row.path;
                                                BrowserDrag.name = row.name;
                                                BrowserDrag.active = true;
                                            }
                                            BrowserDrag.pointer-x = x;
                                            BrowserDrag.pointer-y = y;
                                        }
                                        pointer-event(e) => {
                                            if (e.button == PointerEventButton.left) {
                                                if (e.kind == PointerEventKind.down) {
                                                    self.press-x = self.absolute-position.x + self.mouse-x;
                                                    self.press-y = self.absolute-position.y + self.mouse-y;
                                                } else if (e.kind == PointerEventKind.up
                                                        || e.kind == PointerEventKind.cancel) {
                                                    // Dropped on a join: there, in the chain
                                                    // (MOO-218). Anywhere else on the rack: the
                                                    // same load a double-click does.
                                                    if (BrowserDrag.active && e.kind == PointerEventKind.up) {
                                                        if (BrowserDrag.target-before >= 0) {
                                                            root.browser-preset-dropped(BrowserDrag.path,
                                                                BrowserDrag.target-before);
                                                        } else if (BrowserDrag.over-rack) {
                                                            root.browser-preset-loaded(BrowserDrag.path);
                                                        }
                                                    }
                                                    BrowserDrag.end();
                                                }
                                            }
                                            if (e.kind == PointerEventKind.down
                                                    && e.button == PointerEventButton.right && row.kind == 3) {
                                                root.browser-focus-index = index;
                                                browser-preset-context-menu.show();
                                            }
                                            if (e.kind == PointerEventKind.down
                                                    && e.button == PointerEventButton.right) {
                                                // Only a sample *location* can
                                                // be removed. A preset group is
                                                // also at depth 0 and is not a
                                                // location, so the kind has to
                                                // be checked and not just the
                                                // depth.
                                                if (row.kind == 0 && row.depth == 0) {
                                                    root.browser-location-removed(row.path);
                                                } else if (row.kind == 1) {
                                                    browser-sample-context-menu.show();
                                                }
                                            }
                                        }
                                    }

                                    // A preset's menu (Adam, MOO-9: *"right clicking a
                                    // preset should have a meaningful menu"*): load it
                                    // by the double-click rule, or always as a new
                                    // device. Callback first, close after.
                                    browser-preset-context-menu := PopupWindow {
                                        x: 0px;
                                        y: parent.height + 2px;
                                        width: 190px;
                                        height: browser-preset-context-frame.preferred-height;
                                        close-policy: close-on-click;
                                        browser-preset-context-frame := Rectangle {
                                            background: Theme.surface;
                                            border-width: Theme.hairline;
                                            border-color: Theme.border;
                                            border-radius: Theme.radius-md;
                                            VerticalLayout {
                                                padding: 4px;
                                                MenuRow { text: "Load"; enabled: row.loadable; selected => { root.browser-preset-loaded(row.path); } }
                                                if row.effect : MenuRow { text: "Add as New Device"; selected => { root.browser-preset-appended(row.path); } }
                                            }
                                        }
                                    }

                                    // Right-clicking a sample opens the load menu.
                                    // The row is the popup's anchor, so each row
                                    // carries its own, like the pattern menu.
                                    browser-sample-context-menu := PopupWindow {
                                        x: 0px;
                                        y: parent.height + 2px;
                                        width: 190px;
                                        height: browser-sample-context-frame.preferred-height;
                                        close-policy: close-on-click;
                                        browser-sample-context-frame := Rectangle {
                                            background: Theme.surface;
                                            border-width: Theme.hairline;
                                            border-color: Theme.border;
                                            border-radius: Theme.radius-md;
                                            VerticalLayout {
                                                padding: 4px;
                                                MenuRow { text: "Load in Selected Channel"; selected => { root.browser-sample-loaded(row.path); } }
                                                MenuRow { text: "Load in New Channel"; selected => { root.browser-sample-loaded-new-channel(row.path); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Info pane for the last-clicked sample: its waveform
                        // plus the format stats the file's header carries.
                        if root.browser-info-waveform.length > 0 : Rectangle {
                            height: 78px;
                            background: Theme.surface;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: 1px;
                                background: Theme.border;
                            }

                            VerticalLayout {
                                padding: 6px;
                                padding-top: 9px;
                                spacing: 4px;
                                Text {
                                    text: root.browser-info-name;
                                    color: Theme.text-muted;
                                    font-size: Theme.text-md;
                                    overflow: elide;
                                }
                                SampleTrace {
                                    vertical-stretch: 1;
                                    maximums: root.browser-info-waveform;
                                }
                                Text {
                                    text: root.browser-info-stats;
                                    color: Theme.text-faint;
                                    font-size: Theme.text-md;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 1px;
                        height: parent.height;
                        background: sidebar-grip.has-hover || sidebar-grip.pressed
                            ? Theme.focus : Theme.border;
                    }
                    }

                    sidebar-grip := TouchArea {
                        x: -5px;
                        width: 6px;
                        height: parent.height;
                        enabled: root.sidebar-visible;
                        mouse-cursor: ew-resize;
                        property <length> grab-x;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                Motion.gesture-active = true;
                                self.grab-x = self.mouse-x;
                            } else if (e.kind == PointerEventKind.move && self.pressed) {
                                let target = root.sidebar-width
                                    - (self.mouse-x - self.grab-x);
                                let clamped = max(180px,
                                    min(target, min(400px, root.width - 280px)));
                                if (clamped != target) {
                                    // A bound swallowed the move; re-anchor so
                                    // reversing direction responds immediately
                                    // instead of unwinding the overshoot.
                                    self.grab-x = self.mouse-x;
                                }
                                root.sidebar-width = clamped;
                            } else if (e.kind == PointerEventKind.up
                                    || e.kind == PointerEventKind.cancel) {
                                Motion.gesture-active = false;
                                root.layout-changed();
                            }
                        }
                    }
                }
            }

            // ===== Status bar =====
            //
            // A docked, always-visible row: the work surface ends at this bar's
            // top edge, so nothing ever reflows or hides under the pointer when
            // a hint appears. Live gesture hints take priority over the last
            // status-message; permanent readouts can join the strip.
            //
            // Two hint channels, and they are not redundant. `hover-hint` is
            // this window's own -- the surfaces defined in this file, which
            // can write a property on `root` directly. `StatusHint` is the
            // one every control anywhere reaches, without a property threaded
            // up through the device face it sits in. The window's own wins,
            // because a gesture over the playlist is more specific than the
            // button the pointer passed on the way there.
            //
            // Left to right: the held notice, the hint line, the audio
            // readout, the layout chips. The notice is a segment of its own
            // rather than one more rung in the hint line's priority chain,
            // because that line changes every time the pointer crosses a
            // control -- an error ranked below the hints would be hidden
            // exactly while the user is working, and one ranked above them
            // would hide every hint until it was dismissed.
            Rectangle {
                height: 24px;
                vertical-stretch: 0;
                background: Theme.surface-raised;

                // Where the layout chips begin, counted off the list for the
                // reason the chips' own `x` is.
                property <length> chips-left: self.width - root.layout-chips.length * 26px;
                property <string> readout-hint: root.audio-load < 0
                    ? "Audio has not rendered a block in the last second"
                    : "Audio load over the last second: \{Math.round(root.audio-load * 100)}% on average, \{Math.round(root.audio-load-peak * 100)}% in the worst block"
                        + (root.audio-dropouts > 0 ? ". Click to reset the dropout count" : "")
                        + (root.audio-time-shared
                            ? ". The audio thread is not realtime, so it drops out whenever the machine is busy"
                            : "");

                Rectangle {
                    y: 0;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }

                // Coloured by weight, and clicked away. `status_bar::notify`
                // decides what may replace it; clicking is the one way it
                // ends that Rust does not decide.
                notice := Rectangle {
                    property <color> tone: root.status-notice-level == NoticeLevel.error
                        ? Theme.destructive : Theme.warning;
                    visible: root.status-notice != "";
                    x: 8px;
                    y: 3px;
                    height: parent.height - 5px;
                    width: self.visible
                        ? min(notice-text.preferred-width + 22px, (parent.chips-left - 8px) * 0.6)
                        : 0px;
                    border-radius: Theme.radius-sm;
                    border-width: Theme.hairline;
                    border-color: notice-touch.has-hover ? self.tone : transparent;
                    Rectangle {
                        x: 5px;
                        y: (parent.height - self.height) / 2;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: parent.tone;
                    }
                    notice-text := Text {
                        x: 18px;
                        width: parent.width - 22px;
                        height: parent.height;
                        text: root.status-notice;
                        color: parent.tone;
                        font-size: Theme.text-lg;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    notice-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.status-notice = "";
                        }
                    }
                }

                Text {
                    y: 0;
                    height: parent.height;
                    // The status bar's own two segments first: the pointer is
                    // on the bar, so no control elsewhere is being hovered.
                    text: notice-touch.has-hover ? "Click to dismiss"
                        : readout-touch.has-hover ? parent.readout-hint
                        : root.hover-hint != "" ? root.hover-hint
                        : StatusHint.text != "" ? StatusHint.text
                        // Below the two hint channels, because a live gesture
                        // is more urgent than a mode; above the last status
                        // message, because a pane filling the window is a
                        // state the user needs a way out of.
                        : root.zoomed >= 0
                            ? "Zoomed — double-click the tab or press Esc to restore"
                        : root.status-message;
                    color: Theme.text-muted;
                    font-size: Theme.text-lg;
                    x: notice.visible ? notice.x + notice.width + 12px : 8px;
                    width: max(0px, readout.x - 12px - self.x);
                    vertical-alignment: center;
                    overflow: elide;
                }

                // Numbers only; what they mean is the hint line's, on hover.
                readout := HorizontalLayout {
                    x: parent.chips-left - self.width - 12px;
                    width: self.preferred-width;
                    height: parent.height;
                    spacing: 10px;
                    if root.audio-time-shared: Text {
                        text: "not realtime";
                        color: Theme.warning;
                        font-size: Theme.text-lg;
                        vertical-alignment: center;
                    }
                    if root.audio-dropouts > 0: Text {
                        text: root.audio-dropouts == 1 ? "1 dropout" : "\{root.audio-dropouts} dropouts";
                        color: Theme.warning;
                        font-size: Theme.text-lg;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.audio-load < 0 ? "DSP –" : "DSP \{Math.round(root.audio-load * 100)}%";
                        color: root.audio-load < 0 ? Theme.text-faint
                            : root.audio-load-peak >= 0.8 ? Theme.warning
                            : Theme.text-muted;
                        font-size: Theme.text-lg;
                        vertical-alignment: center;
                    }
                }
                readout-touch := TouchArea {
                    x: readout.x;
                    width: readout.width;
                    height: parent.height;
                    clicked => {
                        root.audio-dropouts = 0;
                    }
                }

                // Layout toggles. The pinned ToolButton style exposes no
                // checkable state, so these are hand-rolled two-state chips:
                // tinted while their region is showing, plain while hidden.
                //
                // **They read in the screen order of the regions they
                // toggle**, by each region's left edge: the dock starts at
                // x 0, the split at the divider, the browser at the sidebar's
                // edge. Adam asked for that on 2026-09-08, and applying it
                // found the browser chip drawing `panel-left` for a sidebar
                // that is docked on the right -- which it had done since the
                // chip was written.
                for chip[k] in root.layout-chips : Rectangle {
                    width: 20px;
                    height: 20px;
                    y: 2px;
                    // Chip k spans [width - (n - k) * 26, +20], where n is the
                    // number of chips -- read off the list rather than spelled
                    // beside it, because a fourth chip arriving is exactly
                    // when a hardcoded three would stop being true.
                    x: parent.width - (root.layout-chips.length - k) * 26px;
                    border-radius: Theme.radius-sm;
                    border-width: Theme.hairline;
                    border-color: chip-touch.has-hover ? Theme.border : transparent;
                    background: chip.on ? Theme.accent-active
                        : chip-touch.pressed ? Theme.surface-active : Theme.surface;
                    Path {
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: chip.fill;
                        fill: chip.on ? Theme.text : Theme.text-muted;
                        opacity: 0.55;
                    }
                    Path {
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: chip.line;
                        stroke: chip.on ? Theme.text : Theme.text-muted;
                        stroke-width: 1.3px;
                        fill: transparent;
                    }
                    chip-touch := TouchArea {
                        mouse-cursor: pointer;
                        enabled: k != 2 || root.split-active >= 0
                            || root.other-main-view() >= 0;
                        clicked => {
                            if (k == 0) {
                                root.toggle-channel-sidebar();
                            } else if (k == 1) {
                                root.bottom-pane-visible = !root.bottom-pane-visible;
                                root.layout-changed();
                            } else if (k == 2) {
                                root.toggle-split();
                            } else {
                                root.sidebar-visible = !root.sidebar-visible;
                                root.layout-changed();
                            }
                        }
                    }
                    accessible-role: button;
                    accessible-label: chip.label;
                    accessible-checked: chip.on;
                }
            }

        }
    }

    // The preset a browser drag is carrying, beside the pointer (MOO-9).
    // Above everything but the dialogs, and never in the way of the drop:
    // it sits below and right of the hot spot.
    if BrowserDrag.active : Rectangle {
        x: BrowserDrag.pointer-x + 12px;
        y: BrowserDrag.pointer-y + 12px;
        width: browser-drag-label.preferred-width + 12px;
        height: 20px;
        border-radius: Theme.radius-md;
        background: BrowserDrag.over-rack ? Theme.accent-active : Theme.surface-raised;
        border-width: Theme.hairline;
        border-color: Theme.border;
        browser-drag-label := Text {
            x: 6px;
            text: BrowserDrag.name;
            color: Theme.text;
            font-size: Theme.text-md;
            vertical-alignment: center;
        }
    }

    PreferencesDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.preferences-open;
        appearance-theme <=> root.preferences-appearance-theme;
        appearance-customized <=> root.preferences-appearance-customized;
        appearance-mode <=> root.preferences-appearance-mode;
        appearance-schemes <=> root.preferences-appearance-schemes;
        appearance-ramp <=> root.preferences-appearance-ramp;
        appearance-variant-derived <=> root.preferences-appearance-variant-derived;
        appearance-text-ratio <=> root.preferences-appearance-text-ratio;
        appearance-accent-ratio <=> root.preferences-appearance-accent-ratio;
        appearance-base-choices <=> root.preferences-appearance-base-choices;
        appearance-hue-choices <=> root.preferences-appearance-hue-choices;
        appearance-base <=> root.preferences-appearance-base;
        appearance-accent <=> root.preferences-appearance-accent;
        appearance-alert <=> root.preferences-appearance-alert;
        appearance-contrast <=> root.preferences-appearance-contrast;
        appearance-roundness <=> root.preferences-appearance-roundness;
        appearance-type-scale <=> root.preferences-appearance-type-scale;
        appearance-density <=> root.preferences-appearance-density;
        appearance-font-family <=> root.preferences-appearance-font-family;
        appearance-font-family-mono <=> root.preferences-appearance-font-family-mono;
        appearance-font-weight <=> root.preferences-appearance-font-weight;
        appearance-hairline <=> root.preferences-appearance-hairline;
        appearance-stroke-emphasis <=> root.preferences-appearance-stroke-emphasis;
        appearance-relief <=> root.preferences-appearance-relief;
        appearance-relief-depth <=> root.preferences-appearance-relief-depth;
        appearance-theme-name <=> root.preferences-appearance-theme-name;
        developer-mode <=> root.preferences-developer-mode;
        mockup-tool-available: root.preferences-mockup-tool-available;
        smooth-curves <=> root.preferences-smooth-curves;
        log-path: root.preferences-log-path;
        validation-error: root.preferences-error;
        audio-output-targets: root.preferences-audio-output-targets;
        audio-buffer-size-index: root.preferences-audio-buffer-size-index;
        audio-sample-rate-text: root.preferences-audio-sample-rate-text;
        audio-auto-reconnect: root.preferences-audio-auto-reconnect;
        audio-error: root.preferences-audio-error;
        audio-driver: root.preferences-audio-driver;
        shortcut-rows: root.preferences-shortcut-rows;
        gesture-rows: root.preferences-gesture-rows;
        gesture-choices: root.preferences-gesture-choices;
        shortcut-super-key-choices: root.preferences-shortcut-super-key-choices;
        shortcut-super-key <=> root.preferences-shortcut-super-key;
        meter-falloff-options: root.preferences-meter-falloff-options;
        shortcut-capturing-id <=> root.preferences-shortcut-capturing-id;
        midi-ports: root.preferences-midi-ports;
        midi-port-note: root.preferences-midi-port-note;
        midi-bindings: root.preferences-midi-bindings;
        midi-transport-rows: root.preferences-midi-transport-rows;
        midi-learn-binds-port: root.preferences-midi-learn-binds-port;
        midi-learn-binds-port-toggled(v) => { root.preferences-midi-learn-binds-port-toggled(v); }
        midi-binding-removed(i) => { root.midi-binding-removed(i); }
        midi-binding-takeover-toggled(i) => { root.midi-binding-takeover-toggled(i); }
        midi-binding-inverted-toggled(i) => { root.midi-binding-inverted-toggled(i); }
        midi-binding-relearn(i) => { root.midi-binding-relearn(i); }
        midi-transport-learn(i) => { root.midi-transport-learn(i); }
        appearance-preview() => { root.preferences-appearance-preview(); }
        appearance-mode-changed(m) => { root.preferences-appearance-mode-changed(m); }
        appearance-select-theme(name) => { root.preferences-appearance-select-theme(name); }
        appearance-save-theme(name) => { root.preferences-appearance-save-theme(name); }
        appearance-remove-theme(name) => { root.preferences-appearance-remove-theme(name); }
        save() => { root.preferences-save() }
        cancelled => { root.preferences-cancelled(); }
        audio-refresh-targets => { root.preferences-audio-refresh-targets(); }
        audio-select-output(client, port-l, port-r) => { root.preferences-audio-select-output(client, port-l, port-r); }
        audio-select-buffer-size(i) => { root.preferences-audio-select-buffer-size(i); }
        audio-auto-reconnect-toggled(v) => { root.preferences-audio-auto-reconnect-toggled(v); }
        shortcut-rebind-key(id, key, ctrl, shift, alt, meta) => { root.preferences-shortcut-rebind-key(id, key, ctrl, shift, alt, meta); }
        shortcut-reset(id) => { root.preferences-shortcut-reset(id); }
        shortcut-reset-all => { root.preferences-shortcut-reset-all(); }
        gesture-rebound(id, index) => { root.preferences-gesture-rebound(id, index); }
        shortcut-super-key-changed(index) => { root.preferences-shortcut-super-key-changed(index); }
        open-mockup-tool => { root.preferences-open-mockup-tool(); }
    }
    SavePresetDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.save-preset-open;
        title: root.save-preset-title;
        name-text <=> root.save-preset-name;
        category-text <=> root.save-preset-category;
        save-confirmed(name, category) => { root.save-preset-confirmed(name, category); }
        cancelled => { root.save-preset-cancelled(); }
    }

    SaveErrorDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.save-error-open;
        title <=> root.save-error-title;
        detail <=> root.save-error-detail;
        report <=> root.save-error-report;
        dismissed => { root.save-error-dismissed(); }
    }
    ExportDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.export-open;
        format-index <=> root.export-format;
        bitrate-index <=> root.export-bitrate;
        tail-seconds <=> root.export-tail-seconds;
        phase <=> root.export-phase;
        progress: root.export-progress;
        result-title: root.export-result-title;
        result-detail: root.export-result-detail;
        accepted(format, bitrate, tail) => { root.export-confirmed(format, bitrate, tail); }
        cancelled => { root.export-open = false; }
        cancel-render => { root.export-cancel-render(); }
        dismissed => {
            root.export-open = false;
            root.export-phase = 0;
        }
    }
    AboutDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.about-open;
        app-version: root.app-version;
        closed => { root.about-open = false; }
    }
    TakesDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.takes-open;
        title: root.takes-title;
        intro: root.takes-intro;
        session-rows: root.takes-session-rows;
        earlier-rows: root.takes-earlier-rows;
        earlier-note: root.takes-earlier-note;
        total: root.takes-total;
        can-confirm: root.takes-can-confirm;
        confirm-label: root.takes-confirm-label;
        cancel-label: root.takes-cancel-label;
        toggled(earlier, index) => { root.take-toggled(earlier, index); }
        confirmed => { root.takes-confirmed(); }
        cancelled => { root.takes-cancelled(); }
    }
    // Last, so it sits over every other dialog: the unsaved-changes question
    // can arrive while the takes dialog is up.
    QuestionDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.question-open;
        title: root.question-title;
        detail: root.question-detail;
        primary-label: root.question-primary;
        secondary-label: root.question-secondary;
        answered(answer) => { root.question-answered(answer); }
    }
}
