import { ComboBox, HorizontalBox, ScrollView, SpinBox, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    IconButton, MiniKnob, ParameterFader, ParameterKnob, PeakMeter,
    SectionLabel as DesignSectionLabel, SegmentedControl, StereoPeakMeter, ToolButton,
    TransportButton, ValueScale, MuteButton as DesignMuteButton
} from "controls.slint";
import {
    BeatLamps, MenuField, NameField, PositionReadout, StepperField, TempoField,
    ToolbarLabel, ToolbarRule, ToolIcons, ToolModeButton
} from "toolbar.slint";
import { MasterMeter } from "meters.slint";
import { EnvelopeEditor } from "envelope.slint";
import { AppearanceDialog } from "appearance-dialog.slint";
import { DocumentMenu, ExportDialog } from "document-menu.slint";
export { Theme }
export { ControlGallery } from "gallery.slint";

// One step cell used in the step-grid models.
struct StepCell {
    active: bool,
    velocity: int,
    // Which 64th slots a note covers, and which ones a note actually starts on.
    // Coverage alone cannot tell a ratcheted step from one long note: both fill
    // all four slots. Onsets are what make a slice visible.
    substeps: int,
    onsets: int,
}

// One tick-addressed note event for the selected channel's piano roll.
struct NoteCell {
    id: int,
    start-tick: int,
    duration-ticks: int,
    note: int,
    velocity: int,
    selected: bool,
}

// Result of asking Rust which note (if any) covers a given tick/MIDI-note
// cell. The search itself lives in Rust because Slint's imperative language
// has no loop or recursion construct that survives its binding-loop checker
// (a self-recursive `pure function` is flagged as a cyclic binding even
// when it terminates), so there is no way to scan a variable-length note
// list from within .slint code.
struct NoteHit {
    found: bool,
    id: int,
    start-tick: int,
    duration-ticks: int,
}

// One channel row in the rack.
struct ChannelRow {
    name: string,
    muted: bool,
    volume: float,
    pan: float,
    selected: bool,
    steps: [StepCell],
}

// One pattern instance in the song playlist.
struct PlaylistClip {
    pattern: int,
    start-tick: int,
    length-steps: int,
}

component FlatButton inherits ToolButton { }
component SectionLabel inherits DesignSectionLabel { }
component MuteButton inherits DesignMuteButton { }

component WaveformMarker inherits Rectangle {
    in property <string> marker-label;
    in property <color> marker-color;
    in property <float> value;
    in property <length> editor-width;
    in property <bool> label-at-bottom;
    callback moved(float);

    width: 1px;
    background: transparent;
    accessible-role: slider;
    accessible-label: root.marker-label + " marker";
    accessible-value: round(root.value * 1000) / 10 + "%";

    Rectangle {
        width: 1px;
        height: parent.height;
        background: root.marker-color;
    }
    Rectangle {
        x: clamp(-6px, -root.x, root.editor-width - root.x - 13px);
        y: root.label-at-bottom ? parent.height - 18px : 2px;
        width: 13px;
        height: 16px;
        border-radius: 2px;
        background: root.marker-color;
        Text {
            text: root.marker-label;
            color: Theme.background;
            font-size: 8px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    marker-touch := TouchArea {
        x: -7px;
        width: 15px;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                root.moved(clamp((root.x + self.x + self.mouse-x) / max(1px, root.editor-width), 0, 1));
            }
        }
    }
    Tooltip { text: @markdown("Drag the **\{root.marker-label}** marker"); }
}

// A compact oscillator strip shared by the three mono-synth oscillators.
component OscillatorStrip inherits Rectangle {
    in property <string> title;
    in-out property <int> wave;
    in-out property <float> semitones;
    in-out property <float> cents;
    in-out property <float> level;
    in-out property <float> pulse-width;
    callback wave-changed(int);
    callback semitones-changed(float);
    callback cents-changed(float);
    callback level-changed(float);
    callback pulse-width-changed(float);

    width: 300px;
    height: 116px;
    background: Theme.surface-raised;
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 5px;
        spacing: 2px;
        SectionLabel { text: root.title; }
        HorizontalLayout {
            spacing: 0px;
            ComboBox {
                model: ["Sine", "Tri", "Saw", "Pulse"];
                current-index <=> root.wave;
                width: 72px;
                height: 24px;
                selected(value) => { root.wave-changed(self.current-index); }
                Tooltip { text: @markdown("Oscillator waveform"); }
            }
            ParameterKnob {
                width: 52px; diameter: 40px;
                label: "Semi"; tooltip: "Oscillator coarse tuning in semitones";
                value <=> root.semitones; minimum: -48; maximum: 48; default-value: 0; step: 1;
                value-text: (root.semitones > 0 ? "+" : "") + round(root.semitones) + " st";
                changed(v) => { root.semitones-changed(v); }
            }
            ParameterKnob {
                width: 52px; diameter: 40px;
                label: "Cents"; tooltip: "Oscillator fine tuning in cents";
                value <=> root.cents; minimum: -100; maximum: 100; default-value: 0; step: 1;
                value-text: (root.cents > 0 ? "+" : "") + round(root.cents) + " ct";
                changed(v) => { root.cents-changed(v); }
            }
            ParameterKnob {
                width: 52px; diameter: 40px;
                label: "Level"; tooltip: "Oscillator mix level";
                value <=> root.level; minimum: 0; maximum: 1; default-value: 0;
                value-text: round(root.level * 100) + "%";
                changed(v) => { root.level-changed(v); }
            }
            ParameterKnob {
                width: 52px; diameter: 40px;
                label: "Width"; tooltip: "Pulse width (used by Pulse waveform)";
                value <=> root.pulse-width; minimum: 0.05; maximum: 0.95; default-value: 0.5;
                enabled: root.wave == 3;
                value-text: round(root.pulse-width * 100) + "%";
                changed(v) => { root.pulse-width-changed(v); }
            }
        }
    }
}

component DrumSourceEditor inherits Rectangle {
    in-out property <int> mode;
    in-out property <float> decay;
    in-out property <float> tune-semitones;
    in-out property <float> drive;
    in-out property <int> choke-group;
    in-out property <float> kick-start-hz;
    in-out property <float> kick-end-hz;
    in-out property <float> kick-sweep;
    in-out property <float> kick-click;
    in-out property <float> snare-tone-hz;
    in-out property <float> snare-noise-mix;
    in-out property <float> snare-noise-decay;
    in-out property <float> hat-hp-hz;
    in-out property <float> hat-metallic;
    callback mode-changed(int);
    callback decay-changed(float);
    callback tune-semitones-changed(float);
    callback drive-changed(float);
    callback choke-group-changed(int);
    callback kick-start-hz-changed(float);
    callback kick-end-hz-changed(float);
    callback kick-sweep-changed(float);
    callback kick-click-changed(float);
    callback snare-tone-hz-changed(float);
    callback snare-noise-mix-changed(float);
    callback snare-noise-decay-changed(float);
    callback hat-hp-hz-changed(float);
    callback hat-metallic-changed(float);

    ScrollView {
        vertical-stretch: 1;
        horizontal-stretch: 1;
        viewport-width: max(self.visible-width, 520px);
        viewport-height: max(self.visible-height, 292px);
        VerticalLayout {
            width: 520px;
            padding: 8px;
            spacing: 8px;
            Rectangle {
                height: 32px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "MODE"; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                    SegmentedControl {
                        width: 180px;
                        options: ["Kick", "Snare", "Hat"];
                        selected-index <=> root.mode;
                        selected(i) => { root.mode-changed(i); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Rectangle {
                height: 110px;
                background: Theme.surface;
                border-radius: 3px;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding: 6px;
                    spacing: 2px;
                    SectionLabel { text: "SHARED"; width: 48px; vertical-alignment: center; }
                    ParameterKnob {
                        label: "Decay"; tooltip: "Amplitude decay in seconds";
                        value <=> root.decay; minimum: 0; maximum: 2; default-value: 0.35;
                        value-text: round(root.decay * 1000) + " ms";
                        changed(v) => { root.decay-changed(v); }
                    }
                    ParameterKnob {
                        label: "Tune"; tooltip: "Keyboard tracking offset in semitones";
                        value <=> root.tune-semitones; minimum: -48; maximum: 48; default-value: 0; step: 1;
                        value-text: (root.tune-semitones > 0 ? "+" : "") + round(root.tune-semitones) + " st";
                        changed(v) => { root.tune-semitones-changed(v); }
                    }
                    ParameterKnob {
                        label: "Drive"; tooltip: "Soft saturation amount";
                        value <=> root.drive; minimum: 0; maximum: 1; default-value: 0; fill: Theme.warning;
                        value-text: round(root.drive * 100) + "%";
                        changed(v) => { root.drive-changed(v); }
                    }
                    VerticalLayout {
                        width: 66px;
                        spacing: 2px;
                        Text { text: "CHOKE"; color: Theme.text-faint; font-size: 8px; }
                        SpinBox {
                            value <=> root.choke-group; minimum: 0; maximum: 16; step-size: 1;
                            width: 62px; height: 24px;
                            edited(value) => { root.choke-group-changed(value); }
                            Tooltip { text: @markdown("Matching non-zero groups choke each other. 0 is off."); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if root.mode == 0 : Rectangle {
                height: 110px; background: Theme.surface;
                border-radius: 3px; border-width: 1px; border-color: Theme.border;
                HorizontalLayout {
                    padding: 6px; spacing: 2px;
                    SectionLabel { text: "KICK"; width: 48px; vertical-alignment: center; }
                    ParameterKnob {
                        label: "Start"; tooltip: "Kick sweep start frequency";
                        value <=> root.kick-start-hz; minimum: 20; maximum: 1000; default-value: 160; scale: ValueScale.logarithmic;
                        value-text: round(root.kick-start-hz) + " Hz"; changed(v) => { root.kick-start-hz-changed(v); }
                    }
                    ParameterKnob {
                        label: "End"; tooltip: "Kick sweep end frequency";
                        value <=> root.kick-end-hz; minimum: 20; maximum: 400; default-value: 48; scale: ValueScale.logarithmic;
                        value-text: round(root.kick-end-hz) + " Hz"; changed(v) => { root.kick-end-hz-changed(v); }
                    }
                    ParameterKnob {
                        label: "Sweep"; tooltip: "Kick pitch sweep time";
                        value <=> root.kick-sweep; minimum: 0; maximum: 2; default-value: 0.045;
                        value-text: round(root.kick-sweep * 1000) + " ms"; changed(v) => { root.kick-sweep-changed(v); }
                    }
                    ParameterKnob {
                        label: "Click"; tooltip: "Beater click level";
                        value <=> root.kick-click; minimum: 0; maximum: 1; default-value: 0.5;
                        value-text: round(root.kick-click * 100) + "%"; changed(v) => { root.kick-click-changed(v); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if root.mode == 1 : Rectangle {
                height: 110px; background: Theme.surface;
                border-radius: 3px; border-width: 1px; border-color: Theme.border;
                HorizontalLayout {
                    padding: 6px; spacing: 2px;
                    SectionLabel { text: "SNARE"; width: 48px; vertical-alignment: center; }
                    ParameterKnob {
                        label: "Tone"; tooltip: "Snare body frequency";
                        value <=> root.snare-tone-hz; minimum: 40; maximum: 2000; default-value: 180; scale: ValueScale.logarithmic;
                        value-text: round(root.snare-tone-hz) + " Hz"; changed(v) => { root.snare-tone-hz-changed(v); }
                    }
                    ParameterKnob {
                        label: "Noise Mix"; tooltip: "Noise versus body mix";
                        value <=> root.snare-noise-mix; minimum: 0; maximum: 1; default-value: 0.6;
                        value-text: round(root.snare-noise-mix * 100) + "%"; changed(v) => { root.snare-noise-mix-changed(v); }
                    }
                    ParameterKnob {
                        label: "Noise Decay"; tooltip: "Noise burst decay in seconds";
                        value <=> root.snare-noise-decay; minimum: 0; maximum: 2; default-value: 0.15;
                        value-text: round(root.snare-noise-decay * 1000) + " ms"; changed(v) => { root.snare-noise-decay-changed(v); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if root.mode == 2 : Rectangle {
                height: 110px; background: Theme.surface;
                border-radius: 3px; border-width: 1px; border-color: Theme.border;
                HorizontalLayout {
                    padding: 6px; spacing: 2px;
                    SectionLabel { text: "HAT"; width: 48px; vertical-alignment: center; }
                    ParameterKnob {
                        label: "HP"; tooltip: "Hat high-pass cutoff";
                        value <=> root.hat-hp-hz; minimum: 500; maximum: 16000; default-value: 7500; scale: ValueScale.logarithmic;
                        value-text: round(root.hat-hp-hz) + " Hz"; changed(v) => { root.hat-hp-hz-changed(v); }
                    }
                    ParameterKnob {
                        label: "Metallic"; tooltip: "Metallic square oscillator blend";
                        value <=> root.hat-metallic; minimum: 0; maximum: 1; default-value: 0.5;
                        value-text: round(root.hat-metallic * 100) + "%"; changed(v) => { root.hat-metallic-changed(v); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

component MonoSourceEditor inherits Rectangle {
    in-out property <int> osc1-wave; in-out property <float> osc1-semitones; in-out property <float> osc1-cents; in-out property <float> osc1-level; in-out property <float> osc1-pulse-width;
    in-out property <int> osc2-wave; in-out property <float> osc2-semitones; in-out property <float> osc2-cents; in-out property <float> osc2-level; in-out property <float> osc2-pulse-width;
    in-out property <int> osc3-wave; in-out property <float> osc3-semitones; in-out property <float> osc3-cents; in-out property <float> osc3-level; in-out property <float> osc3-pulse-width;
    in-out property <float> glide; in-out property <float> attack; in-out property <float> decay; in-out property <float> sustain; in-out property <float> release;
    in-out property <float> filter-cutoff; in-out property <float> filter-resonance; in-out property <float> filter-env; in-out property <float> drive;
    callback osc1-wave-changed(int); callback osc1-semitones-changed(float); callback osc1-cents-changed(float); callback osc1-level-changed(float); callback osc1-pulse-width-changed(float);
    callback osc2-wave-changed(int); callback osc2-semitones-changed(float); callback osc2-cents-changed(float); callback osc2-level-changed(float); callback osc2-pulse-width-changed(float);
    callback osc3-wave-changed(int); callback osc3-semitones-changed(float); callback osc3-cents-changed(float); callback osc3-level-changed(float); callback osc3-pulse-width-changed(float);
    callback glide-changed(float); callback attack-changed(float); callback decay-changed(float); callback sustain-changed(float); callback release-changed(float);
    callback filter-cutoff-changed(float); callback filter-resonance-changed(float); callback filter-env-changed(float); callback drive-changed(float);

    ScrollView {
        vertical-stretch: 1; horizontal-stretch: 1;
        viewport-width: max(self.visible-width, 944px);
        viewport-height: max(self.visible-height, 344px);
        VerticalLayout {
            width: 944px; padding: 8px; spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                OscillatorStrip {
                    title: "OSC 1"; wave <=> root.osc1-wave; semitones <=> root.osc1-semitones; cents <=> root.osc1-cents; level <=> root.osc1-level; pulse-width <=> root.osc1-pulse-width;
                    wave-changed(v) => { root.osc1-wave-changed(v); } semitones-changed(v) => { root.osc1-semitones-changed(v); } cents-changed(v) => { root.osc1-cents-changed(v); } level-changed(v) => { root.osc1-level-changed(v); } pulse-width-changed(v) => { root.osc1-pulse-width-changed(v); }
                }
                OscillatorStrip {
                    title: "OSC 2"; wave <=> root.osc2-wave; semitones <=> root.osc2-semitones; cents <=> root.osc2-cents; level <=> root.osc2-level; pulse-width <=> root.osc2-pulse-width;
                    wave-changed(v) => { root.osc2-wave-changed(v); } semitones-changed(v) => { root.osc2-semitones-changed(v); } cents-changed(v) => { root.osc2-cents-changed(v); } level-changed(v) => { root.osc2-level-changed(v); } pulse-width-changed(v) => { root.osc2-pulse-width-changed(v); }
                }
                OscillatorStrip {
                    title: "OSC 3"; wave <=> root.osc3-wave; semitones <=> root.osc3-semitones; cents <=> root.osc3-cents; level <=> root.osc3-level; pulse-width <=> root.osc3-pulse-width;
                    wave-changed(v) => { root.osc3-wave-changed(v); } semitones-changed(v) => { root.osc3-semitones-changed(v); } cents-changed(v) => { root.osc3-cents-changed(v); } level-changed(v) => { root.osc3-level-changed(v); } pulse-width-changed(v) => { root.osc3-pulse-width-changed(v); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 388px; height: 166px; background: Theme.surface; border-radius: 3px; border-width: 1px; border-color: Theme.border;
                    VerticalLayout {
                        padding: 6px; spacing: 3px;
                        SectionLabel { text: "AMP ENVELOPE"; }
                        EnvelopeEditor {
                            height: 52px; attack: root.attack / 2; decay: root.decay / 2; sustain <=> root.sustain; release: root.release / 2;
                            attack-text: round(root.attack * 1000) + " ms"; decay-text: round(root.decay * 1000) + " ms"; sustain-text: round(root.sustain * 100) + "%"; release-text: round(root.release * 1000) + " ms";
                            attack-changed(v) => { root.attack = v * 2; root.attack-changed(root.attack); }
                            decay-changed(v) => { root.decay = v * 2; root.decay-changed(root.decay); }
                            sustain-changed(v) => { root.sustain-changed(v); }
                            release-changed(v) => { root.release = v * 2; root.release-changed(root.release); }
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            ParameterKnob { label: "Glide"; tooltip: "Portamento time"; value <=> root.glide; minimum: 0; maximum: 2; default-value: 0; value-text: round(root.glide * 1000) + " ms"; changed(v) => { root.glide-changed(v); } }
                            ParameterKnob { label: "Attack"; tooltip: "Amplitude attack time"; value <=> root.attack; minimum: 0; maximum: 2; default-value: 0.005; value-text: round(root.attack * 1000) + " ms"; changed(v) => { root.attack-changed(v); } }
                            ParameterKnob { label: "Decay"; tooltip: "Amplitude decay time"; value <=> root.decay; minimum: 0; maximum: 2; default-value: 0.2; value-text: round(root.decay * 1000) + " ms"; changed(v) => { root.decay-changed(v); } }
                            ParameterKnob { label: "Sustain"; tooltip: "Amplitude sustain level"; value <=> root.sustain; minimum: 0; maximum: 1; default-value: 0.7; value-text: round(root.sustain * 100) + "%"; changed(v) => { root.sustain-changed(v); } }
                            ParameterKnob { label: "Release"; tooltip: "Amplitude release time"; value <=> root.release; minimum: 0; maximum: 2; default-value: 0.15; value-text: round(root.release * 1000) + " ms"; changed(v) => { root.release-changed(v); } }
                        }
                    }
                }
                Rectangle {
                    width: 480px; height: 166px; background: Theme.surface; border-radius: 3px; border-width: 1px; border-color: Theme.border;
                    VerticalLayout {
                        padding: 6px; spacing: 3px;
                        SectionLabel { text: "FILTER AND DRIVE"; }
                        HorizontalLayout {
                            spacing: 0px;
                            ParameterKnob { label: "Cutoff"; tooltip: "Low-pass filter cutoff"; value <=> root.filter-cutoff; minimum: 0; maximum: 1; default-value: 1; value-text: root.filter-cutoff >= 0.999 ? "Open" : round(20 * pow(20000 / 20, root.filter-cutoff)) + " Hz"; changed(v) => { root.filter-cutoff-changed(v); } }
                            ParameterKnob { label: "Reso"; tooltip: "Filter resonance"; value <=> root.filter-resonance; minimum: 0; maximum: 1; default-value: 0; value-text: round(root.filter-resonance * 100) + "%"; changed(v) => { root.filter-resonance-changed(v); } }
                            ParameterKnob { label: "Env"; tooltip: "Bipolar filter envelope depth"; value <=> root.filter-env; minimum: -1; maximum: 1; default-value: 0; bipolar: true; fill: Theme.warning; value-text: (root.filter-env > 0 ? "+" : "") + round(root.filter-env * 100) + "%"; changed(v) => { root.filter-env-changed(v); } }
                            ParameterKnob { label: "Drive"; tooltip: "Soft saturation amount"; value <=> root.drive; minimum: 0; maximum: 1; default-value: 0; fill: Theme.warning; value-text: round(root.drive * 100) + "%"; changed(v) => { root.drive-changed(v); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

export component MainWindow inherits Window {
    title: root.document-title;
    preferred-width: 1280px;
    preferred-height: 760px;
    background: Theme.background;

    // ---- transport / state exchanged with Rust ----
    in-out property <bool>  playing;
    in-out property <int>   bpm;
    in-out property <int>   beat-in-bar;
    in-out property <float> meter-l-db: -60;
    in-out property <float> meter-r-db: -60;
    in-out property <float> meter-l-held-db: -60;
    in-out property <float> meter-r-held-db: -60;
    in-out property <bool> meter-l-clipping;
    in-out property <bool> meter-r-clipping;

    // ---- appearance settings ----
    in-out property <bool> appearance-open;
    in-out property <int> appearance-preset;
    in-out property <string> appearance-accent: "#84CC16";
    in-out property <string> appearance-error;
    callback appearance-opened();
    callback appearance-preview(int, string);
    callback appearance-save(int, string) -> bool;
    callback appearance-cancelled();

    // ---- document lifecycle ----
    in-out property <string> document-title: "Untitled - mooloop";
    in-out property <bool> embed-assets: true;
    in-out property <bool> document-busy;
    in-out property <string> status-message;
    in-out property <bool> export-open;
    in-out property <int> export-format;
    in-out property <int> export-bitrate: 2;
    in-out property <int> export-tail-seconds: 2;
    callback open-song();
    callback save-song();
    callback save-song-as();
    callback load-kit();
    callback save-kit();
    callback load-channel();
    callback save-channel();
    callback export-audio();
    callback export-confirmed(int, int, int);

    // ---- channels / patterns ----
    in-out property <[ChannelRow]> channels;
    in-out property <int> current-pattern;
    in-out property <int> pattern-count: 1;
    in-out property <int> pattern-length;
    in-out property <int> current-step;
    in-out property <int> selected-channel;
    in-out property <[NoteCell]> notes;
    in-out property <bool> song-mode;
    in-out property <[PlaylistClip]> playlist-clips;
    in-out property <int> playlist-position-ticks;
    in-out property <int> playlist-song-length-ticks: 384;
    in-out property <int> playlist-bars: 64;
    in-out property <length> playlist-bar-width: 24px;
    property <int> playlist-bar-ticks: 384;
    property <[string]> musical-snap-options: [
        "1 Bar", "1/2", "1/4", "1/4T", "1/8", "1/8T",
        "1/16", "1/16T", "1/32", "1/32T", "1/64",
    ];
    in-out property <int> musical-snap-index: 6;

    // Transport position, computed engine-side because it depends on PPQ and
    // on whether the playlist or the pattern is driving.
    in-out property <int> position-bar: 1;
    in-out property <int> position-beat: 1;
    in-out property <int> position-tick;

    // Pattern identity. Names are optional; the selector falls back to the
    // number so an unnamed pattern is never blank.
    in-out property <string> current-pattern-name;
    in-out property <[string]> pattern-menu-options;
    callback pattern-renamed(int, string);

    // Editing tool: 0=Select 1=Paint 2=Slice 3=Stretch.
    in-out property <int> tool-mode;
    in-out property <int> slice-divisions: 2;
    // Paint and stretch are drags, so they report a target state rather than
    // toggling: a drag across mixed steps must not invert each one.
    callback step-painted(int, int, bool);   // channel, step, on
    callback step-sliced(int, int, int);     // channel, step, divisions
    callback step-length-dragged(int, int, int); // channel, step, length in steps
    property <int> musical-snap-ticks: root.snap-ticks(root.musical-snap-index);

    pure function snap-ticks(index: int) -> int {
        index == 0 ? 384 : index == 1 ? 192 : index == 2 ? 96
            : index == 3 ? 64 : index == 4 ? 48 : index == 5 ? 32
            : index == 6 ? 24 : index == 7 ? 16 : index == 8 ? 12
            : index == 9 ? 8 : 6
    }

    callback step-clicked(int, int);       // channel, step
    callback step-removed(int, int);       // channel, step
    callback step-velocity-edited(int, int, float); // channel, step, normalised velocity
    callback channel-selected(int);
    callback channel-muted(int);
    callback channel-volume-changed(int, float);
    callback channel-pan-changed(int, float);
    callback add-channel-clicked(int); // 0=Sampler, 1=Drum, 2=Mono
    callback remove-channel-clicked();
    callback add-pattern-clicked();
    callback pattern-selected(int);
    callback pattern-length-changed(int);
    callback playback-mode-changed(bool);
    callback playlist-placement-added(int, int);   // pattern, absolute start tick
    callback playlist-placement-removed(int, int); // pattern, tick covered by clip

    // ---- lower editor ----
    in-out property <int> editor-page;      // 0=Source, 1=Notes, 2=Playlist
    in-out property <int> source-kind;      // 0=Sampler, 1=Drum, 2=Mono
    callback channel-source-changed(int);
    in-out property <int> selected-note-step;
    in-out property <int> selected-note;
    in-out property <int> selected-velocity;
    in-out property <int> selected-duration-ticks: 24;
    in-out property <bool> has-selected-note;
    property <int> piano-low-note: 36;
    property <int> piano-high-note: 84;
    property <length> piano-row-height: 5px;
    property <length> piano-step-width: 32px;

    callback piano-note-created(int, int, int);  // start tick, MIDI note, duration ticks
    callback piano-note-selected(int);      // stable note ID
    callback piano-note-moved(int, int, int); // ID, start tick, MIDI note
    callback piano-note-resized(int, int);  // ID, duration ticks
    callback piano-note-removed(int);       // stable note ID
    // Pure so it can be read from the cursor-shape binding below. Rust owns the
    // note list, so the scan lives there.
    pure callback piano-note-hit-test(int, int) -> NoteHit; // tick, MIDI note -> note under it, if any
    callback velocity-edited(int, float);   // stable note ID, normalised value
    callback selected-note-changed(int);
    callback selected-velocity-changed(int);
    callback selected-duration-changed(int);

    // ---- sampler params of the selected channel ----
    in-out property <float> attack;
    in-out property <float> decay;
    in-out property <float> sustain;
    in-out property <float> release;
    in-out property <float> start-pos;
    in-out property <float> end-pos: 1;
    in-out property <float> loop-start;
    in-out property <float> loop-end;
    in-out property <bool> reverse-playback;
    in-out property <int> root-note: 60;
    in-out property <float> tune-semitones;
    in-out property <float> tune-cents;
    in-out property <float> filter-cutoff;
    in-out property <float> filter-resonance;
    in-out property <float> filter-env;
    in-out property <float> sampler-drive;
    in-out property <float> bit-reduction;
    in-out property <float> rate-reduction;
    in-out property <int>   loop-mode;     // 0=Off 1=Fwd 2=Pong
    in-out property <int> voice-mode;       // 0=One Shot 1=Gate
    in-out property <int> sampler-polyphony: 1;
    in-out property <int> retrigger-mode;   // 0=Restart 1=Layer
    in-out property <int> choke-group;
    in-out property <string> sample-name;
    in-out property <string> sample-description;
    in-out property <float> sample-duration;
    in-out property <int> audio-sample-rate: 48000;
    in-out property <string> selected-channel-name;
    in-out property <[float]> waveform;
    in-out property <bool> can-previous-sample;
    in-out property <bool> can-next-sample;

    callback attack-changed(float);
    callback decay-changed(float);
    callback sustain-changed(float);
    callback release-changed(float);
    callback start-pos-changed(float);
    callback end-pos-changed(float);
    callback loop-start-changed(float);
    callback loop-end-changed(float);
    callback reverse-playback-changed(bool);
    callback root-note-changed(int);
    callback tune-semitones-changed(float);
    callback tune-cents-changed(float);
    callback loop-mode-changed(int);
    callback voice-mode-changed(int);
    callback sampler-polyphony-changed(int);
    callback retrigger-mode-changed(int);
    callback choke-group-changed(int);
    callback filter-cutoff-changed(float);
    callback filter-resonance-changed(float);
    callback filter-env-changed(float);
    callback sampler-drive-changed(float);
    callback bit-reduction-changed(float);
    callback rate-reduction-changed(float);
    callback load-sample-clicked();
    callback previous-sample-clicked();
    callback next-sample-clicked();

    // ---- drum synth params of the selected channel ----
    in-out property <int> drum-mode; // 0=Kick, 1=Snare, 2=Hat
    in-out property <float> drum-decay: 0.35;
    in-out property <float> drum-tune-semitones;
    in-out property <float> drum-drive;
    in-out property <int> drum-choke-group;
    in-out property <float> drum-kick-start-hz: 160;
    in-out property <float> drum-kick-end-hz: 48;
    in-out property <float> drum-kick-sweep: 0.045;
    in-out property <float> drum-kick-click: 0.5;
    in-out property <float> drum-snare-tone-hz: 180;
    in-out property <float> drum-snare-noise-mix: 0.6;
    in-out property <float> drum-snare-noise-decay: 0.15;
    in-out property <float> drum-hat-hp-hz: 7500;
    in-out property <float> drum-hat-metallic: 0.5;
    callback drum-mode-changed(int);
    callback drum-decay-changed(float);
    callback drum-tune-semitones-changed(float);
    callback drum-drive-changed(float);
    callback drum-choke-group-changed(int);
    callback drum-kick-start-hz-changed(float);
    callback drum-kick-end-hz-changed(float);
    callback drum-kick-sweep-changed(float);
    callback drum-kick-click-changed(float);
    callback drum-snare-tone-hz-changed(float);
    callback drum-snare-noise-mix-changed(float);
    callback drum-snare-noise-decay-changed(float);
    callback drum-hat-hp-hz-changed(float);
    callback drum-hat-metallic-changed(float);

    // ---- mono synth params of the selected channel ----
    in-out property <int> mono-osc1-wave: 2;
    in-out property <float> mono-osc1-semitones;
    in-out property <float> mono-osc1-cents;
    in-out property <float> mono-osc1-level: 0.8;
    in-out property <float> mono-osc1-pulse-width: 0.5;
    in-out property <int> mono-osc2-wave: 2;
    in-out property <float> mono-osc2-semitones: 12;
    in-out property <float> mono-osc2-cents: 4;
    in-out property <float> mono-osc2-level;
    in-out property <float> mono-osc2-pulse-width: 0.5;
    in-out property <int> mono-osc3-wave: 2;
    in-out property <float> mono-osc3-semitones: -12;
    in-out property <float> mono-osc3-cents: -4;
    in-out property <float> mono-osc3-level;
    in-out property <float> mono-osc3-pulse-width: 0.5;
    in-out property <float> mono-glide;
    in-out property <float> mono-attack: 0.005;
    in-out property <float> mono-decay: 0.2;
    in-out property <float> mono-sustain: 0.7;
    in-out property <float> mono-release: 0.15;
    in-out property <float> mono-filter-cutoff: 1;
    in-out property <float> mono-filter-resonance;
    in-out property <float> mono-filter-env;
    in-out property <float> mono-drive;
    callback mono-osc1-wave-changed(int); callback mono-osc1-semitones-changed(float); callback mono-osc1-cents-changed(float); callback mono-osc1-level-changed(float); callback mono-osc1-pulse-width-changed(float);
    callback mono-osc2-wave-changed(int); callback mono-osc2-semitones-changed(float); callback mono-osc2-cents-changed(float); callback mono-osc2-level-changed(float); callback mono-osc2-pulse-width-changed(float);
    callback mono-osc3-wave-changed(int); callback mono-osc3-semitones-changed(float); callback mono-osc3-cents-changed(float); callback mono-osc3-level-changed(float); callback mono-osc3-pulse-width-changed(float);
    callback mono-glide-changed(float); callback mono-attack-changed(float); callback mono-decay-changed(float); callback mono-sustain-changed(float); callback mono-release-changed(float);
    callback mono-filter-cutoff-changed(float); callback mono-filter-resonance-changed(float); callback mono-filter-env-changed(float); callback mono-drive-changed(float);

    // ---- transport callbacks ----
    callback new-song();
    callback play-clicked();
    callback stop-clicked();
    callback bpm-changed(int);
    callback toggle-play();

    // Keyboard transport: Space toggles play/pause. Gives an input path
    // independent of mouse clicks (also useful for diagnosing input issues).
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-play();
                accept
            } else if (event.text == Key.UpArrow) {
                root.channel-selected(max(0, root.selected-channel - 1));
                accept
            } else if (event.text == Key.DownArrow) {
                root.channel-selected(min(root.channels.length - 1, root.selected-channel + 1));
                accept
            } else {
                reject
            }
        }
    }

    VerticalBox {
        spacing: 0px;

        // ===== Toolbar =====
        //
        // Two rows, split by what they answer. The transport row is the state
        // of playback and never changes meaning; the edit row is what the
        // current click will do. Mixing the two into one strip is what made
        // the old bar read as a row of unrelated buttons.
        Rectangle {
            height: 62px;
            background: Theme.surface;

            VerticalLayout {
                spacing: 0px;

                // --- Transport row -----------------------------------------
                Rectangle {
                    height: 32px;
                    HorizontalBox {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 3px;

                        DocumentMenu {
                            height: 24px;
                            embed-assets <=> root.embed-assets;
                            busy: root.document-busy;
                            new-song => { root.new-song(); }
                            open-song => { root.open-song(); }
                            save-song => { root.save-song(); }
                            save-song-as => { root.save-song-as(); }
                            load-kit => { root.load-kit(); }
                            save-kit => { root.save-kit(); }
                            load-channel => { root.load-channel(); }
                            save-channel => { root.save-channel(); }
                            export-audio => { root.export-audio(); }
                        }

                        ToolbarRule {}

                        TransportButton {
                            text: root.playing ? "⏸" : "▶";
                            tooltip: root.playing ? "Pause (Space)" : "Play (Space)";
                            role: "play";
                            active: root.playing;
                            clicked => { root.toggle-play(); }
                        }
                        TransportButton {
                            text: "■";
                            tooltip: "Stop";
                            enabled: root.playing || root.current-step > 0;
                            clicked => { root.stop-clicked(); }
                        }

                        ToolbarRule {}

                        SegmentedControl {
                            width: 96px;
                            height: 24px;
                            options: ["PAT", "SONG"];
                            selected-index: root.song-mode ? 1 : 0;
                            selected(i) => {
                                if ((i == 1) != root.song-mode) {
                                    root.song-mode = i == 1;
                                    root.playback-mode-changed(root.song-mode);
                                }
                            }
                        }

                        ToolbarRule {}

                        PositionReadout {
                            bar: root.position-bar;
                            beat: root.position-beat;
                            tick: root.position-tick;
                        }
                        BeatLamps {
                            current: root.beat-in-bar;
                            running: root.playing;
                        }

                        ToolbarRule {}

                        TempoField {
                            bpm <=> root.bpm;
                            changed(v) => { root.bpm-changed(v); }
                        }

                        Rectangle { horizontal-stretch: 1; min-width: 8px; }

                        MasterMeter {
                            width: 200px;
                            left-db: root.meter-l-db;
                            right-db: root.meter-r-db;
                            held-left-db: root.meter-l-held-db;
                            held-right-db: root.meter-r-held-db;
                            left-clipping: root.meter-l-clipping;
                            right-clipping: root.meter-r-clipping;
                        }

                        IconButton {
                            text: "⚙";
                            tooltip: "Appearance settings";
                            clicked => {
                                root.appearance-opened();
                                root.appearance-open = true;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; opacity: 0.6; }

                // --- Edit row ----------------------------------------------
                Rectangle {
                    height: 29px;
                    background: Theme.panel;
                    HorizontalBox {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 3px;
                        padding-bottom: 2px;
                        spacing: 3px;

                        // Pattern selection is a stepper plus a jump list, so
                        // it costs the same width at 2 patterns and at 200.
                        ToolbarLabel { text: "PAT"; }
                        Rectangle {
                            height: 24px;
                            width: pattern-group.preferred-width;
                            border-radius: 3px;
                            background: Theme.surface-raised;
                            pattern-group := HorizontalLayout {
                                spacing: 0px;
                                StepperField {
                                    value: root.current-pattern + 1;
                                    minimum: 1;
                                    maximum: root.pattern-count;
                                    tooltip: "Selected pattern";
                                    value-width: 26px;
                                    field-background: transparent;
                                    changed(v) => { root.pattern-selected(v - 1); }
                                }
                                MenuField {
                                    options: root.pattern-menu-options;
                                    selected-index: root.current-pattern;
                                    display-text: "";
                                    field-width: 0px;
                                    menu-width: 180px;
                                    tooltip: "Jump to pattern";
                                    field-background: transparent;
                                    selected(i) => { root.pattern-selected(i); }
                                }
                            }
                        }
                        NameField {
                            text: root.current-pattern-name;
                            placeholder: "Pattern " + (root.current-pattern + 1);
                            tooltip: "Name this pattern";
                            edited(t) => { root.pattern-renamed(root.current-pattern, t); }
                        }
                        IconButton {
                            text: "+";
                            tooltip: "Create pattern";
                            size: 24px;
                            enabled: root.pattern-count < 256;
                            clicked => { root.add-pattern-clicked(); }
                        }

                        ToolbarRule {}

                        // Tool modes. The glyph row is the answer to "what
                        // will my next drag across the grid do".
                        ToolModeButton {
                            icon: ToolIcons.select; name: "Select";
                            hint: "Click toggles a step. Ctrl-drag sets velocity.";
                            active: root.tool-mode == 0;
                            clicked => { root.tool-mode = 0; }
                        }
                        ToolModeButton {
                            icon: ToolIcons.paint; name: "Paint";
                            hint: "Drag to fill steps. Right-drag to clear.";
                            active: root.tool-mode == 1;
                            clicked => { root.tool-mode = 1; }
                        }
                        ToolModeButton {
                            icon: ToolIcons.slice; name: "Slice";
                            hint: "Click a step to ratchet it into even hits.";
                            active: root.tool-mode == 2;
                            clicked => { root.tool-mode = 2; }
                        }
                        ToolModeButton {
                            icon: ToolIcons.stretch; name: "Stretch";
                            hint: "Drag a step sideways to set its length.";
                            active: root.tool-mode == 3;
                            clicked => { root.tool-mode = 3; }
                        }
                        if root.tool-mode == 2 : StepperField {
                            label: "×";
                            value <=> root.slice-divisions;
                            minimum: 2;
                            maximum: 4;
                            tooltip: "Hits per sliced step";
                            value-width: 18px;
                        }

                        ToolbarRule {}

                        StepperField {
                            label: "STEPS";
                            value <=> root.pattern-length;
                            minimum: 1;
                            maximum: 256;
                            tooltip: "Length of the selected pattern in 16th-note steps";
                            changed(v) => { root.pattern-length-changed(v); }
                        }
                        MenuField {
                            label: "SNAP";
                            options: root.musical-snap-options;
                            selected-index <=> root.musical-snap-index;
                            field-width: 46px;
                            menu-width: 120px;
                            tooltip: "Grid resolution for editing";
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ===== Channel rack: one step-grid row per channel =====
        ScrollView {
            vertical-stretch: 1;
            viewport-width: max(self.visible-width, 300px + root.pattern-length * 27px);
            viewport-height: max(self.visible-height, root.channels.length * 32px + 48px);

            VerticalBox {
                spacing: 2px;
                padding: 8px;

                for row[ch] in root.channels : HorizontalBox {
                    padding: 2px;
                    spacing: 6px;
                    alignment: start;

                    // Channel name selects the channel for the bottom editor.
                    Rectangle {
                        width: 88px;
                        min-height: 24px;
                        border-radius: 3px;
                        background: row.selected ? Theme.surface-active : Theme.surface;
                        Text {
                            text: row.name;
                            color: row.selected ? Theme.text : Theme.text-muted;
                            font-size: 11px;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            x: 6px;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.channel-selected(ch); }
                        }
                    }

                    MuteButton {
                        muted: row.muted;
                        clicked => { root.channel-muted(ch); }
                    }

                    // Volume and pan are knobs here, not faders: the rack row
                    // is for steps, and a pair of 22px knobs costs a fifth of
                    // the width a labelled fader did. Names and values live in
                    // the tooltips.
                    MiniKnob {
                        label: "Volume";
                        value: row.volume;
                        default-value: 0.8;
                        value-text: round(row.volume * 100) + "%";
                        changed(v) => { root.channel-volume-changed(ch, v); }
                    }

                    MiniKnob {
                        label: "Pan";
                        value: row.pan;
                        minimum: -1;
                        maximum: 1;
                        default-value: 0;
                        bipolar: true;
                        value-text: abs(row.pan) < 0.01 ? "Center"
                            : row.pan < 0 ? "L " + round(abs(row.pan) * 100)
                            : "R " + round(row.pan * 100);
                        changed(v) => { root.channel-pan-changed(ch, v); }
                    }

                    // Beat grouping remains visible at any pattern length.
                    //
                    // One hit area covers the whole run of steps and derives
                    // the cell from mouse-x. Per-cell TouchAreas cannot support
                    // a drag: the cell where the press landed keeps the grab,
                    // so the pointer never reaches its neighbours.
                    Rectangle {
                        property <length> cell-pitch: 27px;
                        property <int> step-count: row.steps.length;
                        width: self.step-count * self.cell-pitch - 3px;
                        height: 24px;

                        pure function step-at(x: length) -> int {
                            return clamp(floor(x / self.cell-pitch), 0, self.step-count - 1);
                        }

                        HorizontalLayout {
                            spacing: 3px;
                            for cell[i] in row.steps : Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 2px;
                                clip: true;
                                border-width: root.playing && root.current-step == i ? 1px : 0px;
                                border-color: Theme.text;
                                background: mod(i, 4) == 0 ? Theme.surface-active : Theme.surface-raised;
                                for sub in 4 : Rectangle {
                                    property <int> divisor: sub == 0 ? 1 : sub == 1 ? 2 : sub == 2 ? 4 : 8;
                                    property <bool> onset: mod(floor(cell.onsets / self.divisor), 2) == 1;
                                    visible: mod(floor(cell.substeps / self.divisor), 2) == 1;
                                    x: sub * parent.width / 4;
                                    y: parent.height - self.height;
                                    width: parent.width / 4;
                                    height: max(3px, parent.height * cell.velocity / 127);
                                    border-radius: 0px;
                                    background: Theme.accent;
                                    // A struck slot is solid; one that is only
                                    // being held stays dim, so a ratchet reads
                                    // differently from a single sustained note.
                                    opacity: (self.onset ? 1.0 : 0.3)
                                        * (0.55 + 0.45 * cell.velocity / 127);
                                }
                            }
                        }

                        grid-touch := TouchArea {
                            // -1 means "no drag in progress"; it is not a step.
                            property <int> last-step: -1;
                            property <int> stretch-origin: -1;
                            property <bool> paint-on;
                            property <bool> velocity-drag;
                            // TouchArea.pressed only tracks the left button, so
                            // a right-drag would report its first cell and then
                            // go silent. Track the held button ourselves; this
                            // also stops hover moves from painting.
                            property <int> drag-button: -1;
                            mouse-cursor: root.tool-mode == 1 ? crosshair
                                : root.tool-mode == 3 ? ew-resize : pointer;

                            function paint-to(step: int) {
                                if (step != self.last-step) {
                                    self.last-step = step;
                                    root.step-painted(ch, step, self.paint-on);
                                }
                            }

                            pointer-event(e) => {
                                let step = parent.step-at(self.mouse-x);
                                if (e.kind == PointerEventKind.down) {
                                    self.drag-button =
                                        e.button == PointerEventButton.right ? 1 : 0;
                                    if (root.tool-mode == 1) {
                                        // Left fills, right clears, for the
                                        // whole drag. Toggling per cell would
                                        // invert whatever it crossed.
                                        self.paint-on = e.button == PointerEventButton.left;
                                        self.last-step = -1;
                                        self.paint-to(step);
                                    } else if (root.tool-mode == 2) {
                                        if (e.button == PointerEventButton.right) {
                                            root.step-removed(ch, step);
                                        } else {
                                            root.step-sliced(ch, step, root.slice-divisions);
                                        }
                                    } else if (root.tool-mode == 3) {
                                        if (e.button == PointerEventButton.right) {
                                            root.step-length-dragged(ch, step, 1);
                                        } else {
                                            self.stretch-origin = step;
                                            root.step-length-dragged(ch, step, 1);
                                        }
                                    } else if (e.button == PointerEventButton.right) {
                                        root.step-removed(ch, step);
                                    } else {
                                        self.velocity-drag = e.modifiers.control;
                                        if (self.velocity-drag) {
                                            root.step-velocity-edited(ch, step,
                                                clamp(1 - self.mouse-y / self.height, 0, 1));
                                        } else {
                                            root.step-clicked(ch, step);
                                        }
                                    }
                                } else if (e.kind == PointerEventKind.move && self.drag-button >= 0) {
                                    if (root.tool-mode == 1) {
                                        self.paint-to(step);
                                    } else if (root.tool-mode == 3 && self.stretch-origin >= 0) {
                                        root.step-length-dragged(ch, self.stretch-origin,
                                            max(1, step - self.stretch-origin + 1));
                                    } else if (self.velocity-drag) {
                                        root.step-velocity-edited(ch, step,
                                            clamp(1 - self.mouse-y / self.height, 0, 1));
                                    }
                                } else if (e.kind == PointerEventKind.up) {
                                    self.drag-button = -1;
                                    self.velocity-drag = false;
                                    self.last-step = -1;
                                    self.stretch-origin = -1;
                                }
                            }
                            // @markdown takes a literal, so the per-tool hint
                            // is resolved into a property first.
                            property <string> hint: root.tool-mode == 1
                                ? "**Paint** Drag to fill. Right-drag to clear."
                                : root.tool-mode == 2
                                ? "**Slice** Click to ratchet into \{root.slice-divisions} hits. Right-click clears."
                                : root.tool-mode == 3
                                ? "**Stretch** Drag right to lengthen. Right-click resets."
                                : "Click to toggle. **Ctrl-drag** velocity. **Right-click** to clear.";
                            Tooltip { text: @markdown("\{parent.hint}"); }
                        }
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 4px;
                    alignment: start;
                    FlatButton {
                        text: "+";
                        tooltip: "Add sound source";
                        min-width: 28px;
                        clicked => { add-source-menu.show(); }
                    }
                    FlatButton {
                        text: "−";
                        tooltip: "Remove last channel";
                        min-width: 28px;
                        clicked => { root.remove-channel-clicked(); }
                    }
                }

                add-source-menu := PopupWindow {
                    x: 8px;
                    y: 8px;
                    width: 156px;
                    height: 82px;
                    close-policy: close-on-click;
                    Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 3px;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 1px;
                            ToolButton { text: "Add Sampler"; tooltip: "Add a sampler channel"; clicked => { add-source-menu.close(); root.add-channel-clicked(0); } }
                            ToolButton { text: "Add Drum Synth"; tooltip: "Add a drum synth channel"; clicked => { add-source-menu.close(); root.add-channel-clicked(1); } }
                            ToolButton { text: "Add Mono Synth"; tooltip: "Add a mono synth channel"; clicked => { add-source-menu.close(); root.add-channel-clicked(2); } }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ===== Bottom dock: sampler and note editors =====
        Rectangle {
            height: 410px;
            background: Theme.panel;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 30px;
                    background: Theme.surface;
                    HorizontalBox {
                        padding: 3px;
                        spacing: 3px;
                        alignment: start;
                        FlatButton {
                            text: "Source";
                            tooltip: "Sound source controls";
                            active: root.editor-page == 0;
                            clicked => { root.editor-page = 0; }
                        }
                        FlatButton {
                            text: "Notes";
                            tooltip: "Piano roll and note parameters";
                            active: root.editor-page == 1;
                            clicked => { root.editor-page = 1; }
                        }
                        FlatButton {
                            text: "Playlist";
                            tooltip: "Song arrangement";
                            active: root.editor-page == 2;
                            clicked => { root.editor-page = 2; }
                        }
                        Rectangle { width: 8px; }
                        Text {
                            text: root.editor-page == 2 ? "SONG ARRANGEMENT" : root.selected-channel-name;
                            color: Theme.text-muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                if root.editor-page == 2 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalBox {
                                padding: 4px;
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: "SNAP";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: root.musical-snap-options;
                                    current-index <=> root.musical-snap-index;
                                    width: 92px;
                                    height: 24px;
                                    Tooltip { text: @markdown("Musical placement grid shared with the piano roll"); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "↔"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom timeline out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.playlist-bar-width > 12px;
                                    clicked => { root.playlist-bar-width = max(12px, root.playlist-bar-width - 4px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom timeline in";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.playlist-bar-width < 96px;
                                    clicked => { root.playlist-bar-width = min(96px, root.playlist-bar-width + 4px); }
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: max(self.visible-width,
                                104px + root.playlist-bars * root.playlist-bar-width);
                            viewport-height: max(self.visible-height,
                                30px + root.pattern-count * 28px);

                            playlist-canvas := Rectangle {
                                width: 104px + root.playlist-bars * root.playlist-bar-width;
                                height: max(346px, 30px + root.pattern-count * 28px);

                                Text {
                                    x: 8px; y: 5px;
                                    width: 88px; height: 18px;
                                    text: "PATTERN";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    x: 104px; y: 0px;
                                    width: root.playlist-bars * root.playlist-bar-width;
                                    height: 28px;
                                    background: Theme.surface;
                                    for bar in root.playlist-bars : Rectangle {
                                        x: bar * root.playlist-bar-width;
                                        width: root.playlist-bar-width;
                                        height: parent.height;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        Text {
                                            text: bar + 1;
                                            color: Theme.text-faint;
                                            font-size: 8px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                for pattern in root.pattern-count : Rectangle {
                                    x: 0px;
                                    y: 30px + pattern * 28px;
                                    width: playlist-canvas.width;
                                    height: 26px;

                                    Rectangle {
                                        x: 8px;
                                        width: 88px;
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: root.current-pattern == pattern
                                            ? Theme.surface-active : Theme.surface;
                                        Text {
                                            x: 6px;
                                            text: "Pattern " + (pattern + 1);
                                            color: root.current-pattern == pattern
                                                ? Theme.text : Theme.text-muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.pattern-selected(pattern); }
                                        }
                                    }

                                    timeline := Rectangle {
                                        x: 104px;
                                        width: root.playlist-bars * root.playlist-bar-width;
                                        height: parent.height;
                                        background: Theme.background;

                                        for bar in root.playlist-bars : Rectangle {
                                            x: bar * root.playlist-bar-width;
                                            width: root.playlist-bar-width;
                                            height: parent.height;
                                            background: mod(bar, 4) == 0
                                                ? Theme.surface : Theme.background;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            for division in root.playlist-bar-ticks / root.musical-snap-ticks : Rectangle {
                                                visible: division > 0;
                                                x: division * parent.width
                                                    / (root.playlist-bar-ticks / root.musical-snap-ticks);
                                                width: 1px;
                                                height: parent.height;
                                                background: Theme.border;
                                                opacity: 0.48;
                                            }
                                        }

                                        for clip in root.playlist-clips : Rectangle {
                                            visible: clip.pattern == pattern;
                                            property <int> clip-end-tick:
                                                clip.start-tick + clip.length-steps * 24;
                                            x: clip.start-tick * root.playlist-bar-width
                                                / root.playlist-bar-ticks;
                                            y: 2px;
                                            width: max(4px,
                                                clip.length-steps * root.playlist-bar-width / 16);
                                            height: parent.height - 4px;
                                            border-radius: 2px;
                                            border-width: root.playing && root.song-mode
                                                && root.playlist-position-ticks >= clip.start-tick
                                                && root.playlist-position-ticks < self.clip-end-tick ? 1px : 0px;
                                            border-color: Theme.text;
                                            background: Theme.accent;
                                            opacity: root.current-pattern == pattern ? 1 : 0.62;
                                            Text {
                                                text: pattern + 1;
                                                color: Theme.background;
                                                font-size: 9px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        if root.playing && root.song-mode : Rectangle {
                                            x: root.playlist-position-ticks * root.playlist-bar-width
                                                / root.playlist-bar-ticks;
                                            width: 1px;
                                            height: parent.height;
                                            background: Theme.text;
                                        }

                                        Rectangle {
                                            x: root.playlist-song-length-ticks * root.playlist-bar-width
                                                / root.playlist-bar-ticks - 1px;
                                            width: 1px;
                                            height: parent.height;
                                            background: Theme.text-faint;
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    let raw-tick = clamp(floor(self.mouse-x
                                                        * root.playlist-bar-ticks / root.playlist-bar-width),
                                                        0, root.playlist-bars * root.playlist-bar-ticks - 1);
                                                    if (e.button == PointerEventButton.right) {
                                                        root.playlist-placement-removed(pattern, raw-tick);
                                                    } else if (e.button == PointerEventButton.left) {
                                                        root.playlist-placement-added(pattern,
                                                            floor(raw-tick / root.musical-snap-ticks)
                                                                * root.musical-snap-ticks);
                                                    }
                                                }
                                            }
                                            Tooltip {
                                                text: @markdown("Click to place on the musical grid. **Right-click** a clip to remove it.");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.editor-page == 0 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 36px;
                            background: Theme.surface-raised;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 8px;
                                Text { text: "SOURCE"; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                                SegmentedControl {
                                    width: 252px;
                                    options: ["Sampler", "Drum", "Mono"];
                                    selected-index <=> root.source-kind;
                                    selected(i) => { root.channel-source-changed(i); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        if root.source-kind == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 0px;
                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 3px;
                                FlatButton {
                                    text: "‹";
                                    tooltip: "Previous WAV in this folder";
                                    enabled: root.can-previous-sample;
                                    min-width: 28px; max-width: 28px;
                                    clicked => { root.previous-sample-clicked(); }
                                }
                                FlatButton {
                                    text: "⌕";
                                    tooltip: "Choose a WAV file";
                                    min-width: 28px; max-width: 28px;
                                    clicked => { root.load-sample-clicked(); }
                                }
                                FlatButton {
                                    text: "›";
                                    tooltip: "Next WAV in this folder";
                                    enabled: root.can-next-sample;
                                    min-width: 28px; max-width: 28px;
                                    clicked => { root.next-sample-clicked(); }
                                }
                                Rectangle { width: 5px; }
                                VerticalLayout {
                                    min-width: 180px;
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text {
                                        text: root.sample-name;
                                        color: Theme.text;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.sample-description;
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        overflow: elide;
                                    }
                                }
                                Text { text: "ROOT"; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
                                SpinBox {
                                    value <=> root.root-note;
                                    minimum: 0; maximum: 127; step-size: 1;
                                    width: 62px; height: 24px;
                                    edited(value) => { root.root-note-changed(value); }
                                    Tooltip { text: @markdown("MIDI root note for original sample pitch"); }
                                }
                                FlatButton {
                                    text: "↤";
                                    tooltip: "Reverse playback";
                                    active: root.reverse-playback;
                                    min-width: 30px; max-width: 30px;
                                    clicked => {
                                        root.reverse-playback = !root.reverse-playback;
                                        root.reverse-playback-changed(root.reverse-playback);
                                    }
                                }
                                Rectangle { width: 6px; }
                                Text { text: "LOOP"; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
                                FlatButton {
                                    text: "—"; tooltip: "Loop off"; active: root.loop-mode == 0;
                                    min-width: 30px; max-width: 30px;
                                    clicked => { root.loop-mode = 0; root.loop-mode-changed(0); }
                                }
                                FlatButton {
                                    text: "↻"; tooltip: "Forward loop"; active: root.loop-mode == 1;
                                    min-width: 30px; max-width: 30px;
                                    clicked => { root.loop-mode = 1; root.loop-mode-changed(1); }
                                }
                                FlatButton {
                                    text: "↔"; tooltip: "Ping-pong loop"; active: root.loop-mode == 2;
                                    min-width: 30px; max-width: 30px;
                                    clicked => { root.loop-mode = 2; root.loop-mode-changed(2); }
                                }
                            }
                        }

                        waveform-view := Rectangle {
                            vertical-stretch: 1;
                            min-height: 130px;
                            background: Theme.surface;
                            clip: true;

                            // Shade audio outside the selected playback region.
                            Rectangle {
                                width: clamp(root.start-pos, 0, 1) * parent.width;
                                height: parent.height;
                                background: Theme.background;
                                opacity: 0.68;
                            }
                            Rectangle {
                                x: clamp(root.end-pos, 0, 1) * parent.width;
                                width: parent.width - self.x;
                                height: parent.height;
                                background: Theme.background;
                                opacity: 0.68;
                            }
                            if root.loop-mode != 0 : Rectangle {
                                x: clamp(root.loop-start, root.start-pos, root.end-pos) * parent.width;
                                width: max(1px, (clamp(root.loop-end, root.start-pos, root.end-pos)
                                    - clamp(root.loop-start, root.start-pos, root.end-pos)) * parent.width);
                                height: parent.height;
                                background: Theme.accent-active;
                                opacity: 0.32;
                            }

                            for tick in 9 : Rectangle {
                                x: tick * parent.width / 8;
                                width: 1px;
                                height: parent.height;
                                background: Theme.border;
                                opacity: mod(tick, 2) == 0 ? 0.8 : 0.35;
                            }
                            for tick in 9 : Text {
                                visible: mod(tick, 2) == 0;
                                x: clamp(tick * parent.width / 8 - 22px, 3px, parent.width - 47px);
                                y: 3px;
                                width: 44px;
                                text: round(root.sample-duration * tick / 8 * 1000) / 1000 + "s";
                                color: Theme.text-faint;
                                font-size: 8px;
                                horizontal-alignment: center;
                            }
                            Rectangle {
                                y: parent.height / 2;
                                width: parent.width;
                                height: 1px;
                                background: Theme.border;
                            }
                            for amplitude[index] in root.waveform : Rectangle {
                                x: index * parent.width / max(1, root.waveform.length);
                                y: (parent.height - self.height) / 2;
                                width: max(1px, parent.width / max(1, root.waveform.length));
                                height: max(1px, amplitude * (parent.height - 22px));
                                background: Theme.text-muted;
                            }

                            WaveformMarker {
                                x: clamp(root.start-pos, 0, 1) * (parent.width - 1px);
                                height: parent.height; editor-width: parent.width;
                                marker-label: "S"; marker-color: Theme.accent;
                                moved(v) => {
                                    root.start-pos = min(v, root.end-pos - 0.001);
                                    root.start-pos-changed(root.start-pos);
                                    if (root.loop-start < root.start-pos) {
                                        root.loop-start = root.start-pos;
                                        root.loop-start-changed(root.loop-start);
                                    }
                                    if (root.loop-end < root.loop-start + 0.001) {
                                        root.loop-end = min(root.end-pos, root.loop-start + 0.001);
                                        root.loop-end-changed(root.loop-end);
                                    }
                                }
                            }
                            WaveformMarker {
                                x: clamp(root.end-pos, 0, 1) * (parent.width - 1px);
                                height: parent.height; editor-width: parent.width;
                                marker-label: "E"; marker-color: Theme.accent; label-at-bottom: true;
                                moved(v) => {
                                    root.end-pos = max(v, root.start-pos + 0.001);
                                    root.end-pos-changed(root.end-pos);
                                    if (root.loop-end > root.end-pos) {
                                        root.loop-end = root.end-pos;
                                        root.loop-end-changed(root.loop-end);
                                    }
                                    if (root.loop-start > root.loop-end - 0.001) {
                                        root.loop-start = max(root.start-pos, root.loop-end - 0.001);
                                        root.loop-start-changed(root.loop-start);
                                    }
                                }
                            }
                            WaveformMarker {
                                x: clamp(root.loop-start, 0, 1) * (parent.width - 1px);
                                height: parent.height; editor-width: parent.width;
                                marker-label: "L"; marker-color: root.loop-mode == 0 ? Theme.text-faint : Theme.warning;
                                label-at-bottom: true;
                                moved(v) => {
                                    root.loop-start = clamp(v, root.start-pos, root.loop-end - 0.001);
                                    root.loop-start-changed(root.loop-start);
                                }
                            }
                            WaveformMarker {
                                x: clamp(root.loop-end, 0, 1) * (parent.width - 1px);
                                height: parent.height; editor-width: parent.width;
                                marker-label: "R"; marker-color: root.loop-mode == 0 ? Theme.text-faint : Theme.warning;
                                moved(v) => {
                                    root.loop-end = clamp(v, root.loop-start + 0.001, root.end-pos);
                                    root.loop-end-changed(root.loop-end);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        Rectangle {
                            height: 168px;
                            background: Theme.panel;
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 3px;
                                alignment: start;

                                VerticalLayout {
                                    width: 116px; spacing: 3px;
                                    SectionLabel { text: "TUNE"; }
                                    HorizontalLayout {
                                        spacing: 0px;
                                        ParameterKnob {
                                            label: "Coarse"; tooltip: "Coarse tuning in semitones";
                                            value <=> root.tune-semitones;
                                            minimum: -24; maximum: 24; default-value: 0; step: 1;
                                            value-text: (root.tune-semitones > 0 ? "+" : "") + round(root.tune-semitones) + " st";
                                            changed(v) => { root.tune-semitones-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Fine"; tooltip: "Fine tuning in cents";
                                            value <=> root.tune-cents;
                                            minimum: -100; maximum: 100; default-value: 0; step: 1;
                                            value-text: (root.tune-cents > 0 ? "+" : "") + round(root.tune-cents) + " ct";
                                            changed(v) => { root.tune-cents-changed(v); }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; height: 142px; background: Theme.border; }

                                VerticalLayout {
                                    width: 180px; spacing: 5px;
                                    SectionLabel { text: "VOICE"; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "MODE"; color: Theme.text-faint; font-size: 8px; }
                                            ComboBox {
                                                model: ["One Shot", "Gate"];
                                                current-index <=> root.voice-mode;
                                                width: 105px; height: 24px;
                                                selected(value) => { root.voice-mode-changed(self.current-index); }
                                                Tooltip { text: @markdown("**One Shot** plays the region or exits a loop into its tail. **Gate** follows note length and envelope release."); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "VOICES"; color: Theme.text-faint; font-size: 8px; }
                                            SpinBox {
                                                value <=> root.sampler-polyphony;
                                                minimum: 1; maximum: 16; step-size: 1;
                                                width: 62px; height: 24px;
                                                edited(value) => { root.sampler-polyphony-changed(value); }
                                                Tooltip { text: @markdown("Maximum simultaneous sample voices"); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "RETRIGGER"; color: Theme.text-faint; font-size: 8px; }
                                            ComboBox {
                                                model: ["Restart", "Layer"];
                                                current-index <=> root.retrigger-mode;
                                                width: 105px; height: 24px;
                                                selected(value) => { root.retrigger-mode-changed(self.current-index); }
                                                Tooltip { text: @markdown("**Restart** replaces a matching pitch. **Layer** stacks repeated notes."); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "CHOKE"; color: Theme.text-faint; font-size: 8px; }
                                            SpinBox {
                                                value <=> root.choke-group;
                                                minimum: 0; maximum: 16; step-size: 1;
                                                width: 62px; height: 24px;
                                                edited(value) => { root.choke-group-changed(value); }
                                                Tooltip { text: @markdown("Matching non-zero groups choke each other. **0** is off."); }
                                            }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; height: 142px; background: Theme.border; }

                                VerticalLayout {
                                    width: 230px; spacing: 3px;
                                    SectionLabel { text: "FILTER"; }
                                    HorizontalLayout {
                                        spacing: 1px;
                                        ParameterKnob {
                                            label: "Cutoff"; tooltip: "Low-pass filter cutoff";
                                            value <=> root.filter-cutoff; default-value: 1;
                                            value-text: root.filter-cutoff >= 0.999 ? "Open"
                                                : round(20 * pow(root.audio-sample-rate * 0.45 / 20,
                                                    root.filter-cutoff)) + " Hz";
                                            changed(v) => { root.filter-cutoff-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Reso"; tooltip: "Filter resonance";
                                            value <=> root.filter-resonance; default-value: 0;
                                            value-text: round(root.filter-resonance * 100) + "%";
                                            changed(v) => { root.filter-resonance-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Env"; tooltip: "Bipolar amplitude-envelope modulation of cutoff";
                                            value <=> root.filter-env; default-value: 0.5; fill: Theme.warning;
                                            value-text: (round((root.filter-env * 2 - 1) * 100) > 0 ? "+" : "")
                                                + round((root.filter-env * 2 - 1) * 100) + "%";
                                            changed(v) => { root.filter-env-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Drive"; tooltip: "Pre-filter soft saturation";
                                            value <=> root.sampler-drive; default-value: 0; fill: Theme.warning;
                                            value-text: round(root.sampler-drive * 100) + "%";
                                            changed(v) => { root.sampler-drive-changed(v); }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; height: 142px; background: Theme.border; }

                                VerticalLayout {
                                    width: 230px; spacing: 3px;
                                    SectionLabel { text: "AMP ENVELOPE"; }
                                    // The graph and the knobs edit the same
                                    // properties: drag the shape to find it,
                                    // use a knob when a number matters.
                                    EnvelopeEditor {
                                        height: 56px;
                                        attack <=> root.attack;
                                        decay <=> root.decay;
                                        sustain <=> root.sustain;
                                        release <=> root.release;
                                        attack-text: round(root.attack * 5000) + " ms";
                                        decay-text: round(root.decay * 5000) + " ms";
                                        sustain-text: round(root.sustain * 100) + "%";
                                        release-text: round(root.release * 5000) + " ms";
                                        attack-changed(v) => { root.attack-changed(v); }
                                        decay-changed(v) => { root.decay-changed(v); }
                                        sustain-changed(v) => { root.sustain-changed(v); }
                                        release-changed(v) => { root.release-changed(v); }
                                    }
                                    HorizontalLayout {
                                        spacing: 1px;
                                        ParameterKnob {
                                            label: "Attack"; tooltip: "Amplitude attack";
                                            value <=> root.attack; default-value: 0;
                                            value-text: round(root.attack * 5000) + " ms";
                                            changed(v) => { root.attack-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Decay"; tooltip: "Amplitude decay";
                                            value <=> root.decay; default-value: 0.05;
                                            value-text: round(root.decay * 5000) + " ms";
                                            changed(v) => { root.decay-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Sustain"; tooltip: "Amplitude sustain level";
                                            value <=> root.sustain; default-value: 1;
                                            value-text: round(root.sustain * 100) + "%";
                                            changed(v) => { root.sustain-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Release"; tooltip: "Amplitude release";
                                            value <=> root.release; default-value: 0.01;
                                            value-text: round(root.release * 5000) + " ms";
                                            changed(v) => { root.release-changed(v); }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; height: 142px; background: Theme.border; }

                                VerticalLayout {
                                    width: 116px; spacing: 3px;
                                    SectionLabel { text: "LO-FI"; }
                                    HorizontalLayout {
                                        spacing: 0px;
                                        ParameterKnob {
                                            label: "Bits"; tooltip: "Bit-depth reduction";
                                            value <=> root.bit-reduction; default-value: 0; fill: Theme.warning;
                                            value-text: round(16 - root.bit-reduction * 12) + " bit";
                                            changed(v) => { root.bit-reduction-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Rate"; tooltip: "Sample-rate reduction";
                                            value <=> root.rate-reduction; default-value: 0; fill: Theme.warning;
                                            value-text: "÷" + round(1 + root.rate-reduction * 31);
                                            changed(v) => { root.rate-reduction-changed(v); }
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        }

                        if root.source-kind == 1 : DrumSourceEditor {
                            vertical-stretch: 1;
                            mode <=> root.drum-mode;
                            decay <=> root.drum-decay;
                            tune-semitones <=> root.drum-tune-semitones;
                            drive <=> root.drum-drive;
                            choke-group <=> root.drum-choke-group;
                            kick-start-hz <=> root.drum-kick-start-hz;
                            kick-end-hz <=> root.drum-kick-end-hz;
                            kick-sweep <=> root.drum-kick-sweep;
                            kick-click <=> root.drum-kick-click;
                            snare-tone-hz <=> root.drum-snare-tone-hz;
                            snare-noise-mix <=> root.drum-snare-noise-mix;
                            snare-noise-decay <=> root.drum-snare-noise-decay;
                            hat-hp-hz <=> root.drum-hat-hp-hz;
                            hat-metallic <=> root.drum-hat-metallic;
                            mode-changed(v) => { root.drum-mode-changed(v); }
                            decay-changed(v) => { root.drum-decay-changed(v); }
                            tune-semitones-changed(v) => { root.drum-tune-semitones-changed(v); }
                            drive-changed(v) => { root.drum-drive-changed(v); }
                            choke-group-changed(v) => { root.drum-choke-group-changed(v); }
                            kick-start-hz-changed(v) => { root.drum-kick-start-hz-changed(v); }
                            kick-end-hz-changed(v) => { root.drum-kick-end-hz-changed(v); }
                            kick-sweep-changed(v) => { root.drum-kick-sweep-changed(v); }
                            kick-click-changed(v) => { root.drum-kick-click-changed(v); }
                            snare-tone-hz-changed(v) => { root.drum-snare-tone-hz-changed(v); }
                            snare-noise-mix-changed(v) => { root.drum-snare-noise-mix-changed(v); }
                            snare-noise-decay-changed(v) => { root.drum-snare-noise-decay-changed(v); }
                            hat-hp-hz-changed(v) => { root.drum-hat-hp-hz-changed(v); }
                            hat-metallic-changed(v) => { root.drum-hat-metallic-changed(v); }
                        }

                        if root.source-kind == 2 : MonoSourceEditor {
                            vertical-stretch: 1;
                            osc1-wave <=> root.mono-osc1-wave; osc1-semitones <=> root.mono-osc1-semitones; osc1-cents <=> root.mono-osc1-cents; osc1-level <=> root.mono-osc1-level; osc1-pulse-width <=> root.mono-osc1-pulse-width;
                            osc2-wave <=> root.mono-osc2-wave; osc2-semitones <=> root.mono-osc2-semitones; osc2-cents <=> root.mono-osc2-cents; osc2-level <=> root.mono-osc2-level; osc2-pulse-width <=> root.mono-osc2-pulse-width;
                            osc3-wave <=> root.mono-osc3-wave; osc3-semitones <=> root.mono-osc3-semitones; osc3-cents <=> root.mono-osc3-cents; osc3-level <=> root.mono-osc3-level; osc3-pulse-width <=> root.mono-osc3-pulse-width;
                            glide <=> root.mono-glide; attack <=> root.mono-attack; decay <=> root.mono-decay; sustain <=> root.mono-sustain; release <=> root.mono-release;
                            filter-cutoff <=> root.mono-filter-cutoff; filter-resonance <=> root.mono-filter-resonance; filter-env <=> root.mono-filter-env; drive <=> root.mono-drive;
                            osc1-wave-changed(v) => { root.mono-osc1-wave-changed(v); } osc1-semitones-changed(v) => { root.mono-osc1-semitones-changed(v); } osc1-cents-changed(v) => { root.mono-osc1-cents-changed(v); } osc1-level-changed(v) => { root.mono-osc1-level-changed(v); } osc1-pulse-width-changed(v) => { root.mono-osc1-pulse-width-changed(v); }
                            osc2-wave-changed(v) => { root.mono-osc2-wave-changed(v); } osc2-semitones-changed(v) => { root.mono-osc2-semitones-changed(v); } osc2-cents-changed(v) => { root.mono-osc2-cents-changed(v); } osc2-level-changed(v) => { root.mono-osc2-level-changed(v); } osc2-pulse-width-changed(v) => { root.mono-osc2-pulse-width-changed(v); }
                            osc3-wave-changed(v) => { root.mono-osc3-wave-changed(v); } osc3-semitones-changed(v) => { root.mono-osc3-semitones-changed(v); } osc3-cents-changed(v) => { root.mono-osc3-cents-changed(v); } osc3-level-changed(v) => { root.mono-osc3-level-changed(v); } osc3-pulse-width-changed(v) => { root.mono-osc3-pulse-width-changed(v); }
                            glide-changed(v) => { root.mono-glide-changed(v); } attack-changed(v) => { root.mono-attack-changed(v); } decay-changed(v) => { root.mono-decay-changed(v); } sustain-changed(v) => { root.mono-sustain-changed(v); } release-changed(v) => { root.mono-release-changed(v); }
                            filter-cutoff-changed(v) => { root.mono-filter-cutoff-changed(v); } filter-resonance-changed(v) => { root.mono-filter-resonance-changed(v); } filter-env-changed(v) => { root.mono-filter-env-changed(v); } drive-changed(v) => { root.mono-drive-changed(v); }
                        }
                    }
                }

                if root.editor-page == 1 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalBox {
                                padding: 4px;
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: root.has-selected-note ? "TICK " + root.selected-note-step : "NO NOTE";
                                    color: Theme.text-muted;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "NOTE";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-note;
                                    minimum: root.piano-low-note;
                                    maximum: root.piano-high-note;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-note-changed(value); }
                                    Tooltip { text: @markdown("Selected step MIDI note"); }
                                }
                                Text {
                                    text: "VEL";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-velocity;
                                    minimum: 1;
                                    maximum: 127;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-velocity-changed(value); }
                                    Tooltip { text: @markdown("Selected step velocity"); }
                                }
                                Text {
                                    text: "LEN";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-duration-ticks;
                                    minimum: 1;
                                    maximum: max(1, root.pattern-length * 24);
                                    step-size: root.musical-snap-ticks;
                                    width: 78px;
                                    height: 24px;
                                    edited(value) => { root.selected-duration-changed(value); }
                                    Tooltip { text: @markdown("Selected note length in PPQ ticks. **6** ticks = 1/64 note."); }
                                }
                                Rectangle { width: 8px; }
                                ComboBox {
                                    model: ["Velocity"];
                                    current-index: 0;
                                    current-value: "Velocity";
                                    width: 120px;
                                    height: 24px;
                                    Tooltip { text: @markdown("Parameter lane"); }
                                }
                                Text {
                                    text: "SNAP";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: root.musical-snap-options;
                                    current-index <=> root.musical-snap-index;
                                    width: 84px;
                                    height: 24px;
                                    Tooltip { text: @markdown("Musical grid shared with the playlist"); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "↔"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom time out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-step-width > 20px;
                                    clicked => { root.piano-step-width = max(20px, root.piano-step-width - 4px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom time in";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-step-width < 72px;
                                    clicked => { root.piano-step-width = min(72px, root.piano-step-width + 4px); }
                                }
                                Text { text: "↕"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom pitch out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-row-height > 5px;
                                    clicked => { root.piano-row-height = max(5px, root.piano-row-height - 1px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom pitch in";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-row-height < 16px;
                                    clicked => { root.piano-row-height = min(16px, root.piano-row-height + 1px); }
                                }
                            }
                        }

                        HorizontalLayout {
                            vertical-stretch: 1;

                            Rectangle {
                                width: 46px;
                                background: Theme.panel;
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        vertical-stretch: 1;
                                        clip: true;
                                        Rectangle {
                                            y: -piano-scroll.viewport-y;
                                            width: parent.width;
                                            height: 49 * root.piano-row-height;
                                            for key in 49 : Rectangle {
                                                y: key * root.piano-row-height;
                                                height: root.piano-row-height;
                                                width: parent.width;
                                                property <int> note-number: root.piano-high-note - key;
                                                background: (mod(note-number, 12) == 1
                                                    || mod(note-number, 12) == 3
                                                    || mod(note-number, 12) == 6
                                                    || mod(note-number, 12) == 8
                                                    || mod(note-number, 12) == 10)
                                                    ? Theme.panel : Theme.surface;
                                                if mod(note-number, 12) == 0 : Text {
                                                    text: "C" + (floor(note-number / 12) - 1);
                                                    color: Theme.text-muted;
                                                    font-size: min(9px, root.piano-row-height - 1px);
                                                    vertical-alignment: center;
                                                    x: 3px;
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        height: 17px;
                                        text: "LANE";
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        height: 55px;
                                        text: "VEL";
                                        color: Theme.text-muted;
                                        font-size: 8px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 0px;
                                piano-scroll := ScrollView {
                                    vertical-stretch: 1;
                                    horizontal-stretch: 1;
                                    viewport-width: max(self.visible-width,
                                        root.pattern-length * root.piano-step-width);
                                    viewport-height: max(self.visible-height,
                                        49 * root.piano-row-height);
                                    Rectangle {
                                        x: 0px;
                                        width: root.pattern-length * root.piano-step-width;
                                        height: 49 * root.piano-row-height;
                                        background: Theme.surface;

                                        // Tick/note <-> pixel conversions and note
                                        // hit-testing, shared by the cursor and the
                                        // single hit area below. Kept as functions
                                        // (not per-note state) so a drag never reads
                                        // geometry that moved out from under it: see
                                        // piano-touch for why per-note TouchAreas
                                        // cannot support a drag at all.
                                        pure function note-x(start: int) -> length {
                                            return start * root.piano-step-width / 24;
                                        }
                                        pure function note-width(duration: int) -> length {
                                            return max(root.musical-snap-ticks * root.piano-step-width / 24,
                                                duration * root.piano-step-width / 24);
                                        }
                                        pure function tick-at(x: length) -> int {
                                            return floor(x * 24 / root.piano-step-width);
                                        }
                                        pure function note-at(y: length) -> int {
                                            return clamp(root.piano-high-note - floor(y / root.piano-row-height),
                                                root.piano-low-note, root.piano-high-note);
                                        }
                                        // 0 = empty grid, 1 = note body (move), 2 = right edge (resize).
                                        // The edge zone scales with the note so it stays
                                        // grabbable on a minimum-width note instead of the
                                        // fixed 5px that used to eat the whole note.
                                        pure function grab-mode-at(x: length, y: length) -> int {
                                            let hit = root.piano-note-hit-test(self.tick-at(x), self.note-at(y));
                                            if (!hit.found) {
                                                return 0;
                                            }
                                            let edge = clamp(self.note-width(hit.duration-ticks) / 4, 3px, 8px);
                                            return x >= self.note-x(hit.start-tick)
                                                    + self.note-width(hit.duration-ticks) - edge
                                                ? 2 : 1;
                                        }

                                        for key in 49 : Rectangle {
                                            y: key * root.piano-row-height;
                                            height: root.piano-row-height;
                                            width: parent.width;
                                            property <int> note-number: root.piano-high-note - key;
                                            background: (mod(note-number, 12) == 1
                                                || mod(note-number, 12) == 3
                                                || mod(note-number, 12) == 6
                                                || mod(note-number, 12) == 8
                                                || mod(note-number, 12) == 10)
                                                ? Theme.surface : Theme.surface-raised;
                                        }

                                        for division in root.pattern-length * 24 / root.musical-snap-ticks : Rectangle {
                                            x: division * root.musical-snap-ticks
                                                * root.piano-step-width / 24;
                                            width: 1px;
                                            height: parent.height;
                                            background: mod(division * root.musical-snap-ticks, 24) == 0
                                                ? Theme.text-faint : Theme.border;
                                            opacity: mod(division * root.musical-snap-ticks, 24) == 0
                                                ? 0.8 : 0.5;
                                        }

                                        for cell in root.notes : Rectangle {
                                            x: cell.start-tick * root.piano-step-width / 24;
                                            y: (root.piano-high-note - cell.note) * root.piano-row-height;
                                            width: max(root.musical-snap-ticks * root.piano-step-width / 24,
                                                cell.duration-ticks * root.piano-step-width / 24);
                                            height: root.piano-row-height;
                                            background: cell.selected ? Theme.focus : Theme.accent;
                                            opacity: 0.55 + 0.45 * cell.velocity / 127;
                                            border-width: cell.selected ? 1px : 0px;
                                            border-color: Theme.text;
                                        }

                                        // ONE hit area for the whole note grid, exactly
                                        // like the rack's grid-touch. A TouchArea living
                                        // inside a per-note Rectangle whose x/width is
                                        // bound to that note's own tick/duration moves out
                                        // from under the cursor as soon as the drag updates
                                        // the model, so mouse-x re-measures against the
                                        // moved rectangle and the delta collapses to zero
                                        // after one snap step. Hit-testing from here instead,
                                        // in this Rectangle's stable coordinates, means the
                                        // origin never moves during a drag.
                                        piano-touch := TouchArea {
                                            property <int> grabbed-id: -1;
                                            property <int> grab-mode: 0; // 0 none, 1 move, 2 resize
                                            property <length> origin-x;
                                            property <length> origin-y;
                                            property <int> original-start;
                                            property <int> original-note;
                                            property <int> original-duration;
                                            mouse-cursor: parent.grab-mode-at(self.mouse-x, self.mouse-y) == 2 ? ew-resize
                                                : parent.grab-mode-at(self.mouse-x, self.mouse-y) == 1 ? move
                                                : crosshair;

                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    let tick = parent.tick-at(self.mouse-x);
                                                    let note = parent.note-at(self.mouse-y);
                                                    let hit = root.piano-note-hit-test(tick, note);
                                                    if (hit.found && e.button == PointerEventButton.right) {
                                                        root.piano-note-removed(hit.id);
                                                    } else if (hit.found && e.button == PointerEventButton.left) {
                                                        root.piano-note-selected(hit.id);
                                                        self.grabbed-id = hit.id;
                                                        self.grab-mode = parent.grab-mode-at(self.mouse-x, self.mouse-y);
                                                        self.origin-x = self.mouse-x;
                                                        self.origin-y = self.mouse-y;
                                                        self.original-start = hit.start-tick;
                                                        self.original-note = note;
                                                        self.original-duration = hit.duration-ticks;
                                                    } else if (!hit.found && e.button == PointerEventButton.left) {
                                                        let start-tick = clamp(
                                                            floor(tick / root.musical-snap-ticks) * root.musical-snap-ticks,
                                                            0, max(0, root.pattern-length * 24
                                                                - root.musical-snap-ticks));
                                                        root.piano-note-created(start-tick, note,
                                                            min(root.musical-snap-ticks,
                                                                root.pattern-length * 24 - start-tick));
                                                    }
                                                } else if (e.kind == PointerEventKind.move
                                                        && self.pressed && self.grabbed-id >= 0) {
                                                    if (self.grab-mode == 2) {
                                                        let max-duration = max(root.musical-snap-ticks,
                                                            root.pattern-length * 24 - self.original-start);
                                                        let duration = clamp(self.original-duration
                                                                + round((self.mouse-x - self.origin-x)
                                                                    * 24 / root.piano-step-width
                                                                    / root.musical-snap-ticks)
                                                                    * root.musical-snap-ticks,
                                                            min(root.musical-snap-ticks, max-duration), max-duration);
                                                        root.piano-note-resized(self.grabbed-id, duration);
                                                    } else {
                                                        let tick = clamp(self.original-start
                                                                + round((self.mouse-x - self.origin-x)
                                                                    * 24 / root.piano-step-width
                                                                    / root.musical-snap-ticks)
                                                                    * root.musical-snap-ticks,
                                                            0, max(0, root.pattern-length * 24 - self.original-duration));
                                                        let note = clamp(self.original-note
                                                                + round((self.origin-y - self.mouse-y)
                                                                    / root.piano-row-height),
                                                            root.piano-low-note, root.piano-high-note);
                                                        root.piano-note-moved(self.grabbed-id, tick, note);
                                                    }
                                                } else if (e.kind == PointerEventKind.up) {
                                                    self.grabbed-id = -1;
                                                    self.grab-mode = 0;
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 17px;
                                    background: Theme.panel;
                                    Text {
                                        text: "Velocity";
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        x: 4px;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 55px;
                                    background: Theme.surface;
                                    clip: true;
                                    Rectangle {
                                        x: -piano-scroll.viewport-x;
                                        width: root.pattern-length * root.piano-step-width;
                                        height: parent.height;
                                        background: transparent;
                                        for cell in root.notes : Rectangle {
                                            x: cell.start-tick * root.piano-step-width / 24;
                                            width: max(6px, cell.duration-ticks * root.piano-step-width / 24);
                                            height: parent.height;
                                            border-width: cell.selected ? 1px : 0px;
                                            border-color: Theme.text-muted;
                                            background: transparent;
                                            Rectangle {
                                                x: 3px;
                                                y: parent.height * (127 - cell.velocity) / 127;
                                                width: parent.width - 6px;
                                                height: max(2px, parent.height * cell.velocity / 127);
                                                background: Theme.accent;
                                            }
                                            TouchArea {
                                                mouse-cursor: crosshair;
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.left
                                                        && (e.kind == PointerEventKind.down
                                                        || (e.kind == PointerEventKind.move && self.pressed))) {
                                                        root.velocity-edited(
                                                            cell.id,
                                                            clamp(1 - self.mouse-y / self.height, 0, 1)
                                                        );
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.status-message != "" : Rectangle {
            height: 24px;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border;
            Text {
                text: root.status-message;
                color: Theme.text-muted;
                font-size: 10px;
                x: 8px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    AppearanceDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.appearance-open;
        preset <=> root.appearance-preset;
        accent-text <=> root.appearance-accent;
        validation-error: root.appearance-error;
        preview(preset, accent) => { root.appearance-preview(preset, accent); }
        save(preset, accent) => { root.appearance-save(preset, accent) }
        cancelled => { root.appearance-cancelled(); }
    }
    ExportDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.export-open;
        format-index <=> root.export-format;
        bitrate-index <=> root.export-bitrate;
        tail-seconds <=> root.export-tail-seconds;
        accepted(format, bitrate, tail) => { root.export-confirmed(format, bitrate, tail); }
        cancelled => { root.export-open = false; }
    }
}
