                                                    reorder-requested(target) => { root.reorder-effect(index, target); }
                                                    select-requested => { root.device-selected(index); }
                                                }
                                                if slot.kind == 8 : ReverbDeviceFace {
                                                    modulation-armed: !root.editing-bus && root.modulation-armed-slot >= 0;
                                                    modulation-depths: slot.modulation-depths;
                                                    modulation-allowed: slot.modulation-allowed;
                                                    modulation-offsets: slot.modulation-offsets;
                                                    modulation-route-counts: slot.modulation-route-counts;
                                                    modulation-depth-changed(p, v) => { root.effect-modulation-depth-changed(index, p, v); }
                                                    modulation-edit-started(p) => { root.effect-modulation-edit-started(index, p); }
                                                    modulation-edit-finished(p) => { root.effect-modulation-edit-finished(index, p); }
                                                    x: DeviceRackMetrics.rail-width;
                                                    y: 0px;
                                                    width: parent.content-width;
                                                    height: parent.height;
                                                    slot-index: index;
                                                    slot-count: root.effect-slots.length;
                                                    bypassed: slot.bypassed;
                                                    preset-name: slot.preset-name;
                                                    // Row fields are descriptor ids, and the
                                                    // Reverb's are 8..15: 0..7 are retired
                                                    // convolution-era ids. Edits below are
                                                    // table positions, which do start at 0.
                                                    size: slot.p8;
                                                    decay: slot.p9;
                                                    damping: slot.p10;
                                                    predelay: slot.p11;
                                                    diffusion: slot.p12;
                                                    width-value: slot.p13;
                                                    modulation: slot.p14;
                                                    low-cut: slot.p15;
                                                    size-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                    decay-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                    damping-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                    predelay-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                    diffusion-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                    width-changed(v) => { root.effect-param-changed(index, 5, v); }
                                                    modulation-changed(v) => { root.effect-param-changed(index, 6, v); }
                                                    low-cut-changed(v) => { root.effect-param-changed(index, 7, v); }
