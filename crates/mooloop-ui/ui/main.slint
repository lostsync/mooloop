// Exported standalone (rather than only reachable through the rack) so the
// drag regression tests can drive them directly with real pointer events
// instead of invoking their callbacks, which would pass even if event
// routing to the handle were broken.
export { CompressorDeviceDragHarness, EqDeviceDragHarness, FilterDeviceDragHarness } from "device-drag-harness.slint";
export { MixerStripRow }
export { OutputTargetRow }
export { ShortcutRow }
export { AppearanceSchemeRow }

// One step cell used in the step-grid models.
struct StepCell {
    active: bool,
    velocity: int,
    // Which 64th slots a note covers, and which ones a note actually starts on.
    // Coverage alone cannot tell a ratcheted step from one long note: both fill
    // all four slots. Onsets are what make a slice visible.
    substeps: int,
    onsets: int,
}

// One breakpoint in the piano roll's automation lane. `value` is normalised
// 0..1 against the destination's descriptor, matching how the lane is stored
// and sent to the engine; the readout converts to natural units for display.
struct AutomationPointCell {
    id: int,
    tick: int,
    value: float,
    selected: bool,
}

// One selectable automation destination in the lane picker. Rust builds the
// whole catalogue — every param of every effect on the selected channel and on
// every bus — because only Rust has the descriptor tables.
struct AutomationTargetRow {
    // "Cutoff". Displayed in the menu row and, with `device`, in the header.
    param-name: string,
    // "Filter 1" or "Bus 2 · Delay 1". Menu rows are grouped by this.
    device: string,
    // First row of a device's group draws the header above itself. Precomputed
    // in Rust because Slint's `for` has no access to the previous element.
    starts-group: bool,
    // Already has a lane in this clip, so it sorts to the top level and offers
    // clear/remove rather than just "open".
    open: bool,
    // True when this is the lane currently shown.
    current: bool,
}

// One channel row in the rack.
struct ChannelRow {
    name: string,
    muted: bool,
    // Channel gain in dB from unity; the Rust side stores linear.
    volume-db: float,
    pan: float,
    selected: bool,
    // Mixer bus this channel feeds; 0 is the master.
    bus: int,
    steps: [StepCell],
}

// One pattern instance in the song playlist.
struct PlaylistClip {
    pattern: int,
    start-tick: int,
    length-steps: int,
}

// One row of the sample browser's tree, flattened from the folder hierarchy
// in Rust: folders first, then the audio files beside them, children of an
// expanded folder immediately following their parent.
struct BrowserRow {
    depth: int,
    // 0 = folder, 1 = sample file.
    kind: int,
    name: string,
    // Absolute path; toggling and removal hand it back to Rust verbatim.
    path: string,
    expanded: bool,
}

// One effect slot in the selected channel's chain, in signal order.
//
// Parameters are positional and normalized: `p0` is the first entry in this
// kind's descriptor table in mooloop-core, `p1` the second, and so on, each
// in 0..1. Faces convert to natural units for display using the same mapping
// the descriptor defines. Delay additionally uses `p6`/`p7` for its persisted
// tempo-sync input mode and beat-division selection; its DSP parameter stays
// at `p0` in milliseconds.
struct EffectSlotRow {
    // Matches EffectKind: 0=Filter, 1=Drive, 2=Bitcrush, 3=Delay,
    // 4=Gate, 5=Compressor, 6=Limiter, 7=EQ, 8=Reverb, 9=Mod,
    // 10=Plate, 11=Buffer.
    kind: int,
    // Rack units this device's face occupies. Devices with more working
    // controls get more width rather than compressing their controls.
    units: int,
    bypassed: bool,
    p0: float,
    p1: float,
    p2: float,
    p3: float,
    p4: float,
    p5: float,
    p6: float,
    p7: float,
    // One entry per descriptor, in descriptor order: the armed source's
    // route depth, and whether that parameter accepts modulation at all.
    // Indexed rather than named so a face exposes every eligible control.
    modulation-depths: [float],
    modulation-allowed: [bool],
    modulation-offsets: [float],
    modulation-route-counts: [int],
    // EQ-only: seven groups of freq/gain/q/enabled/kind plus HP and LP.
    eq-band-data: [float],
    eq-spectrum-data: [float],
    eq-analyzer-enabled: bool,
    wet-dry: float,
    // Trims are carried in dB from unity; the Rust side stores linear gain.
    input-trim-db: float,
    output-trim-db: float,
    input-left-db: float,
    input-right-db: float,
    output-left-db: float,
    output-right-db: float,
    // Buffer-only: forced returns to live counted by the inserted device.
    buffer-collisions: int,
    // Dynamics-only: the level this device's sidechain detector reached and
    // the gain reduction it applied. Both are the device's own state, not a
    // difference of the meters above -- the meters are block peaks, these
    // carry the attack and release the device is actually running.
    detector-db: float,
    gain-reduction-db: float,
}

// One selectable destination inside the automation lane picker.
component AutomationMenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> current: false;
    callback selected();
    height: 20px;
    min-width: 150px;
    background: touch.has-hover ? Theme.surface-raised : transparent;
    Text {
        x: 8px;
        text: root.text;
        color: root.current ? Theme.accent : Theme.text;
        font-size: 10px;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

// The lane picker. Every parameter of every device the selected clip can
// reach, grouped by device, with the lane-level actions on top when one is
// already open.
component AutomationLaneMenu inherits VerticalLayout {
    in property <[AutomationTargetRow]> targets;
    in property <bool> has-lane: false;
    callback picked(int);
    callback cleared();
    callback closed();
    padding: 4px;
    spacing: 1px;
    if root.has-lane : AutomationMenuRow {
        text: "Clear points";
        selected => { root.cleared(); }
    }
    if root.has-lane : AutomationMenuRow {
        text: "Remove lane";
        selected => { root.closed(); }
    }
    if root.has-lane : Rectangle {
        height: 5px;
        Rectangle {
            y: 2px;
            height: 1px;
            width: parent.width;
            background: Theme.border;
        }
    }
    ScrollView {
        height: min(280px, list.preferred-height);
        width: max(170px, list.preferred-width);
        list := VerticalLayout {
            spacing: 1px;
            for row[index] in root.targets : VerticalLayout {
                spacing: 1px;
                // Rust marks the first row of each device so the header can be
                // drawn here; Slint's `for` cannot see the previous element.
                if row.starts-group : Text {
                    height: 16px;
                    text: row.device;
                    color: Theme.text-faint;
                    font-size: 8px;
                    vertical-alignment: bottom;
                    x: 6px;
                }
                AutomationMenuRow {
                    text: row.open ? "● " + row.param-name : row.param-name;
                    current: row.current;
                    selected => { root.picked(index); }
                }
            }
        }
    }
}

component FlatButton inherits ToolButton { }
component MuteButton inherits DesignMuteButton { }

export component MainWindow inherits Window {
    title: root.document-title;
    preferred-width: 1280px;
    preferred-height: 760px;
    background: Theme.background;

    // ---- transport / state exchanged with Rust ----
    in-out property <bool>  playing;
    in-out property <int>   bpm;
    in-out property <int>   swing-percent: 50;
    in-out property <int>   beat-in-bar;
    in-out property <float> meter-l-db: -60;
    in-out property <float> meter-r-db: -60;
    in-out property <float> meter-l-held-db: -60;
    in-out property <float> meter-r-held-db: -60;
    in-out property <bool> meter-l-clipping;
    in-out property <bool> meter-r-clipping;
    in-out property <float> source-output-left-db: -60;
    in-out property <float> source-output-right-db: -60;
    in-out property <float> selected-channel-volume-db: 0;

    // ---- preferences ----
    in-out property <bool> preferences-open;
    in-out property <string> preferences-appearance-scheme: "Mooloop";
    in-out property <[AppearanceSchemeRow]> preferences-appearance-schemes;
    in-out property <string> preferences-appearance-base: "#18181B";
    in-out property <string> preferences-appearance-accent: "#84CC16";
    in-out property <string> preferences-appearance-alert: "#EAB308";
    in-out property <float> preferences-appearance-contrast: 1.0;
    in-out property <float> preferences-appearance-roundness: 1.0;
    in-out property <string> preferences-appearance-scheme-name;
    in-out property <bool> preferences-developer-mode;
    in-out property <bool> preferences-log-to-file;
    in-out property <string> preferences-log-path;
    callback preferences-log-to-file-toggled(bool);
    in-out property <bool> preferences-smooth-curves;
    in-out property <string> preferences-error;
    in property <[OutputTargetRow]> preferences-audio-output-targets;
    in property <int> preferences-audio-buffer-size-index;
    in property <string> preferences-audio-sample-rate-text;
    in property <bool> preferences-audio-auto-reconnect;
    in property <string> preferences-audio-error;
    in property <[ShortcutRow]> preferences-shortcut-rows;
    in property <[GestureRow]> preferences-gesture-rows;
    in property <[string]> preferences-gesture-choices;
    in-out property <string> preferences-shortcut-capturing-id;
    callback preferences-opened();
    callback preferences-appearance-preview(string, string, string, float, float);
    callback preferences-appearance-select-scheme(string);
    callback preferences-appearance-save-scheme(string);
    callback preferences-appearance-remove-scheme(string);
    callback preferences-save(string, string, string, float, float, bool, bool) -> bool;
    callback preferences-cancelled();
    callback preferences-audio-refresh-targets();
    callback preferences-audio-select-output(string, string, string);
    callback preferences-audio-select-buffer-size(int);
    callback preferences-audio-auto-reconnect-toggled(bool);
    callback preferences-shortcut-rebind-key(string, string, bool, bool, bool, bool);
    callback preferences-shortcut-reset(string);
    callback preferences-shortcut-reset-all();
    callback preferences-gesture-rebound(string, int);
    callback preferences-open-mockup-tool();

    // ---- document lifecycle ----
    in-out property <string> document-title: "Untitled - mooloop";
    in-out property <bool> embed-assets: true;
    in-out property <bool> document-busy;
    in-out property <string> status-message;
    // Live hover hint: gesture/interaction explanations that used to live in
    // a Tooltip now show here instead, so nothing hover-lingers over a
    // large always-under-the-pointer area (the piano roll, in particular).
    // Takes priority over status-message while non-empty.
    in-out property <string> hover-hint;
    in-out property <bool> save-error-open;
    in-out property <string> save-error-title;
    in-out property <string> save-error-detail;
    in-out property <string> save-error-report;
    callback save-error-dismissed();
    in-out property <bool> export-open;
    in-out property <int> export-format;
    in-out property <int> export-bitrate: 2;
    in-out property <int> export-tail-seconds: 2;
    callback open-song();
    callback save-song();
    callback save-song-as();
    callback load-kit();
    callback save-kit();
    callback load-channel();
    callback save-channel();
    callback export-audio();
    callback export-confirmed(int, int, int);
    callback quit-requested();

    // ---- presets (per-generator and whole-channel) ----
    in-out property <[string]> generator-preset-options;
    in-out property <[string]> channel-preset-options;
    callback generator-preset-selected(int);
    callback channel-preset-selected(int);
    callback save-generator-preset-requested();
    callback save-channel-preset-requested();
    in-out property <bool> save-preset-open;
    in property <string> save-preset-title;
    in-out property <string> save-preset-name;
    in-out property <string> save-preset-category;
    callback save-preset-confirmed(string, string);
    callback save-preset-cancelled();

    // ---- about ----
    in-out property <bool> about-open;
    in property <string> app-version;

    // ---- channels / patterns ----
    in-out property <[ChannelRow]> channels;
    in-out property <int> current-pattern;
    in-out property <int> pattern-count: 1;
    in-out property <int> pattern-length;
    in-out property <int> current-step;
    in-out property <int> selected-channel;
    in-out property <[NoteCell]> notes;
    in-out property <bool> song-mode;
    in-out property <[PlaylistClip]> playlist-clips;
    in-out property <int> playlist-position-ticks;
    in-out property <int> playlist-song-length-ticks: 384;
    in-out property <int> playlist-bars: 64;
    in-out property <length> playlist-bar-width: 24px;
    property <int> playlist-bar-ticks: 384;
    property <[string]> musical-snap-options: [
        "1 Bar", "1/2", "1/4", "1/4T", "1/8", "1/8T",
        "1/16", "1/16T", "1/32", "1/32T", "1/64",
    ];
    in-out property <int> playlist-snap-index: 0;
    in-out property <int> piano-snap-index: 6;

    // Transport position, computed engine-side because it depends on PPQ and
    // on whether the playlist or the pattern is driving.
    in-out property <int> position-bar: 1;
    in-out property <int> position-beat: 1;
    in-out property <int> position-tick;

    // Pattern identity. Names are optional; the selector falls back to the
    // number so an unnamed pattern is never blank.
    in-out property <string> current-pattern-name;
    in-out property <[string]> pattern-menu-options;
    callback pattern-renamed(int, string);

    // Editing tool: 0=Select 1=Paint 2=Slice 3=Stretch.
    in-out property <int> tool-mode;
    in-out property <int> slice-divisions: 2;
    // Paint and stretch are drags, so they report a target state rather than
    // toggling: a drag across mixed steps must not invert each one.
    callback step-painted(int, int, bool);   // channel, step, on
    callback step-sliced(int, int, int);     // channel, step, divisions
    callback step-length-dragged(int, int, int); // channel, step, length in steps
    property <int> playlist-snap-ticks: root.snap-ticks(root.playlist-snap-index);
    // `out` so the shortcut dispatcher can size an arrow-key nudge.
    out property <int> piano-snap-ticks: root.snap-ticks(root.piano-snap-index);
    // Whether the roll quantises at all. The snap-override gesture inverts
    // this for a single drag, in either direction.
    in-out property <bool> piano-snap-enabled: true;
    // Which pointer tool the note grid is in: 0 select, 1 draw, 2 paint,
    // 3 slice, 4 erase. Select is the default because it is the only one
    // that is safe to land on by accident.
    in-out property <int> piano-tool;

    pure function snap-ticks(index: int) -> int {
        index == 0 ? 384 : index == 1 ? 192 : index == 2 ? 96
            : index == 3 ? 64 : index == 4 ? 48 : index == 5 ? 32
            : index == 6 ? 24 : index == 7 ? 16 : index == 8 ? 12
            : index == 9 ? 8 : 6
    }

    callback step-clicked(int, int);       // channel, step
    callback step-removed(int, int);       // channel, step
    callback step-velocity-edited(int, int, float); // channel, step, normalised velocity
    callback channel-selected(int);
    callback channel-muted(int);
    callback channel-volume-changed(int, float);
    callback channel-pan-changed(int, float);
    callback channel-bus-changed(int, int); // channel, bus
    callback add-channel-clicked(int); // 0=Sampler, 1=Drum, 2=Mono, 3=Poly
    callback remove-channel-clicked();
    // Channel structure is a project edit, so these callbacks carry the
    // clicked row rather than relying on whichever row was selected before a
    // context menu opened.
    in-out property <bool> channel-clipboard-available: false;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> project-edit-pending: false;
    // 0=Undo, 1=Redo, 2=Cut channel, 3=Copy channel, 4=Paste channel,
    // 5=Clone channel, 6=Delete channel.  Menu, keyboard, and context menus
    // intentionally route through this one command surface.
    callback edit-command-requested(int, int);
    callback add-pattern-clicked();
    callback pattern-selected(int);
    callback pattern-length-changed(int);
    callback playback-mode-changed(bool);
    callback playlist-placement-added(int, int);   // pattern, absolute start tick
    callback playlist-placement-removed(int, int); // pattern, tick covered by clip

    // ---- mixer ----
    // The work surface shows either the step grid or the mixer; the bottom
    // device rack follows whichever strip is selected in the visible one.
    in-out property <bool> mixer-visible;
    in property <[MixerStripRow]> mixer-strips;
    // Full bus names, master first, indexed by bus. Shared by every picker.
    in property <[string]> bus-names;
    callback bus-selected(int);
    callback bus-muted(int);
    callback bus-volume-changed(int, float);
    callback bus-pan-changed(int, float);
    callback bus-output-changed(int, int);

    // ---- the bus the device rack is editing, when it is editing one ----
    in property <bool> editing-bus;
    in property <int> editing-bus-index;
    in property <string> editing-bus-name;
    in property <bool> editing-bus-is-master;
    in property <bool> editing-bus-muted;
    in property <float> editing-bus-volume: 1.0;
    in property <float> editing-bus-pan;
    in property <int> editing-bus-output;
    in property <int> editing-bus-feed-count;
    in property <[bool]> editing-bus-allowed;
    in property <float> editing-bus-left-db: -60;
    in property <float> editing-bus-right-db: -60;
    in property <float> editing-bus-input-left-db: -60;
    in property <float> editing-bus-input-right-db: -60;

    // ---- lower editor ----
    in-out property <int> editor-page;      // 0=Source, 1=Notes, 2=Playlist
    // Dock height the piano roll restores. Only the notes page drives the
    // splitter today. Source starts at 430px so a fixed device face and the
    // compact modulation shelf fit without an initial vertical scroll, and
    // grows by the shelf's open delta while the shelf is expanded;
    // Playlist retains the established 410px geometry.
    in-out property <length> piano-dock-height: 410px;
    // The whole lower dock (splitter included) can collapse to give the work
    // surface the full column; the status bar's panel button restores it.
    in-out property <bool> bottom-pane-visible: true;
    // The grip clamps while dragging, but only this catches the window
    // itself shrinking under a tall dock. Kept out of the dock's height
    // binding: reading root.height there loops through the layout.
    changed height => {
        if (root.editor-page == 1) {
            root.piano-dock-height = max(140px,
                min(root.piano-dock-height, root.height - 220px));
        }
    }
    // Browser sidebar. Hidden by default; the status bar's panel icon
    // toggles it. Width bounds: a 180px floor, a 400px ceiling, and never
    // wider than the window minus room for the work surface.
    in-out property <bool> sidebar-visible;
    in-out property <length> sidebar-width: 260px;
    changed width => {
        if (root.sidebar-visible) {
            root.sidebar-width = max(180px,
                min(root.sidebar-width, min(400px, root.width - 280px)));
        }
    }
    // Sample browser tree, flattened by Rust into one row per visible
    // folder/file. Adding a location opens the folder picker on a worker
    // thread; toggling expands or collapses that folder in place. Clicking
    // a sample row fills the info pane and, with autoplay armed, plays it.
    in-out property <[BrowserRow]> browser-rows;
    callback browser-add-location();
    callback browser-row-toggled(string);
    callback browser-location-removed(string);
    callback browser-row-previewed(string);
    // Right-click menu on a sample row: load it into the selected channel
    // as-is, or into a fresh sampler channel.
    callback browser-sample-loaded(string);
    callback browser-sample-loaded-new-channel(string);
    // Preview voice controls: the toggle arms click-to-play, the knob is
    // the preview's own gain in dB (the callback carries linear gain). It
    // starts at the operating level, matching the engine's preview cell:
    // auditioning a full-scale file should not be louder than the project.
    in-out property <bool> browser-autoplay: true;
    in-out property <float> browser-preview-gain-db: GainMath.reference-peak-dbfs;
    callback browser-preview-gain-changed(float);
    // Info pane for the last-clicked sample. Empty waveform = nothing
    // inspected yet.
    in-out property <[float]> browser-info-waveform;
    in-out property <string> browser-info-name;
    in-out property <string> browser-info-stats;
    in-out property <int> source-kind;      // 0=Sampler, 1=Drum, 2=Mono, 3=Poly, 4=ML-M1, 5=ML-P8
    in-out property <int> sampler-device-page;
    in-out property <int> mono-device-page;
    in-out property <int> poly-device-page;
    callback channel-source-changed(int);

    // ---- effect chain of the selected channel ----
    in property <[EffectSlotRow]> effect-slots;
    // EffectKind index, then the slot it must precede. `effect-slots.length`
    // means append; every device shell can therefore insert into the chain.
    callback add-effect-clicked(int, int);
    callback remove-effect-clicked(int);            // slot
    callback effect-bypass-toggled(int);            // slot
    callback effect-wet-dry-changed(int, float);
    callback effect-input-trim-changed(int, float);
    callback effect-output-trim-changed(int, float);
    // slot, descriptor index within the kind, normalized 0..1. One callback
    // covers every parameter of every effect kind.
    callback effect-param-changed(int, int, float);
    callback delay-tempo-sync-changed(int, bool);
    callback delay-time-division-changed(int, int);
    // Slot index and an index into the buffer face's fixed debug event table.
    callback effect-buffer-triggered(int, int);
    // Press/release of the buffer face's held reverse control.
    callback effect-buffer-reverse-pressed(int);
    callback effect-buffer-reverse-released(int);
    callback eq-analyzer-changed(int, bool);
    callback reorder-effect(int, int);              // from slot, to slot

    // ---- channel modulation shelf ----
    // The shelf belongs to the selected channel, never the bus chain. Values
    // are plain UI rows; Rust owns their `ModRack` / `ParamAddr` conversion.
    in property <[ModulationSourceRow]> modulation-sources;
    in property <[ModulationRouteRow]> modulation-routes;
    in-out property <bool> modulation-shelf-open;
    in-out property <int> modulation-selected-slot: -1;
    in-out property <int> modulation-armed-slot: -1;
    in property <int> modulation-selected-kind: -1;
    // Selection chooses the source editor. Arming is a separate, deliberate
    // assignment mode, so inspecting an LFO never changes what a knob drag
    // means. The selected source's values and the rack capacity come from
    // Rust rather than being inferred by the shelf.
    // The selected source's parameters, indexed by descriptor id; the shelf's
    // editors are the sole consumer.
    in property <[float]> modulation-selected-values;
    in property <float> modulation-selected-preview-fade-cycles;
    in property <float> modulation-selected-preview-smoothing-cycles;
    in property <[string]> modulation-input-channels;
    in property <int> modulation-selected-envelope-input-channel;
    in property <float> modulation-selected-envelope-preview-attack;
    in property <float> modulation-selected-envelope-preview-decay;
    in property <float> modulation-selected-envelope-preview-release;
    in property <int> modulation-max-sources;
    in property <[string]> modulation-slot-names;
    callback modulation-shelf-toggled();
    callback modulation-source-selected(int);
    callback modulation-source-moved(int, int);
    callback modulation-assignment-toggled();
    callback modulation-source-added(int);
    callback modulation-param-changed(int, int, float);
    callback modulation-param-edit-started();
    callback modulation-param-edit-finished();
    callback modulation-source-removed(int);
    callback modulation-envelope-input-channel-changed(int, int);
    callback modulation-route-polarity-changed(int, int);
    callback modulation-route-removed(int);
    // Generator and strip destinations, indexed by descriptor position the
    // same way `EffectSlotRow` indexes an insert's.
    in property <[float]> source-modulation-depths;
    in property <[bool]> source-modulation-allowed;
    in property <[float]> source-modulation-offsets;
    in property <[int]> source-modulation-route-counts;
    in property <[float]> strip-modulation-depths;
    in property <[bool]> strip-modulation-allowed;
    callback source-modulation-depth-changed(int, float);
    callback source-modulation-edit-started(int);
    callback source-modulation-edit-finished(int);
    callback strip-modulation-depth-changed(int, float);
    callback strip-modulation-edit-started(int);
    callback strip-modulation-edit-finished(int);
    callback effect-modulation-depth-changed(int, int, float);
    callback effect-modulation-edit-started(int, int);
    callback effect-modulation-edit-finished(int, int);
    in-out property <int> selected-note-step;
    in-out property <int> selected-note;
    in-out property <int> selected-velocity;
    in-out property <bool> has-selected-note;
    in-out property <bool> has-note-selection;
    // The piano roll is a MIDI editor, rather than a C2–C6 drum-only view.
    // Keep the bounds and every pixel extent derived from this range so the
    // pitch scrollbar can reach notes below C2 too.
    property <int> piano-low-note: 0;
    property <int> piano-high-note: 127;
    property <int> piano-note-count: root.piano-high-note - root.piano-low-note + 1;
    // Starts three pitch-zoom steps above the old 5px minimum: that is where
    // Adam kept landing after clicking zoom-in, so start there.
    property <length> piano-row-height: 8px;
    property <length> piano-step-width: 32px;
    // Full scrollable extent of the piano-roll grid in pixels; the zoom
    // scrollbars work against these.
    property <length> piano-content-w: root.pattern-length * root.piano-step-width;
    property <length> piano-content-h: root.piano-note-count * root.piano-row-height;

    // A pointer gesture reports an edit on every move frame. Bracketing the
    // gesture lets the history collapse those frames into the one undo step
    // the user thinks they performed; without it a single note drag costs
    // twenty undos.
    // Resolved from `gestures.rs` plus the user's Preferences overrides.
    in property <PianoGestures> piano-gestures;
    // The selection's bounding box, for the grid's selection frame and its
    // scale handles. Zero count means no frame.
    in property <int> selection-count;
    in property <int> selection-start-tick;
    in property <int> selection-end-tick;
    in property <int> selection-low-note;
    in property <int> selection-high-note;
    // Time-scaling the selection. Begin caches the pre-drag geometry in Rust
    // so every frame scales the original rather than compounding on the
    // previous frame's rounding.
    callback piano-scale-begin(bool);   // true when dragging the left handle
    callback piano-selection-scaled(float);
    // Clicking the grid takes keyboard focus back from whatever control had
    // it, so Delete and the arrow keys reach the selection.
    callback piano-focus-requested();
    callback piano-notes-nudged(int, int); // tick delta, semitone delta
    callback piano-notes-copied(bool);     // true to cut
    callback piano-notes-pasted();
    callback piano-gesture-begin();
    callback piano-gesture-end();
    callback piano-note-created(int, int, int) -> int;  // start tick, MIDI note, duration ticks -> stable note ID
    callback piano-note-selected(int, int); // stable note ID, 0 replace / 1 add / 2 remove
    // ID, start tick, MIDI note. The ID names the note under the pointer; the
    // whole selection moves with it, by the delta this note implies.
    callback piano-note-moved(int, int, int);
    // Copy the current selection in place and return the copy of the note the
    // caller names, so a Ctrl-drag can continue on the duplicate. -1 when
    // nothing was duplicated.
    callback piano-selection-duplicated(int) -> int;
    callback piano-note-resized(int, int);  // ID, duration ticks
    // Left-edge resize: the end tick stays put and the start moves.
    callback piano-note-start-resized(int, int); // ID, start tick
    callback piano-note-removed(int);       // stable note ID
    // Marquee selection. Begin snapshots the base selection in Rust, because
    // the band updates live and would otherwise clobber its own base every
    // frame when adding to or removing from an existing selection.
    callback piano-marquee-begin(int);      // 0 replace / 1 add / 2 remove
    callback piano-marquee-updated(int, int, int, int); // start tick, end tick, low note, high note
    callback piano-note-sliced(int, int);   // stable note ID, tick to cut at
    callback piano-selection-joined();
    callback piano-cell-painted(int, int, int); // start tick, MIDI note, duration ticks
    // Pure so it can be read from the cursor-shape binding below. Rust owns the
    // note list, so the scan lives there.
    pure callback piano-note-hit-test(int, int) -> NoteHit; // tick, MIDI note -> note under it, if any
    callback velocity-edited(int, float);   // stable note ID, normalised value

    // ---- editor lanes below the piano roll ----
    // Velocity and automation toggle independently: the roll alone, the roll
    // plus either, or all three are all reasonable working layouts.
    in-out property <bool> velocity-lane-visible: true;
    in-out property <bool> automation-lane-visible: false;
    in property <[AutomationTargetRow]> automation-targets;
    in property <[AutomationPointCell]> automation-points;
    // Empty when no lane is open, which is what makes the lane draw its
    // "pick a destination" prompt instead of a curve.
    in property <string> automation-lane-name;
    // Natural-units readout of the point under the pointer, e.g. "1.2 kHz".
    in property <string> automation-value-text;
    // Index into `automation-targets`.
    callback automation-lane-selected(int);
    callback automation-lane-cleared();
    callback automation-lane-closed();
    // tick, normalised value -> stable point ID (-1 when the lane is full or
    // no destination is open).
    callback automation-point-created(int, float) -> int;
    callback automation-point-moved(int, int, float);  // ID, tick, value
    callback automation-point-removed(int);
    // Point under a tick/value cell, if any. Same reason as the note hit test:
    // the scan needs a loop, which Slint's expression language cannot express.
    // tick, normalised value, and the grab radius in ticks -> point ID, or -1.
    // The radius comes from the view because only the view knows the current
    // time zoom; Rust would otherwise guess at what "near" means on screen.
    pure callback automation-point-hit-test(int, float, int) -> int;

    callback selected-note-changed(int);
    callback selected-velocity-changed(int);
    // Length as a musical division. `selected-duration-index` is -1 when the
    // selection's length matches no listed division, or when the selection
    // is not all one length; the text beside it always shows the truth.
    in property <int> selected-duration-index: -1;
    in property <string> selected-duration-text;
    callback selected-duration-picked(int);

