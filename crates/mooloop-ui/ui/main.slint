                                                    select-requested => { root.device-selected(index); }
                                                }
                                                if slot.kind == 7 : EqDeviceFace {
                                                    modulation-armed: !root.editing-bus && root.modulation-armed-slot >= 0;
                                                    modulation-depths: slot.modulation-depths;
                                                    modulation-allowed: slot.modulation-allowed;
                                                    modulation-offsets: slot.modulation-offsets;
                                                    modulation-route-counts: slot.modulation-route-counts;
                                                    modulation-depth-changed(p, v) => { root.effect-modulation-depth-changed(index, p, v); }
                                                    modulation-edit-started(p) => { root.effect-modulation-edit-started(index, p); }
                                                    modulation-edit-finished(p) => { root.effect-modulation-edit-finished(index, p); }
                                                    x: DeviceRackMetrics.rail-width;
                                                    y: 0px;
                                                    width: parent.content-width;
                                                    height: parent.height;
                                                    slot-index: index;
                                                    slot-count: root.effect-slots.length;
                                                    bypassed: slot.bypassed;
                                                    preset-name: slot.preset-name;
                                                    target: slot.p0;
                                                    enabled: slot.p1;
                                                    frequency: slot.p2;
                                                    gain: slot.p3;
                                                    q: slot.p4;
                                                    pass-slope: slot.p5;
                                                    q-profile: slot.p6;
                                                    band-data: slot.eq-band-data;
                                                    band-kinds: slot.eq-band-kinds;
                                                    pass-data: slot.eq-pass-data;
                                                    curve-db: slot.eq-curve-db;
                                                    spectrum-data: slot.eq-spectrum-data;
                                                    analyzer-enabled: slot.eq-analyzer-enabled;
                                                    target-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                    enabled-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                    frequency-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                    gain-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                    q-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                    pass-slope-changed(v) => { root.effect-param-changed(index, 5, v); }
                                                    q-profile-changed(v) => { root.effect-param-changed(index, 6, v); }
