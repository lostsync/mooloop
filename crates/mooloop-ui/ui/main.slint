    in-out property <bool> save-preset-open;
    in property <string> save-preset-title;
    in-out property <string> save-preset-name;
    in-out property <string> save-preset-category;
    callback save-preset-confirmed(string, string);
    callback save-preset-cancelled();

    // ---- about ----
    in-out property <bool> about-open;
    in property <string> app-version;

    // ---- channels / patterns ----
    in-out property <[ChannelRow]> channels;
    in-out property <int> current-pattern;
    in-out property <int> pattern-count: 1;
    in-out property <int> pattern-length;
    in-out property <int> current-step;
    in-out property <int> selected-channel;
    in-out property <[NoteCell]> notes;
    in-out property <bool> song-mode;
    in-out property <[PlaylistClip]> playlist-clips;
    in-out property <int> playlist-position-ticks;
    in-out property <int> playlist-song-length-ticks: 384;
    in-out property <int> playlist-bars: 64;
    in-out property <length> playlist-bar-width: 24px;
    property <int> playlist-bar-ticks: 384;
    property <[string]> musical-snap-options: [
        "1 Bar", "1/2", "1/4", "1/4T", "1/8", "1/8T",
        "1/16", "1/16T", "1/32", "1/32T", "1/64",
    ];
    in-out property <int> playlist-snap-index: 0;
    in-out property <int> piano-snap-index: 6;

    // Transport position, computed engine-side because it depends on PPQ and
    // on whether the playlist or the pattern is driving.
    in-out property <int> position-bar: 1;
    in-out property <int> position-beat: 1;
    in-out property <int> position-tick;

    // Pattern identity. Names are optional; the selector falls back to the
    // number so an unnamed pattern is never blank.
    in-out property <string> current-pattern-name;
    in-out property <[string]> pattern-menu-options;
    callback pattern-renamed(int, string);

    // Editing tool: 0=Select 1=Paint 2=Slice 3=Stretch.
    in-out property <int> tool-mode;
    in-out property <int> slice-divisions: 2;
    // Paint and stretch are drags, so they report a target state rather than
    // toggling: a drag across mixed steps must not invert each one.
    callback step-painted(int, int, bool);   // channel, step, on
    callback step-sliced(int, int, int);     // channel, step, divisions
    callback step-length-dragged(int, int, int); // channel, step, length in steps
    property <int> playlist-snap-ticks: root.snap-ticks(root.playlist-snap-index);
    property <int> piano-snap-ticks: root.snap-ticks(root.piano-snap-index);

    pure function snap-ticks(index: int) -> int {
        index == 0 ? 384 : index == 1 ? 192 : index == 2 ? 96
            : index == 3 ? 64 : index == 4 ? 48 : index == 5 ? 32
            : index == 6 ? 24 : index == 7 ? 16 : index == 8 ? 12
            : index == 9 ? 8 : 6
    }

    callback step-clicked(int, int);       // channel, step
    callback step-removed(int, int);       // channel, step
    callback step-velocity-edited(int, int, float); // channel, step, normalised velocity
    callback channel-selected(int);
    callback channel-muted(int);
    callback channel-volume-changed(int, float);
    callback channel-pan-changed(int, float);
    callback add-channel-clicked(int); // 0=Sampler, 1=Drum, 2=Mono
    callback remove-channel-clicked();
    callback add-pattern-clicked();
    callback pattern-selected(int);
    callback pattern-length-changed(int);
    callback playback-mode-changed(bool);
    callback playlist-placement-added(int, int);   // pattern, absolute start tick
    callback playlist-placement-removed(int, int); // pattern, tick covered by clip

    // ---- lower editor ----
    in-out property <int> editor-page;      // 0=Source, 1=Notes, 2=Playlist
    in-out property <int> source-kind;      // 0=Sampler, 1=Drum, 2=Mono
    in-out property <int> sampler-device-page;
    in-out property <int> mono-device-page;
    callback channel-source-changed(int);

    // ---- effect chain of the selected channel ----
    in property <[EffectSlotRow]> effect-slots;
    callback add-effect-clicked(int);               // EffectKind index
    callback remove-effect-clicked(int);            // slot
    callback effect-bypass-toggled(int);            // slot
    // slot, descriptor index within the kind, normalized 0..1. One callback
    // covers every parameter of every effect kind.
    callback effect-param-changed(int, int, float);
    callback reorder-effect(int, int);              // from slot, to slot
    in-out property <int> selected-note-step;
    in-out property <int> selected-note;
    in-out property <int> selected-velocity;
    in-out property <int> selected-duration-ticks: 24;
    in-out property <bool> has-selected-note;
    property <int> piano-low-note: 36;
    property <int> piano-high-note: 84;
    property <length> piano-row-height: 5px;
    property <length> piano-step-width: 32px;

    callback piano-note-created(int, int, int) -> int;  // start tick, MIDI note, duration ticks -> stable note ID
    callback piano-note-selected(int);      // stable note ID
    callback piano-note-moved(int, int, int); // ID, start tick, MIDI note
    callback piano-note-resized(int, int);  // ID, duration ticks
    callback piano-note-removed(int);       // stable note ID
    // Pure so it can be read from the cursor-shape binding below. Rust owns the
    // note list, so the scan lives there.
    pure callback piano-note-hit-test(int, int) -> NoteHit; // tick, MIDI note -> note under it, if any
    callback velocity-edited(int, float);   // stable note ID, normalised value
    callback selected-note-changed(int);
    callback selected-velocity-changed(int);
    callback selected-duration-changed(int);

    // ---- sampler params of the selected channel ----
    in-out property <float> attack;
    in-out property <float> decay;
    in-out property <float> sustain;
    in-out property <float> release;
    in-out property <float> start-pos;
    in-out property <float> end-pos: 1;
    in-out property <float> loop-start;
    in-out property <float> loop-end;
    in-out property <bool> reverse-playback;
    in-out property <int> root-note: 60;
    in-out property <float> tune-semitones;
    in-out property <float> tune-cents;
    in-out property <float> filter-cutoff;
    in-out property <float> filter-resonance;
    in-out property <float> filter-env;
    in-out property <float> sampler-drive;
    in-out property <float> bit-reduction;
    in-out property <float> rate-reduction;
    in-out property <int>   loop-mode;     // 0=Off 1=Fwd 2=Pong
    in-out property <int> voice-mode;       // 0=One Shot 1=Gate
    in-out property <int> sampler-polyphony: 1;
    in-out property <int> retrigger-mode;   // 0=Restart 1=Layer
    in-out property <int> choke-group;
    in-out property <string> sample-name;
    in-out property <string> sample-description;
    in-out property <float> sample-duration;
    in-out property <int> audio-sample-rate: 48000;
    in-out property <string> selected-channel-name;
    in-out property <[float]> waveform;
    in-out property <bool> can-previous-sample;
    in-out property <bool> can-next-sample;

    callback attack-changed(float);
    callback decay-changed(float);
    callback sustain-changed(float);
    callback release-changed(float);
    callback start-pos-changed(float);
    callback end-pos-changed(float);
    callback loop-start-changed(float);
    callback loop-end-changed(float);
    callback reverse-playback-changed(bool);
    callback root-note-changed(int);
    callback tune-semitones-changed(float);
    callback tune-cents-changed(float);
    callback loop-mode-changed(int);
    callback voice-mode-changed(int);
    callback sampler-polyphony-changed(int);
    callback retrigger-mode-changed(int);
    callback choke-group-changed(int);
    callback filter-cutoff-changed(float);
    callback filter-resonance-changed(float);
    callback filter-env-changed(float);
    callback sampler-drive-changed(float);
    callback bit-reduction-changed(float);
    callback rate-reduction-changed(float);
    callback load-sample-clicked();
    callback previous-sample-clicked();
    callback next-sample-clicked();

    // ---- drum synth params of the selected channel ----
    in-out property <int> drum-mode; // 0=Kick, 1=Snare, 2=Hat
    in-out property <int> drum-kick-character: 3;
    in-out property <int> drum-snare-character;
    in-out property <int> drum-hat-character: 1;
    in-out property <float> drum-decay: 0.24;
    in-out property <float> drum-tune-semitones;
    in-out property <float> drum-drive;
    in-out property <float> drum-punch: 0.35;
    in-out property <int> drum-choke-group;
    in-out property <float> drum-kick-start-hz: 160;
    in-out property <float> drum-kick-end-hz: 48;
    in-out property <float> drum-kick-sweep: 0.045;
    in-out property <float> drum-kick-click: 0.5;
    in-out property <float> drum-snare-tone-hz: 180;
    in-out property <float> drum-snare-tone2-hz: 330;
    in-out property <float> drum-snare-tone2-mix: 0.2;
    in-out property <float> drum-snare-noise-mix: 0.6;
    in-out property <float> drum-snare-noise-decay: 0.15;
    in-out property <float> drum-snare-noise-color: 0.65;
    in-out property <float> drum-hat-hp-hz: 7500;
    in-out property <float> drum-hat-metallic: 0.5;
    in-out property <[float]> drum-preview-minimums;
    in-out property <[float]> drum-preview-maximums;
    callback drum-mode-changed(int);
    callback drum-kick-character-changed(int);
    callback drum-snare-character-changed(int);
    callback drum-hat-character-changed(int);
    callback drum-decay-changed(float);
    callback drum-tune-semitones-changed(float);
    callback drum-drive-changed(float);
    callback drum-punch-changed(float);
    callback drum-choke-group-changed(int);
    callback drum-kick-start-hz-changed(float);
    callback drum-kick-end-hz-changed(float);
    callback drum-kick-sweep-changed(float);
    callback drum-kick-click-changed(float);
    callback drum-snare-tone-hz-changed(float);
    callback drum-snare-tone2-hz-changed(float);
    callback drum-snare-tone2-mix-changed(float);
    callback drum-snare-noise-mix-changed(float);
    callback drum-snare-noise-decay-changed(float);
    callback drum-snare-noise-color-changed(float);
    callback drum-hat-hp-hz-changed(float);
    callback drum-hat-metallic-changed(float);

    // ---- mono synth params of the selected channel ----
    in-out property <int> mono-osc1-wave: 2;
    in-out property <float> mono-osc1-semitones;
    in-out property <float> mono-osc1-cents;
    in-out property <float> mono-osc1-level: 0.8;
    in-out property <float> mono-osc1-pulse-width: 0.5;
    in-out property <int> mono-osc2-wave: 2;
    in-out property <float> mono-osc2-semitones: 12;
    in-out property <float> mono-osc2-cents: 4;
    in-out property <float> mono-osc2-level;
    in-out property <float> mono-osc2-pulse-width: 0.5;
    in-out property <int> mono-osc3-wave: 2;
    in-out property <float> mono-osc3-semitones: -12;
    in-out property <float> mono-osc3-cents: -4;
    in-out property <float> mono-osc3-level;
    in-out property <float> mono-osc3-pulse-width: 0.5;
    in-out property <float> mono-glide;
    in-out property <float> mono-attack: 0.005;
    in-out property <float> mono-decay: 0.2;
    in-out property <float> mono-sustain: 0.7;
    in-out property <float> mono-release: 0.15;
    in-out property <float> mono-filter-cutoff: 1;
    in-out property <float> mono-filter-resonance;
    in-out property <float> mono-filter-env;
    in-out property <float> mono-drive;
    in-out property <int> mono-lfo-wave;
    in-out property <float> mono-lfo-rate: 5;
    in-out property <bool> mono-lfo-retrigger;
    in-out property <float> mono-lfo-pitch;
    in-out property <float> mono-lfo-filter;
    in-out property <float> mono-lfo-pulse-width;
    in-out property <float> mono-lfo-amp;
    callback mono-osc1-wave-changed(int); callback mono-osc1-semitones-changed(float); callback mono-osc1-cents-changed(float); callback mono-osc1-level-changed(float); callback mono-osc1-pulse-width-changed(float);
    callback mono-osc2-wave-changed(int); callback mono-osc2-semitones-changed(float); callback mono-osc2-cents-changed(float); callback mono-osc2-level-changed(float); callback mono-osc2-pulse-width-changed(float);
    callback mono-osc3-wave-changed(int); callback mono-osc3-semitones-changed(float); callback mono-osc3-cents-changed(float); callback mono-osc3-level-changed(float); callback mono-osc3-pulse-width-changed(float);
    callback mono-glide-changed(float); callback mono-attack-changed(float); callback mono-decay-changed(float); callback mono-sustain-changed(float); callback mono-release-changed(float);
    callback mono-filter-cutoff-changed(float); callback mono-filter-resonance-changed(float); callback mono-filter-env-changed(float); callback mono-drive-changed(float);
    callback mono-lfo-wave-changed(int); callback mono-lfo-rate-changed(float); callback mono-lfo-retrigger-changed(bool);
    callback mono-lfo-pitch-changed(float); callback mono-lfo-filter-changed(float); callback mono-lfo-pulse-width-changed(float); callback mono-lfo-amp-changed(float);

    // ---- transport callbacks ----
    callback new-song();
    callback play-clicked();
    callback stop-clicked();
    callback bpm-changed(int);
    callback swing-changed(int);
    callback toggle-play();

    // Keyboard transport: Space toggles play/pause. Gives an input path
    // independent of mouse clicks (also useful for diagnosing input issues).
    // Ctrl shortcuts mirror the menubar. A Ctrl+letter key event reaches
    // us as a control character on some backends and as plain text with a
    // modifier on others, so the control characters match on their own
    // (they cannot be typed without Ctrl) while plain letters additionally
    // require the modifier.
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-play();
                accept
            } else if (event.text == "\u{f}") {
                root.open-song();
                accept
            } else if (event.text == "\u{13}") {
                if (event.modifiers.shift) {
                    root.save-song-as();
                } else {
                    root.save-song();
                }
                accept
            } else if (event.text == "\u{5}") {
                root.export-audio();
                accept
            } else if (event.text == "\u{11}") {
                root.quit-requested();
                accept
            } else if (event.modifiers.control && !event.modifiers.shift) {
                let k = event.text.to-lowercase();
                if (k == "o") {
                    root.open-song();
                    accept
                } else if (k == "s") {
                    root.save-song();
                    accept
                } else if (k == "e") {
                    root.export-audio();
                    accept
                } else if (k == "q") {
                    root.quit-requested();
                    accept
                } else {
                    reject
                }
            } else if (event.modifiers.control && event.modifiers.shift) {
                if (event.text.to-lowercase() == "s") {
                    root.save-song-as();
                    accept
                } else {
                    reject
                }
            } else if (event.text == Key.UpArrow) {
                root.channel-selected(max(0, root.selected-channel - 1));
                accept
            } else if (event.text == Key.DownArrow) {
                root.channel-selected(min(root.channels.length - 1, root.selected-channel + 1));
                accept
            } else {
                reject
            }
        }
    }

    VerticalBox {
        spacing: 0px;

        // ===== Menu bar =====
        //
        // The concrete menus live here, where every root callback is in
        // scope: an item is one MenuRow line, a new action is one callback
        // on the window plus one line. Rows whose feature does not exist
        // yet are kept disabled on purpose so the menu documents what is
        // being built toward.
        menu-bar := MenuBar {
            MenuBarItem {
                title: "File";
                menu-id: 0;
                open-menu <=> menu-bar.open-menu;
                enabled: !root.document-busy;

                // Target: start a fresh song from scratch.
                MenuRow { text: "New Song"; shortcut: "Ctrl+N"; enabled: false; selected => { } }
                MenuRow {
                    text: "Open Song...";
                    shortcut: "Ctrl+O";
                    selected => { root.open-song(); }
                }
                MenuRow {
                    text: "Save Song";
                    shortcut: "Ctrl+S";
                    selected => { root.save-song(); }
                }
                MenuRow {
                    text: "Save Song As...";
                    shortcut: "Ctrl+Shift+S";
                    selected => { root.save-song-as(); }
                }
                MenuSeparator {}
                MenuRow { text: "Load Kit..."; selected => { root.load-kit(); } }
                MenuRow { text: "Save Kit..."; selected => { root.save-kit(); } }
                MenuRow { text: "Load Channel..."; selected => { root.load-channel(); } }
                MenuRow { text: "Save Channel..."; selected => { root.save-channel(); } }
                MenuSeparator {}
                MenuRow {
                    text: "Embed samples";
                    checked: root.embed-assets;
                    selected => { root.embed-assets = !root.embed-assets; }
                }
                MenuSeparator {}
                MenuRow {
                    text: "Export Audio...";
                    shortcut: "Ctrl+E";
                    selected => { root.export-audio(); }
                }
                MenuSeparator {}
                MenuRow {
                    text: "Quit";
                    shortcut: "Ctrl+Q";
                    selected => { root.quit-requested(); }
                }
            }

            MenuBarItem {
                title: "Edit";
                menu-id: 1;
                open-menu <=> menu-bar.open-menu;
                // Targets: the command/shortcut layer and undo stack do not
                // exist yet; the entries define where they land.
                MenuRow { text: "Undo"; shortcut: "Ctrl+Z"; enabled: false; selected => { } }
                MenuRow { text: "Redo"; shortcut: "Ctrl+Shift+Z"; enabled: false; selected => { } }
                MenuSeparator {}
                MenuRow { text: "Cut"; shortcut: "Ctrl+X"; enabled: false; selected => { } }
                MenuRow { text: "Copy"; shortcut: "Ctrl+C"; enabled: false; selected => { } }
                MenuRow { text: "Paste"; shortcut: "Ctrl+V"; enabled: false; selected => { } }
                MenuSeparator {}
                MenuRow { text: "Select All"; shortcut: "Ctrl+A"; enabled: false; selected => { } }
            }

            MenuBarItem {
                title: "Pattern";
                menu-id: 2;
                open-menu <=> menu-bar.open-menu;
                MenuRow {
                    text: "New Pattern";
                    enabled: root.pattern-count < 256;
                    selected => { root.add-pattern-clicked(); }
                }
                // Target: duplicate the selected pattern's notes and length.
                MenuRow { text: "Clone Pattern"; enabled: false; selected => { } }
                MenuSeparator {}
                // Target: clear the selected pattern's notes.
                MenuRow { text: "Clear Pattern"; enabled: false; selected => { } }
                // Target: remove the selected pattern and its placements.
                MenuRow { text: "Delete Pattern"; enabled: false; selected => { } }
            }

            MenuBarItem {
                title: "Channel";
                menu-id: 3;
                open-menu <=> menu-bar.open-menu;
                MenuRow {
                    text: "Add Channel";
                    selected => { root.add-channel-clicked(0); }
                }
                MenuRow {
                    text: "Remove Last Channel";
                    enabled: root.channels.length > 1;
                    selected => { root.remove-channel-clicked(); }
                }
                MenuSeparator {}
                // Target: duplicate the selected channel's setup and notes.
                MenuRow { text: "Clone Channel"; enabled: false; selected => { } }
                // Target: rename the selected channel in place.
                MenuRow { text: "Rename Channel"; enabled: false; selected => { } }
                // Target: remove the selected channel (not just the last).
                MenuRow { text: "Delete Selected Channel"; enabled: false; selected => { } }
            }

            MenuBarItem {
                title: "View";
                menu-id: 4;
                open-menu <=> menu-bar.open-menu;
                MenuRow {
                    text: "Sampler";
                    checked: root.editor-page == 0;
                    selected => { root.editor-page = 0; }
                }
                MenuRow {
                    text: "Notes";
                    checked: root.editor-page == 1;
                    selected => { root.editor-page = 1; }
                }
                MenuRow {
                    text: "Playlist";
                    checked: root.editor-page == 2;
                    selected => { root.editor-page = 2; }
                }
                MenuSeparator {}
                MenuRow {
                    text: "Appearance...";
                    selected => {
                        root.appearance-opened();
                        root.appearance-open = true;
                    }
                }
            }

            MenuBarItem {
                title: "Help";
                menu-id: 5;
                open-menu <=> menu-bar.open-menu;
                MenuRow { text: "About mooloop"; selected => { root.about-open = true; } }
            }
        }

        // ===== Toolbar =====
        //
        // Two rows, split by what they answer. The transport row is the state
        // of playback and never changes meaning; the edit row is what the
        // current click will do. Mixing the two into one strip is what made
        // the old bar read as a row of unrelated buttons.
        Rectangle {
            height: 62px;
            background: Theme.surface;

            VerticalLayout {
                spacing: 0px;

                // --- Transport row -----------------------------------------
                Rectangle {
                    height: 32px;
                    HorizontalBox {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 3px;

                        TransportButton {
                            text: root.playing ? "⏸" : "▶";
                            tooltip: root.playing ? "Pause (Space)" : "Play (Space)";
                            role: "play";
                            active: root.playing;
                            clicked => { root.toggle-play(); }
                        }
                        TransportButton {
                            text: "■";
                            tooltip: "Stop";
                            enabled: root.playing || root.current-step > 0;
                            clicked => { root.stop-clicked(); }
                        }

                        ToolbarRule {}

                        SegmentedControl {
                            width: 96px;
                            height: 24px;
                            options: ["PAT", "SONG"];
                            selected-index: root.song-mode ? 1 : 0;
                            selected(i) => {
                                if ((i == 1) != root.song-mode) {
                                    root.song-mode = i == 1;
                                    root.playback-mode-changed(root.song-mode);
                                }
                            }
                        }

                        ToolbarRule {}

                        PositionReadout {
                            bar: root.position-bar;
                            beat: root.position-beat;
                            tick: root.position-tick;
                        }
                        BeatLamps {
                            current: root.beat-in-bar;
                            running: root.playing;
                        }

                        ToolbarRule {}

                        TempoField {
                            bpm <=> root.bpm;
                            changed(v) => { root.bpm-changed(v); }
                        }

                        StepperField {
                            label: "SWING";
                            tooltip: "Global sixteenth-note swing; 50% is straight";
                            value <=> root.swing-percent;
                            minimum: 50;
                            maximum: 75;
                            display-text: root.swing-percent + "%";
                            value-width: 28px;
                            changed(v) => { root.swing-changed(v); }
                        }

                        Rectangle { horizontal-stretch: 1; min-width: 8px; }

                        MasterMeter {
                            width: 200px;
                            left-db: root.meter-l-db;
                            right-db: root.meter-r-db;
                            held-left-db: root.meter-l-held-db;
                            held-right-db: root.meter-r-held-db;
                            left-clipping: root.meter-l-clipping;
                            right-clipping: root.meter-r-clipping;
                        }

                        IconButton {
                            text: "⚙";
                            tooltip: "Appearance settings";
                            clicked => {
                                root.appearance-opened();
                                root.appearance-open = true;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; opacity: 0.6; }

                // --- Edit row ----------------------------------------------
                Rectangle {
                    height: 29px;
                    background: Theme.panel;
                    HorizontalBox {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 3px;
                        padding-bottom: 2px;
                        spacing: 3px;

                        // Pattern selection is a stepper plus a jump list, so
                        // it costs the same width at 2 patterns and at 200.
                        ToolbarLabel { text: "PAT"; }
                        Rectangle {
                            height: 24px;
                            width: pattern-group.preferred-width;
                            border-radius: 3px;
                            background: Theme.surface-raised;
                            pattern-group := HorizontalLayout {
                                spacing: 0px;
                                StepperField {
                                    value: root.current-pattern + 1;
                                    minimum: 1;
                                    maximum: root.pattern-count;
                                    tooltip: "Selected pattern";
                                    value-width: 26px;
                                    field-background: transparent;
                                    changed(v) => { root.pattern-selected(v - 1); }
                                }
                                MenuField {
                                    options: root.pattern-menu-options;
                                    selected-index: root.current-pattern;
                                    display-text: "";
                                    field-width: 0px;
                                    menu-width: 180px;
                                    tooltip: "Jump to pattern";
                                    field-background: transparent;
                                    selected(i) => { root.pattern-selected(i); }
                                }
                            }
                        }
                        NameField {
                            text: root.current-pattern-name;
                            placeholder: "Pattern " + (root.current-pattern + 1);
                            tooltip: "Name this pattern";
                            edited(t) => { root.pattern-renamed(root.current-pattern, t); }
                        }
                        IconButton {
                            text: "+";
                            tooltip: "Create pattern";
                            size: 24px;
                            enabled: root.pattern-count < 256;
                            clicked => { root.add-pattern-clicked(); }
                        }

                        ToolbarRule {}

                        // Tool modes. The glyph row is the answer to "what
                        // will my next drag across the grid do".
                        ToolModeButton {
                            icon: ToolIcons.select; name: "Select";
                            hint: "Click toggles a step. Ctrl-drag sets velocity.";
                            active: root.tool-mode == 0;
                            clicked => { root.tool-mode = 0; }
                        }
                        ToolModeButton {
                            icon: ToolIcons.paint; name: "Paint";
                            hint: "Drag to fill steps. Right-drag to clear.";
                            active: root.tool-mode == 1;
                            clicked => { root.tool-mode = 1; }
                        }
                        ToolModeButton {
                            icon: ToolIcons.slice; name: "Slice";
                            hint: "Click a step to ratchet it into even hits.";
                            active: root.tool-mode == 2;
                            clicked => { root.tool-mode = 2; }
                        }
                        ToolModeButton {
                            icon: ToolIcons.stretch; name: "Stretch";
                            hint: "Drag a step sideways to set its length.";
                            active: root.tool-mode == 3;
                            clicked => { root.tool-mode = 3; }
                        }
                        if root.tool-mode == 2 : StepperField {
                            label: "×";
                            value <=> root.slice-divisions;
                            minimum: 2;
                            maximum: 4;
                            tooltip: "Hits per sliced step";
                            value-width: 18px;
                        }

                        ToolbarRule {}

                        StepperField {
                            label: "STEPS";
                            value <=> root.pattern-length;
                            minimum: 1;
                            maximum: 256;
                            tooltip: "Length of the selected pattern in 16th-note steps";
                            changed(v) => { root.pattern-length-changed(v); }
                        }
                        MenuField {
                            label: "SNAP";
                            options: root.musical-snap-options;
                            selected-index: root.editor-page == 2
                                ? root.playlist-snap-index : root.piano-snap-index;
                            field-width: 46px;
                            menu-width: 120px;
                            tooltip: root.editor-page == 2
                                ? "Playlist placement grid" : "Piano-roll note grid";
                            selected(i) => {
                                if (root.editor-page == 2) {
                                    root.playlist-snap-index = i;
                                } else {
                                    root.piano-snap-index = i;
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ===== Channel rack: one step-grid row per channel =====
        ScrollView {
            vertical-stretch: 1;
            viewport-width: max(self.visible-width, 300px + root.pattern-length * 27px);
            viewport-height: max(self.visible-height, root.channels.length * 32px + 48px);

            VerticalBox {
                spacing: 2px;
                padding: 8px;

                for row[ch] in root.channels : HorizontalBox {
                    padding: 2px;
                    spacing: 6px;
                    alignment: start;

                    // Channel name selects the channel for the bottom editor.
                    Rectangle {
                        width: 88px;
                        min-height: 24px;
                        border-radius: 3px;
                        background: row.selected ? Theme.surface-active : Theme.surface;
                        Text {
                            text: row.name;
                            color: row.selected ? Theme.text : Theme.text-muted;
                            font-size: 11px;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            x: 6px;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.channel-selected(ch); }
                        }
                    }

                    MuteButton {
                        muted: row.muted;
                        clicked => { root.channel-muted(ch); }
                    }

                    // Volume and pan are knobs here, not faders: the rack row
                    // is for steps, and a pair of 22px knobs costs a fifth of
                    // the width a labelled fader did. Names and values live in
                    // the tooltips.
                    MiniKnob {
                        label: "Volume";
                        value: row.volume;
                        default-value: 0.8;
                        value-text: round(row.volume * 100) + "%";
                        changed(v) => { root.channel-volume-changed(ch, v); }
                    }

                    MiniKnob {
                        label: "Pan";
                        value: row.pan;
                        minimum: -1;
                        maximum: 1;
                        default-value: 0;
                        bipolar: true;
                        value-text: abs(row.pan) < 0.01 ? "Center"
                            : row.pan < 0 ? "L " + round(abs(row.pan) * 100)
                            : "R " + round(row.pan * 100);
                        changed(v) => { root.channel-pan-changed(ch, v); }
                    }

                    // Beat grouping remains visible at any pattern length.
                    //
                    // One hit area covers the whole run of steps and derives
                    // the cell from mouse-x. Per-cell TouchAreas cannot support
                    // a drag: the cell where the press landed keeps the grab,
                    // so the pointer never reaches its neighbours.
                    Rectangle {
                        property <length> cell-pitch: 27px;
                        property <int> step-count: row.steps.length;
                        width: self.step-count * self.cell-pitch - 3px;
                        height: 24px;

                        pure function step-at(x: length) -> int {
                            return clamp(floor(x / self.cell-pitch), 0, self.step-count - 1);
                        }

                        HorizontalLayout {
                            spacing: 3px;
                            for cell[i] in row.steps : Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 2px;
                                clip: true;
                                border-width: root.playing && root.current-step == i ? 1px : 0px;
                                border-color: Theme.text;
                                background: mod(i, 4) == 0 ? Theme.surface-active : Theme.surface-raised;
                                for sub in 4 : Rectangle {
                                    property <int> divisor: sub == 0 ? 1 : sub == 1 ? 2 : sub == 2 ? 4 : 8;
                                    property <bool> onset: mod(floor(cell.onsets / self.divisor), 2) == 1;
                                    visible: mod(floor(cell.substeps / self.divisor), 2) == 1;
                                    x: sub * parent.width / 4;
                                    y: parent.height - self.height;
                                    width: parent.width / 4;
                                    height: max(3px, parent.height * cell.velocity / 127);
                                    border-radius: 0px;
                                    background: Theme.accent;
                                    // A struck slot is solid; one that is only
                                    // being held stays dim, so a ratchet reads
                                    // differently from a single sustained note.
                                    opacity: (self.onset ? 1.0 : 0.3)
                                        * (0.55 + 0.45 * cell.velocity / 127);
                                }
                            }
                        }

                        grid-touch := TouchArea {
                            // -1 means "no drag in progress"; it is not a step.
                            property <int> last-step: -1;
                            property <int> stretch-origin: -1;
                            property <bool> paint-on;
                            property <bool> velocity-drag;
                            // TouchArea.pressed only tracks the left button, so
                            // a right-drag would report its first cell and then
                            // go silent. Track the held button ourselves; this
                            // also stops hover moves from painting.
                            property <int> drag-button: -1;
                            mouse-cursor: root.tool-mode == 1 ? crosshair
                                : root.tool-mode == 3 ? ew-resize : pointer;

                            function paint-to(step: int) {
                                if (step != self.last-step) {
                                    self.last-step = step;
                                    root.step-painted(ch, step, self.paint-on);
                                }
                            }

                            pointer-event(e) => {
                                let step = parent.step-at(self.mouse-x);
                                if (e.kind == PointerEventKind.down) {
                                    self.drag-button =
                                        e.button == PointerEventButton.right ? 1 : 0;
                                    if (root.tool-mode == 1) {
                                        // Left fills, right clears, for the
                                        // whole drag. Toggling per cell would
                                        // invert whatever it crossed.
                                        self.paint-on = e.button == PointerEventButton.left;
                                        self.last-step = -1;
                                        self.paint-to(step);
                                    } else if (root.tool-mode == 2) {
                                        if (e.button == PointerEventButton.right) {
                                            root.step-removed(ch, step);
                                        } else {
                                            root.step-sliced(ch, step, root.slice-divisions);
                                        }
                                    } else if (root.tool-mode == 3) {
                                        if (e.button == PointerEventButton.right) {
                                            root.step-length-dragged(ch, step, 1);
                                        } else {
                                            self.stretch-origin = step;
                                            root.step-length-dragged(ch, step, 1);
                                        }
                                    } else if (e.button == PointerEventButton.right) {
                                        root.step-removed(ch, step);
                                    } else {
                                        self.velocity-drag = e.modifiers.control;
                                        if (self.velocity-drag) {
                                            root.step-velocity-edited(ch, step,
                                                clamp(1 - self.mouse-y / self.height, 0, 1));
                                        } else {
                                            root.step-clicked(ch, step);
                                        }
                                    }
                                } else if (e.kind == PointerEventKind.move && self.drag-button >= 0) {
                                    if (root.tool-mode == 1) {
                                        self.paint-to(step);
                                    } else if (root.tool-mode == 3 && self.stretch-origin >= 0) {
                                        root.step-length-dragged(ch, self.stretch-origin,
                                            max(1, step - self.stretch-origin + 1));
                                    } else if (self.velocity-drag) {
                                        root.step-velocity-edited(ch, step,
                                            clamp(1 - self.mouse-y / self.height, 0, 1));
                                    }
                                } else if (e.kind == PointerEventKind.up) {
                                    self.drag-button = -1;
                                    self.velocity-drag = false;
                                    self.last-step = -1;
                                    self.stretch-origin = -1;
                                }
                            }
                            // @markdown takes a literal, so the per-tool hint
                            // is resolved into a property first.
                            property <string> hint: root.tool-mode == 1
                                ? "**Paint** Drag to fill. Right-drag to clear."
                                : root.tool-mode == 2
                                ? "**Slice** Click to ratchet into \{root.slice-divisions} hits. Right-click clears."
                                : root.tool-mode == 3
                                ? "**Stretch** Drag right to lengthen. Right-click resets."
                                : "Click to toggle. **Ctrl-drag** velocity. **Right-click** to clear.";
                            Tooltip { text: @markdown("\{parent.hint}"); }
                        }
                    }
                }

                HorizontalBox {
                    height: 28px;
                    padding: 0px;
                    spacing: 4px;
                    alignment: start;
                    FlatButton {
                        text: "+";
                        tooltip: "Add sound source";
                        min-width: 28px; max-width: 28px;
                        min-height: 24px; max-height: 24px;
                        clicked => { add-source-menu.show(); }
                    }
                    FlatButton {
                        text: "−";
                        tooltip: "Remove last channel";
                        min-width: 28px; max-width: 28px;
                        min-height: 24px; max-height: 24px;
                        clicked => { root.remove-channel-clicked(); }
                    }
                }

                add-source-menu := PopupWindow {
                    x: 8px;
                    y: 8px;
                    width: 156px;
                    height: 82px;
                    close-policy: close-on-click;
                    Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 3px;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 1px;
                            ToolButton { text: "Add Sampler"; tooltip: "Add a sampler channel"; clicked => { add-source-menu.close(); root.add-channel-clicked(0); } }
                            ToolButton { text: "Add Drum Synth"; tooltip: "Add a drum synth channel"; clicked => { add-source-menu.close(); root.add-channel-clicked(1); } }
                            ToolButton { text: "Add Mono Synth"; tooltip: "Add a mono synth channel"; clicked => { add-source-menu.close(); root.add-channel-clicked(2); } }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ===== Bottom dock: sampler and note editors =====
        Rectangle {
            height: 410px;
            background: Theme.panel;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 30px;
                    background: Theme.surface;
                    HorizontalBox {
                        padding: 3px;
                        spacing: 3px;
                        alignment: start;
                        FlatButton {
                            text: "Source";
                            tooltip: "Sound source controls";
                            active: root.editor-page == 0;
                            clicked => { root.editor-page = 0; }
                        }
                        FlatButton {
                            text: "Notes";
                            tooltip: "Piano roll and note parameters";
                            active: root.editor-page == 1;
                            clicked => { root.editor-page = 1; }
                        }
                        FlatButton {
                            text: "Playlist";
                            tooltip: "Song arrangement";
                            active: root.editor-page == 2;
                            clicked => { root.editor-page = 2; }
                        }
                        Rectangle { width: 8px; }
                        Text {
                            text: root.editor-page == 2 ? "SONG ARRANGEMENT" : root.selected-channel-name;
                            color: Theme.text-muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.editor-page != 2 : MenuField {
                            label: "CHANNEL PRESET";
                            options: root.channel-preset-options;
                            selected-index: -1;
                            display-text: "Browse...";
                            field-width: 90px;
                            menu-width: 220px;
                            tooltip: "Load a saved whole-channel preset (source + mixer)";
                            selected(i) => { root.channel-preset-selected(i); }
                        }
                        if root.editor-page != 2 : IconButton {
                            text: "💾";
                            tooltip: "Save this channel (source + mixer) as a preset";
                            size: 24px;
                            clicked => { root.save-channel-preset-requested(); }
                        }
                    }
                }

                if root.editor-page == 2 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalBox {
                                padding: 4px;
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: "SNAP";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: root.musical-snap-options;
                                    current-index <=> root.playlist-snap-index;
                                    width: 92px;
                                    height: 24px;
                                    Tooltip { text: @markdown("Playlist placement grid"); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "↔"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom timeline out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.playlist-bar-width > 12px;
                                    clicked => { root.playlist-bar-width = max(12px, root.playlist-bar-width - 4px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom timeline in";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.playlist-bar-width < 96px;
                                    clicked => { root.playlist-bar-width = min(96px, root.playlist-bar-width + 4px); }
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: max(self.visible-width,
                                104px + root.playlist-bars * root.playlist-bar-width);
                            viewport-height: max(self.visible-height,
                                30px + root.pattern-count * 28px);

                            playlist-canvas := Rectangle {
                                width: 104px + root.playlist-bars * root.playlist-bar-width;
                                height: max(346px, 30px + root.pattern-count * 28px);

                                Text {
                                    x: 8px; y: 5px;
                                    width: 88px; height: 18px;
                                    text: "PATTERN";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    x: 104px; y: 0px;
                                    width: root.playlist-bars * root.playlist-bar-width;
                                    height: 28px;
                                    background: Theme.surface;
                                    for bar in root.playlist-bars : Rectangle {
                                        x: bar * root.playlist-bar-width;
                                        width: root.playlist-bar-width;
                                        height: parent.height;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        Text {
                                            text: bar + 1;
                                            color: Theme.text-faint;
                                            font-size: 8px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                for pattern in root.pattern-count : Rectangle {
                                    x: 0px;
                                    y: 30px + pattern * 28px;
                                    width: playlist-canvas.width;
                                    height: 26px;

                                    Rectangle {
                                        x: 8px;
                                        width: 88px;
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: root.current-pattern == pattern
                                            ? Theme.surface-active : Theme.surface;
                                        Text {
                                            x: 6px;
                                            text: "Pattern " + (pattern + 1);
                                            color: root.current-pattern == pattern
                                                ? Theme.text : Theme.text-muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.pattern-selected(pattern); }
                                        }
                                    }

                                    timeline := Rectangle {
                                        x: 104px;
                                        width: root.playlist-bars * root.playlist-bar-width;
                                        height: parent.height;
                                        background: Theme.background;

                                        for bar in root.playlist-bars : Rectangle {
                                            x: bar * root.playlist-bar-width;
                                            width: root.playlist-bar-width;
                                            height: parent.height;
                                            background: mod(bar, 4) == 0
                                                ? Theme.surface : Theme.background;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            for division in root.playlist-bar-ticks / root.playlist-snap-ticks : Rectangle {
                                                visible: division > 0;
                                                x: division * parent.width
                                                    / (root.playlist-bar-ticks / root.playlist-snap-ticks);
                                                width: 1px;
                                                height: parent.height;
                                                background: Theme.border;
                                                opacity: 0.48;
                                            }
                                        }

                                        for clip in root.playlist-clips : Rectangle {
                                            visible: clip.pattern == pattern;
                                            property <int> clip-end-tick:
                                                clip.start-tick + clip.length-steps * 24;
                                            x: clip.start-tick * root.playlist-bar-width
                                                / root.playlist-bar-ticks;
                                            y: 2px;
                                            width: max(4px,
                                                clip.length-steps * root.playlist-bar-width / 16);
                                            height: parent.height - 4px;
                                            border-radius: 2px;
                                            border-width: root.playing && root.song-mode
                                                && root.playlist-position-ticks >= clip.start-tick
                                                && root.playlist-position-ticks < self.clip-end-tick ? 1px : 0px;
                                            border-color: Theme.text;
                                            background: Theme.accent;
                                            opacity: root.current-pattern == pattern ? 1 : 0.62;
                                            Text {
                                                text: pattern + 1;
                                                color: Theme.background;
                                                font-size: 9px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        if root.playing && root.song-mode : Rectangle {
                                            x: root.playlist-position-ticks * root.playlist-bar-width
                                                / root.playlist-bar-ticks;
                                            width: 1px;
                                            height: parent.height;
                                            background: Theme.text;
                                        }

                                        Rectangle {
                                            x: root.playlist-song-length-ticks * root.playlist-bar-width
                                                / root.playlist-bar-ticks - 1px;
                                            width: 1px;
                                            height: parent.height;
                                            background: Theme.text-faint;
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    let raw-tick = clamp(floor(self.mouse-x
                                                        * root.playlist-bar-ticks / root.playlist-bar-width),
                                                        0, root.playlist-bars * root.playlist-bar-ticks - 1);
                                                    if (e.button == PointerEventButton.right) {
                                                        root.playlist-placement-removed(pattern, raw-tick);
                                                    } else if (e.button == PointerEventButton.left) {
                                                        root.playlist-placement-added(pattern,
                                                            floor(raw-tick / root.playlist-snap-ticks)
                                                                * root.playlist-snap-ticks);
                                                    }
                                                }
                                            }
                                            Tooltip {
                                                text: @markdown("Click to place on the playlist grid. Right-click removes a clip.");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.editor-page == 0 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 6px;
                                Text {
                                    text: "DEVICE CHAIN";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SelectorBank {
                                    options: ["Sampler", "Drum", "Mono"];
                                    selected-index <=> root.source-kind;
                                    segment-width: 62px;
                                    tooltip: "Source device";
                                    selected(i) => {
                                        root.source-kind = i;
                                        root.channel-source-changed(i);
                                    }
                                }
                                Rectangle { width: 6px; }
                                MenuField {
                                    label: "PRESET";
                                    options: root.generator-preset-options;
                                    selected-index: -1;
                                    display-text: "Browse...";
                                    field-width: 90px;
                                    menu-width: 220px;
                                    tooltip: "Load a preset for this source device";
                                    selected(i) => { root.generator-preset-selected(i); }
                                }
                                IconButton {
                                    text: "💾";
                                    tooltip: "Save the current source as a preset";
                                    size: 24px;
                                    clicked => { root.save-generator-preset-requested(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        device-chain-scroll := ScrollView {
                            vertical-stretch: 1;
                            viewport-width: max(self.visible-width, 758px);
                            viewport-height: max(self.visible-height, 284px);

                            Rectangle {
                                width: max(device-chain-scroll.visible-width, 758px);
                                height: 284px;
                                background: Theme.panel;

                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 0px;
                                    alignment: start;

                                    source-device := DeviceFrame {
                                        width: DeviceRackMetrics.unit-width * 3 + DeviceRackMetrics.half-gap;
                                        height: DeviceRackMetrics.face-height;

                                        if root.source-kind == 0 : SamplerDeviceFace {
                                            x: 0px;
                                            y: DeviceRackMetrics.header-height;
                                            width: parent.width;
                                            height: parent.height - DeviceRackMetrics.header-height;
                                            page <=> root.sampler-device-page;
                                            attack <=> root.attack;
                                            decay <=> root.decay;
                                            sustain <=> root.sustain;
                                            release <=> root.release;
                                            start-pos <=> root.start-pos;
                                            end-pos <=> root.end-pos;
                                            loop-start <=> root.loop-start;
                                            loop-end <=> root.loop-end;
                                            reverse-playback <=> root.reverse-playback;
                                            root-note <=> root.root-note;
                                            tune-semitones <=> root.tune-semitones;
                                            tune-cents <=> root.tune-cents;
                                            filter-cutoff <=> root.filter-cutoff;
                                            filter-resonance <=> root.filter-resonance;
                                            filter-env <=> root.filter-env;
                                            drive <=> root.sampler-drive;
                                            bit-reduction <=> root.bit-reduction;
                                            rate-reduction <=> root.rate-reduction;
                                            loop-mode <=> root.loop-mode;
                                            voice-mode <=> root.voice-mode;
                                            polyphony <=> root.sampler-polyphony;
                                            retrigger-mode <=> root.retrigger-mode;
                                            choke-group <=> root.choke-group;
                                            sample-name <=> root.sample-name;
                                            sample-description <=> root.sample-description;
                                            waveform <=> root.waveform;
                                            can-previous-sample <=> root.can-previous-sample;
                                            can-next-sample <=> root.can-next-sample;
                                            attack-changed(v) => { root.attack-changed(v); }
                                            decay-changed(v) => { root.decay-changed(v); }
                                            sustain-changed(v) => { root.sustain-changed(v); }
                                            release-changed(v) => { root.release-changed(v); }
                                            start-pos-changed(v) => { root.start-pos-changed(v); }
                                            end-pos-changed(v) => { root.end-pos-changed(v); }
                                            loop-start-changed(v) => { root.loop-start-changed(v); }
                                            loop-end-changed(v) => { root.loop-end-changed(v); }
                                            reverse-playback-changed(v) => { root.reverse-playback-changed(v); }
                                            root-note-changed(v) => { root.root-note-changed(v); }
                                            tune-semitones-changed(v) => { root.tune-semitones-changed(v); }
                                            tune-cents-changed(v) => { root.tune-cents-changed(v); }
                                            loop-mode-changed(v) => { root.loop-mode-changed(v); }
                                            voice-mode-changed(v) => { root.voice-mode-changed(v); }
                                            polyphony-changed(v) => { root.sampler-polyphony-changed(v); }
                                            retrigger-mode-changed(v) => { root.retrigger-mode-changed(v); }
                                            choke-group-changed(v) => { root.choke-group-changed(v); }
                                            filter-cutoff-changed(v) => { root.filter-cutoff-changed(v); }
                                            filter-resonance-changed(v) => { root.filter-resonance-changed(v); }
                                            filter-env-changed(v) => { root.filter-env-changed(v); }
                                            drive-changed(v) => { root.sampler-drive-changed(v); }
                                            bit-reduction-changed(v) => { root.bit-reduction-changed(v); }
                                            rate-reduction-changed(v) => { root.rate-reduction-changed(v); }
                                            load-sample-clicked => { root.load-sample-clicked(); }
                                            previous-sample-clicked => { root.previous-sample-clicked(); }
                                            next-sample-clicked => { root.next-sample-clicked(); }
                                        }

                                        if root.source-kind == 1 : DrumDeviceFace {
                                            x: 0px;
                                            y: DeviceRackMetrics.header-height;
                                            width: parent.width;
                                            height: parent.height - DeviceRackMetrics.header-height;
                                            mode <=> root.drum-mode;
                                            kick-character <=> root.drum-kick-character;
                                            snare-character <=> root.drum-snare-character;
                                            hat-character <=> root.drum-hat-character;
                                            decay <=> root.drum-decay;
                                            tune-semitones <=> root.drum-tune-semitones;
                                            drive <=> root.drum-drive;
                                            punch <=> root.drum-punch;
                                            choke-group <=> root.drum-choke-group;
                                            kick-start-hz <=> root.drum-kick-start-hz;
                                            kick-end-hz <=> root.drum-kick-end-hz;
                                            kick-sweep <=> root.drum-kick-sweep;
                                            kick-click <=> root.drum-kick-click;
                                            snare-tone-hz <=> root.drum-snare-tone-hz;
                                            snare-tone2-hz <=> root.drum-snare-tone2-hz;
                                            snare-tone2-mix <=> root.drum-snare-tone2-mix;
                                            snare-noise-mix <=> root.drum-snare-noise-mix;
                                            snare-noise-decay <=> root.drum-snare-noise-decay;
                                            snare-noise-color <=> root.drum-snare-noise-color;
                                            hat-hp-hz <=> root.drum-hat-hp-hz;
                                            hat-metallic <=> root.drum-hat-metallic;
                                            preview-minimums: root.drum-preview-minimums;
                                            preview-maximums: root.drum-preview-maximums;
                                            mode-changed(v) => { root.drum-mode-changed(v); }
                                            kick-character-changed(v) => { root.drum-kick-character-changed(v); }
                                            snare-character-changed(v) => { root.drum-snare-character-changed(v); }
                                            hat-character-changed(v) => { root.drum-hat-character-changed(v); }
                                            decay-changed(v) => { root.drum-decay-changed(v); }
                                            tune-semitones-changed(v) => { root.drum-tune-semitones-changed(v); }
                                            drive-changed(v) => { root.drum-drive-changed(v); }
                                            punch-changed(v) => { root.drum-punch-changed(v); }
                                            choke-group-changed(v) => { root.drum-choke-group-changed(v); }
                                            kick-start-hz-changed(v) => { root.drum-kick-start-hz-changed(v); }
                                            kick-end-hz-changed(v) => { root.drum-kick-end-hz-changed(v); }
                                            kick-sweep-changed(v) => { root.drum-kick-sweep-changed(v); }
                                            kick-click-changed(v) => { root.drum-kick-click-changed(v); }
                                            snare-tone-hz-changed(v) => { root.drum-snare-tone-hz-changed(v); }
                                            snare-tone2-hz-changed(v) => { root.drum-snare-tone2-hz-changed(v); }
                                            snare-tone2-mix-changed(v) => { root.drum-snare-tone2-mix-changed(v); }
                                            snare-noise-mix-changed(v) => { root.drum-snare-noise-mix-changed(v); }
                                            snare-noise-decay-changed(v) => { root.drum-snare-noise-decay-changed(v); }
                                            snare-noise-color-changed(v) => { root.drum-snare-noise-color-changed(v); }
                                            hat-hp-hz-changed(v) => { root.drum-hat-hp-hz-changed(v); }
                                            hat-metallic-changed(v) => { root.drum-hat-metallic-changed(v); }
                                        }

                                        if root.source-kind == 2 : MonoDeviceFace {
                                            x: 0px;
                                            y: DeviceRackMetrics.header-height;
                                            width: parent.width;
                                            height: parent.height - DeviceRackMetrics.header-height;
                                            page <=> root.mono-device-page;
                                            osc1-wave <=> root.mono-osc1-wave; osc1-semitones <=> root.mono-osc1-semitones; osc1-cents <=> root.mono-osc1-cents; osc1-level <=> root.mono-osc1-level; osc1-pulse-width <=> root.mono-osc1-pulse-width;
                                            osc2-wave <=> root.mono-osc2-wave; osc2-semitones <=> root.mono-osc2-semitones; osc2-cents <=> root.mono-osc2-cents; osc2-level <=> root.mono-osc2-level; osc2-pulse-width <=> root.mono-osc2-pulse-width;
                                            osc3-wave <=> root.mono-osc3-wave; osc3-semitones <=> root.mono-osc3-semitones; osc3-cents <=> root.mono-osc3-cents; osc3-level <=> root.mono-osc3-level; osc3-pulse-width <=> root.mono-osc3-pulse-width;
                                            glide <=> root.mono-glide; attack <=> root.mono-attack; decay <=> root.mono-decay; sustain <=> root.mono-sustain; release <=> root.mono-release;
                                            filter-cutoff <=> root.mono-filter-cutoff; filter-resonance <=> root.mono-filter-resonance; filter-env <=> root.mono-filter-env; drive <=> root.mono-drive;
                                            lfo-wave <=> root.mono-lfo-wave; lfo-rate <=> root.mono-lfo-rate; lfo-retrigger <=> root.mono-lfo-retrigger;
                                            lfo-pitch <=> root.mono-lfo-pitch; lfo-filter <=> root.mono-lfo-filter; lfo-pulse-width <=> root.mono-lfo-pulse-width; lfo-amp <=> root.mono-lfo-amp;
                                            osc1-wave-changed(v) => { root.mono-osc1-wave-changed(v); } osc1-semitones-changed(v) => { root.mono-osc1-semitones-changed(v); } osc1-cents-changed(v) => { root.mono-osc1-cents-changed(v); } osc1-level-changed(v) => { root.mono-osc1-level-changed(v); } osc1-pulse-width-changed(v) => { root.mono-osc1-pulse-width-changed(v); }
                                            osc2-wave-changed(v) => { root.mono-osc2-wave-changed(v); } osc2-semitones-changed(v) => { root.mono-osc2-semitones-changed(v); } osc2-cents-changed(v) => { root.mono-osc2-cents-changed(v); } osc2-level-changed(v) => { root.mono-osc2-level-changed(v); } osc2-pulse-width-changed(v) => { root.mono-osc2-pulse-width-changed(v); }
                                            osc3-wave-changed(v) => { root.mono-osc3-wave-changed(v); } osc3-semitones-changed(v) => { root.mono-osc3-semitones-changed(v); } osc3-cents-changed(v) => { root.mono-osc3-cents-changed(v); } osc3-level-changed(v) => { root.mono-osc3-level-changed(v); } osc3-pulse-width-changed(v) => { root.mono-osc3-pulse-width-changed(v); }
                                            glide-changed(v) => { root.mono-glide-changed(v); } attack-changed(v) => { root.mono-attack-changed(v); } decay-changed(v) => { root.mono-decay-changed(v); } sustain-changed(v) => { root.mono-sustain-changed(v); } release-changed(v) => { root.mono-release-changed(v); }
                                            filter-cutoff-changed(v) => { root.mono-filter-cutoff-changed(v); } filter-resonance-changed(v) => { root.mono-filter-resonance-changed(v); } filter-env-changed(v) => { root.mono-filter-env-changed(v); } drive-changed(v) => { root.mono-drive-changed(v); }
                                            lfo-wave-changed(v) => { root.mono-lfo-wave-changed(v); } lfo-rate-changed(v) => { root.mono-lfo-rate-changed(v); } lfo-retrigger-changed(v) => { root.mono-lfo-retrigger-changed(v); }
                                            lfo-pitch-changed(v) => { root.mono-lfo-pitch-changed(v); } lfo-filter-changed(v) => { root.mono-lfo-filter-changed(v); } lfo-pulse-width-changed(v) => { root.mono-lfo-pulse-width-changed(v); } lfo-amp-changed(v) => { root.mono-lfo-amp-changed(v); }
                                        }

                                        DeviceHeader {
                                            x: 0px; y: 0px; width: parent.width;
                                            name: root.source-kind == 0 ? "Sampler"
                                                : root.source-kind == 1 ? "Drum Synth" : "Mono Synth";
                                            kind: "SOURCE / 3U";
                                            device-color: Theme.accent;
                                        }
                                    }

                                    DeviceJoin { }

                                    for slot[index] in root.effect-slots : Rectangle {
                                        property <length> face-width:
                                            DeviceRackMetrics.unit-width * slot.units
                                            + DeviceRackMetrics.half-gap * (slot.units - 1);
                                        width: self.face-width + 20px;
                                        height: DeviceRackMetrics.face-height;
                                        DeviceFrame {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.face-width;
                                            height: DeviceRackMetrics.face-height;
                                            if slot.kind == 0 : FilterDeviceFace {
                                                x: 0px;
                                                y: 0px;
                                                width: parent.width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                cutoff: slot.p0;
                                                resonance: slot.p1;
                                                mode: slot.p2 >= 0.5 ? 1 : 0;
                                                cutoff-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                resonance-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                mode-changed(v) => { root.effect-param-changed(index, 2, v * 1.0); }
                                                bypass-toggled => { root.effect-bypass-toggled(index); }
                                                remove-clicked => { root.remove-effect-clicked(index); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 1 : DriveDeviceFace {
                                                x: 0px;
                                                y: 0px;
                                                width: parent.width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                drive: slot.p0;
                                                curve: round(slot.p1 * 3);
                                                tone: slot.p2;
                                                mix: slot.p3;
                                                output: slot.p4;
                                                drive-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                curve-changed(i) => { root.effect-param-changed(index, 1, i * 1.0 / 3.0); }
                                                tone-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                mix-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                output-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                bypass-toggled => { root.effect-bypass-toggled(index); }
                                                remove-clicked => { root.remove-effect-clicked(index); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 2 : BitcrushDeviceFace {
                                                x: 0px;
                                                y: 0px;
                                                width: parent.width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                bits: slot.p0;
                                                downsample: slot.p1;
                                                mix: slot.p2;
                                                bits-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                downsample-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                mix-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                bypass-toggled => { root.effect-bypass-toggled(index); }
                                                remove-clicked => { root.remove-effect-clicked(index); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 3 : DelayDeviceFace {
                                                x: 0px;
                                                y: 0px;
                                                width: parent.width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                time: slot.p0;
                                                feedback: slot.p1;
                                                mode: round(slot.p2 * 2);
                                                cross: slot.p3;
                                                tone: slot.p4;
                                                mix: slot.p5;
                                                time-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                feedback-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                mode-changed(i) => { root.effect-param-changed(index, 2, i * 1.0 / 2.0); }
                                                cross-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                tone-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                mix-changed(v) => { root.effect-param-changed(index, 5, v); }
                                                bypass-toggled => { root.effect-bypass-toggled(index); }
                                                remove-clicked => { root.remove-effect-clicked(index); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                        }
                                        DeviceJoin { x: parent.face-width; y: 0px; }
                                    }

                                    Rectangle {
                                        width: 50px;
                                        height: DeviceRackMetrics.face-height;
                                        DeviceAddSlot {
                                            enabled: root.effect-slots.length < 8;
                                            clicked => { add-effect-menu.show(); }
                                        }
                                        // Effect kinds are a growing set, so the
                                        // add action opens a menu rather than
                                        // spending rack width on a selector bank.
                                        add-effect-menu := PopupWindow {
                                            x: 0px;
                                            y: 44px;
                                            width: 148px;
                                            height: 106px;
                                            close-policy: close-on-click;
                                            Rectangle {
                                                background: Theme.surface;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                border-radius: 3px;
                                                VerticalLayout {
                                                    padding: 4px;
                                                    spacing: 1px;
                                                    ToolButton { text: "Filter"; tooltip: "Add a low/high-pass filter"; clicked => { add-effect-menu.close(); root.add-effect-clicked(0); } }
                                                    ToolButton { text: "Drive"; tooltip: "Add saturation or distortion"; clicked => { add-effect-menu.close(); root.add-effect-clicked(1); } }
                                                    ToolButton { text: "Bitcrush"; tooltip: "Add bit and rate reduction"; clicked => { add-effect-menu.close(); root.add-effect-clicked(2); } }
                                                    ToolButton { text: "Delay"; tooltip: "Add a delay"; clicked => { add-effect-menu.close(); root.add-effect-clicked(3); } }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }

                if root.editor-page == 1 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalBox {
                                padding: 4px;
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: root.has-selected-note ? "TICK " + root.selected-note-step : "NO NOTE";
                                    color: Theme.text-muted;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "NOTE";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-note;
                                    minimum: root.piano-low-note;
                                    maximum: root.piano-high-note;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-note-changed(value); }
                                    Tooltip { text: @markdown("Selected step MIDI note"); }
                                }
                                Text {
                                    text: "VEL";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-velocity;
                                    minimum: 1;
                                    maximum: 127;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-velocity-changed(value); }
                                    Tooltip { text: @markdown("Selected step velocity"); }
                                }
                                Text {
                                    text: "LEN";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-duration-ticks;
                                    minimum: 1;
                                    maximum: max(1, root.pattern-length * 24);
                                    step-size: root.piano-snap-ticks;
                                    width: 78px;
                                    height: 24px;
                                    edited(value) => { root.selected-duration-changed(value); }
                                    Tooltip { text: @markdown("Selected note length in PPQ ticks. **6** ticks = 1/64 note."); }
                                }
                                Rectangle { width: 8px; }
                                ComboBox {
                                    model: ["Velocity"];
                                    current-index: 0;
                                    current-value: "Velocity";
                                    width: 120px;
                                    height: 24px;
                                    Tooltip { text: @markdown("Parameter lane"); }
                                }
                                Text {
                                    text: "SNAP";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: root.musical-snap-options;
                                    current-index <=> root.piano-snap-index;
                                    width: 84px;
                                    height: 24px;
                                    Tooltip { text: @markdown("Piano-roll note grid"); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "↔"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom time out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-step-width > 20px;
                                    clicked => { root.piano-step-width = max(20px, root.piano-step-width - 4px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom time in";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-step-width < 72px;
                                    clicked => { root.piano-step-width = min(72px, root.piano-step-width + 4px); }
                                }
                                Text { text: "↕"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom pitch out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-row-height > 5px;
                                    clicked => { root.piano-row-height = max(5px, root.piano-row-height - 1px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom pitch in";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-row-height < 16px;
                                    clicked => { root.piano-row-height = min(16px, root.piano-row-height + 1px); }
                                }
                            }
                        }

                        HorizontalLayout {
                            vertical-stretch: 1;

                            Rectangle {
                                width: 46px;
                                background: Theme.panel;
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        vertical-stretch: 1;
                                        clip: true;
                                        Rectangle {
                                            y: piano-scroll.viewport-y;
                                            width: parent.width;
                                            height: 49 * root.piano-row-height;
                                            for key in 49 : Rectangle {
                                                y: key * root.piano-row-height;
                                                height: root.piano-row-height;
                                                width: parent.width;
                                                property <int> note-number: root.piano-high-note - key;
                                                background: (mod(note-number, 12) == 1
                                                    || mod(note-number, 12) == 3
                                                    || mod(note-number, 12) == 6
                                                    || mod(note-number, 12) == 8
                                                    || mod(note-number, 12) == 10)
                                                    ? Theme.panel : Theme.surface;
                                                if mod(note-number, 12) == 0 : Text {
                                                    text: "C" + (floor(note-number / 12) - 1);
                                                    color: Theme.text-muted;
                                                    font-size: min(9px, root.piano-row-height - 1px);
                                                    vertical-alignment: center;
                                                    x: 3px;
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        height: 17px;
                                        text: "LANE";
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        height: 55px;
                                        text: "VEL";
                                        color: Theme.text-muted;
                                        font-size: 8px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 0px;
                                piano-scroll := ScrollView {
                                    vertical-stretch: 1;
                                    horizontal-stretch: 1;
                                    viewport-width: max(self.visible-width,
                                        root.pattern-length * root.piano-step-width);
                                    viewport-height: max(self.visible-height,
                                        49 * root.piano-row-height);
                                    Rectangle {
                                        x: 0px;
                                        width: root.pattern-length * root.piano-step-width;
                                        height: 49 * root.piano-row-height;
                                        background: Theme.surface;

                                        // Tick/note <-> pixel conversions and note
                                        // hit-testing, shared by the cursor and the
                                        // single hit area below. Kept as functions
                                        // (not per-note state) so a drag never reads
                                        // geometry that moved out from under it: see
                                        // piano-touch for why per-note TouchAreas
                                        // cannot support a drag at all.
                                        pure function note-x(start: int) -> length {
                                            return start * root.piano-step-width / 24;
                                        }
                                        pure function note-width(duration: int) -> length {
                                            return max(root.piano-snap-ticks * root.piano-step-width / 24,
                                                duration * root.piano-step-width / 24);
                                        }
                                        pure function tick-at(x: length) -> int {
                                            return floor(x * 24 / root.piano-step-width);
                                        }
                                        pure function note-at(y: length) -> int {
                                            return clamp(root.piano-high-note - floor(y / root.piano-row-height),
                                                root.piano-low-note, root.piano-high-note);
                                        }
                                        // 0 = empty grid, 1 = note body (move), 2 = right edge (resize).
                                        // The edge zone scales with the note so it stays
                                        // grabbable on a minimum-width note instead of the
                                        // fixed 5px that used to eat the whole note.
                                        pure function grab-mode-at(x: length, y: length) -> int {
                                            let hit = root.piano-note-hit-test(self.tick-at(x), self.note-at(y));
                                            if (!hit.found) {
                                                return 0;
                                            }
                                            let edge = clamp(self.note-width(hit.duration-ticks) / 4, 3px, 8px);
                                            return x >= self.note-x(hit.start-tick)
                                                    + self.note-width(hit.duration-ticks) - edge
                                                ? 2 : 1;
                                        }

                                        for key in 49 : Rectangle {
                                            y: key * root.piano-row-height;
                                            height: root.piano-row-height;
                                            width: parent.width;
                                            property <int> note-number: root.piano-high-note - key;
                                            background: (mod(note-number, 12) == 1
                                                || mod(note-number, 12) == 3
                                                || mod(note-number, 12) == 6
                                                || mod(note-number, 12) == 8
                                                || mod(note-number, 12) == 10)
                                                ? Theme.surface : Theme.surface-raised;
                                        }

                                        for division in root.pattern-length * 24 / root.piano-snap-ticks : Rectangle {
                                            x: division * root.piano-snap-ticks
                                                * root.piano-step-width / 24;
                                            width: 1px;
                                            height: parent.height;
                                            background: mod(division * root.piano-snap-ticks, 24) == 0
                                                ? Theme.text-faint : Theme.border;
                                            opacity: mod(division * root.piano-snap-ticks, 24) == 0
                                                ? 0.8 : 0.5;
                                        }

                                        for cell in root.notes : Rectangle {
                                            x: cell.start-tick * root.piano-step-width / 24;
                                            y: (root.piano-high-note - cell.note) * root.piano-row-height;
                                            width: max(root.piano-snap-ticks * root.piano-step-width / 24,
                                                cell.duration-ticks * root.piano-step-width / 24);
                                            height: root.piano-row-height;
                                            background: cell.selected ? Theme.focus : Theme.accent;
                                            opacity: 0.55 + 0.45 * cell.velocity / 127;
                                            border-width: cell.selected ? 1px : 0px;
                                            border-color: Theme.text;
                                        }

                                        // ONE hit area for the whole note grid, exactly
                                        // like the rack's grid-touch. A TouchArea living
                                        // inside a per-note Rectangle whose x/width is
                                        // bound to that note's own tick/duration moves out
                                        // from under the cursor as soon as the drag updates
                                        // the model, so mouse-x re-measures against the
                                        // moved rectangle and the delta collapses to zero
                                        // after one snap step. Hit-testing from here instead,
                                        // in this Rectangle's stable coordinates, means the
                                        // origin never moves during a drag.
                                        piano-touch := TouchArea {
                                            property <int> grabbed-id: -1;
                                            property <int> grab-mode: 0; // 0 none, 1 move, 2 resize
                                            property <length> origin-x;
                                            property <length> origin-y;
                                            property <int> original-start;
                                            property <int> original-note;
                                            property <int> original-duration;
                                            property <bool> create-click-armed;
                                            property <length> create-click-x;
                                            property <length> create-click-y;
                                            property <int> create-click-start;
                                            property <int> create-click-note;
                                            property <int> create-click-duration;
                                            create-click-timeout := Timer {
                                                interval: 350ms;
                                                running: false;
                                                triggered => {
                                                    self.running = false;
                                                    piano-touch.create-click-armed = false;
                                                }
                                            }
                                            mouse-cursor: parent.grab-mode-at(self.mouse-x, self.mouse-y) == 2 ? ew-resize
                                                : parent.grab-mode-at(self.mouse-x, self.mouse-y) == 1 ? move
                                                : crosshair;

                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    let tick = parent.tick-at(self.mouse-x);
                                                    let note = parent.note-at(self.mouse-y);
                                                    let hit = root.piano-note-hit-test(tick, note);
                                                    if (hit.found && e.button == PointerEventButton.right) {
                                                        self.create-click-armed = false;
                                                        create-click-timeout.running = false;
                                                        root.piano-note-removed(hit.id);
                                                    } else if (hit.found && e.button == PointerEventButton.left) {
                                                        self.create-click-armed = false;
                                                        create-click-timeout.running = false;
                                                        root.piano-note-selected(hit.id);
                                                        self.grabbed-id = hit.id;
                                                        self.grab-mode = parent.grab-mode-at(self.mouse-x, self.mouse-y);
                                                        self.origin-x = self.mouse-x;
                                                        self.origin-y = self.mouse-y;
                                                        self.original-start = hit.start-tick;
                                                        self.original-note = note;
                                                        self.original-duration = hit.duration-ticks;
                                                    } else if (!hit.found && e.button == PointerEventButton.left) {
                                                        let start-tick = clamp(
                                                            floor(tick / root.piano-snap-ticks) * root.piano-snap-ticks,
                                                            0, max(0, root.pattern-length * 24
                                                                - root.piano-snap-ticks));
                                                        let duration = min(root.piano-snap-ticks,
                                                            root.pattern-length * 24 - start-tick);
                                                        if (self.create-click-armed
                                                                && abs(self.mouse-x - self.create-click-x) <= 6px
                                                                && abs(self.mouse-y - self.create-click-y) <= 6px
                                                                && self.create-click-start == start-tick
                                                                && self.create-click-note == note) {
                                                            let id = root.piano-note-created(start-tick, note, duration);
                                                            self.grabbed-id = id;
                                                            self.grab-mode = 2;
                                                            self.origin-x = self.mouse-x;
                                                            self.origin-y = self.mouse-y;
                                                            self.original-start = start-tick;
                                                            self.original-note = note;
                                                            self.original-duration = duration;
                                                            self.create-click-armed = false;
                                                            create-click-timeout.running = false;
                                                        } else {
                                                            self.create-click-armed = true;
                                                            self.create-click-x = self.mouse-x;
                                                            self.create-click-y = self.mouse-y;
                                                            self.create-click-start = start-tick;
                                                            self.create-click-note = note;
                                                            self.create-click-duration = duration;
                                                            create-click-timeout.running = true;
                                                        }
                                                    }
                                                } else if (e.kind == PointerEventKind.move
                                                        && self.pressed && self.grabbed-id >= 0) {
                                                    if (self.grab-mode == 2) {
                                                        let max-duration = max(root.piano-snap-ticks,
                                                            root.pattern-length * 24 - self.original-start);
                                                        let duration = clamp(self.original-duration
                                                                + round((self.mouse-x - self.origin-x)
                                                                    * 24 / root.piano-step-width
                                                                    / root.piano-snap-ticks)
                                                                    * root.piano-snap-ticks,
                                                            min(root.piano-snap-ticks, max-duration), max-duration);
                                                        root.piano-note-resized(self.grabbed-id, duration);
                                                    } else {
                                                        let tick = clamp(self.original-start
                                                                + round((self.mouse-x - self.origin-x)
                                                                    * 24 / root.piano-step-width
                                                                    / root.piano-snap-ticks)
                                                                    * root.piano-snap-ticks,
                                                            0, max(0, root.pattern-length * 24 - self.original-duration));
                                                        let note = clamp(self.original-note
                                                                + round((self.origin-y - self.mouse-y)
                                                                    / root.piano-row-height),
                                                            root.piano-low-note, root.piano-high-note);
                                                        root.piano-note-moved(self.grabbed-id, tick, note);
                                                    }
                                                } else if (e.kind == PointerEventKind.up) {
                                                    self.grabbed-id = -1;
                                                    self.grab-mode = 0;
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 17px;
                                    background: Theme.panel;
                                    Text {
                                        text: "Velocity";
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        x: 4px;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 55px;
                                    background: Theme.surface;
                                    clip: true;
                                    Rectangle {
                                        x: -piano-scroll.viewport-x;
                                        width: root.pattern-length * root.piano-step-width;
                                        height: parent.height;
                                        background: transparent;
                                        for cell in root.notes : Rectangle {
                                            x: cell.start-tick * root.piano-step-width / 24;
                                            width: max(6px, cell.duration-ticks * root.piano-step-width / 24);
                                            height: parent.height;
                                            border-width: cell.selected ? 1px : 0px;
                                            border-color: Theme.text-muted;
                                            background: transparent;
                                            Rectangle {
                                                x: 3px;
                                                y: parent.height * (127 - cell.velocity) / 127;
                                                width: parent.width - 6px;
                                                height: max(2px, parent.height * cell.velocity / 127);
                                                background: Theme.accent;
                                            }
                                            TouchArea {
                                                mouse-cursor: crosshair;
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.left
                                                        && (e.kind == PointerEventKind.down
                                                        || (e.kind == PointerEventKind.move && self.pressed))) {
                                                        root.velocity-edited(
                                                            cell.id,
                                                            clamp(1 - self.mouse-y / self.height, 0, 1)
                                                        );
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.status-message != "" : Rectangle {
            height: 24px;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border;
            Text {
                text: root.status-message;
                color: Theme.text-muted;
                font-size: 10px;
                x: 8px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    AppearanceDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.appearance-open;
        preset <=> root.appearance-preset;
        accent-text <=> root.appearance-accent;
        validation-error: root.appearance-error;
        preview(preset, accent) => { root.appearance-preview(preset, accent); }
        save(preset, accent) => { root.appearance-save(preset, accent) }
        cancelled => { root.appearance-cancelled(); }
    }
    SavePresetDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.save-preset-open;
        title: root.save-preset-title;
        name-text <=> root.save-preset-name;
        category-text <=> root.save-preset-category;
        save-confirmed(name, category) => { root.save-preset-confirmed(name, category); }
        cancelled => { root.save-preset-cancelled(); }
    }
    ExportDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.export-open;
        format-index <=> root.export-format;
        bitrate-index <=> root.export-bitrate;
        tail-seconds <=> root.export-tail-seconds;
        accepted(format, bitrate, tail) => { root.export-confirmed(format, bitrate, tail); }
        cancelled => { root.export-open = false; }
    }
    AboutDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.about-open;
        app-version: root.app-version;
        closed => { root.about-open = false; }
    }
}
