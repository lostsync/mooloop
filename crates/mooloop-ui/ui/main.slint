import { ComboBox, HorizontalBox, ScrollView, SpinBox, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    ParameterFader, ParameterKnob, PeakMeter, SectionLabel as DesignSectionLabel,
    StereoPeakMeter, ToolButton, MuteButton as DesignMuteButton
} from "controls.slint";
import { AppearanceDialog } from "appearance-dialog.slint";
export { Theme }
export { ControlGallery } from "gallery.slint";

// One step cell used in the step-grid models.
struct StepCell {
    active: bool,
    velocity: int,
    substeps: int,
}

// One tick-addressed note event for the selected channel's piano roll.
struct NoteCell {
    id: int,
    start-tick: int,
    duration-ticks: int,
    note: int,
    velocity: int,
    selected: bool,
}

// One channel row in the rack.
struct ChannelRow {
    name: string,
    muted: bool,
    volume: float,
    pan: float,
    selected: bool,
    steps: [StepCell],
}

// One pattern instance in the song playlist.
struct PlaylistClip {
    pattern: int,
    start-half-bar: int,
    length-steps: int,
}

component FlatButton inherits ToolButton { }
component SectionLabel inherits DesignSectionLabel { }
component MuteButton inherits DesignMuteButton { }

component WaveformMarker inherits Rectangle {
    in property <string> marker-label;
    in property <color> marker-color;
    in property <float> value;
    in property <length> editor-width;
    in property <bool> label-at-bottom;
    callback moved(float);

    width: 1px;
    background: transparent;
    accessible-role: slider;
    accessible-label: root.marker-label + " marker";
    accessible-value: round(root.value * 1000) / 10 + "%";

    Rectangle {
        width: 1px;
        height: parent.height;
        background: root.marker-color;
    }
    Rectangle {
        x: clamp(-6px, -root.x, root.editor-width - root.x - 13px);
        y: root.label-at-bottom ? parent.height - 18px : 2px;
        width: 13px;
        height: 16px;
        border-radius: 2px;
        background: root.marker-color;
        Text {
            text: root.marker-label;
            color: Theme.background;
            font-size: 8px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    marker-touch := TouchArea {
        x: -7px;
        width: 15px;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                root.moved(clamp((root.x + self.x + self.mouse-x) / max(1px, root.editor-width), 0, 1));
            }
        }
    }
    Tooltip { text: @markdown("Drag the **\{root.marker-label}** marker"); }
}

export component MainWindow inherits Window {
    title: "mooloop";
    preferred-width: 1280px;
    preferred-height: 760px;
    background: Theme.background;

    // ---- transport / state exchanged with Rust ----
    in-out property <bool>  playing;
    in-out property <int>   bpm;
    in-out property <int>   beat-in-bar;
    in-out property <float> meter-l-db: -60;
    in-out property <float> meter-r-db: -60;
    in-out property <float> meter-l-held-db: -60;
    in-out property <float> meter-r-held-db: -60;
    in-out property <bool> meter-l-clipping;
    in-out property <bool> meter-r-clipping;

    // ---- appearance settings ----
    in-out property <bool> appearance-open;
    in-out property <int> appearance-preset;
    in-out property <string> appearance-accent: "#84CC16";
    in-out property <string> appearance-error;
    callback appearance-opened();
    callback appearance-preview(int, string);
    callback appearance-save(int, string) -> bool;
    callback appearance-cancelled();

    // ---- channels / patterns ----
    in-out property <[ChannelRow]> channels;
    in-out property <int> current-pattern;
    in-out property <int> pattern-length;
    in-out property <int> current-step;
    in-out property <int> selected-channel;
    in-out property <[NoteCell]> notes;
    in-out property <bool> song-mode;
    in-out property <[PlaylistClip]> playlist-clips;
    in-out property <int> playlist-position-ticks;
    in-out property <int> playlist-song-length-ticks: 384;
    in-out property <int> playlist-bars: 64;
    property <length> playlist-bar-width: 24px;
    property <int> playlist-bar-ticks: 384;

    callback step-clicked(int, int);       // channel, step
    callback step-removed(int, int);       // channel, step
    callback step-velocity-edited(int, int, float); // channel, step, normalised velocity
    callback channel-selected(int);
    callback channel-muted(int);
    callback channel-volume-changed(int, float);
    callback channel-pan-changed(int, float);
    callback add-channel-clicked();
    callback remove-channel-clicked();
    callback pattern-selected(int);
    callback pattern-length-changed(int);
    callback playback-mode-changed(bool);
    callback playlist-placement-added(int, int);   // pattern, half-bar slot
    callback playlist-placement-removed(int, int); // pattern, half-bar slot

    // ---- lower editor ----
    in-out property <int> editor-page;      // 0=Sampler, 1=Notes
    in-out property <int> selected-note-step;
    in-out property <int> selected-note;
    in-out property <int> selected-velocity;
    in-out property <int> selected-duration-ticks: 24;
    in-out property <bool> has-selected-note;
    property <int> piano-low-note: 36;
    property <int> piano-high-note: 84;
    property <length> piano-row-height: 5px;
    property <length> piano-step-width: 32px;

    callback piano-note-created(int, int);  // start tick, MIDI note
    callback piano-note-selected(int);      // stable note ID
    callback piano-note-moved(int, int, int); // ID, start tick, MIDI note
    callback piano-note-resized(int, int);  // ID, duration ticks
    callback piano-note-removed(int);       // stable note ID
    callback velocity-edited(int, float);   // stable note ID, normalised value
    callback selected-note-changed(int);
    callback selected-velocity-changed(int);
    callback selected-duration-changed(int);

    // ---- sampler params of the selected channel ----
    in-out property <float> attack;
    in-out property <float> decay;
    in-out property <float> sustain;
    in-out property <float> release;
    in-out property <float> start-pos;
    in-out property <float> end-pos: 1;
    in-out property <float> loop-start;
    in-out property <float> loop-end;
    in-out property <bool> reverse-playback;
    in-out property <int> root-note: 60;
    in-out property <float> tune-semitones;
    in-out property <float> tune-cents;
    in-out property <float> filter-cutoff;
    in-out property <float> filter-resonance;
    in-out property <float> filter-env;
    in-out property <float> sampler-drive;
    in-out property <float> bit-reduction;
    in-out property <float> rate-reduction;
    in-out property <int>   loop-mode;     // 0=Off 1=Fwd 2=Pong
    in-out property <int> voice-mode;       // 0=One Shot 1=Gate
    in-out property <int> sampler-polyphony: 1;
    in-out property <int> retrigger-mode;   // 0=Restart 1=Layer
    in-out property <int> choke-group;
    in-out property <string> sample-name;
    in-out property <string> sample-description;
    in-out property <float> sample-duration;
    in-out property <int> audio-sample-rate: 48000;
    in-out property <string> selected-channel-name;
    in-out property <[float]> waveform;
    in-out property <bool> can-previous-sample;
    in-out property <bool> can-next-sample;

    callback attack-changed(float);
    callback decay-changed(float);
    callback sustain-changed(float);
    callback release-changed(float);
    callback start-pos-changed(float);
    callback end-pos-changed(float);
    callback loop-start-changed(float);
    callback loop-end-changed(float);
    callback reverse-playback-changed(bool);
    callback root-note-changed(int);
    callback tune-semitones-changed(float);
    callback tune-cents-changed(float);
    callback loop-mode-changed(int);
    callback voice-mode-changed(int);
    callback sampler-polyphony-changed(int);
    callback retrigger-mode-changed(int);
    callback choke-group-changed(int);
    callback filter-cutoff-changed(float);
    callback filter-resonance-changed(float);
    callback filter-env-changed(float);
    callback sampler-drive-changed(float);
    callback bit-reduction-changed(float);
    callback rate-reduction-changed(float);
    callback load-sample-clicked();
    callback previous-sample-clicked();
    callback next-sample-clicked();

    // ---- transport callbacks ----
    callback play-clicked();
    callback stop-clicked();
    callback bpm-changed(int);
    callback toggle-play();

    // Keyboard transport: Space toggles play/pause. Gives an input path
    // independent of mouse clicks (also useful for diagnosing input issues).
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-play();
                accept
            } else if (event.text == Key.UpArrow) {
                root.channel-selected(max(0, root.selected-channel - 1));
                accept
            } else if (event.text == Key.DownArrow) {
                root.channel-selected(min(root.channels.length - 1, root.selected-channel + 1));
                accept
            } else {
                reject
            }
        }
    }

    VerticalBox {
        spacing: 0px;

        // ===== Toolbar =====
        Rectangle {
            height: 34px;
            background: Theme.surface;
            HorizontalBox {
                padding: 4px;
                spacing: 4px;
                alignment: start;

                FlatButton {
                    text: root.playing ? "Ⅱ" : "▶";
                    tooltip: root.playing ? "Pause (Space)" : "Play (Space)";
                    active: root.playing;
                    min-width: 30px;
                    clicked => { root.toggle-play(); }
                }
                FlatButton {
                    text: "■";
                    tooltip: "Stop";
                    text-color: root.playing ? Theme.text-muted : Theme.text;
                    min-width: 30px;
                    clicked => { root.stop-clicked(); }
                }

                Rectangle { width: 4px; }

                HorizontalLayout {
                    spacing: 1px;
                    FlatButton {
                        text: "PAT";
                        tooltip: "Play and edit the selected pattern";
                        active: !root.song-mode;
                        min-width: 38px;
                        clicked => {
                            if (root.song-mode) {
                                root.song-mode = false;
                                root.playback-mode-changed(false);
                            }
                        }
                    }
                    FlatButton {
                        text: "SONG";
                        tooltip: "Arrange and play patterns in the playlist";
                        active: root.song-mode;
                        min-width: 44px;
                        clicked => {
                            if (!root.song-mode) {
                                root.song-mode = true;
                                root.playback-mode-changed(true);
                            }
                        }
                    }
                }

                Rectangle { width: 6px; }

                // Pattern selector: buttons 1..8
                HorizontalBox {
                    padding: 0px;
                    spacing: 2px;
                    for p in 8 : FlatButton {
                        text: p + 1;
                        tooltip: "Select pattern " + (p + 1);
                        active: root.current-pattern == p;
                        min-width: 26px;
                        clicked => { root.pattern-selected(p); }
                    }
                }

                Rectangle { width: 6px; }

                Text {
                    text: "STEPS";
                    color: Theme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                SpinBox {
                    value <=> root.pattern-length;
                    minimum: 1;
                    maximum: 256;
                    step-size: 1;
                    width: 72px;
                    height: 24px;
                    edited(value) => { root.pattern-length-changed(value); }
                    Tooltip { text: @markdown("Length of the selected pattern in 16th-note steps"); }
                }

                Rectangle { width: 6px; }

                Rectangle {
                    width: 104px;
                    height: 24px;
                    background: Theme.surface-raised;
                    border-radius: 3px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 0px;
                        alignment: center;
                        Text {
                            text: "-"; color: Theme.text-muted;
                            width: 22px;
                            horizontal-alignment: center; vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    root.bpm = max(1, root.bpm - 1);
                                    root.bpm-changed(root.bpm);
                                }
                            }
                        }
                        Text {
                            text: root.bpm; color: Theme.text;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: 56px;
                        }
                        Text {
                            text: "+"; color: Theme.text-muted;
                            width: 22px;
                            horizontal-alignment: center; vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    root.bpm = min(999, root.bpm + 1);
                                    root.bpm-changed(root.bpm);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 60px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 4px;
                        alignment: center;
                        for i in 4 : Rectangle {
                            width: 10px; height: 10px;
                            border-radius: 5px;
                            background: (root.beat-in-bar == i) ? Theme.accent : Theme.border;
                        }
                    }
                }

                StereoPeakMeter {
                    left-db: root.meter-l-db;
                    right-db: root.meter-r-db;
                    held-left-db: root.meter-l-held-db;
                    held-right-db: root.meter-r-held-db;
                    left-clipping: root.meter-l-clipping;
                    right-clipping: root.meter-r-clipping;
                }

                Rectangle { horizontal-stretch: 1; }

                FlatButton {
                    text: "⚙";
                    tooltip: "Appearance settings";
                    min-width: 30px;
                    clicked => {
                        root.appearance-opened();
                        root.appearance-open = true;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ===== Channel rack: one step-grid row per channel =====
        if !root.song-mode : ScrollView {
            vertical-stretch: 1;
            viewport-width: max(self.visible-width, 300px + root.pattern-length * 27px);
            viewport-height: max(self.visible-height, root.channels.length * 32px + 48px);

            VerticalBox {
                spacing: 2px;
                padding: 8px;

                for row[ch] in root.channels : HorizontalBox {
                    padding: 2px;
                    spacing: 6px;
                    alignment: start;

                    // Channel name selects the channel for the bottom editor.
                    Rectangle {
                        width: 88px;
                        min-height: 24px;
                        border-radius: 3px;
                        background: row.selected ? Theme.surface-active : Theme.surface;
                        Text {
                            text: row.name;
                            color: row.selected ? Theme.text : Theme.text-muted;
                            font-size: 11px;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            x: 6px;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.channel-selected(ch); }
                        }
                    }

                    MuteButton {
                        muted: row.muted;
                        clicked => { root.channel-muted(ch); }
                    }

                    ParameterFader {
                        label: "V";
                        tooltip: "Channel volume: " + round(row.volume * 100) + "%";
                        value: row.volume;
                        default-value: 0.8;
                        width: 76px;
                        min-height: 18px;
                        label-width: 12px;
                        track-min-width: 56px;
                        layout-spacing: 4px;
                        changed(v) => { root.channel-volume-changed(ch, v); }
                    }

                    ParameterFader {
                        label: "P";
                        tooltip: "Channel pan: " + (abs(row.pan) < 0.01 ? "Center"
                            : row.pan < 0 ? "L " + round(abs(row.pan) * 100)
                            : "R " + round(row.pan * 100));
                        value: row.pan;
                        minimum: -1;
                        maximum: 1;
                        default-value: 0;
                        bipolar: true;
                        width: 76px;
                        min-height: 18px;
                        label-width: 12px;
                        track-min-width: 56px;
                        layout-spacing: 4px;
                        changed(v) => { root.channel-pan-changed(ch, v); }
                    }

                    // Beat grouping remains visible at any pattern length.
                    HorizontalLayout {
                        spacing: 3px;
                        for cell[i] in row.steps : Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 2px;
                            border-width: root.playing && root.current-step == i ? 1px : 0px;
                            border-color: Theme.text;
                            background: mod(i, 4) == 0 ? Theme.surface-active : Theme.surface-raised;
                            for sub in 4 : Rectangle {
                                property <int> divisor: sub == 0 ? 1 : sub == 1 ? 2 : sub == 2 ? 4 : 8;
                                visible: mod(floor(cell.substeps / self.divisor), 2) == 1;
                                x: sub * parent.width / 4;
                                y: parent.height - self.height;
                                width: parent.width / 4 - (sub < 3 ? 1px : 0px);
                                height: max(3px, parent.height * cell.velocity / 127);
                                border-radius: 1px;
                                background: Theme.accent;
                                opacity: 0.55 + 0.45 * cell.velocity / 127;
                            }
                            step-touch := TouchArea {
                                property <bool> velocity-drag;
                                mouse-cursor: pointer;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) {
                                        if (e.button == PointerEventButton.right) {
                                            root.step-removed(ch, i);
                                        } else if (e.button == PointerEventButton.left) {
                                            self.velocity-drag = e.modifiers.control;
                                            if (self.velocity-drag) {
                                                root.step-velocity-edited(ch, i,
                                                    clamp(1 - self.mouse-y / self.height, 0, 1));
                                            } else {
                                                root.step-clicked(ch, i);
                                            }
                                        }
                                    } else if (e.kind == PointerEventKind.move
                                        && self.pressed && self.velocity-drag) {
                                        root.step-velocity-edited(ch, i,
                                            clamp(1 - self.mouse-y / self.height, 0, 1));
                                    } else if (e.kind == PointerEventKind.up) {
                                        self.velocity-drag = false;
                                    }
                                }
                                Tooltip { text: @markdown("Click to toggle. **Ctrl-drag** velocity. **Right-click** to clear."); }
                            }
                        }
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 4px;
                    alignment: start;
                    FlatButton {
                        text: "+";
                        tooltip: "Add channel";
                        min-width: 28px;
                        clicked => { root.add-channel-clicked(); }
                    }
                    FlatButton {
                        text: "−";
                        tooltip: "Remove last channel";
                        min-width: 28px;
                        clicked => { root.remove-channel-clicked(); }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // ===== Song playlist: pattern rows on an absolute bar timeline =====
        if root.song-mode : ScrollView {
            vertical-stretch: 1;
            viewport-width: max(self.visible-width,
                104px + root.playlist-bars * root.playlist-bar-width);
            viewport-height: max(self.visible-height, 270px);

            playlist-canvas := Rectangle {
                width: 104px + root.playlist-bars * root.playlist-bar-width;
                height: 270px;

                Text {
                    x: 8px; y: 5px;
                    width: 88px; height: 18px;
                    text: "PATTERN";
                    color: Theme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                }

                header := Rectangle {
                    x: 104px; y: 0px;
                    width: root.playlist-bars * root.playlist-bar-width;
                    height: 28px;
                    background: Theme.surface;
                    for bar in root.playlist-bars : Rectangle {
                        x: bar * root.playlist-bar-width;
                        width: root.playlist-bar-width;
                        height: parent.height;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: bar + 1;
                            color: Theme.text-faint;
                            font-size: 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                for pattern in 8 : Rectangle {
                    x: 0px;
                    y: 30px + pattern * 28px;
                    width: playlist-canvas.width;
                    height: 26px;

                    pattern-label := Rectangle {
                        x: 8px;
                        width: 88px;
                        height: parent.height;
                        border-radius: 3px;
                        background: root.current-pattern == pattern
                            ? Theme.surface-active : Theme.surface;
                        Text {
                            x: 6px;
                            text: "Pattern " + (pattern + 1);
                            color: root.current-pattern == pattern
                                ? Theme.text : Theme.text-muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pattern-selected(pattern); }
                        }
                    }

                    timeline := Rectangle {
                        x: 104px;
                        width: root.playlist-bars * root.playlist-bar-width;
                        height: parent.height;
                        background: Theme.background;

                        for bar in root.playlist-bars : Rectangle {
                            x: bar * root.playlist-bar-width;
                            width: root.playlist-bar-width;
                            height: parent.height;
                            background: mod(bar, 4) == 0
                                ? Theme.surface : Theme.background;
                            border-width: 1px;
                            border-color: Theme.border;
                            Rectangle {
                                x: parent.width / 2;
                                width: 1px;
                                height: parent.height;
                                background: Theme.border;
                                opacity: 0.55;
                            }
                        }

                        for clip in root.playlist-clips : Rectangle {
                            visible: clip.pattern == pattern;
                            property <int> clip-start-tick:
                                clip.start-half-bar * root.playlist-bar-ticks / 2;
                            property <int> clip-end-tick:
                                self.clip-start-tick + clip.length-steps * 24;
                            x: clip.start-half-bar * root.playlist-bar-width / 2;
                            y: 2px;
                            width: max(4px,
                                clip.length-steps * root.playlist-bar-width / 16);
                            height: parent.height - 4px;
                            border-radius: 2px;
                            border-width: root.playing
                                && root.playlist-position-ticks >= self.clip-start-tick
                                && root.playlist-position-ticks < self.clip-end-tick ? 1px : 0px;
                            border-color: Theme.text;
                            background: Theme.accent;
                            opacity: root.current-pattern == pattern ? 1 : 0.62;
                            Text {
                                text: pattern + 1;
                                color: Theme.background;
                                font-size: 9px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        if root.playing : Rectangle {
                            x: root.playlist-position-ticks * root.playlist-bar-width
                                / root.playlist-bar-ticks;
                            width: 1px;
                            height: parent.height;
                            background: Theme.text;
                        }

                        Rectangle {
                            x: root.playlist-song-length-ticks * root.playlist-bar-width
                                / root.playlist-bar-ticks - 1px;
                            width: 1px;
                            height: parent.height;
                            background: Theme.text-faint;
                        }

                        playlist-touch := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    let half-bar = clamp(floor(self.mouse-x
                                        / (root.playlist-bar-width / 2)),
                                        0, root.playlist-bars * 2 - 1);
                                    if (e.button == PointerEventButton.right) {
                                        root.playlist-placement-removed(pattern, half-bar);
                                    } else if (e.button == PointerEventButton.left) {
                                        root.playlist-placement-added(pattern, half-bar);
                                    }
                                }
                            }
                            Tooltip {
                                text: @markdown("Click to place a pattern at a half-bar boundary. **Right-click** a clip to remove it.");
                            }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ===== Bottom dock: sampler and note editors =====
        Rectangle {
            height: 410px;
            background: Theme.panel;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 30px;
                    background: Theme.surface;
                    HorizontalBox {
                        padding: 3px;
                        spacing: 3px;
                        alignment: start;
                        FlatButton {
                            text: "Sampler";
                            tooltip: "Sampler controls";
                            active: root.editor-page == 0;
                            clicked => { root.editor-page = 0; }
                        }
                        FlatButton {
                            text: "Notes";
                            tooltip: "Piano roll and note parameters";
                            active: root.editor-page == 1;
                            clicked => { root.editor-page = 1; }
                        }
                        Rectangle { width: 8px; }
                        Text {
                            text: root.selected-channel-name;
                            color: Theme.text-muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                if root.editor-page == 0 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 3px;
                                FlatButton {
                                    text: "‹";
                                    tooltip: "Previous WAV in this folder";
                                    enabled: root.can-previous-sample;
                                    min-width: 28px; max-width: 28px;
                                    clicked => { root.previous-sample-clicked(); }
                                }
                                FlatButton {
                                    text: "⌕";
                                    tooltip: "Choose a WAV file";
                                    min-width: 28px; max-width: 28px;
                                    clicked => { root.load-sample-clicked(); }
                                }
                                FlatButton {
                                    text: "›";
                                    tooltip: "Next WAV in this folder";
                                    enabled: root.can-next-sample;
                                    min-width: 28px; max-width: 28px;
                                    clicked => { root.next-sample-clicked(); }
                                }
                                Rectangle { width: 5px; }
                                VerticalLayout {
                                    min-width: 180px;
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text {
                                        text: root.sample-name;
                                        color: Theme.text;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.sample-description;
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        overflow: elide;
                                    }
                                }
                                Text { text: "ROOT"; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
                                SpinBox {
                                    value <=> root.root-note;
                                    minimum: 0; maximum: 127; step-size: 1;
                                    width: 62px; height: 24px;
                                    edited(value) => { root.root-note-changed(value); }
                                    Tooltip { text: @markdown("MIDI root note for original sample pitch"); }
                                }
                                FlatButton {
                                    text: "↤";
                                    tooltip: "Reverse playback";
                                    active: root.reverse-playback;
                                    min-width: 30px; max-width: 30px;
                                    clicked => {
                                        root.reverse-playback = !root.reverse-playback;
                                        root.reverse-playback-changed(root.reverse-playback);
                                    }
                                }
                                Rectangle { width: 6px; }
                                Text { text: "LOOP"; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
                                FlatButton {
                                    text: "—"; tooltip: "Loop off"; active: root.loop-mode == 0;
                                    min-width: 30px; max-width: 30px;
                                    clicked => { root.loop-mode = 0; root.loop-mode-changed(0); }
                                }
                                FlatButton {
                                    text: "↻"; tooltip: "Forward loop"; active: root.loop-mode == 1;
                                    min-width: 30px; max-width: 30px;
                                    clicked => { root.loop-mode = 1; root.loop-mode-changed(1); }
                                }
                                FlatButton {
                                    text: "↔"; tooltip: "Ping-pong loop"; active: root.loop-mode == 2;
                                    min-width: 30px; max-width: 30px;
                                    clicked => { root.loop-mode = 2; root.loop-mode-changed(2); }
                                }
                            }
                        }

                        waveform-view := Rectangle {
                            vertical-stretch: 1;
                            min-height: 130px;
                            background: Theme.surface;
                            clip: true;

                            // Shade audio outside the selected playback region.
                            Rectangle {
                                width: clamp(root.start-pos, 0, 1) * parent.width;
                                height: parent.height;
                                background: Theme.background;
                                opacity: 0.68;
                            }
                            Rectangle {
                                x: clamp(root.end-pos, 0, 1) * parent.width;
                                width: parent.width - self.x;
                                height: parent.height;
                                background: Theme.background;
                                opacity: 0.68;
                            }
                            if root.loop-mode != 0 : Rectangle {
                                x: clamp(root.loop-start, root.start-pos, root.end-pos) * parent.width;
                                width: max(1px, (clamp(root.loop-end, root.start-pos, root.end-pos)
                                    - clamp(root.loop-start, root.start-pos, root.end-pos)) * parent.width);
                                height: parent.height;
                                background: Theme.accent-active;
                                opacity: 0.32;
                            }

                            for tick in 9 : Rectangle {
                                x: tick * parent.width / 8;
                                width: 1px;
                                height: parent.height;
                                background: Theme.border;
                                opacity: mod(tick, 2) == 0 ? 0.8 : 0.35;
                            }
                            for tick in 9 : Text {
                                visible: mod(tick, 2) == 0;
                                x: clamp(tick * parent.width / 8 - 22px, 3px, parent.width - 47px);
                                y: 3px;
                                width: 44px;
                                text: round(root.sample-duration * tick / 8 * 1000) / 1000 + "s";
                                color: Theme.text-faint;
                                font-size: 8px;
                                horizontal-alignment: center;
                            }
                            Rectangle {
                                y: parent.height / 2;
                                width: parent.width;
                                height: 1px;
                                background: Theme.border;
                            }
                            for amplitude[index] in root.waveform : Rectangle {
                                x: index * parent.width / max(1, root.waveform.length);
                                y: (parent.height - self.height) / 2;
                                width: max(1px, parent.width / max(1, root.waveform.length));
                                height: max(1px, amplitude * (parent.height - 22px));
                                background: Theme.text-muted;
                            }

                            WaveformMarker {
                                x: clamp(root.start-pos, 0, 1) * (parent.width - 1px);
                                height: parent.height; editor-width: parent.width;
                                marker-label: "S"; marker-color: Theme.accent;
                                moved(v) => {
                                    root.start-pos = min(v, root.end-pos - 0.001);
                                    root.start-pos-changed(root.start-pos);
                                    if (root.loop-start < root.start-pos) {
                                        root.loop-start = root.start-pos;
                                        root.loop-start-changed(root.loop-start);
                                    }
                                    if (root.loop-end < root.loop-start + 0.001) {
                                        root.loop-end = min(root.end-pos, root.loop-start + 0.001);
                                        root.loop-end-changed(root.loop-end);
                                    }
                                }
                            }
                            WaveformMarker {
                                x: clamp(root.end-pos, 0, 1) * (parent.width - 1px);
                                height: parent.height; editor-width: parent.width;
                                marker-label: "E"; marker-color: Theme.accent; label-at-bottom: true;
                                moved(v) => {
                                    root.end-pos = max(v, root.start-pos + 0.001);
                                    root.end-pos-changed(root.end-pos);
                                    if (root.loop-end > root.end-pos) {
                                        root.loop-end = root.end-pos;
                                        root.loop-end-changed(root.loop-end);
                                    }
                                    if (root.loop-start > root.loop-end - 0.001) {
                                        root.loop-start = max(root.start-pos, root.loop-end - 0.001);
                                        root.loop-start-changed(root.loop-start);
                                    }
                                }
                            }
                            WaveformMarker {
                                x: clamp(root.loop-start, 0, 1) * (parent.width - 1px);
                                height: parent.height; editor-width: parent.width;
                                marker-label: "L"; marker-color: root.loop-mode == 0 ? Theme.text-faint : Theme.warning;
                                label-at-bottom: true;
                                moved(v) => {
                                    root.loop-start = clamp(v, root.start-pos, root.loop-end - 0.001);
                                    root.loop-start-changed(root.loop-start);
                                }
                            }
                            WaveformMarker {
                                x: clamp(root.loop-end, 0, 1) * (parent.width - 1px);
                                height: parent.height; editor-width: parent.width;
                                marker-label: "R"; marker-color: root.loop-mode == 0 ? Theme.text-faint : Theme.warning;
                                moved(v) => {
                                    root.loop-end = clamp(v, root.loop-start + 0.001, root.end-pos);
                                    root.loop-end-changed(root.loop-end);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        Rectangle {
                            height: 168px;
                            background: Theme.panel;
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 3px;
                                alignment: start;

                                VerticalLayout {
                                    width: 116px; spacing: 3px;
                                    SectionLabel { text: "TUNE"; }
                                    HorizontalLayout {
                                        spacing: 0px;
                                        ParameterKnob {
                                            label: "Coarse"; tooltip: "Coarse tuning in semitones";
                                            value <=> root.tune-semitones;
                                            minimum: -24; maximum: 24; default-value: 0; step: 1;
                                            value-text: (root.tune-semitones > 0 ? "+" : "") + round(root.tune-semitones) + " st";
                                            changed(v) => { root.tune-semitones-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Fine"; tooltip: "Fine tuning in cents";
                                            value <=> root.tune-cents;
                                            minimum: -100; maximum: 100; default-value: 0; step: 1;
                                            value-text: (root.tune-cents > 0 ? "+" : "") + round(root.tune-cents) + " ct";
                                            changed(v) => { root.tune-cents-changed(v); }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; height: 142px; background: Theme.border; }

                                VerticalLayout {
                                    width: 180px; spacing: 5px;
                                    SectionLabel { text: "VOICE"; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "MODE"; color: Theme.text-faint; font-size: 8px; }
                                            ComboBox {
                                                model: ["One Shot", "Gate"];
                                                current-index <=> root.voice-mode;
                                                width: 105px; height: 24px;
                                                selected(value) => { root.voice-mode-changed(self.current-index); }
                                                Tooltip { text: @markdown("**One Shot** plays the region or exits a loop into its tail. **Gate** follows note length and envelope release."); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "VOICES"; color: Theme.text-faint; font-size: 8px; }
                                            SpinBox {
                                                value <=> root.sampler-polyphony;
                                                minimum: 1; maximum: 16; step-size: 1;
                                                width: 62px; height: 24px;
                                                edited(value) => { root.sampler-polyphony-changed(value); }
                                                Tooltip { text: @markdown("Maximum simultaneous sample voices"); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "RETRIGGER"; color: Theme.text-faint; font-size: 8px; }
                                            ComboBox {
                                                model: ["Restart", "Layer"];
                                                current-index <=> root.retrigger-mode;
                                                width: 105px; height: 24px;
                                                selected(value) => { root.retrigger-mode-changed(self.current-index); }
                                                Tooltip { text: @markdown("**Restart** replaces a matching pitch. **Layer** stacks repeated notes."); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "CHOKE"; color: Theme.text-faint; font-size: 8px; }
                                            SpinBox {
                                                value <=> root.choke-group;
                                                minimum: 0; maximum: 16; step-size: 1;
                                                width: 62px; height: 24px;
                                                edited(value) => { root.choke-group-changed(value); }
                                                Tooltip { text: @markdown("Matching non-zero groups choke each other. **0** is off."); }
                                            }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; height: 142px; background: Theme.border; }

                                VerticalLayout {
                                    width: 230px; spacing: 3px;
                                    SectionLabel { text: "FILTER"; }
                                    HorizontalLayout {
                                        spacing: 1px;
                                        ParameterKnob {
                                            label: "Cutoff"; tooltip: "Low-pass filter cutoff";
                                            value <=> root.filter-cutoff; default-value: 1;
                                            value-text: root.filter-cutoff >= 0.999 ? "Open"
                                                : round(20 * pow(root.audio-sample-rate * 0.45 / 20,
                                                    root.filter-cutoff)) + " Hz";
                                            changed(v) => { root.filter-cutoff-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Reso"; tooltip: "Filter resonance";
                                            value <=> root.filter-resonance; default-value: 0;
                                            value-text: round(root.filter-resonance * 100) + "%";
                                            changed(v) => { root.filter-resonance-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Env"; tooltip: "Bipolar amplitude-envelope modulation of cutoff";
                                            value <=> root.filter-env; default-value: 0.5; fill: Theme.warning;
                                            value-text: (round((root.filter-env * 2 - 1) * 100) > 0 ? "+" : "")
                                                + round((root.filter-env * 2 - 1) * 100) + "%";
                                            changed(v) => { root.filter-env-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Drive"; tooltip: "Pre-filter soft saturation";
                                            value <=> root.sampler-drive; default-value: 0; fill: Theme.warning;
                                            value-text: round(root.sampler-drive * 100) + "%";
                                            changed(v) => { root.sampler-drive-changed(v); }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; height: 142px; background: Theme.border; }

                                VerticalLayout {
                                    width: 230px; spacing: 3px;
                                    SectionLabel { text: "AMP ENVELOPE"; }
                                    HorizontalLayout {
                                        spacing: 1px;
                                        ParameterKnob {
                                            label: "Attack"; tooltip: "Amplitude attack";
                                            value <=> root.attack; default-value: 0;
                                            value-text: round(root.attack * 5000) + " ms";
                                            changed(v) => { root.attack-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Decay"; tooltip: "Amplitude decay";
                                            value <=> root.decay; default-value: 0.05;
                                            value-text: round(root.decay * 5000) + " ms";
                                            changed(v) => { root.decay-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Sustain"; tooltip: "Amplitude sustain level";
                                            value <=> root.sustain; default-value: 1;
                                            value-text: round(root.sustain * 100) + "%";
                                            changed(v) => { root.sustain-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Release"; tooltip: "Amplitude release";
                                            value <=> root.release; default-value: 0.01;
                                            value-text: round(root.release * 5000) + " ms";
                                            changed(v) => { root.release-changed(v); }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; height: 142px; background: Theme.border; }

                                VerticalLayout {
                                    width: 116px; spacing: 3px;
                                    SectionLabel { text: "LO-FI"; }
                                    HorizontalLayout {
                                        spacing: 0px;
                                        ParameterKnob {
                                            label: "Bits"; tooltip: "Bit-depth reduction";
                                            value <=> root.bit-reduction; default-value: 0; fill: Theme.warning;
                                            value-text: round(16 - root.bit-reduction * 12) + " bit";
                                            changed(v) => { root.bit-reduction-changed(v); }
                                        }
                                        ParameterKnob {
                                            label: "Rate"; tooltip: "Sample-rate reduction";
                                            value <=> root.rate-reduction; default-value: 0; fill: Theme.warning;
                                            value-text: "÷" + round(1 + root.rate-reduction * 31);
                                            changed(v) => { root.rate-reduction-changed(v); }
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }

                if root.editor-page == 1 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalBox {
                                padding: 4px;
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: root.has-selected-note ? "TICK " + root.selected-note-step : "NO NOTE";
                                    color: Theme.text-muted;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "NOTE";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-note;
                                    minimum: root.piano-low-note;
                                    maximum: root.piano-high-note;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-note-changed(value); }
                                    Tooltip { text: @markdown("Selected step MIDI note"); }
                                }
                                Text {
                                    text: "VEL";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-velocity;
                                    minimum: 1;
                                    maximum: 127;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-velocity-changed(value); }
                                    Tooltip { text: @markdown("Selected step velocity"); }
                                }
                                Text {
                                    text: "LEN";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-duration-ticks;
                                    minimum: 1;
                                    maximum: max(1, root.pattern-length * 24);
                                    step-size: 6;
                                    width: 78px;
                                    height: 24px;
                                    edited(value) => { root.selected-duration-changed(value); }
                                    Tooltip { text: @markdown("Selected note length in PPQ ticks. **6** ticks = 1/64 note."); }
                                }
                                Rectangle { width: 8px; }
                                ComboBox {
                                    model: ["Velocity"];
                                    current-index: 0;
                                    current-value: "Velocity";
                                    width: 120px;
                                    height: 24px;
                                    Tooltip { text: @markdown("Parameter lane"); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "↔"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom time out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-step-width > 20px;
                                    clicked => { root.piano-step-width = max(20px, root.piano-step-width - 4px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom time in";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-step-width < 72px;
                                    clicked => { root.piano-step-width = min(72px, root.piano-step-width + 4px); }
                                }
                                Text { text: "↕"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom pitch out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-row-height > 5px;
                                    clicked => { root.piano-row-height = max(5px, root.piano-row-height - 1px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom pitch in";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.piano-row-height < 16px;
                                    clicked => { root.piano-row-height = min(16px, root.piano-row-height + 1px); }
                                }
                            }
                        }

                        HorizontalLayout {
                            vertical-stretch: 1;

                            Rectangle {
                                width: 46px;
                                background: Theme.panel;
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        vertical-stretch: 1;
                                        clip: true;
                                        Rectangle {
                                            y: -piano-scroll.viewport-y;
                                            width: parent.width;
                                            height: 49 * root.piano-row-height;
                                            for key in 49 : Rectangle {
                                                y: key * root.piano-row-height;
                                                height: root.piano-row-height;
                                                width: parent.width;
                                                property <int> note-number: root.piano-high-note - key;
                                                background: (mod(note-number, 12) == 1
                                                    || mod(note-number, 12) == 3
                                                    || mod(note-number, 12) == 6
                                                    || mod(note-number, 12) == 8
                                                    || mod(note-number, 12) == 10)
                                                    ? Theme.panel : Theme.surface;
                                                if mod(note-number, 12) == 0 : Text {
                                                    text: "C" + (floor(note-number / 12) - 1);
                                                    color: Theme.text-muted;
                                                    font-size: min(9px, root.piano-row-height - 1px);
                                                    vertical-alignment: center;
                                                    x: 3px;
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        height: 17px;
                                        text: "LANE";
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        height: 55px;
                                        text: "VEL";
                                        color: Theme.text-muted;
                                        font-size: 8px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 0px;
                                piano-scroll := ScrollView {
                                    vertical-stretch: 1;
                                    horizontal-stretch: 1;
                                    viewport-width: max(self.visible-width,
                                        root.pattern-length * root.piano-step-width);
                                    viewport-height: max(self.visible-height,
                                        49 * root.piano-row-height);
                                    Rectangle {
                                        x: 0px;
                                        width: root.pattern-length * root.piano-step-width;
                                        height: 49 * root.piano-row-height;
                                        background: Theme.surface;

                                        for key in 49 : Rectangle {
                                            y: key * root.piano-row-height;
                                            height: root.piano-row-height;
                                            width: parent.width;
                                            property <int> note-number: root.piano-high-note - key;
                                            background: (mod(note-number, 12) == 1
                                                || mod(note-number, 12) == 3
                                                || mod(note-number, 12) == 6
                                                || mod(note-number, 12) == 8
                                                || mod(note-number, 12) == 10)
                                                ? Theme.surface : Theme.surface-raised;
                                        }

                                        for division in root.pattern-length * 4 : Rectangle {
                                            x: division * root.piano-step-width / 4;
                                            width: 1px;
                                            height: parent.height;
                                            background: mod(division, 4) == 0 ? Theme.text-faint : Theme.border;
                                            opacity: mod(division, 4) == 0 ? 0.8 : 0.5;
                                        }

                                        TouchArea {
                                            mouse-cursor: crosshair;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down
                                                    && e.button == PointerEventButton.left) {
                                                    let start-tick = clamp(
                                                        floor(self.mouse-x / (root.piano-step-width / 4)) * 6,
                                                        0, root.pattern-length * 24 - 6);
                                                    let note = clamp(
                                                        root.piano-high-note
                                                            - floor(self.mouse-y / root.piano-row-height),
                                                        root.piano-low-note,
                                                        root.piano-high-note);
                                                    root.piano-note-created(start-tick, note);
                                                }
                                            }
                                        }

                                        for cell in root.notes : Rectangle {
                                            x: cell.start-tick * root.piano-step-width / 24;
                                            y: (root.piano-high-note - cell.note) * root.piano-row-height;
                                            width: max(root.piano-step-width / 4,
                                                cell.duration-ticks * root.piano-step-width / 24);
                                            height: root.piano-row-height;
                                            background: cell.selected ? Theme.focus : Theme.accent;
                                            opacity: 0.55 + 0.45 * cell.velocity / 127;
                                            border-width: cell.selected ? 1px : 0px;
                                            border-color: Theme.text;

                                            note-touch := TouchArea {
                                                width: max(1px, parent.width - 5px);
                                                property <bool> dragging-note;
                                                property <length> origin-x;
                                                property <length> origin-y;
                                                property <int> original-start;
                                                property <int> original-note;
                                                mouse-cursor: move;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down
                                                        && e.button == PointerEventButton.right) {
                                                        root.piano-note-removed(cell.id);
                                                    } else if (e.kind == PointerEventKind.down
                                                        && e.button == PointerEventButton.left) {
                                                        root.piano-note-selected(cell.id);
                                                        self.dragging-note = true;
                                                        self.origin-x = self.mouse-x;
                                                        self.origin-y = self.mouse-y;
                                                        self.original-start = cell.start-tick;
                                                        self.original-note = cell.note;
                                                    } else if (e.kind == PointerEventKind.move
                                                        && self.pressed && self.dragging-note) {
                                                        let tick = clamp(self.original-start
                                                            + round((self.mouse-x - self.origin-x)
                                                                / (root.piano-step-width / 4)) * 6,
                                                            0, root.pattern-length * 24 - 6);
                                                        let note = clamp(self.original-note
                                                            + round((self.origin-y - self.mouse-y)
                                                                / root.piano-row-height),
                                                            root.piano-low-note, root.piano-high-note);
                                                        root.piano-note-moved(cell.id, tick, note);
                                                    } else if (e.kind == PointerEventKind.up) {
                                                        self.dragging-note = false;
                                                    }
                                                }
                                            }
                                            resize-touch := TouchArea {
                                                x: parent.width - 5px;
                                                width: 5px;
                                                property <length> origin-x;
                                                property <int> original-duration;
                                                mouse-cursor: ew-resize;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down
                                                        && e.button == PointerEventButton.left) {
                                                        root.piano-note-selected(cell.id);
                                                        self.origin-x = self.mouse-x;
                                                        self.original-duration = cell.duration-ticks;
                                                    } else if (e.kind == PointerEventKind.move && self.pressed) {
                                                        let duration = clamp(self.original-duration
                                                            + round((self.mouse-x - self.origin-x)
                                                                / (root.piano-step-width / 4)) * 6,
                                                            1, root.pattern-length * 24 - cell.start-tick);
                                                        root.piano-note-resized(cell.id, duration);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 17px;
                                    background: Theme.panel;
                                    Text {
                                        text: "Velocity";
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        x: 4px;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 55px;
                                    background: Theme.surface;
                                    clip: true;
                                    Rectangle {
                                        x: -piano-scroll.viewport-x;
                                        width: root.pattern-length * root.piano-step-width;
                                        height: parent.height;
                                        background: transparent;
                                        for cell in root.notes : Rectangle {
                                            x: cell.start-tick * root.piano-step-width / 24;
                                            width: max(6px, cell.duration-ticks * root.piano-step-width / 24);
                                            height: parent.height;
                                            border-width: cell.selected ? 1px : 0px;
                                            border-color: Theme.text-muted;
                                            background: transparent;
                                            Rectangle {
                                                x: 3px;
                                                y: parent.height * (127 - cell.velocity) / 127;
                                                width: parent.width - 6px;
                                                height: max(2px, parent.height * cell.velocity / 127);
                                                background: Theme.accent;
                                            }
                                            TouchArea {
                                                mouse-cursor: crosshair;
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.left
                                                        && (e.kind == PointerEventKind.down
                                                        || (e.kind == PointerEventKind.move && self.pressed))) {
                                                        root.velocity-edited(
                                                            cell.id,
                                                            clamp(1 - self.mouse-y / self.height, 0, 1)
                                                        );
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    AppearanceDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.appearance-open;
        preset <=> root.appearance-preset;
        accent-text <=> root.appearance-accent;
        validation-error: root.appearance-error;
        preview(preset, accent) => { root.appearance-preview(preset, accent); }
        save(preset, accent) => { root.appearance-save(preset, accent) }
        cancelled => { root.appearance-cancelled(); }
    }
}
