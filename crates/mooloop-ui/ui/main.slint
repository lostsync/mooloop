    in-out property <float> mono-lfo-filter;
    in-out property <float> mono-lfo-pulse-width;
    in-out property <float> mono-lfo-amp;
    callback mono-osc1-wave-changed(int); callback mono-osc1-semitones-changed(float); callback mono-osc1-cents-changed(float); callback mono-osc1-level-changed(float); callback mono-osc1-pulse-width-changed(float);
    callback mono-osc2-wave-changed(int); callback mono-osc2-semitones-changed(float); callback mono-osc2-cents-changed(float); callback mono-osc2-level-changed(float); callback mono-osc2-pulse-width-changed(float);
    callback mono-osc3-wave-changed(int); callback mono-osc3-semitones-changed(float); callback mono-osc3-cents-changed(float); callback mono-osc3-level-changed(float); callback mono-osc3-pulse-width-changed(float);
    callback mono-glide-changed(float); callback mono-attack-changed(float); callback mono-decay-changed(float); callback mono-sustain-changed(float); callback mono-release-changed(float);
    callback mono-filter-cutoff-changed(float); callback mono-filter-resonance-changed(float); callback mono-filter-env-changed(float); callback mono-drive-changed(float);
    callback mono-lfo-wave-changed(int); callback mono-lfo-rate-changed(float); callback mono-lfo-retrigger-changed(bool);
    callback mono-lfo-pitch-changed(float); callback mono-lfo-filter-changed(float); callback mono-lfo-pulse-width-changed(float); callback mono-lfo-amp-changed(float);

    // ---- poly synth params of the selected channel ----
    in-out property <int> poly-osc1-wave: 2;
    in-out property <float> poly-osc1-semitones;
    in-out property <float> poly-osc1-cents;
    in-out property <float> poly-osc1-level: 0.8;
    in-out property <float> poly-osc1-pulse-width: 0.5;
    in-out property <int> poly-osc2-wave: 2;
    in-out property <float> poly-osc2-semitones: 12;
    in-out property <float> poly-osc2-cents: 4;
    in-out property <float> poly-osc2-level;
    in-out property <float> poly-osc2-pulse-width: 0.5;
    in-out property <int> poly-osc3-wave: 2;
    in-out property <float> poly-osc3-semitones: -12;
    in-out property <float> poly-osc3-cents: -4;
    in-out property <float> poly-osc3-level;
    in-out property <float> poly-osc3-pulse-width: 0.5;
    in-out property <float> poly-glide;
    in-out property <float> poly-attack: 0.005;
    in-out property <float> poly-decay: 0.2;
    in-out property <float> poly-sustain: 0.7;
    in-out property <float> poly-release: 0.15;
    in-out property <float> poly-filter-cutoff: 1;
    in-out property <float> poly-filter-resonance;
    in-out property <float> poly-filter-env;
    in-out property <float> poly-drive;
    in-out property <int> poly-lfo-wave;
    in-out property <float> poly-lfo-rate: 5;
    in-out property <bool> poly-lfo-retrigger;
    in-out property <float> poly-lfo-pitch;
    in-out property <float> poly-lfo-filter;
    in-out property <float> poly-lfo-pulse-width;
    in-out property <float> poly-lfo-amp;
    in-out property <int> poly-polyphony: 8;
    in-out property <float> poly-spread;
    callback poly-osc1-wave-changed(int); callback poly-osc1-semitones-changed(float); callback poly-osc1-cents-changed(float); callback poly-osc1-level-changed(float); callback poly-osc1-pulse-width-changed(float);
    callback poly-osc2-wave-changed(int); callback poly-osc2-semitones-changed(float); callback poly-osc2-cents-changed(float); callback poly-osc2-level-changed(float); callback poly-osc2-pulse-width-changed(float);
    callback poly-osc3-wave-changed(int); callback poly-osc3-semitones-changed(float); callback poly-osc3-cents-changed(float); callback poly-osc3-level-changed(float); callback poly-osc3-pulse-width-changed(float);
    callback poly-glide-changed(float); callback poly-attack-changed(float); callback poly-decay-changed(float); callback poly-sustain-changed(float); callback poly-release-changed(float);
    callback poly-filter-cutoff-changed(float); callback poly-filter-resonance-changed(float); callback poly-filter-env-changed(float); callback poly-drive-changed(float);
    callback poly-lfo-wave-changed(int); callback poly-lfo-rate-changed(float); callback poly-lfo-retrigger-changed(bool);
    callback poly-lfo-pitch-changed(float); callback poly-lfo-filter-changed(float); callback poly-lfo-pulse-width-changed(float); callback poly-lfo-amp-changed(float);
    callback poly-polyphony-changed(int); callback poly-spread-changed(float);

    // ---- transport callbacks ----
    callback new-song();
    callback play-clicked();
    callback stop-clicked();
    callback bpm-changed(int);
    callback swing-changed(int);
    callback toggle-play();

    // Every action a shortcut can target is named and looked up in Rust
    // (see `actions.rs`); this window only decodes a raw key event into a
    // canonical (key, ctrl, shift, alt, meta) tuple and hands it off. The
    // return value says whether some action consumed it. See
    // `docs/ACTIONS.md`.
    callback shortcut-key(string, bool, bool, bool, bool) -> bool;
    callback pattern-remove-requested();
    callback pattern-clone-requested();
    callback pattern-clear-requested();
    callback select-all-requested();
    callback delete-selected-notes-requested();

    // Only the piano roll actually zooms today (the playlist has a snap
    // picker but no zoom, and the step grid/mixer aren't zoomable), so
    // these implement themselves here rather than round-tripping through
    // Rust: `piano-step-width` is a private view property, not exposed to
    // Rust. Same 1.15/0.87 factor the existing Ctrl+Shift+wheel handler on
    // the piano roll's time scrollbar uses. Unlike that pointer-centered
    // version, this doesn't re-center the scroll position -- doing so needs
    // the `piano-scroll` id, which (unlike `root.piano-step-width`) isn't
    // reachable from this root-level callback, only from within its own
    // nested scroll area -- so a keyboard zoom just changes scale in place.
    callback zoom-in-requested();
    zoom-in-requested => {
        if (root.editor-page == 1) {
            root.piano-step-width = clamp(root.piano-step-width * 1.15, 20px, 72px);
        }
    }
    callback zoom-out-requested();
    zoom-out-requested => {
        if (root.editor-page == 1) {
            root.piano-step-width = clamp(root.piano-step-width * 0.87, 20px, 72px);
        }
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.preferences-open) {
                // The Shortcuts prefpane owns key capture for (re)binding
                // while it's open; no global action should fire underneath it.
                reject
            } else if (event.text == Key.UpArrow && !event.modifiers.control) {
                root.channel-selected(max(0, root.selected-channel - 1));
                accept
            } else if (event.text == Key.DownArrow && !event.modifiers.control) {
                root.channel-selected(min(root.channels.length - 1, root.selected-channel + 1));
                accept
            } else if (event.text == " ") {
                root.shortcut-key("space", false, false, false, false) ? accept : reject
            } else if (event.text == Key.LeftArrow) {
                root.shortcut-key("left", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.RightArrow) {
                root.shortcut-key("right", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.UpArrow) {
                root.shortcut-key("up", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.DownArrow) {
                root.shortcut-key("down", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Delete) {
                root.shortcut-key("delete", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Backspace) {
                root.shortcut-key("backspace", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Escape) {
                root.shortcut-key("escape", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Tab) {
                root.shortcut-key("tab", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Return) {
                root.shortcut-key("return", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Home) {
                root.shortcut-key("home", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.End) {
                root.shortcut-key("end", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.PageUp) {
                root.shortcut-key("pageup", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.PageDown) {
                root.shortcut-key("pagedown", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == Key.Insert) {
                root.shortcut-key("insert", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            // A bare modifier keypress (pressing Ctrl down, before whatever
            // it's chorded with) reports `event.text` as that modifier's own
            // key code -- and Slint's codes for Shift/Control/Alt/AltGr/
            // CapsLock/ShiftR/ControlR/Meta/MetaR (0x10-0x18) land exactly on
            // top of the Ctrl+P..Ctrl+X sentinel range below. Left
            // unguarded, pressing Ctrl alone was resolving as Ctrl+Q (quit)
            // on every single Ctrl+<something> shortcut. Reject these
            // outright before the sentinel ladder gets a chance to
            // misread them.
            } else if (event.text == Key.Shift || event.text == Key.Control
                    || event.text == Key.Alt || event.text == Key.AltGr
                    || event.text == Key.CapsLock || event.text == Key.ShiftR
                    || event.text == Key.ControlR || event.text == Key.Meta
                    || event.text == Key.MetaR) {
                reject
            // Ctrl+<letter> arrives as the raw ASCII control code for that
            // letter (0x01 = Ctrl+A .. 0x1A = Ctrl+Z) on some backends,
            // rather than as plain text with `event.modifiers.control` set
            // -- a terminal-era convention, not a Slint quirk. `shift` stays
            // reliable from `event.modifiers` either way. Written out once,
            // mechanically; a new Ctrl+letter action never needs a new
            // branch here, only a new `actions.rs` entry. Ctrl+H/I/J are
            // not decoded here because their control codes (0x08/0x09/0x0A)
            // are indistinguishable from Backspace/Tab/Return, which are
            // handled above.
            } else if (event.text == "\u{1}") {
                root.shortcut-key("a", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{2}") {
                root.shortcut-key("b", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{3}") {
                root.shortcut-key("c", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{4}") {
                root.shortcut-key("d", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{5}") {
                root.shortcut-key("e", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{6}") {
                root.shortcut-key("f", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{7}") {
                root.shortcut-key("g", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{b}") {
                root.shortcut-key("k", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{c}") {
                root.shortcut-key("l", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{d}") {
                root.shortcut-key("m", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{e}") {
                root.shortcut-key("n", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{f}") {
                root.shortcut-key("o", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{10}") {
                root.shortcut-key("p", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{11}") {
                root.shortcut-key("q", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{12}") {
                root.shortcut-key("r", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{13}") {
                root.shortcut-key("s", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{14}") {
                root.shortcut-key("t", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{15}") {
                root.shortcut-key("u", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{16}") {
                root.shortcut-key("v", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{17}") {
                root.shortcut-key("w", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{18}") {
                root.shortcut-key("x", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{19}") {
                root.shortcut-key("y", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.text == "\u{1a}") {
                root.shortcut-key("z", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else if (event.modifiers.control) {
                // Non-letter Ctrl combos (digits, `=`, `-`, ...) are
                // reported reliably via `event.modifiers.control` on this
                // backend, so no sentinel decoding is needed for them.
                root.shortcut-key(event.text.to-lowercase(), true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? accept : reject
            } else {
                reject
            }
        }
    }

    VerticalBox {
        spacing: 0px;

        // ===== Menu bar =====
        //
        // The concrete menus live here, where every root callback is in
        // scope: an item is one MenuRow line, a new action is one callback
        // on the window plus one line. Rows whose feature does not exist
        // yet are kept disabled on purpose so the menu documents what is
        // being built toward.
        menu-bar := MenuBar {
            MenuBarItem {
                title: "File";
                menu-id: 0;
                open-menu <=> menu-bar.open-menu;
                titles: menu-bar.titles;
                bar-width: menu-bar.width;
                enabled: !root.document-busy;

                // Target: start a fresh song from scratch.
                MenuRow { text: "New Song"; shortcut: "Ctrl+N"; enabled: false; selected => { } }
                MenuRow {
                    text: "Open Song...";
                    shortcut: "Ctrl+O";
                    selected => { root.open-song(); }
                }
                MenuRow {
                    text: "Save Song";
                    shortcut: "Ctrl+S";
                    selected => { root.save-song(); }
                }
                MenuRow {
                    text: "Save Song As...";
                    shortcut: "Ctrl+Shift+S";
                    selected => { root.save-song-as(); }
                }
                MenuSeparator {}
                MenuRow { text: "Load Kit..."; selected => { root.load-kit(); } }
                MenuRow { text: "Save Kit..."; selected => { root.save-kit(); } }
                MenuRow { text: "Load Channel..."; selected => { root.load-channel(); } }
                MenuRow { text: "Save Channel..."; selected => { root.save-channel(); } }
                MenuSeparator {}
                MenuRow {
                    text: "Embed samples";
                    checked: root.embed-assets;
                    selected => { root.embed-assets = !root.embed-assets; }
                }
                MenuSeparator {}
                MenuRow {
                    text: "Export Audio...";
                    shortcut: "Ctrl+E";
                    selected => { root.export-audio(); }
                }
                MenuSeparator {}
                MenuRow {
                    text: "Quit";
                    shortcut: "Ctrl+Q";
                    selected => { root.quit-requested(); }
                }
            }

            MenuBarItem {
                title: "Edit";
                menu-id: 1;
                open-menu <=> menu-bar.open-menu;
                titles: menu-bar.titles;
                bar-width: menu-bar.width;
                // Undo is still pending, but channel clipboard actions are
                // concrete project edits and therefore live here too.
                MenuRow { text: "Undo"; shortcut: "Ctrl+Z"; enabled: root.can-undo; selected => { root.edit-command-requested(0, root.selected-channel); } }
                MenuRow { text: "Redo"; shortcut: "Ctrl+Shift+Z"; enabled: root.can-redo; selected => { root.edit-command-requested(1, root.selected-channel); } }
                MenuSeparator {}
                MenuRow { text: "Cut Channel"; shortcut: "Ctrl+X"; enabled: root.channels.length > 1; selected => { root.edit-command-requested(2, root.selected-channel); } }
                MenuRow { text: "Copy Channel"; shortcut: "Ctrl+C"; selected => { root.edit-command-requested(3, root.selected-channel); } }
                MenuRow { text: "Paste Channel"; shortcut: "Ctrl+V"; enabled: root.channel-clipboard-available && root.channels.length < 16; selected => { root.edit-command-requested(4, root.selected-channel); } }
                MenuSeparator {}
                MenuRow { text: "Select All"; shortcut: "Ctrl+A"; selected => { root.select-all-requested(); } }
                MenuRow { text: "Delete Selected Notes"; shortcut: "Delete"; selected => { root.delete-selected-notes-requested(); } }
            }

            MenuBarItem {
                title: "Pattern";
                menu-id: 2;
                open-menu <=> menu-bar.open-menu;
                titles: menu-bar.titles;
                bar-width: menu-bar.width;
                MenuRow {
                    text: "New Pattern";
                    shortcut: "Ctrl+Shift+P";
                    enabled: root.pattern-count < 256;
                    selected => { root.add-pattern-clicked(); }
                }
                MenuRow {
                    text: "Clone Pattern";
                    shortcut: "Ctrl+Alt+D";
                    enabled: root.pattern-count < 256;
                    selected => { root.pattern-clone-requested(); }
                }
                MenuSeparator {}
                MenuRow { text: "Clear Pattern"; selected => { root.pattern-clear-requested(); } }
                MenuRow {
                    text: "Delete Pattern";
                    shortcut: "Ctrl+Shift+Delete";
                    enabled: root.pattern-count > 1;
                    selected => { root.pattern-remove-requested(); }
                }
            }

            MenuBarItem {
                title: "Channel";
                menu-id: 3;
                open-menu <=> menu-bar.open-menu;
                titles: menu-bar.titles;
                bar-width: menu-bar.width;
                MenuRow {
                    text: "Add Channel";
                    selected => { root.add-channel-clicked(0); }
                }
                MenuRow {
                    text: "Delete Selected Channel";
                    enabled: root.channels.length > 1;
                    selected => { root.edit-command-requested(6, root.selected-channel); }
                }
                MenuSeparator {}
                MenuRow { text: "Clone Channel"; enabled: root.channels.length < 16; selected => { root.edit-command-requested(5, root.selected-channel); } }
                MenuRow { text: "Copy Channel"; selected => { root.edit-command-requested(3, root.selected-channel); } }
                MenuRow { text: "Paste Channel"; enabled: root.channel-clipboard-available && root.channels.length < 16; selected => { root.edit-command-requested(4, root.selected-channel); } }
            }

            MenuBarItem {
                title: "View";
                menu-id: 4;
                open-menu <=> menu-bar.open-menu;
                titles: menu-bar.titles;
                bar-width: menu-bar.width;
                MenuRow {
                    text: "Sampler";
                    checked: root.editor-page == 0;
                    selected => { root.editor-page = 0; }
                }
                MenuRow {
                    text: "Notes";
                    checked: root.editor-page == 1;
                    selected => { root.editor-page = 1; }
                }
                MenuRow {
                    text: "Playlist";
                    checked: root.editor-page == 2;
                    selected => { root.editor-page = 2; }
                }
                MenuSeparator {}
                MenuRow {
                    text: "Preferences...";
                    selected => {
                        root.preferences-opened();
                        root.preferences-open = true;
                    }
                }
            }

            MenuBarItem {
                title: "Help";
                menu-id: 5;
                open-menu <=> menu-bar.open-menu;
                titles: menu-bar.titles;
                bar-width: menu-bar.width;
                MenuRow { text: "About mooloop"; selected => { root.about-open = true; } }
            }
        }

        // ===== Toolbar =====
        //
        // Two rows, split by what they answer. The transport row is the state
        // of playback and never changes meaning; the edit row is what the
        // current click will do. Mixing the two into one strip is what made
        // the old bar read as a row of unrelated buttons.
        Rectangle {
            height: 62px;
            background: Theme.surface;

            VerticalLayout {
                spacing: 0px;

                // --- Transport row -----------------------------------------
                Rectangle {
                    height: 32px;
                    HorizontalBox {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 3px;

                        TransportButton {
                            text: root.playing ? "⏸" : "▶";
                            tooltip: root.playing ? "Pause (Space)" : "Play (Space)";
                            role: "play";
                            active: root.playing;
                            clicked => { root.toggle-play(); }
                        }
                        TransportButton {
                            text: "■";
                            tooltip: "Stop";
                            enabled: root.playing || root.current-step > 0;
                            clicked => { root.stop-clicked(); }
                        }

                        ToolbarRule {}

                        SegmentedControl {
                            width: 96px;
                            height: 24px;
                            options: ["PAT", "SONG"];
                            selected-index: root.song-mode ? 1 : 0;
                            selected(i) => {
                                if ((i == 1) != root.song-mode) {
                                    root.song-mode = i == 1;
                                    root.playback-mode-changed(root.song-mode);
                                }
                            }
                        }

                        ToolbarRule {}

                        PositionReadout {
                            bar: root.position-bar;
                            beat: root.position-beat;
                            tick: root.position-tick;
                            changed hovered => {
                                root.hover-hint = self.hovered ? "Position as bar:beat:tick"
                                    : root.hover-hint == "Position as bar:beat:tick" ? "" : root.hover-hint;
                            }
                        }
                        BeatLamps {
                            current: root.beat-in-bar;
                            running: root.playing;
                        }

                        ToolbarRule {}

                        TempoField {
                            bpm <=> root.bpm;
                            changed(v) => { root.bpm-changed(v); }
                            changed hovered => {
                                root.hover-hint = self.hovered
                                    ? "Drag to change, double-click to type."
                                    : root.hover-hint == "Drag to change, double-click to type."
                                        ? "" : root.hover-hint;
                            }
                        }

                        StepperField {
                            label: "SWING";
                            tooltip: "Global sixteenth-note swing; 50% is straight";
                            value <=> root.swing-percent;
                            minimum: 50;
                            maximum: 75;
                            display-text: root.swing-percent + "%";
                            value-width: 28px;
                            changed(v) => { root.swing-changed(v); }
                        }

                        Rectangle { horizontal-stretch: 1; min-width: 8px; }

                        MasterMeter {
                            width: 200px;
                            left-db: root.meter-l-db;
                            right-db: root.meter-r-db;
                            held-left-db: root.meter-l-held-db;
                            held-right-db: root.meter-r-held-db;
                            left-clipping: root.meter-l-clipping;
                            right-clipping: root.meter-r-clipping;
                        }

                        IconButton {
                            text: "⚙";
                            tooltip: "Preferences";
                            clicked => {
                                root.preferences-opened();
                                root.preferences-open = true;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; opacity: 0.6; }

                // --- Edit row ----------------------------------------------
                Rectangle {
                    height: 29px;
                    background: Theme.panel;
                    HorizontalBox {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 3px;
                        padding-bottom: 2px;
                        spacing: 3px;

                        // Pattern selection is a stepper plus a jump list, so
                        // it costs the same width at 2 patterns and at 200.
                        ToolbarLabel { text: "PAT"; }
                        Rectangle {
                            height: 24px;
                            width: pattern-group.preferred-width;
                            border-radius: 3px;
                            background: Theme.surface-raised;
                            pattern-group := HorizontalLayout {
                                spacing: 0px;
                                StepperField {
                                    value: root.current-pattern + 1;
                                    minimum: 1;
                                    maximum: root.pattern-count;
                                    tooltip: "Selected pattern";
                                    value-width: 26px;
                                    field-background: transparent;
                                    changed(v) => { root.pattern-selected(v - 1); }
                                }
                                MenuField {
                                    options: root.pattern-menu-options;
                                    selected-index: root.current-pattern;
                                    display-text: "";
                                    field-width: 0px;
                                    menu-width: 180px;
                                    tooltip: "Jump to pattern";
                                    field-background: transparent;
                                    selected(i) => { root.pattern-selected(i); }
                                }
                            }
                        }
                        NameField {
                            text: root.current-pattern-name;
                            placeholder: "Pattern " + (root.current-pattern + 1);
                            tooltip: "Name this pattern";
                            edited(t) => { root.pattern-renamed(root.current-pattern, t); }
                        }
                        IconButton {
                            text: "+";
                            tooltip: "Add Pattern";
                            size: 24px;
                            enabled: root.pattern-count < 256;
                            clicked => { root.add-pattern-clicked(); }
                        }

                        ToolbarRule {}

                        // Tool modes. The glyph row is the answer to "what
                        // will my next drag across the grid do".
                        ToolModeButton {
                            icon: ToolIcons.select; name: "Select";
                            hint: "Click toggles a step. Ctrl-drag sets velocity.";
                            active: root.tool-mode == 0;
                            clicked => { root.tool-mode = 0; }
                        }
                        ToolModeButton {
                            icon: ToolIcons.paint; name: "Paint";
                            hint: "Drag to fill steps. Right-drag to clear.";
                            active: root.tool-mode == 1;
                            clicked => { root.tool-mode = 1; }
                        }
                        ToolModeButton {
                            icon: ToolIcons.slice; name: "Slice";
                            hint: "Click a step to ratchet it into even hits.";
                            active: root.tool-mode == 2;
                            clicked => { root.tool-mode = 2; }
                        }
                        ToolModeButton {
                            icon: ToolIcons.stretch; name: "Stretch";
                            hint: "Drag a step sideways to set its length.";
                            active: root.tool-mode == 3;
                            clicked => { root.tool-mode = 3; }
                        }
                        if root.tool-mode == 2 : StepperField {
                            label: "×";
                            value <=> root.slice-divisions;
                            minimum: 2;
                            maximum: 4;
                            tooltip: "Hits per sliced step";
                            value-width: 18px;
                        }

                        ToolbarRule {}

                        StepperField {
                            label: "STEPS";
                            value <=> root.pattern-length;
                            minimum: 1;
                            maximum: 256;
                            tooltip: "Length of the selected pattern in 16th-note steps";
                            changed(v) => { root.pattern-length-changed(v); }
                        }
                        MenuField {
                            label: "SNAP";
                            options: root.musical-snap-options;
                            selected-index: root.editor-page == 2
                                ? root.playlist-snap-index : root.piano-snap-index;
                            field-width: 46px;
                            menu-width: 120px;
                            selected(i) => {
                                if (root.editor-page == 2) {
                                    root.playlist-snap-index = i;
                                } else {
                                    root.piano-snap-index = i;
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ===== Work surface: the step grid or the mixer =====
        Rectangle {
            height: 26px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 6px;
                SelectorBank {
                    options: ["Steps", "Mixer"];
                    selected-index: root.mixer-visible ? 1 : 0;
                    segment-width: 54px;
                    tooltip: "Show the step grid or the mixer";
                    selected(i) => { root.mixer-visible = i == 1; }
                }
                Text {
                    text: root.mixer-visible
                        ? "Click a bus to put effects on it"
                        : "Each channel's bus field picks where it lands";
                    color: Theme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        if root.mixer-visible : MixerPane {
            vertical-stretch: 1;
            strips: root.mixer-strips;
            bus-names: root.bus-names;
            bus-selected(i) => { root.bus-selected(i); }
            bus-muted(i) => { root.bus-muted(i); }
            bus-volume-changed(i, v) => { root.bus-volume-changed(i, v); }
            bus-pan-changed(i, v) => { root.bus-pan-changed(i, v); }
            bus-output-changed(i, o) => { root.bus-output-changed(i, o); }
        }

        // ===== Channel rack: one step-grid row per channel =====
        if !root.mixer-visible : ScrollView {
            vertical-stretch: 1;
            viewport-width: max(self.visible-width, 340px + root.pattern-length * 27px);
            viewport-height: max(self.visible-height, root.channels.length * 32px + 48px);

            VerticalBox {
                spacing: 2px;
                padding: 8px;

                for row[ch] in root.channels : HorizontalBox {
                    padding: 2px;
                    spacing: 6px;
                    alignment: start;

                    // Channel name selects the channel for the bottom editor.
                    Rectangle {
                        width: 88px;
                        min-height: 24px;
                        border-radius: 3px;
                        background: row.selected ? Theme.surface-active : Theme.surface;
                        Text {
                            text: row.name;
                            color: row.selected ? Theme.text : Theme.text-muted;
                            font-size: 11px;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            x: 6px;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.channel-selected(ch);
                                    if (e.button == PointerEventButton.right) {
                                        channel-context-menu.show();
                                    }
                                }
                            }
                        }

                        // The menu is anchored to the channel name, so it
                        // opens beside the row that owns its commands instead
                        // of at a disconnected fixed screen coordinate.
                        channel-context-menu := PopupWindow {
                            x: 0px;
                            y: parent.height + 2px;
                            width: 172px;
                            height: context-frame.preferred-height;
                            close-policy: close-on-click;
                            context-frame := Rectangle {
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 3px;
                                VerticalLayout {
                                    padding: 4px;
                                    MenuRow { text: "Cut Channel"; shortcut: "Ctrl+X"; enabled: root.channels.length > 1; selected => { root.edit-command-requested(2, ch); } }
                                    MenuRow { text: "Copy Channel"; shortcut: "Ctrl+C"; selected => { root.edit-command-requested(3, ch); } }
                                    MenuRow { text: "Paste Channel"; shortcut: "Ctrl+V"; enabled: root.channel-clipboard-available && root.channels.length < 16; selected => { root.edit-command-requested(4, ch); } }
                                    MenuSeparator {}
                                    MenuRow { text: "Clone Channel"; enabled: root.channels.length < 16; selected => { root.edit-command-requested(5, ch); } }
                                    MenuRow { text: "Delete Channel"; enabled: root.channels.length > 1; selected => { root.edit-command-requested(6, ch); } }
                                }
                            }
                        }
                    }

                    MuteButton {
                        muted: row.muted;
                        clicked => { root.channel-muted(ch); }
                    }

                    // Volume and pan are knobs here, not faders: the rack row
                    // is for steps, and a pair of 22px knobs costs a fifth of
                    // the width a labelled fader did. Names and values live in
                    // the tooltips.
                    TrimKnob {
                        label: "Volume";
                        value: row.volume-db;
                        changed(v) => { root.channel-volume-changed(ch, v <= -59.9 ? 0.0 : pow(10, v / 20)); }
                    }

                    MiniKnob {
                        label: "Pan";
                        value: row.pan;
                        minimum: -1;
                        maximum: 1;
                        default-value: 0;
                        bipolar: true;
                        value-text: abs(row.pan) < 0.01 ? "Center"
                            : row.pan < 0 ? "L " + round(abs(row.pan) * 100)
                            : "R " + round(row.pan * 100);
                        changed(v) => { root.channel-pan-changed(ch, v); }
                    }

                    // Where this channel lands in the mixer. It sits with the
                    // other output controls rather than in the mixer pane,
                    // because it is a property of the channel.
                    BusPicker {
                        bus-names: root.bus-names;
                        value: row.bus;
                        tooltip: "Mixer bus for this channel";
                        picked(b) => { root.channel-bus-changed(ch, b); }
                    }

                    // Beat grouping remains visible at any pattern length.
                    //
                    // One hit area covers the whole run of steps and derives
                    // the cell from mouse-x. Per-cell TouchAreas cannot support
                    // a drag: the cell where the press landed keeps the grab,
                    // so the pointer never reaches its neighbours.
                    Rectangle {
                        property <length> cell-pitch: 27px;
                        property <int> step-count: row.steps.length;
                        width: self.step-count * self.cell-pitch - 3px;
                        height: 24px;

                        pure function step-at(x: length) -> int {
                            return clamp(floor(x / self.cell-pitch), 0, self.step-count - 1);
                        }

                        HorizontalLayout {
                            spacing: 3px;
                            for cell[i] in row.steps : Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 2px;
                                clip: true;
                                border-width: root.playing && root.current-step == i ? 1px : 0px;
                                border-color: Theme.text;
                                background: mod(i, 4) == 0 ? Theme.surface-active : Theme.surface-raised;
                                for sub in 4 : Rectangle {
                                    property <int> divisor: sub == 0 ? 1 : sub == 1 ? 2 : sub == 2 ? 4 : 8;
                                    property <bool> onset: mod(floor(cell.onsets / self.divisor), 2) == 1;
                                    visible: mod(floor(cell.substeps / self.divisor), 2) == 1;
                                    x: sub * parent.width / 4;
                                    y: parent.height - self.height;
                                    width: parent.width / 4;
                                    height: max(3px, parent.height * cell.velocity / 127);
                                    border-radius: 0px;
                                    background: Theme.accent;
                                    // A struck slot is solid; one that is only
                                    // being held stays dim, so a ratchet reads
                                    // differently from a single sustained note.
                                    opacity: (self.onset ? 1.0 : 0.3)
                                        * (0.55 + 0.45 * cell.velocity / 127);
                                }
                            }
                        }

                        grid-touch := TouchArea {
                            // -1 means "no drag in progress"; it is not a step.
                            property <int> last-step: -1;
                            property <int> stretch-origin: -1;
                            property <bool> paint-on;
                            property <bool> velocity-drag;
                            // TouchArea.pressed only tracks the left button, so
                            // a right-drag would report its first cell and then
                            // go silent. Track the held button ourselves; this
                            // also stops hover moves from painting.
                            property <int> drag-button: -1;
                            mouse-cursor: root.tool-mode == 1 ? crosshair
                                : root.tool-mode == 3 ? ew-resize : pointer;

                            function paint-to(step: int) {
                                if (step != self.last-step) {
                                    self.last-step = step;
                                    root.step-painted(ch, step, self.paint-on);
                                }
                            }

                            pointer-event(e) => {
                                let step = parent.step-at(self.mouse-x);
                                if (e.kind == PointerEventKind.down) {
                                    self.drag-button =
                                        e.button == PointerEventButton.right ? 1 : 0;
                                    if (root.tool-mode == 1) {
                                        // Left fills, right clears, for the
                                        // whole drag. Toggling per cell would
                                        // invert whatever it crossed.
                                        self.paint-on = e.button == PointerEventButton.left;
                                        self.last-step = -1;
                                        self.paint-to(step);
                                    } else if (root.tool-mode == 2) {
                                        if (e.button == PointerEventButton.right) {
                                            root.step-removed(ch, step);
                                        } else {
                                            root.step-sliced(ch, step, root.slice-divisions);
                                        }
                                    } else if (root.tool-mode == 3) {
                                        if (e.button == PointerEventButton.right) {
                                            root.step-length-dragged(ch, step, 1);
                                        } else {
                                            self.stretch-origin = step;
                                            root.step-length-dragged(ch, step, 1);
                                        }
                                    } else if (e.button == PointerEventButton.right) {
                                        root.step-removed(ch, step);
                                    } else {
                                        self.velocity-drag = e.modifiers.control;
                                        if (self.velocity-drag) {
                                            root.step-velocity-edited(ch, step,
                                                clamp(1 - self.mouse-y / self.height, 0, 1));
                                        } else {
                                            root.step-clicked(ch, step);
                                        }
                                    }
                                } else if (e.kind == PointerEventKind.move && self.drag-button >= 0) {
                                    if (root.tool-mode == 1) {
                                        self.paint-to(step);
                                    } else if (root.tool-mode == 3 && self.stretch-origin >= 0) {
                                        root.step-length-dragged(ch, self.stretch-origin,
                                            max(1, step - self.stretch-origin + 1));
                                    } else if (self.velocity-drag) {
                                        root.step-velocity-edited(ch, step,
                                            clamp(1 - self.mouse-y / self.height, 0, 1));
                                    }
                                } else if (e.kind == PointerEventKind.up) {
                                    self.drag-button = -1;
                                    self.velocity-drag = false;
                                    self.last-step = -1;
                                    self.stretch-origin = -1;
                                }
                            }
                            // @markdown takes a literal, so the per-tool hint
                            // is resolved into a property first.
                            property <string> hint: root.tool-mode == 1
                                ? "**Paint** Drag to fill. Right-drag to clear."
                                : root.tool-mode == 2
                                ? "**Slice** Click to ratchet into \{root.slice-divisions} hits. Right-click clears."
                                : root.tool-mode == 3
                                ? "**Stretch** Drag right to lengthen. Right-click resets."
                                : "Click to toggle. **Ctrl-drag** velocity. **Right-click** to clear.";
                            Tooltip { text: @markdown("\{parent.hint}"); }
                        }
                    }
                }

                HorizontalBox {
                    height: 28px;
                    padding: 0px;
                    spacing: 4px;
                    alignment: start;
                    FlatButton {
                        text: "+";
                        tooltip: "Add channel";
                        min-width: 28px; max-width: 28px;
                        min-height: 24px; max-height: 24px;
                        clicked => { add-source-menu.show(); }

                        add-source-menu := PopupWindow {
                            x: 0px;
                            y: parent.height + 2px;
                            width: 156px;
                            height: 108px;
                            close-policy: close-on-click;
                            Rectangle {
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 3px;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 1px;
                                    ToolButton { text: "Add Sampler"; clicked => { add-source-menu.close(); root.add-channel-clicked(0); } }
                                    ToolButton { text: "Add Drum Synth"; clicked => { add-source-menu.close(); root.add-channel-clicked(1); } }
                                    ToolButton { text: "Add Mono Synth"; clicked => { add-source-menu.close(); root.add-channel-clicked(2); } }
                                    ToolButton { text: "Add Poly Synth"; clicked => { add-source-menu.close(); root.add-channel-clicked(3); } }
                                }
                            }
                        }
                    }
                    FlatButton {
                        text: "−";
                        tooltip: "Remove channel";
                        min-width: 28px; max-width: 28px;
                        min-height: 24px; max-height: 24px;
                        clicked => { root.remove-channel-clicked(); }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ===== Bottom dock: sampler and note editors =====
        Rectangle {
            height: 410px;
            background: Theme.panel;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 30px;
                    background: Theme.surface;
                    HorizontalBox {
                        padding: 3px;
                        spacing: 3px;
                        alignment: start;
                        FlatButton {
                            text: "Source";
                            active: root.editor-page == 0;
                            clicked => { root.editor-page = 0; }
                        }
                        FlatButton {
                            text: "Notes";
                            active: root.editor-page == 1;
                            clicked => { root.editor-page = 1; }
                        }
                        FlatButton {
                            text: "Playlist";
                            active: root.editor-page == 2;
                            clicked => { root.editor-page = 2; }
                        }
                        Rectangle { width: 8px; }
                        Text {
                            text: root.editor-page == 2 ? "SONG ARRANGEMENT"
                                : root.editing-bus ? root.editing-bus-name
                                : root.selected-channel-name;
                            color: Theme.text-muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.editor-page != 2 && !root.editing-bus : MenuField {
                            label: "CHANNEL PRESET";
                            options: root.channel-preset-options;
                            selected-index: -1;
                            display-text: "Browse...";
                            field-width: 90px;
                            menu-width: 220px;
                            tooltip: "Load a saved whole-channel preset (source + mixer)";
                            selected(i) => { root.channel-preset-selected(i); }
                        }
                        if root.editor-page != 2 && !root.editing-bus : IconButton {
                            text: "💾";
                            tooltip: "Save this channel (source + mixer) as a preset";
                            size: 24px;
                            clicked => { root.save-channel-preset-requested(); }
                        }
                    }
                }

                if root.editor-page == 2 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalBox {
                                padding: 4px;
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: "SNAP";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: root.musical-snap-options;
                                    current-index <=> root.playlist-snap-index;
                                    width: 92px;
                                    height: 24px;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "↔"; color: Theme.text-faint; vertical-alignment: center; }
                                FlatButton {
                                    text: "−"; tooltip: "Zoom Out";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.playlist-bar-width > 12px;
                                    clicked => { root.playlist-bar-width = max(12px, root.playlist-bar-width - 4px); }
                                }
                                FlatButton {
                                    text: "+"; tooltip: "Zoom In";
                                    min-width: 26px; max-width: 26px;
                                    enabled: root.playlist-bar-width < 96px;
                                    clicked => { root.playlist-bar-width = min(96px, root.playlist-bar-width + 4px); }
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: max(self.visible-width,
                                104px + root.playlist-bars * root.playlist-bar-width);
                            viewport-height: max(self.visible-height,
                                30px + root.pattern-count * 28px);

                            playlist-canvas := Rectangle {
                                width: 104px + root.playlist-bars * root.playlist-bar-width;
                                height: max(346px, 30px + root.pattern-count * 28px);

                                Text {
                                    x: 8px; y: 5px;
                                    width: 88px; height: 18px;
                                    text: "PATTERN";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    x: 104px; y: 0px;
                                    width: root.playlist-bars * root.playlist-bar-width;
                                    height: 28px;
                                    background: Theme.surface;
                                    for bar in root.playlist-bars : Rectangle {
                                        x: bar * root.playlist-bar-width;
                                        width: root.playlist-bar-width;
                                        height: parent.height;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        Text {
                                            text: bar + 1;
                                            color: Theme.text-faint;
                                            font-size: 8px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                for pattern in root.pattern-count : Rectangle {
                                    x: 0px;
                                    y: 30px + pattern * 28px;
                                    width: playlist-canvas.width;
                                    height: 26px;

                                    Rectangle {
                                        x: 8px;
                                        width: 88px;
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: root.current-pattern == pattern
                                            ? Theme.surface-active : Theme.surface;
                                        Text {
                                            x: 6px;
                                            text: "Pattern " + (pattern + 1);
                                            color: root.current-pattern == pattern
                                                ? Theme.text : Theme.text-muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    root.pattern-selected(pattern);
                                                    if (e.button == PointerEventButton.right) {
                                                        pattern-context-menu.show();
                                                    }
                                                }
                                            }
                                        }

                                        // Right-click selects the pattern first --
                                        // Clone/Clear/Delete all act on current-pattern,
                                        // not an explicit index -- then opens the menu
                                        // beside the row that owns those commands.
                                        pattern-context-menu := PopupWindow {
                                            x: 0px;
                                            y: parent.height + 2px;
                                            width: 150px;
                                            height: pattern-context-frame.preferred-height;
                                            close-policy: close-on-click;
                                            pattern-context-frame := Rectangle {
                                                background: Theme.surface;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                border-radius: 3px;
                                                VerticalLayout {
                                                    padding: 4px;
                                                    MenuRow { text: "Clone Pattern"; shortcut: "Ctrl+Alt+D"; enabled: root.pattern-count < 256; selected => { root.pattern-clone-requested(); } }
                                                    MenuRow { text: "Clear Pattern"; selected => { root.pattern-clear-requested(); } }
                                                    MenuSeparator {}
                                                    MenuRow { text: "Delete Pattern"; shortcut: "Ctrl+Shift+Delete"; enabled: root.pattern-count > 1; selected => { root.pattern-remove-requested(); } }
                                                }
                                            }
                                        }
                                    }

                                    timeline := Rectangle {
                                        x: 104px;
                                        width: root.playlist-bars * root.playlist-bar-width;
                                        height: parent.height;
                                        background: Theme.background;

                                        for bar in root.playlist-bars : Rectangle {
                                            x: bar * root.playlist-bar-width;
                                            width: root.playlist-bar-width;
                                            height: parent.height;
                                            background: mod(bar, 4) == 0
                                                ? Theme.surface : Theme.background;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            for division in root.playlist-bar-ticks / root.playlist-snap-ticks : Rectangle {
                                                visible: division > 0;
                                                x: division * parent.width
                                                    / (root.playlist-bar-ticks / root.playlist-snap-ticks);
                                                width: 1px;
                                                height: parent.height;
                                                background: Theme.border;
                                                opacity: 0.48;
                                            }
                                        }

                                        for clip in root.playlist-clips : Rectangle {
                                            visible: clip.pattern == pattern;
                                            property <int> clip-end-tick:
                                                clip.start-tick + clip.length-steps * 24;
                                            x: clip.start-tick * root.playlist-bar-width
                                                / root.playlist-bar-ticks;
                                            y: 2px;
                                            width: max(4px,
                                                clip.length-steps * root.playlist-bar-width / 16);
                                            height: parent.height - 4px;
                                            border-radius: 2px;
                                            border-width: root.playing && root.song-mode
                                                && root.playlist-position-ticks >= clip.start-tick
                                                && root.playlist-position-ticks < self.clip-end-tick ? 1px : 0px;
                                            border-color: Theme.text;
                                            background: Theme.accent;
                                            opacity: root.current-pattern == pattern ? 1 : 0.62;
                                            Text {
                                                text: pattern + 1;
                                                color: Theme.background;
                                                font-size: 9px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        if root.playing && root.song-mode : Rectangle {
                                            x: root.playlist-position-ticks * root.playlist-bar-width
                                                / root.playlist-bar-ticks;
                                            width: 1px;
                                            height: parent.height;
                                            background: Theme.text;
                                        }

                                        Rectangle {
                                            x: root.playlist-song-length-ticks * root.playlist-bar-width
                                                / root.playlist-bar-ticks - 1px;
                                            width: 1px;
                                            height: parent.height;
                                            background: Theme.text-faint;
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    let raw-tick = clamp(floor(self.mouse-x
                                                        * root.playlist-bar-ticks / root.playlist-bar-width),
                                                        0, root.playlist-bars * root.playlist-bar-ticks - 1);
                                                    if (e.button == PointerEventButton.right) {
                                                        root.playlist-placement-removed(pattern, raw-tick);
                                                    } else if (e.button == PointerEventButton.left) {
                                                        root.playlist-placement-added(pattern,
                                                            floor(raw-tick / root.playlist-snap-ticks)
                                                                * root.playlist-snap-ticks);
                                                    }
                                                }
                                            }
                                            // Same hover-linger problem as the piano roll's
                                            // canvas: this one TouchArea spans the whole
                                            // timeline row, so a Tooltip here would show for
                                            // as long as the playlist is in use.
                                            changed has-hover => {
                                                root.hover-hint = self.has-hover
                                                    ? "Click to place on the playlist grid. Right-click removes a clip."
                                                    : root.hover-hint == "Click to place on the playlist grid. Right-click removes a clip."
                                                        ? "" : root.hover-hint;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.editor-page == 0 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 6px;
                                Text {
                                    text: "DEVICE CHAIN";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                if !root.editing-bus : SelectorBank {
                                    options: ["Sampler", "Drum", "Mono", "Poly"];
                                    selected-index <=> root.source-kind;
                                    segment-width: 48px;
                                    tooltip: "Source device";
                                    selected(i) => {
                                        root.source-kind = i;
                                        root.channel-source-changed(i);
                                    }
                                }
                                if !root.editing-bus : Rectangle { width: 6px; }
                                if !root.editing-bus : MenuField {
                                    label: "PRESET";
                                    options: root.generator-preset-options;
                                    selected-index: -1;
                                    display-text: "Browse...";
                                    field-width: 90px;
                                    menu-width: 220px;
                                    tooltip: "Load a preset for this source device";
                                    selected(i) => { root.generator-preset-selected(i); }
                                }
                                if !root.editing-bus : IconButton {
                                    text: "💾";
                                    tooltip: "Save the current source as a preset";
                                    size: 24px;
                                    clicked => { root.save-generator-preset-requested(); }
                                }
                                // A bus has no generator and no generator
                                // preset, so the row states what it is instead.
                                if root.editing-bus : Text {
                                    text: root.editing-bus-name;
                                    color: Theme.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                if root.editing-bus : Text {
                                    text: root.editing-bus-is-master
                                        ? "Everything lands here"
                                        : "Effects here shape every channel routed to this bus";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        device-chain-scroll := ScrollView {
                            vertical-stretch: 1;
                            // Sized from the rack row's own intrinsic width, not
                            // a constant: the chain grows as devices are added,
                            // and faces are width-quantized in rack units, so a
                            // fixed figure leaves later devices unreachable.
                            viewport-width: max(self.visible-width, rack-row.preferred-width);
                            viewport-height: max(self.visible-height, 284px);

                            Rectangle {
                                width: max(device-chain-scroll.visible-width, rack-row.preferred-width);
                                height: 284px;
                                background: Theme.panel;

                                rack-row := HorizontalLayout {
                                    padding: 8px;
                                    spacing: 0px;
                                    alignment: start;

                                    // The head of the chain: a channel's
                                    // generator, or the bus's own output stage
                                    // when the rack is following the mixer.
                                    source-device := DeviceFrame {
                                        width: root.editing-bus
                                            ? DeviceRackMetrics.unit-width * 2 + DeviceRackMetrics.half-gap + DeviceRackMetrics.rail-width * 2
                                            : DeviceRackMetrics.unit-width * 3 + DeviceRackMetrics.half-gap + DeviceRackMetrics.rail-width * 2;
                                        height: DeviceRackMetrics.face-height;
                                        input-left-db: root.editing-bus ? root.editing-bus-input-left-db : -60;
                                        input-right-db: root.editing-bus ? root.editing-bus-input-right-db : -60;
                                        output-left-db: root.editing-bus ? root.editing-bus-left-db : root.source-output-left-db;
                                        output-right-db: root.editing-bus ? root.editing-bus-right-db : root.source-output-right-db;
                                        output-trim-enabled: !root.editing-bus;
                                        output-trim: root.selected-channel-volume-db;
                                        output-trim-changed(v) => {
                                            root.channel-volume-changed(root.selected-channel, v <= -59.9 ? 0.0 : pow(10, v / 20));
                                        }
                                        effect-kind-selected(kind) => { root.add-effect-clicked(kind, 0); }

                                        if root.editing-bus : BusDeviceFace {
                                            x: DeviceRackMetrics.rail-width;
                                            y: 0px;
                                            width: parent.content-width;
                                            height: parent.height;
                                            name: root.editing-bus-name;
                                            is-master: root.editing-bus-is-master;
                                            muted: root.editing-bus-muted;
                                            volume: root.editing-bus-volume;
                                            pan: root.editing-bus-pan;
                                            output: root.editing-bus-output;
                                            index: root.editing-bus-index;
                                            feed-count: root.editing-bus-feed-count;
                                            bus-names: root.bus-names;
                                            allowed: root.editing-bus-allowed;
                                            left-db: root.editing-bus-left-db;
                                            right-db: root.editing-bus-right-db;
                                            volume-changed(v) => { root.bus-volume-changed(root.editing-bus-index, v); }
                                            pan-changed(v) => { root.bus-pan-changed(root.editing-bus-index, v); }
                                            mute-toggled => { root.bus-muted(root.editing-bus-index); }
                                            output-picked(o) => { root.bus-output-changed(root.editing-bus-index, o); }
                                        }

                                        if !root.editing-bus && root.source-kind == 0 : SamplerDeviceFace {
                                            x: DeviceRackMetrics.rail-width;
                                            y: DeviceRackMetrics.header-height;
                                            width: parent.content-width;
                                            height: parent.height - DeviceRackMetrics.header-height;
                                            page <=> root.sampler-device-page;
                                            attack <=> root.attack;
                                            decay <=> root.decay;
                                            sustain <=> root.sustain;
                                            release <=> root.release;
                                            start-pos <=> root.start-pos;
                                            end-pos <=> root.end-pos;
                                            loop-start <=> root.loop-start;
                                            loop-end <=> root.loop-end;
                                            reverse-playback <=> root.reverse-playback;
                                            root-note <=> root.root-note;
                                            tune-semitones <=> root.tune-semitones;
                                            tune-cents <=> root.tune-cents;
                                            tune-label <=> root.tune-label;
                                            filter-cutoff <=> root.filter-cutoff;
                                            filter-resonance <=> root.filter-resonance;
                                            filter-env <=> root.filter-env;
                                            drive <=> root.sampler-drive;
                                            bit-reduction <=> root.bit-reduction;
                                            rate-reduction <=> root.rate-reduction;
                                            loop-mode <=> root.loop-mode;
                                            voice-mode <=> root.voice-mode;
                                            polyphony <=> root.sampler-polyphony;
                                            retrigger-mode <=> root.retrigger-mode;
                                            choke-group <=> root.choke-group;
                                            sample-name <=> root.sample-name;
                                            sample-description <=> root.sample-description;
                                            waveform <=> root.waveform;
                                            playhead-positions <=> root.playhead-positions;
                                            sample-frames <=> root.sample-frames;
                                            can-previous-sample <=> root.can-previous-sample;
                                            can-next-sample <=> root.can-next-sample;
                                            waveform-view-offset <=> root.waveform-view-offset;
                                            waveform-view-visible-fraction <=> root.waveform-view-visible-fraction;
                                            waveform-view-changed(o, f) => { root.waveform-view-changed(o, f); }
                                            attack-changed(v) => { root.attack-changed(v); }
                                            decay-changed(v) => { root.decay-changed(v); }
                                            sustain-changed(v) => { root.sustain-changed(v); }
                                            release-changed(v) => { root.release-changed(v); }
                                            start-pos-changed(v) => { root.start-pos-changed(v); }
                                            end-pos-changed(v) => { root.end-pos-changed(v); }
                                            loop-start-changed(v) => { root.loop-start-changed(v); }
                                            loop-end-changed(v) => { root.loop-end-changed(v); }
                                            reverse-playback-changed(v) => { root.reverse-playback-changed(v); }
                                            root-note-changed(v) => { root.root-note-changed(v); }
                                            tune-semitones-changed(v) => { root.tune-semitones-changed(v); }
                                            tune-cents-changed(v) => { root.tune-cents-changed(v); }
                                            loop-mode-changed(v) => { root.loop-mode-changed(v); }
                                            voice-mode-changed(v) => { root.voice-mode-changed(v); }
                                            polyphony-changed(v) => { root.sampler-polyphony-changed(v); }
                                            retrigger-mode-changed(v) => { root.retrigger-mode-changed(v); }
                                            choke-group-changed(v) => { root.choke-group-changed(v); }
                                            filter-cutoff-changed(v) => { root.filter-cutoff-changed(v); }
                                            filter-resonance-changed(v) => { root.filter-resonance-changed(v); }
                                            filter-env-changed(v) => { root.filter-env-changed(v); }
                                            drive-changed(v) => { root.sampler-drive-changed(v); }
                                            bit-reduction-changed(v) => { root.bit-reduction-changed(v); }
                                            rate-reduction-changed(v) => { root.rate-reduction-changed(v); }
                                            load-sample-clicked => { root.load-sample-clicked(); }
                                            previous-sample-clicked => { root.previous-sample-clicked(); }
                                            next-sample-clicked => { root.next-sample-clicked(); }
                                        }

                                        if !root.editing-bus && root.source-kind == 1 : DrumDeviceFace {
                                            x: DeviceRackMetrics.rail-width;
                                            y: DeviceRackMetrics.header-height;
                                            width: parent.content-width;
                                            height: parent.height - DeviceRackMetrics.header-height;
                                            mode <=> root.drum-mode;
                                            kick-character <=> root.drum-kick-character;
                                            snare-character <=> root.drum-snare-character;
                                            hat-character <=> root.drum-hat-character;
                                            decay <=> root.drum-decay;
                                            tune-semitones <=> root.drum-tune-semitones;
                                            drive <=> root.drum-drive;
                                            punch <=> root.drum-punch;
                                            choke-group <=> root.drum-choke-group;
                                            kick-start-hz <=> root.drum-kick-start-hz;
                                            kick-end-hz <=> root.drum-kick-end-hz;
                                            kick-sweep <=> root.drum-kick-sweep;
                                            kick-click <=> root.drum-kick-click;
                                            snare-tone-hz <=> root.drum-snare-tone-hz;
                                            snare-tone2-hz <=> root.drum-snare-tone2-hz;
                                            snare-tone2-mix <=> root.drum-snare-tone2-mix;
                                            snare-noise-mix <=> root.drum-snare-noise-mix;
                                            snare-noise-decay <=> root.drum-snare-noise-decay;
                                            snare-noise-color <=> root.drum-snare-noise-color;
                                            hat-hp-hz <=> root.drum-hat-hp-hz;
                                            hat-metallic <=> root.drum-hat-metallic;
                                            preview-minimums: root.drum-preview-minimums;
                                            preview-maximums: root.drum-preview-maximums;
                                            mode-changed(v) => { root.drum-mode-changed(v); }
                                            kick-character-changed(v) => { root.drum-kick-character-changed(v); }
                                            snare-character-changed(v) => { root.drum-snare-character-changed(v); }
                                            hat-character-changed(v) => { root.drum-hat-character-changed(v); }
                                            decay-changed(v) => { root.drum-decay-changed(v); }
                                            tune-semitones-changed(v) => { root.drum-tune-semitones-changed(v); }
                                            drive-changed(v) => { root.drum-drive-changed(v); }
                                            punch-changed(v) => { root.drum-punch-changed(v); }
                                            choke-group-changed(v) => { root.drum-choke-group-changed(v); }
                                            kick-start-hz-changed(v) => { root.drum-kick-start-hz-changed(v); }
                                            kick-end-hz-changed(v) => { root.drum-kick-end-hz-changed(v); }
                                            kick-sweep-changed(v) => { root.drum-kick-sweep-changed(v); }
                                            kick-click-changed(v) => { root.drum-kick-click-changed(v); }
                                            snare-tone-hz-changed(v) => { root.drum-snare-tone-hz-changed(v); }
                                            snare-tone2-hz-changed(v) => { root.drum-snare-tone2-hz-changed(v); }
                                            snare-tone2-mix-changed(v) => { root.drum-snare-tone2-mix-changed(v); }
                                            snare-noise-mix-changed(v) => { root.drum-snare-noise-mix-changed(v); }
                                            snare-noise-decay-changed(v) => { root.drum-snare-noise-decay-changed(v); }
                                            snare-noise-color-changed(v) => { root.drum-snare-noise-color-changed(v); }
                                            hat-hp-hz-changed(v) => { root.drum-hat-hp-hz-changed(v); }
                                            hat-metallic-changed(v) => { root.drum-hat-metallic-changed(v); }
                                        }

                                        if !root.editing-bus && root.source-kind == 2 : MonoDeviceFace {
                                            x: DeviceRackMetrics.rail-width;
                                            y: DeviceRackMetrics.header-height;
                                            width: parent.content-width;
                                            height: parent.height - DeviceRackMetrics.header-height;
                                            page <=> root.mono-device-page;
                                            osc1-wave <=> root.mono-osc1-wave; osc1-semitones <=> root.mono-osc1-semitones; osc1-cents <=> root.mono-osc1-cents; osc1-level <=> root.mono-osc1-level; osc1-pulse-width <=> root.mono-osc1-pulse-width;
                                            osc2-wave <=> root.mono-osc2-wave; osc2-semitones <=> root.mono-osc2-semitones; osc2-cents <=> root.mono-osc2-cents; osc2-level <=> root.mono-osc2-level; osc2-pulse-width <=> root.mono-osc2-pulse-width;
                                            osc3-wave <=> root.mono-osc3-wave; osc3-semitones <=> root.mono-osc3-semitones; osc3-cents <=> root.mono-osc3-cents; osc3-level <=> root.mono-osc3-level; osc3-pulse-width <=> root.mono-osc3-pulse-width;
                                            glide <=> root.mono-glide; attack <=> root.mono-attack; decay <=> root.mono-decay; sustain <=> root.mono-sustain; release <=> root.mono-release;
                                            filter-cutoff <=> root.mono-filter-cutoff; filter-resonance <=> root.mono-filter-resonance; filter-env <=> root.mono-filter-env; drive <=> root.mono-drive;
                                            lfo-wave <=> root.mono-lfo-wave; lfo-rate <=> root.mono-lfo-rate; lfo-retrigger <=> root.mono-lfo-retrigger;
                                            lfo-pitch <=> root.mono-lfo-pitch; lfo-filter <=> root.mono-lfo-filter; lfo-pulse-width <=> root.mono-lfo-pulse-width; lfo-amp <=> root.mono-lfo-amp;
                                            osc1-wave-changed(v) => { root.mono-osc1-wave-changed(v); } osc1-semitones-changed(v) => { root.mono-osc1-semitones-changed(v); } osc1-cents-changed(v) => { root.mono-osc1-cents-changed(v); } osc1-level-changed(v) => { root.mono-osc1-level-changed(v); } osc1-pulse-width-changed(v) => { root.mono-osc1-pulse-width-changed(v); }
                                            osc2-wave-changed(v) => { root.mono-osc2-wave-changed(v); } osc2-semitones-changed(v) => { root.mono-osc2-semitones-changed(v); } osc2-cents-changed(v) => { root.mono-osc2-cents-changed(v); } osc2-level-changed(v) => { root.mono-osc2-level-changed(v); } osc2-pulse-width-changed(v) => { root.mono-osc2-pulse-width-changed(v); }
                                            osc3-wave-changed(v) => { root.mono-osc3-wave-changed(v); } osc3-semitones-changed(v) => { root.mono-osc3-semitones-changed(v); } osc3-cents-changed(v) => { root.mono-osc3-cents-changed(v); } osc3-level-changed(v) => { root.mono-osc3-level-changed(v); } osc3-pulse-width-changed(v) => { root.mono-osc3-pulse-width-changed(v); }
                                            glide-changed(v) => { root.mono-glide-changed(v); } attack-changed(v) => { root.mono-attack-changed(v); } decay-changed(v) => { root.mono-decay-changed(v); } sustain-changed(v) => { root.mono-sustain-changed(v); } release-changed(v) => { root.mono-release-changed(v); }
                                            filter-cutoff-changed(v) => { root.mono-filter-cutoff-changed(v); } filter-resonance-changed(v) => { root.mono-filter-resonance-changed(v); } filter-env-changed(v) => { root.mono-filter-env-changed(v); } drive-changed(v) => { root.mono-drive-changed(v); }
                                            lfo-wave-changed(v) => { root.mono-lfo-wave-changed(v); } lfo-rate-changed(v) => { root.mono-lfo-rate-changed(v); } lfo-retrigger-changed(v) => { root.mono-lfo-retrigger-changed(v); }
                                            lfo-pitch-changed(v) => { root.mono-lfo-pitch-changed(v); } lfo-filter-changed(v) => { root.mono-lfo-filter-changed(v); } lfo-pulse-width-changed(v) => { root.mono-lfo-pulse-width-changed(v); } lfo-amp-changed(v) => { root.mono-lfo-amp-changed(v); }
                                        }

                                        if !root.editing-bus && root.source-kind == 3 : PolyDeviceFace {
                                            x: 0px;
                                            y: DeviceRackMetrics.header-height;
                                            width: parent.width;
                                            height: parent.height - DeviceRackMetrics.header-height;
                                            page <=> root.poly-device-page;
                                            osc1-wave <=> root.poly-osc1-wave; osc1-semitones <=> root.poly-osc1-semitones; osc1-cents <=> root.poly-osc1-cents; osc1-level <=> root.poly-osc1-level; osc1-pulse-width <=> root.poly-osc1-pulse-width;
                                            osc2-wave <=> root.poly-osc2-wave; osc2-semitones <=> root.poly-osc2-semitones; osc2-cents <=> root.poly-osc2-cents; osc2-level <=> root.poly-osc2-level; osc2-pulse-width <=> root.poly-osc2-pulse-width;
                                            osc3-wave <=> root.poly-osc3-wave; osc3-semitones <=> root.poly-osc3-semitones; osc3-cents <=> root.poly-osc3-cents; osc3-level <=> root.poly-osc3-level; osc3-pulse-width <=> root.poly-osc3-pulse-width;
                                            glide <=> root.poly-glide; attack <=> root.poly-attack; decay <=> root.poly-decay; sustain <=> root.poly-sustain; release <=> root.poly-release;
                                            filter-cutoff <=> root.poly-filter-cutoff; filter-resonance <=> root.poly-filter-resonance; filter-env <=> root.poly-filter-env; drive <=> root.poly-drive;
                                            lfo-wave <=> root.poly-lfo-wave; lfo-rate <=> root.poly-lfo-rate; lfo-retrigger <=> root.poly-lfo-retrigger;
                                            lfo-pitch <=> root.poly-lfo-pitch; lfo-filter <=> root.poly-lfo-filter; lfo-pulse-width <=> root.poly-lfo-pulse-width; lfo-amp <=> root.poly-lfo-amp;
                                            polyphony <=> root.poly-polyphony; spread <=> root.poly-spread;
                                            osc1-wave-changed(v) => { root.poly-osc1-wave-changed(v); } osc1-semitones-changed(v) => { root.poly-osc1-semitones-changed(v); } osc1-cents-changed(v) => { root.poly-osc1-cents-changed(v); } osc1-level-changed(v) => { root.poly-osc1-level-changed(v); } osc1-pulse-width-changed(v) => { root.poly-osc1-pulse-width-changed(v); }
                                            osc2-wave-changed(v) => { root.poly-osc2-wave-changed(v); } osc2-semitones-changed(v) => { root.poly-osc2-semitones-changed(v); } osc2-cents-changed(v) => { root.poly-osc2-cents-changed(v); } osc2-level-changed(v) => { root.poly-osc2-level-changed(v); } osc2-pulse-width-changed(v) => { root.poly-osc2-pulse-width-changed(v); }
                                            osc3-wave-changed(v) => { root.poly-osc3-wave-changed(v); } osc3-semitones-changed(v) => { root.poly-osc3-semitones-changed(v); } osc3-cents-changed(v) => { root.poly-osc3-cents-changed(v); } osc3-level-changed(v) => { root.poly-osc3-level-changed(v); } osc3-pulse-width-changed(v) => { root.poly-osc3-pulse-width-changed(v); }
                                            glide-changed(v) => { root.poly-glide-changed(v); } attack-changed(v) => { root.poly-attack-changed(v); } decay-changed(v) => { root.poly-decay-changed(v); } sustain-changed(v) => { root.poly-sustain-changed(v); } release-changed(v) => { root.poly-release-changed(v); }
                                            filter-cutoff-changed(v) => { root.poly-filter-cutoff-changed(v); } filter-resonance-changed(v) => { root.poly-filter-resonance-changed(v); } filter-env-changed(v) => { root.poly-filter-env-changed(v); } drive-changed(v) => { root.poly-drive-changed(v); }
                                            lfo-wave-changed(v) => { root.poly-lfo-wave-changed(v); } lfo-rate-changed(v) => { root.poly-lfo-rate-changed(v); } lfo-retrigger-changed(v) => { root.poly-lfo-retrigger-changed(v); }
                                            lfo-pitch-changed(v) => { root.poly-lfo-pitch-changed(v); } lfo-filter-changed(v) => { root.poly-lfo-filter-changed(v); } lfo-pulse-width-changed(v) => { root.poly-lfo-pulse-width-changed(v); } lfo-amp-changed(v) => { root.poly-lfo-amp-changed(v); }
                                            polyphony-changed(v) => { root.poly-polyphony-changed(v); } spread-changed(v) => { root.poly-spread-changed(v); }
                                        }

                                        if !root.editing-bus : DeviceHeader {
                                            x: DeviceRackMetrics.rail-width; y: 0px; width: parent.content-width;
                                            name: root.source-kind == 0 ? "Sampler"
                                                : root.source-kind == 1 ? "Drum Synth"
                                                : root.source-kind == 2 ? "Mono Synth" : "Poly Synth";
                                            kind: "SOURCE / 3U";
                                            device-color: Theme.accent;
                                        }
                                    }

                                    DeviceJoin { }

                                    for slot[index] in root.effect-slots : Rectangle {
                                        property <length> face-width:
                                            DeviceRackMetrics.unit-width * slot.units
                                            + DeviceRackMetrics.half-gap * (slot.units - 1);
                                        width: self.face-width + DeviceRackMetrics.rail-width * 2 + 20px;
                                        height: DeviceRackMetrics.face-height;
                                        DeviceFrame {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.face-width + DeviceRackMetrics.rail-width * 2;
                                            height: DeviceRackMetrics.face-height;
                                            input-left-db: slot.input-left-db;
                                            input-right-db: slot.input-right-db;
                                            output-left-db: slot.output-left-db;
                                            output-right-db: slot.output-right-db;
                                            bypass-enabled: true;
                                            bypassed: slot.bypassed;
                                            bypass-toggled => { root.effect-bypass-toggled(index); }
                                            input-trim-enabled: true;
                                            input-trim: slot.input-trim-db;
                                            input-trim-changed(v) => { root.effect-input-trim-changed(index, v); }
                                            output-trim-enabled: true;
                                            output-trim: slot.output-trim-db;
                                            output-trim-changed(v) => { root.effect-output-trim-changed(index, v); }
                                            wet-dry-enabled: true;
                                            wet-dry: slot.wet-dry;
                                            wet-dry-text: round(slot.wet-dry * 100) + "% wet";
                                            wet-dry-changed(v) => { root.effect-wet-dry-changed(index, v); }
                                            removal-enabled: true;
                                            effect-kind-selected(kind) => { root.add-effect-clicked(kind, index); }
                                            remove-requested => { root.remove-effect-clicked(index); }
                                            if slot.kind == 0 : FilterDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                cutoff: slot.p0;
                                                resonance: slot.p1;
                                                mode: slot.p2 >= 0.5 ? 1 : 0;
                                                cutoff-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                resonance-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                mode-changed(v) => { root.effect-param-changed(index, 2, v * 1.0); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 1 : DriveDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                drive: slot.p0;
                                                curve: round(slot.p1 * 3);
                                                tone: slot.p2;
                                                mix: slot.p3;
                                                output: slot.p4;
                                                drive-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                curve-changed(i) => { root.effect-param-changed(index, 1, i * 1.0 / 3.0); }
                                                tone-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                mix-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                output-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 2 : BitcrushDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                bits: slot.p0;
                                                downsample: slot.p1;
                                                mix: slot.p2;
                                                bits-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                downsample-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                mix-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 3 : DelayDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                time: slot.p0;
                                                feedback: slot.p1;
                                                mode: round(slot.p2 * 2);
                                                cross: slot.p3;
                                                tone: slot.p4;
                                                mix: slot.p5;
                                                time-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                feedback-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                mode-changed(i) => { root.effect-param-changed(index, 2, i * 1.0 / 2.0); }
                                                cross-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                tone-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                mix-changed(v) => { root.effect-param-changed(index, 5, v); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 4 : GateDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                threshold: slot.p0;
                                                attack: slot.p1;
                                                hold: slot.p2;
                                                release: slot.p3;
                                                range: slot.p4;
                                                threshold-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                attack-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                hold-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                release-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                range-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 5 : CompressorDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                threshold: slot.p0;
                                                ratio: slot.p1;
                                                attack: slot.p2;
                                                release: slot.p3;
                                                knee: slot.p4;
                                                makeup: slot.p5;
                                                threshold-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                ratio-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                attack-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                release-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                knee-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                makeup-changed(v) => { root.effect-param-changed(index, 5, v); }
                                                hover-hint <=> root.hover-hint;
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 6 : LimiterDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                ceiling: slot.p0;
                                                release: slot.p1;
                                                gain: slot.p2;
                                                ceiling-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                release-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                gain-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 7 : EqDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                target: slot.p0;
                                                enabled: slot.p1;
                                                frequency: slot.p2;
                                                gain: slot.p3;
                                                q: slot.p4;
                                                character: slot.p5;
                                                band-data: slot.eq-band-data;
                                                spectrum-data: slot.eq-spectrum-data;
                                                analyzer-enabled: slot.eq-analyzer-enabled;
                                                target-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                enabled-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                frequency-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                gain-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                q-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                character-changed(v) => { root.effect-param-changed(index, 5, v); }
                                                analyzer-toggled(v) => { root.eq-analyzer-changed(index, v); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 8 : ReverbDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                shape: round(slot.p0 * 2);
                                                material: round(slot.p1 * 3);
                                                width-value: slot.p2;
                                                depth-value: slot.p3;
                                                height-value: slot.p4;
                                                decay-value: slot.p5;
                                                capture-x: slot.p6;
                                                capture-y: slot.p7;
                                                shape-changed(i) => { root.effect-param-changed(index, 0, i * 1.0 / 2.0); }
                                                material-changed(i) => { root.effect-param-changed(index, 1, i * 1.0 / 3.0); }
                                                width-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                depth-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                height-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                decay-changed(v) => { root.effect-param-changed(index, 5, v); }
                                                capture-x-changed(v) => { root.effect-param-changed(index, 6, v); }
                                                capture-y-changed(v) => { root.effect-param-changed(index, 7, v); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 9 : ModulationDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                mode: round(slot.p0 * 4);
                                                rate: slot.p1;
                                                depth: slot.p2;
                                                character: slot.p3;
                                                feedback: slot.p4;
                                                spread: slot.p5;
                                                tone: slot.p6;
                                                stages: slot.p7;
                                                mode-changed(i) => { root.effect-param-changed(index, 0, i * 1.0 / 4.0); }
                                                rate-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                depth-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                character-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                feedback-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                spread-changed(v) => { root.effect-param-changed(index, 5, v); }
                                                tone-changed(v) => { root.effect-param-changed(index, 6, v); }
                                                stages-changed(v) => { root.effect-param-changed(index, 7, v); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                            if slot.kind == 10 : PlateDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: 0px;
                                                width: parent.content-width;
                                                height: parent.height;
                                                slot-index: index;
                                                slot-count: root.effect-slots.length;
                                                bypassed: slot.bypassed;
                                                size: slot.p0;
                                                decay: slot.p1;
                                                damping: slot.p2;
                                                width-value: slot.p3;
                                                size-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                decay-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                damping-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                width-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                reorder-requested(target) => { root.reorder-effect(index, target); }
                                            }
                                        }
                                        DeviceJoin { x: parent.face-width + DeviceRackMetrics.rail-width * 2; y: 0px; }
                                    }

                                    Rectangle {
                                        width: 50px;
                                        height: DeviceRackMetrics.face-height;
                                        DeviceAddSlot {
                                            kind-selected(kind) => { root.add-effect-clicked(kind, root.effect-slots.length); }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }

                if root.editor-page == 1 : Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.surface-raised;
                            HorizontalBox {
                                padding: 4px;
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: root.has-selected-note ? "TICK " + root.selected-note-step : "NO NOTE";
                                    color: Theme.text-muted;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "NOTE";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-note;
                                    minimum: root.piano-low-note;
                                    maximum: root.piano-high-note;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-note-changed(value); }
                                    Tooltip { text: @markdown("Selected step MIDI note"); }
                                }
                                Text {
                                    text: "VEL";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-velocity;
                                    minimum: 1;
                                    maximum: 127;
                                    step-size: 1;
                                    width: 70px;
                                    height: 24px;
                                    edited(value) => { root.selected-velocity-changed(value); }
                                    Tooltip { text: @markdown("Selected step velocity"); }
                                }
                                Text {
                                    text: "LEN";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    enabled: root.has-selected-note;
                                    value <=> root.selected-duration-ticks;
                                    minimum: 1;
                                    maximum: max(1, root.pattern-length * 24);
                                    step-size: root.piano-snap-ticks;
                                    width: 78px;
                                    height: 24px;
                                    edited(value) => { root.selected-duration-changed(value); }
                                    Tooltip { text: @markdown("Selected note length in PPQ ticks. **6** ticks = 1/64 note."); }
                                }
                                Rectangle { width: 8px; }
                                ComboBox {
                                    model: ["Velocity"];
                                    current-index: 0;
                                    current-value: "Velocity";
                                    width: 120px;
                                    height: 24px;
                                }
                                Text {
                                    text: "SNAP";
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: root.musical-snap-options;
                                    current-index <=> root.piano-snap-index;
                                    width: 84px;
                                    height: 24px;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        HorizontalLayout {
                            vertical-stretch: 1;

                            Rectangle {
                                width: 46px;
                                background: Theme.panel;
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        vertical-stretch: 1;
                                        clip: true;
                                        Rectangle {
                                            y: piano-scroll.viewport-y;
                                            width: parent.width;
                                            height: root.piano-note-count * root.piano-row-height;
                                            for key in root.piano-note-count : Rectangle {
                                                y: key * root.piano-row-height;
                                                height: root.piano-row-height;
                                                width: parent.width;
                                                property <int> note-number: root.piano-high-note - key;
                                                background: (mod(note-number, 12) == 1
                                                    || mod(note-number, 12) == 3
                                                    || mod(note-number, 12) == 6
                                                    || mod(note-number, 12) == 8
                                                    || mod(note-number, 12) == 10)
                                                    ? Theme.panel : Theme.surface;
                                                if mod(note-number, 12) == 0 : Text {
                                                    text: "C" + (floor(note-number / 12) - 1);
                                                    color: Theme.text-muted;
                                                    font-size: min(9px, root.piano-row-height - 1px);
                                                    vertical-alignment: center;
                                                    x: 3px;
                                                }
                                            }
                                        }
                                    }
                                    // Matches the time scrollbar below the grid
                                    // so the keyboard's parameter labels stay
                                    // aligned with the lanes on the right.
                                    Rectangle { height: 14px; background: Theme.panel; }
                                    Text {
                                        height: 17px;
                                        text: "LANE";
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        height: 55px;
                                        text: "VEL";
                                        color: Theme.text-muted;
                                        font-size: 8px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 0px;
                                HorizontalLayout {
                                    spacing: 2px;
                                    piano-scroll := ScrollView {
                                        // The zoom scrollbars own panning and
                                        // zooming for both axes; the built-in
                                        // bars would only duplicate them.
                                        horizontal-scrollbar-policy: always-off;
                                        vertical-scrollbar-policy: always-off;
                                        vertical-stretch: 1;
                                        horizontal-stretch: 1;
                                    viewport-width: max(self.visible-width,
                                        root.pattern-length * root.piano-step-width);
                                    viewport-height: max(self.visible-height,
                                        root.piano-note-count * root.piano-row-height);
                                    // Start around the working register (C6 at
                                    // the top) even though the canvas spans the
                                    // full MIDI range. Subsequent pan/zoom
                                    // interactions take ownership of this value.
                                    viewport-y: -(root.piano-high-note - 84) * root.piano-row-height;
                                    Rectangle {
                                        x: 0px;
                                        width: root.pattern-length * root.piano-step-width;
                                        height: root.piano-note-count * root.piano-row-height;
                                        background: Theme.surface;

                                        // Tick/note <-> pixel conversions and note
                                        // hit-testing, shared by the cursor and the
                                        // single hit area below. Kept as functions
                                        // (not per-note state) so a drag never reads
                                        // geometry that moved out from under it: see
                                        // piano-touch for why per-note TouchAreas
                                        // cannot support a drag at all.
                                        pure function note-x(start: int) -> length {
                                            return start * root.piano-step-width / 24;
                                        }
                                        pure function note-width(duration: int) -> length {
                                            return max(root.piano-snap-ticks * root.piano-step-width / 24,
                                                duration * root.piano-step-width / 24);
                                        }
                                        pure function tick-at(x: length) -> int {
                                            return floor(x * 24 / root.piano-step-width);
                                        }
                                        pure function note-at(y: length) -> int {
                                            return clamp(root.piano-high-note - floor(y / root.piano-row-height),
                                                root.piano-low-note, root.piano-high-note);
                                        }
                                        // 0 = empty grid, 1 = note body (move), 2 = right edge (resize).
                                        // The edge zone scales with the note so it stays
                                        // grabbable on a minimum-width note instead of the
                                        // fixed 5px that used to eat the whole note.
                                        pure function grab-mode-at(x: length, y: length) -> int {
                                            let hit = root.piano-note-hit-test(self.tick-at(x), self.note-at(y));
                                            if (!hit.found) {
                                                return 0;
                                            }
                                            let edge = clamp(self.note-width(hit.duration-ticks) / 4, 3px, 8px);
                                            return x >= self.note-x(hit.start-tick)
                                                    + self.note-width(hit.duration-ticks) - edge
                                                ? 2 : 1;
                                        }

                                        for key in root.piano-note-count : Rectangle {
                                            y: key * root.piano-row-height;
                                            height: root.piano-row-height;
                                            width: parent.width;
                                            property <int> note-number: root.piano-high-note - key;
                                            background: (mod(note-number, 12) == 1
                                                || mod(note-number, 12) == 3
                                                || mod(note-number, 12) == 6
                                                || mod(note-number, 12) == 8
                                                || mod(note-number, 12) == 10)
                                                ? Theme.surface : Theme.surface-raised;
                                        }

                                        for division in root.pattern-length * 24 / root.piano-snap-ticks : Rectangle {
                                            x: division * root.piano-snap-ticks
                                                * root.piano-step-width / 24;
                                            width: 1px;
                                            height: parent.height;
                                            background: mod(division * root.piano-snap-ticks, 24) == 0
                                                ? Theme.text-faint : Theme.border;
                                            opacity: mod(division * root.piano-snap-ticks, 24) == 0
                                                ? 0.8 : 0.5;
                                        }

                                        for cell in root.notes : Rectangle {
                                            x: cell.start-tick * root.piano-step-width / 24;
                                            y: (root.piano-high-note - cell.note) * root.piano-row-height;
                                            width: max(root.piano-snap-ticks * root.piano-step-width / 24,
                                                cell.duration-ticks * root.piano-step-width / 24);
                                            height: root.piano-row-height;
                                            background: cell.selected ? Theme.focus : Theme.accent;
                                            opacity: 0.55 + 0.45 * cell.velocity / 127;
                                            border-width: cell.selected ? 1px : 0px;
                                            border-color: Theme.text;
                                        }

                                        // ONE hit area for the whole note grid, exactly
                                        // like the rack's grid-touch. A TouchArea living
                                        // inside a per-note Rectangle whose x/width is
                                        // bound to that note's own tick/duration moves out
                                        // from under the cursor as soon as the drag updates
                                        // the model, so mouse-x re-measures against the
                                        // moved rectangle and the delta collapses to zero
                                        // after one snap step. Hit-testing from here instead,
                                        // in this Rectangle's stable coordinates, means the
                                        // origin never moves during a drag.
                                        piano-touch := TouchArea {
                                            property <int> grabbed-id: -1;
                                            property <int> grab-mode: 0; // 0 none, 1 move, 2 resize
                                            property <length> origin-x;
                                            property <length> origin-y;
                                            property <int> original-start;
                                            property <int> original-note;
                                            property <int> original-duration;
                                            property <bool> create-click-armed;
                                            property <length> create-click-x;
                                            property <length> create-click-y;
                                            property <int> create-click-start;
                                            property <int> create-click-note;
                                            property <int> create-click-duration;
                                            create-click-timeout := Timer {
                                                interval: 350ms;
                                                running: false;
                                                triggered => {
                                                    self.running = false;
                                                    piano-touch.create-click-armed = false;
                                                }
                                            }
                                            mouse-cursor: parent.grab-mode-at(self.mouse-x, self.mouse-y) == 2 ? ew-resize
                                                : parent.grab-mode-at(self.mouse-x, self.mouse-y) == 1 ? move
                                                : crosshair;

                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    let tick = parent.tick-at(self.mouse-x);
                                                    let note = parent.note-at(self.mouse-y);
                                                    let hit = root.piano-note-hit-test(tick, note);
                                                    if (hit.found && e.button == PointerEventButton.right) {
                                                        self.create-click-armed = false;
                                                        create-click-timeout.running = false;
                                                        root.piano-note-removed(hit.id);
                                                    } else if (hit.found && e.button == PointerEventButton.left) {
                                                        self.create-click-armed = false;
                                                        create-click-timeout.running = false;
                                                        root.piano-note-selected(hit.id, e.modifiers.shift, e.modifiers.control);
                                                        self.grabbed-id = hit.id;
                                                        self.grab-mode = parent.grab-mode-at(self.mouse-x, self.mouse-y);
                                                        self.origin-x = self.mouse-x;
                                                        self.origin-y = self.mouse-y;
                                                        self.original-start = hit.start-tick;
                                                        self.original-note = note;
                                                        self.original-duration = hit.duration-ticks;
                                                    } else if (!hit.found && e.button == PointerEventButton.left) {
                                                        let start-tick = clamp(
                                                            floor(tick / root.piano-snap-ticks) * root.piano-snap-ticks,
                                                            0, max(0, root.pattern-length * 24
                                                                - root.piano-snap-ticks));
                                                        let duration = min(root.piano-snap-ticks,
                                                            root.pattern-length * 24 - start-tick);
                                                        if (self.create-click-armed
                                                                && abs(self.mouse-x - self.create-click-x) <= 6px
                                                                && abs(self.mouse-y - self.create-click-y) <= 6px
                                                                && self.create-click-start == start-tick
                                                                && self.create-click-note == note) {
                                                            let id = root.piano-note-created(start-tick, note, duration);
                                                            self.grabbed-id = id;
                                                            self.grab-mode = 2;
                                                            self.origin-x = self.mouse-x;
                                                            self.origin-y = self.mouse-y;
                                                            self.original-start = start-tick;
                                                            self.original-note = note;
                                                            self.original-duration = duration;
                                                            self.create-click-armed = false;
                                                            create-click-timeout.running = false;
                                                        } else {
                                                            self.create-click-armed = true;
                                                            self.create-click-x = self.mouse-x;
                                                            self.create-click-y = self.mouse-y;
                                                            self.create-click-start = start-tick;
                                                            self.create-click-note = note;
                                                            self.create-click-duration = duration;
                                                            create-click-timeout.running = true;
                                                        }
                                                    }
                                                } else if (e.kind == PointerEventKind.move
                                                        && self.pressed && self.grabbed-id >= 0) {
                                                    if (self.grab-mode == 2) {
                                                        let max-duration = max(root.piano-snap-ticks,
                                                            root.pattern-length * 24 - self.original-start);
                                                        let duration = clamp(self.original-duration
                                                                + round((self.mouse-x - self.origin-x)
                                                                    * 24 / root.piano-step-width
                                                                    / root.piano-snap-ticks)
                                                                    * root.piano-snap-ticks,
                                                            min(root.piano-snap-ticks, max-duration), max-duration);
                                                        root.piano-note-resized(self.grabbed-id, duration);
                                                    } else {
                                                        let tick = clamp(self.original-start
                                                                + round((self.mouse-x - self.origin-x)
                                                                    * 24 / root.piano-step-width
                                                                    / root.piano-snap-ticks)
                                                                    * root.piano-snap-ticks,
                                                            0, max(0, root.pattern-length * 24 - self.original-duration));
                                                        let note = clamp(self.original-note
                                                                + round((self.origin-y - self.mouse-y)
                                                                    / root.piano-row-height),
                                                            root.piano-low-note, root.piano-high-note);
                                                        root.piano-note-moved(self.grabbed-id, tick, note);
                                                    }
                                                } else if (e.kind == PointerEventKind.up) {
                                                    self.grabbed-id = -1;
                                                    self.grab-mode = 0;
                                                }
                                            }
                                            // Ctrl+wheel zooms pitch under the pointer.
                                            // Add Shift to zoom time instead. Ordinary wheel
                                            // input is left to ScrollView for panning.
                                            scroll-event(e) => {
                                                if (e.modifiers.control && e.delta-y != 0px) {
                                                    let factor = e.delta-y < 0px ? 1.15 : 0.87;
                                                    if (e.modifiers.shift) {
                                                        let old-width = root.piano-step-width;
                                                        let next-width = clamp(old-width * factor, 20px, 72px);
                                                        let content-x = self.mouse-x - piano-scroll.viewport-x;
                                                        root.piano-step-width = next-width;
                                                        piano-scroll.viewport-x = clamp(
                                                            self.mouse-x - content-x * next-width / old-width,
                                                            min(0px, piano-scroll.visible-width - root.piano-content-w),
                                                            0px);
                                                    } else {
                                                        let old-height = root.piano-row-height;
                                                        let next-height = clamp(old-height * factor, 5px, 16px);
                                                        let content-y = self.mouse-y - piano-scroll.viewport-y;
                                                        root.piano-row-height = next-height;
                                                        piano-scroll.viewport-y = clamp(
                                                            self.mouse-y - content-y * next-height / old-height,
                                                            min(0px, piano-scroll.visible-height - root.piano-content-h),
                                                            0px);
                                                    }
                                                    accept
                                                } else { reject }
                                            }
                                            // A Tooltip here would hover-linger for as long as
                                            // the piano roll is in use, since this one TouchArea
                                            // covers the whole note canvas. Use the status bar
                                            // instead, which clears the moment the pointer moves
                                            // to something else.
                                            changed has-hover => {
                                                root.hover-hint = self.has-hover
                                                    ? "Ctrl+wheel zooms pitch. Ctrl+Shift+wheel zooms time."
                                                    : root.hover-hint == "Ctrl+wheel zooms pitch. Ctrl+Shift+wheel zooms time."
                                                        ? "" : root.hover-hint;
                                            }
                                        }
                                    }
                                    }

                                    // Pitch axis: same idiom vertically. The
                                    // keyboard column follows viewport-y, so
                                    // keys stay in sync while dragging.
                                    ZoomScrollBar {
                                        vertical: true;
                                        width: 12px;
                                        offset: clamp(-piano-scroll.viewport-y
                                            / max(1px, root.piano-content-h - piano-scroll.visible-height), 0, 1);
                                        visible-fraction: clamp(
                                            piano-scroll.visible-height / max(1px, root.piano-content-h), 0, 1);
                                        scrolled(v) => {
                                            piano-scroll.viewport-y = -v * max(0px,
                                                root.piano-content-h - piano-scroll.visible-height);
                                        }
                                        zoomed(o, f) => {
                                            root.piano-row-height = clamp(
                                                piano-scroll.visible-height / max(1, root.piano-note-count * f),
                                                5px, 16px);
                                            piano-scroll.viewport-y = -o * max(0px,
                                                root.piano-content-h - piano-scroll.visible-height);
                                        }
                                        changed hovered => {
                                            root.hover-hint = self.hovered
                                                ? "Drag to scroll pitch. Drag an end grip to zoom."
                                                : root.hover-hint == "Drag to scroll pitch. Drag an end grip to zoom."
                                                    ? "" : root.hover-hint;
                                        }
                                    }
                                }

                                // The bottom edge is the time scrollbar: drag
                                // its body to pan and either marked end to zoom.
                                HorizontalLayout {
                                    height: 14px;
                                    spacing: 2px;
                                    ZoomScrollBar {
                                        height: 14px;
                                        horizontal-stretch: 1;
                                        offset: clamp(-piano-scroll.viewport-x
                                            / max(1px, root.piano-content-w - piano-scroll.visible-width), 0, 1);
                                        visible-fraction: clamp(
                                            piano-scroll.visible-width / max(1px, root.piano-content-w), 0, 1);
                                        scrolled(v) => {
                                            piano-scroll.viewport-x = -v * max(0px,
                                                root.piano-content-w - piano-scroll.visible-width);
                                        }
                                        zoomed(o, f) => {
                                            root.piano-step-width = clamp(
                                                piano-scroll.visible-width / max(1, root.pattern-length * f),
                                                20px, 72px);
                                            piano-scroll.viewport-x = -o * max(0px,
                                                root.piano-content-w - piano-scroll.visible-width);
                                        }
                                        changed hovered => {
                                            root.hover-hint = self.hovered
                                                ? "Drag to scroll time. Drag an end grip to zoom."
                                                : root.hover-hint == "Drag to scroll time. Drag an end grip to zoom."
                                                    ? "" : root.hover-hint;
                                        }
                                    }
                                    Rectangle { width: 12px; }
                                }

                                Rectangle {
                                    height: 17px;
                                    background: Theme.panel;
                                    Text {
                                        text: "Velocity";
                                        color: Theme.text-faint;
                                        font-size: 8px;
                                        x: 4px;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 55px;
                                    background: Theme.surface;
                                    clip: true;
                                    Rectangle {
                                        x: -piano-scroll.viewport-x;
                                        width: root.pattern-length * root.piano-step-width;
                                        height: parent.height;
                                        background: transparent;
                                        for cell in root.notes : Rectangle {
                                            x: cell.start-tick * root.piano-step-width / 24;
                                            width: max(6px, cell.duration-ticks * root.piano-step-width / 24);
                                            height: parent.height;
                                            border-width: cell.selected ? 1px : 0px;
                                            border-color: Theme.text-muted;
                                            background: transparent;
                                            Rectangle {
                                                x: 3px;
                                                y: parent.height * (127 - cell.velocity) / 127;
                                                width: parent.width - 6px;
                                                height: max(2px, parent.height * cell.velocity / 127);
                                                background: Theme.accent;
                                            }
                                            TouchArea {
                                                mouse-cursor: crosshair;
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.left
                                                        && (e.kind == PointerEventKind.down
                                                        || (e.kind == PointerEventKind.move && self.pressed))) {
                                                        root.velocity-edited(
                                                            cell.id,
                                                            clamp(1 - self.mouse-y / self.height, 0, 1)
                                                        );
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

    }

    // Overlay rather than a VerticalLayout row: appearing on hover must not
    // reflow the work surface beneath the pointer.
    if root.hover-hint != "" || root.status-message != "" : Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: 24px;
        z: 100;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border;
        Text {
            text: root.hover-hint != "" ? root.hover-hint : root.status-message;
            color: Theme.text-muted;
            font-size: 10px;
            x: 8px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    PreferencesDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.preferences-open;
        appearance-preset <=> root.preferences-appearance-preset;
        appearance-accent <=> root.preferences-appearance-accent;
        developer-mode <=> root.preferences-developer-mode;
        validation-error: root.preferences-error;
        audio-output-targets: root.preferences-audio-output-targets;
        audio-buffer-size-index: root.preferences-audio-buffer-size-index;
        audio-sample-rate-text: root.preferences-audio-sample-rate-text;
        audio-auto-reconnect: root.preferences-audio-auto-reconnect;
        audio-error: root.preferences-audio-error;
        shortcut-rows: root.preferences-shortcut-rows;
        shortcut-capturing-id <=> root.preferences-shortcut-capturing-id;
        appearance-preview(preset, accent) => { root.preferences-appearance-preview(preset, accent); }
        save(preset, accent, developer-mode) => { root.preferences-save(preset, accent, developer-mode) }
        cancelled => { root.preferences-cancelled(); }
        audio-refresh-targets => { root.preferences-audio-refresh-targets(); }
        audio-select-output(client, port-l, port-r) => { root.preferences-audio-select-output(client, port-l, port-r); }
        audio-select-buffer-size(i) => { root.preferences-audio-select-buffer-size(i); }
        audio-auto-reconnect-toggled(v) => { root.preferences-audio-auto-reconnect-toggled(v); }
        shortcut-rebind-key(id, key, ctrl, shift, alt, meta) => { root.preferences-shortcut-rebind-key(id, key, ctrl, shift, alt, meta); }
        shortcut-reset(id) => { root.preferences-shortcut-reset(id); }
        shortcut-reset-all => { root.preferences-shortcut-reset-all(); }
    }
    SavePresetDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.save-preset-open;
        title: root.save-preset-title;
        name-text <=> root.save-preset-name;
        category-text <=> root.save-preset-category;
        save-confirmed(name, category) => { root.save-preset-confirmed(name, category); }
        cancelled => { root.save-preset-cancelled(); }
    }

    SaveErrorDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.save-error-open;
        title <=> root.save-error-title;
        detail <=> root.save-error-detail;
        dismissed => { root.save-error-dismissed(); }
    }
    ExportDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.export-open;
        format-index <=> root.export-format;
        bitrate-index <=> root.export-bitrate;
        tail-seconds <=> root.export-tail-seconds;
        accepted(format, bitrate, tail) => { root.export-confirmed(format, bitrate, tail); }
        cancelled => { root.export-open = false; }
    }
    AboutDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.about-open;
        app-version: root.app-version;
        closed => { root.about-open = false; }
    }
}
