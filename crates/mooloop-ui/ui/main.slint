                                                filter-velocity-changed(v) => { root.mlp8-filter-velocity-changed(v); }
                                                voice-feedback-changed(v) => { root.mlp8-voice-feedback-changed(v); }
                                                filter-attack-changed(v) => { root.mlp8-filter-attack-changed(v); }
                                                filter-decay-changed(v) => { root.mlp8-filter-decay-changed(v); }
                                                filter-sustain-changed(v) => { root.mlp8-filter-sustain-changed(v); }
                                                filter-release-changed(v) => { root.mlp8-filter-release-changed(v); }
                                                text-committed(p, t) => { root.mlp8-text-committed(p, t); }
                                                modulation-depth-changed(p, v) => { root.source-modulation-depth-changed(p, v); }
                                                modulation-edit-started(p) => { root.source-modulation-edit-started(p); }
                                                modulation-edit-finished(p) => { root.source-modulation-edit-finished(p); }
                                            }

                                            if !root.editing-bus && root.source-kind == 6 : Ds01DeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: DeviceRackMetrics.header-height;
                                                width: parent.content-width;
                                                height: parent.height - DeviceRackMetrics.header-height;
                                                values: root.ds01-values;
                                                defaults: root.ds01-defaults;
                                                value-texts: root.ds01-value-texts;
                                                step-counts: root.ds01-step-counts;
                                                contours: root.ds01-contours;
                                                preview-minimums: root.ds01-preview-minimums;
                                                preview-maximums: root.ds01-preview-maximums;
                                                burst-ticks: root.ds01-burst-ticks;
                                                bipolars: root.ds01-bipolars;
                                                matrix-source-names: root.ds01-matrix-source-names;
                                                matrix-dest-names: root.ds01-matrix-dest-names;
                                                body-decay-fraction: root.ds01-body-decay-fraction;
                                                span-text: root.ds01-span-text;
                                                page <=> root.ds01-device-page;
                                                modulation-armed: root.modulation-armed-slot >= 0;
                                                modulation-depths: root.source-modulation-depths;
                                                modulation-allowed: root.source-modulation-allowed;
                                                modulation-offsets: root.source-modulation-offsets;
                                                modulation-route-counts: root.source-modulation-route-counts;
                                                value-changed(p, v) => { root.ds01-value-changed(p, v); }
                                                text-committed(p, t) => { root.ds01-text-committed(p, t); }
                                                modulation-depth-changed(p, v) => { root.source-modulation-depth-changed(p, v); }
                                                modulation-edit-started(p) => { root.source-modulation-edit-started(p); }
                                                modulation-edit-finished(p) => { root.source-modulation-edit-finished(p); }
                                            }

                                            if !root.editing-bus && root.source-kind == 7 : AuxInDeviceFace {
                                                x: DeviceRackMetrics.rail-width;
                                                y: DeviceRackMetrics.header-height;
                                                width: parent.content-width;
                                                height: parent.height - DeviceRackMetrics.header-height;
                                                source-names: root.aux-in-source-names;
                                                source-index: root.aux-in-source-index;
                                                outlet-names: root.aux-in-outlet-names;
                                                outlet-index: root.aux-in-outlet-index;
                                                level: root.source.p2;
                                                level-text: root.aux-in-level-text;
                                                tap-text: root.aux-in-tap-text;
                                                refusal-text: root.aux-in-refusal-text;
                                                modulation-armed: root.modulation-armed-slot >= 0;
                                                modulation-depths: root.source-modulation-depths;
                                                modulation-allowed: root.source-modulation-allowed;
                                                modulation-offsets: root.source-modulation-offsets;
                                                modulation-route-counts: root.source-modulation-route-counts;
                                                source-picked(i) => { root.aux-in-source-picked(i); }
                                                outlet-picked(i) => { root.aux-in-outlet-picked(i); }
                                                level-changed(v) => { root.source-param-changed(2, v); }
                                                modulation-depth-changed(p, v) => { root.source-modulation-depth-changed(p, v); }
                                                modulation-edit-started(p) => { root.source-modulation-edit-started(p); }
                                                modulation-edit-finished(p) => { root.source-modulation-edit-finished(p); }
                                            }

                                            if !root.editing-bus : DeviceHeader {
                                                x: DeviceRackMetrics.rail-width; y: 0px; width: parent.content-width;
                                                // The one kind-label list, as the picker and the
                                                // add-channel menu read it. This was eight strings
                                                // in a ternary ladder whose last arm was a bare
                                                // fallback, so a ninth kind would have been headed
                                                // with the eighth's label, and nothing read the
                                                // ladder to report it.
                                                name: SourceKinds.labels[root.source-kind];
                                                kind: "SOURCE / " + source-device.source-units + "U";
                                                preset: root.source-preset-name;
                                                device-color: Theme.accent;
                                            }
                                        }

                                        // The first join, after the chain's head:
                                        // a device added here runs first.
                                        DeviceJoin {
                                            drop-before: 0;
                                            kind-selected(kind) => { root.add-effect-clicked(kind, 0); }
                                        }

                                        // The strip's own row, pinned. When
                                        // `STRIP_PIN` pins it to the head it is
                                        // bundled straight into `BusDeviceFace`
                                        // above rather than drawn again here --
                                        // one box, not two beside each other.
                                        // The tail position below is the other
                                        // half of the same guard: a
                                        // `HorizontalLayout` places its
                                        // children in declaration order, so
                                        // "at the head" and "after the chain"
                                        // are two positions in this file.
                                        // `STRIP_PIN` picks between them, and
                                        // the engine reads the same constant.
                                        for slot[index] in root.effect-slots : cell := Rectangle {
                                            property <length> face-width:
                                                DeviceRackMetrics.unit-width * slot.units
                                                + DeviceRackMetrics.half-gap * (slot.units - 1);
                                            // A container draws no output rail against its
                                            // own face -- it draws one past the last device
                                            // it holds -- so its frame is a rail narrower.
                                            property <bool> is-container: slot.is-container;
                                            property <length> frame-width: self.face-width
                                                + DeviceRackMetrics.rail-width
                                                    * (self.is-container ? 1 : 2);
                                            // The rails the boxes ending here contribute,
                                            // innermost first, between this row and the join.
                                            property <length> tail-width:
                                                slot.closing.length * DeviceRackMetrics.rail-width;
                                            // An empty box draws a join inside it, between its
                                            // face and its own output rail (MOO-218).
                                            property <bool> inner-join: self.is-container && slot.children == 0;
                                            property <length> inner-width:
                                                self.inner-join ? DeviceRackMetrics.join-width : 0px;
                                            // The level of the innermost box closing here.
                                            // An empty container closes itself, one level in
                                            // from its own depth; everything else closes the
                                            // boxes it is the last row of.
                                            property <int> innermost-close:
                                                self.is-container && slot.children == 0
                                                    ? slot.depth + 1 : slot.depth;
                                            // The row after this one, which is what says where a
                                            // container's box closes. A repeater item can index its
                                            // own model, so the box needs nothing from Rust that
                                            // `children` and `depth` were not already carrying.
                                            // Rust's, because a layer may be hiding the
                                            // next row: see `EffectSlotRow.next-depth`.
                                            property <int> next-depth: slot.next-depth;
                                            property <bool> dragging: RackDrag.source == index;
                                            // Which row the pointer is over, answered by the row
                                            // itself from its own bounds. One row is hot at a time
                                            // because the cells tile the rack without gaps.
                                            property <bool> hot: RackDrag.active
                                                && RackDrag.pointer-x >= self.absolute-position.x
                                                && RackDrag.pointer-x < self.absolute-position.x + self.width;
                                            changed hot => { if (self.hot) { RackDrag.target = index; } }
                                            // The pitch of this row, published when the grab
                                            // lands on it. The device shell owns the gesture
                                            // but not the geometry: a container's frame is a
                                            // rail narrower than a leaf's and any row may
                                            // carry the output rails of the boxes ending on
                                            // it, so only the cell can say how wide a gap
                                            // taking it out leaves behind.
                                            changed dragging => {
                                                if (self.dragging) { RackDrag.source-width = self.width; }
                                            }
                                            // The rows between the grab and the landing slide aside.
                                            // The gap *is* the drop indicator: it opens exactly one
                                            // row's pitch, where the dragged face is about to sit, so
                                            // there is nothing to reconcile between a marker and the
                                            // result -- and it opens inside a container's box when the
                                            // drop lands inside one.
                                            property <length> shift: ReorderMath.shift(
                                                index, RackDrag.source, RackDrag.target, RackDrag.source-width);
                                            animate shift { duration: Motion.duration; easing: Motion.curve; }

                                            // A row in a branch its layer is not showing
                                            // takes no room at all (`containers/09`).
                                            visible: !slot.hidden;
                                            width: slot.hidden ? 0px : self.frame-width + self.inner-width
                                                + self.tail-width + DeviceRackMetrics.join-width;
                                            height: DeviceRackMetrics.face-height;

                                            // The box, behind the face. One slice per level per row;
                                            // the head draws the left cap and a row whose successor
                                            // is shallower draws the right one. An empty container
                                            // caps itself, so an empty box still looks like a box.
                                            // `depth` is a count of enclosing boxes, so the
                                            // levels are 1..4 and the loop iterates the
                                            // *values*. Writing `for level[lvl] in [...]`
                                            // and then using `lvl` was a bug that shipped:
                                            // `lvl` is the index, so the levels ran 0..3, and
                                            // `depth >= 0` is true of every row -- every
                                            // device in the rack wore a container's band,
                                            // whether or not it was in one.
                                            //
                                            // The list is `MAX_CONTAINER_DEPTH`
                                            // spelled out, and it is held to
                                            // it by
                                            // `the_rack_draws_a_band_for_every_level_the_engine_blends`
                                            // in `rack_tools.rs`. A derived
                                            // model would be a Rust-supplied
                                            // property for four literals that
                                            // never change at run time; a
                                            // guard on the copy is the cheaper
                                            // half of the same protection.
                                            for level in [1, 2, 3, 4] : ContainerEnclosure {
                                                property <bool> inside: slot.depth >= level;
                                                property <bool> is-head: slot.is-container && slot.depth == level - 1;
                                                visible: self.inside || self.is-head;
                                                level: level;
                                                head: self.is-head;
                                                cap-right: (self.is-head && slot.children == 0)
                                                    || (self.inside && cell.next-depth < level);
                                                x: cell.shift;
                                                // A box that closes here ends after its own
                                                // rail and before the join arrow, which is
                                                // leading out of it. A box that carries on
                                                // spans the arrow too, because that arrow is
                                                // inside it.
                                                width: self.cap-right
                                                    ? cell.frame-width + cell.inner-width
                                                        + (cell.innermost-close - level + 1)
                                                            * DeviceRackMetrics.rail-width
                                                    : cell.width;
                                            }

                                            // What the dragged row left behind, so the grab has a
                                            // visible origin to snap back to when nothing moves.
                                            // The bracket over the branch a layer is
                                            // showing (`containers/09`). The last row's
                                            // slice stops at its face, before the join
                                            // arrow that leads out of the branch.
                                            if slot.bracket : LayerBracket {
                                                x: cell.shift;
                                                width: slot.bracket-end ? cell.frame-width + cell.inner-width : cell.width;
                                                start: slot.bracket-start;
                                                end: slot.bracket-end;
                                            }

                                            if cell.dragging : Rectangle {
                                                x: cell.shift;
                                                width: cell.frame-width;
                                                height: parent.height;
                                                border-width: Theme.hairline;
                                                border-color: Theme.accent.with-alpha(0.45);
                                                border-radius: Theme.radius-md;
                                                background: Theme.background.with-alpha(0.5);
                                            }

                                            DeviceFrame {
                                                // A row in a box, or a box's own head, draws no card:
                                                // `ContainerEnclosure` behind it is that card, drawn
                                                // once around the whole run.
                                                contained: slot.depth > 0 || cell.is-container;
                                                tail-rail: !cell.is-container;
                                                container-chrome: cell.is-container;
                                                // Tracks the pointer directly rather than through an
                                                // animation: an eased `x` lags the hand and reads as
                                                // the interface being slow. The rows it displaces are
                                                // where the animation belongs, because that motion is
                                                // explaining a change rather than following a finger.
                                                x: cell.shift + (cell.dragging ? RackDrag.dx : 0px);
                                                y: cell.dragging ? -8px : 0px;
                                                width: cell.frame-width;
                                                height: DeviceRackMetrics.face-height;
                                                // Lifted off the rack while it is carried.
                                                drop-shadow-blur: cell.dragging ? 20px : 0px;
                                                drop-shadow-color: #000000dd;
                                                drop-shadow-offset-y: cell.dragging ? 8px : 0px;
                                                opacity: cell.dragging ? 0.95 : 1.0;
                                                input-left-db: slot.input-left-db;
                                                input-right-db: slot.input-right-db;
                                                output-left-db: slot.output-left-db;
                                                output-right-db: slot.output-right-db;
                                                bypass-enabled: true;
                                                bypassed: slot.bypassed;
                                                bypass-toggled => { root.effect-bypass-toggled(index); }
                                                input-trim-enabled: true;
                                                input-trim: slot.input-trim-db;
                                                input-trim-changed(v) => { root.effect-input-trim-changed(index, v); }
                                                output-trim-enabled: true;
                                                output-trim: slot.output-trim-db;
                                                output-trim-changed(v) => { root.effect-output-trim-changed(index, v); }
                                                // A container has no node to
                                                // be wet with, and the engine
                                                // refuses this one outright --
                                                // `EffectChain::process` says
                                                // why. The Mix knob on its own
                                                // face is the box's blend; an
                                                // inert second dry/wet beside
                                                // it is the "convincing but
                                                // inert control" the rack's own
                                                // rule names.
                                                wet-dry-enabled: !slot.is-container;
                                                wet-dry: slot.wet-dry;
                                                wet-dry-text: round(slot.wet-dry * 100) + "% wet";
                                                wet-dry-changed(v) => { root.effect-wet-dry-changed(index, v); }
                                                removal-enabled: true;
                                                is-container: slot.is-container;
                                                container-children: slot.children;
                                                // Wrapping a container in
                                                // another is legal, so this
                                                // is on every row -- until
                                                // the box it would make is
                                                // one the engine will not
                                                // blend.
                                                wrap-enabled: slot.wrap-enabled;
                                                unwrap-enabled: slot.is-container;
                                                wrap-requested(kind) => { root.wrap-effect-clicked(index, kind); }
                                                unwrap-requested => { root.unwrap-effect-clicked(index); }
                                                selected: slot.selected;
                                                duplicate-enabled: true;
                                                duplicate-requested => { root.duplicate-effect-clicked(index); }
                                                remove-requested => { root.remove-effect-clicked(index); }
                                                preset-enabled: true;
                                                preset-options: slot.preset-options;
                                                preset-selected(i) => { root.effect-preset-selected(index, i); }
                                                save-preset-requested => { root.save-effect-preset-requested(index); }

                                                if slot.kind == 0 : FilterDeviceFace {
                                                    modulation-armed: !root.editing-bus && root.modulation-armed-slot >= 0;
                                                    modulation-depths: slot.modulation-depths;
                                                    modulation-allowed: slot.modulation-allowed;
                                                    modulation-offsets: slot.modulation-offsets;
                                                    modulation-route-counts: slot.modulation-route-counts;
                                                    modulation-depth-changed(p, v) => { root.effect-modulation-depth-changed(index, p, v); }
                                                    modulation-edit-started(p) => { root.effect-modulation-edit-started(index, p); }
                                                    modulation-edit-finished(p) => { root.effect-modulation-edit-finished(index, p); }
                                                    x: DeviceRackMetrics.rail-width;
                                                    y: 0px;
                                                    width: parent.content-width;
                                                    height: parent.height;
                                                    slot-index: index;
                                                    slot-count: root.effect-slots.length;
                                                    bypassed: slot.bypassed;
                                                    preset-name: slot.preset-name;
                                                    cutoff: slot.p0;
                                                    resonance: slot.p1;
                                                    mode: round(slot.p2 * 2);
                                                    slope: round(slot.p3);
                                                    drive: slot.p4;
                                                    cutoff-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                    resonance-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                    mode-changed(v) => { root.effect-param-changed(index, 2, v * 1.0 / 2.0); }
                                                    slope-changed(v) => { root.effect-param-changed(index, 3, v * 1.0); }
                                                    drive-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                    reorder-requested(target) => { root.reorder-effect(index, target); }
                                                    select-requested => { root.device-selected(index); }
                                                }
                                                if slot.kind == 1 : DriveDeviceFace {
                                                    modulation-armed: !root.editing-bus && root.modulation-armed-slot >= 0;
                                                    modulation-depths: slot.modulation-depths;
                                                    modulation-allowed: slot.modulation-allowed;
                                                    modulation-offsets: slot.modulation-offsets;
                                                    modulation-route-counts: slot.modulation-route-counts;
                                                    modulation-depth-changed(p, v) => { root.effect-modulation-depth-changed(index, p, v); }
                                                    modulation-edit-started(p) => { root.effect-modulation-edit-started(index, p); }
                                                    modulation-edit-finished(p) => { root.effect-modulation-edit-finished(index, p); }
                                                    x: DeviceRackMetrics.rail-width;
                                                    y: 0px;
                                                    width: parent.content-width;
                                                    height: parent.height;
                                                    slot-index: index;
                                                    slot-count: root.effect-slots.length;
                                                    bypassed: slot.bypassed;
                                                    preset-name: slot.preset-name;
                                                    drive: slot.p0;
                                                    curve: round(slot.p1 * 3);
                                                    tone: slot.p2;
                                                    mix: slot.p3;
                                                    output: slot.p4;
                                                    drive-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                    curve-changed(i) => { root.effect-param-changed(index, 1, i * 1.0 / 3.0); }
                                                    tone-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                    mix-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                    output-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                    reorder-requested(target) => { root.reorder-effect(index, target); }
                                                    select-requested => { root.device-selected(index); }
                                                }
                                                if slot.kind == 12 : PreampDeviceFace {
                                                    modulation-armed: !root.editing-bus && root.modulation-armed-slot >= 0;
                                                    modulation-depths: slot.modulation-depths;
                                                    modulation-allowed: slot.modulation-allowed;
                                                    modulation-offsets: slot.modulation-offsets;
                                                    modulation-route-counts: slot.modulation-route-counts;
                                                    modulation-depth-changed(p, v) => { root.effect-modulation-depth-changed(index, p, v); }
                                                    modulation-edit-started(p) => { root.effect-modulation-edit-started(index, p); }
                                                    modulation-edit-finished(p) => { root.effect-modulation-edit-finished(index, p); }
                                                    x: DeviceRackMetrics.rail-width;
                                                    y: 0px;
                                                    width: parent.content-width;
                                                    height: parent.height;
                                                    slot-index: index;
                                                    slot-count: root.effect-slots.length;
                                                    bypassed: slot.bypassed;
                                                    preset-name: slot.preset-name;
                                                    drive: slot.p0;
                                                    voicing: round(slot.p1 * 3);
                                                    mix: slot.p2;
                                                    output: slot.p3;
                                                    deviation: slot.preamp-deviation;
                                                    display-enabled: slot.preamp-display-enabled;
                                                    display-toggled(v) => { root.preamp-display-changed(index, v); }
                                                    drive-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                    voicing-changed(i) => { root.effect-param-changed(index, 1, i * 1.0 / 3.0); }
                                                    mix-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                    output-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                    reorder-requested(target) => { root.reorder-effect(index, target); }
                                                    select-requested => { root.device-selected(index); }
                                                }
                                                if slot.kind == 2 : BitcrushDeviceFace {
                                                    modulation-armed: !root.editing-bus && root.modulation-armed-slot >= 0;
                                                    modulation-depths: slot.modulation-depths;
                                                    modulation-allowed: slot.modulation-allowed;
                                                    modulation-offsets: slot.modulation-offsets;
                                                    modulation-route-counts: slot.modulation-route-counts;
                                                    modulation-depth-changed(p, v) => { root.effect-modulation-depth-changed(index, p, v); }
                                                    modulation-edit-started(p) => { root.effect-modulation-edit-started(index, p); }
                                                    modulation-edit-finished(p) => { root.effect-modulation-edit-finished(index, p); }
                                                    x: DeviceRackMetrics.rail-width;
                                                    y: 0px;
                                                    width: parent.content-width;
                                                    height: parent.height;
                                                    slot-index: index;
                                                    slot-count: root.effect-slots.length;
                                                    bypassed: slot.bypassed;
                                                    preset-name: slot.preset-name;
                                                    style: round(slot.p3 * 3);
                                                    bits: slot.p0;
                                                    downsample: slot.p1;
                                                    mix: slot.p2;
                                                    style-changed(i) => { root.effect-param-changed(index, 3, i * 1.0 / 3.0); }
                                                    bits-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                    downsample-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                    mix-changed(v) => { root.effect-param-changed(index, 2, v); }
                                                    reorder-requested(target) => { root.reorder-effect(index, target); }
                                                    select-requested => { root.device-selected(index); }
                                                }
                                                if slot.kind == 3 : DelayDeviceFace {
                                                    modulation-armed: !root.editing-bus && root.modulation-armed-slot >= 0;
                                                    modulation-depths: slot.modulation-depths;
                                                    modulation-allowed: slot.modulation-allowed;
                                                    modulation-offsets: slot.modulation-offsets;
                                                    modulation-route-counts: slot.modulation-route-counts;
                                                    modulation-depth-changed(p, v) => { root.effect-modulation-depth-changed(index, p, v); }
                                                    modulation-edit-started(p) => { root.effect-modulation-edit-started(index, p); }
                                                    modulation-edit-finished(p) => { root.effect-modulation-edit-finished(index, p); }
                                                    x: DeviceRackMetrics.rail-width;
                                                    y: 0px;
                                                    width: parent.content-width;
                                                    height: parent.height;
                                                    slot-index: index;
                                                    slot-count: root.effect-slots.length;
                                                    bypassed: slot.bypassed;
                                                    preset-name: slot.preset-name;
                                                    time: slot.p0;
                                                    feedback: slot.p1;
                                                    mode: round(slot.p2 * 2);
                                                    cross: slot.p3;
                                                    tone: slot.p4;
                                                    mix: slot.p5;
                                                    bpm: root.bpm;
                                                    tempo-sync: slot.p16 >= 0.5;
                                                    time-division: round(slot.p17);
                                                    time-changed(v) => { root.effect-param-changed(index, 0, v); }
                                                    tempo-sync-changed(enabled) => {
                                                        root.delay-tempo-sync-changed(index, enabled);
                                                    }
                                                    time-division-changed(division) => {
                                                        root.delay-time-division-changed(index, division);
                                                    }
                                                    feedback-changed(v) => { root.effect-param-changed(index, 1, v); }
                                                    mode-changed(i) => { root.effect-param-changed(index, 2, i * 1.0 / 2.0); }
                                                    cross-changed(v) => { root.effect-param-changed(index, 3, v); }
                                                    tone-changed(v) => { root.effect-param-changed(index, 4, v); }
                                                    mix-changed(v) => { root.effect-param-changed(index, 5, v); }
                                                    reorder-requested(target) => { root.reorder-effect(index, target); }
                                                    select-requested => { root.device-selected(index); }
