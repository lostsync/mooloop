    in-out property <bool> channel-clipboard-available: false;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    // 0=Undo, 1=Redo, 2=Cut channel, 3=Copy channel, 4=Paste channel,
    // 5=Clone channel, 6=Delete channel.  Menu, keyboard, and context menus
