import { Theme } from "theme.slint";
import { ParameterKnob } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";

// Container face. A container is a device that holds an ordered run of the
// devices after it, so its own face is small: what it is, how many devices
// are inside, and the mix across the whole run.
//
// The *frame* around the run -- the indent, the collapse, the drop target on
// its inside edge -- is step 04 of `docs/plans/containers/`. This face is
// what makes the row visible and its one control reachable in the meantime;
// until step 03 the mix is inert and says so.
export component ContainerDeviceFace inherits EffectDeviceShell {
    name: "Chain";
    kind: "FX / 1U";
    // Normalized 0..1, and already the natural range: a mix is a ratio.
    in-out property <float> mix;
    // How many rows of the rack are inside this one.
    in property <int> children;
    in property <bool> mix-inert: false;
    callback mix-changed(float);

    VerticalLayout {
        padding: 6px;
        padding-top: DeviceRackMetrics.header-height + 6px;
        spacing: 4px;

        Rectangle {
            height: 104px;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                alignment: center;
                Text {
                    text: root.children == 1 ? "1 device" : root.children + " devices";
                    color: Theme.text;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.children == 0 ? "empty" : "inside";
                    color: Theme.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
                if root.mix-inert : Text {
                    text: "mix pending";
                    color: Theme.text-muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            ParameterKnob {
                width: 69px;
                diameter: 38px;
                label: "Mix";
                tooltip: "Dry/wet across everything in this container";
                value <=> root.mix;
                default-value: 1.0;
                value-text: round(root.mix * 100) + " %";
                changed(v) => { root.mix-changed(v); }
            }
        }
    }
}
