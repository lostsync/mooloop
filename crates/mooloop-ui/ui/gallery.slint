import { HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";
import { DisplayPrefs, Theme } from "theme.slint";
import {
    AudioOrientation, IconButton, LedIndicator, MiniKnob, MixerFader, MuteButton,
    ParameterFader, ParameterKnob, PeakMeter, SectionLabel, SegmentedControl, SoloButton,
    StereoPeakMeter, ToggleButton, ToolButton, TransportButton, ValueScale, ValueReadout,
    TimeDivisionKnob, ZoomScrollBar
} from "controls.slint";
import {
    ChannelMeter, ClipIndicator, CorrelationMeter, GainReductionMeter, MasterMeter,
    MeterScale, SegmentedMeter
} from "meters.slint";
import { EnvelopeEditor } from "envelope.slint";
import {
    BeatLamps, MenuField, NameField, PositionReadout, StepperField, TempoField,
    ToolbarLabel, ToolbarRule, ToolIcons, ToolModeButton
} from "toolbar.slint";
import { PreferencesDialog } from "appearance-dialog.slint";
import {
    DeviceAddSlot, DeviceFrame, DeviceRackMetrics
} from "device-rack.slint";
import { FilterDeviceFace } from "filter-device.slint";
import { DriveDeviceFace } from "drive-device.slint";
import { BitcrushDeviceFace } from "bitcrush-device.slint";
import { DelayDeviceFace } from "delay-device.slint";
import { GateDeviceFace } from "gate-device.slint";
import { CompressorDeviceFace } from "compressor-device.slint";
import { LimiterDeviceFace } from "limiter-device.slint";
import { EqDeviceFace } from "eq-device.slint";
import { ReverbDeviceFace } from "reverb-device.slint";
import { PlateDeviceFace } from "plate-device.slint";
import { ModulationDeviceFace } from "modulation-device.slint";

export component ControlGallery inherits Window {
    title: "mooloop control gallery";
    preferred-width: 980px;
    preferred-height: 720px;
    background: Theme.background;

    in-out property <float> linear-value: 0.64;
    in-out property <float> gallery-delay-time: 0.7815;
    in-out property <bool> gallery-delay-tempo-sync: true;
    in-out property <int> gallery-delay-division: 2;
    in-out property <float> frequency: 440;
    in-out property <float> meter-value: -9;
    in-out property <int> segment: 1;
    in-out property <int> gallery-preset;
    in-out property <bool> gallery-dialog-open;
    in-out property <string> gallery-accent: "#84CC16";
    in-out property <bool> gallery-developer-mode;
    in-out property <bool> gallery-smooth-curves: true;
    in-out property <float> bipolar-value: 0.5;
    in-out property <float> mini-volume: 0.8;
    in-out property <float> mini-pan: 0;
    in-out property <float> zoom-offset: 0.2;
    in-out property <float> zoom-visible: 0.3;
    in-out property <float> zoom-offset-v: 0.1;
    in-out property <float> zoom-visible-v: 0.5;
    in-out property <float> env-attack: 0.12;
    in-out property <float> env-decay: 0.3;
    in-out property <float> env-sustain: 0.6;
    in-out property <float> env-release: 0.25;
    in-out property <float> reduction-db: 6;
    in-out property <float> correlation: 0.7;
    in-out property <bool> transport-playing;
    in-out property <bool> transport-armed;
    in-out property <int> gallery-steps: 16;
    in-out property <int> gallery-snap: 2;
    in-out property <int> gallery-pattern;
    in-out property <int> gallery-tool;
    in-out property <int> gallery-bpm: 128;
    in-out property <int> gallery-beat: 1;
    in-out property <string> gallery-pattern-name;

    function use-preset(preset: int) {
        root.gallery-preset = preset;
        if (preset == 1) {
            Theme.background = #151617; Theme.panel = #111213; Theme.surface = #222426;
            Theme.surface-raised = #2c2f31; Theme.surface-active = #373a3d; Theme.border = #45494d;
            Theme.text = #f1f3f5; Theme.text-muted = #a6adb4; Theme.text-faint = #61686f;
            Theme.accent = #f59e0b; Theme.accent-active = #67450a; Theme.focus = #fbbf24;
        } else if (preset == 2) {
            Theme.background = #000000; Theme.panel = #080808; Theme.surface = #151515;
            Theme.surface-raised = #262626; Theme.surface-active = #363636; Theme.border = #707070;
            Theme.text = #ffffff; Theme.text-muted = #c7c7c7; Theme.text-faint = #888888;
            Theme.accent = #22d3ee; Theme.accent-active = #155e75; Theme.focus = #67e8f9;
        } else {
            Theme.background = #18181b; Theme.panel = #131316; Theme.surface = #232328;
            Theme.surface-raised = #2a2a2e; Theme.surface-active = #33333a; Theme.border = #3f3f46;
            Theme.text = #e4e4e7; Theme.text-muted = #a1a1aa; Theme.text-faint = #52525b;
            Theme.accent = #84cc16; Theme.accent-active = #2d6a3e; Theme.focus = #bef264;
        }
    }

    VerticalBox {
        spacing: 0px;
        Rectangle {
            height: 44px;
            background: Theme.surface;
            HorizontalBox {
                padding: 8px;
                spacing: 6px;
                Text { text: "MOOLOOP / CONTROLS"; color: Theme.text; font-size: 14px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                ToolButton {
                    text: "Mooloop"; active: root.gallery-preset == 0;
                    clicked => { root.use-preset(0); }
                }
                ToolButton {
                    text: "Graphite"; active: root.gallery-preset == 1;
                    clicked => { root.use-preset(1); }
                }
                ToolButton {
                    text: "High Contrast"; active: root.gallery-preset == 2;
                    clicked => { root.use-preset(2); }
                }
                ToolButton {
                    text: "Appearance...";
                    clicked => { root.gallery-dialog-open = true; }
                }
            }
        }

        ScrollView {
            viewport-width: self.visible-width;
            viewport-height: 1760px;
            VerticalBox {
                padding: 18px;
                spacing: 18px;

                SectionLabel { text: "PARAMETER KNOBS"; }
                HorizontalBox {
                    spacing: 20px;
                    alignment: start;
                    ParameterKnob {
                        label: "MIX"; tooltip: "Linear wet/dry mix";
                        value <=> root.linear-value;
                        default-value: 0.5;
                        value-text: round(root.linear-value * 100) + "%";
                    }
                    ParameterKnob {
                        label: "FREQUENCY"; tooltip: "Logarithmic frequency";
                        value <=> root.frequency;
                        minimum: 20; maximum: 20000; default-value: 440;
                        scale: ValueScale.logarithmic;
                        value-text: root.frequency >= 1000
                            ? round(root.frequency / 100) / 10 + " kHz"
                            : round(root.frequency) + " Hz";
                    }
                    TimeDivisionKnob {
                        label: "DELAY";
                        tooltip: "Milliseconds or tempo-synced delay time";
                        value <=> root.gallery-delay-time;
                        bpm: root.gallery-bpm;
                        tempo-sync <=> root.gallery-delay-tempo-sync;
                        division <=> root.gallery-delay-division;
                    }
                    ParameterKnob {
                        label: "DISABLED"; value: 0.35; value-text: "35%"; enabled: false;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SectionLabel { text: "FADERS AND METERS"; }
                HorizontalBox {
                    spacing: 24px;
                    alignment: start;
                    VerticalBox {
                        width: 300px;
                        spacing: 8px;
                        ParameterFader {
                            label: "LEVEL"; value <=> root.linear-value; default-value: 0.75;
                            tooltip: "Horizontal level fader";
                        }
                        ParameterFader {
                            label: "FREQ"; value <=> root.frequency;
                            minimum: 20; maximum: 20000; default-value: 440;
                            scale: ValueScale.logarithmic; tooltip: "Logarithmic frequency fader";
                        }
                        ValueReadout { value-text: round(root.frequency) + " Hz"; }
                    }
                    ParameterFader {
                        label: "GAIN"; value <=> root.linear-value; default-value: 0.75;
                        orientation: AudioOrientation.vertical;
                    }
                    VerticalBox {
                        width: 260px;
                        spacing: 10px;
                        ParameterFader {
                            label: "METER"; value <=> root.meter-value;
                            minimum: -60; maximum: 0; default-value: -12; step: 1;
                        }
                        StereoPeakMeter {
                            left-db: root.meter-value;
                            right-db: root.meter-value - 3;
                            held-left-db: max(root.meter-value, -3);
                            held-right-db: max(root.meter-value - 3, -6);
                            left-clipping: root.meter-value >= 0;
                            right-clipping: false;
                        }
                        PeakMeter {
                            width: 12px; height: 120px;
                            orientation: AudioOrientation.vertical;
                            level-db: root.meter-value;
                            held-db: max(root.meter-value, -3);
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SectionLabel { text: "COMMANDS AND MODES"; }
                HorizontalBox {
                    spacing: 10px;
                    alignment: start;
                    ToolButton { text: "Command"; tooltip: "Regular command"; }
                    ToolButton { text: "Selected"; active: true; }
                    ToolButton { text: "Disabled"; enabled: false; }
                    ToggleButton { text: "Toggle"; checked: true; }
                    SegmentedControl {
                        width: 280px;
                        options: ["Mono", "Stereo", "M/S"];
                        selected-index <=> root.segment;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SectionLabel { text: "BIPOLAR AND COMPACT KNOBS"; }
                HorizontalBox {
                    spacing: 20px;
                    alignment: start;
                    ParameterKnob {
                        label: "ENV AMT"; tooltip: "Bipolar modulation depth";
                        value <=> root.bipolar-value; default-value: 0.5;
                        bipolar: true; fill: Theme.warning;
                        value-text: (round((root.bipolar-value * 2 - 1) * 100) > 0 ? "+" : "")
                            + round((root.bipolar-value * 2 - 1) * 100) + "%";
                    }
                    ParameterKnob {
                        label: "LARGE"; tooltip: "A knob at a bigger diameter";
                        diameter: 60px; width: 68px;
                        value <=> root.linear-value; default-value: 0.5;
                        value-text: round(root.linear-value * 100) + "%";
                    }
                    VerticalBox {
                        alignment: center;
                        spacing: 6px;
                        SectionLabel { text: "MINI (RACK ROW)"; }
                        HorizontalBox {
                            spacing: 8px;
                            alignment: start;
                            MiniKnob {
                                label: "Volume"; value <=> root.mini-volume; default-value: 0.8;
                                value-text: round(root.mini-volume * 100) + "%";
                            }
                            MiniKnob {
                                label: "Pan"; value <=> root.mini-pan;
                                minimum: -1; maximum: 1; default-value: 0; bipolar: true;
                                value-text: abs(root.mini-pan) < 0.01 ? "Center"
                                    : root.mini-pan < 0 ? "L " + round(abs(root.mini-pan) * 100)
                                    : "R " + round(root.mini-pan * 100);
                            }
                            MiniKnob {
                                label: "Send"; diameter: 28px;
                                value <=> root.linear-value; fill: Theme.warning;
                                value-text: round(root.linear-value * 100) + "%";
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SectionLabel { text: "ENVELOPE"; }
                HorizontalBox {
                    spacing: 20px;
                    alignment: start;
                    EnvelopeEditor {
                        width: 340px;
                        height: 130px;
                        attack <=> root.env-attack;
                        decay <=> root.env-decay;
                        sustain <=> root.env-sustain;
                        release <=> root.env-release;
                        attack-text: round(root.env-attack * 5000) + " ms";
                        decay-text: round(root.env-decay * 5000) + " ms";
                        sustain-text: round(root.env-sustain * 100) + "%";
                        release-text: round(root.env-release * 5000) + " ms";
                    }
                    VerticalBox {
                        alignment: start;
                        spacing: 4px;
                        SectionLabel { text: "DRAG THE HANDLES"; }
                        Text {
                            text: "Attack sets the peak, the middle handle sets decay and\nsustain together, and the last handle sets release.";
                            color: Theme.text-muted;
                            font-size: 10px;
                        }
                        EnvelopeEditor {
                            width: 200px;
                            height: 80px;
                            enabled: false;
                            attack: 0.05; decay: 0.5; sustain: 0.2; release: 0.6;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SectionLabel { text: "METERING"; }
                HorizontalBox {
                    spacing: 26px;
                    alignment: start;

                    VerticalBox {
                        alignment: start;
                        spacing: 8px;
                        SectionLabel { text: "MASTER"; }
                        MasterMeter {
                            width: 240px;
                            left-db: root.meter-value;
                            right-db: root.meter-value - 3;
                            held-left-db: max(root.meter-value, -3);
                            held-right-db: max(root.meter-value - 3, -6);
                            left-clipping: root.meter-value >= 0;
                        }
                        SectionLabel { text: "CORRELATION"; }
                        CorrelationMeter { width: 200px; correlation: root.correlation; }
                        ParameterFader {
                            label: "PHASE"; value <=> root.correlation;
                            minimum: -1; maximum: 1; default-value: 1; bipolar: true;
                            width: 240px;
                        }
                        SectionLabel { text: "GAIN REDUCTION"; }
                        GainReductionMeter { width: 200px; reduction-db: root.reduction-db; }
                        ParameterFader {
                            label: "GR"; value <=> root.reduction-db;
                            minimum: 0; maximum: 24; default-value: 0;
                            width: 240px;
                        }
                    }

                    VerticalBox {
                        alignment: start;
                        spacing: 8px;
                        SectionLabel { text: "SEGMENTED"; }
                        HorizontalBox {
                            spacing: 10px;
                            alignment: start;
                            SegmentedMeter {
                                width: 12px; height: 150px;
                                level-db: root.meter-value;
                                held-db: max(root.meter-value, -3);
                            }
                            MeterScale { width: 24px; height: 150px; }
                            ChannelMeter {
                                height: 150px;
                                left-db: root.meter-value;
                                right-db: root.meter-value - 6;
                                held-left-db: max(root.meter-value, -3);
                                held-right-db: max(root.meter-value - 6, -9);
                                clipping: root.meter-value >= -1;
                            }
                            MasterMeter {
                                height: 150px;
                                orientation: AudioOrientation.vertical;
                                left-db: root.meter-value;
                                right-db: root.meter-value - 3;
                                held-left-db: max(root.meter-value, -3);
                                held-right-db: max(root.meter-value - 3, -6);
                                left-clipping: root.meter-value >= 0;
                            }
                        }
                    }

                    VerticalBox {
                        alignment: start;
                        spacing: 8px;
                        width: 200px;
                        SectionLabel { text: "MIXER STRIP"; }
                        HorizontalBox {
                            spacing: 8px;
                            alignment: start;
                            MixerFader {
                                height: 150px;
                                value <=> root.linear-value;
                                value-text: round(root.linear-value * 100) + "%";
                            }
                            ChannelMeter {
                                height: 150px;
                                left-db: root.meter-value;
                                right-db: root.meter-value - 6;
                                held-left-db: max(root.meter-value, -3);
                                held-right-db: max(root.meter-value - 6, -9);
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SectionLabel { text: "TRANSPORT, STATE AND INDICATORS"; }
                HorizontalBox {
                    spacing: 10px;
                    alignment: start;
                    TransportButton {
                        text: "\u{25b6}"; tooltip: "Play"; role: "play";
                        active: root.transport-playing;
                        clicked => { root.transport-playing = !root.transport-playing; }
                    }
                    TransportButton { text: "\u{25a0}"; tooltip: "Stop"; }
                    TransportButton {
                        text: "\u{25cf}"; tooltip: "Record"; role: "record";
                        active: root.transport-armed;
                        clicked => { root.transport-armed = !root.transport-armed; }
                    }
                    IconButton { text: "\u{2699}"; tooltip: "Settings"; }
                    IconButton { text: "+"; tooltip: "Add channel"; }
                    MuteButton { muted: true; }
                    SoloButton { soloed: true; }
                    MuteButton { }
                    SoloButton { }
                    VerticalBox {
                        alignment: center;
                        spacing: 4px;
                        LedIndicator { on: root.transport-playing; tooltip: "Running"; }
                        LedIndicator { on: root.transport-armed; led-color: Theme.destructive; tooltip: "Armed"; }
                    }
                    ClipIndicator { clipping: root.meter-value >= 0; }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SectionLabel { text: "TOOLBAR FIELDS"; }
                Rectangle {
                    height: 34px;
                    background: Theme.surface;
                    border-radius: 3px;
                    HorizontalBox {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 3px;

                        PositionReadout {
                            bar: 12; beat: root.gallery-beat; tick: 48;
                        }
                        BeatLamps {
                            current: root.gallery-beat - 1;
                            running: true;
                        }
                        ToolbarRule {}
                        TempoField { bpm <=> root.gallery-bpm; }
                        ToolbarRule {}
                        ToolbarLabel { text: "PAT"; }
                        Rectangle {
                            height: 24px;
                            width: gallery-pattern-group.preferred-width;
                            border-radius: 3px;
                            background: Theme.surface-raised;
                            gallery-pattern-group := HorizontalLayout {
                                spacing: 0px;
                                StepperField {
                                    value: root.gallery-pattern + 1;
                                    minimum: 1; maximum: 4;
                                    value-width: 26px;
                                    field-background: transparent;
                                    tooltip: "Selected pattern";
                                    changed(v) => { root.gallery-pattern = v - 1; }
                                }
                                MenuField {
                                    options: ["01  Intro", "02  Beat A", "03  Beat B", "04  Break"];
                                    selected-index <=> root.gallery-pattern;
                                    display-text: "";
                                    field-width: 0px;
                                    menu-width: 160px;
                                    field-background: transparent;
                                    tooltip: "Jump to pattern";
                                }
                            }
                        }
                        NameField {
                            text <=> root.gallery-pattern-name;
                            placeholder: "Pattern " + (root.gallery-pattern + 1);
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                SectionLabel { text: "DEVICE FACES"; }
                HorizontalBox {
                    spacing: 4px;
                    alignment: start;
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width + DeviceRackMetrics.rail-width * 2;
                        height: DeviceRackMetrics.face-height;
                        output-trim-enabled: true;
                        output-trim: -2.5;
                        input-trim-enabled: true;
                        input-trim: 3;
                        bypass-enabled: true;
                        wet-dry-enabled: true;
                        wet-dry: 0.65;
                        wet-dry-text: "65% wet";
                        input-left-db: -9;
                        input-right-db: -12;
                        output-left-db: -15;
                        output-right-db: -18;
                        FilterDeviceFace {
                            x: DeviceRackMetrics.rail-width;
                            y: 0px;
                            width: parent.content-width;
                            height: parent.height;
                            slot-index: 0;
                            slot-count: 8;
                            cutoff: 0.62;
                            resonance: 0.45;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width;
                        height: DeviceRackMetrics.face-height;
                        FilterDeviceFace {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            slot-index: 1;
                            slot-count: 8;
                            bypassed: true;
                            mode: 2;
                            slope: 1;
                            cutoff: 0.3;
                            resonance: 0.1;
                            drive: 0.35;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width;
                        height: DeviceRackMetrics.face-height;
                        DriveDeviceFace {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            slot-index: 2;
                            slot-count: 8;
                            curve: 2;
                            drive: 0.55;
                            tone: 0.7;
                            mix: 1.0;
                            output: 0.5;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width;
                        height: DeviceRackMetrics.face-height;
                        BitcrushDeviceFace {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            slot-index: 3;
                            slot-count: 8;
                            bits: 0.25;
                            downsample: 0.4;
                            mix: 1.0;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width * 2 + DeviceRackMetrics.half-gap;
                        height: DeviceRackMetrics.face-height;
                        DelayDeviceFace {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            slot-index: 4;
                            slot-count: 8;
                            mode: 0;
                            time: 0.7815;
                            feedback: 0.62;
                            cross: 1.0;
                            tone: 0.6;
                            mix: 0.35;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width * 2 + DeviceRackMetrics.half-gap;
                        height: DeviceRackMetrics.face-height;
                        GateDeviceFace {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            slot-index: 5; slot-count: 8;
                            threshold: 0.5; attack: 0.3941; hold: 0.02;
                            release: 0.6058; range: 0.15;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width * 2 + DeviceRackMetrics.half-gap;
                        height: DeviceRackMetrics.face-height;
                        CompressorDeviceFace {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            slot-index: 6; slot-count: 8;
                            threshold: 0.55; ratio: 0.6; attack: 0.6388;
                            release: 0.5304; knee: 0.5; makeup: 0.25;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width;
                        height: DeviceRackMetrics.face-height;
                        LimiterDeviceFace {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            slot-index: 7; slot-count: 8;
                            ceiling: 0.75; release: 0.6294; gain: 0.5;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width * 3 + DeviceRackMetrics.half-gap * 2;
                        height: DeviceRackMetrics.face-height;
                        EqDeviceFace {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            slot-index: 8; slot-count: 9;
                            target: 0.25; enabled: 1; frequency: 0.61; gain: 0.64; q: 0.32; character: 0.25;
                            band-data: [0.18, 0.58, 0.707, 1, 1, 0.35, 0.42, 0.707, 1, 0, 0.53, 0.66, 1.4, 1, 0, 0.67, 0.39, 0.9, 1, 0, 0.76, 0.57, 0.707, 1, 0, 0.84, 0.45, 1.1, 1, 0, 0.93, 0.62, 0.707, 1, 2, 0.1, 0.707, 1, 1, 0.96, 0.707, 1, 1];
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width * 3 + DeviceRackMetrics.half-gap * 2;
                        height: DeviceRackMetrics.face-height;
                        ReverbDeviceFace {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            slot-index: 9; slot-count: 10;
                            shape: 1; material: 1;
                            width-value: 0.48; depth-value: 0.56; height-value: 0.28;
                            decay-value: 0.60; capture-x: 0.72; capture-y: 0.66;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width * 3 + DeviceRackMetrics.half-gap * 2;
                        height: DeviceRackMetrics.face-height;
                        ModulationDeviceFace {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            slot-index: 10; slot-count: 12;
                            mode: 2; rate: 0.45; depth: 0.58; character: 0.52;
                            feedback: 0.64; spread: 0.72; tone: 0.76; stages: 0.5;
                        }
                    }
                    DeviceFrame {
                        width: DeviceRackMetrics.unit-width;
                        height: DeviceRackMetrics.face-height;
                        PlateDeviceFace {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            slot-index: 11; slot-count: 12;
                            size: 0.5; decay: 0.5886; damping: 0.4; width-value: 1.0;
                        }
                    }
                    DeviceAddSlot { }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SectionLabel { text: "ZOOM SCROLLBAR"; }
                HorizontalBox {
                    spacing: 24px;
                    alignment: start;
                    VerticalBox {
                        width: 320px;
                        spacing: 10px;
                        ZoomScrollBar {
                            width: 320px;
                            offset <=> root.zoom-offset;
                            visible-fraction <=> root.zoom-visible;
                            scrolled(v) => { root.zoom-offset = v; }
                            zoomed(o, f) => { root.zoom-offset = o; root.zoom-visible = f; }
                        }
                        Text {
                            text: "offset " + round(root.zoom-offset * 100) + "%  visible "
                                + round(root.zoom-visible * 100) + "%";
                            color: Theme.text-muted;
                            font-size: 10px;
                        }
                        ZoomScrollBar {
                            width: 320px;
                            enabled: false;
                            offset: 0.4;
                            visible-fraction: 0.15;
                        }
                    }
                    HorizontalBox {
                        spacing: 10px;
                        alignment: start;
                        ZoomScrollBar {
                            vertical: true;
                            height: 140px;
                            offset <=> root.zoom-offset-v;
                            visible-fraction <=> root.zoom-visible-v;
                            scrolled(v) => { root.zoom-offset-v = v; }
                            zoomed(o, f) => { root.zoom-offset-v = o; root.zoom-visible-v = f; }
                        }
                        Text {
                            text: "V\n" + round(root.zoom-offset-v * 100) + "%\n"
                                + round(root.zoom-visible-v * 100) + "%";
                            color: Theme.text-muted;
                            font-size: 10px;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                SectionLabel { text: "CURSOR TOOLS AND STEPPERS"; }
                HorizontalBox {
                    spacing: 3px;
                    alignment: start;
                    ToolModeButton {
                        icon: ToolIcons.select; name: "Select";
                        hint: "Click toggles a step. Ctrl-drag sets velocity.";
                        active: root.gallery-tool == 0;
                        clicked => { root.gallery-tool = 0; }
                    }
                    ToolModeButton {
                        icon: ToolIcons.paint; name: "Paint";
                        hint: "Drag to fill steps. Right-drag to clear.";
                        active: root.gallery-tool == 1;
                        clicked => { root.gallery-tool = 1; }
                    }
                    ToolModeButton {
                        icon: ToolIcons.slice; name: "Slice";
                        hint: "Click a step to ratchet it into even hits.";
                        active: root.gallery-tool == 2;
                        clicked => { root.gallery-tool = 2; }
                    }
                    ToolModeButton {
                        icon: ToolIcons.stretch; name: "Stretch";
                        hint: "Drag a step sideways to set its length.";
                        active: root.gallery-tool == 3;
                        clicked => { root.gallery-tool = 3; }
                    }
                    ToolbarRule {}
                    StepperField {
                        label: "STEPS";
                        value <=> root.gallery-steps;
                        minimum: 1; maximum: 256;
                        tooltip: "Pattern length in 16th-note steps";
                    }
                    MenuField {
                        label: "SNAP";
                        options: ["1 bar", "1/4", "1/8", "1/16", "1/32", "1/64"];
                        selected-index <=> root.gallery-snap;
                        field-width: 46px;
                        menu-width: 120px;
                        tooltip: "Grid resolution for editing";
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }

    PreferencesDialog {
        width: parent.width;
        height: parent.height;
        open <=> root.gallery-dialog-open;
        appearance-preset <=> root.gallery-preset;
        appearance-accent <=> root.gallery-accent;
        developer-mode <=> root.gallery-developer-mode;
        smooth-curves <=> root.gallery-smooth-curves;
        appearance-preview(preset, accent) => { root.use-preset(preset); }
        save(preset, accent, developer-mode, smooth-curves) => {
            DisplayPrefs.smooth-curves = smooth-curves;
            root.use-preset(preset);
            true
        }
    }
}
