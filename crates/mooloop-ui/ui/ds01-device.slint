                        edited(p, v) => { root.value-changed(p, v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    Ds01Knob {
                        label: "RELEASE"; param: 75;
                        fill: #a78bfa;
                        values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                        step-counts: root.step-counts; bipolars: root.bipolars;
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        edited(p, v) => { root.value-changed(p, v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    Ds01Chip {
                        label: "GATE"; param: 76;
                        values: root.values; value-texts: root.value-texts; step-counts: root.step-counts;
                        changed(p, v) => { root.value-changed(p, v); }
                    }
                }
            }
        }

        // ---- DS-01 MOD ---------------------------------------------------
        // The modulation the channel rack cannot provide: a channel source
        // produces one number per control tick for the whole channel, and a
        // drum channel can have eight hits ringing at once, each with its own
        // velocity, its own position in a burst and its own envelopes.
        if root.page == 5 : Module {
            vertical-stretch: 1;
            title: "DS-01 MOD";
            caption: "PER HIT, INSIDE THE VOICE";
            HorizontalLayout {
                height: 11px;
                spacing: 5px;
                Rectangle { width: 12px; }
                SectionLabel { text: "SOURCE"; width: 104px; }
                Rectangle { width: 10px; }
                SectionLabel { text: "DESTINATION"; horizontal-stretch: 1; }
                SectionLabel { text: "AMOUNT"; width: 67px; }
                SectionLabel { text: "CURVE"; width: 63px; }
            }
            VerticalLayout {
                spacing: 1px;
                for row in 8 : MatrixRow {
                    index: row;
                    values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                    step-counts: root.step-counts; bipolars: root.bipolars;
                    source-names: root.matrix-source-names;
                    dest-names: root.matrix-dest-names;
                    modulation-armed: root.modulation-armed;
                    depths: root.modulation-depths; allowed: root.modulation-allowed;
                    offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                    changed(p, v) => { root.value-changed(p, v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
            }
        }
    }
}
