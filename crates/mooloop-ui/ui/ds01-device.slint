                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellKnob {
                            label: "LEVEL"; param: 1; fill: Theme.warning;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                    }
                }
                VRule {}
                // The matrix's eight rows of four go here. The three
                // checked-in concepts settled the columns and the bands and
                // did not draw this panel, so the layout for thirty-two more
                // controls is an open question rather than one to answer in
                // passing -- `00-status.md` records it.
                Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "MOD  \u{2014}  eight rows, layout undecided";
                        color: Theme.text-faint;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Where the body's ring reaches the end of the scope's span, as a
    // fraction. Rust supplies it beside the contours for the same reason: the
    // conversion from seconds needs the parameter table.
    in property <float> body-decay-fraction: 0.5;
}
