                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellKnob {
                            label: "M.SUS"; param: 74; fill: #a78bfa;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellKnob {
                            label: "M.REL"; param: 75; fill: #a78bfa;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellChip {
                            label: "M.GATE"; param: 76;
                            values: root.values; value-texts: root.value-texts; step-counts: root.step-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                        }
                    }
                    Scope {
                        vertical-stretch: 1;
                        Contour {
                            x: 1px; y: 1px;
                            width: parent.width - 2px; height: parent.height - 2px;
                            shape: root.contours[0]; tint: Theme.accent; filled: true;
                        }
                        Contour {
                            x: 1px; y: 1px;
                            width: parent.width - 2px; height: parent.height - 2px;
                            shape: root.contours[3]; tint: #a78bfa; filled: false;
                        }
                        // Over the envelope's fill rather than under it: the
                        // fill is opaque, for the seam reasons the contour
                        // documents, so a trace beneath it would be a trace
                        // nobody sees. Above it the hit reads inside the
                        // shape that made it, which is the relationship the
                        // column is for.
                        HitTrace {
                            x: 1px; y: 1px;
                            width: parent.width - 2px; height: parent.height - 2px;
                            minimums: root.preview-minimums;
                            maximums: root.preview-maximums;
                        }
                        ScopeHandle {
                            span-width: parent.width; span-height: parent.height;
                            param: 40; at-x: 0.0; at-y: 1.0; tint: Theme.accent;
                            dragged(p, f) => { root.handle-dragged(p, f); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                        }
                        ScopeHandle {
                            span-width: parent.width; span-height: parent.height;
                            param: 41; at-x: root.contours[0].attack; at-y: 0.0; tint: Theme.accent;
                            dragged(p, f) => { root.handle-dragged(p, f); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                        }
                        ScopeHandle {
                            span-width: parent.width; span-height: parent.height;
                            param: 42; at-x: root.contours[0].attack + root.contours[0].hold + root.contours[0].decay; at-y: 1.0; tint: Theme.accent;
                            dragged(p, f) => { root.handle-dragged(p, f); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                        }
                        ScopeHandle {
                            span-width: parent.width; span-height: parent.height;
                            param: 70; at-x: 0.0; at-y: 1.0; tint: #a78bfa;
                            dragged(p, f) => { root.handle-dragged(p, f); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                        }
                        ScopeHandle {
                            span-width: parent.width; span-height: parent.height;
                            param: 71; at-x: root.contours[3].attack; at-y: 0.0; tint: #a78bfa;
                            dragged(p, f) => { root.handle-dragged(p, f); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                        }
                        ScopeHandle {
                            span-width: parent.width; span-height: parent.height;
                            param: 72; at-x: root.contours[3].attack + root.contours[3].hold + root.contours[3].decay; at-y: 1.0; tint: #a78bfa;
                            dragged(p, f) => { root.handle-dragged(p, f); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                        }
                    }
                }
            }
        }
        Rule {}

        // The shaper and the burst come after the voice, so they sit in a
        // band underneath the columns that make it.
        Rectangle {
            height: 56px;
            background: Theme.surface;
            HorizontalLayout {
                spacing: 0px;
                Column {
                    title: "BURST";
                    pad: 3px;
                    ticks: root.burst-ticks;
                    horizontal-stretch: 5;
                    CellRow {
                        CellChip {
                            label: "REPEAT"; param: 80;
                            values: root.values; value-texts: root.value-texts; step-counts: root.step-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                        }
                        CellKnob {
                            label: "SPACING"; param: 81; fill: Theme.accent;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellKnob {
                            label: "SPREAD"; param: 82; fill: Theme.accent;
                            bipolar: true;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellKnob {
                            label: "LVL ST"; param: 83; fill: Theme.accent;
                            bipolar: true;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellKnob {
                            label: "PCH ST"; param: 84; fill: Theme.accent;
                            bipolar: true;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                    }
                }
                VRule {}
                Column {
                    title: "SHAPE";
                    tint: Theme.warning;
                    pad: 3px;
                    horizontal-stretch: 6;
                    CellRow {
                        CellKnob {
                            label: "DRIVE"; param: 90; fill: Theme.warning;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellChip {
                            label: "CHAR"; param: 91;
                            values: root.values; value-texts: root.value-texts; step-counts: root.step-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                        }
                        CellKnob {
                            label: "BIAS"; param: 92; fill: Theme.warning;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellChip {
                            label: "BITS"; param: 93;
                            values: root.values; value-texts: root.value-texts; step-counts: root.step-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                        }
                        CellKnob {
                            label: "OUT HP"; param: 94; fill: Theme.warning;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
