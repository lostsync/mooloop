// The DS-01's face.
//
// A drum sound is one event unfolding over a few hundred milliseconds, so
// every control is either a description of a moment in that event or of a
// layer's contribution to it. The face spends **pages** on that: one page per
// layer, one for the whole voice, one for the two envelopes that shape the
// output, and one for the per-hit matrix.
//
// ## Why pages, and why the scopes are not the editor
//
// `08-the-face.md` fitted ninety-two controls on one screen by making the
// scopes the envelope editor — every envelope time a handle dragged on a
// curve rather than a knob — and paid for the rest with a 21px dial and an
// 8px caption at five rack units. That is the same trade ML-P8's first face
// made and Adam rejected: on a 14" laptop a dial that size is a smudge.
//
// So the scopes are displays again and every parameter has a control of its
// own, at the 34px `KnobStack` the rest of the program uses. What used to buy
// the fit is now bought by pages, exactly as `docs/plans/poly-synth-v2/
// mockups/README.md` argues: a page is a few large controls inside modules
// that share one chrome, never a grid of small ones.
//
// ## Why this face is indexed by parameter id
//
// Every other device face here declares one property per parameter. DS-01 has
// ninety-two, and one property each would be a second copy of the parameter
// table written out by hand — which is the thing the device exists not to
// have. Instead the face takes arrays indexed by descriptor id and reports
// edits as `(id, normalized)`, the same shape the modulation depths already
// use. Rust owns the ranges, the curves, the polarity and the formatting; the
// face owns the layout and nothing else.
//
// Values cross as *normalized* `0..1` rather than in natural units, because
// that is the space a route and an automation lane both work in, and it is
// the one space where a knob's travel means the same thing on a linear
// parameter and an exponential one.

import { Theme } from "theme.slint";
import { KnobStack, MiniKnob, PickerChip, SectionLabel } from "controls.slint";
import { DevicePageButton } from "device-rack.slint";

// One contour, as the face needs to draw it: every time is already a
// fraction of the scope's span, because converting seconds into a fraction
// needs the parameter table and the face does not have one.
export struct Ds01Contour {
    attack: float,
    hold: float,
    decay: float,
    // -1 logarithmic, 0 exponential, +1 linear, matching the parameter.
    curve: float,
    sustain: float,
    // How tall this contour is drawn, `0..1`. The pitch envelope's depth is
    // the only one that is not 1.
    height: float,
    // Whether this contour has anything to draw at all.
    active: bool,
}

// One knob on this face: 34px, stacked, typed into, and addressed by id.
//
// A page is then a list of parameter ids rather than ten lines of modulation
// plumbing repeated per knob, and the id is the whole address — every array
// here is indexed by descriptor id, so a knob that knows its id knows its
// value, its default, its text, its step, its polarity and its routes.
component Ds01Knob inherits KnobStack {
    in property <int> param;
    in property <[float]> values;
    in property <[float]> defaults;
    in property <[string]> value-texts;
    // `0` for a continuous parameter, the position count for a stepped one.
    in property <[int]> step-counts;
    in property <[bool]> bipolars;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback edited(int, float);
    callback committed(int, string);
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);

    // The travel is the normalized range, whatever the parameter's own units
    // and curve are. A stepped parameter's positions are evenly spaced in
    // that space, so its step is one over the gaps between them.
    minimum: 0;
    maximum: 1;
    // The model row is the value, and stays the value: `controlled` stops the
    // knob writing its own property, so the binding below survives a drag.
    // Without it the first drag drops the binding and this control never
    // follows the patch again — see `ParameterKnob.controlled`. Rust closes
    // the loop by writing the row back inside `value-changed`.
    controlled: true;
    value: root.values[root.param];
    modulation-depth: root.depths[root.param];
    default-value: root.defaults[root.param];
    display-text: root.value-texts[root.param];
    bipolar: root.bipolars[root.param];
    step: root.step-counts[root.param] > 1
        ? 1.0 / (root.step-counts[root.param] - 1)
        : 0;
    modulation-allowed: root.allowed[root.param];
    modulation-offset: root.offsets[root.param];
    modulation-route-count: root.route-counts[root.param];
    changed(v) => { root.edited(root.param, v); }
    text-committed(t) => { root.committed(root.param, t); }
    modulation-depth-changed(v) => { root.route-depth-changed(root.param, v); }
    modulation-edit-started => { root.route-edit-started(root.param); }
    modulation-edit-finished => { root.route-edit-finished(root.param); }
}

// A small dial for a row that has no room for a stack: the matrix's amount
// and curve. Same addressing, and controlled for the same reason.
component Ds01Dial inherits MiniKnob {
    in property <int> param;
    in property <[float]> values;
    in property <[float]> defaults;
    in property <[string]> value-texts;
    in property <[bool]> bipolars;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback edited(int, float);
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);

    controlled: true;
    value: root.values[root.param];
    modulation-depth: root.depths[root.param];
    default-value: root.defaults[root.param];
    value-text: root.value-texts[root.param];
    bipolar: root.bipolars[root.param];
    modulation-allowed: root.allowed[root.param];
    modulation-offset: root.offsets[root.param];
    modulation-route-count: root.route-counts[root.param];
    changed(v) => { root.edited(root.param, v); }
    modulation-depth-changed(v) => { root.route-depth-changed(root.param, v); }
    modulation-edit-started() => { root.route-edit-started(root.param); }
    modulation-edit-finished() => { root.route-edit-finished(root.param); }
}

// A stepped control shown as its current label and cycled by clicking.
//
// A chip rather than a knob because these are *choices* — Poly or Mono, one
// of four noise generators, one of four drive characters, gated or one-shot —
// and the value a musician needs to read off one is its name. Nothing that
// reads as a number is drawn this way: a count is a knob with a step, so
// Tune, Partials, Repeats and Bits keep their travel.
//
// Cycling rather than opening a list: none of them has more than four
// positions. The matrix's two do, and they use `PickerChip`.
component Ds01Chip inherits Rectangle {
    in property <string> label;
    in property <int> param;
    in property <[float]> values;
    in property <[string]> value-texts;
    in property <[int]> step-counts;
    callback changed(int, float);

    private property <int> steps: max(2, root.step-counts[root.param]);

    // The same height and caption line as `Ds01Knob`, so a chip in a knob row
    // sits on the row rather than beside it.
    width: 50px;
    height: 69px;
    VerticalLayout {
        spacing: 2px;
        Text {
            height: 11px;
            text: root.label;
            color: Theme.text-muted;
            font-size: 9px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            height: 54px;
            background: touch.has-hover ? Theme.surface-active : Theme.surface-raised;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            accessible-role: button;
            accessible-label: root.label;
            accessible-value: root.value-texts[root.param];
            Text {
                width: 100%;
                height: 100%;
                text: root.value-texts[root.param];
                color: Theme.text;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    // Cycle in normalized space, which is where a stepped
                    // descriptor's positions are evenly spaced.
                    let position = round(root.values[root.param] * (root.steps - 1));
                    let next = mod(position + 1, root.steps);
                    root.changed(root.param, next / (root.steps - 1));
                }
            }
        }
    }
}

// A row of controls under a module's display. Centred, because a row of four
// under a display that is wider than it reads as a caption rather than as a
// column of leftovers.
component KnobRow inherits HorizontalLayout {
    spacing: 6px;
    alignment: center;
    @children
}

// Where a burst's impulses fall, on a short axis beside the controls that set
// them, so spacing and spread are seen rather than inferred from two numbers.
// At Repeats 1 there is one tick, which is honest rather than empty.
component BurstTicks inherits Rectangle {
    in property <[float]> at;
    height: 9px;
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
    for position in root.at : Rectangle {
        x: clamp(parent.width * position, 0px, parent.width - 2px);
        width: 2px;
        height: 100%;
        background: Theme.accent;
    }
}

// A bounded group. Every module on every page has the same padding, the same
// title row and the same corner, so nothing on this face is aligned by eye.
component Module inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    in property <color> tint: Theme.accent;
    // Impulse positions, when this module has a schedule to show. Drawn in
    // the title row rather than over the controls: it is an axis, not a
    // scope, and the burst has no vertical extent to draw.
    in property <[float]> ticks;
    background: Theme.panel;
    border-radius: Theme.radius-sm;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        HorizontalLayout {
            height: 12px;
            spacing: 6px;
            Rectangle {
                width: 3px;
                height: 10px;
                y: 1px;
                background: root.tint;
                border-radius: Theme.radius-xs;
            }
            SectionLabel { text: root.title; vertical-alignment: center; }
            if root.ticks.length > 0 : BurstTicks {
                at: root.ticks;
                width: 108px;
                y: 2px;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.caption;
                color: Theme.text-faint;
                font-size: 9px;
                vertical-alignment: center;
            }
        }
        @children
    }
}

// One layer's contour over the scope's span.
component Contour inherits Rectangle {
    in property <Ds01Contour> shape;
    in property <color> tint: Theme.accent;
    in property <bool> filled: true;
    // A contour drawn for context rather than for editing — the amplitude
    // envelope behind the pitch one — goes quiet, so the page's own contour
    // is the one being read. Dimmed by mixing further toward the panel rather
    // than by alpha: the fill has to stay opaque, for the seam reasons below.
    in property <bool> dim;
    private property <int> steps: 160;
    private property <color> fill-tint:
        Theme.panel.mix(root.tint, root.dim ? 0.9 : 0.78);
    private property <color> line-tint:
        root.dim ? Theme.panel.mix(root.tint, 0.45) : root.tint;

    // `env::shape`, not an approximation of it. A power curve was standing in
    // for it and had the two ends the wrong way round: it drew the *fastest*
    // decay at curve -1, where the envelope produces the slowest. A display
    // that contradicts what is heard is worse than no display, and the real
    // function is three lines.
    pure function shaped(u: float) -> float {
        if (u <= 0) { return 0; }
        if (u >= 1) { return 1; }
        // `(e^(A*u) - 1) / (e^A - 1)` with `A = DECAY_TAIL_CONSTANTS`: the
        // exponential law, which is where curve 0 sits.
        let exponential = (pow(2.718281828, 9.21034 * u) - 1) / 9999.0;
        if (root.shape.curve >= 0) {
            // Toward linear.
            return exponential + (u - exponential) * root.shape.curve;
        }
        // Toward logarithmic: the exponential reflected through the diagonal,
        // a tail that stays audible for most of its length and then stops.
        let logarithmic = 1 - (pow(2.718281828, 9.21034 * (1 - u)) - 1) / 9999.0;
        return exponential + (logarithmic - exponential) * -root.shape.curve;
    }

    pure function level-at(x: float) -> float {
        if (x < root.shape.attack) {
            return root.shaped(x / max(0.0001, root.shape.attack));
        }
        if (x < root.shape.attack + root.shape.hold) { return 1.0; }
        let t = (x - root.shape.attack - root.shape.hold) / max(0.0001, root.shape.decay);
        if (t >= 1) { return root.shape.sustain; }
        return root.shape.sustain + (1 - root.shape.sustain) * root.shaped(1 - t);
    }

    for index in root.shape.active ? root.steps : 0 : Rectangle {
        property <float> here: root.shape.height * root.level-at(index / (root.steps - 1));
        property <float> prev: root.shape.height * root.level-at(max(0, index - 1) / (root.steps - 1));
        x: index * parent.width / root.steps;
        // Overlapped by half a pixel: exactly abutting steps leave sub-pixel
        // gaps and read as hatching. The fill is opaque for the mirror-image
        // reason -- a translucent overlap double-blends and reads as stripes.
        width: max(1px, parent.width / root.steps + 0.5px);
        y: parent.height * (1 - max(self.here, self.prev));
        height: root.filled
            ? parent.height * max(self.here, self.prev)
            : max(1px, parent.height * (abs(self.here - self.prev) + 0.012));
        background: root.filled ? root.fill-tint : root.line-tint;
    }
    if root.filled && root.shape.active : Rectangle {
        for index in root.steps : Rectangle {
            property <float> here: root.shape.height * root.level-at(index / (root.steps - 1));
            property <float> prev: root.shape.height * root.level-at(max(0, index - 1) / (root.steps - 1));
            x: index * parent.width / root.steps;
            width: max(1px, parent.width / root.steps + 0.5px);
            y: parent.height * (1 - max(self.here, self.prev));
            height: max(1px, parent.height * (abs(self.here - self.prev) + 0.01));
            background: root.tint;
        }
    }
}

// The rendered hit, from the production voice path. v1's best property, and
// the reason it sits on the AMP page: it is the device's output, and the
// output is what the amplitude envelope shapes.
//
// Drawn as min/max bins rather than a resampled line, so a transient shorter
// than a pixel still occupies that pixel instead of falling between two.
component HitTrace inherits Rectangle {
    in property <[float]> minimums;
    in property <[float]> maximums;
    private property <int> bins: min(root.minimums.length, root.maximums.length);

    for index in root.bins : Rectangle {
        x: index * parent.width / root.bins;
        width: max(1px, parent.width / root.bins + 0.5px);
        y: parent.height / 2 - parent.height * 0.46 * root.maximums[index];
        height: max(1px, parent.height * 0.46
            * (root.maximums[index] - root.minimums[index]));
        background: Theme.text.with-alpha(0.5);
    }
    Rectangle {
        y: parent.height / 2;
        width: 100%;
        height: 1px;
        background: Theme.border.with-alpha(0.5);
    }
}

// The box a contour is drawn in. Faint verticals at the same fractions on
// every page key the scopes to one another without pretending they are one
// continuous axis: they are four drawings of the same span, which the page
// bar states once.
component Scope inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    for line in [0.25, 0.5, 0.75] : Rectangle {
        x: parent.width * line;
        width: 1px;
        height: 100%;
        background: Theme.border.with-alpha(0.45);
    }
    @children
}

// One row of the per-hit matrix: what it reads, what it moves, how far, and
// with what shaping.
//
// A row is never removed, only switched off, so the eight rows are eight rows
// for the life of the patch and a route keeps its place. Source and
// Destination are pickers rather than cycling chips because nine and
// forty-seven are past what clicking through can carry.
component MatrixRow inherits Rectangle {
    in property <int> index;
    in property <[float]> values;
    in property <[float]> defaults;
    in property <[string]> value-texts;
    in property <[int]> step-counts;
    in property <[bool]> bipolars;
    in property <[string]> source-names;
    in property <[string]> dest-names;
    in property <bool> modulation-armed;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback changed(int, float);
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);

    // The matrix's eight rows of four, 100-131.
    private property <int> base: 100 + root.index * 4;
    private property <int> source-steps: max(2, root.step-counts[root.base]);
    private property <int> dest-steps: max(2, root.step-counts[root.base + 1]);
    // Source 0 is None, which is what an unused row rests on.
    private property <bool> live: round(root.values[root.base] * (root.source-steps - 1)) > 0;

    height: 18px;
    HorizontalLayout {
        spacing: 5px;
        Text {
            width: 12px;
            text: root.index + 1;
            color: Theme.text-faint;
            font-size: 9px;
            vertical-alignment: center;
        }
        PickerChip {
            width: 104px;
            options: root.source-names;
            selected-index: round(root.values[root.base] * (root.source-steps - 1));
            tooltip: "What this row reads";
            text-color: root.live ? Theme.accent : Theme.text-faint;
            picked(i) => { root.changed(root.base, i / (root.source-steps - 1)); }
        }
        Text {
            width: 10px;
            text: "\u{2192}";
            color: Theme.text-faint;
            font-size: 9px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        PickerChip {
            horizontal-stretch: 1;
            options: root.dest-names;
            selected-index: round(root.values[root.base + 1] * (root.dest-steps - 1));
            tooltip: "What this row moves";
            text-color: root.live ? Theme.text : Theme.text-faint;
            picked(i) => { root.changed(root.base + 1, i / (root.dest-steps - 1)); }
        }
        Ds01Dial {
            diameter: 16px;
            param: root.base + 2;
            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
            bipolars: root.bipolars;
            label: "Amount";
            modulation-armed: root.modulation-armed;
            depths: root.depths; allowed: root.allowed;
            offsets: root.offsets; route-counts: root.route-counts;
            edited(p, v) => { root.changed(p, v); }
            route-depth-changed(p, v) => { root.route-depth-changed(p, v); }
            route-edit-started(p) => { root.route-edit-started(p); }
            route-edit-finished(p) => { root.route-edit-finished(p); }
        }
        Text {
            width: 46px;
            text: root.value-texts[root.base + 2];
            color: root.live ? Theme.text : Theme.text-faint;
            font-size: 9px;
            font-family: "monospace";
            vertical-alignment: center;
        }
        Ds01Dial {
            diameter: 16px;
            param: root.base + 3;
            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
            bipolars: root.bipolars;
            label: "Curve";
            modulation-armed: root.modulation-armed;
            depths: root.depths; allowed: root.allowed;
            offsets: root.offsets; route-counts: root.route-counts;
            edited(p, v) => { root.changed(p, v); }
            route-depth-changed(p, v) => { root.route-depth-changed(p, v); }
            route-edit-started(p) => { root.route-edit-started(p); }
            route-edit-finished(p) => { root.route-edit-finished(p); }
        }
        Text {
            width: 42px;
            text: root.value-texts[root.base + 3];
            color: root.live ? Theme.text : Theme.text-faint;
            font-size: 9px;
            font-family: "monospace";
            vertical-alignment: center;
        }
    }
}

export component Ds01DeviceFace inherits Rectangle {
    // Indexed by descriptor id, in `mooloop_core::ds01`'s own namespace.
    in property <[float]> values;
    in property <[float]> defaults;
    in property <[string]> value-texts;
    // `0` for a continuous parameter, the position count for a stepped one.
    in property <[int]> step-counts;
    // Whether a parameter swings both ways about zero, which decides where a
    // dial fills from. Supplied rather than written out per knob: it is
    // `descriptor.min < 0` and the face does not get a second copy of that.
    in property <[bool]> bipolars;
    in property <bool> modulation-armed;
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    // The span every scope is drawn over, as the page bar states it.
    in property <string> span-text;
    // VOICE, TONE, NOISE, BODY, AMP, DS-01 MOD.
    in-out property <int> page;
    /// `Ds01ModSource::ALL` and the destination list, labelled by Rust so the
    /// face holds no second copy of either.
    in property <[string]> matrix-source-names;
    in property <[string]> matrix-dest-names;
    // The four contours, in a fixed order Rust fills: amp, pitch, noise, mod.
    in property <[Ds01Contour]> contours;
    // The rendered hit, in min/max bins over the same span.
    in property <[float]> preview-minimums;
    in property <[float]> preview-maximums;
    // Impulse positions, as fractions of the burst's own length.
    in property <[float]> burst-ticks;
    // Where the body's ring reaches the end of the scope's span, as a
    // fraction. Rust supplies it beside the contours for the same reason: the
    // conversion from seconds needs the parameter table.
    in property <float> body-decay-fraction: 0.5;

    callback value-changed(int, float);
    callback text-committed(int, string);
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);

    background: Theme.surface;

    VerticalLayout {
        padding: 6px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 3px;
            DevicePageButton { text: "VOICE"; active: root.page == 0; clicked => { root.page = 0; } }
            DevicePageButton { text: "TONE"; active: root.page == 1; clicked => { root.page = 1; } }
            DevicePageButton { text: "NOISE"; active: root.page == 2; clicked => { root.page = 2; } }
            DevicePageButton { text: "BODY"; active: root.page == 3; clicked => { root.page = 3; } }
            DevicePageButton { text: "AMP"; active: root.page == 4; clicked => { root.page = 4; } }
            // Not plain MOD. The common device frame's MOD opens the *channel*
            // shelf, and a per-hit matrix row being mistaken for a channel
            // route is exactly the confusion this name prevents.
            DevicePageButton { text: "DS-01 MOD"; active: root.page == 5; clicked => { root.page = 5; } }
            Rectangle { horizontal-stretch: 1; }
            // Stated once for the whole face rather than once per scope: the
            // pages are four drawings of the same span, and a span that moved
            // per page would make a shorter contour look like a different
            // scale instead of a shorter contour.
            Text {
                text: root.span-text;
                color: Theme.text-faint;
                font-size: 9px;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- VOICE -------------------------------------------------------
        // Everything that belongs to the hit as a whole rather than to a
        // layer: which drum this is, how it is chased off, how many impulses
        // it fires, and what colour the shaper gives the sum.
        if root.page == 0 : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            Module {
                horizontal-stretch: 1;
                title: "VOICE";
                KnobRow {
                    Ds01Knob {
                        label: "TUNE"; param: 0;
                        values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                        step-counts: root.step-counts; bipolars: root.bipolars;
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        edited(p, v) => { root.value-changed(p, v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
