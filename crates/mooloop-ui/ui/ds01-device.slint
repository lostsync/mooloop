// The DS-01's face.
//
// A drum sound is one event unfolding over a few hundred milliseconds, so
// every control is either a description of a moment in that event or of a
// layer's contribution to it. The face is that: three source layers as
// parallel columns because they are parallel in the signal path, their sum as
// the fourth column, and each layer's scope directly underneath the controls
// that make it. `docs/plans/drum-synth-v2/08-the-face.md` has the argument,
// and `mockups/` has the two layouts this one beat.
//
// ## Why this face is indexed by parameter id
//
// Every other device face here declares one property per parameter. DS-01 has
// ninety-two, and one property each would be a second copy of the parameter
// table written out by hand — which is the thing the device exists not to
// have. Instead the face takes arrays indexed by descriptor id and reports
// edits as `(id, normalized)`, the same shape the modulation depths already
// use. Rust owns the ranges, the curves and the formatting; the face owns the
// layout and nothing else.
//
// Values cross as *normalized* `0..1` rather than in natural units, because
// that is the space a route and an automation lane both work in, and it is
// the one space where a knob's travel means the same thing on a linear
// parameter and an exponential one.

import { Theme } from "theme.slint";
import { MiniKnob, SectionLabel } from "controls.slint";

// A knob with its name under it. `MiniKnob` draws only the dial, so a dense
// row places its own captions.
component CellKnob inherits Rectangle {
    in property <string> label;
    in property <int> param;
    in property <[float]> values;
    in property <[float]> defaults;
    in property <[string]> value-texts;
    in property <bool> bipolar;
    in property <color> fill: Theme.accent;
    in property <bool> modulation-armed;
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    callback changed(int, float);
    callback edit-started(int);
    callback edit-finished(int);
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);

    height: 34px;
    MiniKnob {
        x: (parent.width - self.width) / 2;
        y: (min(parent.height, 24px) - self.height) / 2;
        diameter: 21px;
        label: root.label;
        value: root.values[root.param];
        default-value: root.defaults[root.param];
        value-text: root.value-texts[root.param];
        bipolar: root.bipolar;
        fill: root.fill;
        modulation-armed: root.modulation-armed;
        modulation-allowed: root.modulation-allowed[root.param];
        modulation-depth: root.modulation-depths[root.param];
        modulation-offset: root.modulation-offsets[root.param];
        modulation-route-count: root.modulation-route-counts[root.param];
        changed(v) => { root.changed(root.param, v); }
        edit-started() => { root.edit-started(root.param); }
        edit-finished() => { root.edit-finished(root.param); }
        modulation-depth-changed(v) => { root.modulation-depth-changed(root.param, v); }
        modulation-edit-started() => { root.modulation-edit-started(root.param); }
        modulation-edit-finished() => { root.modulation-edit-finished(root.param); }
    }
    Text {
        y: 24px;
        width: 100%;
        text: root.label;
        color: Theme.text-muted;
        font-size: 8px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// A stepped control, shown as its current label and cycled by clicking.
//
// A chip rather than a knob because a stepped parameter is a choice, and
// because the value a musician needs to read off it is its name. It cycles
// rather than opening a list: none of DS-01's stepped controls has more than
// a handful of positions, and the ones that do — Choke Group, Bits — read as
// numbers anyway.
component CellChip inherits Rectangle {
    in property <string> label;
    in property <int> param;
    in property <[float]> values;
    in property <[string]> value-texts;
    in property <[int]> step-counts;
    in property <color> text-color: Theme.text;
    callback changed(int, float);

    height: 34px;
    private property <int> steps: max(2, root.step-counts[root.param]);

    Rectangle {
        x: 4px;
        y: (min(parent.height, 21px) - self.height) / 2;
        width: parent.width - 8px;
        height: 17px;
        background: touch.has-hover ? Theme.surface-active : Theme.surface-raised;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border;
        Text {
            width: 100%;
            height: 100%;
            text: root.value-texts[root.param];
            color: root.text-color;
            font-size: 8px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                // Cycle in normalized space, which is where a stepped
                // descriptor's positions are evenly spaced.
                let position = round(root.values[root.param] * (root.steps - 1));
                let next = mod(position + 1, root.steps);
                root.changed(root.param, next / (root.steps - 1));
            }
        }
    }
    Text {
        y: 24px;
        width: 100%;
        text: root.label;
        color: Theme.text-muted;
        font-size: 8px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

component Rule inherits Rectangle { height: 1px; background: Theme.border; }
component VRule inherits Rectangle { width: 1px; background: Theme.border; }

component CellRow inherits Rectangle {
    height: 34px;
    HorizontalLayout { spacing: 0px; @children }
}

// One contour, as the face needs to draw it: every time is already a
// fraction of the scope's span, because converting seconds into a fraction
// needs the parameter table and the face does not have one.
export struct Ds01Contour {
    attack: float,
    hold: float,
    decay: float,
    // -1 logarithmic, 0 exponential, +1 linear, matching the parameter.
    curve: float,
    sustain: float,
    // How tall this contour is drawn, `0..1`. The pitch envelope's depth is
    // the only one that is not 1.
    height: float,
    // Whether this contour has anything to draw at all.
    active: bool,
}

// One layer's contour over the scope's span.
component Contour inherits Rectangle {
    in property <Ds01Contour> shape;
    in property <color> tint: Theme.accent;
    in property <bool> filled: true;
    private property <int> steps: 160;

    // `env::shape`, not an approximation of it. A power curve was standing in
    // for it and had the two ends the wrong way round: it drew the *fastest*
    // decay at curve -1, where the envelope produces the slowest. A display
    // that contradicts what is heard is worse than no display, and the real
    // function is three lines.
    pure function shaped(u: float) -> float {
        if (u <= 0) { return 0; }
        if (u >= 1) { return 1; }
        // `(e^(A*u) - 1) / (e^A - 1)` with `A = DECAY_TAIL_CONSTANTS`: the
        // exponential law, which is where curve 0 sits.
        let exponential = (pow(2.718281828, 9.21034 * u) - 1) / 9999.0;
        if (root.shape.curve >= 0) {
            // Toward linear.
            return exponential + (u - exponential) * root.shape.curve;
        }
        // Toward logarithmic: the exponential reflected through the diagonal,
        // a tail that stays audible for most of its length and then stops.
        let logarithmic = 1 - (pow(2.718281828, 9.21034 * (1 - u)) - 1) / 9999.0;
        return exponential + (logarithmic - exponential) * -root.shape.curve;
    }

    pure function level-at(x: float) -> float {
        if (x < root.shape.attack) {
            return root.shaped(x / max(0.0001, root.shape.attack));
        }
        if (x < root.shape.attack + root.shape.hold) { return 1.0; }
        let t = (x - root.shape.attack - root.shape.hold) / max(0.0001, root.shape.decay);
        if (t >= 1) { return root.shape.sustain; }
        return root.shape.sustain + (1 - root.shape.sustain) * root.shaped(1 - t);
    }

    for index in root.shape.active ? root.steps : 0 : Rectangle {
        property <float> here: root.shape.height * root.level-at(index / (root.steps - 1));
        property <float> prev: root.shape.height * root.level-at(max(0, index - 1) / (root.steps - 1));
        x: index * parent.width / root.steps;
        // Overlapped by half a pixel: exactly abutting steps leave sub-pixel
        // gaps and read as hatching. The fill is opaque for the mirror-image
        // reason -- a translucent overlap double-blends and reads as stripes.
        width: max(1px, parent.width / root.steps + 0.5px);
        y: parent.height * (1 - max(self.here, self.prev));
        height: root.filled
            ? parent.height * max(self.here, self.prev)
            : max(1px, parent.height * (abs(self.here - self.prev) + 0.012));
        background: root.filled ? Theme.panel.mix(root.tint, 0.78) : root.tint;
    }
    if root.filled && root.shape.active : Rectangle {
        for index in root.steps : Rectangle {
            property <float> here: root.shape.height * root.level-at(index / (root.steps - 1));
            property <float> prev: root.shape.height * root.level-at(max(0, index - 1) / (root.steps - 1));
            x: index * parent.width / root.steps;
            width: max(1px, parent.width / root.steps + 0.5px);
            y: parent.height * (1 - max(self.here, self.prev));
            height: max(1px, parent.height * (abs(self.here - self.prev) + 0.01));
            background: root.tint;
        }
    }
}

// The rendered hit, from the production voice path. v1's best property, and
// the reason it sits in the amp column rather than behind every column: it is
// the device's output, and the output is what the amp envelope shapes.
//
// Drawn as min/max bins rather than a resampled line, so a transient shorter
// than a pixel still occupies that pixel instead of falling between two.
component HitTrace inherits Rectangle {
    in property <[float]> minimums;
    in property <[float]> maximums;
    private property <int> bins: min(root.minimums.length, root.maximums.length);

    for index in root.bins : Rectangle {
        x: index * parent.width / root.bins;
        width: max(1px, parent.width / root.bins + 0.5px);
        y: parent.height / 2 - parent.height * 0.46 * root.maximums[index];
        height: max(1px, parent.height * 0.46
            * (root.maximums[index] - root.minimums[index]));
        background: Theme.text.with-alpha(0.5);
    }
    Rectangle {
        y: parent.height / 2;
        width: 100%;
        height: 1px;
        background: Theme.border.with-alpha(0.5);
    }
}

// A draggable envelope handle. Its presence is the claim that the scope is
// where that envelope is *edited* rather than where it is shown, which is
// what took the envelope times off the knob rows and what makes the device
// fit on one face.
component ScopeHandle inherits Rectangle {
    in property <int> param;
    // Where it sits, both as fractions of the scope.
    in property <float> at-x;
    in property <float> at-y;
    // The scope's own size. Passed in rather than read from `parent`, which a
    // component cannot reach from its own root's property bindings.
    in property <length> span-width;
    in property <length> span-height;
    in property <color> tint: Theme.accent;
    // Dragging left and right edits a time; dragging up and down edits a
    // depth. No handle does both.
    in property <bool> vertical;
    callback dragged(int, float);
    callback edit-started(int);
    callback edit-finished(int);

    width: 9px;
    height: 9px;
    x: clamp(root.span-width * root.at-x - 4px, 0px, root.span-width - 9px);
    y: clamp(root.span-height * root.at-y - 4px, 0px, root.span-height - 9px);
    border-radius: 4px;
    background: touch.has-hover || touch.pressed ? Theme.text : root.tint;
    border-width: 1px;
    border-color: Theme.background;

    touch := TouchArea {
        // Bigger than the dot, so a 9px target is not a 9px target.
        x: -4px;
        y: -4px;
        width: 17px;
        height: 17px;
        mouse-cursor: root.vertical ? MouseCursor.ns-resize : MouseCursor.ew-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) { root.edit-started(root.param); }
                if (event.kind == PointerEventKind.up) { root.edit-finished(root.param); }
            }
        }
        moved => {
            if (self.pressed) {
                if (root.vertical) {
                    root.dragged(root.param, clamp(
                        1 - (root.y + 4px + self.mouse-y - self.pressed-y) / root.span-height,
                        0, 1));
                } else {
                    root.dragged(root.param, clamp(
                        (root.x + 4px + self.mouse-x - self.pressed-x) / root.span-width,
                        0, 1));
                }
            }
        }
    }
}

// The box a column's contours are drawn in. Faint verticals at the same
// fractions in every column key the four scopes to one another without
// pretending they are one continuous axis: they are four drawings of the same
// span.
component Scope inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    for line in [0.25, 0.5, 0.75] : Rectangle {
        x: parent.width * line;
        width: 1px;
        height: 100%;
        background: Theme.border.with-alpha(0.45);
    }
    @children
}

// Where a burst's impulses fall, on a short axis beside the controls that set
// them, so spacing and spread are seen rather than inferred from two numbers.
// At Repeats 1 there is one tick, which is honest rather than empty.
component BurstTicks inherits Rectangle {
    in property <[float]> at;
    height: 9px;
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
    for position in root.at : Rectangle {
        x: clamp(parent.width * position, 0px, parent.width - 2px);
        width: 2px;
        height: 100%;
        background: Theme.accent;
    }
}

component Column inherits Rectangle {
    in property <string> title;
    in property <color> tint: Theme.accent;
    in property <length> pad: 6px;
    // Impulse positions, when this column has a schedule to show. Drawn in
    // the title row rather than under the controls: it is an axis, not a
    // scope, and the band has no vertical room to spare.
    in property <[float]> ticks;
    VerticalLayout {
        padding: root.pad;
        spacing: 3px;
        HorizontalLayout {
            spacing: 5px;
            height: 11px;
            Rectangle {
                width: 3px;
                height: 10px;
                background: root.tint;
                border-radius: Theme.radius-xs;
            }
            SectionLabel { text: root.title; }
            Rectangle { width: 8px; }
            if root.ticks.length > 0 : BurstTicks {
                at: root.ticks;
                width: 96px;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        @children
    }
}

export component Ds01DeviceFace inherits Rectangle {
    // Indexed by descriptor id, in `mooloop_core::ds01`'s own namespace.
    in property <[float]> values;
    in property <[float]> defaults;
    in property <[string]> value-texts;
    // `0` for a continuous parameter, the position count for a stepped one.
    in property <[int]> step-counts;
    in property <bool> modulation-armed;
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    // The span every scope is drawn over, as the header states it.
    in property <string> span-text;

    callback value-changed(int, float);
    callback edit-started(int);
    callback edit-finished(int);
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);

    background: Theme.surface;

    // The four contours, in a fixed order Rust fills: amp, pitch, noise, mod.
    in property <[Ds01Contour]> contours;
    // The rendered hit, in min/max bins over the same span.
    in property <[float]> preview-minimums;
    in property <[float]> preview-maximums;
    // Impulse positions, as fractions of the burst's own length.
    in property <[float]> burst-ticks;
    /// A handle moved: the parameter, and where it was dropped as a fraction
    /// of the scope. Rust turns that back into seconds through the span and
    /// the descriptor, because the conversion needs the parameter table.
    callback handle-dragged(int, float);

    VerticalLayout {
        spacing: 0px;

        // The globals, and the span every scope below is drawn over. The
        // captions sit beside the controls rather than under them: a header
        // row is read left to right, and the eight pixels it saves are eight
        // pixels of scope in every column below.
        Rectangle {
            height: 26px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 6px;
                Text {
                    text: "DS-01";
                    color: Theme.text;
                    font-size: 10px;
                    vertical-alignment: center;
                    width: 44px;
                }
                Text {
                    text: "TUNE";
                    color: Theme.text-muted;
                    font-size: 8px;
                    vertical-alignment: center;
                }
                CellChip {
                    width: 52px; height: 20px; param: 0; label: "";
                    values: root.values; value-texts: root.value-texts; step-counts: root.step-counts;
                    changed(p, v) => { root.value-changed(p, v); }
                }
                Text {
                    text: "CHOKE";
                    color: Theme.text-muted;
                    font-size: 8px;
                    vertical-alignment: center;
                }
                CellChip {
                    width: 34px; height: 20px; param: 2; label: "";
                    values: root.values; value-texts: root.value-texts; step-counts: root.step-counts;
                    changed(p, v) => { root.value-changed(p, v); }
                }
                CellKnob {
                    width: 24px; height: 20px; param: 3; label: "";
                    values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                    modulation-armed: root.modulation-armed;
                    modulation-depths: root.modulation-depths;
                    modulation-allowed: root.modulation-allowed;
                    modulation-offsets: root.modulation-offsets;
                    modulation-route-counts: root.modulation-route-counts;
                    changed(p, v) => { root.value-changed(p, v); }
                    edit-started(p) => { root.edit-started(p); }
                    edit-finished(p) => { root.edit-finished(p); }
                    modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    modulation-edit-started(p) => { root.modulation-edit-started(p); }
                    modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    text: "RETRIG";
                    color: Theme.text-muted;
                    font-size: 8px;
                    vertical-alignment: center;
                }
                CellChip {
                    width: 52px; height: 20px; param: 4; label: "";
                    values: root.values; value-texts: root.value-texts; step-counts: root.step-counts;
                    changed(p, v) => { root.value-changed(p, v); }
                }
                Text {
                    text: "VEL";
                    color: Theme.text-muted;
                    font-size: 8px;
                    vertical-alignment: center;
                }
                CellKnob {
                    width: 24px; height: 20px; param: 5; label: "";
                    values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                    modulation-armed: root.modulation-armed;
                    modulation-depths: root.modulation-depths;
                    modulation-allowed: root.modulation-allowed;
                    modulation-offsets: root.modulation-offsets;
                    modulation-route-counts: root.modulation-route-counts;
                    changed(p, v) => { root.value-changed(p, v); }
                    edit-started(p) => { root.edit-started(p); }
                    edit-finished(p) => { root.edit-finished(p); }
                    modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    modulation-edit-started(p) => { root.modulation-edit-started(p); }
                    modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.span-text;
                    color: Theme.text-faint;
                    font-size: 8px;
                    vertical-alignment: center;
                }
            }
        }
        Rule {}

        // Three sources side by side because they are parallel in the signal
        // path, their sum to the right of them. Each column is as wide as its
        // own controls need, which is why they are not equal: the noise layer
        // has ten cells and the body has six.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            HorizontalLayout {
                spacing: 0px;
                Column {
                    title: "TONE";
                    horizontal-stretch: 4;
                    CellRow {
                        CellKnob {
                            label: "LEVEL"; param: 10; fill: Theme.accent;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellKnob {
                            label: "PITCH"; param: 11; fill: Theme.accent;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellKnob {
                            label: "WAVE"; param: 12; fill: Theme.accent;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellChip {
                            label: "PART"; param: 13;
                            values: root.values; value-texts: root.value-texts; step-counts: root.step-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                        }
                    }
                    CellRow {
                        CellKnob {
                            label: "SPREAD"; param: 14; fill: Theme.accent;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
                            modulation-depths: root.modulation-depths;
                            modulation-allowed: root.modulation-allowed;
                            modulation-offsets: root.modulation-offsets;
                            modulation-route-counts: root.modulation-route-counts;
                            changed(p, v) => { root.value-changed(p, v); }
                            edit-started(p) => { root.edit-started(p); }
                            edit-finished(p) => { root.edit-finished(p); }
                            modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            modulation-edit-started(p) => { root.modulation-edit-started(p); }
                            modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        CellKnob {
                            label: "FM"; param: 15; fill: Theme.accent;
                            values: root.values; defaults: root.defaults; value-texts: root.value-texts;
                            modulation-armed: root.modulation-armed;
