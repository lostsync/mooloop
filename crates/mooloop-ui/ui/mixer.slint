import { Theme, Motion } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { ConsoleButton, MixerFader, MiniKnob, MuteButton, ParameterFader, PickerChip, SectionLabel, SoloButton, ToolButton } from "controls.slint";
import { GainMath } from "gain.slint";
import { ChannelMeter } from "meters.slint";
import { StripIcons, StripRow, StripSections } from "strip.slint";

// The mixer's own numbers, under a name, the way `DeviceRackMetrics` holds
// the rack's.
//
// Adam, 2026-09-10: *"white tie imperial makes it work at 92px. why dont we
// just adopt that size fully?"* The arithmetic is the argument: a strip was
// 62px with 4px padding, so 54px of content, and `MiniKnob` is 22px -- two
// knobs to a row, never three. At 92px there are 84px of content, three
// knobs and their gutters are 74px, and **an EQ band is one row**. It pays
// on the front as well: meter (22px) plus fader (30px) leaves room for the
// column the mockup stacks mute and polarity in, which is what does not fit
// at 62px and why today's strip put pan below the fader instead.
//
// The front face, the back face and `tests/mixer_snapshot.rs` all want this
// number, and a number spelled in four places that drift apart is the fault
// `AGENTS.md` opens on.
export global MixerMetrics {
    out property <length> strip-width: 92px;
    out property <length> strip-padding: 4px;
    out property <length> meter-width: 22px;
    out property <length> fader-width: 30px;
    /// The fader may be squeezed from the top -- Adam: *"there's room to
    /// squish the fader's top downward but it should have some kind of
    /// reasonable min height"* -- and this is the floor it stops at, which is
    /// what lets the turned-over face take the rest of the strip.
    /// The output section's floor, which is the column beside the fader: a
    /// pan knob and three 18px buttons with their gaps. The meter (79px at
    /// `meter-segments`) and the fader (100px of its own, overridden at the
    /// instance) both shrink to it, and it is the last of the three numbers
    /// that had to come down before the analog-sum switch fit the room a
    /// 200px dock leaves.
    out property <length> fader-floor: 82px;
    /// And the floor it stops at once the strip is turned over, where the
    /// fader is there to be *watched* rather than dragged: an EQ is set by
    /// ear against what it does to the level, which a short fader still
    /// shows. Without this the back face gets what is left of a 200px pane
    /// after a full-height fader, which is a page seen through a slot.
    out property <length> fader-turned-floor: root.column-height;
    /// The strip page's own height: the three sections stacked, which is
    /// taller than any mixer pane will be. It scrolls to this rather than
    /// squeezing its knobs, the way the sends area scrolls to its rows.
    ///
    /// Section by section: DRIVE is a header and a row, EQ is a header, a
    /// column of labels and four band rows, COMP is a header and three rows
    /// of captioned knobs. Stated rather than measured because the page
    /// lives inside the clipping card that makes the turn work, and a
    /// clipped child reports no preferred height at all.
    out property <length> strip-page-height: 340px;
    /// What a strip's fader face needs, top to bottom: its padding, the
    /// name plate, the output section, the destination and the analog sum.
    ///
    /// The output section's own floor is **the column beside the fader**
    /// rather than the fader, which is what this arithmetic is for: the pan
    /// knob and three buttons are what the face cannot give back.
    ///
    /// Finding that took four wrong answers, and the last one was the
    /// interesting one: `ToolButton` used to declare `min-height: 24px`,
    /// Slint takes the stricter of a component's constraint and its
    /// instance's, and so the column was 24px taller than it asked for. See
    /// that component's own comment.
    out property <length> strip-min-height:
        2 * root.strip-padding + 20px + 3px + root.column-height + 3px + root.front-height;
    /// Pan knob, three 18px buttons, and the gaps between them.
    out property <length> column-height: 22px + 3 * 18px + 3 * 2px;

    /// Room for a scroll bar, which Slint draws **over** the edge of a
    /// viewport rather than beside it. `SendRow` has the same allowance for
    /// the same reason, one level down.
    out property <length> scroll-bar: 12px;

    /// Segments in a strip's meter. Resolution only: `SegmentedMeter`
    /// draws them proportionally and declares a 60px minimum whatever the
    /// count, so this number has never had anything to do with the face's
    /// height -- which is worth writing down, because it was trimmed to 12
    /// on that theory before the column of buttons turned out to be the one
    /// holding the door.
    out property <int> meter-segments: 14;
    /// The front face's lower half: the destination picker, the feed count
    /// and the analog-sum switch, with the two gaps between them. Stated
    /// rather than left to `preferred-height`, because the faces are inside
    /// the clipping card that makes the turn work and a clipped child
    /// reports nothing useful.
    /// The destination and the analog sum, with the gap between them and
    /// nothing else -- an extra child adds an extra gap and puts the bottom
    /// of the switch outside the card's own clip.
    ///
    /// This and the fader's floor are what make the face fit the room the
    /// pane gives it, which is less than the dock's height in two ways: the
    /// row's padding, and the horizontal scroll bar a `ScrollView` reserves
    /// out of its visible height. The **feed count went** to make it fit --
    /// how many channels arrive is a fact you want while setting a track up
    /// rather than while mixing, and the track's rack face says it in words.
    out property <length> front-height: 22px + 3px + 18px;
}

// One send on a track's strip: where it goes, how loud, where it taps, and
// whether it is passing audio.
//
// `target` is a track index and `target-name` its name, carried together so
// the row can draw the name without indexing `bus-names` -- a send survives
// track edits by being renumbered in the model, and a row that looked its own
// name up would be the one place that renumbering could be seen to lag.
export struct MixerSendRow {
    target: int,
    target-name: string,
    level: float,
    pre-fader: bool,
    enabled: bool,
}

// One mixer bus as the pane and the Rust side exchange it. Levels arrive
// already in dB so the strip never has to know the meter's floor.
export struct MixerStripRow {
    name: string,
    muted: bool,
    volume: float,
    pan: float,
    // Destination bus index; 0 is the master.
    output: int,
    selected: bool,
    // The master is bus 0. It has no output of its own and cannot be routed.
    is-master: bool,
    // Whether this bus's own output is console-encoded. Never set on the
    // master, which feeds nothing.
    console: bool,
    // Whether this track's signal is inverted.
    polarity: bool,
    // Whether this track is soloed, and whether somebody else's solo is
    // silencing it. Two facts rather than one: a track that is not being
    // heard because of a solo elsewhere is not muted and should not look
    // muted, it is set up and waiting.
    solo: bool,
    solo-silenced: bool,
    // This track's channel strip: four sections, all out until something
    // switches them in. Drawn on the back face; the same struct the rack
    // face draws, so no parameter is reachable from only one of them.
    strip: StripRow,
    // The sends this track has, for the back face's SENDS page. The rack
    // face draws the same rows.
    sends: [MixerSendRow],
    // Which tracks this one may send to: the same mask the output picker
    // uses, because a send and an output are legal under the same rule.
    send-allowed: [bool],
    // Sequencer channels feeding this bus directly. Drawn so an empty bus is
    // distinguishable from a loaded one at a glance.
    feed-count: int,
    // Destinations this bus may be routed to, indexed by bus. False where the
    // connection would close a loop. Computed in Rust, which owns the graph.
    allowed: [bool],
    left-db: float,
    right-db: float,
    // The meter's own ballistics, computed per bus in the pump. Held levels
    // and the clip latch used to be dropped on the floor here, so a strip
    // drew a bare level with its peak marker pinned to it and a clip light
    // that could never come on.
    held-left-db: float,
    held-right-db: float,
    clipping: bool,
}

// One send, drawn as Adam's bar: the target, where it taps, whether it is
// passing, and a fader.
//
// Two lines rather than one because the strip is narrow and a send has four
// things to say. The bar is a `ParameterFader` -- the same horizontal fader
// the rest of the interface uses -- rather than a bespoke one, so a send
// level drags, fine-drags and resets to default like every other value.
// Shared since 2026-09-11: the track's rack face drew it first and the mixer
// strip's back face draws the same rows, so it lives here with `BusPicker`
// rather than in one of the two faces that uses it.
export component SendRow inherits Rectangle {
    in property <MixerSendRow> send;
    callback level-changed(float);
    callback tap-picked(int);
    callback enable-toggled();
    callback removed();

    height: 42px;
    background: hover.has-hover ? Theme.surface-raised : transparent;
    border-radius: Theme.radius-sm;

    hover := TouchArea { }

    VerticalLayout {
        padding-left: 4px;
        // Room for the scroll bar, which is drawn over the right edge of the
        // viewport: at 2px the remove button sat under it and could not be
        // clicked at all, while the switch beside it worked. Found by the
        // test below, which is why it clicks rather than invoking.
        padding-right: 12px;
        padding-top: 2px;
        spacing: 1px;

        HorizontalLayout {
            spacing: 3px;
            height: 18px;
            Text {
                horizontal-stretch: 1;
                text: root.send.target-name;
                color: root.send.enabled ? Theme.text : Theme.text-faint;
                font-size: 9px;
                vertical-alignment: center;
                overflow: elide;
            }
            // Post-fader first and pre-fader second, which is the order they
            // are reached for. The deeper tap points -- after a named device,
            // or at one of its declared outlets -- are the second half of
            // this step and become further rows in this same list.
            PickerChip {
                width: 46px;
                options: ["Post", "Pre"];
                selected-index: root.send.pre-fader ? 1 : 0;
                tooltip: root.send.pre-fader
                    ? "Pre-fader: after this track's devices, before its fader"
                    : "Post-fader: follows this track's fader";
                picked(i) => { root.tap-picked(i); }
            }
            // The bypass dot, in the shape the device frame already uses for
            // it. Switched off is not the same as turned down: this keeps the
            // level, and keeps the send in the graph, so nothing re-times.
            ToolButton {
                text: root.send.enabled ? "\u{25cf}" : "\u{25cb}";
                tooltip: root.send.enabled ? "Switch this send off" : "Switch this send on";
                hint: "A send switched off keeps its level and stays in the routing, so nothing else moves in time.";
                min-width: 20px;
                max-width: 20px;
                min-height: 18px;
                max-height: 18px;
                text-color: root.send.enabled ? Theme.accent : Theme.text-faint;
                clicked => { root.enable-toggled(); }
            }
            ToolButton {
                text: "\u{00d7}";
                tooltip: "Remove this send";
                hint: "Remove this send. The track it fed keeps everything else routed to it.";
                min-width: 18px;
                max-width: 18px;
                min-height: 18px;
                max-height: 18px;
                text-color: Theme.text-muted;
                clicked => { root.removed(); }
            }
        }
        ParameterFader {
            min-width: 60px;
            min-height: 20px;
            label-width: 0px;
            track-min-width: 40px;
            layout-spacing: 4px;
            value: root.send.level;
            maximum: GainMath.db-to-linear(6.0);
            default-value: 1.0;
            enabled: root.send.enabled;
            fill: root.send.enabled ? Theme.accent : Theme.text-faint;
            tooltip: "Level sent to " + root.send.target-name;
            value-text: GainMath.format-db(GainMath.linear-to-db(root.send.level));
            changed(v) => { root.level-changed(v); }
        }
    }
}

// Shared bus chooser. Used both to assign a channel to a bus and to route one
// bus into another; the two differ only in which destinations are offered.
//
// `allowed` masks the destinations that would close a loop, which only Rust
// can work out because it is a property of the whole graph rather than of one
// edge. An empty mask permits everything, which is the channel case: a channel
// is never part of a bus cycle. Disallowed entries are shown greyed rather
// than hidden, so the reason a destination is unavailable stays visible.
export component BusPicker inherits Rectangle {
    in property <[string]> bus-names;
    in property <int> value;
    in property <[bool]> allowed;
    in property <string> tooltip: "Destination bus";
    in property <bool> enabled: true;
    // Static text instead of the current destination, for the one use that
    // has no current destination: adding a send. The list, the legality mask
    // and the report-before-close fix are all the same, so this is a label
    // rather than a second picker.
    in property <string> label;
    in property <length> chip-width: 30px;
    callback picked(int);

    // The mute button on the same strip already reads "M", so the
    // destination carries an arrow rather than repeating a bare letter.
    private property <string> short-label: root.label != ""
        ? root.label
        : "\u{2192}" + (root.value == 0 ? "M" : root.value);

    width: root.chip-width;
    height: 22px;
    border-radius: Theme.radius-md;
    background: pick-touch.has-hover && root.enabled ? Theme.surface-active : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    Text {
        text: root.short-label;
        color: root.enabled ? Theme.text-muted : Theme.text-faint;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    pick-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { bus-menu.show(); }
    }

    Tooltip { text: @markdown("\{root.tooltip}"); }

    bus-menu := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: 96px;
        height: root.bus-names.length * 21px + 8px;
        // A destination is chosen by clicking *inside* this popup. With
        // `close-on-click`, Slint consumes that click to dismiss the popup
        // before the row's ToolButton can report `picked`, leaving every
        // channel apparently stuck on Master. Report the choice before
        // explicitly closing; only outside clicks otherwise auto-dismiss.
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                for name[i] in root.bus-names : Rectangle {
                    property <bool> permitted:
                        root.allowed.length == 0 || root.allowed[i];
                    height: 20px;
                    ToolButton {
                        width: 100%;
                        height: 20px;
                        text: name;
                        active: i == root.value;
                        enabled: parent.permitted;
                        // Not "Send to \{name}". This picker is four
                        // controls -- three output pickers and one send
                        // picker -- and since step 05 a send is a specific
                        // thing that three of them are not. The name is
                        // already the visible text, so when the row is legal
                        // the tooltip stays the label and adds nothing.
                        //
                        // The refused row is the one place in the interface
                        // where a sentence belongs in a tooltip rather than
                        // the status bar: `hint` is published from
                        // `ToolButton`'s TouchArea, which is disabled here,
                        // so the status bar would never hear it. `Tooltip`
                        // lowers to its own hover area and still shows. Do
                        // not "correct" this to a `hint`.
                        tooltip: parent.permitted
                            ? name
                            : name + " already leads back here";
                        clicked => {
                            root.picked(i);
                            bus-menu.close();
                        }
                    }
                }
            }
        }
    }
}
// One of the two arrows that turn a strip. A chevron while its page is
// elsewhere, and the same dot the sections' in-and-out switches wear while it
// is the page you are on.
component StripPageArrow inherits ToolButton {
    in property <bool> here;
    in property <string> glyph;

    text: root.here ? "" : root.glyph;
    icon: root.here ? StripIcons.dot : "";
    active: root.here;
    text-color: root.here ? Theme.text : Theme.text-muted;
    min-width: 20px;
    max-width: 20px;
    min-height: 16px;
    max-height: 16px;
}

// One track, at `MixerMetrics.strip-width`, with **three faces**.
//
// The middle one is the fader -- what you look at while mixing. The two
// beside it are reached by the arrows in the strip's bottom corners: sends to
// the left, the strip's own processing to the right. Adam, 2026-09-11:
// *"< for the send page, > for the strip page and if either is active the <
// or > turns into a dot, like the in/out buttons."* So each arrow is a
// two-position switch that wears a dot while its own page is up, which is the
// same idiom the sections' in-and-out switches use.
//
// **The name, the meter, the fader and the column beside it do not turn.**
// Two reasons, and the second is the load-bearing one: an EQ is set by ear
// while watching what it does to the level, and a face sharing nothing with
// the one it replaced reads as a different panel arriving rather than as this
// strip, turned round. The pan knob is in that column since 2026-09-11, where
// Adam's redraw puts it -- it used to be on the back face, which meant
// panning cost a turn.
component MixerStrip inherits Rectangle {
    in property <MixerStripRow> strip;
    in property <int> index;
    in property <[string]> bus-names;
    callback selected();
    callback mute-toggled();
    callback solo-toggled();
    callback polarity-toggled();
    callback volume-changed(float);
    callback pan-changed(float);
    callback output-picked(int);
    callback console-toggled();
    callback clip-reset();
    callback strip-moved(int, float);
    callback strip-switched(int, bool);
    callback strip-point-dragged(int, float, float);
    callback voicing-picked(int);
    callback send-added(int);
    callback send-removed(int);
    callback send-level-changed(int, float);
    callback send-tap-picked(int, int);
    callback send-enable-toggled(int);

    /// 0 sends, 1 the fader, 2 the strip. The fader is the middle one in the
    /// interface and in this number, which is what makes the two arrows
    /// point the way they do.
    private property <int> page: 1;
    private property <bool> faders: root.page == 1;
    // The way between the faces is a real turn: Slint 1.17 has no 3D
    // transform, so the card closes to nothing and opens again with the
    // other face on it -- `abs(turn - 0.5) * 2` is 1 at both ends and 0 in
    // the middle, where the faces swap. It spends `Motion.duration` and
    // `Motion.curve`, the tokens the device rack's slide-aside and the dock's
    // extent already animate on, rather than introducing a second timing.
    //
    // It turns on the way *out of* the fader face and back into it. Going
    // from sends straight to the strip swaps without the squeeze, which is
    // the one transition the two arrows cannot both be pressed for.
    private property <float> turn: root.faders ? 0 : 1;
    animate turn { duration: Motion.duration; easing: Motion.curve; }

    width: MixerMetrics.strip-width;
    background: root.strip.selected ? Theme.surface-active : Theme.surface;
    border-width: 1px;
    border-color: root.strip.selected ? Theme.accent : Theme.border;
    border-radius: Theme.radius-md;

    VerticalLayout {
        padding: MixerMetrics.strip-padding;
        spacing: 3px;

        // Name plate. Clicking it is the gesture that points the device rack
        // below at this track, so it covers the full width of the strip.
        Rectangle {
            height: 20px;
            border-radius: Theme.radius-sm;
            background: root.strip.selected ? Theme.accent-active : Theme.surface-raised;
            Text {
                text: root.strip.name;
                // Dimmed while somebody else's solo is silencing this
                // track: the strip is still there and still set up, it is
                // just not being heard, which is a different thing from
                // being muted and should not look the same.
                color: root.strip.solo-silenced
                    ? Theme.text-faint
                    : root.strip.selected ? Theme.text : Theme.text-muted;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                width: parent.width - 4px;
                x: 2px;
            }
            name-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(); }
            }
            Tooltip { text: @markdown("\{root.strip.name}"); }
        }

        // The output section: meter, fader, and the column beside it. It is
        // the elastic one -- the fader is squeezed from the top down to
        // `MixerMetrics.fader-floor`, and further to `fader-turned-floor`
        // once a face that needs the room is showing.
        HorizontalLayout {
            vertical-stretch: root.faders ? 1 : 0;
            min-height: root.faders
                ? MixerMetrics.fader-floor
                : MixerMetrics.fader-turned-floor;
            spacing: 2px;
            alignment: center;
            ChannelMeter {
                width: MixerMetrics.meter-width;
                segments: MixerMetrics.meter-segments;
                left-db: root.strip.left-db;
                right-db: root.strip.right-db;
                held-left-db: root.strip.held-left-db;
                held-right-db: root.strip.held-right-db;
                clipping: root.strip.clipping;
                clip-reset => { root.clip-reset(); }
            }
            MixerFader {
                width: MixerMetrics.fader-width;
                // The floor Adam asked for -- *"there's room to squish the
                // fader's top downward but it should have some kind of
                // reasonable min height"* -- and it has to be no lower than
                // `MixerFader`'s own, because Slint takes the stricter of a
                // component's constraint and its instance's.
                min-height: MixerMetrics.fader-floor;
                value: root.strip.volume;
                maximum: GainMath.db-to-linear(6.0);
                default-value: 1.0;
                tooltip: root.strip.name + " level";
                value-text: GainMath.format-db(GainMath.linear-to-db(root.strip.volume));
                changed(v) => { root.volume-changed(v); }
            }
            // Pan, solo, mute and polarity stacked, which is where Adam's
            // redraw puts them and what 92px makes possible: at 62px this
            // column is what did not fit, and pan had to go on a row below
            // the fader.
            // Stretch-aligned rather than `alignment: start`: a
            // start-aligned layout lays its children out at their preferred
            // sizes and reports the sum as its own *minimum*, so the column
            // could not give a pixel back. The spacer at the end takes
            // whatever is over instead.
            VerticalLayout {
                width: 24px;
                spacing: 2px;
                MiniKnob {
                    label: "Pan";
                    hint: "Where this track sits between the speakers.";
                    value: root.strip.pan;
                    minimum: -1;
                    maximum: 1;
                    default-value: 0;
                    bipolar: true;
                    controlled: true;
                    value-text: abs(root.strip.pan) < 0.01 ? "Center"
                        : root.strip.pan < 0 ? "L " + round(abs(root.strip.pan) * 100)
                        : "R " + round(root.strip.pan * 100);
                    changed(v) => { root.pan-changed(v); }
                }
                // Solo in place: this silences the other tracks rather than
                // tapping this one to a monitor output. The master has none,
                // because every track reaches it and soloing it would
                // silence nothing.
                // Bounded to 18px each, like the polarity button below
                // them: `ToolButton`'s own floor is 24, and four of those
                // plus the pan knob is taller than the fader's floor -- so
                // the column grew the output section and clipped the analog
                // sum off the bottom of the strip.
                if !root.strip.is-master : SoloButton {
                    soloed: root.strip.solo;
                    min-width: 22px;
                    max-width: 22px;
                    min-height: 18px;
                    max-height: 18px;
                    clicked => { root.solo-toggled(); }
                }
                MuteButton {
                    muted: root.strip.muted;
                    min-width: 22px;
                    max-width: 22px;
                    min-height: 18px;
                    max-height: 18px;
                    clicked => { root.mute-toggled(); }
                }
                // The cheapest control on the mockup, and drawn where it is
                // drawn rather than where it acts: polarity is applied at
                // the top of the track's block, so the strip, the chain,
                // both send taps and the fader all see the flipped signal.
                ToolButton {
                    text: "\u{00f8}";
                    tooltip: root.strip.polarity ? "Inverted" : "Normal";
                    hint: "Invert this track's polarity. It acts on the way in, so "
                        + "everything after it -- including a pre-fader send -- is flipped.";
                    active: root.strip.polarity;
                    min-width: 22px;
                    max-width: 22px;
                    min-height: 18px;
                    max-height: 18px;
                    clicked => { root.polarity-toggled(); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // The card. Only the lower half turns, so what is above stays put
        // and the strip reads as one object throughout.
        Rectangle {
            vertical-stretch: root.faders ? 0 : 1;
            // Bounds rather than a height, because an explicit `height`
            // overrides a layout's stretch: bound to `preferred-height` the
            // turned face measured zero -- a `ScrollView` has no intrinsic
            // height -- and the fader grew into the whole strip while the
            // back face drew nothing at all.
            //
            // **Zero, not a floor, on a turned face.** A 90px minimum here
            // made the turned strip 222px where the pane guarantees only
            // `strip-min-height + 16px` = 175, so the strip overflowed the
            // pane's bottom and took the arrow row with it -- the arrows
            // moved down the moment the strip was turned, which is the one
            // thing they cannot do, since they are how it turns back. The
            // page inside scrolls, so it has nothing to lose by collapsing:
            // the floor belonged to the pane, and the pane already has it.
            min-height: root.faders ? MixerMetrics.front-height : 0px;
            max-height: root.faders ? MixerMetrics.front-height : 100000px;
            clip: true;
            Rectangle {
                width: parent.width * abs(root.turn - 0.5) * 2;
                x: (parent.width - self.width) / 2;
                height: 100%;
                clip: true;
                // Fixed at the strip's own content width inside a container
                // that narrows, so the face is *clipped* as the card closes
                // rather than reflowed into a column one pixel wide.
                Rectangle {
                    width: MixerMetrics.strip-width - 2 * MixerMetrics.strip-padding;
                    x: (parent.width - self.width) / 2;
                    height: 100%;
                    // Exactly one of the three is built at a time -- an `if`
                    // rather than an opacity, which is what keeps the other
                    // two free on every track that is not turned to them.
                    if root.page == 1 : VerticalLayout {
                        spacing: 3px;
                        // The master has nowhere to send, so the row below
                        // it carries a feed count instead of an empty
                        // control.
                        Rectangle {
                            height: 22px;
                            if !root.strip.is-master : BusPicker {
                                x: (parent.width - 30px) / 2;
                                bus-names: root.bus-names;
                                value: root.strip.output;
                                allowed: root.strip.allowed;
                                tooltip: "Bus this one feeds";
                                picked(i) => { root.output-picked(i); }
                            }
                            if root.strip.is-master : Text {
                                text: "OUT";
                                color: Theme.text-faint;
                                font-size: 8px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                            }
                        }
                        // Analog sum, at the foot of the strip and set apart
                        // from mute -- which is where Adam's mockup puts it,
                        // and it is the honest place: this is the last thing
                        // that happens on the way out, after the fader, and
                        // it is not an output control in the way mute and
                        // pan are. The master has none, because it feeds
                        // nothing.
                        Rectangle {
                            height: 18px;
                            if !root.strip.is-master : ConsoleButton {
                                // Sized and placed by coordinate rather than
                                // by a layout, so it needs an explicit size:
                                // outside a layout an element fills its
                                // parent and `min-width`/`max-width`
                                // constrain nothing, which drew the switch as
                                // a slab across the whole strip the first
                                // time.
                                x: (parent.width - 22px) / 2;
                                y: 0px;
                                width: 22px;
                                height: 18px;
                                on: root.strip.console;
                                tooltip: "Analog sum";
                                hint: "Sum this bus into its destination through the analog summing "
                                    + "curve, together with everything else feeding it that has this on.";
                                toggled(v) => { root.console-toggled(); }
                            }
                        }
                        // No trailing spacer: the card is sized to exactly
                        // these three rows and their two gaps, and a fourth
                        // child adds a third gap -- which put the bottom
                        // four pixels of the analog-sum switch outside the
                        // card's own clip. The face's height is
                        // `MixerMetrics.front-height`, and it means what it
                        // says only if nothing else is in here.
                    }

                    // The sends page. The area draws the sends that exist
                    // and scrolls past the room it has, rather than
                    // reserving bays for a number somebody drew once. Adam,
                    // 2026-09-09: *"i drew 4 sends bc that is how many fit
                    // in my drawing... we are not limiting to 4."*
                    if root.page == 0 : VerticalLayout {
                        spacing: 3px;
                        padding-bottom: 18px;
                        HorizontalLayout {
                            spacing: 2px;
                            height: 16px;
                            SectionLabel {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                text: root.strip.sends.length == 0 ? "SENDS"
                                    : root.strip.sends.length + (root.strip.sends.length == 1 ? " SEND" : " SENDS");
                                color: root.strip.sends.length == 0 ? Theme.text-faint : Theme.accent;
                            }
                            // Not a `+ Send` button: this creates a
                            // **route**, and the track at the far end
                            // becomes a return by being sent to
                            // (`docs/TERMINOLOGY.md`).
                            if !root.strip.is-master : BusPicker {
                                bus-names: root.bus-names;
                                value: root.strip.output;
                                allowed: root.strip.send-allowed;
                                label: "+";
                                chip-width: 20px;
                                height: 16px;
                                tooltip: "Route a copy of this track to another one";
                                picked(target) => { root.send-added(target); }
                            }
                        }
                        if root.strip.sends.length == 0 : Text {
                            text: root.strip.is-master
                                ? "Every track reaches the master, so it sends to nothing."
                                : "Route this track to another and it gains a fader here.";
                            color: Theme.text-faint;
                            font-size: 8px;
                            wrap: word-wrap;
                            vertical-stretch: 1;
                        }
                        if root.strip.sends.length > 0 : ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.visible-width;
                            viewport-height: max(self.visible-height, root.strip.sends.length * 41px);
                            VerticalLayout {
                                spacing: 1px;
                                for send[index] in root.strip.sends : SendRow {
                                    send: send;
                                    level-changed(v) => { root.send-level-changed(index, v); }
                                    tap-picked(tap) => { root.send-tap-picked(index, tap); }
                                    enable-toggled => { root.send-enable-toggled(index); }
                                    removed => { root.send-removed(index); }
                                }
                            }
                        }
                    }

                    // The strip's own page: the three sections stacked, no
                    // tabs and no scopes. Scrolled rather than squeezed --
                    // the mixer pane is whatever height the views around it
                    // leave, and a section that shrank to fit would be a row
                    // of 8px knobs. The same answer the sends area gives.
                    if root.page == 2 : ScrollView {
                        viewport-width: self.visible-width;
                        viewport-height: max(self.visible-height, MixerMetrics.strip-page-height);
                        // Room for the vertical scroll bar, which Slint draws
                        // **over** the right edge of the viewport rather
                        // than beside it -- the trap `SendRow` records one
                        // level down, where it put a remove button under the
                        // bar. Here it sat on top of every section's
                        // in-and-out switch. Taken with an explicit x and
                        // width rather than by subtracting from
                        // `visible-width`, which is the bar's own idea of
                        // the viewport and already excludes it.
                        StripSections {
                            x: 0px;
                            width: MixerMetrics.strip-width
                                - 2 * MixerMetrics.strip-padding
                                - MixerMetrics.scroll-bar;
                            height: MixerMetrics.strip-page-height;
                            strip: root.strip.strip;
                            track: root.index;
                            moved(id, value) => { root.strip-moved(id, value); }
                            switched(id, on) => { root.strip-switched(id, on); }
                            voicing-picked(voicing) => { root.voicing-picked(voicing); }
                            point-dragged(band, hz, gain) => {
                                root.strip-point-dragged(band, hz, gain);
                            }
                        }
                    }
                }
            }
        }

        // The two page arrows, as the face's last row.
        //
        // **Not absolutely positioned.** They were children of the strip
        // with `y: root.height - 20px`, which reads like a free overlay and
        // is not: a non-layout child still contributes to its parent's
        // layout constraints, so the pair added their own height to
        // everything the `VerticalLayout` already needed and pushed the
        // analog-sum switch out of the bottom of the face. It cost four
        // wrong theories -- the meter's segments, the fader's floor, the
        // scroll bar, the column's alignment -- and the proof was deleting
        // them and watching the switch appear.
        HorizontalLayout {
            height: 16px;
            StripPageArrow {
                here: root.page == 0;
                glyph: "\u{2039}";
                tooltip: root.page == 0 ? "Back to the fader" : "This track's sends";
                hint: root.page == 0
                    ? "Turn this strip back to its fader, meter and destination."
                    : "Turn this strip to its sends: what it routes a copy of itself to, "
                        + "and how loud.";
                clicked => { root.page = root.page == 0 ? 1 : 0; }
            }
            Rectangle { horizontal-stretch: 1; }
            StripPageArrow {
                here: root.page == 2;
                glyph: "\u{203a}";
                tooltip: root.page == 2 ? "Back to the fader" : "This track's strip";
                hint: root.page == 2
                    ? "Turn this strip back to its fader, meter and destination."
                    : "Turn this strip to its own processing: drive, EQ and compressor, at "
                        + "the same width. The name, the meter and the fader stay where they are.";
                clicked => { root.page = root.page == 2 ? 1 : 2; }
            }
        }
    }
}

// The mixer work surface: the master, then every insert bus, scrolling
// horizontally the same way the device rack does.
export component MixerPane inherits Rectangle {
    in property <[MixerStripRow]> strips;
    in property <[string]> bus-names;
    callback bus-selected(int);
    callback bus-muted(int);
    callback bus-volume-changed(int, float);
    callback bus-pan-changed(int, float);
    callback bus-output-changed(int, int);
    callback bus-console-toggled(int);
    callback bus-polarity-toggled(int);
    callback bus-solo-toggled(int);
    callback bus-clip-reset(int);
    // One callback for every strip parameter, carrying the id
    // `mooloop_core::strip` gave it: `StripSpec` is where the markup gets
    // that id from, so neither side spells a number.
    callback bus-strip-param(int, int, float);
    callback bus-strip-point-dragged(int, int, float, float);
    callback bus-voicing-picked(int, int);
    callback bus-send-added(int, int);
    callback bus-send-removed(int, int);
    callback bus-send-level-changed(int, int, float);
    callback bus-send-tap-picked(int, int, int);
    callback bus-send-enable-toggled(int, int);
    callback track-added();
    in property <bool> can-add-track: true;

    background: Theme.panel;

    mixer-scroll := ScrollView {
        width: 100%;
        height: 100%;
        // Derived from the row, not a constant: the bank is fixed today but a
        // hardcoded width is exactly what left the device rack unscrollable.
        viewport-width: max(self.visible-width, strip-row.preferred-width);
        // The row's own padding plus what a strip's front face needs. A
        // turned strip wants far more and scrolls *inside* its own page
        // instead, so only the face with a hard minimum sets this one.
        // Derived from the row, like the width above and for the same
        // reason: a strip's face has a minimum height it cannot be squeezed
        // below -- the meter's fourteen segments, the column of four
        // buttons, the fader's own floor -- and every attempt to write that
        // number down here was wrong by a different amount. The layout
        // already knows it, so the pane scrolls to it.
        viewport-height: max(self.visible-height, MixerMetrics.strip-min-height + 16px);

        Rectangle {
            width: max(mixer-scroll.visible-width, strip-row.preferred-width);
            height: max(mixer-scroll.visible-height, MixerMetrics.strip-min-height + 16px);

            strip-row := HorizontalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;

                for strip[i] in root.strips : MixerStrip {
                    strip: strip;
                    index: i;
                    bus-names: root.bus-names;
                    selected => { root.bus-selected(i); }
                    mute-toggled => { root.bus-muted(i); }
                    polarity-toggled => { root.bus-polarity-toggled(i); }
                    solo-toggled => { root.bus-solo-toggled(i); }
                    volume-changed(v) => { root.bus-volume-changed(i, v); }
                    pan-changed(v) => { root.bus-pan-changed(i, v); }
                    output-picked(o) => { root.bus-output-changed(i, o); }
                    console-toggled => { root.bus-console-toggled(i); }
                    clip-reset => { root.bus-clip-reset(i); }
                    strip-moved(id, value) => { root.bus-strip-param(i, id, value); }
                    strip-point-dragged(band, hz, gain) => {
                        root.bus-strip-point-dragged(i, band, hz, gain);
                    }
                    strip-switched(id, on) => { root.bus-strip-param(i, id, on ? 1 : 0); }
                    voicing-picked(voicing) => { root.bus-voicing-picked(i, voicing); }
                    send-added(target) => { root.bus-send-added(i, target); }
                    send-removed(send) => { root.bus-send-removed(i, send); }
                    send-level-changed(send, level) => { root.bus-send-level-changed(i, send, level); }
                    send-tap-picked(send, tap) => { root.bus-send-tap-picked(i, send, tap); }
                    send-enable-toggled(send) => { root.bus-send-enable-toggled(i, send); }
                }

                // One `+`, one kind of thing. What a track *is* -- an
                // ordinary track, a bus, a send -- is decided by what routes
                // into it, not by which button made it, which is why there
                // is no `+ Bus` and no `+ Send` beside this
                // (`docs/TERMINOLOGY.md`).
                Rectangle {
                    width: 34px;
                    ToolButton {
                        y: 4px;
                        width: 26px;
                        height: 26px;
                        text: "+";
                        tooltip: "Add track";
                        hint: "Add a mixer track. Route channels or other tracks into it to "
                            + "make it a bus; feed it from a send to make it a return.";
                        enabled: root.can-add-track;
                        clicked => { root.track-added(); }
                    }
                }
            }
        }
    }
}
