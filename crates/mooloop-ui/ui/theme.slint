// Runtime theme tokens shared by every mooloop control in a component tree.
//
// Colors are derived in Rust (`settings::ThemePalette`) from three user-set
// seeds -- base, accent, and alert -- so the whole ramp moves together when
// any one of them changes. Nothing here should be hardcoded in a component:
// a control that writes its own hex is invisible to Preferences > Appearance.
export global Theme {
    in-out property <color> background: #18181b;
    in-out property <color> panel: #131316;
    in-out property <color> surface: #232328;
    in-out property <color> surface-raised: #2a2a2e;
    in-out property <color> surface-active: #33333a;
    in-out property <color> border: #3f3f46;
    in-out property <color> text: #e4e4e7;
    in-out property <color> text-muted: #a1a1aa;
    in-out property <color> text-faint: #52525b;
    in-out property <color> accent: #84cc16;
    in-out property <color> accent-active: #2d6a3e;
    in-out property <color> focus: #bef264;
    in-out property <color> warning: #eab308;
    in-out property <color> destructive: #ef4444;
    in-out property <color> destructive-active: #7f1d1d;
    in-out property <color> meter-safe: #22c55e;
    in-out property <color> meter-warning: #eab308;
    in-out property <color> meter-clip: #ef4444;

    // Corner-radius scale. Components use these tokens instead of literal
    // pixel radii so the Appearance page's one roundness control retunes the
    // whole UI live. Pill shapes stay expressed as `height / 2` locally --
    // they track their own geometry, not this scale.
    in-out property <float> roundness: 1.0;
    out property <length> radius-xs: 1px * root.roundness;
    out property <length> radius-sm: 2px * root.roundness;
    out property <length> radius-md: 3px * root.roundness;
    out property <length> radius-lg: 4px * root.roundness;

    // Type. `font-family` is a family name resolved at load time -- empty
    // means whatever the platform hands us -- and `main.slint` binds it to the
    // window's `default-font-family`, which is what makes it reach the three
    // hundred `Text` elements that never name a family. `font-family-mono` is
    // named explicitly, and only where the content demands it: a readout whose
    // digits must not reflow as the value changes.
    //
    // `type-scale` is the accessibility control. The working range of this
    // interface is 7-11px, which is small, and before these tokens existed
    // turning it up meant editing three hundred literals.
    in-out property <string> font-family: "";
    in-out property <string> font-family-mono: "monospace";
    in-out property <float> type-scale: 1.0;
    in-out property <int> font-weight: 400;

    out property <length> text-xs: 7px * root.type-scale;
    out property <length> text-sm: 8px * root.type-scale;
    out property <length> text-md: 9px * root.type-scale;
    out property <length> text-lg: 10px * root.type-scale;
    out property <length> text-xl: 11px * root.type-scale;
    // Above the working range: dialog headings, the transport readout, and
    // the handful of glyphs drawn large on purpose.
    out property <length> text-2xl: 13px * root.type-scale;
    out property <length> text-3xl: 16px * root.type-scale;
    out property <length> text-4xl: 22px * root.type-scale;

    // Stroke. A theme that wants a borderless interface sets `hairline` to 0
    // and gets one without any face knowing that is what it asked for; the
    // conditional strokes keep their condition, because whether a border is
    // drawn is behaviour and how thick it is is theme.
    in-out property <length> hairline: 1px;
    in-out property <length> stroke-emphasis: 2px;

    // Metrics. One `density` scalar over the control heights and the padding
    // ramp, which is what lets a theme open the interface up -- or a touch
    // display grow the hit targets -- without a per-face edit.
    //
    // The ramp is padding *and* spacing: at this size the distance between a
    // control and its neighbour and the distance between a control and its own
    // edge are the same decision, and two scales would be two names for it.
    in-out property <float> density: 1.0;
    out property <length> control-height: 24px * root.density;
    out property <length> control-min-width: 44px * root.density;
    out property <length> pad-xs: 2px * root.density;
    out property <length> pad-sm: 4px * root.density;
    out property <length> pad-md: 6px * root.density;
    out property <length> pad-lg: 8px * root.density;
}

// Rendering preferences set from Preferences > Appearance, alongside the
// palette. Kept separate from Theme since these aren't colors, but they
// apply the same way: set once from Rust, read by any component.
export global DisplayPrefs {
    in-out property <bool> smooth-curves: true;
}

// What the status bar is saying about whatever the pointer is over.
//
// Adam's rule for the two surfaces, which this exists to make cheap to obey:
// a tooltip is a value or a label, and the sentence explaining a control goes
// in the status bar. A control publishes its own sentence here and the status
// bar reads it; neither knows about the other, and it works at any depth.
//
// The alternative was in the tree and is why the rule was not kept: a
// `hover-hint` property threaded from a knob, up through its device face, and
// bound at the face's instantiation in `main.slint`. Exactly one device face
// ever grew that plumbing, and every sentence on the other twenty-odd stayed
// in a tooltip.
//
// A hover leaving clears the hint only if it is still that control's own: the
// pointer reaches the next control before the last one hears that it left, so
// an unconditional clear would blank a hint that had just been set.
export global StatusHint {
    in-out property <string> text;

    public function show(hint: string) {
        if (hint != "") { StatusHint.text = hint; }
    }
    public function clear(hint: string) {
        if (StatusHint.text == hint) { StatusHint.text = ""; }
    }
}

// The one owner of UI motion: every hide/show or reflow animation in the
// app draws its duration and easing from here, so Preferences > Appearance
// retunes all of them at once. `speed`/`easing` are indices into the
// option rows the Appearance page shows; Rust persists them by name.
// Slint's default is Instant so tests and pre-settings startup are
// deterministic; the application applies the stored preference on launch.
export global Motion {
    // 0=Instant, 1=Fast, 2=Normal, 3=Slow
    in-out property <int> speed: 0;
    // 0=Linear, 1=Ease out, 2=Ease in-out, 3=Overshoot
    in-out property <int> easing: 2;
    // Set while a pointer gesture owns the animated value (panel resize
    // grips): the animation steps aside so the panel tracks the pointer.
    in-out property <bool> gesture-active: false;

    out property <duration> duration:
        speed == 1 ? 120ms : speed == 2 ? 200ms : speed == 3 ? 320ms : 0ms;
    out property <easing> curve:
        easing == 1 ? ease-out
        : easing == 2 ? ease-in-out
        : easing == 3 ? cubic-bezier(0.34, 1.56, 0.64, 1)
        : linear;
}
