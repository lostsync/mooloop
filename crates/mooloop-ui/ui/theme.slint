// Runtime theme tokens shared by every mooloop control in a component tree.
export global Theme {
    in-out property <color> background: #18181b;
    in-out property <color> panel: #131316;
    in-out property <color> surface: #232328;
    in-out property <color> surface-raised: #2a2a2e;
    in-out property <color> surface-active: #33333a;
    in-out property <color> border: #3f3f46;
    in-out property <color> text: #e4e4e7;
    in-out property <color> text-muted: #a1a1aa;
    in-out property <color> text-faint: #52525b;
    in-out property <color> accent: #84cc16;
    in-out property <color> accent-active: #2d6a3e;
    in-out property <color> focus: #bef264;
    in-out property <color> warning: #eab308;
    in-out property <color> destructive: #ef4444;
    in-out property <color> destructive-active: #7f1d1d;
    in-out property <color> meter-safe: #22c55e;
    in-out property <color> meter-warning: #eab308;
    in-out property <color> meter-clip: #ef4444;
}
