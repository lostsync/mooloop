// The left sidebar: what the selected thing is called, what colour it is, and
// -- for a channel -- where its MIDI comes from and which mixer track its
// audio goes to.
//
// **It follows the selection the device rack already has** rather than keeping
// one of its own. `effect_target` is either a channel or a track and decides
// what the rack below is editing, so a sidebar that reads the same flag can
// never disagree with it about what "this thing" is. A track and a channel are
// different enough to draw differently and alike enough to share a panel: both
// are things you named and coloured.
//
// `reference/img/mooloop-1.0-mockup.png` draws this panel with four tabs --
// CHANNEL, MIDI, PLUGINS, MIXER -- and this is the CHANNEL one. The other
// three would each be a second view of a surface that already exists (the
// rack, the mixer), and `docs/plans/archive/interface-iteration/README.md`'s rule is
// that an interface change is judged by whether something already built
// becomes easier to reach. So the tab strip is drawn with one tab rather than
// four stubs: it is the shape, without the promise.
//
// **IN and CH are live as of 2026-09-15; OUT is still inert.** A channel picks
// which input plays it and on which MIDI channel, which is
// `docs/plans/archive/midi-control/` step 04. MIDI *output* does not exist at all --
// `SCOPE.md` §2 item 2 puts it in 0.2.0 -- so that row stays disabled and says
// so, which is the distinction the original comment here drew: a disabled row
// means "not configurable yet", and it would be a lie about the two that now
// are.
//
// **Neither picker holds its own list.** `MidiInputSource::picker_rows` and
// `MidiChannelFilter` own the rows and the index-to-value mapping, with
// round-trip tests; this markup receives the strings and hands back an index.
// A menu that spelled "Omni, 1, 2, ... 16" here would be the second copy of a
// list, which is the fault `AGENTS.md` opens on.

import { Theme } from "theme.slint";
import { PeakMeter, SectionLabel, ToggleButton } from "controls.slint";
import { GainMath } from "gain.slint";
import { MenuField, NameField } from "toolbar.slint";
import { ColorChipButton, ColorChoice } from "color-picker.slint";
// The same row the mixer strip draws, not a second one. A send has one model
// and these are two views of it; a row of its own here would be the third
// spelling of the same four controls.
import { BusPicker, MixerSendRow, SendRow } from "mixer.slint";
// Re-exported so `main.slint` has one import for the panel and the struct its
// model is made of.
export { ColorChoice }

// A label above a control, which is how a 180px column has to stack what a
// toolbar puts side by side.
component SidebarField inherits VerticalLayout {
    in property <string> label;
    spacing: 3px;
    SectionLabel { text: root.label; }
    @children
}

export component ChannelSidebar inherits Rectangle {
    // The channel these controls edit. The sidebar edits the selected channel
    // and nothing else: `selected-channel` already exists, is saved with the
    // document, and is what every other surface means by "this channel".
    // Whether the selection is a track rather than a channel. The panel is the
    // same panel either way; what changes is the tab's word, the number beside
    // it, and whether the MIDI rows are there at all.
    in property <bool> is-track;
    in property <string> channel-name;
    in property <int> channel-number;
    in property <bool> has-color;
    // Named `tint` rather than `color`, which a `Rectangle` already owns.
    in property <color> tint;
    in property <string> color-hex;
    in property <[ColorChoice]> color-choices;

    // A track's sends, and the vocabulary the "send to" picker needs. Empty
    // and unused for a channel: a channel's output is a route to one track and
    // a send is a track-to-track edge, which `docs/TERMINOLOGY.md` keeps
    // apart.
    in property <[MixerSendRow]> sends;
    in property <[string]> bus-names;
    // The mixer track a *channel* feeds. Unused for a track, whose
    // destination is the picker on its own mixer strip.
    in property <int> channel-bus;
    in property <[bool]> send-allowed;
    in property <int> track-index;
    in property <bool> is-master;

    // The MIDI input rows. Both lists come from Rust -- see the header -- and
    // both callbacks hand back the row that was picked, never a value.
    in property <[string]> midi-input-options;
    in property <int> midi-input-index;
    // Set when the stored input names a port that is not plugged in. The row
    // falls back to "Follow Selection", so without this the panel would
    // silently misreport what the channel is set to.
    in property <bool> midi-input-missing;
    in property <string> midi-input-missing-name;
    in property <[string]> midi-channel-options;
    in property <int> midi-channel-index;

    // The AUDIO row (`audio-recording/05`): where this channel records audio
    // from. Built in Rust by `AudioInputPicker`, like the MIDI rows, and
    // independent of them. Offered on every channel whatever its device
    // (decision 5); a device with no use for audio ignores it.
    in property <[string]> audio-input-options;
    in property <int> audio-input-index;
    // Set when the stored source is a track or channel that has been deleted.
    in property <bool> audio-input-missing;
    // The hardware input is picked: the monitoring toggle and its meter show.
    in property <bool> audio-input-is-hardware;
    // Hearing the hardware input through this channel. Off by default, and
    // nothing but this toggle turns it on: a live microphone monitored
    // through speakers feeds back.
    in property <bool> audio-monitor;
    in property <float> audio-input-level-db: GainMath.min-db;
    in property <float> audio-input-held-db: GainMath.min-db;

    callback midi-input-picked(int);
    callback midi-channel-picked(int);
    callback audio-input-picked(int);
    callback audio-monitor-toggled(bool);
    callback renamed(string);
    callback send-added(int);
    callback send-removed(int);
    callback send-level-changed(int, float);
    callback send-tap-picked(int, int);
    callback send-enable-toggled(int);
    // The mixer track picked for this channel, by index into `bus-names`.
    callback bus-picked(int);
    // The hex the project should store, or "" for no colour at all. A string
    // rather than a `color` because a colour is what Slint draws and a hex is
    // what the song keeps -- and because Rust is the only thing here that can
    // parse one.
    callback color-chosen(string);

    background: Theme.panel;
    VerticalLayout {
        spacing: 0px;

        // The tab strip, with one tab. Same 24px header the browser sidebar
        // wears on the other side of the window, so the two panels line up.
        Rectangle {
            height: 24px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 3px;
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 4px;
                Rectangle {
                    width: tab-label.preferred-width + 10px;
                    border-radius: Theme.radius-sm;
                    background: Theme.surface-active;
                    tab-label := Text {
                        text: root.is-track ? "TRACK" : "CHANNEL";
                        color: Theme.text;
                        font-size: Theme.text-md;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.channel-number <= 0
                        ? ""
                        : (root.is-track ? "TRK " : "CH ") + root.channel-number;
                    color: Theme.text-faint;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; opacity: 0.6; }

        VerticalLayout {
            padding: 8px;
            spacing: 10px;

            // The name and the colour share a row, and the colour is a chip.
            //
            // They are the two facts you give a channel by hand, and they are
            // the pair the transport toolbar already draws this way for a
            // pattern -- so this is the same control, not a second one. The
            // chip needs no label of its own because it *is* the colour; the
            // swatches move into its popup, which buys the panel back the two
            // rows it was spending on a palette that gets looked at once per
            // channel and then never again.
            SidebarField {
                label: "NAME";
                HorizontalLayout {
                    spacing: 4px;
                    NameField {
                        horizontal-stretch: 1;
                        text: root.channel-name;
                        placeholder: root.is-track ? "Track name" : "Channel name";
                        tooltip: root.is-track ? "Rename this track" : "Rename this channel";
                        edited(value) => { root.renamed(value); }
                    }
                    ColorChipButton {
                        choices: root.color-choices;
                        has-color: root.has-color;
                        tint: root.tint;
                        color-hex: root.color-hex;
                        tooltip: root.is-track ? "Color this track" : "Color this channel";
                        chosen(value) => { root.color-chosen(value); }
                    }
                }
            }

            // Where this channel lands in the mixer.
            //
            // It is the same edit the rack row's picker makes, off the same
            // model row that draws it -- not a second copy of the channel's
            // destination, which would be this repository's characteristic
            // fault applied to a routing decision. A channel's output is a
            // property of the channel, so the panel that describes a channel
            // is where it belongs; the rack row keeps its picker because a
            // step row wants the destination to hand without a selection.
            //
            // A track's destination is not drawn here. It has one, but it
            // lives on the track's own mixer strip beside the analog-sum
            // switch it is a property of, and a second editor for it is
            // exactly what moving the sends off the device face undid.
            if !root.is-track : SidebarField {
                label: "OUTPUT";
                BusPicker {
                    bus-names: root.bus-names;
                    value: root.channel-bus;
                    // `label` is the picker's static-text escape hatch, and
                    // what it is handed here is the destination's own name --
                    // so the chip still reports the value rather than
                    // replacing it, and reports it in words. "\u{2192}3" is
                    // what a 30px chip in a run of steps can say; a panel has
                    // the room to say "REVERB".
                    label: root.bus-names[root.channel-bus];
                    chip-width: 96px;
                    tooltip: "Mixer track this channel feeds";
                    picked(b) => { root.bus-picked(b); }
                }
            }

            // **Sends live here, and only here.** They were drawn on the
            // track's device face until 2026-09-13, which put a second editor
            // for them behind whichever view the bottom pane happened to be
            // showing. This panel is always to hand, and the mixer strip
            // keeps its level controls -- riding a send with its meter in
            // view is a different job from setting one up, which is the
            // division Adam asked for.
            //
            // The master has none: every track reaches it, so a send from it
            // could only close a loop.
            if root.is-track && !root.is-master : SidebarField {
                label: root.sends.length == 0
                    ? "SENDS"
                    : root.sends.length + (root.sends.length == 1 ? " SEND" : " SENDS");
                if root.sends.length == 0 : Text {
                    text: "Route this track to another and it gains a fader here.";
                    color: Theme.text-faint;
                    font-size: Theme.text-md;
                    wrap: word-wrap;
                }
                for send[i] in root.sends : SendRow {
                    send: send;
                    level-changed(v) => { root.send-level-changed(i, v); }
                    tap-picked(t) => { root.send-tap-picked(i, t); }
                    enable-toggled => { root.send-enable-toggled(i); }
                    removed => { root.send-removed(i); }
                }
                // Not a `+ Send` button: `docs/TERMINOLOGY.md` retires that
                // because it would name a *track* a send. This creates a
                // route, and the track at the far end becomes an effects
                // return by being sent to.
                BusPicker {
                    bus-names: root.bus-names;
                    value: root.track-index;
                    allowed: root.send-allowed;
                    label: "Send to\u{2026}";
                    chip-width: 62px;
                    height: 18px;
                    tooltip: "Route a copy of this track to another one";
                    picked(i) => { root.send-added(i); }
                }
            }

            if !root.is-track : Rectangle {
                height: 1px;
                background: Theme.border;
                opacity: 0.6;
            }

            // Inert. See the header of this file: the setting is drawn, the
            // configuration is not built, and the rows say which of those two
            // they are by being disabled.
            // **A track has no MIDI input**, so it does not draw the rows
            // rather than drawing them disabled. Disabled here would mean
            // "not configurable yet", which is true of a channel's and would
            // be a lie about a track's -- there is nothing to configure.
            if !root.is-track : SidebarField {
                label: "MIDI";
                VerticalLayout {
                    spacing: 4px;
                    // **A constant, not `root.width - padding`.** A
                    // `MenuField` sizes itself from `field-width`, so a row
                    // told to span the panel makes the panel size itself to a
                    // child that is reading the panel's width -- a binding
                    // loop through `layoutinfo-h`, which Slint now warns may
                    // panic at runtime. 96px clears the 180px minimum with
                    // the 16px of padding and the 38px the label and caret
                    // take, and a wider panel simply leaves slack to the
                    // right, which is what every toolbar field here does.
                    property <length> value-width: 96px;
                    MenuField {
                        field-width: parent.value-width;
                        label: "IN";
                        options: root.midi-input-options;
                        selected-index: root.midi-input-index;
                        tooltip: root.midi-input-missing
                            ? "MIDI input — " + root.midi-input-missing-name + " is not connected"
                            : "Which MIDI input plays this channel";
                        selected(index) => { root.midi-input-picked(index); }
                    }
                    // The one row still drawn disabled, and it means what a
                    // disabled row here has always meant: MIDI output does not
                    // exist, so there is nothing to configure.
                    MenuField {
                        field-width: parent.value-width;
                        label: "OUT";
                        enabled: false;
                        options: ["None"];
                        selected-index: 0;
                        tooltip: "MIDI output — not built yet";
                    }
                    MenuField {
                        field-width: parent.value-width;
                        label: "CH";
                        options: root.midi-channel-options;
                        selected-index: root.midi-channel-index;
                        tooltip: "Which MIDI channel this channel listens on";
                        selected(index) => { root.midi-channel-picked(index); }
                    }
                    // A device the project names and the system does not have.
                    // Said out loud rather than left to a silent channel.
                    if root.midi-input-missing : Text {
                        text: root.midi-input-missing-name + " not connected";
                        font-size: Theme.text-md;
                        color: Theme.warning;
                        wrap: word-wrap;
                        width: parent.value-width + 38px;
                    }
                }
            }

            if !root.is-track : SidebarField {
                label: "AUDIO";
                VerticalLayout {
                    spacing: 4px;
                    // A constant, for the reason the MIDI rows give.
                    property <length> value-width: 96px;
                    MenuField {
                        field-width: parent.value-width;
                        label: "IN";
                        options: root.audio-input-options;
                        selected-index: root.audio-input-index;
                        tooltip: root.audio-input-missing ? "Audio input — deleted" : "Audio input";
                        hint: "What this channel records from when its sampler's REC is pressed.";
                        selected(index) => { root.audio-input-picked(index); }
                    }
                    if root.audio-input-is-hardware : HorizontalLayout {
                        spacing: 6px;
                        ToggleButton {
                            width: 44px;
                            height: 22px;
                            text: "MON";
                            tooltip: "Monitor";
                            hint: "Hear the input through this channel. Off by default: a live microphone through speakers feeds back.";
                            checked: root.audio-monitor;
                            toggled(on) => { root.audio-monitor-toggled(on); }
                        }
                        VerticalLayout {
                            alignment: center;
                            PeakMeter {
                                width: 84px;
                                height: 6px;
                                level-db: root.audio-input-level-db;
                                held-db: root.audio-input-held-db;
                            }
                        }
                    }
                    if root.audio-input-missing : Text {
                        text: "Its source was deleted";
                        font-size: Theme.text-md;
                        color: Theme.warning;
                        wrap: word-wrap;
                        width: parent.value-width + 38px;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
