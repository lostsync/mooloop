// The seven-band EQ's face.
//
// **No range, resting value, label or count is spelled here.** `EqSpec` is a
// global whose table Rust fills once at startup from `mooloop_core`'s EQ
// descriptors, the same arrangement `strip.slint` uses and for the same
// reason: a knob's minimum and its automation lane's minimum are two views of
// one number, and a number written twice is how they come to disagree.
// `tests/eq_face.rs` reads the table back out of the window, holds it to the
// descriptors, and fails if a bound reappears in this file.
//
// The face is **one control set over a selection**, and it should be: seven
// duplicated rows of knobs is not an interface. What changed on 2026-09-14 is
// that the selection is resolved in Rust, to a real per-band parameter id,
// rather than being a parameter the DSP had to consult -- so this file's
// control indices are `EqFaceControl` positions, not descriptor ids. See
// `docs/plans/archive/../eq-v2/01-per-band-parameters.md`.

import { Theme } from "theme.slint";
import { GainMath } from "gain.slint";
import { NoteFormat, ParameterKnob, SelectorBank, ToolButton } from "controls.slint";
import { EqResponseDisplay } from "device-displays.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";

// One face control's range, as `mooloop_core::ParamDescriptor` states it.
// Handed over once at startup, never per frame.
export struct EqControlSpec {
    unit: string,
    minimum: float,
    maximum: float,
    logarithmic: bool,
}

// Everything about the EQ that is a fact rather than a layout.
//
// Rust sets all of it once, from the descriptor table the engine reads. The
// one thing this markup decides is which control goes where.
export global EqSpec {
    /// One row per `EqFaceControl`, in face-control order. A control that
    /// does not apply to the selected target -- a pass filter has no gain --
    /// still has a row, because the range belongs to the control and the
    /// face greys the knob rather than hiding it.
    in-out property <[EqControlSpec]> controls;
    /// How many bands the bank has. Targets past it are pass filters.
    in-out property <int> band-count;
    /// How many positions the target selector has: the bands, then the
    /// high-pass and the low-pass.
    in-out property <int> target-count;
    /// The selector's labels, in target order. Band *names*, from the same
    /// numbering the descriptors use -- band 0's parameters are "B1 Freq"
    /// and friends, so its button says 1. It said LOW until 2026-09-14,
    /// which made the face and the automation menu count differently.
    in-out property <[string]> target-names;
    /// The pass-filter slope selector's labels, in index order, from
    /// `EqSlope::db_per_octave`. They read 12/24/36/48/72 and said
    /// 6/12/18/24/36 until 2026-09-14: a stage is a second-order section, so
    /// every name was half the slope the bank was running.
    in-out property <[string]> slope-names;
    /// Every target's resting position for every control, normalized, laid
    /// out `target * controls.length + control`.
    ///
    /// Per target rather than one row for the whole face, because band 0
    /// rests at 120 Hz and band 1 at 1 kHz: a single resting value meant a
    /// knob's double-click returned to *band 2's* default whatever band was
    /// selected. `LOOSE_ENDS.md` had carried that since 2026-09-14.
    in-out property <[float]> defaults;

    /// A control's value in its own units, from the knob's 0..1 position.
    public pure function natural(control: int, value: float) -> float {
        let spec = root.controls[clamp(control, 0, max(0, root.controls.length - 1))];
        return spec.logarithmic && spec.minimum > 0 && spec.maximum > 0
            ? spec.minimum * pow(spec.maximum / spec.minimum, clamp(value, 0, 1))
            : spec.minimum + (spec.maximum - spec.minimum) * clamp(value, 0, 1);
    }

    /// A knob's readout, in the unit its own descriptor names. One formatter
    /// for the face rather than an expression per knob, the way
    /// `StripSpec.format` does it.
    public pure function format(control: int, value: float) -> string {
        let unit = root.controls[clamp(control, 0, max(0, root.controls.length - 1))].unit;
        let natural = root.natural(control, value);
        if (unit == "dB") { return GainMath.format-db(natural); }
        if (unit == "Hz") { return NoteFormat.frequency-value(natural); }
        return round(natural * 100) / 100;
    }

    /// Where `control` rests for `target`, for a double-click to return to.
    public pure function rest(target: int, control: int) -> float {
        let index = target * root.controls.length + control;
        return index >= 0 && index < root.defaults.length ? root.defaults[index] : 0;
    }

    /// The selector's position from the face's 0..1 selection, and back.
    public pure function target-index(value: float) -> int {
        return round(clamp(value, 0, 1) * (root.target-count - 1));
    }
    public pure function target-value(index: int) -> float {
        return clamp(index, 0, root.target-count - 1) / (root.target-count - 1);
    }
    public pure function slope-index(value: float) -> int {
        return round(clamp(value, 0, 1) * (root.slope-names.length - 1));
    }
    public pure function slope-value(index: int) -> float {
        return clamp(index, 0, root.slope-names.length - 1) / (root.slope-names.length - 1);
    }
    /// Whether a target is a pass filter, which has no gain and no Q profile
    /// but does have a slope.
    public pure function is-pass(target: int) -> bool {
        return target >= root.band-count;
    }
}

export component EqDeviceFace inherits EffectDeviceShell {
    name: "EQ";
    kind: "FX / 2U";
    in-out property <float> target;
    in-out property <float> enabled;
    in-out property <float> frequency;
    in-out property <float> gain;
    in-out property <float> q;
    /// The selected *pass filter's* slope, five positions. Named for what it is
    /// since 2026-09-12: this property used to carry either the slope or a
    /// band's Q profile depending on the selected target, which is two settings
    /// of different arity behind one parameter.
    in-out property <float> pass-slope;
    /// The selected *band's* Q profile, two positions.
    in-out property <float> q-profile;
    in property <[float]> band-data;
    /// Each band's shape, as `EqBandKind::to_index` numbers it, so the
    /// selector can draw a shelf as a shelf rather than as a number.
    ///
    /// Live rather than installed once with the rest of `EqSpec`: a preset or
    /// an automation lane can make band 4 a low shelf, and a glyph that could
    /// not follow that would be a control saying something the engine is not
    /// doing. `tests/eq_face.rs` holds the two integers below to
    /// `EqBandKind::to_index`.
    in property <[int]> band-kinds;
    in property <[float]> pass-data;
    in property <[float]> curve-db;
    in property <[float]> spectrum-data;
    in property <bool> analyzer-enabled: false;
    callback target-changed(float);
    callback enabled-changed(float);
    callback frequency-changed(float);
    callback gain-changed(float);
    callback q-changed(float);
    callback pass-slope-changed(float);
    callback q-profile-changed(float);
    callback analyzer-toggled(bool);

    private property <int> target-index: EqSpec.target-index(root.target);
    private property <bool> pass-target: EqSpec.is-pass(root.target-index);
    private property <bool> proportional-q: root.q-profile >= 0.5;

    // The selector's glyphs, on `ToolButton`'s 16x16 grid: what each target
    // does to the curve, drawn as the curve. A band that is a plain bell
    // draws its number instead -- the number its own parameters are called
    // by -- so the row reads as the bank does, shelf, five bells, shelf,
    // with the two pass filters at the ends.
    private property <string> low-shelf-icon: "M 2 5 L 5 5 C 7 5 7 11 9 11 L 14 11";
    private property <string> high-shelf-icon: "M 2 11 L 7 11 C 9 11 9 5 11 5 L 14 5";
    private property <string> high-pass-icon: "M 2 13 C 5 13 6 5 9 5 L 14 5";
    private property <string> low-pass-icon: "M 2 5 L 7 5 C 10 5 11 13 14 13";
    private property <string> analyzer-icon:
        "M 3 13 L 3 9 M 6.5 13 L 6.5 5 M 10 13 L 10 8 M 13.5 13 L 13.5 3";

    // Which target the button at `position` aims at: the high-pass first,
    // then the seven bands, then the low-pass, so the row runs left to right
    // the way the plot does and a shelf sits at the end it shelves.
    //
    // Only the *row* is reordered. A target keeps the number its parameters
    // keep -- the passes are the two past the bands, which is what
    // `EqSpec.is-pass` reads and what a dragged handle reports itself as.
    pure function row-target(position: int) -> int {
        if (position == 0) { return EqSpec.band-count; }
        return position > EqSpec.band-count ? EqSpec.band-count + 1 : position - 1;
    }

    // The glyph a target draws instead of its label, or "" for its label.
    //
    // The two integers are `EqBandKind::to_index`'s, which is the one thing
    // this face knows about the engine's numbering and the one thing
    // `the_selectors_glyphs_follow_the_bands_own_kind` pins.
    pure function target-icon(target: int) -> string {
        if (EqSpec.is-pass(target)) {
            return target == EqSpec.band-count ? root.high-pass-icon : root.low-pass-icon;
        }
        let kind = target < root.band-kinds.length ? root.band-kinds[target] : 0;
        return kind == 1 ? root.low-shelf-icon : kind == 2 ? root.high-shelf-icon : "";
    }

    VerticalLayout {
        padding: 6px; padding-top: DeviceRackMetrics.header-height + 6px; spacing: 4px;
        // The plot, with the analyzer's switch in its own top corner. The
        // switch said FFT and sat in the row of band buttons until
        // 2026-09-15, which put a control over what the *display* shows in a
        // row of things to aim the knobs at.
        Rectangle {
            height: 126px;
            EqResponseDisplay {
                width: 100%; height: 100%; band-data: root.band-data; pass-data: root.pass-data;
                curve-db: root.curve-db; spectrum-data: root.spectrum-data;
                selected-target: root.target-index; spectrum-visible: root.analyzer-enabled;
                point-grabbed(index) => { root.target-changed(EqSpec.target-value(index)); }
                // A pass filter's point moves in frequency only, so its gain
                // argument is the value it already had and writing it back is
                // refused in Rust anyway -- `EqParams::id_for_selected` has no id
                // for a pass filter's gain. Not sending it is the honest half of
                // that; the refusal is the belt.
                point-dragged(index, freq, gain) => {
                    root.target-changed(EqSpec.target-value(index));
                    root.frequency-changed(freq);
                    if (!EqSpec.is-pass(index)) { root.gain-changed(gain); }
                }
            }
            ToolButton {
                // Width and height rather than a min/max pair: outside a
                // layout an element takes its preferred size, and this one is
                // placed against the plot's right edge by its own width.
                x: parent.width - self.width - 6px;
                y: 6px;
                width: 28px; height: 22px;
                icon: root.analyzer-icon;
                tooltip: "Analyzer";
                hint: "Show spectrum analyzer";
                active: root.analyzer-enabled;
                clicked => { root.analyzer-toggled(!root.analyzer-enabled); }
            }
        }
        // The target row, centred under the plot and nothing else in it.
        //
        // Built out of `ToolButton` rather than with a `SelectorBank`
        // because a segment draws a **glyph** where its target has a shape --
        // the shelves and the two pass filters -- and its number where it is
        // a plain bell, and a bank carries one string per segment. The chrome
        // is `SelectorBank`'s own, through the same `Theme` tokens: what is
        // not shared is the choice of what to put inside a segment.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 26px;
                width: targets.preferred-width;
                background: Theme.surface;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;
                targets := HorizontalLayout {
                    spacing: 1px;
                    // One button per target, in row order rather than in
                    // target order; the loop is over the names only to get
                    // one iteration per target.
                    for name[position] in EqSpec.target-names : ToolButton {
                        property <int> target: root.row-target(position);
                        min-width: 30px; max-width: 30px;
                        text: root.target-icon(self.target) == ""
                            ? EqSpec.target-names[self.target] : "";
                        icon: root.target-icon(self.target);
                        tooltip: EqSpec.target-names[self.target];
                        hint: "Select EQ band";
                        active: root.target-index == self.target;
                        clicked => { root.target-changed(EqSpec.target-value(self.target)); }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            // The selected target's switch, beside the knobs it switches on
            // rather than in the row of targets: it is this band's control,
            // like the three knobs to its right, and not a way of choosing
            // one.
            VerticalLayout {
                alignment: center;
                padding-left: 6px;
                padding-right: 12px;
                ToolButton {
                    min-width: 30px; max-width: 30px; min-height: 26px; max-height: 26px;
                    text: "ON"; tooltip: "On"; hint: "Enable selected EQ section"; active: root.enabled >= 0.5;
                    clicked => { root.enabled-changed(root.enabled >= 0.5 ? 0 : 1); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            ParameterKnob { width: 80px; diameter: 40px; label: "Freq"; tooltip: "Selected band frequency"; value <=> root.frequency; default-value: EqSpec.rest(root.target-index, 2); value-text: EqSpec.format(2, root.frequency); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[2]; modulation-depth: root.modulation-depths[2]; modulation-offset: root.modulation-offsets[2]; modulation-route-count: root.modulation-route-counts[2]; changed(v) => { root.frequency-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(2, v); } modulation-edit-started => { root.modulation-edit-started(2); } modulation-edit-finished => { root.modulation-edit-finished(2); } }
            ParameterKnob { width: 80px; diameter: 40px; label: "Gain"; tooltip: "Selected band boost or cut"; enabled: !root.pass-target; bipolar: true; value <=> root.gain; default-value: EqSpec.rest(root.target-index, 3); value-text: EqSpec.format(3, root.gain); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[3]; modulation-depth: root.modulation-depths[3]; modulation-offset: root.modulation-offsets[3]; modulation-route-count: root.modulation-route-counts[3]; changed(v) => { root.gain-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(3, v); } modulation-edit-started => { root.modulation-edit-started(3); } modulation-edit-finished => { root.modulation-edit-finished(3); } }
            ParameterKnob { width: 80px; diameter: 40px; label: "Q"; tooltip: "Selected band width or pass resonance"; value <=> root.q; default-value: EqSpec.rest(root.target-index, 4); value-text: EqSpec.format(4, root.q); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[4]; modulation-depth: root.modulation-depths[4]; modulation-offset: root.modulation-offsets[4]; modulation-route-count: root.modulation-route-counts[4]; changed(v) => { root.q-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(4, v); } modulation-edit-started => { root.modulation-edit-started(4); } modulation-edit-finished => { root.modulation-edit-finished(4); } }
            Rectangle { horizontal-stretch: 1; }
            if root.pass-target : SelectorBank {
                options: EqSpec.slope-names;
                selected-index: EqSpec.slope-index(root.pass-slope);
                segment-width: 26px;
                tooltip: "Pass filter slope (dB per octave)";
                selected(i) => { root.pass-slope-changed(EqSpec.slope-value(i)); }
            }
            if !root.pass-target : ToolButton {
                min-width: 26px; max-width: 26px; min-height: 26px; max-height: 26px;
                text: "";
                icon: "M 2 12 L 5 12 L 8 4 L 11 12 L 14 12";
                tooltip: "Proportional Q";
                active: root.proportional-q;
                clicked => { root.q-profile-changed(root.proportional-q ? 0 : 1); }
            }
        }
    }
}
