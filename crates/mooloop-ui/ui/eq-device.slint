import { Theme } from "theme.slint";
import { DraggablePoint, NoteFormat, ParameterKnob, SelectorBank, ToolButton } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";

// A deliberately bounded frequency plot. The spectrum layer receives compact
// display telemetry only when enabled, so it cannot create background DSP work.
component EqResponseDisplay inherits Rectangle {
    in property <[float]> band-data;
    in property <[float]> spectrum-data;
    in property <int> selected-target;
    in property <bool> spectrum-visible;
    callback point-grabbed(int);
    callback point-dragged(int, float, float);
    private property <int> sample-count: 140;

    pure function band-value(index: int, field: int) -> float {
        return index * 5 + field < root.band-data.length ? root.band-data[index * 5 + field] : 0;
    }
    pure function band-shape(index: int, x: float) -> float {
        let frequency = 20 * pow(1000, clamp(x, 0, 1));
        let center = 20 * pow(1000, clamp(root.band-value(index, 0), 0, 1));
        // Q is the inverse of bandwidth: a larger Q must visibly narrow the
        // bell. The old exponent approximation changed the curve's skirt but
        // not its half-width, which made the display read backwards.
        let bell = 1 / (1 + pow(abs(ln(frequency / center)) * max(0.15, root.band-value(index, 2)), 2));
        return root.band-value(index, 4) == 1 ? 1 / (1 + pow(frequency / center, 1.6))
            : root.band-value(index, 4) == 2 ? 1 / (1 + pow(center / frequency, 1.6)) : bell;
    }
    // Coincident points cannot be independently clicked when they occupy the
    // same TouchArea. Spread only matching, enabled points horizontally; the
    // callback still addresses the band at the curve position.
    pure function overlaps(index: int, other: int) -> bool {
        return index != other
            && root.band-value(index, 3) > 0.5
            && root.band-value(other, 3) > 0.5
            && abs(root.band-value(index, 0) - root.band-value(other, 0)) < 0.002
            && abs(root.band-value(index, 1) - root.band-value(other, 1)) < 0.002;
    }
    pure function overlap-count(index: int) -> int {
        return 1
            + (root.overlaps(index, 0) ? 1 : 0) + (root.overlaps(index, 1) ? 1 : 0)
            + (root.overlaps(index, 2) ? 1 : 0) + (root.overlaps(index, 3) ? 1 : 0)
            + (root.overlaps(index, 4) ? 1 : 0) + (root.overlaps(index, 5) ? 1 : 0)
            + (root.overlaps(index, 6) ? 1 : 0);
    }
    pure function overlap-rank(index: int) -> int {
        return (index > 0 && root.overlaps(index, 0) ? 1 : 0)
            + (index > 1 && root.overlaps(index, 1) ? 1 : 0)
            + (index > 2 && root.overlaps(index, 2) ? 1 : 0)
            + (index > 3 && root.overlaps(index, 3) ? 1 : 0)
            + (index > 4 && root.overlaps(index, 4) ? 1 : 0)
            + (index > 5 && root.overlaps(index, 5) ? 1 : 0);
    }
    pure function response-db(x: float) -> float {
        let b0 = root.band-value(0, 3) > 0.5 ? (root.band-value(0, 1) * 36 - 18) * root.band-shape(0, x) : 0;
        let b1 = root.band-value(1, 3) > 0.5 ? (root.band-value(1, 1) * 36 - 18) * root.band-shape(1, x) : 0;
        let b2 = root.band-value(2, 3) > 0.5 ? (root.band-value(2, 1) * 36 - 18) * root.band-shape(2, x) : 0;
        let b3 = root.band-value(3, 3) > 0.5 ? (root.band-value(3, 1) * 36 - 18) * root.band-shape(3, x) : 0;
        let b4 = root.band-value(4, 3) > 0.5 ? (root.band-value(4, 1) * 36 - 18) * root.band-shape(4, x) : 0;
        let b5 = root.band-value(5, 3) > 0.5 ? (root.band-value(5, 1) * 36 - 18) * root.band-shape(5, x) : 0;
        let b6 = root.band-value(6, 3) > 0.5 ? (root.band-value(6, 1) * 36 - 18) * root.band-shape(6, x) : 0;
        return clamp(b0 + b1 + b2 + b3 + b4 + b5 + b6, -24, 24);
    }
    pure function point-color(index: int) -> color {
        return index == 0 ? #eab308 : index == 1 ? #84cc16 : index == 2 ? #22c55e
            : index == 3 ? #06b6d4 : index == 4 ? #3b82f6 : index == 5 ? #a855f7 : #ec4899;
    }

    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    for grid in 7 : Rectangle { x: grid * parent.width / 6; width: 1px; height: 100%; background: Theme.border.with-alpha(0.32); }
    for grid in 5 : Rectangle { y: grid * parent.height / 4; width: 100%; height: 1px; background: Theme.border.with-alpha(grid == 2 ? 0.72 : 0.32); }
    for bar in 48 : Rectangle {
        private property <float> level: bar < root.spectrum-data.length ? root.spectrum-data[bar] : 0;
        x: bar * parent.width / 48; width: max(1px, parent.width / 48 - 1px);
        y: parent.height * (1 - clamp(level, 0, 1)); height: parent.height * clamp(level, 0, 1);
        background: Theme.text-faint.with-alpha(root.spectrum-visible ? 0.16 : 0);
    }
    for sample in root.sample-count : Rectangle {
        private property <float> x0: sample / (root.sample-count - 1);
        private property <float> x1: min(1, (sample + 1) / (root.sample-count - 1));
        private property <float> y0: 0.5 - root.response-db(x0) / 48;
        private property <float> y1: 0.5 - root.response-db(x1) / 48;
        x: x0 * parent.width; y: min(y0, y1) * parent.height;
        width: max(1px, parent.width / root.sample-count + 0.5px); height: max(1px, abs(y1 - y0) * parent.height);
        background: Theme.accent;
    }
    for index in 7 : DraggablePoint {
        private property <float> frequency: root.band-value(index, 0);
        private property <float> gain: root.band-value(index, 1);
        private property <int> coincident-count: root.overlap-count(index);
        private property <int> coincident-rank: root.overlap-rank(index);
        x: frequency * parent.width - 7px + (coincident-rank - (coincident-count - 1) / 2) * 18px;
        y: (1 - gain) * parent.height - 7px;
        width: 14px; height: 14px;
        enabled: root.band-value(index, 3) > 0.5;
        grabbed => { root.point-grabbed(index); }
        dragged(dx, dy) => {
            root.point-dragged(index,
                clamp(self.frequency + dx * 1px / parent.width, 0, 1),
                clamp(self.gain - dy * 1px / parent.height, 0, 1));
        }
        Rectangle { width: 14px; height: 14px; border-radius: 7px; background: root.point-color(index); border-width: root.selected-target == index ? 2px : 1px; border-color: root.selected-target == index ? Theme.text : Theme.panel; }
    }
}

export component EqDeviceFace inherits EffectDeviceShell {
    name: "EQ";
    kind: "FX / 2U";
    in-out property <float> target;
    in-out property <float> enabled;
    in-out property <float> frequency;
    in-out property <float> gain;
    in-out property <float> q;
    in-out property <float> character;
    in property <[float]> band-data;
    in property <[float]> spectrum-data;
    in property <bool> analyzer-enabled: false;
    callback target-changed(float);
    callback enabled-changed(float);
    callback frequency-changed(float);
    callback gain-changed(float);
    callback q-changed(float);
    callback character-changed(float);
    callback analyzer-toggled(bool);

    private property <int> target-index: round(root.target * 8);
    private property <float> frequency-hz: 20 * pow(1000, root.frequency);
    private property <float> gain-db: root.gain * 36 - 18;
    private property <float> q-value: 0.15 * pow(120, root.q);
    private property <bool> pass-target: root.target-index >= 7;
    private property <bool> proportional-q: round(root.character * 4) >= 1;

    VerticalLayout {
        padding: 6px; padding-top: DeviceRackMetrics.header-height + 6px; spacing: 4px;
        EqResponseDisplay {
            height: 126px; width: 100%; band-data: root.band-data; spectrum-data: root.spectrum-data; selected-target: root.target-index; spectrum-visible: root.analyzer-enabled;
            point-grabbed(index) => { root.target-changed(index / 8); }
            point-dragged(index, freq, gain) => { root.target-changed(index / 8); root.frequency-changed(freq); root.gain-changed(gain); }
        }
        HorizontalLayout {
            spacing: 4px;
            SelectorBank {
                options: ["LOW", "1", "2", "3", "4", "5", "6", "HP", "LP"];
                selected-index: root.target-index;
                segment-width: 30px;
                tooltip: "Select EQ band";
                selected(index) => { root.target-changed(index / 8); }
            }
            ToolButton {
                min-width: 30px; max-width: 30px; min-height: 26px; max-height: 26px;
                text: "ON"; tooltip: "Enable selected EQ section"; active: root.enabled >= 0.5;
                clicked => { root.enabled-changed(root.enabled >= 0.5 ? 0 : 1); }
            }
            ToolButton {
                min-width: 30px; max-width: 30px; min-height: 26px; max-height: 26px;
                text: "FFT"; tooltip: "Show spectrum analyzer"; active: root.analyzer-enabled;
                clicked => { root.analyzer-toggled(!root.analyzer-enabled); }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            ParameterKnob { width: 80px; diameter: 40px; label: "Freq"; tooltip: "Selected band frequency"; value <=> root.frequency; default-value: 0.566; value-text: NoteFormat.frequency-value(root.frequency-hz); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[2]; modulation-depth: root.modulation-depths[2]; modulation-offset: root.modulation-offsets[2]; modulation-route-count: root.modulation-route-counts[2]; changed(v) => { root.frequency-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(2, v); } modulation-edit-started => { root.modulation-edit-started(2); } modulation-edit-finished => { root.modulation-edit-finished(2); } }
            ParameterKnob { width: 80px; diameter: 40px; label: "Gain"; tooltip: "Selected band boost or cut"; enabled: !root.pass-target; bipolar: true; value <=> root.gain; default-value: 0.5; value-text: round(root.gain-db * 10) / 10 + " dB"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[3]; modulation-depth: root.modulation-depths[3]; modulation-offset: root.modulation-offsets[3]; modulation-route-count: root.modulation-route-counts[3]; changed(v) => { root.gain-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(3, v); } modulation-edit-started => { root.modulation-edit-started(3); } modulation-edit-finished => { root.modulation-edit-finished(3); } }
            ParameterKnob { width: 80px; diameter: 40px; label: "Q"; tooltip: "Selected band width or pass resonance"; value <=> root.q; default-value: 0.32; value-text: round(root.q-value * 100) / 100; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[4]; modulation-depth: root.modulation-depths[4]; modulation-offset: root.modulation-offsets[4]; modulation-route-count: root.modulation-route-counts[4]; changed(v) => { root.q-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(4, v); } modulation-edit-started => { root.modulation-edit-started(4); } modulation-edit-finished => { root.modulation-edit-finished(4); } }
            Rectangle { horizontal-stretch: 1; }
            if root.pass-target : SelectorBank {
                options: ["6", "12", "18", "24", "36"];
                selected-index: round(root.character * 4);
                segment-width: 26px;
                tooltip: "Pass filter slope (dB per octave)";
                selected(i) => { root.character-changed(i / 4); }
            }
            if !root.pass-target : ToolButton {
                min-width: 26px; max-width: 26px; min-height: 26px; max-height: 26px;
                text: "";
                icon: "M 2 12 L 5 12 L 8 4 L 11 12 L 14 12";
                tooltip: "Proportional Q";
                active: root.proportional-q;
                clicked => { root.character-changed(root.proportional-q ? 0 : 0.25); }
            }
        }
    }
}
