import { Theme } from "theme.slint";
import { ToolButton } from "controls.slint";

// A question the app asks in its own window: Save / Don't Save / Cancel for
// unsaved changes, Replace / Cancel for a preset name that is taken, Load /
// Cancel for a kit that drops channels (MOO-91).
//
// In-app rather than a desktop dialog program for two reasons that both cost
// someone their work. A program that would not start read as Cancel, so with
// no zenity a song with unsaved changes could not be quit at all; and one
// that did start blocked the UI thread, meters and MIDI included, until it
// was answered.
//
// `answered` carries 0 for Cancel (also Escape), 1 for the primary button
// (also Enter) and 2 for the secondary one. The dialog closes itself *before*
// it reports, so whatever the answer starts may open it again with the next
// question.
export component QuestionDialog inherits Rectangle {
    in-out property <bool> open;
    in property <string> title;
    in property <string> detail;
    in property <string> primary-label: "OK";
    // Empty hides it: most questions have two answers, not three.
    in property <string> secondary-label;
    in property <string> cancel-label: "Cancel";
    callback answered(int);

    visible: root.open;
    background: #00000099;
    z: 210;

    function answer(value: int) {
        root.open = false;
        root.answered(value);
    }

    changed open => {
        if (root.open) {
            keys.focus();
        }
    }

    // Swallows clicks on the scrim so the window behind stays untouched.
    TouchArea { }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.answer(0);
                return accept;
            }
            if (event.text == Key.Return) {
                root.answer(1);
                return accept;
            }
            accept
        }
    }

    Rectangle {
        // A fixed card, so every button sits in the same place whatever the
        // question says: the tests press them by position.
        width: min(parent.width - 32px, 460px);
        height: 160px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-width: Theme.hairline;
        border-color: Theme.border;
        border-radius: Theme.radius-lg;

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.text-3xl;
                overflow: elide;
            }
            Text {
                text: root.detail;
                visible: root.detail != "";
                color: Theme.text-muted;
                font-size: Theme.text-xl;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 6px;
                if root.secondary-label != "": ToolButton {
                    text: root.secondary-label;
                    width: 110px;
                    height: 30px;
                    clicked => { root.answer(2); }
                }
                Rectangle { horizontal-stretch: 1; }
                ToolButton {
                    text: root.cancel-label;
                    width: 88px;
                    height: 30px;
                    clicked => { root.answer(0); }
                }
                ToolButton {
                    text: root.primary-label;
                    active: true;
                    width: 110px;
                    height: 30px;
                    clicked => { root.answer(1); }
                }
            }
        }
    }
}
