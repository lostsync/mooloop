import { Theme } from "theme.slint";
import { GainMath } from "gain.slint";

export enum ValueScale { linear, logarithmic }
export enum AudioOrientation { horizontal, vertical }

// Interaction-only graph handle. Consumers bind its position to their plotted
// transfer function and map the relative pixel deltas into their parameters.
export component DraggablePoint inherits TouchArea {
    callback grabbed();
    callback dragged(float, float);
    callback scrolled(float);

    mouse-cursor: MouseCursor.crosshair;
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            root.grabbed();
        }
    }
    // The point moves with the bound parameter during a drag. Relative-to-
    // press coordinates avoid treating that moving hit target as a stable
    // parent coordinate system.
    moved => {
        root.dragged((self.mouse-x - self.pressed-x) / 1px, (self.mouse-y - self.pressed-y) / 1px);
    }
    scroll-event(e) => {
        root.scrolled(e.delta-y / 1px);
        accept
    }

    @children
}

// Frequency controls use the same nearest-note convention as the sampler's
// tuned-root readout: A4 is MIDI 69 at 440 Hz.
export global NoteFormat {
    // Split out from `name` because a MIDI note number is what the sampler's
    // root and slice-base fields already hold: going through Hz to get a
    // note name back would be a round trip through the one representation
    // neither end uses.
    public pure function midi-name(midi: int) -> string {
        let clamped = clamp(midi, 0, 127);
        let pitch-class = mod(clamped, 12);
        let note = pitch-class == 0 ? "C" : pitch-class == 1 ? "C#"
            : pitch-class == 2 ? "D" : pitch-class == 3 ? "D#"
            : pitch-class == 4 ? "E" : pitch-class == 5 ? "F"
            : pitch-class == 6 ? "F#" : pitch-class == 7 ? "G"
            : pitch-class == 8 ? "G#" : pitch-class == 9 ? "A"
            : pitch-class == 10 ? "A#" : "B";
        return note + (floor(clamped / 12) - 1);
    }

    public pure function name(hz: float) -> string {
        return root.midi-name(round(69 + 12 * ln(max(hz, 0.001) / 440) / ln(2)));
    }

    public pure function frequency-value(hz: float) -> string {
        return root.name(hz) + " · " + round(hz) + " Hz";
    }
}

export component ToolButton inherits Rectangle {
    in property <string> text;
    // Line-art icon on a 16x16 grid, drawn instead of a glyph when set (see
    // ToolIcons in toolbar.slint for the precedent: text glyphs resolve
    // through font fallback and arrive at inconsistent weights, Path icons
    // stay one family). Empty string keeps the plain-text behavior.
    in property <string> icon: "";
    in property <string> tooltip: root.text;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <color> text-color: Theme.text;
    in property <color> active-color: Theme.accent-active;
    callback clicked;

    min-width: 44px;
    min-height: 24px;
    border-radius: Theme.radius-md;
    border-width: (tap.has-hover || button-keyboard.has-focus) && root.enabled ? 1px : 0px;
    border-color: button-keyboard.has-focus ? Theme.focus : Theme.border;
    background: !root.enabled
        ? Theme.surface
        : tap.pressed
            ? Theme.surface-active
            : root.active ? root.active-color : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.tooltip;
    forward-focus: button-keyboard;

    if root.icon == "" : Text {
        text: root.text;
        color: root.enabled ? root.text-color : Theme.text-faint;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 11px;
    }
    if root.icon != "" : Path {
        width: 16px;
        height: 16px;
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.icon;
        stroke: root.enabled ? root.text-color : Theme.text-faint;
        stroke-width: 1.3px;
        fill: transparent;
    }

    tap := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { button-keyboard.focus(); root.clicked(); }
    }

    // focus-on-click must stay off: a FocusScope that doesn't yet have focus
    // swallows the press that would focus it, so the first click on a control
    // would only highlight it and never reach `tap`. The TouchArea above takes
    // focus explicitly instead.
    button-keyboard := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") { root.clicked(); accept } else { reject }
        }
    }

    Tooltip { text: @markdown("\{root.tooltip}"); }
}

export component ToggleButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip: root.text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-width: 44px;
    min-height: 24px;

    ToolButton {
        text: root.text;
        tooltip: root.tooltip;
        active: root.checked;
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected-index;
    in property <bool> enabled: true;
    callback selected(int);

    min-height: 26px;
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        spacing: 1px;
        for option[i] in root.options : ToolButton {
            text: option;
            tooltip: option;
            active: root.selected-index == i;
            enabled: root.enabled;
            horizontal-stretch: 1;
            clicked => {
                root.selected-index = i;
                root.selected(i);
            }
        }
    }
}

// Compact one-click choice for short, fixed option sets such as waveforms and
// filter modes. Segment widths follow their labels instead of filling an
// arbitrary panel width.
export component SelectorBank inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected-index;
    in property <bool> enabled: true;
    in property <string> tooltip;
    in property <length> segment-width: 44px;
    callback selected(int);

    height: 26px;
    width: selector-layout.preferred-width;
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    selector-layout := HorizontalLayout {
        spacing: 1px;
        for option[i] in root.options : ToolButton {
            text: option;
            tooltip: root.tooltip == "" ? option : root.tooltip + ": " + option;
            active: root.selected-index == i;
            enabled: root.enabled;
            min-width: root.segment-width;
            max-width: root.segment-width;
            clicked => {
                root.selected-index = i;
                root.selected(i);
            }
        }
    }
}

export component SectionLabel inherits Text {
    color: Theme.text-faint;
    font-size: 9px;
    height: 12px;
}

// Bounded functional group used to tile instrument editors. Children live in
// one padded content column under a stable title line.
export component InstrumentModule inherits Rectangle {
    in property <string> title;
    in property <length> module-padding: 6px;

    min-height: 64px;
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: root.module-padding;
        spacing: 4px;
        if root.title != "" : SectionLabel { text: root.title; }
        @children
    }
}

// Emulates a small readout display: a recessed dark box sized to its own
// text, holding the value in a bright accent tone. Monospace keeps digits
// from jittering the box width as a knob is dragged. Slint's font-family
// takes a single name rather than a fallback list, so this relies on the
// same "monospace" alias the codebase already uses elsewhere (toolbar.slint,
// sampler-device.slint) to resolve to whatever the host has, rather than
// bundling a font — a deliberate fallback, not an oversight.
export component ValueReadout inherits Rectangle {
    in property <string> value-text;
    in property <string> unit;
    // Bounds the readout to whatever column it sits in (a knob is usually
    // narrower than a long value string, e.g. a note+Hz readout), so packed
    // rows of knobs never collide. Text still elides past that bound.
    in property <length> readout-max-width: 10000px;
    min-height: 16px;
    width: min(readout-text.preferred-width + 10px, root.readout-max-width);
    border-radius: Theme.radius-sm;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;

    readout-text := Text {
        width: 100%;
        text: root.value-text + (root.unit == "" ? "" : " " + root.unit);
        color: Theme.accent;
        font-family: "monospace";
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Shared knob visual: a value arc around a raised cap, plus a pointer dot.
// Purely presentational - callers overlay their own TouchArea via `@children`
// so that the knob, the mini knob, and future modulation rings can all share
// one look without duplicating interaction code.
component KnobFace inherits Rectangle {
    in property <float> normalized;
    in property <bool> bipolar;
    in property <bool> enabled: true;
    in property <bool> focused;
    in property <bool> hovered;
    in property <color> fill: Theme.accent;
    in property <length> diameter: 44px;
    // Assign mode for this control: an assignable source is armed and this
    // destination accepts it.
    in property <bool> modulation-armed;
    // The armed source's signed route depth, shown only while assigning.
    in property <float> modulation-depth;
    // The live signed offset the running modulators are applying right now,
    // in normalized units. Shown only outside assign mode, where it is the
    // whole point: the arc has to move for modulation to read as modulation.
    in property <float> modulation-offset;
    // How many routes land here, drawn as dots in the track's bottom gap.
    in property <int> modulation-route-count;

    // The arc sweeps 270 degrees, from 7:30 round to 4:30, matching the
    // pointer dot below. Geometry is expressed in a 100x100 viewbox so a
    // single set of numbers works at every diameter.
    private property <float> clamped: clamp(root.normalized, 0, 1);
    private property <angle> value-angle: -135deg + root.clamped * 270deg;
    private property <float> modulation-range: abs(root.modulation-depth);
    private property <float> modulation-low: clamp(root.clamped - root.modulation-range, 0, 1);
    private property <float> modulation-high: clamp(root.clamped + root.modulation-range, 0, 1);
    private property <angle> modulation-low-angle: -135deg + root.modulation-low * 270deg;
    private property <angle> modulation-high-angle: -135deg + root.modulation-high * 270deg;
    // Where the arc actually sits once the running modulators are summed in.
    private property <float> modulated: clamp(root.clamped + root.modulation-offset, 0, 1);
    private property <angle> modulated-angle: -135deg + root.modulated * 270deg;
    private property <bool> modulation-live: !root.modulation-armed
        && abs(root.modulated - root.clamped) > 0.002;
    // While assigning, the value arc is replaced by a short bar at the base,
    // so the ring is free to show the route's excursion without the two
    // readings competing. Centred on the value, which keeps it on the track
    // at both ends of the sweep.
    private property <angle> base-bar-from: -135deg + clamp(root.clamped - 0.022, 0, 1) * 270deg;
    private property <angle> base-bar-to: -135deg + clamp(root.clamped + 0.022, 0, 1) * 270deg;
    private property <angle> origin-angle: root.bipolar ? 0deg : -135deg;
    private property <color> active-fill: root.enabled ? root.fill : Theme.text-faint;
    private property <int> dots: min(root.modulation-route-count, 4);

    width: root.diameter;
    height: root.diameter;

    pure function arc-x(a: angle) -> float { return 50 + 40 * sin(a); }
    pure function arc-y(a: angle) -> float { return 50 - 40 * cos(a); }

    // One arc of the track between two angles. The large-arc flag turns on
    // past a half turn and the sweep flag carries the direction, so callers
    // draw base-to-value, base-to-modulated, or an excursion span without
    // restating the geometry -- and a backward span (a negative offset) comes
    // out right instead of wrapping the long way round.
    pure function arc-commands(from: angle, to: angle) -> string {
        return "M \{root.arc-x(from)} \{root.arc-y(from)} A 40 40 0 "
            + (abs(to / 1deg - from / 1deg) > 180 ? 1 : 0) + " "
            + (to > from ? 1 : 0) + " "
            + root.arc-x(to) + " " + root.arc-y(to);
    }

    // Unswept track, so the control still reads as a knob at rest.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: root.arc-commands(-135deg, 135deg);
        stroke: Theme.border;
        stroke-width: root.diameter * 0.09;
        fill: transparent;
    }

    // Value arc. Bipolar knobs grow outward from 12 o'clock in whichever
    // direction the value sits, so "no modulation" reads as an empty ring.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        visible: !root.modulation-armed
            && (root.bipolar ? abs(root.clamped - 0.5) > 0.002 : root.clamped > 0.002);
        commands: root.arc-commands(root.origin-angle, root.value-angle);
        stroke: root.active-fill;
        stroke-width: root.diameter * 0.09;
        fill: transparent;
    }

    // Live modulation, drawn out of the value arc's end so the base stays
    // readable underneath it. A negative offset runs back over the green.
    if root.modulation-live : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: root.arc-commands(root.value-angle, root.modulated-angle);
        stroke: Theme.warning;
        stroke-width: root.diameter * 0.09;
        fill: transparent;
    }

    // The dialled-in depth, as the span the source will sweep around the
    // base. A bipolar source swings both ways, so the span is symmetric.
    if root.modulation-armed && root.modulation-range > 0.002 : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: root.arc-commands(root.modulation-low-angle, root.modulation-high-angle);
        stroke: Theme.warning;
        stroke-width: root.diameter * 0.09;
        fill: transparent;
    }

    // Assign mode: the authored value shrinks to a bar so the ring can carry
    // the route's excursion instead. Drawn after the excursion, which
    // otherwise buries the one mark saying where the base actually is.
    if root.modulation-armed : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: root.arc-commands(root.base-bar-from, root.base-bar-to);
        stroke: root.active-fill;
        stroke-width: root.diameter * 0.09;
        fill: transparent;
    }

    // Raised cap.
    Rectangle {
        x: parent.width * 0.16;
        y: parent.height * 0.16;
        width: parent.width * 0.68;
        height: parent.height * 0.68;
        border-radius: self.width / 2;
        background: Theme.surface-raised;
        border-width: root.focused || root.hovered ? 2px : 1px;
        border-color: root.focused ? Theme.focus : root.hovered ? Theme.text-faint : Theme.border;
    }

    // Pointer dot.
    Rectangle {
        width: root.diameter * 0.12;
        height: self.width;
        x: parent.width * (50 + 21 * sin(root.value-angle)) / 100 - self.width / 2;
        y: parent.height * (50 - 21 * cos(root.value-angle)) / 100 - self.height / 2;
        border-radius: self.width / 2;
        background: root.active-fill;
    }

    // Centre tick marks the bipolar origin so centre is findable by eye.
    if root.bipolar : Rectangle {
        x: parent.width / 2 - self.width / 2;
        y: parent.height * 0.02;
        width: 1px;
        height: parent.height * 0.08;
        background: Theme.text-faint;
    }

    // A zero-depth route still has to be visible while assigning: with no
    // span to draw, one endpoint at the base is what says "assigned".
    if root.modulation-armed && root.modulation-range <= 0.002 : Rectangle {
        width: root.diameter * 0.1;
        height: self.width;
        x: parent.width * (50 + 43 * sin(root.value-angle)) / 100 - self.width / 2;
        y: parent.height * (50 - 43 * cos(root.value-angle)) / 100 - self.height / 2;
        border-radius: self.width / 2;
        background: Theme.warning;
    }

    // Assigned-route count, in the 90-degree gap the track leaves at the
    // bottom. One dot per route so the count is readable at a glance, capped
    // at the per-channel modulator limit so the row cannot outgrow the knob.
    for index in [0, 1, 2, 3] : Rectangle {
        visible: !root.modulation-armed && index < root.dots;
        width: root.diameter * 0.09;
        height: self.width;
        x: parent.width / 2
            + (index - (root.dots - 1) / 2) * root.diameter * 0.15
            - self.width / 2;
        y: parent.height * 0.85;
        border-radius: self.width / 2;
        background: Theme.warning;
    }

    @children
}

export component ParameterKnob inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    in property <string> value-text;
    out property <bool> hovered: knob-touch.has-hover;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> default-value: root.minimum;
    in property <float> step: 0;
    in property <ValueScale> scale: ValueScale.linear;
    in property <bool> enabled: true;
    in property <bool> bipolar;
    in property <length> diameter: 44px;
    in property <color> fill: Theme.accent;
    // A knob normally carries its own name and value, stacked above and
    // below the face. A caller that already shows both -- a row that puts the
    // label and an editable field beside the knob -- turns them off here
    // rather than drawing them twice and paying three rows of height for it.
    in property <bool> show-label: true;
    in property <bool> show-value-text: true;
    // And a caller that draws the parameter *itself* some other way -- a cell
    // in a matrix that fills like a bar -- turns the dial off too, keeping
    // the drag, wheel, double-click-to-default, keyboard and modulation-
    // arming contract. That contract is the reason to reach for this rather
    // than build a second interactive control: there would then be two
    // implementations of what arming a route does to a gesture.
    in property <bool> show-dial: true;
    // Callers opt only legal, continuous destinations into this mode. While
    // active, every ordinary knob gesture adjusts this source's route depth
    // and leaves `value` — the authored base — untouched.
    in property <bool> modulation-armed;
    in property <bool> modulation-allowed: true;
    in-out property <float> modulation-depth;
    // Display-only: what the running modulators are doing to this parameter
    // right now, and how many routes land on it.
    in property <float> modulation-offset;
    in property <int> modulation-route-count;
    callback changed(float);
    callback modulation-depth-changed(float);
    callback modulation-edit-started();
    callback modulation-edit-finished();

    private property <float> pressed-normalized;
    private property <float> pressed-modulation-depth;
    private property <bool> fine-drag;
    private property <bool> modulation-edited;
    private property <float> normalized: root.normalized-value(root.value);
    private property <bool> modulation-active: root.modulation-armed && root.modulation-allowed;

    width: root.show-label ? 56px : root.diameter;
    height: root.show-label || root.show-value-text ? 80px : root.diameter;
    accessible-role: slider;
    accessible-label: root.tooltip;
    accessible-value: root.value-text;
    forward-focus: keyboard;

    pure function normalized-value(v: float) -> float {
        if (root.maximum <= root.minimum) { return 0; }
        if (root.scale == ValueScale.logarithmic && root.minimum > 0 && root.maximum > 0) {
            return clamp(ln(clamp(v, root.minimum, root.maximum) / root.minimum)
                / ln(root.maximum / root.minimum), 0, 1);
        }
        return clamp((v - root.minimum) / (root.maximum - root.minimum), 0, 1);
    }

    pure function value-at(n: float) -> float {
        let position = clamp(n, 0, 1);
        if (root.scale == ValueScale.logarithmic && root.minimum > 0 && root.maximum > 0) {
            return root.minimum * pow(root.maximum / root.minimum, position);
        }
        return root.minimum + position * (root.maximum - root.minimum);
    }

    function set-normalized(n: float) {
        if (root.modulation-active) {
            root.set-modulation-depth(root.modulation-depth + n - root.normalized);
            return;
        }
        let raw = root.value-at(n);
        let quantized = root.step > 0
            ? root.minimum + round((raw - root.minimum) / root.step) * root.step
            : raw;
        let next = clamp(quantized, root.minimum, root.maximum);
        if (next != root.value) {
            root.value = next;
            root.changed(next);
        }
    }

    function set-modulation-depth(depth: float) {
        let next = clamp(depth, -1, 1);
        if (next != root.modulation-depth) {
            root.modulation-depth = next;
            root.modulation-edited = true;
            root.modulation-depth-changed(next);
        }
    }

    VerticalLayout {
        spacing: 3px;
        alignment: center;

        if root.show-label : Text {
            text: root.label;
            color: !root.enabled ? Theme.text-faint
                : root.modulation-active ? Theme.warning : Theme.text-muted;
            font-size: 9px;
            height: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }

        // VerticalLayout aligns its children along the vertical axis only.
        // Without this full-width cell, a narrow knob face starts at the left
        // of a wider ParameterKnob, visibly skewing every device control row.
        if root.show-dial : Rectangle {
            width: root.width;
            height: root.diameter;
            knob-face := KnobFace {
                x: (parent.width - root.diameter) / 2;
                diameter: root.diameter;
                normalized: root.normalized;
                bipolar: root.bipolar;
                enabled: root.enabled;
                fill: root.fill;
                modulation-armed: root.modulation-active;
                modulation-depth: root.modulation-depth;
                modulation-offset: root.modulation-offset;
                modulation-route-count: root.modulation-route-count;
                focused: keyboard.has-focus;
                hovered: knob-touch.has-hover;
            }
        }

        if root.show-value-text : Rectangle {
            width: root.width;
            height: 16px;
            ValueReadout {
                x: (parent.width - self.width) / 2;
                value-text: root.value-text;
                readout-max-width: root.width;
            }
        }
    }

    // The label and value are part of the parameter, so they share the knob's
    // drag, reset, and wheel interaction instead of becoming dead pixels.
    knob-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.modulation-active ? crosshair : ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                keyboard.focus();
                root.pressed-normalized = root.normalized;
                root.pressed-modulation-depth = root.modulation-depth;
                root.modulation-edited = false;
                root.fine-drag = e.modifiers.control || e.modifiers.shift;
                if (root.modulation-active) { root.modulation-edit-started(); }
            } else if (e.kind == PointerEventKind.move && self.pressed) {
                if (root.modulation-active) {
                    root.set-modulation-depth(root.pressed-modulation-depth
                        + (self.pressed-y - self.mouse-y) / (root.fine-drag ? 5000px : 150px));
                } else {
                    root.set-normalized(root.pressed-normalized
                        + (self.pressed-y - self.mouse-y) / (root.fine-drag ? 5000px : 150px));
                }
            } else if (e.kind == PointerEventKind.up && root.modulation-active && root.modulation-edited) {
                root.modulation-edit-finished();
            }
        }
        double-clicked => {
            if (root.modulation-active) {
                root.modulation-edit-started();
                root.modulation-edited = false;
                root.set-modulation-depth(0);
                if (root.modulation-edited) { root.modulation-edit-finished(); }
            } else {
                root.value = clamp(root.default-value, root.minimum, root.maximum);
                root.changed(root.value);
            }
        }
        scroll-event(e) => {
            if (root.modulation-active) { root.modulation-edit-started(); root.modulation-edited = false; }
            root.set-normalized(root.normalized
                - e.delta-y / ((e.modifiers.control || e.modifiers.shift) ? 5000px : 600px));
            if (root.modulation-active && root.modulation-edited) { root.modulation-edit-finished(); }
            accept
        }
    }

    keyboard := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                if (root.modulation-active) { root.modulation-edit-started(); root.modulation-edited = false; }
                root.set-normalized(root.normalized
                    + ((e.modifiers.control || e.modifiers.shift) ? 0.0002 : 0.01));
                if (root.modulation-active && root.modulation-edited) { root.modulation-edit-finished(); }
                accept
            } else if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                if (root.modulation-active) { root.modulation-edit-started(); root.modulation-edited = false; }
                root.set-normalized(root.normalized
                    - ((e.modifiers.control || e.modifiers.shift) ? 0.0002 : 0.01));
                if (root.modulation-active && root.modulation-edited) { root.modulation-edit-finished(); }
                accept
            } else { reject }
        }
    }
    // Value only, never the name -- the label is already on screen, and a
    // knob's tooltip exists to confirm the exact value, not restate itself.
    Tooltip { text: @markdown("\{root.value-text}"); }
}

/// One row: a name, a small knob, and a typed field -- `Tune o [      ]`.
///
/// The knob keeps the whole modulation contract -- arming, depth drag, route
/// count, the live offset readout -- because that machinery is bound to the
/// knob gesture and splitting it would mean two places that can disagree
/// about what a parameter's base value is. The field is a plain text entry
/// over the same value, for the cases a knob is bad at: typing an exact
/// number, or reading one back without hovering.
///
/// The field commits on Enter or on losing focus, and reverts to the
/// authoritative text on anything it cannot parse. It deliberately does not
/// participate in modulation arming: while a source is armed the knob edits
/// route depth rather than the base, and a text box that quietly wrote the
/// base underneath that would be a trap.
export component KnobField inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    /// What the field shows when it is not being edited. The caller formats
    /// it, so units and precision stay wherever the rest of that parameter's
    /// formatting lives.
    in property <string> display-text;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> default-value: root.minimum;
    in property <float> step: 0;
    in property <ValueScale> scale: ValueScale.linear;
    in property <bool> bipolar;
    in property <length> diameter: 30px;
    in property <length> label-width: 34px;
    in property <length> field-width: 62px;
    in property <bool> modulation-armed;
    in property <bool> modulation-allowed: true;
    in-out property <float> modulation-depth;
    in property <float> modulation-offset;
    in property <int> modulation-route-count;
    callback changed(float);
    /// The typed string, unparsed. Rust owns the parsing: it already owns the
    /// formatting, and a unit-aware parser written twice in two languages is
    /// a unit-aware parser that disagrees with itself.
    callback text-committed(string);
    callback modulation-depth-changed(float);
    callback modulation-edit-started();
    callback modulation-edit-finished();

    // Placed rather than laid out, because the three parts have to line up on
    // one baseline and a layout that stretches any of them vertically breaks
    // that. The height is the knob's, so a row of these costs one knob.
    height: max(root.diameter, 20px);
    width: root.label-width + root.diameter + root.field-width + 9px;

    Text {
        x: 0;
        y: 0;
        width: root.label-width;
        height: root.height;
        text: root.label;
        color: root.modulation-armed && root.modulation-allowed
            ? Theme.warning : Theme.text-muted;
        font-size: 9px;
        vertical-alignment: center;
        overflow: elide;
    }

    knob := ParameterKnob {
        x: root.label-width + 4px;
        y: (root.height - self.height) / 2;
        // The name is in this row's own label and the value is in the field
        // beside it; the knob draws neither again.
        show-label: false;
        show-value-text: false;
        diameter: root.diameter;
        label: root.label;
        tooltip: root.tooltip;
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        default-value: root.default-value;
        step: root.step;
        scale: root.scale;
        bipolar: root.bipolar;
        value-text: root.display-text;
        modulation-armed: root.modulation-armed;
        modulation-allowed: root.modulation-allowed;
        modulation-depth <=> root.modulation-depth;
        modulation-offset: root.modulation-offset;
        modulation-route-count: root.modulation-route-count;
        changed(v) => { root.changed(v); }
        modulation-depth-changed(v) => { root.modulation-depth-changed(v); }
        modulation-edit-started => { root.modulation-edit-started(); }
        modulation-edit-finished => { root.modulation-edit-finished(); }
    }

    Rectangle {
        x: root.label-width + root.diameter + 9px;
        y: (root.height - self.height) / 2;
        width: root.field-width;
        height: 20px;
        border-radius: Theme.radius-md;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: entry.has-focus ? Theme.accent : Theme.border;
        accessible-role: text-input;
        accessible-label: root.tooltip;

        entry := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: 100%;
            // Rebinds whenever the caller's text changes, which is what pulls
            // the field back into agreement after a knob drag or a modulated
            // value lands.
            text: root.display-text;
            color: Theme.text;
            font-size: 9px;
            font-family: "monospace";
            single-line: true;
            vertical-alignment: center;
            selection-background-color: Theme.accent;
            accepted => {
                root.text-committed(self.text);
                self.clear-focus();
            }
            edited => { }
        }
    }
}


// Delay time can be a free-running millisecond value or one of a short,
// visible set of musical divisions. The audio-facing value remains the same
// normalized millisecond parameter in both cases; selecting a division simply
// recalculates it against the current BPM.
export component TimeDivisionKnob inherits Rectangle {
    in property <string> label: "TIME";
    in property <string> tooltip: "Delay time";
    in-out property <float> value;
    in property <int> bpm: 120;
    in-out property <bool> tempo-sync;
    // 0=1/2, 1=1/4, 2=1/8., 3=1/8T, 4=1/16.
    in-out property <int> division: 1;
    in property <float> default-value: 0.7815;
    in property <bool> modulation-armed;
    // Only the free-running millisecond value is a continuous destination:
    // while tempo-synced the knob selects a division index, and sweeping that
    // would step the delay between musical divisions rather than glide it.
    in property <bool> modulation-allowed: true;
    in-out property <float> modulation-depth;
    in property <float> modulation-offset;
    in property <int> modulation-route-count;
    callback changed(float);
    callback tempo-sync-changed(bool);
    callback division-changed(int);
    callback modulation-depth-changed(float);
    callback modulation-edit-started();
    callback modulation-edit-finished();

    private property <float> division-beats: root.division == 0 ? 0.5
        : root.division == 1 ? 1.0 : root.division == 2 ? 0.75
        : root.division == 3 ? 1.0 / 3.0 : 0.25;
    private property <float> effective-ms: root.tempo-sync
        ? root.division-beats * 60000 / max(root.bpm, 1)
        : pow(2000, root.value);
    private property <int> selected-mode: root.tempo-sync ? root.division + 1 : 0;

    width: 230px;
    height: 80px;

    pure function normalized-for-ms(ms: float) -> float {
        return clamp(ln(clamp(ms, 1, 2000)) / ln(2000), 0, 1);
    }

    function set-division(next: int) {
        let clamped = clamp(next, 0, 4);
        if (clamped != root.division) {
            root.division = clamped;
            root.division-changed(clamped);
        }
        root.value = root.normalized-for-ms(root.effective-ms);
        root.changed(root.value);
    }

    function select-mode(index: int) {
        if (index == 0) {
            if (root.tempo-sync) {
                root.tempo-sync = false;
                root.tempo-sync-changed(false);
            }
        } else {
            if (!root.tempo-sync) {
                root.tempo-sync = true;
                root.tempo-sync-changed(true);
            }
            root.set-division(index - 1);
        }
    }

    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        ParameterKnob {
            width: 64px;
            diameter: 40px;
            label: root.label;
            tooltip: root.tooltip;
            value: root.tempo-sync ? root.division * 1.0 : root.value;
            minimum: 0;
            maximum: root.tempo-sync ? 4 : 1;
            default-value: root.tempo-sync ? 1 : root.default-value;
            step: root.tempo-sync ? 1 : 0;
            value-text: root.effective-ms >= 100
                ? round(root.effective-ms) + " ms"
                : round(root.effective-ms * 10) / 10 + " ms";
            modulation-armed: root.modulation-armed;
            modulation-allowed: root.modulation-allowed && !root.tempo-sync;
            modulation-depth <=> root.modulation-depth;
            modulation-offset: root.modulation-offset;
            modulation-route-count: root.modulation-route-count;
            modulation-depth-changed(v) => { root.modulation-depth-changed(v); }
            modulation-edit-started => { root.modulation-edit-started(); }
            modulation-edit-finished => { root.modulation-edit-finished(); }
            changed(v) => {
                if (root.tempo-sync) {
                    root.set-division(round(v));
                } else {
                    root.value = v;
                    root.changed(v);
                }
            }
        }
        SelectorBank {
            options: ["MS", "1/2", "1/4", "1/8.", "1/8T", "1/16"];
            selected-index: root.selected-mode;
            segment-width: 26px;
            tooltip: "Delay time mode";
            selected(i) => { root.select-mode(i); }
        }
    }
}

export component ParameterFader inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    in property <string> value-text;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> default-value: root.minimum;
    in property <float> step: 0;
    in property <ValueScale> scale: ValueScale.linear;
    in property <AudioOrientation> orientation: AudioOrientation.horizontal;
    in property <bool> enabled: true;
    in property <bool> bipolar;
    in property <length> label-width: 34px;
    in property <length> track-min-width: 112px;
    in property <length> layout-spacing: 6px;
    in property <color> fill: Theme.accent;
    in property <color> text-color: Theme.text-muted;
    callback changed(float);

    private property <float> normalized: root.normalized-value(root.value);
    private property <length> track-height: 4px;
    private property <float> pressed-normalized;
    private property <bool> fine-drag;
    min-height: root.orientation == AudioOrientation.horizontal ? 22px : 112px;
    min-width: root.orientation == AudioOrientation.horizontal ? 120px : 32px;
    preferred-width: root.orientation == AudioOrientation.horizontal ? 176px : 32px;
    max-width: root.orientation == AudioOrientation.horizontal ? 10000px : 32px;
    accessible-role: slider;
    accessible-label: root.tooltip;
    accessible-value: root.value-text;
    forward-focus: fader-keyboard;

    pure function normalized-value(v: float) -> float {
        if (root.maximum <= root.minimum) { return 0; }
        if (root.scale == ValueScale.logarithmic && root.minimum > 0 && root.maximum > 0) {
            return clamp(ln(clamp(v, root.minimum, root.maximum) / root.minimum)
                / ln(root.maximum / root.minimum), 0, 1);
        }
        return clamp((v - root.minimum) / (root.maximum - root.minimum), 0, 1);
    }

    pure function value-at(n: float) -> float {
        let position = clamp(n, 0, 1);
        if (root.scale == ValueScale.logarithmic && root.minimum > 0 && root.maximum > 0) {
            return root.minimum * pow(root.maximum / root.minimum, position);
        }
        return root.minimum + position * (root.maximum - root.minimum);
    }

    function set-normalized(n: float) {
        let raw = root.value-at(n);
        let quantized = root.step > 0
            ? root.minimum + round((raw - root.minimum) / root.step) * root.step
            : raw;
        let next = clamp(quantized, root.minimum, root.maximum);
        if (next != root.value) {
            root.value = next;
            root.changed(next);
        }
    }

    if root.orientation == AudioOrientation.horizontal : HorizontalLayout {
        spacing: root.layout-spacing;
        alignment: start;
        Text {
            text: root.label;
            color: root.text-color;
            font-size: 10px;
            vertical-alignment: center;
            width: root.label-width;
        }
        horizontal-track := Rectangle {
            horizontal-stretch: 1;
            min-width: root.track-min-width;
            vertical-stretch: 1;
            Rectangle {
                y: (parent.height - root.track-height) / 2;
                height: root.track-height;
                width: parent.width;
                background: Theme.border;
                border-radius: root.track-height / 2;
            }
            Rectangle {
                x: root.bipolar ? parent.width * min(root.normalized, 0.5) : 0px;
                y: (parent.height - root.track-height) / 2;
                height: root.track-height;
                width: root.bipolar
                    ? parent.width * abs(root.normalized - 0.5)
                    : parent.width * root.normalized;
                background: root.enabled ? root.fill : Theme.text-faint;
                border-radius: root.track-height / 2;
            }
            if root.bipolar : Rectangle {
                x: parent.width / 2;
                y: (parent.height - root.track-height) / 2 - 2px;
                width: 1px;
                height: root.track-height + 4px;
                background: Theme.text-faint;
            }
            Rectangle {
                x: clamp(parent.width * root.normalized - 1px, 0px, parent.width - 2px);
                y: (parent.height - 12px) / 2;
                width: 2px;
                height: 12px;
                border-radius: Theme.radius-xs;
                background: root.enabled ? Theme.text : Theme.text-faint;
            }
            TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        fader-keyboard.focus();
                        root.pressed-normalized = root.normalized;
                        root.fine-drag = e.modifiers.control || e.modifiers.shift;
                        if (!root.fine-drag) { root.set-normalized(self.mouse-x / self.width); }
                    } else if (e.kind == PointerEventKind.move && self.pressed) {
                        root.set-normalized(root.fine-drag
                            ? root.pressed-normalized + (self.mouse-x - self.pressed-x) / 5000px
                            : self.mouse-x / self.width);
                    }
                }
                double-clicked => { root.value = clamp(root.default-value, root.minimum, root.maximum); root.changed(root.value); }
                scroll-event(e) => {
                    root.set-normalized(root.normalized
                        - e.delta-y / ((e.modifiers.control || e.modifiers.shift) ? 5000px : 600px)); accept
                }
            }
        }
    }

    if root.orientation == AudioOrientation.vertical : VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: root.text-color;
            font-size: 9px;
            height: 12px;
            horizontal-alignment: center;
        }
        vertical-track := Rectangle {
            vertical-stretch: 1;
            min-height: 76px;
            Rectangle {
                x: (parent.width - root.track-height) / 2;
                width: root.track-height;
                height: parent.height;
                background: Theme.border;
                border-radius: root.track-height / 2;
            }
            Rectangle {
                x: (parent.width - root.track-height) / 2;
                y: parent.height * (1 - root.normalized);
                width: root.track-height;
                height: parent.height * root.normalized;
                background: root.enabled ? root.fill : Theme.text-faint;
                border-radius: root.track-height / 2;
            }
            Rectangle {
                x: (parent.width - 14px) / 2;
                y: clamp(parent.height * (1 - root.normalized) - 2px, 0px, parent.height - 4px);
                width: 14px;
                height: 4px;
                border-radius: Theme.radius-xs;
                background: root.enabled ? Theme.text : Theme.text-faint;
            }
            TouchArea {
                enabled: root.enabled;
                mouse-cursor: ns-resize;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        fader-keyboard.focus();
                        root.pressed-normalized = root.normalized;
                        root.fine-drag = e.modifiers.control || e.modifiers.shift;
                        if (!root.fine-drag) { root.set-normalized(1 - self.mouse-y / self.height); }
                    } else if (e.kind == PointerEventKind.move && self.pressed) {
                        root.set-normalized(root.fine-drag
                            ? root.pressed-normalized + (self.pressed-y - self.mouse-y) / 5000px
                            : 1 - self.mouse-y / self.height);
                    }
                }
                double-clicked => { root.value = clamp(root.default-value, root.minimum, root.maximum); root.changed(root.value); }
                scroll-event(e) => {
                    root.set-normalized(root.normalized
                        - e.delta-y / ((e.modifiers.control || e.modifiers.shift) ? 5000px : 600px)); accept
                }
            }
        }
    }
    fader-keyboard := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                root.set-normalized(root.normalized
                    + ((e.modifiers.control || e.modifiers.shift) ? 0.0002 : 0.01)); accept
            } else if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                root.set-normalized(root.normalized
                    - ((e.modifiers.control || e.modifiers.shift) ? 0.0002 : 0.01)); accept
            } else { reject }
        }
    }
    Tooltip { text: @markdown("\{root.value-text}"); }
}

export component PeakMeter inherits Rectangle {
    in property <float> level-db: -60;
    in property <float> held-db: -60;
    in property <float> minimum-db: -60;
    in property <float> warning-db: GainMath.meter-warning-db;
    in property <float> hot-db: GainMath.meter-hot-db;
    in property <bool> clipping;
    in property <AudioOrientation> orientation: AudioOrientation.horizontal;

    private property <float> level-normalized: clamp(
        (root.level-db - root.minimum-db) / (0 - root.minimum-db), 0, 1);
    private property <float> held-normalized: clamp(
        (root.held-db - root.minimum-db) / (0 - root.minimum-db), 0, 1);
    min-width: root.orientation == AudioOrientation.horizontal ? 72px : 8px;
    min-height: root.orientation == AudioOrientation.horizontal ? 8px : 72px;
    border-radius: Theme.radius-sm;
    background: Theme.border;
    clip: true;

    if root.orientation == AudioOrientation.horizontal : Rectangle {
        width: parent.width * root.level-normalized;
        height: parent.height;
        background: root.level-db >= root.hot-db ? Theme.meter-clip
            : root.level-db >= root.warning-db ? Theme.meter-warning : Theme.meter-safe;
    }
    if root.orientation == AudioOrientation.horizontal : Rectangle {
        x: parent.width * root.held-normalized - 1px;
        width: 2px;
        height: parent.height;
        background: root.clipping ? Theme.meter-clip : Theme.text;
    }
    if root.orientation == AudioOrientation.vertical : Rectangle {
        y: parent.height * (1 - root.level-normalized);
        width: parent.width;
        height: parent.height * root.level-normalized;
        background: root.level-db >= root.hot-db ? Theme.meter-clip
            : root.level-db >= root.warning-db ? Theme.meter-warning : Theme.meter-safe;
    }
    if root.orientation == AudioOrientation.vertical : Rectangle {
        y: parent.height * (1 - root.held-normalized) - 1px;
        width: parent.width;
        height: 2px;
        background: root.clipping ? Theme.meter-clip : Theme.text;
    }
}

export component StereoPeakMeter inherits Rectangle {
    in property <float> left-db: -60;
    in property <float> right-db: -60;
    in property <float> held-left-db: -60;
    in property <float> held-right-db: -60;
    in property <bool> left-clipping;
    in property <bool> right-clipping;
    min-width: 96px;
    height: 18px;

    VerticalLayout {
        spacing: 2px;
        PeakMeter { level-db: root.left-db; held-db: root.held-left-db; clipping: root.left-clipping; }
        PeakMeter { level-db: root.right-db; held-db: root.held-right-db; clipping: root.right-clipping; }
    }
}

export component MuteButton inherits ToolButton {
    in property <bool> muted;
    text: "M";
    tooltip: "Mute";
    active: root.muted;
    active-color: Theme.destructive-active;
    text-color: root.muted ? #fecaca : Theme.text-faint;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
}

// Compact knob for dense rows (a rack channel, a step inspector) where a
// labelled ParameterKnob would not fit. Name and value live in the tooltip
// instead of taking layout space.
export component MiniKnob inherits Rectangle {
    in property <string> label;
    in property <string> value-text;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> default-value: root.minimum;
    in property <float> step: 0;
    in property <ValueScale> scale: ValueScale.linear;
    in property <bool> enabled: true;
    in property <bool> bipolar;
    in property <length> diameter: 22px;
    in property <color> fill: Theme.accent;
    // The same destination contract ParameterKnob answers, so a trim or a
    // level knob is assignable on equal terms with a device's other controls
    // rather than being a second class of parameter.
    in property <bool> modulation-armed;
    in property <bool> modulation-allowed: true;
    in-out property <float> modulation-depth;
    in property <float> modulation-offset;
    in property <int> modulation-route-count;
    callback changed(float);
    callback modulation-depth-changed(float);
    callback modulation-edit-started();
    callback modulation-edit-finished();
    // Base-value gesture boundaries, so a caller can coalesce one drag into
    // one undo step. Fired only when the knob edits its own value, never in
    // assign mode; a gesture that changes nothing is the caller's to ignore.
    callback edit-started();
    callback edit-finished();

    private property <float> pressed-normalized;
    private property <float> pressed-modulation-depth;
    private property <bool> fine-drag;
    private property <bool> modulation-edited;
    private property <float> normalized: root.normalized-value(root.value);
    private property <bool> modulation-active: root.modulation-armed && root.modulation-allowed;

    width: root.diameter;
    height: root.diameter;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    forward-focus: mini-keyboard;

    pure function normalized-value(v: float) -> float {
        if (root.maximum <= root.minimum) { return 0; }
        if (root.scale == ValueScale.logarithmic && root.minimum > 0 && root.maximum > 0) {
            return clamp(ln(clamp(v, root.minimum, root.maximum) / root.minimum)
                / ln(root.maximum / root.minimum), 0, 1);
        }
        return clamp((v - root.minimum) / (root.maximum - root.minimum), 0, 1);
    }

    pure function value-at(n: float) -> float {
        let position = clamp(n, 0, 1);
        if (root.scale == ValueScale.logarithmic && root.minimum > 0 && root.maximum > 0) {
            return root.minimum * pow(root.maximum / root.minimum, position);
        }
        return root.minimum + position * (root.maximum - root.minimum);
    }

    function set-normalized(n: float) {
        if (root.modulation-active) {
            root.set-modulation-depth(root.modulation-depth + n - root.normalized);
            return;
        }
        let raw = root.value-at(n);
        let quantized = root.step > 0
            ? root.minimum + round((raw - root.minimum) / root.step) * root.step
            : raw;
        let next = clamp(quantized, root.minimum, root.maximum);
        if (next != root.value) {
            root.value = next;
            root.changed(next);
        }
    }

    function set-modulation-depth(depth: float) {
        let next = clamp(depth, -1, 1);
        if (next != root.modulation-depth) {
            root.modulation-depth = next;
            root.modulation-edited = true;
            root.modulation-depth-changed(next);
        }
    }

    KnobFace {
        diameter: root.diameter;
        normalized: root.normalized;
        bipolar: root.bipolar;
        enabled: root.enabled;
        fill: root.fill;
        modulation-armed: root.modulation-active;
        modulation-depth: root.modulation-depth;
        modulation-offset: root.modulation-offset;
        modulation-route-count: root.modulation-route-count;
        focused: mini-keyboard.has-focus;
        hovered: mini-touch.has-hover;

        mini-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.modulation-active ? crosshair : ns-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    mini-keyboard.focus();
                    root.pressed-normalized = root.normalized;
                    root.pressed-modulation-depth = root.modulation-depth;
                    root.modulation-edited = false;
                    root.fine-drag = e.modifiers.control || e.modifiers.shift;
                    if (root.modulation-active) { root.modulation-edit-started(); }
                    else { root.edit-started(); }
                } else if (e.kind == PointerEventKind.move && self.pressed) {
                    if (root.modulation-active) {
                        root.set-modulation-depth(root.pressed-modulation-depth
                            + (self.pressed-y - self.mouse-y) / (root.fine-drag ? 5000px : 150px));
                    } else {
                        root.set-normalized(root.pressed-normalized
                            + (self.pressed-y - self.mouse-y) / (root.fine-drag ? 5000px : 150px));
                    }
                } else if (e.kind == PointerEventKind.up) {
                    if (root.modulation-active) {
                        if (root.modulation-edited) { root.modulation-edit-finished(); }
                    } else {
                        root.edit-finished();
                    }
                }
            }
            double-clicked => {
                if (root.modulation-active) {
                    root.modulation-edit-started();
                    root.modulation-edited = false;
                    root.set-modulation-depth(0);
                    if (root.modulation-edited) { root.modulation-edit-finished(); }
                } else {
                    root.edit-started();
                    root.value = clamp(root.default-value, root.minimum, root.maximum);
                    root.changed(root.value);
                    root.edit-finished();
                }
            }
            scroll-event(e) => {
                if (root.modulation-active) { root.modulation-edit-started(); root.modulation-edited = false; }
                else { root.edit-started(); }
                root.set-normalized(root.normalized
                    - e.delta-y / ((e.modifiers.control || e.modifiers.shift) ? 5000px : 600px));
                if (root.modulation-active) {
                    if (root.modulation-edited) { root.modulation-edit-finished(); }
                } else {
                    root.edit-finished();
                }
                accept
            }
        }
    }

    mini-keyboard := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                if (root.modulation-active) { root.modulation-edit-started(); root.modulation-edited = false; }
                else { root.edit-started(); }
                root.set-normalized(root.normalized
                    + ((e.modifiers.control || e.modifiers.shift) ? 0.0002 : 0.01));
                if (root.modulation-active) {
                    if (root.modulation-edited) { root.modulation-edit-finished(); }
                } else {
                    root.edit-finished();
                }
                accept
            } else if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                if (root.modulation-active) { root.modulation-edit-started(); root.modulation-edited = false; }
                else { root.edit-started(); }
                root.set-normalized(root.normalized
                    - ((e.modifiers.control || e.modifiers.shift) ? 0.0002 : 0.01));
                if (root.modulation-active) {
                    if (root.modulation-edited) { root.modulation-edit-finished(); }
                } else {
                    root.edit-finished();
                }
                accept
            } else { reject }
        }
    }

    Tooltip { text: @markdown("\{root.value-text}"); }
}

// Trim/gain knob in dB from unity. Every gain-stage trim in a device frame —
// effect input, effect output, source output, channel volume — is one of
// these, so gain always reads and drags the same way: linear in dB (the dB
// domain is already perceptually logarithmic), unity at double-click, and a
// value readout that says "+3.0 dB" rather than a percentage of a ratio.
// `value` is dB; the caller converts to linear gain at its boundary.
export component TrimKnob inherits MiniKnob {
    minimum: -60;
    maximum: 12;
    default-value: 0;
    value-text: GainMath.format-db(root.value);
}

// Small round status light. Not interactive - use it for activity, sync, and
// record-armed state.
export component LedIndicator inherits Rectangle {
    in property <bool> on;
    in property <color> led-color: Theme.accent;
    in property <length> diameter: 8px;
    in property <string> tooltip;

    width: root.diameter;
    height: root.diameter;
    border-radius: self.width / 2;
    background: root.on ? root.led-color : root.led-color.with-alpha(0.16);
    border-width: 1px;
    border-color: root.on ? root.led-color.brighter(0.4) : Theme.border;

    if root.tooltip != "" : Tooltip { text: @markdown("\{root.tooltip}"); }
}

// Square glyph button, for toolbar affordances that carry a symbol rather
// than a word.
// The shared musical grid, spelled once. Every control that carries a
// `ModTimeDivision` index -- the modulator rack's sync knobs, the step
// sequencer's rate, the ML-P8's own LFO -- reads its names from here, so
// none of them gets to invent a second spelling.
export global Divisions {
    public pure function label(index: int) -> string {
        return index == 0 ? "4/1" : index == 1 ? "2/1" : index == 2 ? "1/1"
            : index == 3 ? "1/2D" : index == 4 ? "1/2" : index == 5 ? "1/2T"
            : index == 6 ? "1/4D" : index == 7 ? "1/4" : index == 8 ? "1/4T"
            : index == 9 ? "1/8D" : index == 10 ? "1/8" : index == 11 ? "1/8T"
            : index == 12 ? "1/16D" : index == 13 ? "1/16" : index == 14 ? "1/16T"
            : index == 15 ? "1/32D" : index == 16 ? "1/32" : index == 17 ? "1/32T"
            : index == 18 ? "1/64D" : index == 19 ? "1/64" : "1/64T";
    }
}

// A continuously draggable knob becomes a stepped musical-division knob when
// its adjacent LED is lit. The tiny clickable lamp is intentionally the
// "O." gesture: timing mode stays visible without spending a selector row on
// every sync-capable control.
export component SyncMiniKnob inherits Rectangle {
    in property <string> label;
    in property <string> free-value-text;
    in property <float> free-value;
    in property <float> free-minimum;
    in property <float> free-maximum;
    in property <float> free-default;
    in property <ValueScale> free-scale: ValueScale.linear;
    in property <bool> synced;
    in property <int> division: 7;
    callback free-changed(float);
    callback sync-changed(bool);
    callback division-changed(int);
    callback edit-started();
    callback edit-finished();

    width: 46px;
    height: 51px;


    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 9px;
        text: root.label;
        color: Theme.text-muted;
        font-size: 7px;
        horizontal-alignment: center;
    }
    MiniKnob {
        x: 9px;
        y: 10px;
        diameter: 22px;
        label: root.label;
        value: root.synced ? root.division * 1.0 : root.free-value;
        minimum: root.synced ? 0 : root.free-minimum;
        maximum: root.synced ? 20 : root.free-maximum;
        default-value: root.synced ? 7 : root.free-default;
        step: root.synced ? 1 : 0;
        scale: root.synced ? ValueScale.linear : root.free-scale;
        value-text: root.synced ? Divisions.label(root.division) : root.free-value-text;
        changed(value) => {
            if (root.synced) {
                root.division-changed(round(value));
            } else {
                root.free-changed(value);
            }
        }
        edit-started => { root.edit-started(); }
        edit-finished => { root.edit-finished(); }
    }
    sync-light := Rectangle {
        x: 33px;
        y: 17px;
        width: 11px;
        height: 11px;
        accessible-role: button;
        accessible-label: "Tempo sync " + root.label;
        LedIndicator {
            x: 1px;
            y: 1px;
            diameter: 9px;
            on: root.synced;
            tooltip: root.synced ? "Tempo sync on" : "Tempo sync off";
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.sync-changed(!root.synced); }
        }
    }
    Text {
        x: 0px;
        y: 35px;
        width: parent.width;
        height: 12px;
        text: root.synced ? Divisions.label(root.division) : root.free-value-text;
        color: root.synced ? Theme.focus : Theme.accent;
        font-size: 7px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// A knob with its name above it and an editable value below it.
//
// The two knobs that already exist each give up one of those. `ParameterKnob`
// stacks a label and a value around the dial, but the value is read-only;
// `KnobField` makes the value typed into, but lays the three parts out in a
// *row*, which is 130px wide once the dial is big enough to read. A device
// page that wants four legible knobs across a quarter of a face needs both:
// stacked, and typed into.
//
// The dial is a real `ParameterKnob` with its own captions turned off, so the
// drag, wheel, double-click-to-default, keyboard and modulation-arming
// contract is the one every other knob in the program has rather than a
// second implementation of it.
export component KnobStack inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    /// What the field shows when it is not being edited. The caller formats
    /// it, so units and precision stay where the rest of that parameter's
    /// formatting lives.
    in property <string> display-text;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> default-value: root.minimum;
    in property <float> step: 0;
    in property <ValueScale> scale: ValueScale.linear;
    in property <bool> bipolar;
    in property <length> diameter: 34px;
    in property <bool> modulation-armed;
    in property <bool> modulation-allowed: true;
    in-out property <float> modulation-depth;
    in property <float> modulation-offset;
    in property <int> modulation-route-count;
    /// A timing control that can be free-running or tempo-locked shows a
    /// clickable LED beside its caption. The dial itself does not change: the
    /// caller hands over whichever value, range and text the current mode
    /// means, exactly as `SyncMiniKnob` does internally. This is the shared
    /// `O.` affordance from `MODULATOR_SYSTEM_SPEC.md`, at a size the rest of
    /// a device page can sit next to.
    in property <bool> show-sync;
    in property <bool> synced;
    callback sync-toggled(bool);
    callback changed(float);
    /// The typed string, unparsed. Rust owns the parsing because it owns the
    /// formatting, exactly as for `KnobField`.
    callback text-committed(string);
    callback modulation-depth-changed(float);
    callback modulation-edit-started();
    callback modulation-edit-finished();

    width: 50px;
    height: 11px + root.diameter + 20px + 4px;

    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            height: 11px;
            spacing: 2px;
            alignment: center;
            Text {
                text: root.label;
                color: root.modulation-armed && root.modulation-allowed
                    ? Theme.warning : Theme.text-muted;
                font-size: 9px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.show-sync : Rectangle {
                width: 9px;
                height: 11px;
                accessible-role: button;
                accessible-label: "Tempo sync " + root.label;
                LedIndicator {
                    y: 2px;
                    diameter: 8px;
                    on: root.synced;
                    tooltip: root.synced ? "Tempo sync on" : "Tempo sync off";
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.sync-toggled(!root.synced); }
                }
            }
        }
        ParameterKnob {
            height: root.diameter;
            show-label: false;
            show-value-text: false;
            diameter: root.diameter;
            tooltip: root.tooltip;
            value <=> root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            default-value: root.default-value;
            step: root.step;
            scale: root.scale;
            bipolar: root.bipolar;
            modulation-armed: root.modulation-armed;
            modulation-allowed: root.modulation-allowed;
            modulation-depth <=> root.modulation-depth;
            modulation-offset: root.modulation-offset;
            modulation-route-count: root.modulation-route-count;
            changed(v) => { root.changed(v); }
            modulation-depth-changed(v) => { root.modulation-depth-changed(v); }
            modulation-edit-started => { root.modulation-edit-started(); }
            modulation-edit-finished => { root.modulation-edit-finished(); }
        }
        Rectangle {
            height: 18px;
            border-radius: Theme.radius-md;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: stacked-entry.has-focus ? Theme.accent : Theme.border;
            accessible-role: text-input;
            accessible-label: root.tooltip;
            stacked-entry := TextInput {
                x: 3px;
                width: parent.width - 6px;
                height: 100%;
                text: root.display-text;
                color: Theme.text;
                font-size: 9px;
                font-family: "monospace";
                single-line: true;
                horizontal-alignment: center;
                vertical-alignment: center;
                selection-background-color: Theme.accent;
                accepted => {
                    root.text-committed(self.text);
                    self.clear-focus();
                }
                edited => { }
            }
        }
    }
}

export component IconButton inherits ToolButton {
    in property <length> size: 26px;
    min-width: root.size;
    max-width: root.size;
    min-height: root.size;
    max-height: root.size;
}

// Transport button. `role` tints the active state: play goes green, record
// goes red, everything else uses the theme accent.
export component TransportButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip: root.text;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <string> role: "default";
    callback clicked;

    private property <color> role-color: root.role == "record" ? Theme.destructive
        : root.role == "play" ? Theme.meter-safe : Theme.accent;

    min-width: 34px;
    min-height: 26px;
    border-radius: Theme.radius-md;
    border-width: transport-touch.has-hover && root.enabled ? 1px : 0px;
    border-color: root.role-color;
    background: !root.enabled
        ? Theme.surface
        : transport-touch.pressed
            ? Theme.surface-active
            : root.active ? root.role-color.with-alpha(0.28) : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.tooltip;

    Text {
        text: root.text;
        color: !root.enabled ? Theme.text-faint : root.active ? root.role-color : Theme.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    transport-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// Solo, sized and shaped to sit next to MuteButton in a rack row.
export component SoloButton inherits ToolButton {
    in property <bool> soloed;
    text: "S";
    tooltip: "Solo";
    active: root.soloed;
    active-color: #78500a;
    text-color: root.soloed ? #fde68a : Theme.text-faint;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
}

// Mixer-style fader with a real cap and travel ticks, for channel strips.
// ParameterFader stays the right choice for inline parameter rows; this is
// the one that should look like a console.
//
// `value` is always the stored linear gain, but with `db-taper` the *travel*
// is linear in dB per the gain contract (docs/plans/archive/gain-structure/): unity
// at three-quarter throw, +6 dB at the top, the drag stays relative in
// position units so the throw feels even in dB. Travel ticks land on the
// taper's breakpoints instead of even spacing.
export component MixerFader inherits Rectangle {
    in property <string> tooltip: "Level";
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> db-taper: true;
    in property <float> default-value: 1.0;
    in property <float> step: 0;
    in property <bool> enabled: true;
    in property <string> value-text;
    in property <color> fill: Theme.accent;
    callback changed(float);

    private property <float> normalized: root.maximum <= root.minimum
        ? 0 : root.db-taper
            ? clamp(GainMath.fader-db-to-position(GainMath.linear-to-db(root.value)), 0, 1)
            : clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);
    private property <[float]> tick-positions: root.db-taper
        ? [1.0, 0.75, 0.5, 0.3, 0.15, 0.0]
        : [1.0, 0.75, 0.5, 0.25, 0.0];
    private property <float> pressed-normalized;
    private property <bool> fine-drag;
    private property <length> cap-height: 16px;

    width: 30px;
    min-height: 100px;
    accessible-role: slider;
    accessible-label: root.tooltip;
    accessible-value: root.value-text;
    forward-focus: mixer-keyboard;

    function set-normalized(n: float) {
        if (root.db-taper) {
            let db = GainMath.fader-position-to-db(clamp(n, 0, 1));
            let next = clamp(GainMath.db-to-linear(db), root.minimum, root.maximum);
            if (next != root.value) {
                root.value = next;
                root.changed(next);
            }
            return;
        }
        let raw = root.minimum + clamp(n, 0, 1) * (root.maximum - root.minimum);
        let quantized = root.step > 0
            ? root.minimum + round((raw - root.minimum) / root.step) * root.step
            : raw;
        let next = clamp(quantized, root.minimum, root.maximum);
        if (next != root.value) {
            root.value = next;
            root.changed(next);
        }
    }

    travel := Rectangle {
        width: 100%;
        height: 100%;

        // Travel ticks: the taper's own breakpoints down the left, so throw
        // is readable without a scale.
        for tick[i] in root.tick-positions : Rectangle {
            x: 2px;
            y: (parent.height - root.cap-height) * (1 - tick) + root.cap-height / 2;
            width: i == 0 || i == root.tick-positions.length - 1 ? 6px : 4px;
            height: 1px;
            background: Theme.text-faint;
        }

        // Slot.
        Rectangle {
            x: (parent.width - 4px) / 2 + 4px;
            y: root.cap-height / 2;
            width: 4px;
            height: parent.height - root.cap-height;
            border-radius: Theme.radius-sm;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.border;
        }

        // Filled travel below the cap.
        Rectangle {
            x: (parent.width - 4px) / 2 + 4px;
            y: root.cap-height / 2 + (parent.height - root.cap-height) * (1 - root.normalized);
            width: 4px;
            height: (parent.height - root.cap-height) * root.normalized;
            border-radius: Theme.radius-sm;
            background: root.enabled ? root.fill : Theme.text-faint;
        }

        // Cap.
        Rectangle {
            x: (parent.width - 18px) / 2 + 4px;
            y: (parent.height - root.cap-height) * (1 - root.normalized);
            width: 18px;
            height: root.cap-height;
            border-radius: Theme.radius-sm;
            background: mixer-touch.pressed ? Theme.surface-active : Theme.surface-raised;
            border-width: mixer-keyboard.has-focus || mixer-touch.has-hover ? 2px : 1px;
            border-color: mixer-keyboard.has-focus ? Theme.focus : Theme.border;
            // Grip line on the cap marks the exact value position.
            Rectangle {
                y: (parent.height - 2px) / 2;
                width: parent.width - 6px;
                x: 3px;
                height: 2px;
                background: root.enabled ? root.fill : Theme.text-faint;
            }
        }

        mixer-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: ns-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    mixer-keyboard.focus();
                    root.pressed-normalized = root.normalized;
                    root.fine-drag = e.modifiers.control || e.modifiers.shift;
                } else if (e.kind == PointerEventKind.move && self.pressed) {
                    // Always relative: grabbing a cap should never jump the
                    // level, which is the one thing a mixer fader must not do.
                    root.set-normalized(root.pressed-normalized
                        + (self.pressed-y - self.mouse-y) / (root.fine-drag ? 4000px : (parent.height - root.cap-height)));
                }
            }
            double-clicked => {
                root.value = clamp(root.default-value, root.minimum, root.maximum);
                root.changed(root.value);
            }
            scroll-event(e) => {
                root.set-normalized(root.normalized
                    - e.delta-y / ((e.modifiers.control || e.modifiers.shift) ? 5000px : 600px));
                accept
            }
        }
    }

    mixer-keyboard := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                root.set-normalized(root.normalized
                    + ((e.modifiers.control || e.modifiers.shift) ? 0.0002 : 0.01)); accept
            } else if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                root.set-normalized(root.normalized
                    - ((e.modifiers.control || e.modifiers.shift) ? 0.0002 : 0.01)); accept
            } else { reject }
        }
    }

    Tooltip { text: @markdown("\{root.value-text}"); }
}

// Scrollbar with integrated zoom grips, the Ableton/Bitwig idiom that
// replaces separate zoom-in/zoom-out buttons. Callers work entirely in
// normalized [0, 1] terms; the widget does its own pixel math against
// whatever length the caller gives it.
//
// Only ONE `TouchArea` covers the whole track (see the drag feedback-loop
// pitfall documented on `MixerFader`): the thumb never moves as a *direct*
// result of being under the pointer during a drag, so `mouse-x`/`mouse-y`
// stay a stable coordinate system for its duration. Which zone was grabbed
// (left grip / body / right grip) is decided once at press time and latched
// in `drag-zone`.
export component ZoomScrollBar inherits Rectangle {
    in property <bool> vertical: false;
    in property <float> offset: 0;
    in property <float> visible-fraction: 1;
    in property <bool> enabled: true;
    out property <bool> hovered: track.has-hover;
    callback scrolled(float);
    callback zoomed(float, float);

    private property <length> grip-size: 6px;
    private property <length> min-thumb-length: 18px;
    private property <string> drag-zone: "";
    private property <float> press-offset;
    private property <float> press-visible-fraction;
    private property <length> press-pos;

    private property <length> track-length: root.vertical ? self.height : self.width;
    private property <float> min-fraction: root.track-length > 0px
        ? min(1, root.min-thumb-length / root.track-length) : 0;
    private property <float> clamped-visible: clamp(root.visible-fraction, root.min-fraction, 1);
    private property <length> thumb-length: max(root.track-length * root.clamped-visible, root.min-thumb-length);
    private property <length> thumb-start: clamp(
        root.track-length * clamp(root.offset, 0, 1), 0px, max(0px, root.track-length - root.thumb-length));
    private property <string> hover-zone: track.has-hover
        ? root.zone-at(root.vertical ? track.mouse-y : track.mouse-x) : "";
    private property <string> active-zone: track.pressed ? root.drag-zone : root.hover-zone;

    min-width: root.vertical ? 14px : 64px;
    min-height: root.vertical ? 64px : 14px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;

    pure function zone-at(pos: length) -> string {
        if (pos < root.thumb-start || pos > root.thumb-start + root.thumb-length) {
            return "jump";
        }
        if (pos < root.thumb-start + root.grip-size) {
            return "left";
        }
        if (pos > root.thumb-start + root.thumb-length - root.grip-size) {
            return "right";
        }
        return "body";
    }

    thumb := Rectangle {
        x: root.vertical ? 0px : root.thumb-start;
        y: root.vertical ? root.thumb-start : 0px;
        width: root.vertical ? parent.width : root.thumb-length;
        height: root.vertical ? root.thumb-length : parent.height;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: (root.active-zone == "left" || root.active-zone == "right" || root.active-zone == "body")
            ? Theme.text-faint : Theme.border;
        background: !root.enabled
            ? Theme.surface-raised
            : root.active-zone == "body" && track.pressed
                ? Theme.surface-active
                : Theme.surface-raised;

        // Grip marks on the two resizable ends, so they read as grabbable
        // rather than as decoration on a plain thumb.
        Rectangle {
            x: root.vertical ? 2px : 3px;
            y: root.vertical ? 3px : 2px;
            width: root.vertical ? parent.width - 4px : 2px;
            height: root.vertical ? 2px : parent.height - 4px;
            border-radius: Theme.radius-xs;
            background: root.enabled
                ? (root.active-zone == "left" ? Theme.focus : Theme.text-faint) : Theme.text-faint;
        }
        Rectangle {
            x: root.vertical ? 2px : parent.width - 5px;
            y: root.vertical ? parent.height - 5px : 2px;
            width: root.vertical ? parent.width - 4px : 2px;
            height: root.vertical ? 2px : parent.height - 4px;
            border-radius: Theme.radius-xs;
            background: root.enabled
                ? (root.active-zone == "right" ? Theme.focus : Theme.text-faint) : Theme.text-faint;
        }
    }

    track := TouchArea {
        enabled: root.enabled;
        mouse-cursor: !root.enabled
            ? default
            : (root.active-zone == "left" || root.active-zone == "right")
                ? (root.vertical ? ns-resize : ew-resize)
                : pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                let pos = root.vertical ? self.mouse-y : self.mouse-x;
                root.drag-zone = root.zone-at(pos);
                root.press-offset = root.offset;
                root.press-visible-fraction = root.visible-fraction;
                root.press-pos = pos;
                if (root.drag-zone == "jump") {
                    // Clicking outside the thumb pages it so the click point
                    // becomes its centre, then continues as a body drag.
                    let target-start = pos - root.thumb-length / 2;
                    let next = clamp(target-start / root.track-length, 0, max(0, 1 - root.visible-fraction));
                    root.scrolled(next);
                    root.press-offset = next;
                    root.drag-zone = "body";
                }
            } else if (e.kind == PointerEventKind.move && self.pressed) {
                let pos = root.vertical ? self.mouse-y : self.mouse-x;
                let delta = (pos - root.press-pos) / root.track-length;
                if (root.drag-zone == "body") {
                    root.scrolled(clamp(root.press-offset + delta, 0, max(0, 1 - root.clamped-visible)));
                } else if (root.drag-zone == "left") {
                    let fixed-end = root.press-offset + root.press-visible-fraction;
                    let next-start = clamp(root.press-offset + delta, 0, fixed-end - root.min-fraction);
                    root.zoomed(next-start, fixed-end - next-start);
                } else if (root.drag-zone == "right") {
                    let next-end = clamp(root.press-offset + root.press-visible-fraction + delta,
                        root.press-offset + root.min-fraction, 1);
                    root.zoomed(root.press-offset, next-end - root.press-offset);
                }
            } else if (e.kind == PointerEventKind.up) {
                root.drag-zone = "";
            }
        }
    }
}
