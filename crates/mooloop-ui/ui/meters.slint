import { Theme } from "theme.slint";
import { GainMath } from "gain.slint";
import { AudioOrientation } from "controls.slint";

// Metering family.
//
// All of these take dBFS directly and share one scale convention: `minimum-db`
// at the bottom, 0 dBFS at the top, linear in dB. Ballistics (attack, decay,
// peak hold, clip latch) belong to the audio side in `meter.rs`; these
// components only draw what they are handed.

// The meter ballistics a user can tune.
//
// `falloff` is an index into the row Preferences > Appearance shows, and that
// is deliberately all it is: the rates in dB per second live in `meter.rs`,
// which is the thing that runs them, and Rust persists the choice by name.
// This global exists for the same reason `Motion` does -- the preference page
// writes straight into it, so the change is live before Apply, and Rust reads
// it back when the time comes to save.
//
// The markup never needs the number. Ballistics run on the audio side and
// these components only draw what they are handed, which is the rule stated
// at the top of this file and the reason a dB/s does not appear in it.
export global MeterPrefs {
    // 0=Fast, 1=Standard (IEC), 2=Slow, 3=Slowest
    in-out property <int> falloff: 1;
}

// Shared dB -> 0..1 mapping, exposed so a scale and its meter cannot drift.
export global MeterScaleMath {
    public pure function normalize(db: float, minimum-db: float) -> float {
        return clamp((db - minimum-db) / (0 - minimum-db), 0, 1);
    }
}

// Tick marks with dB labels, to sit alongside a meter.
export component MeterScale inherits Rectangle {
    in property <float> minimum-db: GainMath.min-db;
    in property <[float]> ticks: [0, -6, -12, -18, -24, -36, -48];
    in property <AudioOrientation> orientation: AudioOrientation.vertical;
    in property <bool> show-labels: true;

    min-width: root.orientation == AudioOrientation.vertical ? (root.show-labels ? 22px : 5px) : 40px;
    min-height: root.orientation == AudioOrientation.vertical ? 40px : (root.show-labels ? 14px : 5px);

    if root.orientation == AudioOrientation.vertical : Rectangle {
        for db in root.ticks : Rectangle {
            y: parent.height * (1 - MeterScaleMath.normalize(db, root.minimum-db));
            width: parent.width;
            height: 1px;
            Rectangle {
                // Pinned to the left edge. Sized on one axis and unplaced on
                // the other, this was centred across the scale's full width
                // and landed on the label -- which starts at 6px precisely to
                // clear a 4px tick sitting here. The stroke crossed the
                // digits, so `-12` read as `+2` and `-18` as `+8`.
                x: 0px;
                width: 4px;
                height: 1px;
                background: Theme.text-faint;
            }
            if root.show-labels : Text {
                x: 6px;
                y: -5px;
                text: db == 0 ? "0" : db;
                color: Theme.text-faint;
                font-size: 8px;
            }
        }
    }

    if root.orientation == AudioOrientation.horizontal : Rectangle {
        for db in root.ticks : Rectangle {
            x: parent.width * MeterScaleMath.normalize(db, root.minimum-db);
            width: 1px;
            height: parent.height;
            Rectangle {
                // Pinned to the top, for the reason the vertical branch is
                // pinned to the left: centred down the scale's full height it
                // struck through the label below it, which sits at 5px to
                // clear exactly this.
                y: 0px;
                width: 1px;
                height: 4px;
                background: Theme.text-faint;
            }
            if root.show-labels : Text {
                x: -8px;
                y: 5px;
                text: db == 0 ? "0" : db;
                color: Theme.text-faint;
                font-size: 8px;
                width: 16px;
                horizontal-alignment: center;
            }
        }
    }
}

// The colour zones of the scale, drawn at full height and one alpha.
//
// **Position, never level.** A zone is red because it is the top of the range,
// not because the signal reached it -- which is the convention the LED form
// has had since it was written, and the one thing a continuous bar can lose
// by accident: stretch a single three-stop gradient to the lit height and the
// whole bar turns red the moment it hits 0 dB. Drawing the zones full height
// and showing a window onto them is what keeps a colour attached to a dB.
component MeterZones inherits Rectangle {
    in property <float> minimum-db;
    in property <float> warning-db;
    in property <float> hot-db;
    in property <float> zone-alpha: 1.0;
    in property <AudioOrientation> orientation: AudioOrientation.vertical;

    private property <float> warn-n: MeterScaleMath.normalize(root.warning-db, root.minimum-db);
    private property <float> hot-n: MeterScaleMath.normalize(root.hot-db, root.minimum-db);

    if root.orientation == AudioOrientation.vertical : Rectangle {
        Rectangle {
            y: parent.height * (1 - root.warn-n);
            width: parent.width;
            height: parent.height * root.warn-n;
            background: Theme.meter-safe.with-alpha(root.zone-alpha);
        }
        Rectangle {
            y: parent.height * (1 - root.hot-n);
            width: parent.width;
            height: parent.height * (root.hot-n - root.warn-n);
            background: Theme.meter-warning.with-alpha(root.zone-alpha);
        }
        Rectangle {
            y: 0px;
            width: parent.width;
            height: parent.height * (1 - root.hot-n);
            background: Theme.meter-clip.with-alpha(root.zone-alpha);
        }
    }
    if root.orientation == AudioOrientation.horizontal : Rectangle {
        Rectangle {
            x: 0px;
            width: parent.width * root.warn-n;
            height: parent.height;
            background: Theme.meter-safe.with-alpha(root.zone-alpha);
        }
        Rectangle {
            x: parent.width * root.warn-n;
            width: parent.width * (root.hot-n - root.warn-n);
            height: parent.height;
            background: Theme.meter-warning.with-alpha(root.zone-alpha);
        }
        Rectangle {
            x: parent.width * root.hot-n;
            width: parent.width * (1 - root.hot-n);
            height: parent.height;
            background: Theme.meter-clip.with-alpha(root.zone-alpha);
        }
    }
}

// Peak meter, continuous by default and LED-segmented on request.
//
// **`segments: 0` means one unbroken bar, and that is what every meter in the
// application asks for.** The LED form is what this drew everywhere until
// 2026-09-15; at the sizes a mixer strip actually has, a dozen-odd lozenges
// quantise the reading to about 4 dB a step and the gaps eat a third of the
// column. Raising the count does not fix it on its own either -- the 1px gap
// between segments does not scale, so past about thirty the segments compute
// a negative height and the meter goes blank. Continuous or coarse are the
// two things this can honestly be, which is why the option is a count and
// zero, rather than a count anyone is invited to tune.
//
// The segmented path is kept because it is the readable one at very large
// sizes and because `mockup-catalog.slint` still draws it, not because
// anything in the mixer does.
export component SegmentedMeter inherits Rectangle {
    in property <float> level-db: GainMath.min-db;
    in property <float> held-db: GainMath.min-db;
    in property <float> minimum-db: GainMath.min-db;
    in property <float> warning-db: GainMath.meter-warning-db;
    in property <float> hot-db: GainMath.meter-hot-db;
    /// Zero -- the default -- draws one continuous bar. A positive count
    /// draws that many LED lozenges. See the note above the component.
    in property <int> segments: 0;
    in property <AudioOrientation> orientation: AudioOrientation.vertical;

    private property <float> level-normalized: MeterScaleMath.normalize(root.level-db, root.minimum-db);
    private property <float> held-normalized: MeterScaleMath.normalize(root.held-db, root.minimum-db);
    // Index of the segment carrying the peak-hold marker, or -1 when idle.
    private property <int> held-index: root.held-db <= root.minimum-db
        ? -1 : min(root.segments - 1, floor(root.held-normalized * root.segments));

    min-width: root.orientation == AudioOrientation.vertical ? 9px : 60px;
    min-height: root.orientation == AudioOrientation.vertical ? 60px : 9px;
    background: Theme.background;
    border-radius: Theme.radius-sm;
    clip: true;

    // Colour for the segment at index i, by its own position on the scale.
    pure function segment-color(i: int) -> color {
        let db = root.minimum-db + (i + 0.5) / root.segments * (0 - root.minimum-db);
        return db >= root.hot-db ? Theme.meter-clip
            : db >= root.warning-db ? Theme.meter-warning : Theme.meter-safe;
    }
    pure function segment-lit(i: int) -> bool {
        return root.level-normalized * root.segments > i;
    }

    // The continuous bar: the zones at rest, a window onto the zones at full
    // strength for the part that is lit, and a hairline for the peak hold --
    // which is the segmented form's "held segment stays bright" with nothing
    // left to round it to.
    if root.segments <= 0 && root.orientation == AudioOrientation.vertical : column := Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;

        MeterZones {
            width: 100%;
            height: 100%;
            zone-alpha: 0.13;
            minimum-db: root.minimum-db;
            warning-db: root.warning-db;
            hot-db: root.hot-db;
        }
        Rectangle {
            y: column.height * (1 - root.level-normalized);
            width: column.width;
            height: column.height * root.level-normalized;
            clip: true;
            MeterZones {
                // Pushed back up by exactly what the window came down, so the
                // zones sit at their own dB positions rather than at the top
                // of whatever the window happens to be.
                y: -column.height * (1 - root.level-normalized);
                width: column.width;
                height: column.height;
                minimum-db: root.minimum-db;
                warning-db: root.warning-db;
                hot-db: root.hot-db;
            }
        }
        if root.held-db > root.minimum-db : Rectangle {
            y: min(column.height - 1px,
                column.height * (1 - root.held-normalized));
            width: column.width;
            height: 1px;
            background: Theme.text;
        }
    }

    if root.segments <= 0 && root.orientation == AudioOrientation.horizontal : row := Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;

        MeterZones {
            width: 100%;
            height: 100%;
            zone-alpha: 0.13;
            orientation: AudioOrientation.horizontal;
            minimum-db: root.minimum-db;
            warning-db: root.warning-db;
            hot-db: root.hot-db;
        }
        Rectangle {
            x: 0px;
            width: row.width * root.level-normalized;
            height: row.height;
            clip: true;
            MeterZones {
                x: 0px;
                width: row.width;
                height: row.height;
                orientation: AudioOrientation.horizontal;
                minimum-db: root.minimum-db;
                warning-db: root.warning-db;
                hot-db: root.hot-db;
            }
        }
        if root.held-db > root.minimum-db : Rectangle {
            x: min(row.width - 1px, row.width * root.held-normalized);
            width: 1px;
            height: row.height;
            background: Theme.text;
        }
    }

    if root.segments > 0 && root.orientation == AudioOrientation.vertical : Rectangle {
        for i in root.segments : Rectangle {
            property <bool> lit: root.segment-lit(i);
            property <bool> peak: i == root.held-index;
            x: 1px;
            y: parent.height * (1 - (i + 1) / root.segments) + 1px;
            width: parent.width - 2px;
            height: parent.height / root.segments - 1px;
            border-radius: Theme.radius-xs;
            background: self.lit || self.peak
                ? root.segment-color(i)
                : root.segment-color(i).with-alpha(0.13);
            // The held segment stays bright even as the level falls away.
            opacity: self.peak && !self.lit ? 0.85 : 1.0;
        }
    }

    if root.segments > 0 && root.orientation == AudioOrientation.horizontal : Rectangle {
        for i in root.segments : Rectangle {
            property <bool> lit: root.segment-lit(i);
            property <bool> peak: i == root.held-index;
            x: parent.width * i / root.segments + 1px;
            y: 1px;
            width: parent.width / root.segments - 1px;
            height: parent.height - 2px;
            border-radius: Theme.radius-xs;
            background: self.lit || self.peak
                ? root.segment-color(i)
                : root.segment-color(i).with-alpha(0.13);
            opacity: self.peak && !self.lit ? 0.85 : 1.0;
        }
    }
}

// Latching clip light. Clicking it clears the latch, which is the behaviour
// every engineer already expects from a clip indicator.
export component ClipIndicator inherits Rectangle {
    in property <bool> clipping;
    callback reset();

    width: 9px;
    height: 9px;
    border-radius: Theme.radius-sm;
    background: root.clipping ? Theme.meter-clip : Theme.meter-clip.with-alpha(0.15);
    accessible-role: button;
    accessible-label: "Clip indicator";

    TouchArea {
        mouse-cursor: root.clipping ? pointer : default;
        clicked => { root.reset(); }
    }
    Tooltip { text: @markdown("Clipped. Click to clear."); }
}

// Narrow stereo meter for a channel strip: two segment columns, a shared clip
// light, and no scale. Sized to sit beside a fader.
export component ChannelMeter inherits Rectangle {
    in property <float> left-db: GainMath.min-db;
    in property <float> right-db: GainMath.min-db;
    in property <float> held-left-db: GainMath.min-db;
    in property <float> held-right-db: GainMath.min-db;
    in property <bool> clipping;
    /// Passed through to `SegmentedMeter`; zero is one continuous bar.
    in property <int> segments: 0;
    /// Whether to draw the clip lamp at all.
    ///
    /// **A meter whose owner has no clip state must turn this off.** The lamp
    /// is drawn from `clipping` and cleared by `clip-reset`, so a caller that
    /// binds neither gets two faint red bars that cannot light and do nothing
    /// when clicked -- the "convincing but inert control" the device rack's
    /// own rule names. The rack's IN and OUT rails were exactly that until
    /// 2026-09-14: they meter a chain, and a chain has no clip latch.
    in property <bool> show-clip: true;
    callback clip-reset();

    width: 22px;
    min-height: 70px;

    VerticalLayout {
        spacing: 2px;
        if root.show-clip : ClipIndicator {
            width: 22px;
            height: 5px;
            clipping: root.clipping;
            reset => { root.clip-reset(); }
        }
        HorizontalLayout {
            spacing: 2px;
            vertical-stretch: 1;
            SegmentedMeter {
                width: 10px;
                segments: root.segments;
                level-db: root.left-db;
                held-db: root.held-left-db;
            }
            SegmentedMeter {
                width: 10px;
                segments: root.segments;
                level-db: root.right-db;
                held-db: root.held-right-db;
            }
        }
    }
}

// Master meter: stereo segments with a labelled scale between them and a
// numeric peak readout, for the transport bar or a master strip.
export component MasterMeter inherits Rectangle {
    in property <float> left-db: GainMath.min-db;
    in property <float> right-db: GainMath.min-db;
    in property <float> held-left-db: GainMath.min-db;
    in property <float> held-right-db: GainMath.min-db;
    in property <bool> left-clipping;
    in property <bool> right-clipping;
    in property <float> minimum-db: GainMath.min-db;
    /// Passed through to `SegmentedMeter`; zero is one continuous bar.
    in property <int> segments: 0;
    in property <AudioOrientation> orientation: AudioOrientation.horizontal;
    in property <bool> show-readout: true;
    callback clip-reset();

    private property <float> peak-db: max(root.held-left-db, root.held-right-db);

    min-width: root.orientation == AudioOrientation.horizontal ? 150px : 54px;
    min-height: root.orientation == AudioOrientation.horizontal ? 26px : 90px;

    if root.orientation == AudioOrientation.horizontal : HorizontalLayout {
        spacing: 4px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            SegmentedMeter {
                height: 6px;
                segments: root.segments;
                minimum-db: root.minimum-db;
                orientation: AudioOrientation.horizontal;
                level-db: root.left-db;
                held-db: root.held-left-db;
            }
            SegmentedMeter {
                height: 6px;
                segments: root.segments;
                minimum-db: root.minimum-db;
                orientation: AudioOrientation.horizontal;
                level-db: root.right-db;
                held-db: root.held-right-db;
            }
            MeterScale {
                height: 11px;
                minimum-db: root.minimum-db;
                orientation: AudioOrientation.horizontal;
                ticks: [0, -12, -24, -36, -48];
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            ClipIndicator {
                clipping: root.left-clipping || root.right-clipping;
                reset => { root.clip-reset(); }
            }
        }
        if root.show-readout : Text {
            width: 34px;
            text: root.peak-db <= root.minimum-db
                ? "-inf" : GainMath.format-db-value(root.peak-db);
            color: root.left-clipping || root.right-clipping ? Theme.meter-clip : Theme.text-muted;
            font-size: 9px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    if root.orientation == AudioOrientation.vertical : HorizontalLayout {
        spacing: 2px;
        alignment: center;
        VerticalLayout {
            spacing: 2px;
            ClipIndicator {
                width: 22px;
                height: 5px;
                clipping: root.left-clipping || root.right-clipping;
                reset => { root.clip-reset(); }
            }
            HorizontalLayout {
                spacing: 2px;
                vertical-stretch: 1;
                SegmentedMeter {
                    width: 10px;
                    segments: root.segments;
                    minimum-db: root.minimum-db;
                    level-db: root.left-db;
                    held-db: root.held-left-db;
                }
                SegmentedMeter {
                    width: 10px;
                    segments: root.segments;
                    minimum-db: root.minimum-db;
                    level-db: root.right-db;
                    held-db: root.held-right-db;
                }
            }
        }
        MeterScale { width: 20px; minimum-db: root.minimum-db; }
    }
}

// Gain-reduction meter. `reduction-db` is a positive amount of reduction and
// the bar grows downward from 0, opposite to a level meter, so the two are
// never confused at a glance.
export component GainReductionMeter inherits Rectangle {
    in property <float> reduction-db: 0;
    in property <float> range-db: 24;
    in property <AudioOrientation> orientation: AudioOrientation.horizontal;

    private property <float> normalized: clamp(root.reduction-db / root.range-db, 0, 1);

    min-width: root.orientation == AudioOrientation.horizontal ? 80px : 9px;
    min-height: root.orientation == AudioOrientation.horizontal ? 9px : 60px;
    background: Theme.background;
    border-radius: Theme.radius-sm;
    clip: true;

    if root.orientation == AudioOrientation.horizontal : Rectangle {
        x: parent.width * (1 - root.normalized);
        width: parent.width * root.normalized;
        height: parent.height;
        background: Theme.warning;
    }
    if root.orientation == AudioOrientation.vertical : Rectangle {
        // Pinned to the top, because a child given a height inside a plain
        // Rectangle is centred in it. Without this the bar grew from the
        // middle outwards in both directions -- the one thing the comment
        // above says this meter must not do, since growing downward from 0
        // is what tells it apart from a level meter at a glance.
        y: 0px;
        width: parent.width;
        height: parent.height * root.normalized;
        background: Theme.warning;
    }
    Tooltip { text: @markdown("Gain reduction"); }
}

// Stereo correlation, -1 (out of phase) to +1 (mono). The bar runs from the
// centre so that a healthy wide-but-compatible mix sits right of centre.
export component CorrelationMeter inherits Rectangle {
    in property <float> correlation: 1;
    private property <float> clamped: clamp(root.correlation, -1, 1);

    min-width: 90px;
    min-height: 14px;

    VerticalLayout {
        spacing: 1px;
        Rectangle {
            height: 7px;
            background: Theme.background;
            border-radius: Theme.radius-sm;
            clip: true;
            Rectangle {
                x: root.clamped >= 0 ? parent.width / 2 : parent.width / 2 * (1 + root.clamped);
                width: parent.width / 2 * abs(root.clamped);
                height: parent.height;
                background: root.clamped < 0 ? Theme.meter-clip
                    : root.clamped < 0.3 ? Theme.meter-warning : Theme.meter-safe;
            }
            // Centre reference.
            Rectangle {
                x: parent.width / 2;
                width: 1px;
                height: parent.height;
                background: Theme.text-faint;
            }
        }
        HorizontalLayout {
            Text { text: "-1"; color: Theme.text-faint; font-size: 8px; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "0"; color: Theme.text-faint; font-size: 8px; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "+1"; color: Theme.text-faint; font-size: 8px; }
        }
    }
    Tooltip { text: @markdown("Stereo correlation"); }
}
