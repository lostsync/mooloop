import { DisplayPrefs, Theme } from "theme.slint";
import { GainMath } from "gain.slint";
import { DraggablePoint } from "controls.slint";

export component SampleTrace inherits Rectangle {
    in property <[float]> minimums;
    in property <[float]> maximums;
    in property <color> trace-color: Theme.accent;

    Rectangle {
        y: parent.height / 2;
        width: 100%;
        height: 1px;
        background: Theme.border.with-alpha(0.55);
    }
    for maximum[index] in root.maximums : Rectangle {
        property <float> minimum: index < root.minimums.length ? root.minimums[index] : -maximum;
        property <float> top-value: clamp(max(maximum, self.minimum), -1, 1);
        property <float> bottom-value: clamp(min(maximum, self.minimum), -1, 1);
        x: index * parent.width / max(1, root.maximums.length);
        y: parent.height * (0.5 - self.top-value * 0.44);
        width: max(1px, parent.width / max(1, root.maximums.length));
        height: max(1px, parent.height * (self.top-value - self.bottom-value) * 0.44);
        background: root.trace-color;
    }
}

export component OscillatorTrace inherits Rectangle {
    in property <int> wave;
    in property <float> semitones;
    in property <float> cents;
    in property <float> level;
    in property <float> pulse-width;
    private property <int> sample-count: 160;
    private property <float> cycles: clamp(pow(2, (root.semitones + root.cents / 100) / 12), 0.5, 8);

    pure function sample(index: int) -> float {
        let phase = mod(index * root.cycles / (root.sample-count - 1), 1);
        let raw = root.wave == 0
            ? sin(phase * 360deg)
            : root.wave == 1
                ? 4 * abs(phase - 0.5) - 1
                : root.wave == 2
                    ? 2 * phase - 1
                    : phase < clamp(root.pulse-width, 0.05, 0.95) ? 1 : -1;
        return raw * clamp(root.level, 0, 1);
    }

    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    for index in root.sample-count : Rectangle {
        property <float> current: root.sample(index);
        property <float> previous: root.sample(max(0, index - 1));
        property <float> top-value: max(self.current, self.previous);
        property <float> bottom-value: min(self.current, self.previous);
        x: index * parent.width / root.sample-count;
        y: parent.height * (0.5 - self.top-value * 0.42);
        width: max(1px, parent.width / root.sample-count + 0.5px);
        height: max(1px, parent.height * (self.top-value - self.bottom-value) * 0.42);
        background: Theme.accent;
    }
}

export component BitcrusherTrace inherits Rectangle {
    in property <float> bit-reduction;
    in property <float> rate-reduction;
    private property <int> sample-count: 96;
    private property <int> hold-frames: round(1 + clamp(root.rate-reduction, 0, 1) * 31);
    private property <int> bits: round(16 - clamp(root.bit-reduction, 0, 1) * 12);
    private property <float> quantization-scale: pow(2, root.bits - 1);

    pure function sample(index: int) -> float {
        let held-index = floor(index / root.hold-frames) * root.hold-frames;
        let source = sin(held-index * 2.75 * 360deg / (root.sample-count - 1));
        return round(source * root.quantization-scale) / root.quantization-scale;
    }

    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    for index in root.sample-count : Rectangle {
        property <float> current: root.sample(index);
        property <float> previous: root.sample(max(0, index - 1));
        property <float> top-value: max(self.current, self.previous);
        property <float> bottom-value: min(self.current, self.previous);
        x: index * parent.width / root.sample-count;
        y: parent.height * (0.5 - self.top-value * 0.42);
        width: max(1px, parent.width / root.sample-count + 0.5px);
        height: max(1px, parent.height * (self.top-value - self.bottom-value) * 0.42);
        background: Theme.warning;
    }
}

export component FilterResponseDisplay inherits Rectangle {
    // 0 = low-pass, 1 = band-pass, 2 = high-pass.
    in property <int> mode;
    in property <float> cutoff;
    in property <float> resonance;
    // Extra cascaded 12 dB/oct stages beyond the first: 0 = 12 dB/oct, 1 = 24.
    // Fractional values are meaningful, for filters that land between the two
    // -- a three-pole ladder is 0.5.
    in property <float> slope;
    in property <float> env-amount;
    callback point-dragged(float, float);
    callback point-scrolled(float);
    private property <int> sample-count: 160;
    private property <float> modulated-cutoff: clamp(root.cutoff + root.env-amount * 0.602, 0, 1);

    pure function response-at(x: float, normalized-cutoff: float) -> float {
        let frequency = 20 * pow(1000, clamp(x, 0, 1));
        let cutoff-hz = 20 * pow(1000, clamp(normalized-cutoff, 0, 1));
        // The production TPT SVF uses g = tan(pi * f / sample-rate).
        let frequency-angle = frequency / 48000 * 180deg;
        let cutoff-angle = cutoff-hz / 48000 * 180deg;
        let ratio = (sin(frequency-angle) / cos(frequency-angle))
            / max(0.0001, sin(cutoff-angle) / cos(cutoff-angle));
        let damping = clamp(2 - clamp(root.resonance, 0, 1) * 1.9, 0.1, 2);
        let denominator = max(0.0001, pow(pow(1 - ratio * ratio, 2) + pow(damping * ratio, 2), 0.5));
        let stage = root.mode == 0 ? 1 / denominator : root.mode == 1 ? ratio / denominator : ratio * ratio / denominator;
        return root.slope > 0 ? pow(stage, 1 + root.slope) : stage;
    }

    pure function response(index: int, normalized-cutoff: float) -> float {
        return root.response-at(index / (root.sample-count - 1), normalized-cutoff);
    }

    pure function plot-y-at(x: float, normalized-cutoff: float) -> float {
        let magnitude = root.response-at(x, normalized-cutoff);
        return magnitude >= 1
            ? clamp(0.25 - 0.2 * (1 - 1 / magnitude), 0.04, 0.25)
            : clamp(0.25 + 0.7 * (1 - magnitude), 0.25, 0.95);
    }

    pure function plot-y(index: int, normalized-cutoff: float) -> float {
        return root.plot-y-at(index / (root.sample-count - 1), normalized-cutoff);
    }

    for line in 5 : Rectangle {
        y: line * parent.height / 4;
        width: 100%; height: 1px;
        background: Theme.border.with-alpha(line == 1 ? 0.65 : 0.35);
    }
    if abs(root.env-amount) > 0.01 && !DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Rectangle {
            property <float> current: root.plot-y(index, root.modulated-cutoff);
            property <float> previous: root.plot-y(max(0, index - 1), root.modulated-cutoff);
            x: index * parent.width / root.sample-count;
            y: min(self.current, self.previous) * parent.height;
            width: max(1px, parent.width / root.sample-count + 0.5px);
            height: max(1px, abs(self.current - self.previous) * parent.height);
            background: Theme.warning.with-alpha(0.62);
        }
    }
    if abs(root.env-amount) > 0.01 && DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Path {
            width: 100%; height: 100%;
            // Path viewboxes retain their aspect ratio. Match this scope's
            // dimensions so every segment uses the full rectangular plot.
            property <float> plot-w: self.width / 1px;
            property <float> plot-h: self.height / 1px;
            viewbox-width: self.plot-w; viewbox-height: self.plot-h;
            commands: "M " + (max(0, index - 1) / root.sample-count * self.plot-w) + " " + (root.plot-y(max(0, index - 1), root.modulated-cutoff) * self.plot-h)
                + " L " + (index / root.sample-count * self.plot-w) + " " + (root.plot-y(index, root.modulated-cutoff) * self.plot-h);
            stroke: Theme.warning.with-alpha(0.62);
            stroke-width: 1.4px;
            fill: transparent;
        }
    }
    if !DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Rectangle {
            property <float> current: root.plot-y(index, root.cutoff);
            property <float> previous: root.plot-y(max(0, index - 1), root.cutoff);
            x: index * parent.width / root.sample-count;
            y: min(self.current, self.previous) * parent.height;
            width: max(1px, parent.width / root.sample-count + 0.5px);
            height: max(1px, abs(self.current - self.previous) * parent.height);
            background: Theme.accent;
        }
    }
    if DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Path {
            width: 100%; height: 100%;
            property <float> plot-w: self.width / 1px;
            property <float> plot-h: self.height / 1px;
            viewbox-width: self.plot-w; viewbox-height: self.plot-h;
            commands: "M " + (max(0, index - 1) / root.sample-count * self.plot-w) + " " + (root.plot-y(max(0, index - 1), root.cutoff) * self.plot-h)
                + " L " + (index / root.sample-count * self.plot-w) + " " + (root.plot-y(index, root.cutoff) * self.plot-h);
            stroke: Theme.accent;
            stroke-width: 1.4px;
            fill: transparent;
        }
    }
    DraggablePoint {
        x: root.cutoff * parent.width - 7px;
        y: root.plot-y-at(root.cutoff, root.cutoff) * parent.height - 7px;
        width: 14px;
        height: 14px;
        dragged(dx, dy) => {
            root.point-dragged(
                clamp(root.cutoff + dx * 1px / parent.width, 0, 1),
                clamp(root.resonance - dy * 1px / parent.height, 0, 1));
        }
        scrolled(delta) => {
            root.point-scrolled(clamp(root.resonance - delta / 600, 0, 1));
        }
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: Theme.accent;
            border-width: 1px;
            border-color: Theme.panel;
        }
    }
}

// Transfer curve of the drive effect: input on x, shaped output on y. Mirrors
// `mooloop_dsp::shaper` exactly — same curves, same drive compensation — so
// the plot is parameter feedback rather than decoration.
export component DriveTransferDisplay inherits Rectangle {
    in property <float> drive;   // natural, 1..64
    in property <int> curve;     // 0 = soft, 1 = hard, 2 = fold, 3 = tape
    private property <int> sample-count: 140;
    // tanh(0.12), the DC the tape curve subtracts back out.
    private property <float> tape-dc: 0.1194273;

    pure function tanh-of(x: float) -> float {
        let e = pow(2.718281828, 2 * clamp(x, -8, 8));
        return (e - 1) / (e + 1);
    }

    pure function fold-of(x: float) -> float {
        let p = x * 0.25 + 0.25;
        return 1 - 4 * abs((p - floor(p)) - 0.5);
    }

    pure function tape-of(x: float) -> float {
        return (root.tanh-of(x + 0.12) - root.tape-dc) / (1 + root.tape-dc);
    }

    pure function shaped(x: float) -> float {
        let driven = x * root.drive;
        return root.curve == 1 ? clamp(driven, -1, 1)
            : root.curve == 2 ? root.fold-of(driven)
            : root.curve == 3 ? root.tape-of(driven)
            : root.tanh-of(driven);
    }

    pure function compensation() -> float {
        let d = max(1, root.drive);
        return root.curve == 1 ? 1
            : root.curve == 2 ? 1 / pow(d, 0.5)
            : root.curve == 3 ? 1 / max(0.1, root.tape-of(d))
            : 1 / max(0.1, root.tanh-of(d));
    }

    pure function plot-y(index: int) -> float {
        let x = index / (root.sample-count - 1) * 2 - 1;
        let y = clamp(root.shaped(x) * root.compensation(), -1, 1);
        return 0.5 - y * 0.46;
    }

    // Unity axes: the diagonal a fully clean signal would follow.
    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    Rectangle { x: parent.width / 2; width: 1px; height: 100%; background: Theme.border.with-alpha(0.55); }
    if !DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Rectangle {
            property <float> current: root.plot-y(index);
            property <float> previous: root.plot-y(max(0, index - 1));
            x: index * parent.width / root.sample-count;
            y: min(self.current, self.previous) * parent.height;
            width: max(1px, parent.width / root.sample-count + 0.5px);
            height: max(1px, abs(self.current - self.previous) * parent.height);
            background: Theme.warning;
        }
    }
    if DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Path {
            width: 100%; height: 100%;
            property <float> plot-w: self.width / 1px;
            property <float> plot-h: self.height / 1px;
            viewbox-width: self.plot-w; viewbox-height: self.plot-h;
            commands: "M " + (max(0, index - 1) / root.sample-count * self.plot-w) + " " + (root.plot-y(max(0, index - 1)) * self.plot-h)
                + " L " + (index / root.sample-count * self.plot-w) + " " + (root.plot-y(index) * self.plot-h);
            stroke: Theme.warning;
            stroke-width: 1.4px;
            fill: transparent;
        }
    }
}

// Quantization staircase of the bitcrush effect, using the effect's own
// natural units rather than the sampler's normalized lo-fi controls: step
// size is `2 / 2^bits` and the hold span is `downsample` input samples,
// matching `mooloop_dsp::effects::bitcrush`.
export component BitcrushTrace inherits Rectangle {
    in property <float> bits;        // natural, 1..16
    in property <float> downsample;  // natural, 1..64
    private property <int> sample-count: 120;
    private property <float> step: 2 / pow(2, clamp(root.bits, 1, 16));

    pure function sample(index: int) -> float {
        let hold = max(1, root.downsample);
        let held-index = floor(index / hold) * hold;
        let source = sin(held-index * 2.5 * 360deg / (root.sample-count - 1));
        return clamp(round(source / root.step) * root.step, -1, 1);
    }

    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    for index in root.sample-count : Rectangle {
        property <float> current: root.sample(index);
        property <float> previous: root.sample(max(0, index - 1));
        property <float> top-value: max(self.current, self.previous);
        property <float> bottom-value: min(self.current, self.previous);
        x: index * parent.width / root.sample-count;
        y: parent.height * (0.5 - self.top-value * 0.44);
        width: max(1px, parent.width / root.sample-count + 0.5px);
        height: max(1px, parent.height * (self.top-value - self.bottom-value) * 0.44);
        background: Theme.warning;
    }
}

// Echo train of the delay effect: one bar per repeat, spaced by the delay
// time and decaying by the feedback gain. Left-channel energy is drawn above
// the centre line and right below, so cross-feed reads as the repeats
// alternating sides.
//
// The channel split is the closed form of the feedback mixing matrix
// [[1-c, c], [c, 1-c]] applied n times: the total still decays as fb^n while
// the difference between channels decays as (1-2c)^n. At c = 1 that gives
// exact ping-pong.
export component DelayEchoDisplay inherits Rectangle {
    in property <float> time-ms;   // natural, 1..2000
    in property <float> feedback;  // 0..0.98
    in property <float> cross;     // 0..1
    private property <int> repeat-count: 12;
    // Fixed window across the parameter's full range, so moving the time
    // control visibly moves the repeats instead of rescaling the axis.
    private property <float> span-ms: 2000;

    // The first repeat is the direct tap: it is heard at full level on its
    // own channel, because feedback and cross-feed only act on the repeats
    // that follow it. Both therefore run to the power n - 1.
    pure function balance(n: int) -> float {
        let a = 1 - 2 * clamp(root.cross, 0, 1);
        let magnitude = pow(abs(a), n - 1);
        return a < 0 && mod(n - 1, 2) == 1 ? -magnitude : magnitude;
    }

    pure function amplitude(n: int) -> float {
        return pow(clamp(root.feedback, 0, 0.999), n - 1);
    }

    pure function left-height(n: int) -> float {
        return root.amplitude(n) * (1 + root.balance(n)) / 2;
    }

    pure function right-height(n: int) -> float {
        return root.amplitude(n) * (1 - root.balance(n)) / 2;
    }

    pure function position(n: int) -> float {
        return clamp(n * root.time-ms / root.span-ms, 0, 1);
    }

    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    // Dry impulse at the origin, for scale.
    Rectangle {
        x: 0px;
        y: parent.height * 0.06;
        width: 2px;
        height: parent.height * 0.44;
        background: Theme.text-faint;
    }
    for n in root.repeat-count : Rectangle {
        // `for n in count` yields 0..count-1; repeats start at 1.
        property <int> index: n + 1;
        property <bool> visible-repeat: root.position(self.index) < 1
            && root.amplitude(self.index) > 0.004;
        x: root.position(self.index) * (parent.width - 2px);
        width: 2px;
        y: parent.height * (0.5 - root.left-height(self.index) * 0.44);
        height: self.visible-repeat
            ? parent.height * (root.left-height(self.index) + root.right-height(self.index)) * 0.44
            : 0px;
        background: Theme.warning;
    }
}

// Transfer curve shared by the gate, compressor, and limiter: input level on
// x, output level on y, both -60..0 dB, with the unity diagonal for reference.
// The gain computers are the same ones in mooloop_dsp::dynamics, so the
// plotted corner and both parameter-derived points stay on the audible curve.
// A deliberately bounded frequency plot. The spectrum layer receives compact
// display telemetry only when enabled, so it cannot create background DSP work.
// Shared rather than private to the EQ device since 2026-09-11: the channel
// strip's own four bands are drawn by it too, and a second copy would be a
// second answer to what a bell of a given Q looks like.
//
// It reads a flat `band-data` of five floats a band -- normalized frequency,
// normalized gain, Q, enabled, `EqBandKind` index -- and draws up to seven of
// them. A caller with four bands sends four; `band-value` answers 0 past the
// end of the model, and a band whose `enabled` field is 0 is neither plotted
// nor draggable.
export component EqResponseDisplay inherits Rectangle {
    in property <[float]> band-data;
    in property <[float]> spectrum-data;
    in property <int> selected-target;
    in property <bool> spectrum-visible;
    callback point-grabbed(int);
    callback point-dragged(int, float, float);
    private property <int> sample-count: 140;

    pure function band-value(index: int, field: int) -> float {
        return index * 5 + field < root.band-data.length ? root.band-data[index * 5 + field] : 0;
    }
    pure function band-shape(index: int, x: float) -> float {
        let frequency = 20 * pow(1000, clamp(x, 0, 1));
        let center = 20 * pow(1000, clamp(root.band-value(index, 0), 0, 1));
        // Q is the inverse of bandwidth: a larger Q must visibly narrow the
        // bell. The old exponent approximation changed the curve's skirt but
        // not its half-width, which made the display read backwards.
        let bell = 1 / (1 + pow(abs(ln(frequency / center)) * max(0.15, root.band-value(index, 2)), 2));
        return root.band-value(index, 4) == 1 ? 1 / (1 + pow(frequency / center, 1.6))
            : root.band-value(index, 4) == 2 ? 1 / (1 + pow(center / frequency, 1.6)) : bell;
    }
    // Coincident points cannot be independently clicked when they occupy the
    // same TouchArea. Spread only matching, enabled points horizontally; the
    // callback still addresses the band at the curve position.
    pure function overlaps(index: int, other: int) -> bool {
        return index != other
            && root.band-value(index, 3) > 0.5
            && root.band-value(other, 3) > 0.5
            && abs(root.band-value(index, 0) - root.band-value(other, 0)) < 0.002
            && abs(root.band-value(index, 1) - root.band-value(other, 1)) < 0.002;
    }
    pure function overlap-count(index: int) -> int {
        return 1
            + (root.overlaps(index, 0) ? 1 : 0) + (root.overlaps(index, 1) ? 1 : 0)
            + (root.overlaps(index, 2) ? 1 : 0) + (root.overlaps(index, 3) ? 1 : 0)
            + (root.overlaps(index, 4) ? 1 : 0) + (root.overlaps(index, 5) ? 1 : 0)
            + (root.overlaps(index, 6) ? 1 : 0);
    }
    pure function overlap-rank(index: int) -> int {
        return (index > 0 && root.overlaps(index, 0) ? 1 : 0)
            + (index > 1 && root.overlaps(index, 1) ? 1 : 0)
            + (index > 2 && root.overlaps(index, 2) ? 1 : 0)
            + (index > 3 && root.overlaps(index, 3) ? 1 : 0)
            + (index > 4 && root.overlaps(index, 4) ? 1 : 0)
            + (index > 5 && root.overlaps(index, 5) ? 1 : 0);
    }
    pure function response-db(x: float) -> float {
        let b0 = root.band-value(0, 3) > 0.5 ? (root.band-value(0, 1) * 36 - 18) * root.band-shape(0, x) : 0;
        let b1 = root.band-value(1, 3) > 0.5 ? (root.band-value(1, 1) * 36 - 18) * root.band-shape(1, x) : 0;
        let b2 = root.band-value(2, 3) > 0.5 ? (root.band-value(2, 1) * 36 - 18) * root.band-shape(2, x) : 0;
        let b3 = root.band-value(3, 3) > 0.5 ? (root.band-value(3, 1) * 36 - 18) * root.band-shape(3, x) : 0;
        let b4 = root.band-value(4, 3) > 0.5 ? (root.band-value(4, 1) * 36 - 18) * root.band-shape(4, x) : 0;
        let b5 = root.band-value(5, 3) > 0.5 ? (root.band-value(5, 1) * 36 - 18) * root.band-shape(5, x) : 0;
        let b6 = root.band-value(6, 3) > 0.5 ? (root.band-value(6, 1) * 36 - 18) * root.band-shape(6, x) : 0;
        return clamp(b0 + b1 + b2 + b3 + b4 + b5 + b6, -24, 24);
    }
    pure function point-color(index: int) -> color {
        return index == 0 ? #eab308 : index == 1 ? #84cc16 : index == 2 ? #22c55e
            : index == 3 ? #06b6d4 : index == 4 ? #3b82f6 : index == 5 ? #a855f7 : #ec4899;
    }

    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    for grid in 7 : Rectangle { x: grid * parent.width / 6; width: 1px; height: 100%; background: Theme.border.with-alpha(0.32); }
    for grid in 5 : Rectangle { y: grid * parent.height / 4; width: 100%; height: 1px; background: Theme.border.with-alpha(grid == 2 ? 0.72 : 0.32); }
    for bar in 48 : Rectangle {
        private property <float> level: bar < root.spectrum-data.length ? root.spectrum-data[bar] : 0;
        x: bar * parent.width / 48; width: max(1px, parent.width / 48 - 1px);
        y: parent.height * (1 - clamp(level, 0, 1)); height: parent.height * clamp(level, 0, 1);
        background: Theme.text-faint.with-alpha(root.spectrum-visible ? 0.16 : 0);
    }
    for sample in root.sample-count : Rectangle {
        private property <float> x0: sample / (root.sample-count - 1);
        private property <float> x1: min(1, (sample + 1) / (root.sample-count - 1));
        private property <float> y0: 0.5 - root.response-db(x0) / 48;
        private property <float> y1: 0.5 - root.response-db(x1) / 48;
        x: x0 * parent.width; y: min(y0, y1) * parent.height;
        width: max(1px, parent.width / root.sample-count + 0.5px); height: max(1px, abs(y1 - y0) * parent.height);
        background: Theme.accent;
    }
    for index in 7 : DraggablePoint {
        private property <float> frequency: root.band-value(index, 0);
        private property <float> gain: root.band-value(index, 1);
        private property <int> coincident-count: root.overlap-count(index);
        private property <int> coincident-rank: root.overlap-rank(index);
        x: frequency * parent.width - 7px + (coincident-rank - (coincident-count - 1) / 2) * 18px;
        y: (1 - gain) * parent.height - 7px;
        width: 14px; height: 14px;
        enabled: root.band-value(index, 3) > 0.5;
        grabbed => { root.point-grabbed(index); }
        dragged(dx, dy) => {
            root.point-dragged(index,
                clamp(self.frequency + dx * 1px / parent.width, 0, 1),
                clamp(self.gain - dy * 1px / parent.height, 0, 1));
        }
        Rectangle { width: 14px; height: 14px; border-radius: 7px; background: root.point-color(index); border-width: root.selected-target == index ? 2px : 1px; border-color: root.selected-target == index ? Theme.text : Theme.panel; }
    }
}

export component DynamicsCurveDisplay inherits Rectangle {
    in property <int> mode;            // 0 = gate, 1 = compressor, 2 = limiter
    // Gate and compressor: the threshold. Limiter: the ceiling.
    in property <float> threshold-db;
    in property <float> threshold-min-db: -60;
    in property <float> ratio;
    in property <float> knee-db;
    // Gate: range. Compressor: makeup. Limiter: input gain.
    in property <float> extra-db;
    // What the device's own sidechain detector reached, referred to this
    // node's input. Deliberately not the input meter: that is a per-block
    // peak, which lands somewhere different every frame and makes the dot
    // stutter, while this has already been through the attack and release
    // the device is running, so it moves the way the device sounds.
    in property <float> detector-db: root.floor-db;
    // Gain reduction the device is actually applying, in dB and <= 0. It
    // lags the static curve during release, which is exactly the part of a
    // compressor's behaviour a transfer plot alone cannot show.
    in property <float> gain-reduction-db: 0;
    /// Output level in dB for `floor-db..0` of input, sampled evenly, or
    /// empty to use this component's own gain computer.
    ///
    /// For a device whose curve is **not** the shared one: the channel
    /// strip's compressor bends its ratio above the knee by an amount its
    /// voicing chooses, and the alternative to plotting what it hands over
    /// is teaching this file a second gain computer -- two formulas, one
    /// name, and the copy that drifts is the one a user is reading. Rust
    /// samples the real curve, and the display draws what is running.
    in property <[float]> curve-db;
    callback threshold-dragged(float);
    private property <int> sample-count: 140;
    private property <float> floor-db: -60;
    private property <float> input-db: clamp(root.detector-db, root.floor-db, 0);
    // A device with nothing coming into it is not doing anything worth
    // lighting up, whatever its gain computer says. This matters for the
    // gate above all: a shut gate on a silent channel is holding 80 dB down
    // and would otherwise sit at full glow for as long as nobody plays.
    private property <bool> has-signal: root.detector-db > root.floor-db;
    private property <float> reduction-db:
        root.has-signal ? clamp(-root.gain-reduction-db, 0, 24) : 0;
    // Reduction as 0..1 for the glow. Squashed rather than linear: the first
    // few decibels are the ones worth seeing arrive, and past about twelve
    // the display should already be as lit as it gets.
    private property <float> reduction-amount: clamp(pow(root.reduction-db / 12, 0.65), 0, 1);
    // Where the signal actually leaves the device: the detector's level plus
    // the gain being applied to it right now. On a steady tone this sits on
    // the curve; through a transient it rides above it, by the amount the
    // ballistics are still holding back. With nothing playing it parks on
    // the floor rather than being lifted off it by the makeup gain.
    private property <float> live-output-db: root.has-signal
        ? clamp(root.input-db + root.gain-reduction-db + root.extra-db, root.floor-db, 0)
        : root.floor-db;

    pure function comp-gain(input-db: float) -> float {
        let slope = 1 - 1 / max(1, root.ratio);
        let over = input-db - root.threshold-db;
        let half = max(0, root.knee-db) / 2;
        return over <= -half ? 0
            : (half <= 0 ? (over > 0 ? -slope * over : 0)
            : (over >= half ? -slope * over
            : -slope * (over + half) * (over + half) / (4 * half)));
    }

    pure function output-db(input-db: float) -> float {
        return root.mode == 0
            ? (input-db >= root.threshold-db ? input-db : input-db + root.extra-db)
            : (root.mode == 2
                ? min(input-db + root.extra-db, root.threshold-db)
                : input-db + root.comp-gain(input-db) + root.extra-db);
    }

    /// This device's output for an input level: the supplied curve if there
    /// is one, and otherwise its own gain computer.
    pure function curve-out(input-db: float) -> float {
        if (root.curve-db.length > 1) {
            let travel = clamp((input-db - root.floor-db) / -root.floor-db, 0, 1);
            return root.curve-db[clamp(round(travel * (root.curve-db.length - 1)), 0, root.curve-db.length - 1)];
        }
        return root.output-db(input-db);
    }

    pure function plot-y(index: int) -> float {
        let input-db = root.floor-db + (0 - root.floor-db) * index / (root.sample-count - 1);
        let out = clamp(root.curve-out(input-db), root.floor-db, 0);
        return -out / -root.floor-db;
    }

    pure function db-x(db: float) -> float {
        return (clamp(db, root.floor-db, 0) - root.floor-db) / -root.floor-db;
    }

    // Plot height for a level, shared by the curve, the handle, and the live
    // dot so all three agree on where a given decibel sits.
    pure function level-y(db: float) -> float {
        return -clamp(db, root.floor-db, 0) / -root.floor-db;
    }

    pure function db-y(db: float) -> float {
        return root.level-y(root.curve-out(clamp(db, root.floor-db, 0)));
    }

    // The scope warms as the device leans on the signal. This is the same
    // number as the rail on the right, said in a way that is legible from
    // across the rack without being read: gain reduction is the one thing
    // about a compressor you want to notice without looking at it.
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.warning.with-alpha(root.reduction-amount * 0.07);
        border-width: 1px;
        border-color: Theme.warning.with-alpha(root.reduction-amount * 0.22);
        border-radius: Theme.radius-xs;
    }
    for line in 5 : Rectangle {
        y: line * parent.height / 4;
        width: 100%; height: 1px;
        background: Theme.border.with-alpha(0.35);
    }
    // Unity reference: what the signal would do untouched.
    for index in root.sample-count : Rectangle {
        property <float> unity: 1 - index / (root.sample-count - 1);
        x: index * parent.width / root.sample-count;
        y: self.unity * parent.height;
        width: max(1px, parent.width / root.sample-count + 0.5px);
        height: 1px;
        background: Theme.border.with-alpha(0.8);
    }
    if !DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Rectangle {
            property <float> current: root.plot-y(index);
            property <float> previous: root.plot-y(max(0, index - 1));
            x: index * parent.width / root.sample-count;
            y: min(self.current, self.previous) * parent.height;
            width: max(1px, parent.width / root.sample-count + 0.5px);
            height: max(1px, abs(self.current - self.previous) * parent.height);
            background: Theme.warning;
        }
    }
    if DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Path {
            width: 100%; height: 100%;
            property <float> plot-w: self.width / 1px;
            property <float> plot-h: self.height / 1px;
            viewbox-width: self.plot-w; viewbox-height: self.plot-h;
            commands: "M " + (max(0, index - 1) / root.sample-count * self.plot-w) + " " + (root.plot-y(max(0, index - 1)) * self.plot-h)
                + " L " + (index / root.sample-count * self.plot-w) + " " + (root.plot-y(index) * self.plot-h);
            stroke: Theme.warning;
            stroke-width: 1.4px;
            fill: transparent;
        }
    }

    // Gain-reduction rail: the plain reading of the same number the glow
    // gives approximately. Drawn downward from the top, like every hardware
    // GR meter.
    Rectangle {
        x: parent.width - 4px;
        width: 2px;
        height: 100%;
        z: 2;
        background: Theme.border.with-alpha(0.3);
        // Full scale at 18 dB rather than the 24 the devices can reach: the
        // rail is there to show the first few decibels arriving, and a scale
        // set by the extreme leaves ordinary gain reduction barely moving.
        Rectangle {
            y: 0;
            width: 100%;
            height: parent.height * clamp(root.reduction-db / 18, 0, 1);
            background: Theme.warning.with-alpha(0.8);
        }
    }
    if root.reduction-db > 0.05 : Text {
        x: 4px;
        y: 2px;
        z: 2;
        text: "GR -" + GainMath.format-plain-db(root.reduction-db) + " dB";
        font-size: 9px;
        color: Theme.warning.with-alpha(0.85);
    }

    // Where the signal is, and where the device is putting it. The dot sits
    // at the detector's level on x and at the level actually leaving the
    // device on y, so under a slow release it floats above the static curve
    // for as long as the device is still holding the gain down.
    Rectangle {
        x: root.db-x(root.input-db) * parent.width - 4px;
        y: root.level-y(root.live-output-db) * parent.height - 4px;
        z: 3;
        width: 8px;
        height: 8px;
        // A halo in the reduction colour, sized by how hard the device is
        // working. At rest it is not drawn at all.
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 8px + 13px * root.reduction-amount;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.warning.with-alpha(root.reduction-amount * 0.22);
        }
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 4px;
            background: Theme.accent;
            border-width: 1px;
            border-color: Theme.panel;
        }
    }

    DraggablePoint {
        x: root.db-x(root.threshold-db) * parent.width - 7px;
        y: root.db-y(root.threshold-db) * parent.height - 7px;
        z: 3;
        width: 14px;
        height: 14px;
        dragged(dx, dy) => {
            root.threshold-dragged(clamp(
                root.threshold-db - dy * (0 - root.threshold-min-db) / (parent.height / 1px),
                root.threshold-min-db,
                0));
        }
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: Theme.panel;
            border-width: 2px;
            border-color: Theme.warning;
        }
        Rectangle {
            x: 5px;
            y: 5px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: Theme.text;
        }
    }
}

// Where a preamp is distorting, band by band.
//
// **Not a spectrum.** Each value is how many decibels that band gained
// between what arrived and what left, with any broadband level change already
// taken out by `mooloop_dsp::effects::preamp` -- so a bar rises where the
// stage *added* energy and stays down where it merely passed it through.
// Turning Drive up does not light the display; turning it up far enough to
// distort does.
//
// The band grid is the analyzer's, log-spaced 20 Hz to `0.45 * sample_rate`,
// which is the same axis `spikes/preamp-measure` plots its harmonics against.
export component PreampDeviationDisplay inherits Rectangle {
    in property <[float]> deviation;
    in property <bool> active;

    // A band with nothing in it is not drawn as an empty slot: the rail
    // underneath is what makes a lit band read as lit rather than as the
    // only thing present.
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border.with-alpha(root.active ? 0.55 : 0.25);
    }
    for value[index] in root.deviation : Rectangle {
        property <float> level: root.active ? clamp(value, 0, 1) : 0;
        x: index * parent.width / max(1, root.deviation.length);
        width: max(1px, parent.width / max(1, root.deviation.length) - 1px);
        y: parent.height - self.height;
        height: max(1px, self.level * parent.height);
        // Warm where the stage is working hardest, which is the same ramp
        // the drive transfer display uses for the same meaning.
        background: self.level > 0.66 ? Theme.warning
            : self.level > 0.33 ? Theme.warning.with-alpha(0.7)
            : Theme.accent.with-alpha(0.55);
    }
}
