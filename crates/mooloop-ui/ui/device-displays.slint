import { DisplayPrefs, Theme } from "theme.slint";

export component SampleTrace inherits Rectangle {
    in property <[float]> minimums;
    in property <[float]> maximums;
    in property <color> trace-color: Theme.accent;

    Rectangle {
        y: parent.height / 2;
        width: 100%;
        height: 1px;
        background: Theme.border.with-alpha(0.55);
    }
    for maximum[index] in root.maximums : Rectangle {
        property <float> minimum: index < root.minimums.length ? root.minimums[index] : -maximum;
        property <float> top-value: clamp(max(maximum, self.minimum), -1, 1);
        property <float> bottom-value: clamp(min(maximum, self.minimum), -1, 1);
        x: index * parent.width / max(1, root.maximums.length);
        y: parent.height * (0.5 - self.top-value * 0.44);
        width: max(1px, parent.width / max(1, root.maximums.length));
        height: max(1px, parent.height * (self.top-value - self.bottom-value) * 0.44);
        background: root.trace-color;
    }
}

export component OscillatorTrace inherits Rectangle {
    in property <int> wave;
    in property <float> semitones;
    in property <float> cents;
    in property <float> level;
    in property <float> pulse-width;
    private property <int> sample-count: 160;
    private property <float> cycles: clamp(pow(2, (root.semitones + root.cents / 100) / 12), 0.5, 8);

    pure function sample(index: int) -> float {
        let phase = mod(index * root.cycles / (root.sample-count - 1), 1);
        let raw = root.wave == 0
            ? sin(phase * 360deg)
            : root.wave == 1
                ? 4 * abs(phase - 0.5) - 1
                : root.wave == 2
                    ? 2 * phase - 1
                    : phase < clamp(root.pulse-width, 0.05, 0.95) ? 1 : -1;
        return raw * clamp(root.level, 0, 1);
    }

    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    for index in root.sample-count : Rectangle {
        property <float> current: root.sample(index);
        property <float> previous: root.sample(max(0, index - 1));
        property <float> top-value: max(self.current, self.previous);
        property <float> bottom-value: min(self.current, self.previous);
        x: index * parent.width / root.sample-count;
        y: parent.height * (0.5 - self.top-value * 0.42);
        width: max(1px, parent.width / root.sample-count + 0.5px);
        height: max(1px, parent.height * (self.top-value - self.bottom-value) * 0.42);
        background: Theme.accent;
    }
}

export component BitcrusherTrace inherits Rectangle {
    in property <float> bit-reduction;
    in property <float> rate-reduction;
    private property <int> sample-count: 96;
    private property <int> hold-frames: round(1 + clamp(root.rate-reduction, 0, 1) * 31);
    private property <int> bits: round(16 - clamp(root.bit-reduction, 0, 1) * 12);
    private property <float> quantization-scale: pow(2, root.bits - 1);

    pure function sample(index: int) -> float {
        let held-index = floor(index / root.hold-frames) * root.hold-frames;
        let source = sin(held-index * 2.75 * 360deg / (root.sample-count - 1));
        return round(source * root.quantization-scale) / root.quantization-scale;
    }

    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    for index in root.sample-count : Rectangle {
        property <float> current: root.sample(index);
        property <float> previous: root.sample(max(0, index - 1));
        property <float> top-value: max(self.current, self.previous);
        property <float> bottom-value: min(self.current, self.previous);
        x: index * parent.width / root.sample-count;
        y: parent.height * (0.5 - self.top-value * 0.42);
        width: max(1px, parent.width / root.sample-count + 0.5px);
        height: max(1px, parent.height * (self.top-value - self.bottom-value) * 0.42);
        background: Theme.warning;
    }
}

export component FilterResponseDisplay inherits Rectangle {
    // 0 = low-pass, 1 = band-pass, 2 = high-pass. Audio currently uses LPF.
    in property <int> mode;
    in property <float> cutoff;
    in property <float> resonance;
    in property <float> env-amount;
    private property <int> sample-count: 160;
    private property <float> modulated-cutoff: clamp(root.cutoff + root.env-amount * 0.602, 0, 1);

    pure function response(index: int, normalized-cutoff: float) -> float {
        let frequency = 20 * pow(1000, index / (root.sample-count - 1));
        let cutoff-hz = 20 * pow(1000, clamp(normalized-cutoff, 0, 1));
        // The production TPT SVF uses g = tan(pi * f / sample-rate).
        let frequency-angle = frequency / 48000 * 180deg;
        let cutoff-angle = cutoff-hz / 48000 * 180deg;
        let ratio = (sin(frequency-angle) / cos(frequency-angle))
            / max(0.0001, sin(cutoff-angle) / cos(cutoff-angle));
        let damping = clamp(2 - clamp(root.resonance, 0, 1) * 1.9, 0.1, 2);
        let denominator = max(0.0001, pow(pow(1 - ratio * ratio, 2) + pow(damping * ratio, 2), 0.5));
        return root.mode == 0 ? 1 / denominator : root.mode == 1 ? ratio / denominator : ratio * ratio / denominator;
    }

    pure function plot-y(index: int, normalized-cutoff: float) -> float {
        let magnitude = root.response(index, normalized-cutoff);
        return magnitude >= 1
            ? clamp(0.25 - 0.2 * (1 - 1 / magnitude), 0.04, 0.25)
            : clamp(0.25 + 0.7 * (1 - magnitude), 0.25, 0.95);
    }

    for line in 5 : Rectangle {
        y: line * parent.height / 4;
        width: 100%; height: 1px;
        background: Theme.border.with-alpha(line == 1 ? 0.65 : 0.35);
    }
    if abs(root.env-amount) > 0.01 && !DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Rectangle {
            property <float> current: root.plot-y(index, root.modulated-cutoff);
            property <float> previous: root.plot-y(max(0, index - 1), root.modulated-cutoff);
            x: index * parent.width / root.sample-count;
            y: min(self.current, self.previous) * parent.height;
            width: max(1px, parent.width / root.sample-count + 0.5px);
            height: max(1px, abs(self.current - self.previous) * parent.height);
            background: Theme.warning.with-alpha(0.62);
        }
    }
    if abs(root.env-amount) > 0.01 && DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Path {
            width: 100%; height: 100%;
            viewbox-width: 1; viewbox-height: 1;
            commands: "M " + (max(0, index - 1) / root.sample-count) + " " + root.plot-y(max(0, index - 1), root.modulated-cutoff)
                + " L " + (index / root.sample-count) + " " + root.plot-y(index, root.modulated-cutoff);
            stroke: Theme.warning.with-alpha(0.62);
            stroke-width: 1.4px;
            fill: transparent;
        }
    }
    if !DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Rectangle {
            property <float> current: root.plot-y(index, root.cutoff);
            property <float> previous: root.plot-y(max(0, index - 1), root.cutoff);
            x: index * parent.width / root.sample-count;
            y: min(self.current, self.previous) * parent.height;
            width: max(1px, parent.width / root.sample-count + 0.5px);
            height: max(1px, abs(self.current - self.previous) * parent.height);
            background: Theme.accent;
        }
    }
    if DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Path {
            width: 100%; height: 100%;
            viewbox-width: 1; viewbox-height: 1;
            commands: "M " + (max(0, index - 1) / root.sample-count) + " " + root.plot-y(max(0, index - 1), root.cutoff)
                + " L " + (index / root.sample-count) + " " + root.plot-y(index, root.cutoff);
            stroke: Theme.accent;
            stroke-width: 1.4px;
            fill: transparent;
        }
    }
}

// Transfer curve of the drive effect: input on x, shaped output on y. Mirrors
// `mooloop_dsp::shaper` exactly — same curves, same drive compensation — so
// the plot is parameter feedback rather than decoration.
export component DriveTransferDisplay inherits Rectangle {
    in property <float> drive;   // natural, 1..64
    in property <int> curve;     // 0 = soft, 1 = hard, 2 = fold, 3 = tape
    private property <int> sample-count: 140;
    // tanh(0.12), the DC the tape curve subtracts back out.
    private property <float> tape-dc: 0.1194273;

    pure function tanh-of(x: float) -> float {
        let e = pow(2.718281828, 2 * clamp(x, -8, 8));
        return (e - 1) / (e + 1);
    }

    pure function fold-of(x: float) -> float {
        let p = x * 0.25 + 0.25;
        return 1 - 4 * abs((p - floor(p)) - 0.5);
    }

    pure function tape-of(x: float) -> float {
        return (root.tanh-of(x + 0.12) - root.tape-dc) / (1 + root.tape-dc);
    }

    pure function shaped(x: float) -> float {
        let driven = x * root.drive;
        return root.curve == 1 ? clamp(driven, -1, 1)
            : root.curve == 2 ? root.fold-of(driven)
            : root.curve == 3 ? root.tape-of(driven)
            : root.tanh-of(driven);
    }

    pure function compensation() -> float {
        let d = max(1, root.drive);
        return root.curve == 1 ? 1
            : root.curve == 2 ? 1 / pow(d, 0.5)
            : root.curve == 3 ? 1 / max(0.1, root.tape-of(d))
            : 1 / max(0.1, root.tanh-of(d));
    }

    pure function plot-y(index: int) -> float {
        let x = index / (root.sample-count - 1) * 2 - 1;
        let y = clamp(root.shaped(x) * root.compensation(), -1, 1);
        return 0.5 - y * 0.46;
    }

    // Unity axes: the diagonal a fully clean signal would follow.
    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    Rectangle { x: parent.width / 2; width: 1px; height: 100%; background: Theme.border.with-alpha(0.55); }
    if !DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Rectangle {
            property <float> current: root.plot-y(index);
            property <float> previous: root.plot-y(max(0, index - 1));
            x: index * parent.width / root.sample-count;
            y: min(self.current, self.previous) * parent.height;
            width: max(1px, parent.width / root.sample-count + 0.5px);
            height: max(1px, abs(self.current - self.previous) * parent.height);
            background: Theme.warning;
        }
    }
    if DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Path {
            width: 100%; height: 100%;
            viewbox-width: 1; viewbox-height: 1;
            commands: "M " + (max(0, index - 1) / root.sample-count) + " " + root.plot-y(max(0, index - 1))
                + " L " + (index / root.sample-count) + " " + root.plot-y(index);
            stroke: Theme.warning;
            stroke-width: 1.4px;
            fill: transparent;
        }
    }
}

// Quantization staircase of the bitcrush effect, using the effect's own
// natural units rather than the sampler's normalized lo-fi controls: step
// size is `2 / 2^bits` and the hold span is `downsample` input samples,
// matching `mooloop_dsp::effects::bitcrush`.
export component BitcrushTrace inherits Rectangle {
    in property <float> bits;        // natural, 1..16
    in property <float> downsample;  // natural, 1..64
    private property <int> sample-count: 120;
    private property <float> step: 2 / pow(2, clamp(root.bits, 1, 16));

    pure function sample(index: int) -> float {
        let hold = max(1, root.downsample);
        let held-index = floor(index / hold) * hold;
        let source = sin(held-index * 2.5 * 360deg / (root.sample-count - 1));
        return clamp(round(source / root.step) * root.step, -1, 1);
    }

    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    for index in root.sample-count : Rectangle {
        property <float> current: root.sample(index);
        property <float> previous: root.sample(max(0, index - 1));
        property <float> top-value: max(self.current, self.previous);
        property <float> bottom-value: min(self.current, self.previous);
        x: index * parent.width / root.sample-count;
        y: parent.height * (0.5 - self.top-value * 0.44);
        width: max(1px, parent.width / root.sample-count + 0.5px);
        height: max(1px, parent.height * (self.top-value - self.bottom-value) * 0.44);
        background: Theme.warning;
    }
}

// Echo train of the delay effect: one bar per repeat, spaced by the delay
// time and decaying by the feedback gain. Left-channel energy is drawn above
// the centre line and right below, so cross-feed reads as the repeats
// alternating sides.
//
// The channel split is the closed form of the feedback mixing matrix
// [[1-c, c], [c, 1-c]] applied n times: the total still decays as fb^n while
// the difference between channels decays as (1-2c)^n. At c = 1 that gives
// exact ping-pong.
export component DelayEchoDisplay inherits Rectangle {
    in property <float> time-ms;   // natural, 1..2000
    in property <float> feedback;  // 0..0.98
    in property <float> cross;     // 0..1
    private property <int> repeat-count: 12;
    // Fixed window across the parameter's full range, so moving the time
    // control visibly moves the repeats instead of rescaling the axis.
    private property <float> span-ms: 2000;

    // The first repeat is the direct tap: it is heard at full level on its
    // own channel, because feedback and cross-feed only act on the repeats
    // that follow it. Both therefore run to the power n - 1.
    pure function balance(n: int) -> float {
        let a = 1 - 2 * clamp(root.cross, 0, 1);
        let magnitude = pow(abs(a), n - 1);
        return a < 0 && mod(n - 1, 2) == 1 ? -magnitude : magnitude;
    }

    pure function amplitude(n: int) -> float {
        return pow(clamp(root.feedback, 0, 0.999), n - 1);
    }

    pure function left-height(n: int) -> float {
        return root.amplitude(n) * (1 + root.balance(n)) / 2;
    }

    pure function right-height(n: int) -> float {
        return root.amplitude(n) * (1 - root.balance(n)) / 2;
    }

    pure function position(n: int) -> float {
        return clamp(n * root.time-ms / root.span-ms, 0, 1);
    }

    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border.with-alpha(0.55); }
    // Dry impulse at the origin, for scale.
    Rectangle {
        x: 0px;
        y: parent.height * 0.06;
        width: 2px;
        height: parent.height * 0.44;
        background: Theme.text-faint;
    }
    for n in root.repeat-count : Rectangle {
        // `for n in count` yields 0..count-1; repeats start at 1.
        property <int> index: n + 1;
        property <bool> visible-repeat: root.position(self.index) < 1
            && root.amplitude(self.index) > 0.004;
        x: root.position(self.index) * (parent.width - 2px);
        width: 2px;
        y: parent.height * (0.5 - root.left-height(self.index) * 0.44);
        height: self.visible-repeat
            ? parent.height * (root.left-height(self.index) + root.right-height(self.index)) * 0.44
            : 0px;
        background: Theme.warning;
    }
}

// Static transfer curve shared by the gate, compressor, and limiter: input
// level on x, output level on y, both -60..0 dB, with the unity diagonal for
// reference. The gain computers are the same ones in mooloop_dsp::dynamics,
// so the plotted corner is the corner the audio actually has.
export component DynamicsCurveDisplay inherits Rectangle {
    in property <int> mode;            // 0 = gate, 1 = compressor, 2 = limiter
    // Gate and compressor: the threshold. Limiter: the ceiling.
    in property <float> threshold-db;
    in property <float> ratio;
    in property <float> knee-db;
    // Gate: range. Compressor: makeup. Limiter: input gain.
    in property <float> extra-db;
    private property <int> sample-count: 140;
    private property <float> floor-db: -60;

    pure function comp-gain(input-db: float) -> float {
        let slope = 1 - 1 / max(1, root.ratio);
        let over = input-db - root.threshold-db;
        let half = max(0, root.knee-db) / 2;
        return over <= -half ? 0
            : (half <= 0 ? (over > 0 ? -slope * over : 0)
            : (over >= half ? -slope * over
            : -slope * (over + half) * (over + half) / (4 * half)));
    }

    pure function output-db(input-db: float) -> float {
        return root.mode == 0
            ? (input-db >= root.threshold-db ? input-db : input-db + root.extra-db)
            : (root.mode == 2
                ? min(input-db + root.extra-db, root.threshold-db)
                : input-db + root.comp-gain(input-db) + root.extra-db);
    }

    pure function plot-y(index: int) -> float {
        let input-db = root.floor-db + (0 - root.floor-db) * index / (root.sample-count - 1);
        let out = clamp(root.output-db(input-db), root.floor-db, 0);
        return -out / -root.floor-db;
    }

    for line in 5 : Rectangle {
        y: line * parent.height / 4;
        width: 100%; height: 1px;
        background: Theme.border.with-alpha(0.35);
    }
    // Unity reference: what the signal would do untouched.
    for index in root.sample-count : Rectangle {
        property <float> unity: 1 - index / (root.sample-count - 1);
        x: index * parent.width / root.sample-count;
        y: self.unity * parent.height;
        width: max(1px, parent.width / root.sample-count + 0.5px);
        height: 1px;
        background: Theme.border.with-alpha(0.8);
    }
    if !DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Rectangle {
            property <float> current: root.plot-y(index);
            property <float> previous: root.plot-y(max(0, index - 1));
            x: index * parent.width / root.sample-count;
            y: min(self.current, self.previous) * parent.height;
            width: max(1px, parent.width / root.sample-count + 0.5px);
            height: max(1px, abs(self.current - self.previous) * parent.height);
            background: Theme.warning;
        }
    }
    if DisplayPrefs.smooth-curves : Rectangle {
        for index in root.sample-count : Path {
            width: 100%; height: 100%;
            viewbox-width: 1; viewbox-height: 1;
            commands: "M " + (max(0, index - 1) / root.sample-count) + " " + root.plot-y(max(0, index - 1))
                + " L " + (index / root.sample-count) + " " + root.plot-y(index);
            stroke: Theme.warning;
            stroke-width: 1.4px;
            fill: transparent;
        }
    }
}
