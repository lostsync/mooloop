import { Theme } from "theme.slint";
import { MiniKnob, NoteFormat, ParameterKnob, SelectorBank, ToggleButton, ToolButton, TrimKnob, ValueScale, ZoomScrollBar } from "controls.slint";
import { GainMath } from "gain.slint";
import { DevicePageButton } from "device-rack.slint";
import { BitcrusherTrace, FilterResponseDisplay } from "device-displays.slint";
import { EnvelopeEditor } from "envelope.slint";
import { StepperField } from "toolbar.slint";

global SamplerDeviceIcons {
    out property <string> previous: "M 10 3 L 5 8 L 10 13";
    out property <string> next: "M 6 3 L 11 8 L 6 13";
    out property <string> search: "M 10 6 A 4 4 0 1 1 2 6 A 4 4 0 1 1 10 6 Z M 9.2 9.2 L 13.5 13.5";
    out property <string> reverse: "M 12 3 L 12 13 M 12 8 L 4.5 8 M 7.3 5 L 4.3 8 L 7.3 11";
}

component SampleMarker inherits Rectangle {
    in property <color> marker-color;
    in property <string> marker-label;
    in property <length> editor-width;
    in property <bool> label-at-bottom;
    callback moved(float);

    width: 1px;
    background: root.marker-color;
    Rectangle {
        x: -3px;
        y: root.label-at-bottom ? parent.height - 8px : 0px;
        width: 7px;
        height: 7px;
        background: root.marker-color;
    }
    Text {
        x: root.x > root.editor-width - 18px ? -16px : 3px;
        y: root.label-at-bottom ? parent.height - 12px : 2px;
        text: root.marker-label;
        color: root.marker-color;
        font-size: 8px;
    }
    TouchArea {
        x: -6px;
        width: 13px;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                root.moved(clamp((root.x + self.x + self.mouse-x) / max(1px, root.editor-width), 0, 1));
            }
        }
    }
}

// Sample-frame-accurate numeric entry, for placing trim/loop points more
// precisely than dragging a `SampleMarker` allows. No prev/next arrows
// (a sample can be hundreds of thousands of frames long, so +/-1 buttons
// would be useless) — drag or scroll to change it instead, the same idiom
// as `StepperField`, with Ctrl/Shift dropping to the finest 1-frame step
// the same way the knobs' fine-drag does. `value` is purely display-driven
// from outside (like `SampleMarker.x`); `changed` reports the proposed new
// absolute frame so the caller can clamp and convert it.
component SampleField inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    in property <int> value;
    in property <int> maximum: 1;
    callback changed(int);

    private property <int> pressed-value;
    private property <bool> fine-drag;
    private property <int> coarse-step: max(1, root.maximum / 1000);

    height: 22px;
    width: layout.preferred-width;
    border-radius: Theme.radius-md;
    background: Theme.surface-raised;
    accessible-role: spinbox;
    accessible-label: root.tooltip;

    layout := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.text-faint;
            font-size: 8px;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 9px;
            font-family: "monospace";
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 48px;
        }
    }
    TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pressed-value = root.value;
                root.fine-drag = e.modifiers.control || e.modifiers.shift;
            } else if (e.kind == PointerEventKind.move && self.pressed) {
                let step = root.fine-drag ? 1 : root.coarse-step;
                let next = root.pressed-value + round((self.pressed-y - self.mouse-y) / 4px) * step;
                root.changed(clamp(next, 0, root.maximum));
            }
        }
        scroll-event(e) => {
            let step = (e.modifiers.control || e.modifiers.shift) ? 1 : root.coarse-step;
            root.changed(clamp(root.value + (e.delta-y > 0 ? step : -step), 0, root.maximum));
            accept
        }
    }
    Tooltip { text: @markdown("**\{root.tooltip}** \{root.value}"); }
}

export component SamplerDeviceFace inherits Rectangle {
    in-out property <int> page;
    in-out property <float> attack;
    in-out property <float> decay;
    in-out property <float> sustain;
    in-out property <float> release;
    in-out property <float> start-pos;
    in-out property <float> end-pos: 1;
    in-out property <float> loop-start;
    in-out property <float> loop-end;
    in-out property <bool> reverse-playback;
    in-out property <int> root-note: 60;
    in-out property <float> tune-semitones;
    in-out property <float> tune-cents;
    in-out property <string> tune-label;
    in-out property <float> filter-cutoff;
    in-out property <float> filter-resonance;
    in-out property <float> filter-env;
    in property <bool> modulation-armed;
    // Indexed by descriptor id, mirroring `SAMPLER_PARAM_*` in mooloop-core, so
    // every eligible control on this face routes through one path.
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    in-out property <float> drive;
    in-out property <float> bit-reduction;
    in-out property <float> rate-reduction;
    // The patch's output trim, stored linear like the engine keeps it. The
    // knob works in dB; the conversion happens at the control, as it does on
    // the oscillator strip's Level.
    in-out property <float> output-gain;
    in-out property <int> loop-mode;
    in-out property <int> voice-mode;
    in-out property <int> polyphony: 1;
    in-out property <int> retrigger-mode;
    in-out property <int> choke-group;
    in-out property <string> sample-name;
    in-out property <string> sample-description;
    in-out property <[float]> waveform;
    in-out property <[float]> playhead-positions;
    in-out property <int> sample-frames;
    // Global editing preference rather than saved sampler state: it changes
    // how a marker edit resolves, not what the instrument sounds like.
    in-out property <bool> snap-to-zero;
    in-out property <bool> can-previous-sample;
    in-out property <bool> can-next-sample;
    // Pure view state: which slice of the sample the waveform is
    // zoomed/scrolled to. Not sent to the engine, not persisted.
    in-out property <float> waveform-view-offset: 0;
    in-out property <float> waveform-view-visible-fraction: 1;

    callback attack-changed(float);
    callback decay-changed(float);
    callback sustain-changed(float);
    callback release-changed(float);
    callback start-pos-changed(float);
    callback end-pos-changed(float);
    callback loop-start-changed(float);
    callback loop-end-changed(float);
    callback reverse-playback-changed(bool);
    callback root-note-changed(int);
    callback tune-semitones-changed(float);
    callback tune-cents-changed(float);
    callback loop-mode-changed(int);
    callback voice-mode-changed(int);
    callback polyphony-changed(int);
    callback retrigger-mode-changed(int);
    callback choke-group-changed(int);
    callback filter-cutoff-changed(float);
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);
    callback filter-resonance-changed(float);
    callback filter-env-changed(float);
    callback drive-changed(float);
    callback bit-reduction-changed(float);
    callback rate-reduction-changed(float);
    callback output-gain-changed(float);
    callback load-sample-clicked();
    callback previous-sample-clicked();
    callback next-sample-clicked();
    callback waveform-view-changed(float, float);
    callback snap-to-zero-changed(bool);
    callback snap-markers-clicked();

    // Maps a position normalized against the whole sample (0..1) to a
    // position normalized against the currently visible zoom window, for
    // markers/playhead drawn over the (possibly windowed) waveform bars.
    pure function to-view(pos: float) -> float {
        return (pos - root.waveform-view-offset) / max(0.0001, root.waveform-view-visible-fraction);
    }

    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 3px;
            DevicePageButton { text: "SAMPLE"; active: root.page == 0; clicked => { root.page = 0; } }
            DevicePageButton { text: "VOICE"; active: root.page == 1; clicked => { root.page = 1; } }
            DevicePageButton { text: "TONE"; active: root.page == 2; clicked => { root.page = 2; } }
            Rectangle { horizontal-stretch: 1; }
            // The trim belongs to the patch, not to a page, so it sits in the
            // page bar and stays reachable from all three. One control: the
            // channel fader in the rack rail is still the mix level.
            Text {
                text: "OUTPUT";
                color: Theme.text-faint;
                font-size: 8px;
                vertical-alignment: center;
            }
            TrimKnob {
                diameter: 22px;
                label: "Output";
                value: GainMath.linear-to-db(root.output-gain);
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[22];
                modulation-depth: root.modulation-depths[22];
                modulation-offset: root.modulation-offsets[22];
                modulation-route-count: root.modulation-route-counts[22];
                changed(v) => {
                    // Restate the linear value locally so the knob tracks the
                    // drag instead of waiting for the engine's params to come
                    // back around.
                    root.output-gain = GainMath.db-to-linear(v);
                    root.output-gain-changed(root.output-gain);
                }
                modulation-depth-changed(v) => { root.modulation-depth-changed(22, v); }
                modulation-edit-started => { root.modulation-edit-started(22); }
                modulation-edit-finished => { root.modulation-edit-finished(22); }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        if root.page == 0 : VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 3px;
                ToolButton {
                    icon: SamplerDeviceIcons.previous; tooltip: "Previous sample";
                    enabled: root.can-previous-sample; min-width: 28px; max-width: 28px;
                    clicked => { root.previous-sample-clicked(); }
                }
                ToolButton {
                    icon: SamplerDeviceIcons.search; tooltip: "Load sample";
                    min-width: 28px; max-width: 28px;
                    clicked => { root.load-sample-clicked(); }
                }
                ToolButton {
                    icon: SamplerDeviceIcons.next; tooltip: "Next sample";
                    enabled: root.can-next-sample; min-width: 28px; max-width: 28px;
                    clicked => { root.next-sample-clicked(); }
                }
                VerticalLayout {
                    min-width: 130px; horizontal-stretch: 1; spacing: 0px;
                    Text {
                        text: root.sample-name == "" ? "No sample loaded" : root.sample-name;
                        color: root.sample-name == "" ? Theme.text-faint : Theme.text;
                        font-size: 10px; overflow: elide;
                    }
                    Text { text: root.sample-description; color: Theme.text-faint; font-size: 8px; overflow: elide; }
                }
                StepperField {
                    label: "ROOT"; value <=> root.root-note; minimum: 0; maximum: 127; step: 1; value-width: 24px;
                    tooltip: "MIDI root note for original sample pitch";
                    changed(v) => { root.root-note-changed(v); }
                }
                ToolButton {
                    icon: SamplerDeviceIcons.reverse; tooltip: "Reverse";
                    active: root.reverse-playback; min-width: 28px; max-width: 28px;
                    clicked => { root.reverse-playback = !root.reverse-playback; root.reverse-playback-changed(root.reverse-playback); }
                }
                SelectorBank {
                    options: ["Off", "Loop", "Pong"];
                    selected-index <=> root.loop-mode;
                    segment-width: 42px;
                    tooltip: "Loop mode";
                    selected(i) => { root.loop-mode-changed(i); }
                }
            }

            waveform-view := Rectangle {
                vertical-stretch: 1;
                min-height: 105px;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                clip: true;
                for tick in 9 : Rectangle {
                    x: tick * parent.width / 8;
                    width: 1px; height: parent.height;
                    background: Theme.border; opacity: 0.45;
                }
                Rectangle {
                    width: clamp(root.to-view(root.start-pos), 0, 1) * parent.width;
                    height: parent.height; background: Theme.background; opacity: 0.66;
                }
                Rectangle {
                    x: clamp(root.to-view(root.end-pos), 0, 1) * parent.width;
                    width: parent.width - self.x;
                    height: parent.height; background: Theme.background; opacity: 0.66;
                }
                if root.loop-mode != 0 : Rectangle {
                    x: clamp(root.to-view(clamp(root.loop-start, root.start-pos, root.end-pos)), 0, 1) * parent.width;
                    width: max(1px, (clamp(root.to-view(clamp(root.loop-end, root.start-pos, root.end-pos)), 0, 1)
                        - clamp(root.to-view(clamp(root.loop-start, root.start-pos, root.end-pos)), 0, 1)) * parent.width);
                    height: parent.height; background: Theme.accent-active; opacity: 0.32;
                }
                Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border; }
                for amplitude[index] in root.waveform : Rectangle {
                    x: index * parent.width / max(1, root.waveform.length);
                    y: (parent.height - self.height) / 2;
                    width: max(1px, parent.width / max(1, root.waveform.length));
                    height: max(1px, amplitude * (parent.height - 18px));
                    background: Theme.text-muted;
                }
                // A faint moving line per actively playing voice — layered
                // retriggers show as several lines rather than one, since
                // that is what is actually sounding.
                for position in root.playhead-positions : Rectangle {
                    x: clamp(root.to-view(position), 0, 1) * (parent.width - 1px);
                    width: 1px; height: parent.height;
                    background: Theme.text;
                    opacity: root.to-view(position) >= 0 && root.to-view(position) <= 1 ? 0.55 : 0.0;
                }
                SampleMarker {
                    x: clamp(root.to-view(root.start-pos), 0, 1) * (parent.width - 1px); height: parent.height;
                    opacity: root.to-view(root.start-pos) >= 0 && root.to-view(root.start-pos) <= 1 ? 1.0 : 0.0;
                    editor-width: parent.width; marker-label: "S"; marker-color: Theme.accent;
                    moved(v) => {
                        let abs = root.waveform-view-offset + v * root.waveform-view-visible-fraction;
                        root.start-pos = min(abs, root.end-pos - 0.001); root.start-pos-changed(root.start-pos);
                        if (root.loop-start < root.start-pos) { root.loop-start = root.start-pos; root.loop-start-changed(root.loop-start); }
                    }
                }
                SampleMarker {
                    x: clamp(root.to-view(root.end-pos), 0, 1) * (parent.width - 1px); height: parent.height;
                    opacity: root.to-view(root.end-pos) >= 0 && root.to-view(root.end-pos) <= 1 ? 1.0 : 0.0;
                    editor-width: parent.width; marker-label: "E"; marker-color: Theme.accent; label-at-bottom: true;
                    moved(v) => {
                        let abs = root.waveform-view-offset + v * root.waveform-view-visible-fraction;
                        root.end-pos = max(abs, root.start-pos + 0.001); root.end-pos-changed(root.end-pos);
                        if (root.loop-end > root.end-pos) { root.loop-end = root.end-pos; root.loop-end-changed(root.loop-end); }
                    }
                }
                SampleMarker {
                    x: clamp(root.to-view(root.loop-start), 0, 1) * (parent.width - 1px); height: parent.height;
                    opacity: root.to-view(root.loop-start) >= 0 && root.to-view(root.loop-start) <= 1 ? 1.0 : 0.0;
                    editor-width: parent.width; marker-label: "L"; marker-color: root.loop-mode == 0 ? Theme.text-faint : Theme.warning; label-at-bottom: true;
                    moved(v) => {
                        let abs = root.waveform-view-offset + v * root.waveform-view-visible-fraction;
                        root.loop-start = clamp(abs, root.start-pos, root.loop-end - 0.001); root.loop-start-changed(root.loop-start);
                    }
                }
                SampleMarker {
                    x: clamp(root.to-view(root.loop-end), 0, 1) * (parent.width - 1px); height: parent.height;
                    opacity: root.to-view(root.loop-end) >= 0 && root.to-view(root.loop-end) <= 1 ? 1.0 : 0.0;
                    editor-width: parent.width; marker-label: "R"; marker-color: root.loop-mode == 0 ? Theme.text-faint : Theme.warning;
                    moved(v) => {
                        let abs = root.waveform-view-offset + v * root.waveform-view-visible-fraction;
                        root.loop-end = clamp(abs, root.loop-start + 0.001, root.end-pos); root.loop-end-changed(root.loop-end);
                    }
                }
            }

            ZoomScrollBar {
                height: 12px;
                offset: root.waveform-view-offset;
                visible-fraction: root.waveform-view-visible-fraction;
                scrolled(v) => {
                    root.waveform-view-offset = v;
                    root.waveform-view-changed(root.waveform-view-offset, root.waveform-view-visible-fraction);
                }
                zoomed(o, f) => {
                    root.waveform-view-offset = o;
                    root.waveform-view-visible-fraction = f;
                    root.waveform-view-changed(o, f);
                }
            }

            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        MiniKnob {
                            diameter: 28px; fill: Theme.accent;
                            label: "Coarse tuning";
                            value <=> root.tune-semitones; minimum: -24; maximum: 24; default-value: 0; step: 1;
                            value-text: (root.tune-semitones > 0 ? "+" : "") + round(root.tune-semitones) + " st";
                            changed(v) => { root.tune-semitones-changed(v); }
                        }
                        MiniKnob {
                            diameter: 28px; fill: Theme.accent;
                            label: "Fine tuning";
                            value <=> root.tune-cents; minimum: -100; maximum: 100; default-value: 0; step: 1;
                            value-text: (root.tune-cents > 0 ? "+" : "") + round(root.tune-cents) + " ct";
                            changed(v) => { root.tune-cents-changed(v); }
                        }
                    }
                    // Musically meaningful readout for the coarse/fine pair:
                    // the note name and frequency the tuned root note lands
                    // on, since "+3 st / +40 ct" alone doesn't say what pitch
                    // that actually is. Doubles as the pair's label, now that
                    // the individual "Coarse"/"Fine" captions are gone (the
                    // tooltip still names each knob on hover).
                    Text { text: root.tune-label; font-size: 8px; color: Theme.text-muted; horizontal-alignment: center; }
                }
                Rectangle { width: 1px; background: Theme.border; }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 4px;
                        SampleField {
                            label: "S"; tooltip: "Start frame";
                            value: round(root.start-pos * root.sample-frames);
                            maximum: root.sample-frames;
                            changed(v) => {
                                let abs = root.sample-frames > 0 ? v / root.sample-frames : 0;
                                root.start-pos = min(abs, root.end-pos - 0.001); root.start-pos-changed(root.start-pos);
                                if (root.loop-start < root.start-pos) { root.loop-start = root.start-pos; root.loop-start-changed(root.loop-start); }
                            }
                        }
                        SampleField {
                            label: "E"; tooltip: "End frame";
                            value: round(root.end-pos * root.sample-frames);
                            maximum: root.sample-frames;
                            changed(v) => {
                                let abs = root.sample-frames > 0 ? v / root.sample-frames : 1;
                                root.end-pos = max(abs, root.start-pos + 0.001); root.end-pos-changed(root.end-pos);
                                if (root.loop-end > root.end-pos) { root.loop-end = root.end-pos; root.loop-end-changed(root.loop-end); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        SampleField {
                            label: "L"; tooltip: "Loop start frame";
                            value: round(root.loop-start * root.sample-frames);
                            maximum: root.sample-frames;
                            changed(v) => {
                                let abs = root.sample-frames > 0 ? v / root.sample-frames : 0;
                                root.loop-start = clamp(abs, root.start-pos, root.loop-end - 0.001); root.loop-start-changed(root.loop-start);
                            }
                        }
                        SampleField {
                            label: "R"; tooltip: "Loop end frame";
                            value: round(root.loop-end * root.sample-frames);
                            maximum: root.sample-frames;
                            changed(v) => {
                                let abs = root.sample-frames > 0 ? v / root.sample-frames : 1;
                                root.loop-end = clamp(abs, root.loop-start + 0.001, root.end-pos); root.loop-end-changed(root.loop-end);
                            }
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.border; }
                // Beside the marker fields rather than under them: the face is
                // a fixed 3U and a third row falls off the bottom of it.
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    ToggleButton {
                        text: "AUTO"; min-width: 44px; max-width: 44px; min-height: 20px;
                        tooltip: "Snap markers to zero crossings while editing";
                        checked <=> root.snap-to-zero;
                        toggled(v) => { root.snap-to-zero-changed(v); }
                    }
                    ToolButton {
                        text: "SNAP"; min-width: 44px; max-width: 44px; min-height: 20px;
                        tooltip: "Snap all four markers to zero crossings now";
                        clicked => { root.snap-markers-clicked(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        if root.page == 1 : HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 200px; background: Theme.panel; border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px; spacing: 6px;
                    Text { text: "VOICE"; color: Theme.text-faint; font-size: 8px; }
                    SelectorBank { options: ["One Shot", "Gate"]; selected-index <=> root.voice-mode; segment-width: 74px; tooltip: "Playback mode"; selected(i) => { root.voice-mode-changed(i); } }
                    SelectorBank { options: ["Restart", "Layer"]; selected-index <=> root.retrigger-mode; segment-width: 74px; tooltip: "Retrigger behavior"; selected(i) => { root.retrigger-mode-changed(i); } }
                    StepperField { label: "VOICES"; value <=> root.polyphony; minimum: 1; maximum: 16; step: 1; value-width: 18px; tooltip: "Maximum simultaneous voices"; changed(v) => { root.polyphony-changed(v); } }
                    StepperField { label: "CHOKE"; value <=> root.choke-group; minimum: 0; maximum: 16; step: 1; value-width: 18px; tooltip: "Matching non-zero groups choke each other"; changed(v) => { root.choke-group-changed(v); } }
                }
            }
            Rectangle {
                horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px; spacing: 4px;
                    Text { text: "AMPLITUDE"; color: Theme.text-faint; font-size: 8px; }
                    EnvelopeEditor {
                        height: 78px;
                        attack <=> root.attack; decay <=> root.decay; sustain <=> root.sustain; release <=> root.release;
                        attack-text: round(root.attack * 5000) + " ms"; decay-text: round(root.decay * 5000) + " ms"; sustain-text: round(root.sustain * 100) + "%"; release-text: round(root.release * 5000) + " ms";
                        attack-changed(v) => { root.attack-changed(v); } decay-changed(v) => { root.decay-changed(v); } sustain-changed(v) => { root.sustain-changed(v); } release-changed(v) => { root.release-changed(v); }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        ParameterKnob { diameter: 36px; label: "Attack"; tooltip: "Amplitude attack"; value <=> root.attack; default-value: 0; value-text: round(root.attack * 5000) + " ms"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[8]; modulation-depth: root.modulation-depths[8]; modulation-offset: root.modulation-offsets[8]; modulation-route-count: root.modulation-route-counts[8]; changed(v) => { root.attack-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(8, v); } modulation-edit-started => { root.modulation-edit-started(8); } modulation-edit-finished => { root.modulation-edit-finished(8); } }
                        ParameterKnob { diameter: 36px; label: "Decay"; tooltip: "Amplitude decay"; value <=> root.decay; default-value: 0.05; value-text: round(root.decay * 5000) + " ms"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[9]; modulation-depth: root.modulation-depths[9]; modulation-offset: root.modulation-offsets[9]; modulation-route-count: root.modulation-route-counts[9]; changed(v) => { root.decay-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(9, v); } modulation-edit-started => { root.modulation-edit-started(9); } modulation-edit-finished => { root.modulation-edit-finished(9); } }
                        ParameterKnob { diameter: 36px; label: "Sustain"; tooltip: "Amplitude sustain"; value <=> root.sustain; default-value: 1; value-text: round(root.sustain * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[10]; modulation-depth: root.modulation-depths[10]; modulation-offset: root.modulation-offsets[10]; modulation-route-count: root.modulation-route-counts[10]; changed(v) => { root.sustain-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(10, v); } modulation-edit-started => { root.modulation-edit-started(10); } modulation-edit-finished => { root.modulation-edit-finished(10); } }
                        ParameterKnob { diameter: 36px; label: "Release"; tooltip: "Amplitude release"; value <=> root.release; default-value: 0.01; value-text: round(root.release * 5000) + " ms"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[11]; modulation-depth: root.modulation-depths[11]; modulation-offset: root.modulation-offsets[11]; modulation-route-count: root.modulation-route-counts[11]; changed(v) => { root.release-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(11, v); } modulation-edit-started => { root.modulation-edit-started(11); } modulation-edit-finished => { root.modulation-edit-finished(11); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        if root.page == 2 : HorizontalLayout {
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 3; background: Theme.panel; border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px; spacing: 4px;
                    Text { text: "FILTER / DRIVE"; color: Theme.text-faint; font-size: 8px; }
                    FilterResponseDisplay {
                        vertical-stretch: 1;
                        mode: 0;
                        cutoff: root.filter-cutoff;
                        resonance: root.filter-resonance;
                        env-amount: root.filter-env * 2 - 1;
                    }
                    HorizontalLayout {
                        spacing: 5px;
                        ParameterKnob {
                            diameter: 36px; label: "Cutoff"; tooltip: "Low-pass cutoff";
                            value <=> root.filter-cutoff; default-value: 1;
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[12];
                            modulation-depth: root.modulation-depths[12];
                            modulation-offset: root.modulation-offsets[12];
                            modulation-route-count: root.modulation-route-counts[12];
                            value-text: NoteFormat.frequency-value(20 * pow(1000, root.filter-cutoff));
                            changed(v) => { root.filter-cutoff-changed(v); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(12, v); }
                            modulation-edit-started => { root.modulation-edit-started(12); }
                            modulation-edit-finished => { root.modulation-edit-finished(12); }
                        }
                        ParameterKnob { diameter: 36px; label: "Reso"; tooltip: "Filter resonance"; value <=> root.filter-resonance; default-value: 0; value-text: round(root.filter-resonance * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[13]; modulation-depth: root.modulation-depths[13]; modulation-offset: root.modulation-offsets[13]; modulation-route-count: root.modulation-route-counts[13]; changed(v) => { root.filter-resonance-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(13, v); } modulation-edit-started => { root.modulation-edit-started(13); } modulation-edit-finished => { root.modulation-edit-finished(13); } }
                        ParameterKnob { diameter: 36px; label: "Env"; tooltip: "Envelope modulation"; value <=> root.filter-env; default-value: 0.5; bipolar: true; value-text: (round((root.filter-env * 2 - 1) * 100) > 0 ? "+" : "") + round((root.filter-env * 2 - 1) * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[14]; modulation-depth: root.modulation-depths[14]; modulation-offset: root.modulation-offsets[14]; modulation-route-count: root.modulation-route-counts[14]; changed(v) => { root.filter-env-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(14, v); } modulation-edit-started => { root.modulation-edit-started(14); } modulation-edit-finished => { root.modulation-edit-finished(14); } }
                        ParameterKnob { diameter: 36px; label: "Drive"; tooltip: "Pre-filter saturation"; value <=> root.drive; default-value: 0; value-text: round(root.drive * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[15]; modulation-depth: root.modulation-depths[15]; modulation-offset: root.modulation-offsets[15]; modulation-route-count: root.modulation-route-counts[15]; changed(v) => { root.drive-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(15, v); } modulation-edit-started => { root.modulation-edit-started(15); } modulation-edit-finished => { root.modulation-edit-finished(15); } }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 2; background: Theme.panel; border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px; spacing: 4px;
                    Text { text: "LO-FI"; color: Theme.text-faint; font-size: 8px; }
                    BitcrusherTrace {
                        vertical-stretch: 1;
                        bit-reduction: root.bit-reduction;
                        rate-reduction: root.rate-reduction;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ParameterKnob { label: "Bits"; tooltip: "Bit-depth reduction"; value <=> root.bit-reduction; default-value: 0; value-text: round(16 - root.bit-reduction * 12) + " bit"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[16]; modulation-depth: root.modulation-depths[16]; modulation-offset: root.modulation-offsets[16]; modulation-route-count: root.modulation-route-counts[16]; changed(v) => { root.bit-reduction-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(16, v); } modulation-edit-started => { root.modulation-edit-started(16); } modulation-edit-finished => { root.modulation-edit-finished(16); } }
                        ParameterKnob { label: "Rate"; tooltip: "Sample-rate reduction"; value <=> root.rate-reduction; default-value: 0; value-text: "÷" + round(1 + root.rate-reduction * 31); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[17]; modulation-depth: root.modulation-depths[17]; modulation-offset: root.modulation-offsets[17]; modulation-route-count: root.modulation-route-counts[17]; changed(v) => { root.rate-reduction-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(17, v); } modulation-edit-started => { root.modulation-edit-started(17); } modulation-edit-finished => { root.modulation-edit-finished(17); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
}
