import { Theme, StatusHint } from "theme.slint";
import { CutoffLaw, KnobField, MiniKnob, NoteFormat, ParameterKnob, PickerChip, SelectorBank, TimeFormat, ToggleButton, ToolButton, TrimKnob, ValueScale, ZoomScrollBar } from "controls.slint";
import { GainMath } from "gain.slint";
import { DevicePageButton } from "device-rack.slint";
import { BitcrusherTrace, FilterResponseDisplay } from "device-displays.slint";
import { EnvelopeEditor } from "envelope.slint";
import { StepperField } from "toolbar.slint";

global SamplerDeviceIcons {
    out property <string> previous: "M 10 3 L 5 8 L 10 13";
    out property <string> next: "M 6 3 L 11 8 L 6 13";
    out property <string> search: "M 10 6 A 4 4 0 1 1 2 6 A 4 4 0 1 1 10 6 Z M 9.2 9.2 L 13.5 13.5";
    out property <string> reverse: "M 12 3 L 12 13 M 12 8 L 4.5 8 M 7.3 5 L 4.3 8 L 7.3 11";
}

component SampleMarker inherits Rectangle {
    in property <color> marker-color;
    in property <string> marker-label;
    in property <length> editor-width;
    in property <bool> label-at-bottom;
    callback moved(float);

    width: 1px;
    background: root.marker-color;
    Rectangle {
        x: -3px;
        y: root.label-at-bottom ? parent.height - 8px : 0px;
        width: 7px;
        height: 7px;
        background: root.marker-color;
    }
    Text {
        x: root.x > root.editor-width - 18px ? -16px : 3px;
        y: root.label-at-bottom ? parent.height - 12px : 2px;
        text: root.marker-label;
        color: root.marker-color;
        font-size: Theme.text-sm;
    }
    TouchArea {
        x: -6px;
        width: 13px;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                root.moved(clamp((root.x + self.x + self.mouse-x) / max(1px, root.editor-width), 0, 1));
            }
        }
    }
}

// One slice boundary drawn over the waveform.
//
// Modelled on `SampleMarker` deliberately -- same press-latch drag through
// `pointer-event`, same hiding when the zoom window moves off it -- rather
// than reaching for `gestures.rs`, which is a piano-roll modifier registry
// and has nothing to say about this. What it adds is an ordinal label,
// because ordinal position is what a note selects, and two gestures the trim
// markers have no use for: pressing one auditions the slice it opens, and
// right-clicking removes the boundary.
component SliceHandle inherits Rectangle {
    in property <int> index;
    in property <length> editor-width;
    callback moved(float);
    callback auditioned();
    callback audition-released();
    callback removed();
    callback drag-started();
    callback drag-finished();

    // Whether the press that is down on this handle started a note, so the
    // matching release goes out once and only for a left button: a
    // right-click removal never auditioned anything.
    private property <bool> auditioning;

    width: 1px;
    // Its own colour rather than the trim markers' accent or the loop
    // markers' warning: with sixteen of these across the view, finding S
    // among them has to stay possible.
    background: Theme.focus;
    Text {
        x: 2px;
        y: parent.height / 2 - 5px;
        text: root.index + 1;
        color: Theme.focus;
        font-size: Theme.text-sm;
    }
    TouchArea {
        x: -4px;
        width: 9px;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                if (e.button == PointerEventButton.right) {
                    root.removed();
                } else {
                    // Hearing the slice you just grabbed is the point of
                    // grabbing it.
                    root.auditioning = true;
                    root.auditioned();
                    root.drag-started();
                }
            } else if (e.kind == PointerEventKind.up) {
                if (root.auditioning) {
                    root.auditioning = false;
                    root.audition-released();
                }
                root.drag-finished();
            } else if (e.kind == PointerEventKind.move && self.pressed) {
                root.moved(clamp((root.x + self.x + self.mouse-x) / max(1px, root.editor-width), 0, 1));
            }
        }
    }
}

// Sample-frame-accurate numeric entry, for placing trim/loop points more
// precisely than dragging a `SampleMarker` allows. No prev/next arrows
// (a sample can be hundreds of thousands of frames long, so +/-1 buttons
// would be useless) — drag or scroll to change it instead, the same idiom
// as `StepperField`, with Ctrl/Shift dropping to the finest 1-frame step
// the same way the knobs' fine-drag does. `value` is purely display-driven
// from outside (like `SampleMarker.x`); `changed` reports the proposed new
// absolute frame so the caller can clamp and convert it.
component SampleField inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    in property <int> value;
    in property <int> maximum: 1;
    callback changed(int);

    private property <int> pressed-value;
    private property <bool> fine-drag;
    private property <int> coarse-step: max(1, root.maximum / 1000);

    height: 22px;
    width: layout.preferred-width;
    border-radius: Theme.radius-md;
    background: Theme.surface-raised;
    accessible-role: spinbox;
    accessible-label: root.tooltip;

    layout := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.text-faint;
            font-size: Theme.text-sm;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: Theme.text-md;
            font-family: Theme.font-family-mono;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 48px;
        }
    }
    TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pressed-value = root.value;
                root.fine-drag = e.modifiers.control || e.modifiers.shift;
            } else if (e.kind == PointerEventKind.move && self.pressed) {
                let step = root.fine-drag ? 1 : root.coarse-step;
                let next = root.pressed-value + round((self.pressed-y - self.mouse-y) / 4px) * step;
                root.changed(clamp(next, 0, root.maximum));
            }
        }
        scroll-event(e) => {
            let step = (e.modifiers.control || e.modifiers.shift) ? 1 : root.coarse-step;
            root.changed(clamp(root.value + (e.delta-y > 0 ? step : -step), 0, root.maximum));
            accept
        }
    }
    Tooltip { text: @markdown("**\{root.tooltip}** \{root.value}"); }
}

export component SamplerDeviceFace inherits Rectangle {
    in-out property <int> page;
    in-out property <float> attack;
    in-out property <float> decay;
    in-out property <float> sustain;
    in-out property <float> release;
    in-out property <float> start-pos;
    in-out property <float> end-pos: 1;
    in-out property <float> loop-start;
    in-out property <float> loop-end;
    in-out property <bool> reverse-playback;
    in-out property <int> root-note: 60;
    in-out property <float> tune-semitones;
    in-out property <float> tune-cents;
    in-out property <string> tune-label;
    in-out property <bool> retune-live;
    in-out property <float> filter-cutoff;
    in-out property <float> filter-resonance;
    in-out property <float> filter-env;
    in property <bool> modulation-armed;
    // Indexed by descriptor id, mirroring `SAMPLER_PARAM_*` in mooloop-core, so
    // every eligible control on this face routes through one path.
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    in-out property <float> drive;
    in-out property <float> bit-reduction;
    in-out property <float> rate-reduction;
    // The patch's output trim, stored linear like the engine keeps it. The
    // knob works in dB; the conversion happens at the control, as it does on
    // the oscillator strip's Level.
    in-out property <float> output-gain;
    // The filter's own envelope, normalized like the amplitude one.
    in-out property <float> filter-attack;
    in-out property <float> filter-decay;
    in-out property <float> filter-sustain: 1.0;
    in-out property <float> filter-release;
    // Which of the FILTER panel's two internal pages is showing. A stable
    // index rather than a bool so a third view can be added without moving
    // the two that exist.
    in-out property <int> filter-view;
    in-out property <int> loop-mode;
    // The loop seam's crossfade (MOO-43), normalized through its descriptor
    // by Rust, with the readout Rust formats: the face holds no copy of the
    // range. The span is the part of the waveform the fade covers, as
    // fractions of the sample, and `loop-fade-shown` is whether there is one
    // to draw -- Rust resolves it with the voice's own arithmetic.
    in-out property <float> loop-fade;
    in property <string> loop-fade-label;
    in property <float> loop-fade-start;
    in property <float> loop-fade-end;
    in property <bool> loop-fade-shown;
    // The loop grid (MOO-47): the picked position, the options as Rust
    // names them, and the bounds the loop actually plays once snapped, as
    // fractions of the sample. The band is drawn at the snapped bounds, so a
    // moving loop reads as the grid it steps on.
    in property <int> loop-grid;
    in property <[string]> loop-grid-options;
    in property <float> loop-band-start;
    in property <float> loop-band-end: 1;
    // What fit-to-tempo is doing, in words Rust writes (MOO-39): the loop's
    // own length and tempo, and what it is fitted to. `warning` is set when
    // the bar count looks wrong, and `hint` then says why in the status bar.
    in property <string> stretch-fit-label;
    in property <bool> stretch-fit-warning;
    in property <string> stretch-fit-hint;
    // Whether a note transposes the region or picks a slice out of it.
    in-out property <int> play-mode;
    // The note that plays slice 0; each semitone above steps one slice on.
    in-out property <int> slice-base-note: 36;
    // Slice boundaries as fractions of the published buffer, ascending.
    // Fractions rather than frames so they survive the same `to-view` the
    // waveform and every other marker already go through.
    in-out property <[float]> slice-markers;
    // How many slices DIVIDE should lay down. Pure view state: the request,
    // not the result.
    in-out property <int> slice-count: 8;
    // Transient detection (MOO-44). While a preview is up, the markers it
    // proposes are drawn ghosted over the real ones, and the slice row
    // becomes its controls: sensitivity, the closest two markers may land
    // (ms), Replace, Merge, Cancel. Sensitivity and spacing are view state
    // the face owns; each change asks Rust to detect again.
    in property <bool> slice-preview;
    in property <[float]> slice-preview-markers;
    in-out property <float> slice-sensitivity: 0.5;
    in-out property <float> slice-spacing-ms: 50;
    // Writing the slices into the pattern (MOO-46). The choice is the
    // face's until it is made: whether the notes land on the step grid, and
    // whether they replace this channel's notes or join them.
    in-out property <bool> slice-pattern-open;
    in-out property <bool> slice-pattern-grid;
    // Whether the published buffer is a committed render, what it was baked
    // at, and whether the project has since moved off the tempo it was fitted
    // to. Stale is shown, never acted on: re-baking a loop underneath someone
    // is not a thing to do without being asked.
    in-out property <bool> committed;
    in-out property <string> commit-label;
    in-out property <bool> commit-stale;
    in-out property <int> voice-mode;
    in-out property <int> polyphony: 1;
    in-out property <int> retrigger-mode;
    in-out property <int> choke-group;
    in-out property <bool> stretch-enabled;
    in-out property <int> stretch-mode;
    // Normalized 0..1 like the other knobs; the real value is formatted in
    // Rust and arrives as a label, the way tuning already does.
    in-out property <float> stretch-ratio: 0.3333;
    in-out property <string> stretch-ratio-label;
    in-out property <float> stretch-grain: 0.6667;
    in-out property <string> stretch-grain-label;
    // Whether the current ratio is inside the range the spike measured as
    // clean. Shown rather than enforced -- the extremes are a destination.
    in-out property <bool> stretch-ratio-clean: true;
    in-out property <bool> stretch-sync;
    in-out property <float> stretch-bars: 0.4;
    in-out property <string> stretch-bars-label;
    in-out property <string> sample-name;
    in-out property <string> sample-description;
    in-out property <[float]> waveform;
    in-out property <[float]> playhead-positions;
    in-out property <int> sample-frames;
    // Global editing preference rather than saved sampler state: it changes
    // how a marker edit resolves, not what the instrument sounds like.
    in-out property <bool> snap-to-zero;
    in-out property <bool> can-previous-sample;
    in-out property <bool> can-next-sample;
    // Pure view state: which slice of the sample the waveform is
    // zoomed/scrolled to. Not sent to the engine, not persisted.
    in-out property <float> waveform-view-offset: 0;
    in-out property <float> waveform-view-visible-fraction: 1;

    // The RECORD page (`audio-recording/05`). Everything but the two clip
    // settings is published from Rust at the pump's rate: the take belongs to
    // the engine, and this page only shows it.
    //
    // 0 idle, 1 waiting for the bar line (the pre-roll), 2 recording.
    in property <int> record-state;
    // The take's length so far, formatted in Rust.
    in property <string> record-elapsed;
    // The take so far, one peak per bucket, 0..1, oldest first.
    in property <[float]> record-peaks;
    // How much of the width the drawn peaks fill: the take against its clip
    // length when Clip is on, all of it when the take runs free.
    in property <float> record-fill: 1;
    // What the channel's AUDIO row names, or "" when it has none.
    in property <string> record-source;
    in-out property <bool> record-clip;
    in-out property <int> record-bars: 1;
    in property <int> record-max-bars;

    callback attack-changed(float);
    callback decay-changed(float);
    callback sustain-changed(float);
    callback release-changed(float);
    callback start-pos-changed(float);
    callback end-pos-changed(float);
    callback loop-start-changed(float);
    callback loop-end-changed(float);
    callback reverse-playback-changed(bool);
    callback root-note-changed(int);
    callback tune-semitones-changed(float);
    callback tune-cents-changed(float);
    callback retune-live-changed(bool);
    callback loop-mode-changed(int);
    callback loop-fade-changed(float);
    callback loop-grid-changed(int);
    callback voice-mode-changed(int);
    callback polyphony-changed(int);
    callback retrigger-mode-changed(int);
    callback choke-group-changed(int);
    callback stretch-enabled-changed(bool);
    callback stretch-mode-changed(int);
    callback stretch-ratio-changed(float);
    callback stretch-grain-changed(float);
    callback stretch-sync-changed(bool);
    callback stretch-bars-changed(float);
    // Typed entry. Rust parses, because Rust already formats -- a unit-aware
    // parser written on both sides is one that disagrees with itself.
    callback stretch-ratio-typed(string);
    callback stretch-bars-typed(string);
    callback stretch-grain-typed(string);
    callback tune-typed(string);
    callback filter-cutoff-changed(float);
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);
    callback filter-resonance-changed(float);
    callback filter-env-changed(float);
    callback drive-changed(float);
    callback bit-reduction-changed(float);
    callback rate-reduction-changed(float);
    callback output-gain-changed(float);
    callback filter-attack-changed(float);
    callback filter-decay-changed(float);
    callback filter-sustain-changed(float);
    callback filter-release-changed(float);
    callback load-sample-clicked();
    callback previous-sample-clicked();
    callback next-sample-clicked();
    callback waveform-view-changed(float, float);
    callback snap-to-zero-changed(bool);
    callback snap-markers-clicked();
    callback play-mode-changed(int);
    callback slice-base-note-changed(int);
    callback slice-added(float);
    callback slice-moved(int, float);
    callback slice-removed(int);
    callback slice-auditioned(int);
    // The note-off half of an audition, on release of the handle. Without it
    // a gated or looping slice held until something else silenced it.
    callback slice-audition-released(int);
    callback slices-divided(int);
    callback slices-cleared();
    callback slices-detect(float, float);
    callback slices-accept(int);
    callback slices-cancel();
    callback slices-to-pattern(bool, bool);
    // Bracket a marker drag so the history collapses its frames into one
    // undo entry, the way the piano roll's gestures already do.
    callback slice-drag-started();
    callback slice-drag-finished();
    callback commit-clicked();
    callback revert-clicked();
    callback record-clicked();
    callback record-clip-changed(bool);
    callback record-bars-changed(int);

    // Maps a position normalized against the whole sample (0..1) to a
    // position normalized against the currently visible zoom window, for
    // markers/playhead drawn over the (possibly windowed) waveform bars.
    pure function to-view(pos: float) -> float {
        return (pos - root.waveform-view-offset) / max(0.0001, root.waveform-view-visible-fraction);
    }

    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 3px;
            DevicePageButton { text: "SAMPLE"; active: root.page == 0; clicked => { root.page = 0; } }
            DevicePageButton { text: "VOICE"; active: root.page == 1; clicked => { root.page = 1; } }
            DevicePageButton { text: "TONE"; active: root.page == 2; clicked => { root.page = 2; } }
            DevicePageButton { text: "RECORD"; active: root.page == 3; clicked => { root.page = 3; } }
            Rectangle { horizontal-stretch: 1; }
            // The trim belongs to the patch, not to a page, so it sits in the
            // page bar and stays reachable from all three. One control: the
            // channel fader in the rack rail is still the mix level.
            Text {
                text: "OUTPUT";
                color: Theme.text-faint;
                font-size: Theme.text-sm;
                vertical-alignment: center;
            }
            TrimKnob {
                diameter: 22px;
                label: "Output";
                value: GainMath.linear-to-db(root.output-gain);
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[22];
                modulation-depth: root.modulation-depths[22];
                modulation-offset: root.modulation-offsets[22];
                modulation-route-count: root.modulation-route-counts[22];
                changed(v) => {
                    // Restate the linear value locally so the knob tracks the
                    // drag instead of waiting for the engine's params to come
                    // back around.
                    root.output-gain = GainMath.db-to-linear(v);
                    root.output-gain-changed(root.output-gain);
                }
                modulation-depth-changed(v) => { root.modulation-depth-changed(22, v); }
                modulation-edit-started => { root.modulation-edit-started(22); }
                modulation-edit-finished => { root.modulation-edit-finished(22); }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        if root.page == 0 : VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 3px;
                ToolButton {
                    icon: SamplerDeviceIcons.previous; tooltip: "Previous sample";
                    enabled: root.can-previous-sample; min-width: 28px; max-width: 28px;
                    clicked => { root.previous-sample-clicked(); }
                }
                ToolButton {
                    icon: SamplerDeviceIcons.search; tooltip: "Load sample";
                    min-width: 28px; max-width: 28px;
                    clicked => { root.load-sample-clicked(); }
                }
                ToolButton {
                    icon: SamplerDeviceIcons.next; tooltip: "Next sample";
                    enabled: root.can-next-sample; min-width: 28px; max-width: 28px;
                    clicked => { root.next-sample-clicked(); }
                }
                VerticalLayout {
                    min-width: 130px; horizontal-stretch: 1; spacing: 0px;
                    Text {
                        text: root.sample-name == "" ? "No sample loaded" : root.sample-name;
                        color: root.sample-name == "" ? Theme.text-faint : Theme.text;
                        font-size: Theme.text-lg; overflow: elide;
                    }
                    Text { text: root.sample-description; color: Theme.text-faint; font-size: Theme.text-sm; overflow: elide; }
                }
                StepperField {
                    controlled: false;
                    label: "ROOT"; value <=> root.root-note; minimum: 0; maximum: 127; step: 1; value-width: 24px;
                    tooltip: "Root"; hint: "MIDI root note for original sample pitch";
                    changed(v) => { root.root-note-changed(v); }
                }
                ToolButton {
                    icon: SamplerDeviceIcons.reverse; tooltip: "Reverse";
                    active: root.reverse-playback; min-width: 28px; max-width: 28px;
                    clicked => { root.reverse-playback = !root.reverse-playback; root.reverse-playback-changed(root.reverse-playback); }
                }
                SelectorBank {
                    controlled: false;
                    options: ["Pitch", "Slice"];
                    selected-index <=> root.play-mode;
                    segment-width: 40px;
                    tooltip: "Pitched plays the region transposed; Slice plays one slice per note at its own pitch";
                    selected(i) => { root.play-mode-changed(i); }
                }
                SelectorBank {
                    controlled: false;
                    options: ["Off", "Loop", "Pong"];
                    selected-index <=> root.loop-mode;
                    segment-width: 42px;
                    tooltip: root.play-mode == 1
                        ? "Loop mode; in Slice mode the loop is the slice itself"
                        : "Loop mode";
                    selected(i) => { root.loop-mode-changed(i); }
                }
                // Only a forward loop has a seam: a ping-pong turnaround
                // reverses on the frame it reached.
                VerticalLayout {
                    alignment: center;
                    MiniKnob {
                        diameter: 22px; fill: Theme.warning;
                        label: "Loop fade";
                        hint: "Crossfade the loop's seam, so its end runs into its start without a click";
                        enabled: root.loop-mode == 1;
                        value <=> root.loop-fade;
                        value-text: root.loop-fade-label;
                        modulation-armed: root.modulation-armed;
                        modulation-allowed: root.modulation-allowed[36];
                        modulation-depth: root.modulation-depths[36];
                        modulation-offset: root.modulation-offsets[36];
                        modulation-route-count: root.modulation-route-counts[36];
                        changed(v) => { root.loop-fade-changed(v); }
                        modulation-depth-changed(v) => { root.modulation-depth-changed(36, v); }
                        modulation-edit-started => { root.modulation-edit-started(36); }
                        modulation-edit-finished => { root.modulation-edit-finished(36); }
                    }
                }
            }

            waveform-view := Rectangle {
                vertical-stretch: 1;
                min-height: 105px;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                clip: true;
                for tick in 9 : Rectangle {
                    x: tick * parent.width / 8;
                    width: 1px; height: parent.height;
                    background: Theme.border; opacity: 0.45;
                }
                Rectangle {
                    width: clamp(root.to-view(root.start-pos), 0, 1) * parent.width;
                    height: parent.height; background: Theme.background; opacity: 0.66;
                }
                Rectangle {
                    x: clamp(root.to-view(root.end-pos), 0, 1) * parent.width;
                    width: parent.width - self.x;
                    height: parent.height; background: Theme.background; opacity: 0.66;
                }
                // Hidden in Slice mode along with the greyed L/R markers:
                // there the loop is the slice, so a band drawn between the
                // global loop points describes nothing that happens.
                if root.loop-mode != 0 && root.play-mode == 0 : Rectangle {
                    x: clamp(root.to-view(root.loop-band-start), 0, 1) * parent.width;
                    width: max(1px, (clamp(root.to-view(root.loop-band-end), 0, 1)
                        - clamp(root.to-view(root.loop-band-start), 0, 1)) * parent.width);
                    height: parent.height; background: Theme.accent-active; opacity: 0.32;
                }
                // The loop fade's span, at the loop's end: the stretch that
                // runs into the loop's start, or out to silence when there is
                // nothing before the start to run into.
                if root.loop-fade-shown : Rectangle {
                    x: clamp(root.to-view(root.loop-fade-start), 0, 1) * parent.width;
                    width: max(1px, (clamp(root.to-view(root.loop-fade-end), 0, 1)
                        - clamp(root.to-view(root.loop-fade-start), 0, 1)) * parent.width);
                    height: parent.height; background: Theme.warning; opacity: 0.28;
                }
                Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Theme.border; }
                // Declared before the handles and the trim markers so they
                // sit on top of it: this is the empty waveform, not the
                // markers already on it. Double-click rather than click,
                // because a stray single click while reaching for a handle
                // should not add a boundary.
                if root.play-mode == 1 : TouchArea {
                    double-clicked => {
                        root.slice-added(clamp(root.waveform-view-offset
                            + (self.mouse-x / max(1px, parent.width)) * root.waveform-view-visible-fraction, 0, 1));
                    }
                }
                for amplitude[index] in root.waveform : Rectangle {
                    x: index * parent.width / max(1, root.waveform.length);
                    y: (parent.height - self.height) / 2;
                    width: max(1px, parent.width / max(1, root.waveform.length));
                    height: max(1px, amplitude * (parent.height - 18px));
                    background: Theme.text-muted;
                }
                // A faint moving line per actively playing voice — layered
                // retriggers show as several lines rather than one, since
                // that is what is actually sounding.
                for position in root.playhead-positions : Rectangle {
                    x: clamp(root.to-view(position), 0, 1) * (parent.width - 1px);
                    width: 1px; height: parent.height;
                    background: Theme.text;
                    opacity: root.to-view(position) >= 0 && root.to-view(position) <= 1 ? 0.55 : 0.0;
                }
                SampleMarker {
                    x: clamp(root.to-view(root.start-pos), 0, 1) * (parent.width - 1px); height: parent.height;
                    opacity: root.to-view(root.start-pos) >= 0 && root.to-view(root.start-pos) <= 1 ? 1.0 : 0.0;
                    editor-width: parent.width; marker-label: "S"; marker-color: Theme.accent;
                    moved(v) => {
                        let abs = root.waveform-view-offset + v * root.waveform-view-visible-fraction;
                        root.start-pos = min(abs, root.end-pos - 0.001); root.start-pos-changed(root.start-pos);
                        if (root.loop-start < root.start-pos) { root.loop-start = root.start-pos; root.loop-start-changed(root.loop-start); }
                    }
                }
                SampleMarker {
                    x: clamp(root.to-view(root.end-pos), 0, 1) * (parent.width - 1px); height: parent.height;
                    opacity: root.to-view(root.end-pos) >= 0 && root.to-view(root.end-pos) <= 1 ? 1.0 : 0.0;
                    editor-width: parent.width; marker-label: "E"; marker-color: Theme.accent; label-at-bottom: true;
                    moved(v) => {
                        let abs = root.waveform-view-offset + v * root.waveform-view-visible-fraction;
                        root.end-pos = max(abs, root.start-pos + 0.001); root.end-pos-changed(root.end-pos);
                        if (root.loop-end > root.end-pos) { root.loop-end = root.end-pos; root.loop-end-changed(root.loop-end); }
                    }
                }
                SampleMarker {
                    x: clamp(root.to-view(root.loop-start), 0, 1) * (parent.width - 1px); height: parent.height;
                    opacity: root.to-view(root.loop-start) >= 0 && root.to-view(root.loop-start) <= 1 ? 1.0 : 0.0;
                    editor-width: parent.width; marker-label: "L"; marker-color: root.loop-mode == 0 || root.play-mode == 1 ? Theme.text-faint : Theme.warning; label-at-bottom: true;
                    moved(v) => {
                        let abs = root.waveform-view-offset + v * root.waveform-view-visible-fraction;
                        root.loop-start = clamp(abs, root.start-pos, root.loop-end - 0.001); root.loop-start-changed(root.loop-start);
                    }
                }
                SampleMarker {
                    x: clamp(root.to-view(root.loop-end), 0, 1) * (parent.width - 1px); height: parent.height;
                    opacity: root.to-view(root.loop-end) >= 0 && root.to-view(root.loop-end) <= 1 ? 1.0 : 0.0;
                    editor-width: parent.width; marker-label: "R"; marker-color: root.loop-mode == 0 || root.play-mode == 1 ? Theme.text-faint : Theme.warning;
                    moved(v) => {
                        let abs = root.waveform-view-offset + v * root.waveform-view-visible-fraction;
                        root.loop-end = clamp(abs, root.loop-start + 0.001, root.end-pos); root.loop-end-changed(root.loop-end);
                    }
                }
                // A detection preview, ghosted: what Replace or Merge would
                // lay down. Drawn, not handled; the row below decides.
                if root.slice-preview : Rectangle {
                    for position in root.slice-preview-markers : Rectangle {
                        x: clamp(root.to-view(position), 0, 1) * (parent.width - 1px);
                        width: 1px;
                        height: parent.height;
                        background: Theme.focus;
                        opacity: root.to-view(position) >= 0 && root.to-view(position) <= 1 ? 0.45 : 0.0;
                    }
                }
                // Last, so a handle sitting under a trim marker is the one
                // the pointer finds: the trim markers are two fixed points a
                // user rarely moves, and the slices are what this mode is for.
                if root.play-mode == 1 : Rectangle {
                    for position[index] in root.slice-markers : SliceHandle {
                        x: clamp(root.to-view(position), 0, 1) * (parent.width - 1px);
                        height: parent.height;
                        opacity: root.to-view(position) >= 0 && root.to-view(position) <= 1 ? 1.0 : 0.0;
                        index: index;
                        editor-width: parent.width;
                        moved(v) => {
                            root.slice-moved(index, clamp(root.waveform-view-offset
                                + v * root.waveform-view-visible-fraction, 0, 1));
                        }
                        auditioned => { root.slice-auditioned(index); }
                        audition-released => { root.slice-audition-released(index); }
                        removed => { root.slice-removed(index); }
                        drag-started => { root.slice-drag-started(); }
                        drag-finished => { root.slice-drag-finished(); }
                    }
                }
            }

            ZoomScrollBar {
                height: 12px;
                offset: root.waveform-view-offset;
                visible-fraction: root.waveform-view-visible-fraction;
                scrolled(v) => {
                    root.waveform-view-offset = v;
                    root.waveform-view-changed(root.waveform-view-offset, root.waveform-view-visible-fraction);
                }
                zoomed(o, f) => {
                    root.waveform-view-offset = o;
                    root.waveform-view-visible-fraction = f;
                    root.waveform-view-changed(o, f);
                }
            }

            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 4px;
                        SampleField {
                            label: "S"; tooltip: "Start frame";
                            value: round(root.start-pos * root.sample-frames);
                            maximum: root.sample-frames;
                            changed(v) => {
                                let abs = root.sample-frames > 0 ? v / root.sample-frames : 0;
                                root.start-pos = min(abs, root.end-pos - 0.001); root.start-pos-changed(root.start-pos);
                                if (root.loop-start < root.start-pos) { root.loop-start = root.start-pos; root.loop-start-changed(root.loop-start); }
                            }
                        }
                        SampleField {
                            label: "E"; tooltip: "End frame";
                            value: round(root.end-pos * root.sample-frames);
                            maximum: root.sample-frames;
                            changed(v) => {
                                let abs = root.sample-frames > 0 ? v / root.sample-frames : 1;
                                root.end-pos = max(abs, root.start-pos + 0.001); root.end-pos-changed(root.end-pos);
                                if (root.loop-end > root.end-pos) { root.loop-end = root.end-pos; root.loop-end-changed(root.loop-end); }
                            }
                        }
                        // The break back as notes: one per slice, where it
                        // falls, into this channel's current pattern.
                        if root.play-mode == 1 && !root.slice-preview && !root.slice-pattern-open : ToolButton {
                            text: "PATTERN"; min-width: 58px; max-width: 58px; min-height: 20px;
                            tooltip: "Pattern from slices"; hint: "Write a note for each slice where it falls, into this channel's pattern";
                            clicked => { root.slice-pattern-open = true; }
                        }
                    }
                    // The slice row takes the loop row's place rather than
                    // adding one: the face is a fixed 3U, a third row falls
                    // off the bottom of it, and in Slice mode the global loop
                    // points are not what loops anyway -- the slice is.
                    if root.play-mode == 0 : HorizontalLayout {
                        spacing: 4px;
                        SampleField {
                            label: "L"; tooltip: "Loop start frame";
                            value: round(root.loop-start * root.sample-frames);
                            maximum: root.sample-frames;
                            changed(v) => {
                                let abs = root.sample-frames > 0 ? v / root.sample-frames : 0;
                                root.loop-start = clamp(abs, root.start-pos, root.loop-end - 0.001); root.loop-start-changed(root.loop-start);
                            }
                        }
                        SampleField {
                            label: "R"; tooltip: "Loop end frame";
                            value: round(root.loop-end * root.sample-frames);
                            maximum: root.sample-frames;
                            changed(v) => {
                                let abs = root.sample-frames > 0 ? v / root.sample-frames : 1;
                                root.loop-end = clamp(abs, root.loop-start + 0.001, root.end-pos); root.loop-end-changed(root.loop-end);
                            }
                        }
                        // What the loop's bounds snap to: free, the slice
                        // markers, or a division of the sample's bar count.
                        PickerChip {
                            options: root.loop-grid-options;
                            selected-index: root.loop-grid;
                            tooltip: "Loop grid: snap the loop's bounds to slices or a division of the bar";
                            picked(i) => { root.loop-grid-changed(i); }
                        }
                    }
                    if root.play-mode == 1 && root.slice-preview : HorizontalLayout {
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            MiniKnob {
                                label: "Sensitivity";
                                hint: "How quiet a hit still gets a marker";
                                value <=> root.slice-sensitivity;
                                value-text: round(root.slice-sensitivity * 100) + "%";
                                changed(v) => { root.slices-detect(v, root.slice-spacing-ms); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            MiniKnob {
                                label: "Spacing";
                                hint: "The closest two markers may land: a flam or a roll faster than this is one slice";
                                minimum: 10; maximum: 250; default-value: 50;
                                value <=> root.slice-spacing-ms;
                                value-text: round(root.slice-spacing-ms) + " ms";
                                changed(v) => { root.slices-detect(root.slice-sensitivity, v); }
                            }
                        }
                        ToolButton {
                            text: "REPLACE"; min-width: 56px; max-width: 56px; min-height: 20px;
                            tooltip: "Replace"; hint: "Keep the markers you placed by hand and replace the rest";
                            clicked => { root.slices-accept(0); }
                        }
                        ToolButton {
                            text: "MERGE"; min-width: 46px; max-width: 46px; min-height: 20px;
                            tooltip: "Merge"; hint: "Keep every marker, and add the detected ones that aren't beside one";
                            clicked => { root.slices-accept(1); }
                        }
                        ToolButton {
                            text: "CANCEL"; min-width: 50px; max-width: 50px; min-height: 20px;
                            tooltip: "Cancel"; hint: "Drop the preview and change nothing";
                            clicked => { root.slices-cancel(); }
                        }
                    }
                    if root.play-mode == 1 && root.slice-pattern-open : HorizontalLayout {
                        spacing: 4px;
                        ToggleButton {
                            text: "1/16"; min-width: 40px; max-width: 40px; max-height: 20px;
                            tooltip: "Quantize"; hint: "Put each note on the nearest sixteenth; off keeps the break's own timing";
                            checked <=> root.slice-pattern-grid;
                        }
                        ToolButton {
                            text: "REPLACE"; min-width: 56px; max-width: 56px; min-height: 20px;
                            tooltip: "Replace"; hint: "Clear this channel's notes in the pattern, then write the slices";
                            clicked => { root.slice-pattern-open = false; root.slices-to-pattern(true, root.slice-pattern-grid); }
                        }
                        ToolButton {
                            text: "ADD"; min-width: 40px; max-width: 40px; min-height: 20px;
                            tooltip: "Add"; hint: "Write the slices beside this channel's notes in the pattern";
                            clicked => { root.slice-pattern-open = false; root.slices-to-pattern(false, root.slice-pattern-grid); }
                        }
                        ToolButton {
                            text: "CANCEL"; min-width: 50px; max-width: 50px; min-height: 20px;
                            tooltip: "Cancel"; hint: "Write nothing";
                            clicked => { root.slice-pattern-open = false; }
                        }
                    }
                    if root.play-mode == 1 && !root.slice-preview && !root.slice-pattern-open : HorizontalLayout {
                        spacing: 4px;
                        StepperField {
                            controlled: false;
                            label: "BASE"; value <=> root.slice-base-note;
                            minimum: 0; maximum: 127; step: 1; value-width: 26px;
                            display-text: NoteFormat.midi-name(root.slice-base-note);
                            tooltip: "Base note"; hint: "The note that plays the first slice";
                            changed(v) => { root.slice-base-note-changed(v); }
                        }
                        StepperField {
                            controlled: false;
                            label: "N"; value <=> root.slice-count;
                            minimum: 1; maximum: 128; step: 1; value-width: 20px;
                            tooltip: "Slices"; hint: "How many slices DIVIDE lays down";
                        }
                        ToolButton {
                            text: "DIVIDE"; min-width: 46px; max-width: 46px; min-height: 20px;
                            tooltip: "Divide"; hint: "Replace the slices with equal divisions of the playback region";
                            clicked => { root.slices-divided(root.slice-count); }
                        }
                        ToolButton {
                            text: "DETECT"; min-width: 48px; max-width: 48px; min-height: 20px;
                            tooltip: "Detect"; hint: "Find the hits and preview a marker on each";
                            clicked => { root.slices-detect(root.slice-sensitivity, root.slice-spacing-ms); }
                        }
                        ToolButton {
                            text: "CLEAR"; min-width: 42px; max-width: 42px; min-height: 20px;
                            tooltip: "Clear"; hint: "Remove every slice";
                            clicked => { root.slices-cleared(); }
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.border; }
                // Beside the marker fields rather than under them: the face is
                // a fixed 3U and a third row falls off the bottom of it.
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    ToggleButton {
                        controlled: false;
                        text: "AUTO"; min-width: 44px; max-width: 44px; min-height: 20px;
                        tooltip: "Zero-cross"; hint: "Snap markers to zero crossings while editing";
                        checked <=> root.snap-to-zero;
                        toggled(v) => { root.snap-to-zero-changed(v); }
                    }
                    ToolButton {
                        text: "SNAP"; min-width: 44px; max-width: 44px; min-height: 20px;
                        tooltip: "Zero-cross"; hint: "Snap all four markers to zero crossings now";
                        clicked => { root.snap-markers-clicked(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        if root.page == 1 : HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 168px; background: Theme.panel; border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px; spacing: 6px;
                    Text { text: "VOICE"; color: Theme.text-faint; font-size: Theme.text-sm; }
                    SelectorBank { controlled: false; options: ["One Shot", "Gate"]; selected-index <=> root.voice-mode; segment-width: 74px; tooltip: "Playback mode"; selected(i) => { root.voice-mode-changed(i); } }
                    SelectorBank { controlled: false; options: ["Restart", "Layer"]; selected-index <=> root.retrigger-mode; segment-width: 74px; tooltip: "Retrigger behavior"; selected(i) => { root.retrigger-mode-changed(i); } }
                    StepperField { controlled: false; label: "VOICES"; value <=> root.polyphony; minimum: 1; maximum: 16; step: 1; value-width: 18px; tooltip: "Voices"; hint: "Maximum simultaneous voices"; changed(v) => { root.polyphony-changed(v); } }
                    StepperField { controlled: false; label: "CHOKE"; value <=> root.choke-group; minimum: 0; maximum: 16; step: 1; value-width: 18px; tooltip: "Choke"; hint: "Matching non-zero groups choke each other"; changed(v) => { root.choke-group-changed(v); } }
                    // Without this the column shares its slack out between the
                    // rows, floating them into the middle of an empty panel.
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Rectangle {
                width: 204px; background: Theme.panel; border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px; spacing: 4px;
                    HorizontalLayout {
                        spacing: 4px;
                        // Pitch and speed live together because fit-to-tempo
                        // makes them a pair: with it on, transposing a voice
                        // does not change how long it lasts, so they are two
                        // independent axes of one gesture rather than two
                        // settings that happen to both affect playback.
                        Text { text: "PITCH & SPEED"; color: Theme.text-faint; font-size: Theme.text-sm; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleButton {
                            controlled: false;
                            text: "ON";
                            tooltip: "Stretch";
                            // Live stretch is bypassed rather than refused in
                            // Slice mode, in reverse, and in Pong: the DSP
                            // declines to run WSOLA backwards and a commit is
                            // the answer. The toggle stays lit in all three,
                            // which used to leave nothing on screen saying
                            // why -- this face had no way to reach the status
                            // bar until `StatusHint` existed.
                            hint: root.play-mode == 1
                                ? "Bypassed in Slice mode. Commit the stretch to bake it in."
                                : root.reverse-playback
                                ? "Bypassed in reverse. Commit the stretch to bake it in."
                                : root.loop-mode == 2
                                ? "Bypassed in Pong. Commit the stretch to bake it in."
                                : "Time stretching";
                            // Bounded, or the layout hands a toggle the whole
                            // width the title row is not using.
                            min-width: 40px; max-width: 40px; max-height: 20px;
                            checked <=> root.stretch-enabled;
                            toggled(on) => { root.stretch-enabled-changed(on); }
                        }
                    }

                    // Coarse and fine tune on one line, so the whole group
                    // fits a 3U face with the stretch controls under it.
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        KnobField {
                            controlled: false;
                            label: "Tune";
                            tooltip: root.tune-label;
                            diameter: 28px;
                            value <=> root.tune-semitones;
                            minimum: -24; maximum: 24; default-value: 0; step: 1;
                            bipolar: true;
                            field-width: 84px;
                            display-text: root.tune-label;
                            changed(v) => { root.tune-semitones-changed(v); }
                            text-committed(t) => { root.tune-typed(t); }
                        }
                        VerticalLayout {
                            alignment: center;
                            MiniKnob {
                                controlled: false;
                                diameter: 22px; fill: Theme.accent;
                                label: "Fine tuning";
                                value <=> root.tune-cents; minimum: -100; maximum: 100; default-value: 0; step: 1;
                                bipolar: true;
                                value-text: (root.tune-cents > 0 ? "+" : "") + round(root.tune-cents) + " ct";
                                changed(v) => { root.tune-cents-changed(v); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "RETUNE";
                            color: Theme.text-faint;
                            font-size: Theme.text-sm;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleButton {
                            controlled: false;
                            text: "LIVE";
                            // Off reproduces the sampler's original behavior:
                            // a held or looping voice keeps the pitch it was
                            // triggered with until it is triggered again.
                            tooltip: root.retune-live
                                ? "A tune edit is heard on sounding voices immediately"
                                : "A tune edit only reaches the next triggered voice";
                            min-width: 40px; max-width: 40px; max-height: 16px;
                            checked <=> root.retune-live;
                            toggled(on) => { root.retune-live-changed(on); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        SelectorBank {
                            controlled: false;
                            options: ["Music", "Drums", "Grain"];
                            selected-index <=> root.stretch-mode;
                            segment-width: 46px;
                            tooltip: "Stretch mode";
                            selected(i) => { root.stretch-mode-changed(i); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            ToggleButton {
                                controlled: false;
                                text: "SYNC";
                                tooltip: "Sync"; hint: "Fit the loop to the project tempo";
                                min-width: 46px; max-width: 46px; max-height: 20px;
                                checked <=> root.stretch-sync;
                                toggled(on) => { root.stretch-sync-changed(on); }
                            }
                        }
                    }
                    // Bars when synced, ratio when not: with fit-to-tempo on
                    // the ratio is derived, so showing it as an editable knob
                    // would be offering a control that does nothing.
                    if root.stretch-sync : KnobField {
                        controlled: false;
                        label: "Bars";
                        tooltip: root.stretch-bars-label;
                        diameter: 26px;
                        // Normalized, so unity is not zero: without this a
                        // double-click resets to the bottom of the range.
                        default-value: 0.4;
                        // Detented to powers of two, which is what
                        // `snap_bars_to_power_of_two` already guesses when
                        // fit-to-tempo is switched on: a loop is nearly
                        // always some power of two of bars, and a continuous
                        // knob over ten octaves lands on 1.372 instead. The
                        // range is 1/16 to 64 bars -- ten octaves -- and the
                        // knob is logarithmic, so a tenth of its travel is
                        // exactly one octave. Typing into the field is still
                        // free, for the loop that genuinely is three bars.
                        step: 0.1;
                        field-width: 84px;
                        value <=> root.stretch-bars;
                        display-text: root.stretch-bars-label;
                        modulation-armed: root.modulation-armed;
                        modulation-allowed: root.modulation-allowed[32];
                        modulation-depth: root.modulation-depths[32];
                        modulation-offset: root.modulation-offsets[32];
                        modulation-route-count: root.modulation-route-counts[32];
                        changed(v) => { root.stretch-bars-changed(v); }
                        text-committed(t) => { root.stretch-bars-typed(t); }
                        modulation-depth-changed(v) => { root.modulation-depth-changed(32, v); }
                        modulation-edit-started => { root.modulation-edit-started(32); }
                        modulation-edit-finished => { root.modulation-edit-finished(32); }
                    }
                    if !root.stretch-sync : KnobField {
                        controlled: false;
                        label: "Speed";
                        tooltip: root.stretch-ratio-label;
                        diameter: 26px;
                        default-value: 0.3333;
                        field-width: 84px;
                        value <=> root.stretch-ratio;
                        display-text: root.stretch-ratio-label;
                        modulation-armed: root.modulation-armed;
                        modulation-allowed: root.modulation-allowed[29];
                        modulation-depth: root.modulation-depths[29];
                        modulation-offset: root.modulation-offsets[29];
                        modulation-route-count: root.modulation-route-counts[29];
                        changed(v) => { root.stretch-ratio-changed(v); }
                        text-committed(t) => { root.stretch-ratio-typed(t); }
                        modulation-depth-changed(v) => { root.modulation-depth-changed(29, v); }
                        modulation-edit-started => { root.modulation-edit-started(29); }
                        modulation-edit-finished => { root.modulation-edit-finished(29); }
                    }
                    // Grain size only means anything without the similarity
                    // search, and the search is what the other modes turn on.
                    if root.stretch-mode == 2 : KnobField {
                        controlled: false;
                        label: "Grain";
                        tooltip: root.stretch-grain-label;
                        diameter: 26px;
                        default-value: 0.6667;
                        field-width: 108px;
                        value <=> root.stretch-grain;
                        display-text: root.stretch-grain-label;
                        modulation-armed: root.modulation-armed;
                        modulation-allowed: root.modulation-allowed[30];
                        modulation-depth: root.modulation-depths[30];
                        modulation-offset: root.modulation-offsets[30];
                        modulation-route-count: root.modulation-route-counts[30];
                        changed(v) => { root.stretch-grain-changed(v); }
                        text-committed(t) => { root.stretch-grain-typed(t); }
                        modulation-depth-changed(v) => { root.modulation-depth-changed(30, v); }
                        modulation-edit-started => { root.modulation-edit-started(30); }
                        modulation-edit-finished => { root.modulation-edit-finished(30); }
                    }
                    // The clean band is marked, not enforced. Extreme
                    // slow-down is a sound people want. Conditional, because
                    // an always-present line costs a row of a face that has
                    // none to spare.
                    if !root.stretch-sync && !root.stretch-ratio-clean : Text {
                        text: "past clean range";
                        color: Theme.text-faint;
                        font-size: Theme.text-sm;
                        height: 10px;
                    }
                    // Synced, the ratio is derived, so what is worth reading
                    // is where it came from: the loop's own length and tempo
                    // and what it now lasts. In the warning colour when the
                    // bar count gives the loop an unlikely tempo.
                    if root.stretch-sync : Rectangle {
                        height: 10px;
                        Text {
                            width: 100%;
                            text: root.stretch-fit-label;
                            color: root.stretch-fit-warning ? Theme.warning : Theme.text-faint;
                            font-size: Theme.text-sm;
                            overflow: elide;
                        }
                        TouchArea {
                            changed has-hover => {
                                if (self.has-hover) { StatusHint.show(root.stretch-fit-hint); }
                                else { StatusHint.clear(root.stretch-fit-hint); }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    // Committing bakes the stretch into the buffer, after
                    // which it is ordinary audio: reverse and Slice mode work
                    // on it, which they cannot do on a live stretch because
                    // WSOLA only runs forwards.
                    HorizontalLayout {
                        spacing: 4px;
                        if !root.committed : ToolButton {
                            text: "COMMIT";
                            enabled: root.stretch-enabled;
                            min-width: 56px; max-width: 56px; min-height: 18px;
                            tooltip: root.stretch-enabled
                                ? "Bake the stretch into the buffer, so reverse and Slice mode can use it"
                                : "Switch stretching on to commit it";
                            clicked => { root.commit-clicked(); }
                        }
                        if root.committed : Text {
                            text: root.commit-stale ? root.commit-label + " · stale" : root.commit-label;
                            color: root.commit-stale ? Theme.warning : Theme.text-faint;
                            font-size: Theme.text-sm;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // A stale bake is re-rendered in place. The handler
                        // already commits from the source rather than from
                        // the baked buffer, so this is one click where it
                        // used to take REVERT and then COMMIT -- and the
                        // only route to a re-bake at all once the row had
                        // hidden COMMIT behind `committed`.
                        if root.committed && root.commit-stale : ToolButton {
                            text: "REBAKE";
                            min-width: 50px; max-width: 50px; min-height: 18px;
                            tooltip: "Re-bake"; hint: "Re-bake the stretch";
                            clicked => { root.commit-clicked(); }
                        }
                        if root.committed : ToolButton {
                            text: "REVERT";
                            min-width: 52px; max-width: 52px; min-height: 18px;
                            tooltip: "Revert"; hint: "Put the source buffer and its markers back";
                            clicked => { root.revert-clicked(); }
                        }
                        if !root.committed : Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px; spacing: 4px;
                    Text { text: "AMPLITUDE"; color: Theme.text-faint; font-size: Theme.text-sm; }
                    EnvelopeEditor {
                        height: 78px;
                        attack <=> root.attack; decay <=> root.decay; sustain <=> root.sustain; release <=> root.release;
                        attack-text: TimeFormat.seconds(root.attack); decay-text: TimeFormat.seconds(root.decay); sustain-text: round(root.sustain * 100) + "%"; release-text: TimeFormat.seconds(root.release);
                        attack-changed(v) => { root.attack-changed(v); } decay-changed(v) => { root.decay-changed(v); } sustain-changed(v) => { root.sustain-changed(v); } release-changed(v) => { root.release-changed(v); }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        ParameterKnob { controlled: false; diameter: 36px; label: "Attack"; tooltip: "Amplitude attack"; value <=> root.attack; minimum: 0.001; maximum: 8; scale: ValueScale.logarithmic; default-value: 0.001; value-text: TimeFormat.seconds(root.attack); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[8]; modulation-depth: root.modulation-depths[8]; modulation-offset: root.modulation-offsets[8]; modulation-route-count: root.modulation-route-counts[8]; changed(v) => { root.attack-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(8, v); } modulation-edit-started => { root.modulation-edit-started(8); } modulation-edit-finished => { root.modulation-edit-finished(8); } }
                        ParameterKnob { controlled: false; diameter: 36px; label: "Decay"; tooltip: "Amplitude decay"; value <=> root.decay; minimum: 0.001; maximum: 8; scale: ValueScale.logarithmic; default-value: 0.25; value-text: TimeFormat.seconds(root.decay); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[9]; modulation-depth: root.modulation-depths[9]; modulation-offset: root.modulation-offsets[9]; modulation-route-count: root.modulation-route-counts[9]; changed(v) => { root.decay-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(9, v); } modulation-edit-started => { root.modulation-edit-started(9); } modulation-edit-finished => { root.modulation-edit-finished(9); } }
                        ParameterKnob { controlled: false; diameter: 36px; label: "Sustain"; tooltip: "Amplitude sustain"; value <=> root.sustain; default-value: 1; value-text: round(root.sustain * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[10]; modulation-depth: root.modulation-depths[10]; modulation-offset: root.modulation-offsets[10]; modulation-route-count: root.modulation-route-counts[10]; changed(v) => { root.sustain-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(10, v); } modulation-edit-started => { root.modulation-edit-started(10); } modulation-edit-finished => { root.modulation-edit-finished(10); } }
                        ParameterKnob { controlled: false; diameter: 36px; label: "Release"; tooltip: "Amplitude release"; value <=> root.release; minimum: 0.001; maximum: 8; scale: ValueScale.logarithmic; default-value: 0.05; value-text: TimeFormat.seconds(root.release); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[11]; modulation-depth: root.modulation-depths[11]; modulation-offset: root.modulation-offsets[11]; modulation-route-count: root.modulation-route-counts[11]; changed(v) => { root.release-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(11, v); } modulation-edit-started => { root.modulation-edit-started(11); } modulation-edit-finished => { root.modulation-edit-finished(11); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        if root.page == 2 : HorizontalLayout {
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 3; background: Theme.panel; border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px; spacing: 4px;
                    // Two internal pages rather than a taller face: the
                    // response curve and the envelope both want the whole
                    // display area, and the 3U height is not negotiable.
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "FILTER / DRIVE"; color: Theme.text-faint; font-size: Theme.text-sm; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        SelectorBank {
                            controlled: false;
                            options: ["CURVE", "ENV"];
                            selected-index <=> root.filter-view;
                            segment-width: 34px;
                            tooltip: "Filter response or filter envelope";
                        }
                    }
                    if root.filter-view == 0 : FilterResponseDisplay {
                        vertical-stretch: 1;
                        mode: 0;
                        cutoff: root.filter-cutoff;
                        resonance: root.filter-resonance;
                        env-amount: root.filter-env * 2 - 1;
                    }
                    if root.filter-view == 1 : EnvelopeEditor {
                        vertical-stretch: 1;
                        fill: Theme.accent;
                        attack <=> root.filter-attack; decay <=> root.filter-decay; sustain <=> root.filter-sustain; release <=> root.filter-release;
                        attack-text: TimeFormat.seconds(root.filter-attack); decay-text: TimeFormat.seconds(root.filter-decay); sustain-text: round(root.filter-sustain * 100) + "%"; release-text: TimeFormat.seconds(root.filter-release);
                        attack-changed(v) => { root.filter-attack-changed(v); } decay-changed(v) => { root.filter-decay-changed(v); } sustain-changed(v) => { root.filter-sustain-changed(v); } release-changed(v) => { root.filter-release-changed(v); }
                    }
                    if root.filter-view == 1 : HorizontalLayout {
                        spacing: 5px;
                        ParameterKnob { controlled: false; diameter: 36px; label: "Attack"; tooltip: "Filter envelope attack"; value <=> root.filter-attack; minimum: 0.001; maximum: 8; scale: ValueScale.logarithmic; default-value: 0.001; value-text: TimeFormat.seconds(root.filter-attack); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[23]; modulation-depth: root.modulation-depths[23]; modulation-offset: root.modulation-offsets[23]; modulation-route-count: root.modulation-route-counts[23]; changed(v) => { root.filter-attack-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(23, v); } modulation-edit-started => { root.modulation-edit-started(23); } modulation-edit-finished => { root.modulation-edit-finished(23); } }
                        ParameterKnob { controlled: false; diameter: 36px; label: "Decay"; tooltip: "Filter envelope decay"; value <=> root.filter-decay; minimum: 0.001; maximum: 8; scale: ValueScale.logarithmic; default-value: 0.25; value-text: TimeFormat.seconds(root.filter-decay); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[24]; modulation-depth: root.modulation-depths[24]; modulation-offset: root.modulation-offsets[24]; modulation-route-count: root.modulation-route-counts[24]; changed(v) => { root.filter-decay-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(24, v); } modulation-edit-started => { root.modulation-edit-started(24); } modulation-edit-finished => { root.modulation-edit-finished(24); } }
                        ParameterKnob { controlled: false; diameter: 36px; label: "Sustain"; tooltip: "Filter envelope sustain"; value <=> root.filter-sustain; default-value: 1; value-text: round(root.filter-sustain * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[25]; modulation-depth: root.modulation-depths[25]; modulation-offset: root.modulation-offsets[25]; modulation-route-count: root.modulation-route-counts[25]; changed(v) => { root.filter-sustain-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(25, v); } modulation-edit-started => { root.modulation-edit-started(25); } modulation-edit-finished => { root.modulation-edit-finished(25); } }
                        ParameterKnob { controlled: false; diameter: 36px; label: "Release"; tooltip: "Filter envelope release"; value <=> root.filter-release; minimum: 0.001; maximum: 8; scale: ValueScale.logarithmic; default-value: 0.05; value-text: TimeFormat.seconds(root.filter-release); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[26]; modulation-depth: root.modulation-depths[26]; modulation-offset: root.modulation-offsets[26]; modulation-route-count: root.modulation-route-counts[26]; changed(v) => { root.filter-release-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(26, v); } modulation-edit-started => { root.modulation-edit-started(26); } modulation-edit-finished => { root.modulation-edit-finished(26); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.filter-view == 0 : HorizontalLayout {
                        spacing: 5px;
                        ParameterKnob {
                            controlled: false;
                            diameter: 36px; label: "Cutoff"; tooltip: "Low-pass cutoff";
                            value <=> root.filter-cutoff; default-value: 1;
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[12];
                            modulation-depth: root.modulation-depths[12];
                            modulation-offset: root.modulation-offsets[12];
                            modulation-route-count: root.modulation-route-counts[12];
                            value-text: NoteFormat.frequency-value(CutoffLaw.hz(root.filter-cutoff));
                            changed(v) => { root.filter-cutoff-changed(v); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(12, v); }
                            modulation-edit-started => { root.modulation-edit-started(12); }
                            modulation-edit-finished => { root.modulation-edit-finished(12); }
                        }
                        ParameterKnob { controlled: false; diameter: 36px; label: "Reso"; tooltip: "Filter resonance"; value <=> root.filter-resonance; default-value: 0; value-text: round(root.filter-resonance * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[13]; modulation-depth: root.modulation-depths[13]; modulation-offset: root.modulation-offsets[13]; modulation-route-count: root.modulation-route-counts[13]; changed(v) => { root.filter-resonance-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(13, v); } modulation-edit-started => { root.modulation-edit-started(13); } modulation-edit-finished => { root.modulation-edit-finished(13); } }
                        ParameterKnob { controlled: false; diameter: 36px; label: "Env"; tooltip: "Envelope modulation"; value <=> root.filter-env; default-value: 0.5; bipolar: true; value-text: (round((root.filter-env * 2 - 1) * 100) > 0 ? "+" : "") + round((root.filter-env * 2 - 1) * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[14]; modulation-depth: root.modulation-depths[14]; modulation-offset: root.modulation-offsets[14]; modulation-route-count: root.modulation-route-counts[14]; changed(v) => { root.filter-env-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(14, v); } modulation-edit-started => { root.modulation-edit-started(14); } modulation-edit-finished => { root.modulation-edit-finished(14); } }
                        ParameterKnob { controlled: false; diameter: 36px; label: "Drive"; tooltip: "Pre-filter saturation"; value <=> root.drive; default-value: 0; value-text: round(root.drive * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[15]; modulation-depth: root.modulation-depths[15]; modulation-offset: root.modulation-offsets[15]; modulation-route-count: root.modulation-route-counts[15]; changed(v) => { root.drive-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(15, v); } modulation-edit-started => { root.modulation-edit-started(15); } modulation-edit-finished => { root.modulation-edit-finished(15); } }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 2; background: Theme.panel; border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px; spacing: 4px;
                    Text { text: "LO-FI"; color: Theme.text-faint; font-size: Theme.text-sm; }
                    BitcrusherTrace {
                        vertical-stretch: 1;
                        bit-reduction: root.bit-reduction;
                        rate-reduction: root.rate-reduction;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ParameterKnob { controlled: false; label: "Bits"; tooltip: "Bit-depth reduction"; value <=> root.bit-reduction; default-value: 0; value-text: round(16 - root.bit-reduction * 12) + " bit"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[16]; modulation-depth: root.modulation-depths[16]; modulation-offset: root.modulation-offsets[16]; modulation-route-count: root.modulation-route-counts[16]; changed(v) => { root.bit-reduction-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(16, v); } modulation-edit-started => { root.modulation-edit-started(16); } modulation-edit-finished => { root.modulation-edit-finished(16); } }
                        ParameterKnob { controlled: false; label: "Rate"; tooltip: "Sample-rate reduction"; value <=> root.rate-reduction; default-value: 0; value-text: "÷" + round(1 + root.rate-reduction * 31); modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[17]; modulation-depth: root.modulation-depths[17]; modulation-offset: root.modulation-offsets[17]; modulation-route-count: root.modulation-route-counts[17]; changed(v) => { root.rate-reduction-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(17, v); } modulation-edit-started => { root.modulation-edit-started(17); } modulation-edit-finished => { root.modulation-edit-finished(17); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        // Clip recording into this sampler (`audio-recording/05`, decisions
        // 7-9). One button: pressed idle it arms a take, which waits for the
        // next bar line and then records the channel's AUDIO input; pressed
        // again it stops. With Clip on the take also stops by itself after
        // its length. What finishes becomes this sampler's sample.
        if root.page == 3 : VerticalLayout {
            spacing: 5px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 56px;
                    height: 24px;
                    border-radius: Theme.radius-md;
                    background: root.record-state == 2 ? Theme.destructive
                        : root.record-state == 1 ? Theme.warning
                        : record-touch.has-hover ? Theme.surface-active : Theme.surface-raised;
                    Text {
                        text: root.record-state == 2 ? "STOP" : root.record-state == 1 ? "WAIT" : "REC";
                        color: root.record-state == 0 ? Theme.text : Theme.background;
                        font-size: Theme.text-md;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    record-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.record-clicked(); }
                    }
                }
                Text {
                    text: root.record-state == 2 ? root.record-elapsed
                        : root.record-state == 1 ? "Waiting for the bar"
                        : root.record-source == "" ? "No audio input" : "Ready";
                    color: root.record-state == 0 ? Theme.text-muted : Theme.text;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                ToggleButton {
                    controlled: false;
                    width: 52px;
                    text: "CLIP";
                    tooltip: "Clip";
                    hint: "On: a take stops by itself after its length. Off: it records until you stop it.";
                    checked <=> root.record-clip;
                    toggled(on) => { root.record-clip-changed(on); }
                }
                StepperField {
                    controlled: false;
                    label: "LENGTH";
                    tooltip: "Length";
                    hint: "How long a take records with Clip on.";
                    enabled: root.record-clip;
                    value <=> root.record-bars;
                    minimum: 1;
                    maximum: root.record-max-bars;
                    value-width: 44px;
                    display-text: root.record-bars + (root.record-bars == 1 ? " BAR" : " BARS");
                    changed(bars) => { root.record-bars-changed(bars); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 60px;
                background: Theme.background;
                border-radius: Theme.radius-sm;
                clip: true;
                for amplitude[index] in root.record-peaks : Rectangle {
                    x: index * parent.width * clamp(root.record-fill, 0, 1) / max(1, root.record-peaks.length);
                    y: (parent.height - self.height) / 2;
                    width: max(1px, parent.width * clamp(root.record-fill, 0, 1) / max(1, root.record-peaks.length));
                    height: max(1px, amplitude * (parent.height - 6px));
                    background: root.record-state == 2 ? Theme.destructive : Theme.text-muted;
                }
                if root.record-peaks.length == 0 : Text {
                    text: root.record-source == ""
                        ? "Pick an AUDIO input in the channel sidebar to record"
                        : root.record-state == 1 ? "Recording starts on the next bar"
                        : "Press REC: recording starts on the next bar";
                    color: Theme.text-faint;
                    font-size: Theme.text-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Text { text: "FROM"; color: Theme.text-faint; font-size: Theme.text-sm; vertical-alignment: center; }
                Text {
                    text: root.record-source == "" ? "—" : root.record-source;
                    color: Theme.text-muted;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
