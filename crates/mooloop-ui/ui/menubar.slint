import { Theme } from "theme.slint";

// Traditional menu-bar vocabulary.
//
// These pieces are deliberately generic: they know nothing about which
// actions exist. Concrete menus live where their callbacks are in scope
// (see MainWindow in main.slint), so adding a menu item is one MenuRow
// line -- and a new action is one callback on the window. Rows whose
// feature does not exist yet are declared with `enabled: false` so the
// menu itself documents what is being built toward.

// One selectable row: label, optional shortcut hint, optional check state.
// The 26px label gutter keeps checked and unchecked rows of one menu
// aligned; the shortcut column is only reserved when a hint is shown.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    callback selected;

    height: 24px;
    background: touch.has-hover && root.enabled ? Theme.surface-active : transparent;

    Text {
        x: 26px;
        width: parent.width - 26px - (root.shortcut != "" ? 76px : 8px);
        text: root.text;
        color: root.enabled ? Theme.text : Theme.text-faint;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 8px;
        width: 14px;
        text: "✓";
        visible: root.checked;
        color: root.enabled ? Theme.text : Theme.text-faint;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - self.width - 10px;
        text: root.shortcut;
        visible: root.shortcut != "";
        color: root.enabled ? Theme.text-faint : Theme.text-faint;
        font-size: 10px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.selected(); }
    }
}

// Hairline gap between groups of rows.
export component MenuSeparator inherits Rectangle {
    height: 5px;
    Rectangle {
        x: 8px;
        y: 2px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.border;
    }
}

// One title in the bar, together with the dropdown it owns. `open-menu` is
// the bar-wide "which menu is open" index (-1 = none), bound two-way to
// every item: it is what makes hovering across titles switch menus the way
// a native bar does, without another click.
export component MenuBarItem inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    in property <int> menu-id;
    in-out property <int> open-menu: -1;
    // All title strings in bar order, index == menu-id. Used only to
    // rebuild an invisible copy of the title row inside this item's own
    // popup -- see the hover-chain catcher below.
    in property <[string]> titles;
    in property <length> bar-width;
    // Watching the popup's `is-open` directly with a `changed` handler
    // trips a Slint 1.17 compiler bug, so mirror it here instead.
    property <bool> popup-open: menu.is-open;

    width: title-text.preferred-width + 16px;
    border-radius: 3px;
    background: !root.enabled ? transparent
        : root.open-menu == root.menu-id || touch.has-hover
        ? Theme.surface-active : transparent;

    title-text := Text {
        x: 8px;
        text: root.title;
        color: root.enabled ? Theme.text : Theme.text-faint;
        font-size: 11px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.open-menu == root.menu-id) {
                root.open-menu = -1;
            } else {
                root.open-menu = root.menu-id;
                menu.show();
            }
        }
        changed has-hover => {
            // Once any menu is open, crossing titles switches menus.
            if (self.has-hover && root.open-menu >= 0 && root.open-menu != root.menu-id) {
                root.open-menu = root.menu-id;
                menu.show();
            }
        }
    }

    changed open-menu => {
        if (root.open-menu == root.menu-id) {
            if (!menu.is-open) {
                menu.show();
            }
        } else if (menu.is-open) {
            menu.close();
        }
    }

    changed popup-open => {
        // Outside clicks and Escape close the popup itself; forget the
        // bar-wide state so the next title click reopens.
        if (!root.popup-open && root.open-menu == root.menu-id) {
            root.open-menu = -1;
        }
    }

    menu := PopupWindow {
        // The popup's hit-box is widened to cover the whole title strip
        // above the dropdown (not just this item's own title). Slint only
        // chains mouse-move across siblings for its built-in Menu widget
        // kind; a hand-rolled PopupWindow like this one otherwise blocks
        // all hover events to anything outside itself while open, so
        // hovering from "File" to "Edit" would never switch menus. The
        // invisible strip below reproduces the real title row pixel-for
        // -pixel (same padding/spacing/font) so hovering across it can
        // reassign `open-menu` directly.
        x: -root.x;
        y: 0;
        width: max(root.bar-width, 216px);
        height: root.height + 2px + menu-frame-content.preferred-height;
        close-policy: close-on-click;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.height;

            HorizontalLayout {
                padding-left: 4px;
                spacing: 2px;
                alignment: start;

                for t[idx] in root.titles: Rectangle {
                    width: catcher-text.preferred-width + 16px;
                    catcher-text := Text {
                        text: t;
                        font-size: 11px;
                        color: transparent;
                    }
                    TouchArea {
                        clicked => { root.open-menu = idx; }
                        changed has-hover => {
                            if (self.has-hover && root.open-menu != idx) {
                                root.open-menu = idx;
                            }
                        }
                    }
                }
            }
        }

        menu-frame := Rectangle {
            // Popup-local x=0 is the bar's left edge (see the -root.x
            // shift above), so shift back by root.x to land under this
            // item's own title instead of always under the first one.
            x: root.x;
            y: root.height + 2px;
            width: 216px;
            height: menu-frame-content.preferred-height;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            menu-frame-content := VerticalLayout {
                padding: 4px;
                @children
            }
        }

    }
}

// The bar itself: a thin panel of titles above the toolbar. Children
// declared on it are MenuBarItem instances.
export component MenuBar inherits Rectangle {
    in-out property <int> open-menu: -1;
    // Single source of truth for the hover-chain catcher in MenuBarItem;
    // order must match each item's `menu-id`.
    out property <[string]> titles: ["File", "Edit", "Pattern", "Channel", "View", "Help"];

    height: 26px;
    background: Theme.panel;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 6px;
        spacing: 2px;
        alignment: start;
        @children
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
        opacity: 0.6;
    }
}
