import { Theme } from "theme.slint";
import { ParameterKnob } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";
import { BitcrushTrace } from "device-displays.slint";

// One bitcrush effect in a channel's device rack: only the working controls
// live here; header, drag-to-reorder, and host actions come from the shared
// shell and frame.
export component BitcrushDeviceFace inherits EffectDeviceShell {
    name: "Bitcrush";
    kind: "FX / 1U";
    in-out property <float> bits;        // normalized 0..1 (1 .. 16 bits)
    in-out property <float> downsample;  // normalized 0..1 (1x .. 64x)
    in-out property <float> mix;         // normalized 0..1
    callback bits-changed(float);
    callback downsample-changed(float);
    callback mix-changed(float);

    // Normalized -> natural, matching the descriptors in mooloop-core: bits is
    // linear over [1, 16], downsample is exponential over [1, 64].
    private property <float> bits-natural: 1 + root.bits * 15;
    private property <float> rate-natural: pow(64, root.downsample);

    VerticalLayout {
        padding: 6px;
        padding-top: DeviceRackMetrics.header-height + 6px;
        spacing: 4px;
        Rectangle {
            height: 104px;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            BitcrushTrace {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                bits: root.bits-natural;
                downsample: root.rate-natural;
            }
        }
        HorizontalLayout {
            spacing: 0px;
            ParameterKnob {
                width: 69px;
                diameter: 36px;
                label: "Bits";
                tooltip: "Quantization depth";
                value <=> root.bits;
                default-value: 1.0;
                value-text: round(root.bits-natural * 10) / 10 + " bit";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[0];
                modulation-depth: root.modulation-depths[0];
                modulation-offset: root.modulation-offsets[0];
                modulation-route-count: root.modulation-route-counts[0];
                changed(v) => { root.bits-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(0, v); }
                modulation-edit-started => { root.modulation-edit-started(0); }
                modulation-edit-finished => { root.modulation-edit-finished(0); }
            }
            ParameterKnob {
                width: 69px;
                diameter: 36px;
                label: "Rate";
                tooltip: "Sample-and-hold length";
                value <=> root.downsample;
                default-value: 0.0;
                value-text: round(root.rate-natural * 10) / 10 + "x";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[1];
                modulation-depth: root.modulation-depths[1];
                modulation-offset: root.modulation-offsets[1];
                modulation-route-count: root.modulation-route-counts[1];
                changed(v) => { root.downsample-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(1, v); }
                modulation-edit-started => { root.modulation-edit-started(1); }
                modulation-edit-finished => { root.modulation-edit-finished(1); }
            }
            // Bitcrush's own DSP blend, distinct from the surrounding host's
            // generic Wet/dry control.
            ParameterKnob {
                width: 69px;
                diameter: 36px;
                label: "Mix";
                tooltip: "Bitcrush's internal dry/wet blend";
                value <=> root.mix;
                default-value: 1.0;
                value-text: round(root.mix * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[2];
                modulation-depth: root.modulation-depths[2];
                modulation-offset: root.modulation-offsets[2];
                modulation-route-count: root.modulation-route-counts[2];
                changed(v) => { root.mix-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(2, v); }
                modulation-edit-started => { root.modulation-edit-started(2); }
                modulation-edit-finished => { root.modulation-edit-finished(2); }
            }
        }
    }
}
