import { EqDeviceFace } from "eq-device.slint";
import { FilterDeviceFace } from "filter-device.slint";
import { CompressorDeviceFace } from "compressor-device.slint";
import { Ds01Contour, Ds01DeviceFace } from "ds01-device.slint";

// Slint only generates Rust bindings for exported components that inherit
// Window - EqDeviceFace inherits EffectDeviceShell (a
// Rectangle), so they can't be instantiated directly from a test. These
// thin Window wrappers exist purely so the drag regression tests can drive
// the real faces with real pointer events instead of invoking their
// callbacks directly, which would pass even if event routing to the handle
// were broken.
export component EqDeviceDragHarness inherits Window {
    in-out property <float> target;
    in-out property <float> enabled;
    in-out property <float> frequency;
    in-out property <float> gain;
    in-out property <float> q;
    in-out property <float> character;
    in property <[float]> band-data;
    in property <[float]> spectrum-data;
    in property <bool> analyzer-enabled;
    callback target-changed(float);
    callback enabled-changed(float);
    callback frequency-changed(float);
    callback gain-changed(float);
    callback q-changed(float);
    callback character-changed(float);
    callback analyzer-toggled(bool);

    preferred-width: 668px;
    preferred-height: 268px;
    EqDeviceFace {
        width: 100%;
        height: 100%;
        target <=> root.target;
        enabled <=> root.enabled;
        frequency <=> root.frequency;
        gain <=> root.gain;
        q <=> root.q;
        character <=> root.character;
        band-data: root.band-data;
        spectrum-data: root.spectrum-data;
        analyzer-enabled: root.analyzer-enabled;
        target-changed(v) => { root.target-changed(v); }
        enabled-changed(v) => { root.enabled-changed(v); }
        frequency-changed(v) => { root.frequency-changed(v); }
        gain-changed(v) => { root.gain-changed(v); }
        q-changed(v) => { root.q-changed(v); }
        character-changed(v) => { root.character-changed(v); }
        analyzer-toggled(v) => { root.analyzer-toggled(v); }
    }
}

export component FilterDeviceDragHarness inherits Window {
    in-out property <int> mode;
    in-out property <float> cutoff;
    in-out property <float> resonance;
    callback cutoff-changed(float);
    callback resonance-changed(float);
    callback mode-changed(int);

    preferred-width: 220px;
    preferred-height: 268px;
    FilterDeviceFace {
        width: 100%;
        height: 100%;
        mode <=> root.mode;
        cutoff <=> root.cutoff;
        resonance <=> root.resonance;
        cutoff-changed(v) => { root.cutoff-changed(v); }
        resonance-changed(v) => { root.resonance-changed(v); }
        mode-changed(v) => { root.mode-changed(v); }
    }
}

export component CompressorDeviceDragHarness inherits Window {
    in-out property <float> threshold;
    in-out property <float> ratio;
    in-out property <float> attack;
    in-out property <float> release;
    in-out property <float> knee;
    in-out property <float> makeup;
    in property <float> detector-db: -60;
    in property <float> gain-reduction-db: 0;
    callback threshold-changed(float);

    preferred-width: 444px;
    preferred-height: 268px;
    CompressorDeviceFace {
        width: 100%;
        height: 100%;
        threshold <=> root.threshold;
        ratio <=> root.ratio;
        attack <=> root.attack;
        release <=> root.release;
        knee <=> root.knee;
        makeup <=> root.makeup;
        detector-db: root.detector-db;
        gain-reduction-db: root.gain-reduction-db;
        threshold-changed(v) => { root.threshold-changed(v); }
    }
}

// The DS-01's face, at the size the rack gives it: four rack units of
// `DeviceRackMetrics` minus the two rails, by `face-height` minus the device
// header.
//
// Here for the same reason as the three above, and for one more. The face is
// indexed by descriptor id, so every control's value is a *binding* onto a
// model row rather than a property Rust sets one at a time — and Slint drops
// a binding at the first assignment to the property it feeds, which is what a
// knob does to itself while it is dragged. A test that only invoked the
// callbacks would never touch that, and neither would one that drove the
// whole `MainWindow`, whose element positions the `ElementHandle` search API
// could only find in a build with `SLINT_EMIT_DEBUG_INFO=1`.
export component Ds01DeviceDragHarness inherits Window {
    in property <[float]> values;
    in property <[float]> defaults;
    in property <[string]> value-texts;
    in property <[int]> step-counts;
    in property <[bool]> bipolars;
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    in property <[Ds01Contour]> contours;
    in property <[float]> preview-minimums;
    in property <[float]> preview-maximums;
    in property <[float]> burst-ticks;
    in property <[string]> matrix-source-names;
    in property <[string]> matrix-dest-names;
    in property <float> body-decay-fraction;
    in property <string> span-text;
    in-out property <int> page;
    callback value-changed(int, float);
    callback text-committed(int, string);

    preferred-width: 884px;
    preferred-height: 240px;
    Ds01DeviceFace {
        width: 100%;
        height: 100%;
        values: root.values;
        defaults: root.defaults;
        value-texts: root.value-texts;
        step-counts: root.step-counts;
        bipolars: root.bipolars;
        modulation-depths: root.modulation-depths;
        modulation-allowed: root.modulation-allowed;
        modulation-offsets: root.modulation-offsets;
        modulation-route-counts: root.modulation-route-counts;
        contours: root.contours;
        preview-minimums: root.preview-minimums;
        preview-maximums: root.preview-maximums;
        burst-ticks: root.burst-ticks;
        matrix-source-names: root.matrix-source-names;
        matrix-dest-names: root.matrix-dest-names;
        body-decay-fraction: root.body-decay-fraction;
        span-text: root.span-text;
        page <=> root.page;
        value-changed(p, v) => { root.value-changed(p, v); }
        text-committed(p, t) => { root.text-committed(p, t); }
    }
}
