import { EqDeviceFace } from "eq-device.slint";
import { FilterDeviceFace } from "filter-device.slint";

// Slint only generates Rust bindings for exported components that inherit
// Window - EqDeviceFace inherits EffectDeviceShell (a
// Rectangle), so they can't be instantiated directly from a test. These
// thin Window wrappers exist purely so the drag regression tests can drive
// the real faces with real pointer events instead of invoking their
// callbacks directly, which would pass even if event routing to the handle
// were broken.
export component EqDeviceDragHarness inherits Window {
    in-out property <float> target;
    in-out property <float> enabled;
    in-out property <float> frequency;
    in-out property <float> gain;
    in-out property <float> q;
    in-out property <float> character;
    in property <[float]> band-data;
    in property <[float]> spectrum-data;
    in property <bool> analyzer-enabled;
    callback target-changed(float);
    callback enabled-changed(float);
    callback frequency-changed(float);
    callback gain-changed(float);
    callback q-changed(float);
    callback character-changed(float);
    callback analyzer-toggled(bool);

    preferred-width: 668px;
    preferred-height: 268px;
    EqDeviceFace {
        width: 100%;
        height: 100%;
        target <=> root.target;
        enabled <=> root.enabled;
        frequency <=> root.frequency;
        gain <=> root.gain;
        q <=> root.q;
        character <=> root.character;
        band-data: root.band-data;
        spectrum-data: root.spectrum-data;
        analyzer-enabled: root.analyzer-enabled;
        target-changed(v) => { root.target-changed(v); }
        enabled-changed(v) => { root.enabled-changed(v); }
        frequency-changed(v) => { root.frequency-changed(v); }
        gain-changed(v) => { root.gain-changed(v); }
        q-changed(v) => { root.q-changed(v); }
        character-changed(v) => { root.character-changed(v); }
        analyzer-toggled(v) => { root.analyzer-toggled(v); }
    }
}

export component FilterDeviceDragHarness inherits Window {
    in-out property <int> mode;
    in-out property <float> cutoff;
    in-out property <float> resonance;
    callback cutoff-changed(float);
    callback resonance-changed(float);
    callback mode-changed(int);

    preferred-width: 220px;
    preferred-height: 268px;
    FilterDeviceFace {
        width: 100%;
        height: 100%;
        mode <=> root.mode;
        cutoff <=> root.cutoff;
        resonance <=> root.resonance;
        cutoff-changed(v) => { root.cutoff-changed(v); }
        resonance-changed(v) => { root.resonance-changed(v); }
        mode-changed(v) => { root.mode-changed(v); }
    }
}
