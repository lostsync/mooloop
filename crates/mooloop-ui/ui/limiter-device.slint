import { Theme } from "theme.slint";
import { GainMath } from "gain.slint";
import { ParameterKnob } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";
import { DynamicsCurveDisplay, GainReductionMeter } from "device-displays.slint";

// Limiter device face. Gate, compressor, and limiter share one transfer-curve
// display because they are the same kind of plot; only their controls
// differ. Header and drag come from the shared EffectDeviceShell.
//
// Redrawn 2026-10-19 to the Comp's grid: the curve and a reduction meter
// across the top, and three equal knobs under them in the order the signal
// meets them -- pushed in, held under the ceiling, let go. Placed by hand: a
// full-size knob inside a layout is a binding loop.
export component LimiterDeviceFace inherits EffectDeviceShell {
    name: "Limiter";
    kind: "FX";
    in-out property <float> ceiling;  // normalized 0..1 (-24..0 dB)
    in-out property <float> release;  // normalized 0..1 (1..500 ms)
    in-out property <float> gain;     // normalized 0..1 (0..24 dB)
    in property <float> detector-db: GainMath.min-db;
    in property <float> gain-reduction-db: 0;
    callback ceiling-changed(float);
    callback release-changed(float);
    callback gain-changed(float);

    // Normalized -> natural, matching the descriptor tables in mooloop-core.
    private property <float> ceiling-db: -24 + root.ceiling * 24;
    private property <float> release-ms: pow(500, root.release);
    private property <float> gain-db: root.gain * 24;

    private property <length> pad: 8px;
    private property <length> inner: root.width - 2 * root.pad;
    private property <length> top: DeviceRackMetrics.header-height + 8px;
    private property <length> plot-height: 148px;
    private property <length> knob-y: root.top + root.plot-height + 6px;

    Rectangle {
        x: root.pad;
        y: root.top;
        width: root.inner - meter.width - 6px;
        height: root.plot-height;
        background: Theme.panel;
        border-radius: Theme.radius-sm;
        DynamicsCurveDisplay {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            mode: 2;
            threshold-db: root.ceiling-db;
            threshold-min-db: -24;
            ratio: 1;
            knee-db: 0;
            extra-db: root.gain-db;
            detector-db: root.detector-db;
            gain-reduction-db: root.gain-reduction-db;
            threshold-dragged(db) => {
                // Reported, not written: `ceiling` is the model row's, and
                // writing it would drop that binding (MOO-220).
                root.ceiling-changed(clamp((db + 24) / 24, 0, 1));
            }
        }
    }

    meter := GainReductionMeter {
        x: root.pad + root.inner - self.width;
        y: root.top;
        height: root.plot-height;
        gain-reduction-db: root.gain-reduction-db;
    }

    ParameterKnob {
        x: root.pad + root.inner * 0 / 3;
        y: root.knob-y;
        width: root.inner / 3;
        height: root.height - root.knob-y - 4px;
        diameter: 34px;
        label: "Gain";
        tooltip: "Level driven into the ceiling";
        value <=> root.gain;
        default-value: 0.0;
        value-text: GainMath.format-db(root.gain-db);
        modulation-armed: root.modulation-armed;
        modulation-allowed: root.modulation-allowed[2];
        modulation-depth: root.modulation-depths[2];
        modulation-offset: root.modulation-offsets[2];
        modulation-route-count: root.modulation-route-counts[2];
        changed(v) => { root.gain-changed(v); }
        modulation-depth-changed(v) => { root.modulation-depth-changed(2, v); }
        modulation-edit-started => { root.modulation-edit-started(2); }
        modulation-edit-finished => { root.modulation-edit-finished(2); }
    }
    ParameterKnob {
        x: root.pad + root.inner * 1 / 3;
        y: root.knob-y;
        width: root.inner / 3;
        height: root.height - root.knob-y - 4px;
        diameter: 34px;
        label: "Ceiling";
        tooltip: "Level nothing is allowed past";
        value <=> root.ceiling;
        default-value: 0.9875;
        value-text: GainMath.format-plain-db(root.ceiling-db) + " dB";
        modulation-armed: root.modulation-armed;
        modulation-allowed: root.modulation-allowed[0];
        modulation-depth: root.modulation-depths[0];
        modulation-offset: root.modulation-offsets[0];
        modulation-route-count: root.modulation-route-counts[0];
        changed(v) => { root.ceiling-changed(v); }
        modulation-depth-changed(v) => { root.modulation-depth-changed(0, v); }
        modulation-edit-started => { root.modulation-edit-started(0); }
        modulation-edit-finished => { root.modulation-edit-finished(0); }
    }
    ParameterKnob {
        x: root.pad + root.inner * 2 / 3;
        y: root.knob-y;
        width: root.inner / 3;
        height: root.height - root.knob-y - 4px;
        diameter: 34px;
        label: "Release";
        tooltip: "How fast the limiter lets go";
        value <=> root.release;
        default-value: 0.6294;
        value-text: round(root.release-ms) + " ms";
        modulation-armed: root.modulation-armed;
        modulation-allowed: root.modulation-allowed[1];
        modulation-depth: root.modulation-depths[1];
        modulation-offset: root.modulation-offsets[1];
        modulation-route-count: root.modulation-route-counts[1];
        changed(v) => { root.release-changed(v); }
        modulation-depth-changed(v) => { root.modulation-depth-changed(1, v); }
        modulation-edit-started => { root.modulation-edit-started(1); }
        modulation-edit-finished => { root.modulation-edit-finished(1); }
    }
}
