import { Theme } from "theme.slint";
import { ParameterKnob, SelectorBank } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";

// Parameter-derived LFO traces. This is a compact working display rather
// than a simulated oscilloscope: depth, spread, and mode visibly change it.
component ModulationDisplay inherits Rectangle {
    in property <int> mode;
    in property <float> depth;
    in property <float> spread;
    background: Theme.panel;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    Rectangle { x: 0px; y: parent.height * 0.5; width: parent.width; height: 1px; background: Theme.border; }
    for point in 52 : Rectangle {
        private property <float> x_unit: point * 1.0 / 51.0;
        private property <float> trace_phase: self.x_unit * 360 + (root.mode == 2 ? 45 : 0);
        x: self.x_unit * parent.width;
        y: parent.height * (0.5 - sin(self.trace_phase * 1deg) * (0.12 + root.depth * 0.31));
        width: max(1px, parent.width / 50); height: 2px;
        background: Theme.accent;
    }
    for point in 52 : Rectangle {
        private property <float> x_unit: point * 1.0 / 51.0;
        private property <float> trace_phase: self.x_unit * 360 + root.spread * 90;
        x: self.x_unit * parent.width;
        y: parent.height * (0.5 - sin(self.trace_phase * 1deg) * (0.12 + root.depth * 0.31));
        width: max(1px, parent.width / 50); height: 2px;
        background: Theme.focus.with-alpha(0.7);
    }
}

export component ModulationDeviceFace inherits EffectDeviceShell {
    name: "Mod";
    kind: "FX / 2U";
    in-out property <int> mode;
    in-out property <float> rate;
    in-out property <float> depth;
    in-out property <float> character;
    in-out property <float> feedback;
    in-out property <float> spread;
    in-out property <float> tone;
    in-out property <float> stages;
    in-out property <float> wet-dry: 1;
    callback mode-changed(int);
    callback rate-changed(float);
    callback depth-changed(float);
    callback character-changed(float);
    callback feedback-changed(float);
    callback spread-changed(float);
    callback tone-changed(float);
    callback stages-changed(float);
    callback wet-dry-changed(float);

    private property <float> rate-hz: 0.02 * pow(600, root.rate);
    private property <int> stage-count: 4 + round(root.stages * 4) * 2;
    private property <string> color-label: root.mode == 2 ? "Center" : root.mode == 4 ? "Age" : "Delay";
    private property <float> lfo-phase;

    Rectangle {
        x: 186px;
        y: 30px;
        width: 252px;
        height: 208px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-sm;
    }

    ModulationDisplay {
        x: 6px;
        y: 72px;
        width: 174px;
        height: 148px;
        mode: root.mode;
        depth: root.depth;
        spread: root.spread;
    }

    SelectorBank {
        x: 190px;
        y: DeviceRackMetrics.header-height + 6px;
        options: ["CHOR", "FLNG", "PHAS", "ENS", "ADT"];
        selected-index <=> root.mode;
        segment-width: 48px;
        tooltip: "Modulation mode";
        selected(i) => { root.mode-changed(i); }
    }

    HorizontalLayout {
        x: 190px;
        y: 66px;
        width: 240px;
        height: 80px;
        spacing: 0px;
        ParameterKnob { width: 60px; diameter: 36px; label: "Rate"; tooltip: "LFO speed"; value <=> root.rate; default-value: 0.445; value-text: round(root.rate-hz * 100) / 100 + " Hz"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[1]; modulation-depth: root.modulation-depths[1]; modulation-offset: root.modulation-offsets[1]; modulation-route-count: root.modulation-route-counts[1]; changed(v) => { root.rate-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(1, v); } modulation-edit-started => { root.modulation-edit-started(1); } modulation-edit-finished => { root.modulation-edit-finished(1); } }
        ParameterKnob { width: 60px; diameter: 36px; label: "Depth"; tooltip: "Sweep amount"; value <=> root.depth; default-value: 0.45; value-text: round(root.depth * 100) + " %"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[2]; modulation-depth: root.modulation-depths[2]; modulation-offset: root.modulation-offsets[2]; modulation-route-count: root.modulation-route-counts[2]; changed(v) => { root.depth-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(2, v); } modulation-edit-started => { root.modulation-edit-started(2); } modulation-edit-finished => { root.modulation-edit-finished(2); } }
        ParameterKnob { width: 60px; diameter: 36px; label: root.color-label; tooltip: "Delay, phase centre, or tape age"; value <=> root.character; default-value: 0.45; value-text: round(root.character * 100) + " %"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[3]; modulation-depth: root.modulation-depths[3]; modulation-offset: root.modulation-offsets[3]; modulation-route-count: root.modulation-route-counts[3]; changed(v) => { root.character-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(3, v); } modulation-edit-started => { root.modulation-edit-started(3); } modulation-edit-finished => { root.modulation-edit-finished(3); } }
        ParameterKnob { width: 60px; diameter: 36px; label: "Feedback"; tooltip: "Regeneration or phase resonance"; bipolar: true; value <=> root.feedback; default-value: 0.5; value-text: round((root.feedback * 1.84 - 0.92) * 100) + " %"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[4]; modulation-depth: root.modulation-depths[4]; modulation-offset: root.modulation-offsets[4]; modulation-route-count: root.modulation-route-counts[4]; changed(v) => { root.feedback-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(4, v); } modulation-edit-started => { root.modulation-edit-started(4); } modulation-edit-finished => { root.modulation-edit-finished(4); } }
    }

    HorizontalLayout {
        x: 190px;
        y: 150px;
        width: 240px;
        height: 80px;
        spacing: 0px;
        ParameterKnob { width: 60px; diameter: 36px; label: "Spread"; tooltip: "Stereo LFO phase offset"; value <=> root.spread; default-value: 0.65; value-text: round(root.spread * 100) + " %"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[5]; modulation-depth: root.modulation-depths[5]; modulation-offset: root.modulation-offsets[5]; modulation-route-count: root.modulation-route-counts[5]; changed(v) => { root.spread-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(5, v); } modulation-edit-started => { root.modulation-edit-started(5); } modulation-edit-finished => { root.modulation-edit-finished(5); } }
        ParameterKnob { width: 60px; diameter: 36px; label: "Tone"; tooltip: "Brightness of the processed signal"; value <=> root.tone; default-value: 0.75; value-text: round(root.tone * 100) + " %"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[6]; modulation-depth: root.modulation-depths[6]; modulation-offset: root.modulation-offsets[6]; modulation-route-count: root.modulation-route-counts[6]; changed(v) => { root.tone-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(6, v); } modulation-edit-started => { root.modulation-edit-started(6); } modulation-edit-finished => { root.modulation-edit-finished(6); } }
        ParameterKnob { width: 60px; diameter: 36px; label: "Stages"; tooltip: "Number of all-pass stages in Phaser mode"; enabled: root.mode == 2; value <=> root.stages; default-value: 0.5; value-text: root.stage-count + ""; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[7]; modulation-depth: root.modulation-depths[7]; modulation-offset: root.modulation-offsets[7]; modulation-route-count: root.modulation-route-counts[7]; changed(v) => { root.stages-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(7, v); } modulation-edit-started => { root.modulation-edit-started(7); } modulation-edit-finished => { root.modulation-edit-finished(7); } }
        ParameterKnob { width: 60px; diameter: 36px; label: "Wet"; tooltip: "Primary processed-signal blend"; value <=> root.wet-dry; default-value: 1; value-text: round(root.wet-dry * 100) + " %"; changed(v) => { root.wet-dry-changed(v); } }
    }

    Rectangle {
        x: 196px;
        y: 76px;
        width: 7px;
        height: 7px;
        border-radius: self.width / 2;
        background: Theme.accent;
        opacity: 0.2 + 0.8 * (0.5 + 0.5 * sin(root.lfo-phase * 360deg));
    }

    pulse := Timer {
        interval: 16ms;
        running: true;
        triggered => {
            root.lfo-phase = Math.mod(root.lfo-phase + root.rate-hz * 0.016, 1);
        }
    }
}
