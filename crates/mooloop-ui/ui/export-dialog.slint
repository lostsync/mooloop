import { CheckBox, LineEdit, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SectionLabel, SegmentedControl, SelectorBank, ToolButton } from "controls.slint";

// One of the dialog's buttons. `primary` is the accent-filled one.
component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    width: 76px;
    height: 28px;
    border-radius: Theme.radius-md;
    background: !root.enabled
        ? Theme.surface
        : root.primary
            ? (touch.pressed ? Theme.accent-active : Theme.accent)
            : (touch.has-hover ? Theme.surface-active : Theme.surface-raised);
    Text {
        text: root.label;
        color: !root.enabled ? Theme.text-faint : root.primary ? Theme.background : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One section of the settings: its name in a fixed left column, its
// controls on the right, one or more rows of them.
component Section inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    SectionLabel {
        text: root.label;
        width: 56px;
        height: 26px;
        vertical-alignment: center;
    }
    VerticalLayout {
        spacing: 6px;
        horizontal-stretch: 1;
        @children
    }
}

// One track on the Source's checklist (MOO-182). `id` is the track's
// durable identity, which Rust reads back; `depth` indents a bus's feeders
// under it.
export struct ExportTrackRow {
    id: int,
    name: string,
    checked: bool,
    depth: int,
}

// The Range choice: SegmentedControl's look, with one segment that can be
// unavailable -- the loop selection, when the song has none (MOO-181).
component RangeChoice inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index;
    in property <int> unavailable-index: -1;
    in property <string> hint;
    callback selected(int);

    min-height: 26px;
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: Theme.hairline;
    border-color: Theme.border;

    HorizontalLayout {
        spacing: 1px;
        for option[i] in root.options : ToolButton {
            text: option;
            hint: root.hint;
            active: root.selected-index == i;
            enabled: i != root.unavailable-index;
            horizontal-stretch: 1;
            accessible-checkable: true;
            accessible-checked: root.selected-index == i;
            clicked => { root.selected(i); }
        }
    }
}

// The export dialog, in three phases on one card: the settings, the render
// with its progress and a Cancel, and what the render found (MOO-125). The
// card stays up for all three, so a render is never something that happens
// behind a closed dialog with only the status bar to say it finished.
//
// The settings are five sections -- Source, Range, Format, Tail, Output --
// each a row group under one label column (MOO-180). Source is the master
// mix or tracks, each checked track to its own file with a checklist under
// it (MOO-182), and the delivery formats (MOO-186) grow Format. Range is a choice of four, with
// the stretch it covers shown as bar.beat underneath (MOO-181). Format is
// WAV or MP3 with stereo or mono, then the depth and dither of a WAV or the
// bitrate of an MP3 (MOO-186). Output is on the card itself: a folder and a name,
// with no save-file chooser, because one render can write several files.
export component ExportDialog inherits Rectangle {
    in-out property <bool> open;
    // 0 WAV, 1 MP3 (MOO-186).
    in-out property <int> format-index;
    // The WAV's depth: 0 16-bit, 1 24-bit, 2 32-bit float.
    in-out property <int> depth-index: 1;
    // TPDF dither before rounding, for 16- and 24-bit; a float file takes
    // none. Picking a depth sets it to that depth's default.
    in-out property <bool> dither;
    // One channel, (L + R) / 2, instead of two.
    in-out property <bool> mono;
    // 0 192, 1 256, 2 320 kbps.
    in-out property <int> bitrate-index: 2;
    // The most tail there may be. The render stops as soon as every device
    // has fallen silent, so this is a cap rather than a length.
    in-out property <int> tail-seconds: 10;
    // What is rendered (MOO-182): 0 the master mix, 1 tracks, each checked
    // track to its own file, with the master too if `with-master`.
    in-out property <int> source-index;
    in-out property <[ExportTrackRow]> tracks;
    in-out property <bool> with-master;
    in-out property <bool> skip-silent;
    // Which stretch of it (MOO-181): 0 the whole song, 1 the loop
    // selection, 2 a custom range, 3 the current pattern. `range-from` and
    // `range-to` show the stretch as bar.beat, and are typed only for a
    // custom range; Rust fills them for the others.
    in-out property <int> range-index;
    in-out property <string> range-from;
    in-out property <string> range-to;
    in property <bool> loop-available;
    in property <string> pattern-label: "Pattern";
    // The range can be rendered; Export waits for it.
    in property <bool> range-ok: true;
    // The folder typed or browsed to. Empty is `default-folder`, shown as
    // the field's placeholder: the song's own folder, or the music folder
    // for a song never saved.
    in-out property <string> folder;
    in property <string> default-folder;
    // The file name without its extension. Empty is `default-name`.
    in-out property <string> file-name;
    in property <string> default-name;
    // "Don't overwrite: number it" (MOO-188): a name already in the folder
    // is written as name-001, name-002. Off, a file there is replaced, after
    // asking.
    in-out property <bool> number-existing: true;
    // The file the export will write, numbering included, in a few words.
    // Rust fills it whenever `output-edited` says the name may have changed.
    in property <string> output-preview;
    callback output-edited;
    // The folder chooser is up; Browse waits for it.
    in property <bool> browsing;
    // Why the settings can't be exported as they are, in one sentence.
    in property <string> problem;
    // 0: the settings. 1: rendering. 2: the result.
    in-out property <int> phase;
    // How far the render is, 0 to 1. Negative before it has started.
    in property <float> progress: -1;
    in property <string> result-title;
    in property <string> result-detail;
    callback accepted;
    // A range was picked, or a custom one typed: Rust fills the fields and
    // says whether the range can be rendered.
    callback range-picked;
    callback range-edited;
    callback browse-folder;
    // All or None on the track checklist.
    callback tracks-all(bool);
    callback cancelled;
    callback cancel-render;
    callback dismissed;

    visible: root.open;
    background: #00000099;
    z: 200;
    // Nothing behind the card takes a click while it is up.
    TouchArea { }
    Rectangle {
        width: min(parent.width - 32px, 460px);
        // A checklist adds its list and its option row (MOO-182).
        height: root.phase == 0 ? (root.source-index == 1 ? 616px : 460px)
            : root.phase == 2 ? 250px : 180px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-width: Theme.hairline;
        border-color: Theme.border;
        border-radius: Theme.radius-lg;
        if root.phase == 0: VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { text: "Export Audio"; color: Theme.text; font-size: Theme.text-3xl; }
            Section {
                label: "SOURCE";
                SegmentedControl {
                    options: ["Master mix", "Tracks"];
                    hint: "Tracks writes each checked track's own output, after its fader and before what it feeds, to its own file: no limiter runs on a stem, so float is the safe format";
                    selected-index: root.source-index;
                    selected(index) => { root.source-index = index; }
                }
                if root.source-index == 1: Rectangle {
                    height: 112px;
                    background: Theme.background;
                    border-radius: Theme.radius-md;
                    border-width: Theme.hairline;
                    border-color: Theme.border;
                    ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 0px;
                            for row[i] in root.tracks: HorizontalLayout {
                                padding-left: row.depth * 16px;
                                CheckBox {
                                    text: row.name;
                                    checked: row.checked;
                                    toggled => { root.tracks[i].checked = self.checked; }
                                }
                            }
                        }
                    }
                }
                if root.source-index == 1: HorizontalLayout {
                    spacing: 6px;
                    ToolButton {
                        text: "All";
                        width: 36px;
                        hint: "Check every track";
                        clicked => { root.tracks-all(true); }
                    }
                    ToolButton {
                        text: "None";
                        width: 44px;
                        hint: "Uncheck every track";
                        clicked => { root.tracks-all(false); }
                    }
                    CheckBox {
                        text: "+ master";
                        checked <=> root.with-master;
                    }
                    CheckBox {
                        text: "Skip silent";
                        checked <=> root.skip-silent;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Section {
                label: "RANGE";
                RangeChoice {
                    options: ["Whole song", "Loop", "Custom", root.pattern-label];
                    hint: "What is rendered. A note that starts before the range is not played, as when playing from a locate";
                    selected-index: root.range-index;
                    unavailable-index: root.loop-available ? -1 : 1;
                    selected(index) => {
                        root.range-index = index;
                        root.range-picked();
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "from";
                        color: Theme.text-muted;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        width: 80px;
                        text <=> root.range-from;
                        enabled: root.range-index == 2;
                        edited => { root.range-edited(); }
                    }
                    Text {
                        text: "to";
                        color: Theme.text-muted;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        width: 80px;
                        text <=> root.range-to;
                        enabled: root.range-index == 2;
                        edited => { root.range-edited(); }
                    }
                    Text {
                        text: "bar.beat";
                        color: Theme.text-faint;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
            Section {
                label: "FORMAT";
                HorizontalLayout {
                    spacing: 8px;
                    SegmentedControl {
                        options: ["WAV", "MP3"];
                        hint: "The file format: WAV for a master or further work, MP3 to share";
                        selected-index: root.format-index;
                        selected(index) => {
                            root.format-index = index;
                            root.output-edited();
                        }
                    }
                    SegmentedControl {
                        options: ["Stereo", "Mono"];
                        hint: "Mono writes one channel, (L + R) / 2: a centred sound keeps its level, a hard-panned one is 6 dB down";
                        selected-index: root.mono ? 1 : 0;
                        selected(index) => { root.mono = index == 1; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    if root.format-index == 0: SelectorBank {
                        options: ["16", "24", "32 float"];
                        tooltip: "The WAV's bit depth";
                        selected-index: root.depth-index;
                        // Dither follows the depth's default each time
                        // the depth is picked: on at 16, off at 24.
                        selected(index) => {
                            root.depth-index = index;
                            root.dither = index == 0;
                        }
                    }
                    if root.format-index == 0: Text {
                        text: "bit";
                        color: Theme.text-muted;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                    }
                    if root.format-index == 0: CheckBox {
                        text: "Dither";
                        enabled: root.depth-index != 2;
                        checked: root.dither && root.depth-index != 2;
                        toggled => { root.dither = self.checked; }
                    }
                    if root.format-index == 1: SelectorBank {
                        options: ["192", "256", "320"];
                        tooltip: "The MP3's bitrate";
                        selected-index: root.bitrate-index;
                        selected(index) => { root.bitrate-index = index; }
                    }
                    if root.format-index == 1: Text {
                        text: "kbps";
                        color: Theme.text-muted;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Section {
                label: "TAIL";
                HorizontalLayout {
                    spacing: 8px;
                    SpinBox { value <=> root.tail-seconds; minimum: 0; maximum: 30; width: 90px; }
                    Text {
                        text: "s at most; it ends when the sound does";
                        color: Theme.text-faint;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
            Section {
                label: "OUTPUT";
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.folder;
                        placeholder-text: root.default-folder;
                        horizontal-stretch: 1;
                        edited => { root.output-edited(); }
                    }
                    DialogButton {
                        label: root.browsing ? "Browsing" : "Browse...";
                        enabled: !root.browsing;
                        clicked => { root.browse-folder(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.file-name;
                        placeholder-text: root.default-name;
                        horizontal-stretch: 1;
                        edited => { root.output-edited(); }
                    }
                    Text {
                        width: 76px;
                        text: root.format-index == 1 ? ".mp3" : ".wav";
                        color: Theme.text-muted;
                        font-size: Theme.text-lg;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    CheckBox {
                        text: "Don't overwrite: number it";
                        checked: root.number-existing;
                        toggled => {
                            root.number-existing = self.checked;
                            root.output-edited();
                        }
                    }
                    Text {
                        text: root.output-preview;
                        color: Theme.text-faint;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
            Text {
                text: root.problem;
                color: Theme.destructive;
                font-size: Theme.text-md;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                DialogButton {
                    label: "Cancel";
                    clicked => { root.cancelled(); root.open = false; }
                }
                DialogButton {
                    label: "Export";
                    primary: true;
                    enabled: !root.browsing && root.range-ok;
                    clicked => { root.accepted(); }
                }
            }
        }
        if root.phase == 1: VerticalLayout {
            padding: 18px;
            spacing: 14px;
            Text { text: "Exporting"; color: Theme.text; font-size: Theme.text-3xl; }
            Text {
                text: root.progress < 0 ? "Starting" : "Rendering " + round(root.progress * 100) + "%";
                color: Theme.text-muted;
                font-size: Theme.text-md;
            }
            Rectangle {
                height: 8px;
                border-radius: Theme.radius-sm;
                background: Theme.surface-raised;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.progress, 0, 1);
                    border-radius: Theme.radius-sm;
                    background: Theme.accent;
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                DialogButton {
                    label: "Cancel";
                    clicked => { root.cancel-render(); }
                }
            }
        }
        if root.phase == 2: VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { text: "Exported"; color: Theme.text; font-size: Theme.text-3xl; }
            Text {
                text: root.result-title;
                color: Theme.text;
                font-size: Theme.text-lg;
                overflow: elide;
            }
            Text {
                text: root.result-detail;
                color: Theme.text-muted;
                font-size: Theme.text-md;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                alignment: end;
                DialogButton {
                    label: "OK";
                    primary: true;
                    clicked => { root.dismissed(); }
                }
            }
        }
    }
}
