import { ComboBox, SpinBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One of the dialog's buttons. `primary` is the accent-filled one.
component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked;
    width: 76px;
    height: 28px;
    border-radius: Theme.radius-md;
    background: root.primary
        ? (touch.pressed ? Theme.accent-active : Theme.accent)
        : (touch.has-hover ? Theme.surface-active : Theme.surface-raised);
    Text {
        text: root.label;
        color: root.primary ? Theme.background : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The export dialog, in three phases on one card: the settings, the render
// with its progress and a Cancel, and what the render found (MOO-125). The
// card stays up for all three, so a render is never something that happens
// behind a closed dialog with only the status bar to say it finished.
export component ExportDialog inherits Rectangle {
    in-out property <bool> open;
    in-out property <int> format-index;
    in-out property <int> bitrate-index: 2;
    // The most tail there may be. The render stops as soon as every device
    // has fallen silent, so this is a cap rather than a length.
    in-out property <int> tail-seconds: 10;
    // 0: the settings. 1: rendering. 2: the result.
    in-out property <int> phase;
    // How far the render is, 0 to 1. Negative while the file picker is still
    // open and nothing has started.
    in property <float> progress: -1;
    in property <string> result-title;
    in property <string> result-detail;
    callback accepted(int, int, int);
    callback cancelled;
    callback cancel-render;
    callback dismissed;

    visible: root.open;
    background: #00000099;
    z: 200;
    Rectangle {
        width: 390px;
        height: root.phase == 2 ? 250px : 230px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-width: Theme.hairline;
        border-color: Theme.border;
        border-radius: Theme.radius-lg;
        if root.phase == 0: VerticalLayout {
            padding: 18px;
            spacing: 14px;
            Text { text: "Export Audio"; color: Theme.text; font-size: Theme.text-3xl; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "FORMAT"; color: Theme.text-faint; font-size: Theme.text-md; vertical-alignment: center; }
                ComboBox {
                    model: ["WAV 24-bit PCM", "WAV 32-bit float", "MP3"];
                    current-index <=> root.format-index;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "MP3 RATE"; color: Theme.text-faint; font-size: Theme.text-md; vertical-alignment: center; }
                ComboBox {
                    enabled: root.format-index == 2;
                    model: ["192 kbps", "256 kbps", "320 kbps"];
                    current-index <=> root.bitrate-index;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "TAIL, AT MOST (S)"; color: Theme.text-faint; font-size: Theme.text-md; vertical-alignment: center; }
                SpinBox { value <=> root.tail-seconds; minimum: 0; maximum: 30; width: 100px; }
                Text {
                    text: "ends when the sound does";
                    color: Theme.text-faint;
                    font-size: Theme.text-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                DialogButton {
                    label: "Cancel";
                    clicked => { root.cancelled(); root.open = false; }
                }
                DialogButton {
                    label: "Export";
                    primary: true;
                    clicked => { root.accepted(root.format-index, root.bitrate-index, root.tail-seconds); }
                }
            }
        }
        if root.phase == 1: VerticalLayout {
            padding: 18px;
            spacing: 14px;
            Text { text: "Exporting"; color: Theme.text; font-size: Theme.text-3xl; }
            Text {
                text: root.progress < 0 ? "Choose where to save it" : "Rendering " + round(root.progress * 100) + "%";
                color: Theme.text-muted;
                font-size: Theme.text-md;
            }
            Rectangle {
                height: 8px;
                border-radius: Theme.radius-sm;
                background: Theme.surface-raised;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.progress, 0, 1);
                    border-radius: Theme.radius-sm;
                    background: Theme.accent;
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                DialogButton {
                    label: "Cancel";
                    clicked => { root.cancel-render(); }
                }
            }
        }
        if root.phase == 2: VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { text: "Exported"; color: Theme.text; font-size: Theme.text-3xl; }
            Text {
                text: root.result-title;
                color: Theme.text;
                font-size: Theme.text-lg;
                overflow: elide;
            }
            Text {
                text: root.result-detail;
                color: Theme.text-muted;
                font-size: Theme.text-md;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                alignment: end;
                DialogButton {
                    label: "OK";
                    primary: true;
                    clicked => { root.dismissed(); }
                }
            }
        }
    }
}
