import { Theme } from "theme.slint";
import { NoteFormat, ParameterKnob, SelectorBank } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";
import { FilterResponseDisplay } from "device-displays.slint";

// One filter effect in a channel's device rack: only the working controls
// live here; the header and drag-to-reorder come from the shared
// EffectDeviceShell, and bypass/remove live on the host DeviceFrame.
export component FilterDeviceFace inherits EffectDeviceShell {
    name: "Filter";
    kind: "FX / 1U";
    in-out property <int> mode;         // 0 = low-pass, 1 = band-pass, 2 = high-pass
    in-out property <float> cutoff;     // perceptual 0..1 (20 Hz .. 20 kHz)
    in-out property <float> resonance;  // 0..1
    in-out property <int> slope;        // 0 = 12 dB/oct, 1 = 24 dB/oct
    in-out property <float> drive;      // 0..1 compensated soft saturation
    in property <bool> modulation-armed;
    in property <float> cutoff-modulation-depth;
    callback cutoff-changed(float);
    callback cutoff-modulation-depth-changed(float);
    callback cutoff-modulation-edit-started();
    callback cutoff-modulation-edit-finished();
    callback resonance-changed(float);
    callback mode-changed(int);
    callback slope-changed(int);
    callback drive-changed(float);

    VerticalLayout {
        padding: 6px;
        padding-top: DeviceRackMetrics.header-height + 6px;
        spacing: 4px;
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            SelectorBank {
                options: ["LP", "BP", "HP"];
                selected-index <=> root.mode;
                segment-width: 30px;
                tooltip: "Filter mode";
                selected(i) => { root.mode-changed(i); }
            }
            SelectorBank {
                options: ["12", "24"];
                selected-index <=> root.slope;
                segment-width: 30px;
                tooltip: "Filter slope (dB per octave)";
                selected(i) => { root.slope-changed(i); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            height: 104px;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            FilterResponseDisplay {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                mode: root.mode;
                cutoff: root.cutoff;
                resonance: root.resonance;
                slope: root.slope;
                env-amount: 0;
                point-dragged(cutoff, resonance) => {
                    root.cutoff-changed(cutoff);
                    root.resonance-changed(resonance);
                }
                point-scrolled(resonance) => { root.resonance-changed(resonance); }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            ParameterKnob {
                width: 52px;
                diameter: 36px;
                label: "Cutoff";
                tooltip: "Filter cutoff frequency: " + NoteFormat.name(20 * pow(1000, root.cutoff));
                value <=> root.cutoff;
                default-value: 0.9;
                modulation-armed: root.modulation-armed;
                modulation-depth: root.cutoff-modulation-depth;
                value-text: round(20 * pow(1000, root.cutoff)) + " Hz";
                changed(v) => { root.cutoff-changed(v); }
                modulation-depth-changed(v) => { root.cutoff-modulation-depth-changed(v); }
                modulation-edit-started => { root.cutoff-modulation-edit-started(); }
                modulation-edit-finished => { root.cutoff-modulation-edit-finished(); }
            }
            ParameterKnob {
                width: 52px;
                diameter: 36px;
                label: "Reso";
                tooltip: "Filter resonance";
                value <=> root.resonance;
                default-value: 0;
                value-text: round(root.resonance * 100) + "%";
                changed(v) => { root.resonance-changed(v); }
            }
            ParameterKnob {
                width: 52px;
                diameter: 36px;
                label: "Drive";
                tooltip: "Soft saturation before the filter";
                value <=> root.drive;
                default-value: 0;
                value-text: round(root.drive * 100) + "%";
                changed(v) => { root.drive-changed(v); }
            }
        }
    }
}
