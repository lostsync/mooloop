import { Theme } from "theme.slint";
import { NoteFormat, ParameterKnob, SelectorBank } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";
import { FilterResponseDisplay } from "device-displays.slint";

// One filter effect in a channel's device rack: only the working controls
// live here; the header and drag-to-reorder come from the shared
// EffectDeviceShell, and bypass/remove live on the host DeviceFrame.
export component FilterDeviceFace inherits EffectDeviceShell {
    name: "Filter";
    kind: "FX / 1U";
    in-out property <int> mode;         // 0 = low-pass, 1 = high-pass
    in-out property <float> cutoff;     // perceptual 0..1 (20 Hz .. 20 kHz)
    in-out property <float> resonance;  // 0..1
    callback cutoff-changed(float);
    callback resonance-changed(float);
    callback mode-changed(int);

    VerticalLayout {
        padding: 6px;
        padding-top: DeviceRackMetrics.header-height + 6px;
        spacing: 4px;
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            SelectorBank {
                options: ["LP", "HP"];
                selected-index <=> root.mode;
                segment-width: 30px;
                tooltip: "Filter mode";
                selected(i) => { root.mode-changed(i); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            height: 104px;
            background: Theme.panel;
            border-radius: 2px;
            FilterResponseDisplay {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                mode: root.mode == 0 ? 0 : 2;
                cutoff: root.cutoff;
                resonance: root.resonance;
                env-amount: 0;
            }
        }
        HorizontalLayout {
            spacing: 0px;
            ParameterKnob {
                width: 52px;
                diameter: 36px;
                label: "Cutoff";
                tooltip: "Filter cutoff frequency";
                value <=> root.cutoff;
                default-value: 0.9;
                value-text: NoteFormat.frequency-value(20 * pow(1000, root.cutoff));
                changed(v) => { root.cutoff-changed(v); }
            }
            ParameterKnob {
                width: 52px;
                diameter: 36px;
                label: "Reso";
                tooltip: "Filter resonance";
                value <=> root.resonance;
                default-value: 0;
                value-text: round(root.resonance * 100) + "%";
                changed(v) => { root.resonance-changed(v); }
            }
        }
    }
}
