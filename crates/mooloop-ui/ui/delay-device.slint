import { Theme } from "theme.slint";
import { ParameterKnob, SelectorBank, TimeDivisionKnob } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";
import { DelayEchoDisplay } from "device-displays.slint";

// One delay in a channel's device rack. Three units wide: its musical time
// selector sits beside the five working controls instead of compressing them.
// Header and drag come from
// the shared EffectDeviceShell.
export component DelayDeviceFace inherits EffectDeviceShell {
    name: "Delay";
    kind: "FX / 3U";
    in-out property <int> mode;      // 0 = digital, 1 = tape, 2 = reverse
    in-out property <float> time;     // normalized 0..1 (1 ms .. 2000 ms)
    in-out property <float> feedback; // normalized 0..1
    in-out property <float> cross;    // normalized 0..1
    in-out property <float> tone;     // normalized 0..1
    in-out property <float> mix;      // normalized 0..1
    in property <int> bpm: 120;
    in-out property <bool> tempo-sync;
    in-out property <int> time-division: 1;
    callback time-changed(float);
    callback feedback-changed(float);
    callback mode-changed(int);
    callback cross-changed(float);
    callback tone-changed(float);
    callback mix-changed(float);
    callback tempo-sync-changed(bool);
    callback time-division-changed(int);

    // Normalized -> natural, matching ParamCurve::Exponential over [1, 2000].
    private property <float> time-natural: pow(2000, root.time);
    private property <float> feedback-natural: root.feedback * 0.98;

    VerticalLayout {
        padding: 6px;
        padding-top: DeviceRackMetrics.header-height + 6px;
        spacing: 4px;
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            SelectorBank {
                options: ["DIGI", "TAPE", "REV"];
                selected-index <=> root.mode;
                segment-width: 38px;
                tooltip: "How the repeats respond when the time moves";
                selected(i) => { root.mode-changed(i); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            height: 104px;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            DelayEchoDisplay {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                time-ms: root.time-natural;
                feedback: root.feedback-natural;
                cross: root.cross;
            }
        }
        HorizontalLayout {
            spacing: 0px;
            TimeDivisionKnob {
                label: "Time";
                tooltip: "Free milliseconds or a tempo-synced beat division";
                value <=> root.time;
                bpm: root.bpm;
                tempo-sync <=> root.tempo-sync;
                division <=> root.time-division;
                default-value: 0.7815;
                changed(v) => { root.time-changed(v); }
                tempo-sync-changed(enabled) => { root.tempo-sync-changed(enabled); }
                division-changed(index) => { root.time-division-changed(index); }
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[0];
                modulation-depth: root.modulation-depths[0];
                modulation-offset: root.modulation-offsets[0];
                modulation-route-count: root.modulation-route-counts[0];
                modulation-depth-changed(v) => { root.modulation-depth-changed(0, v); }
                modulation-edit-started => { root.modulation-edit-started(0); }
                modulation-edit-finished => { root.modulation-edit-finished(0); }
            }
            ParameterKnob {
                width: 85px;
                diameter: 40px;
                label: "Fdbk";
                tooltip: "How much of each repeat feeds the next";
                value <=> root.feedback;
                default-value: 0.3571;
                value-text: round(root.feedback-natural * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[1];
                modulation-depth: root.modulation-depths[1];
                modulation-offset: root.modulation-offsets[1];
                modulation-route-count: root.modulation-route-counts[1];
                changed(v) => { root.feedback-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(1, v); }
                modulation-edit-started => { root.modulation-edit-started(1); }
                modulation-edit-finished => { root.modulation-edit-finished(1); }
            }
            ParameterKnob {
                width: 85px;
                diameter: 40px;
                label: "Cross";
                tooltip: "Feedback crossing to the other channel; full is ping-pong";
                value <=> root.cross;
                default-value: 0.0;
                value-text: round(root.cross * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[3];
                modulation-depth: root.modulation-depths[3];
                modulation-offset: root.modulation-offsets[3];
                modulation-route-count: root.modulation-route-counts[3];
                changed(v) => { root.cross-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(3, v); }
                modulation-edit-started => { root.modulation-edit-started(3); }
                modulation-edit-finished => { root.modulation-edit-finished(3); }
            }
            ParameterKnob {
                width: 85px;
                diameter: 40px;
                label: "Tone";
                tooltip: "Damping of the repeats: dark to open";
                value <=> root.tone;
                default-value: 0.6;
                value-text: round(root.tone * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[4];
                modulation-depth: root.modulation-depths[4];
                modulation-offset: root.modulation-offsets[4];
                modulation-route-count: root.modulation-route-counts[4];
                changed(v) => { root.tone-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(4, v); }
                modulation-edit-started => { root.modulation-edit-started(4); }
                modulation-edit-finished => { root.modulation-edit-finished(4); }
            }
            // Delay's own repeat blend is intentionally kept alongside the
            // generic host Wet/dry control for the rare but useful nested mix.
            ParameterKnob {
                width: 85px;
                diameter: 40px;
                label: "Mix";
                tooltip: "Delay's internal dry/wet blend";
                value <=> root.mix;
                default-value: 0.35;
                value-text: round(root.mix * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[5];
                modulation-depth: root.modulation-depths[5];
                modulation-offset: root.modulation-offsets[5];
                modulation-route-count: root.modulation-route-counts[5];
                changed(v) => { root.mix-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(5, v); }
                modulation-edit-started => { root.modulation-edit-started(5); }
                modulation-edit-finished => { root.modulation-edit-finished(5); }
            }
        }
    }
}
