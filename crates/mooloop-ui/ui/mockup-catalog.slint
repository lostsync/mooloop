        {
            component: "DraggablePoint", name: "Draggable point", module: "controls.slint",
            groups: ["Knobs & faders", "Scopes & displays"],
            default-width: 16px, default-height: 16px, behavior: 0,
        },
        {
            component: "DeviceJoin", name: "Device join", module: "device-rack.slint",
            groups: ["Device rack"], default-width: 20px, default-height: 268px, behavior: 0,
        },
        {
            component: "DeviceAddSlot", name: "Device add slot", module: "device-rack.slint",
            groups: ["Device rack"], default-width: 50px, default-height: 268px, behavior: 0,
        },
        {
            component: "DevicePageButton", name: "Device page button", module: "device-rack.slint",
            groups: ["Device rack", "Buttons"], default-width: 60px, default-height: 22px, behavior: 2,
        },
        {
            component: "MixerPane", name: "Mixer pane", module: "mixer.slint",
            groups: ["Mixer"], default-width: 440px, default-height: 320px, behavior: 0,
        },
        {
            component: "OscillatorDeviceStrip", name: "Oscillator strip",
            module: "device-oscillator.slint", groups: ["Device rack", "Mixer"],
            default-width: 190px, default-height: 190px, behavior: 1,
        },
    ];

    // Rack geometry for a device kind, so the tool can only ever produce a
    // width the real rack would lay out. Half a unit is a unit split down the
    // middle, gap included, which is how DeviceJoin divides one.
    public pure function unit-width(units: int, half: bool) -> length {
        half
            ? DeviceRackMetrics.unit-width / 2 - DeviceRackMetrics.half-gap / 2
            : DeviceRackMetrics.unit-width * units
                + DeviceRackMetrics.half-gap * (units - 1)
    }
}

// The mockup tool's own annotation widget: a scrap of paper for the intent
// behind a layout. Lives here rather than in mockup.slint so the audit sees a
// real exported component behind its catalog row.
export component StickyNote inherits Rectangle {
    in property <string> text;
    callback edited(string);
    callback background-clicked;

    background: Theme.warning.with-alpha(0.16);
    border-width: 1px;
    border-color: Theme.warning.with-alpha(0.5);
    border-radius: Theme.radius-md;

    // Sits under the text input so a click on the note's own border still
    // selects it - the input itself covers most of the area and needs plain
    // clicks for caret placement.
    TouchArea { clicked => { root.background-clicked(); } }
    TextInput {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        text: root.text;
        color: Theme.text;
        font-size: 10px;
        wrap: word-wrap;
        single-line: false;
        edited => { root.edited(self.text); }
    }
}

// Every palette kind's live rendering, indexed by its position in
// `MockupCatalog.kinds`. The one if-chain in the tool.
export component MockupSpecimen inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    in property <float> value;
    in property <string> text;
    callback note-edited(string);
    callback note-clicked;

    if root.kind == 0: InstrumentModule {
        title: root.label == "" ? "MODULE" : root.label;
        width: 100%;
        height: 100%;
    }
    if root.kind == 1: SectionLabel {
        text: root.label == "" ? "SECTION" : root.label;
    }
    if root.kind == 2: ParameterKnob {
        label: root.label == "" ? "PARAM" : root.label;
        value: root.value;
        value-text: round(root.value * 100) + "%";
        width: 100%;
        height: 100%;
    }
    if root.kind == 3: MiniKnob {
        label: root.label;
        value: root.value;
        value-text: round(root.value * 100) + "%";
    }
    if root.kind == 4: ParameterFader {
        label: root.label == "" ? "LEVEL" : root.label;
        value: root.value;
        width: 100%;
    }
    if root.kind == 5: ParameterFader {
        label: root.label == "" ? "LVL" : root.label;
        value: root.value;
        orientation: AudioOrientation.vertical;
        height: 100%;
    }
    if root.kind == 6: MixerFader {
        value: root.value;
        value-text: round(root.value * 100) + "%";
        height: 100%;
    }
    if root.kind == 7: ToggleButton {
        text: root.label == "" ? "Toggle" : root.label;
        checked: root.value > 0.5;
        width: 100%;
        height: 100%;
    }
    if root.kind == 8: ToolButton {
        text: root.label == "" ? "Button" : root.label;
        active: root.value > 0.5;
        width: 100%;
        height: 100%;
    }
    if root.kind == 9: IconButton {
        text: root.label == "" ? "+" : root.label;
        active: root.value > 0.5;
    }
    if root.kind == 10: TransportButton {
        text: root.label == "" ? "\u{25b6}" : root.label;
        active: root.value > 0.5;
    }
    if root.kind == 11: SegmentedControl {
        options: root.label == "" ? ["Mono", "Stereo", "M/S"] : [root.label, "B", "C"];
        selected-index: round(root.value * 2);
        width: 100%;
    }
    if root.kind == 12: SelectorBank {
        options: root.label == "" ? ["Sine", "Saw", "Square"] : [root.label, "B", "C"];
        selected-index: round(root.value * 2);
    }
    if root.kind == 13: LedIndicator {
        on: root.value > 0.5;
        tooltip: root.label;
    }
    if root.kind == 14: ValueReadout {
        value-text: root.label == "" ? "0%" : root.label;
        width: 100%;
        height: 100%;
    }
    if root.kind == 15: EnvelopeEditor {
        width: 100%;
        height: 100%;
        attack: 0.12;
        decay: 0.3;
        sustain: 0.6;
        release: 0.25;
    }
    if root.kind == 16: PeakMeter {
        level-db: root.value * 60 - 60;
        held-db: root.value * 60 - 60;
        width: 100%;
        height: 100%;
    }
    if root.kind == 17: StereoPeakMeter {
        left-db: root.value * 60 - 60;
        right-db: root.value * 60 - 60;
        held-left-db: root.value * 60 - 60;
        held-right-db: root.value * 60 - 60;
        width: 100%;
    }
    if root.kind == 18: StickyNote {
        width: 100%;
        height: 100%;
        text: root.text;
        edited(t) => { root.note-edited(t); }
        background-clicked => { root.note-clicked(); }
    }
    if root.kind == 19: MuteButton {
        muted: root.value > 0.5;
    }
    if root.kind == 20: SoloButton {
        soloed: root.value > 0.5;
    }
    if root.kind == 21: TrimKnob {
        label: root.label == "" ? "TRIM" : root.label;
        value: root.value * 72 - 60;
    }
    if root.kind == 22: ZoomScrollBar {
        width: 100%;
        height: 100%;
        offset: 0.2;
        visible-fraction: 0.4;
    }
    if root.kind == 23: MeterScale {
        width: 100%;
        height: 100%;
    }
    if root.kind == 24: SegmentedMeter {
        level-db: root.value * 60 - 60;
        held-db: root.value * 60 - 60;
        width: 100%;
        height: 100%;
    }
    if root.kind == 25: ClipIndicator {
        clipping: root.value > 0.5;
    }
    if root.kind == 26: ChannelMeter {
        left-db: root.value * 60 - 60;
        right-db: root.value * 60 - 60;
        held-left-db: root.value * 60 - 60;
        held-right-db: root.value * 60 - 60;
        width: 100%;
        height: 100%;
    }
    if root.kind == 27: MasterMeter {
        left-db: root.value * 60 - 60;
        right-db: root.value * 60 - 60;
        held-left-db: root.value * 60 - 60;
        held-right-db: root.value * 60 - 60;
        width: 100%;
    }
    if root.kind == 28: GainReductionMeter {
        reduction-db: root.value * 24;
        width: 100%;
        height: 100%;
    }
    if root.kind == 29: CorrelationMeter {
        correlation: root.value * 2 - 1;
        width: 100%;
    }
    if root.kind == 30: BusPicker {
        bus-names: ["Master", "Bus A", "Bus B"];
        value: round(root.value * 2);
    }
    if root.kind == 31: DeviceHeader {
        name: root.label == "" ? "DEVICE" : root.label;
        kind: "Type";
        width: 100%;
    }
    if root.kind == 32: EffectDeviceShell {
        name: root.label == "" ? "DEVICE" : root.label;
        kind: "Type";
        slot-index: 0;
        slot-count: 1;
        width: 100%;
        height: 100%;
        Rectangle {
            y: DeviceRackMetrics.header-height;
            width: 100%;
            height: parent.height - DeviceRackMetrics.header-height;
            background: Theme.surface;
        }
    }
    if root.kind == 33: DeviceFrame {
        width: 100%;
        height: 100%;
    }
    // A stylised hit rather than real audio: a mockup only needs the shape
    // the widget draws, and a canned envelope keeps it recognisable.
    if root.kind == 34: SampleTrace {
        width: 100%;
        height: 100%;
        minimums: [-0.05, -0.92, -0.71, -0.55, -0.44, -0.36, -0.29, -0.23,
                   -0.18, -0.14, -0.11, -0.08, -0.06, -0.04, -0.03, -0.02];
        maximums: [0.06, 0.88, 0.68, 0.52, 0.42, 0.34, 0.27, 0.22,
                   0.17, 0.13, 0.10, 0.08, 0.06, 0.04, 0.03, 0.02];
    }
    if root.kind == 35: OscillatorTrace {
        width: 100%;
        height: 100%;
        wave: clamp(round(root.value * 4), 0, 4);
        semitones: 0;
        cents: 0;
        level: 0.9;
        pulse-width: 0.5;
    }
    if root.kind == 36: BitcrusherTrace {
        width: 100%;
        height: 100%;
        bit-reduction: root.value;
        rate-reduction: root.value;
    }
    if root.kind == 37: BitcrushTrace {
        width: 100%;
        height: 100%;
        bits: 16 - root.value * 14;
        downsample: 1 + root.value * 24;
    }
    if root.kind == 38: FilterResponseDisplay {
        width: 100%;
        height: 100%;
        mode: 0;
        cutoff: root.value;
        resonance: 0.4;
        slope: 0;
        env-amount: 0;
    }
    if root.kind == 39: DriveTransferDisplay {
        width: 100%;
        height: 100%;
        drive: 1 + root.value * 32;
        curve: 0;
    }
    if root.kind == 40: DelayEchoDisplay {
        width: 100%;
        height: 100%;
        time-ms: 40 + root.value * 560;
        feedback: root.value * 0.8;
        cross: 0;
    }
    if root.kind == 41: DynamicsCurveDisplay {
        width: 100%;
        height: 100%;
        mode: 1;
        threshold-db: root.value * 60 - 60;
        ratio: 4;
        knee-db: 6;
    }
    if root.kind == 42: StepperField {
        width: 100%;
        label: root.label == "" ? "STEP" : root.label;
        value: round(root.value * 99);
    }
    if root.kind == 43: MenuField {
        label: root.label;
        options: ["1/4", "1/8", "1/16"];
        selected-index: round(root.value * 2);
    }
    if root.kind == 44: NameField {
        width: 100%;
        text: root.text;
        placeholder: root.label == "" ? "Name" : root.label;
        edited(t) => { root.note-edited(t); }
    }
    if root.kind == 45: ToolModeButton {
        glyph: root.label == "" ? "\u{270e}" : root.label;
        name: root.label == "" ? "Draw" : root.label;
        active: root.value > 0.5;
    }
    if root.kind == 46: PositionReadout {
        bar: 1 + round(root.value * 63);
        beat: 1 + round(root.value * 3);
        tick: 0;
    }
    if root.kind == 47: TempoField {
        bpm: round(60 + root.value * 140);
    }
    if root.kind == 48: BeatLamps {
        beats: 4;
        current: round(root.value * 3);
        running: true;
    }
    if root.kind == 49: ToolbarRule {
        height: 100%;
    }
    if root.kind == 50: ToolbarLabel {
        text: root.label == "" ? "LABEL" : root.label;
    }
    if root.kind == 51: MenuRow {
        width: 100%;
        text: root.label == "" ? "Save Song" : root.label;
        shortcut: "Ctrl+S";
        checked: root.value > 0.5;
    }
    if root.kind == 52: MenuSeparator {
        width: 100%;
    }
    if root.kind == 53: MenuBarItem {
        title: root.label == "" ? "File" : root.label;
        menu-id: 0;
        titles: [root.label == "" ? "File" : root.label];
        bar-width: root.width;
    }
    // The bar is the row of titles, so a specimen of it needs titles in it;
    // its own `titles` is the source of truth for their order.
    if root.kind == 54: MenuBar {
        width: 100%;
        menu-bar-specimen := MenuBar {}
        for title[i] in menu-bar-specimen.titles: MenuBarItem {
            title: title;
            menu-id: i;
            titles: menu-bar-specimen.titles;
            bar-width: root.width;
        }
    }
    if root.kind == 55: KnobField {
        label: root.label == "" ? "PARAM" : root.label;
        value: root.value;
        display-text: round(root.value * 100) + "%";
    }
    if root.kind == 56: TimeDivisionKnob {
        value: root.value;
        bpm: 120;
    }
    // Interaction-only, so it draws nothing of its own; the mockup gives it
    // the handle its consumers each draw for themselves.
    if root.kind == 57: DraggablePoint {
        width: 100%;
        height: 100%;
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: min(parent.width, parent.height) / 2;
            background: Theme.accent;
            border-width: 1px;
            border-color: Theme.background;
        }
    }
    if root.kind == 58: DeviceJoin {
        width: 100%;
        height: 100%;
    }
    if root.kind == 59: DeviceAddSlot {
        width: 100%;
        height: 100%;
    }
    if root.kind == 60: DevicePageButton {
        text: root.label == "" ? "OSC" : root.label;
        active: root.value > 0.5;
    }
    if root.kind == 61: MixerPane {
        width: 100%;
        height: 100%;
        bus-names: ["Master", "Bus A"];
        strips: [
            {
                name: "Master", volume: 0.8, pan: 0, output: 0, is-master: true,
                feed-count: 2, left-db: -12, right-db: -14,
            },
            {
                name: "Bus A", volume: 0.65, pan: -0.3, output: 0, selected: true,
                feed-count: 1, left-db: -18, right-db: -17,
            },
        ];
    }
    if root.kind == 62: OscillatorDeviceStrip {
        width: 100%;
        height: 100%;
        title: root.label == "" ? "OSC 1" : root.label;
        wave: clamp(round(root.value * 4), 0, 4);
        semitones: 0;
        cents: 0;
        level: 0.8;
        pulse-width: 0.5;
    }
}
