import { Theme } from "theme.slint";
import {
    AudioOrientation, DraggablePoint, IconButton, InstrumentModule, KnobField, LedIndicator,
    MiniKnob, MixerFader, MuteButton, ParameterFader, ParameterKnob, PeakMeter, SectionLabel,
    SegmentedControl, SelectorBank, SoloButton, StereoPeakMeter, TimeDivisionKnob, ToggleButton,
    ToolButton, TransportButton, TrimKnob, ValueReadout, ZoomScrollBar
} from "controls.slint";
import { EnvelopeEditor } from "envelope.slint";
import {
    ChannelMeter, ClipIndicator, CorrelationMeter, GainReductionMeter, MasterMeter, MeterScale,
    SegmentedMeter
} from "meters.slint";
import { BusPicker, MixerPane, MixerStripRow } from "mixer.slint";
import {
    DeviceAddSlot, DeviceFrame, DeviceHeader, DeviceJoin, DevicePageButton, DeviceRackMetrics,
    EffectDeviceShell
} from "device-rack.slint";
import {
    BitcrushTrace, BitcrusherTrace, DelayEchoDisplay, DriveTransferDisplay, DynamicsCurveDisplay,
    FilterResponseDisplay, OscillatorTrace, SampleTrace
} from "device-displays.slint";
import { OscillatorDeviceStrip } from "device-oscillator.slint";
import { MenuBar, MenuBarItem, MenuRow, MenuSeparator } from "menubar.slint";
import {
    BeatLamps, MenuField, NameField, PositionReadout, StepperField, TempoField, ToolbarLabel,
    ToolbarRule, ToolModeButton
} from "toolbar.slint";

// One entry in the mockup tool's palette. This is the single source of truth:
// the palette list, the render switch below, the default sizes, and the drag
// behaviour all read from here, so adding a widget to the tool is one row in
// `MockupCatalog.kinds` plus one branch in `MockupSpecimen`.
export struct MockupKind {
    // Stable save key, and the audit key up to the first ':'. A component with
    // more than one palette presentation (a fader is both horizontal and
    // vertical) gets a ':variant' suffix so the two rows stay distinguishable
    // in a saved layout while still auditing as the one exported component.
    component: string,
    name: string,
    module: string,
    // Many-to-many: a channel meter belongs under both Meters and Mixer.
    groups: [string],
    default-width: length,
    default-height: length,
    // 0 inert, 1 drag-value, 2 toggle, 3 index, 4 note. See PlacedItem in
    // mockup.slint, which reads this instead of comparing kind integers.
    behavior: int,
    // Drag-value kinds that read horizontally rather than vertically.
    drag-horizontal: bool,
    // Sized in rack units by the properties panel rather than by the grip, so
    // a device mockup is always something the real rack could build.
    device-units: bool,
}

export global MockupCatalog {
    out property <[MockupKind]> kinds: [
        {
            component: "InstrumentModule", name: "Module frame", module: "controls.slint",
            groups: ["Layout"], default-width: 220px, default-height: 140px, behavior: 0,
        },
        {
            component: "SectionLabel", name: "Section label", module: "controls.slint",
            groups: ["Layout", "Annotation"], default-width: 120px, default-height: 12px, behavior: 0,
        },
        {
            component: "ParameterKnob", name: "Knob", module: "controls.slint",
