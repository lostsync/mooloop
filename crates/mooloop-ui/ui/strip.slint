// The channel strip every track has, drawn.
//
// One set of components, used by all three places the strip appears: the
// mixer strip's back face (92px, `mixer.slint`), the track's pinned row in
// the device rack (`bus-device.slint`), and -- when it is built -- the zoomed
// console. `docs/plans/archive/console/THE-STRIP.md` is the mockup and
// `docs/UI_DESIGN.md` carries the two rules that pull against each other: a
// page that is not on screen is not built, and no parameter is reachable
// from only one of them.
//
// **No parameter's range, id or default is spelled here.** `StripSpec` is a
// global whose table Rust fills once at startup from `mooloop_core::strip`,
// so a knob's minimum, maximum, default, name and unit all come from the
// descriptor the engine reads -- which is the duplication `AGENTS.md` opens
// on, closed by construction rather than by a test. The one thing the markup
// decides is which parameter goes where.
//
// The two numbers that *are* written here are `EqResponseDisplay`'s axes,
// which `StripEqPage` inverts to turn a dragged point back into hertz and
// decibels. They are the display's convention rather than a parameter's.
// This is the only face that still spells them: the seven-band EQ's point
// writes its parameters directly, because its frequency descriptor runs the
// plot's own 20 Hz to 20 kHz and its gain descriptor the plot's own +-18, so
// a dragged position *is* the normalized value. Those coincidences are what
// `the_response_plots_gain_axis_is_the_bands_gain_range` and
// `a_dragged_point_writes_the_parameter_it_looks_like` hold open; the axis
// itself is `mooloop_core::EQ_PLOT_MIN_HZ`, which the publishers use.

import { Motion, StatusHint, Theme } from "theme.slint";
import { GainMath } from "gain.slint";
import { MiniKnob, NoteFormat, PickerChip, SectionLabel, SelectorBank, ToolButton, ValueScale } from "controls.slint";
import { DynamicsCurveDisplay, EqResponseDisplay } from "device-displays.slint";

// One parameter's identity and range, as `mooloop_core::ParamDescriptor`
// states it. Handed over once at startup, never per frame.
export struct StripParamSpec {
    id: int,
    name: string,
    unit: string,
    minimum: float,
    maximum: float,
    default-value: float,
    // 0 for a continuous parameter, 2 for a switch, 4 for the voicing.
    steps: int,
    logarithmic: bool,
}

// One track's strip, as the pane and Rust exchange it. Values are in natural
// units -- dB, hertz, milliseconds -- because that is what the engine holds
// and what the readouts say; the knobs normalize against the spec.
export struct StripRow {
    voicing: int,
    pre-in: bool,
    drive-db: float,
    eq-in: bool,
    // Four bands, one entry each. Parallel arrays rather than a struct per
    // band so one repeater can draw a row from an index.
    //
    // **The knob's value is the position; the hertz is the readout.** A band
    // is stepped and the voicing decides what each position is worth, so
    // these two are a control and a reading of it rather than one value
    // twice -- see `mooloop_dsp::strip::StripEqTable`.
    band-position: [float],
    band-frequency-hz: [float],
    band-gain-db: [float],
    band-q: [float],
    band-shelf: [bool],
    // The response plot's own conventions: three floats a band to place its
    // handle, and the bank's magnitude response in decibels, sampled by
    // `mooloop_dsp::strip::strip_eq_response_db`. See `EqResponseDisplay`.
    band-data: [float],
    eq-curve-db: [float],
    comp-in: bool,
    threshold-db: float,
    ratio: float,
    attack-ms: float,
    release-ms: float,
    knee-db: float,
    mix: float,
    makeup-db: float,
    // The compressor's static curve as it is *running*, sampled by Rust:
    // the voicing bends the line above the knee and this is how the display
    // shows the bend without holding a second gain computer. See
    // `DynamicsCurveDisplay::curve-db`.
    curve-db: [float],
}

// The parameter table, and every id the markup addresses.
//
// Rust sets all of this once, from `mooloop_core::strip`. It is the reason
// no number below is a literal: `StripSpec.drive-db` *is*
// `mooloop_core::strip::STRIP_DRIVE_DB`, and a knob's range *is* its
// descriptor's.
export global StripSpec {
    in-out property <[StripParamSpec]> params;
    in-out property <int> first;
    in-out property <int> voicing;
    in-out property <int> pre-in;
    in-out property <int> drive-db;
    in-out property <int> eq-in;
    in-out property <int> band-base;
    in-out property <int> band-stride;
    in-out property <int> band-frequency;
    in-out property <int> band-gain;
    in-out property <int> band-q;
    in-out property <int> band-kind;
    in-out property <int> comp-in;
    in-out property <int> threshold-db;
    in-out property <int> ratio;
    in-out property <int> attack-ms;
    in-out property <int> release-ms;
    in-out property <int> knee-db;
    in-out property <int> mix;
    in-out property <int> makeup-db;
    /// The four voicing names, in index order, so the selector does not
    /// spell what `PreampVoicing::label` already says.
    in property <[string]> voicings;
    /// The four bands' names, in the reading order the layout draws them in:
    /// high shelf, high mid, low mid, low shelf. From Rust, so the markup
    /// does not hold a second answer to which row is which.
    in property <[string]> band-names;

    /// One field of one band, the way `strip_band_param` computes it.
    public pure function band(band: int, field: int) -> int {
        return root.band-base + band * root.band-stride + field;
    }

    public pure function spec(id: int) -> StripParamSpec {
        return root.params[clamp(id - root.first, 0, max(0, root.params.length - 1))];
    }

    /// A value in the units its own descriptor names.
    ///
    /// One formatter for the whole strip rather than a readout expression
    /// per knob: the unit string comes from the descriptor, so the knob that
    /// reads "dB" is the knob whose descriptor says dB.
    public pure function format(id: int, value: float) -> string {
        let unit = root.spec(id).unit;
        if (unit == "dB") { return GainMath.format-db(value); }
        if (unit == "Hz") { return NoteFormat.frequency-value(value); }
        if (unit == "ms") { return value < 10 ? round(value * 100) / 100 + " ms" : round(value) + " ms"; }
        if (unit == ":1") { return round(value * 10) / 10 + ":1"; }
        return round(value * 100) / 100;
    }
}

// A knob for one strip parameter, which is the only shape a strip control
// takes. Everything about it but its position comes from the descriptor.
component StripKnob inherits MiniKnob {
    in property <int> param;
    in property <float> natural;
    in property <bool> bipolar-value;
    in property <length> size: 20px;

    private property <StripParamSpec> spec: StripSpec.spec(root.param);

    diameter: root.size;
    label: root.spec.name;
    minimum: root.spec.minimum;
    maximum: root.spec.maximum;
    default-value: root.spec.default-value;
    scale: root.spec.logarithmic ? ValueScale.logarithmic : ValueScale.linear;
    // A stepped parameter quantizes and takes a short throw. Both come off
    // the descriptor's own step count, so a band that gains a position gains
    // the travel for it: 14px a stop, against the 37px one of five cost
    // while the knob was using a continuous control's 150px. The engine
    // rounds the value anyway -- this is about the *gesture*, which was
    // asking for a long drag to cross a switch.
    step: root.spec.steps > 0 ? 1 : 0;
    travel: root.spec.steps > 0 ? root.spec.steps * 14px : 150px;
    bipolar: root.bipolar-value;
    value: root.natural;
    // The caller owns the value: it comes from a model row, so the knob must
    // not keep its own copy or the first drag drops the binding.
    controlled: true;
    // The descriptor's own units, unless the caller has something truer to
    // say: a stepped band's knob holds a position and its reading is the
    // frequency that position selects, which only the voicing knows.
    in property <string> readout;
    value-text: root.readout == "" ? StripSpec.format(root.param, root.natural) : root.readout;
}

// A section's `in` switch, which is the whole of "free while it is out".
// The strip's own sizes, under names, because size *is* meaning here.
//
// Adam's redrawn face sizes a knob by how much it matters -- the EQ's gain is
// bigger than its frequency and Q, the compressor's threshold and ratio
// bigger than its timing -- which is a rule nothing else in this interface
// follows: a device face picks one diameter per class. It reads immediately
// and it will propagate, so it is four numbers here rather than forty in the
// pages, and a rule in `docs/UI_DESIGN.md` rather than a habit.
export global StripMetrics {
    /// The control you reach for first in its section.
    out property <length> knob-major: 28px;
    /// The ones that qualify it.
    out property <length> knob-minor: 20px;
    /// Both again, for a face with room -- the rack row and the zoomed
    /// console. The same hierarchy, four pixels further apart.
    out property <length> knob-major-wide: 34px;
    out property <length> knob-minor-wide: 24px;
    /// A caption under a knob, and the left column that identifies an EQ
    /// row. Eight pixels of text, which is the floor `Theme` goes to.
    out property <length> caption: 9px;
    out property <length> row-label: 11px;
    /// The square in-and-out switch at the head of a section, and the round
    /// lights: a shape switch on a band, and the lamp that reads gain
    /// reduction.
    out property <length> switch: 16px;
    out property <length> light: 9px;
}

// The line-art a shape gets instead of a letter.
//
// Adam, on the row letters: *"they're hard to read anyway, tooltip and
// statusbar are gonna be the user's friend regardless. little icons would be
// fine instead of letters."* So a band is drawn as the curve it *is* --
// which is also the switch that changes it, on the two bands that have a
// choice, so the label and the control are one thing rather than the light
// and the letter the mockup drew separately.
//
// Letters stay where the thing is a quantity rather than a shape: a
// threshold is not a picture. `docs/UI_DESIGN.md` carries that split.
export global StripIcons {
    out property <string> bell: "M 1 13 C 5 13 5 4 8 4 C 11 4 11 13 15 13";
    out property <string> high-shelf: "M 1 12 L 6 12 C 9 12 8 4 15 4";
    out property <string> low-shelf: "M 1 4 C 8 4 7 12 10 12 L 15 12";
    /// The dot the in-and-out switch wears instead of the word `IN`.
    out property <string> dot: "M 6 8 A 2 2 0 1 1 10 8 A 2 2 0 1 1 6 8";
}

// What the strip's lamps read, per track.
//
// One array rather than a field on every strip row, because this is the only
// thing about a strip that changes sixty times a second: the pump writes one
// model a tick, where patching a row per track would clone seventeen of them
// -- and both faces index the same publisher, so the mixer's lamp and the
// rack row's curve cannot disagree about what the compressor is doing.
export global StripMeters {
    /// Gain reduction per track, in dB as a positive amount. Zero while a
    /// track's compressor is out, which takes its lamp dark.
    in-out property <[float]> reduction-db;

    public pure function reduction(track: int) -> float {
        return track >= 0 && track < root.reduction-db.length ? root.reduction-db[track] : 0;
    }
}

// A section's in-and-out switch: a square with a dot in it.
//
// Adam: *"'IN' button can be square with a dot icon."* The word `IN` at 11px
// in a 24px button was the widest thing in a 84px column and said less than
// the dot does -- the section's own label is right beside it, lit when the
// section is in.
component StripInSwitch inherits ToolButton {
    in property <bool> on;

    icon: StripIcons.dot;
    active: root.on;
    text-color: root.on ? Theme.text : Theme.text-faint;
    tooltip: root.on ? "In" : "Out";
    min-width: StripMetrics.switch;
    max-width: StripMetrics.switch;
    min-height: StripMetrics.switch;
    max-height: StripMetrics.switch;
}

// A round light. Two jobs, and only one of them is a control.
//
// As a switch it is a band's shape, drawn as the curve it selects; as a lamp
// it is gain reduction, and `glow` is how hard it is lit. The lamp is
// deliberately the same shape as the switch: what it means is "this section
// is doing something", which is what the switch beside it also means.
component StripLight inherits Rectangle {
    in property <bool> on;
    /// 0 dark, 1 fully lit. A switch leaves it alone and uses `on`.
    in property <float> glow;
    in property <bool> clickable;
    in property <string> tooltip;
    in property <string> hint;
    callback clicked();

    width: StripMetrics.light;
    height: StripMetrics.light;
    border-radius: self.width / 2;
    border-width: Theme.hairline;
    border-color: root.on || root.glow > 0.02 ? Theme.accent : Theme.border;
    background: root.on
        ? Theme.accent
        : Theme.accent.with-alpha(clamp(root.glow, 0, 1) * 0.9);
    // The lamp fades rather than stepping: the engine publishes a held peak
    // per tick and a dot that snapped between them would flicker where the
    // needle beside it moves.
    animate background { duration: Motion.duration; easing: Motion.curve; }

    if root.clickable : TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover) { StatusHint.show(root.hint); }
            else { StatusHint.clear(root.hint); }
        }
    }
    if root.tooltip != "" : Tooltip { text: @markdown("\{root.tooltip}"); }
}

// A knob with a caption under it, which is how the mockup identifies the
// compressor's seven values: one letter each, and the hover text for what it
// actually is.
component StripKnobCell inherits VerticalLayout {
    in property <int> param;
    in property <float> natural;
    in property <bool> bipolar-value;
    in property <length> size;
    in property <string> caption;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <string> readout;
    callback changed(float);

    spacing: 1px;
    alignment: center;

    HorizontalLayout {
        alignment: center;
        StripKnob {
            param: root.param;
            natural: root.natural;
            bipolar-value: root.bipolar-value;
            size: root.size;
            enabled: root.enabled;
            hint: root.hint;
            readout: root.readout;
            changed(v) => { root.changed(v); }
        }
    }
    Text {
        text: root.caption;
        color: root.enabled ? Theme.text-muted : Theme.text-faint;
        font-size: Theme.text-sm;
        height: StripMetrics.caption;
        horizontal-alignment: center;
    }
}

// A section's head: its name, lit when it is in, and the switch that puts it
// there. The compressor's passes a lamp as well.
component StripSectionHead inherits HorizontalLayout {
    in property <string> label;
    in property <bool> on;
    in property <string> hint;
    /// Gain reduction, 0..1, for the section that has a lamp.
    in property <float> glow: -1;
    callback toggled();

    spacing: 4px;
    height: StripMetrics.switch;

    SectionLabel {
        vertical-alignment: center;
        text: root.label;
        color: root.on ? Theme.accent : Theme.text-faint;
    }
    if root.glow >= 0 : StripLight {
        y: (parent.height - self.height) / 2;
        glow: root.glow;
        tooltip: "Gain reduction";
    }
    Rectangle { horizontal-stretch: 1; }
    StripInSwitch {
        on: root.on;
        hint: root.hint;
        clicked => { root.toggled(); }
    }
}

// The voicing, which governs all three sections and so belongs beside the
// input stage rather than inside one of them.
export component StripVoicingPicker inherits Rectangle {
    in-out property <int> voicing;
    in property <bool> wide;
    callback picked(int);

    private property <string> hint-text: "The strip's voicing: what its input stage "
        + "distorts, which frequencies its EQ bands offer, how its EQ tracks gain, "
        + "and how its compressor bends above the knee.";

    if !root.wide : PickerChip {
        width: 100%;
        options: StripSpec.voicings;
        selected-index: root.voicing;
        tooltip: root.hint-text;
        text-color: Theme.accent;
        picked(index) => { root.picked(index); }
    }
    // Four segments across whatever room there is, rather than a fixed
    // segment width: the bank sizes itself to its own labels by default,
    // which at 150px overflowed the panel it was in and drew `IRON` on top
    // of the EQ beside it.
    if root.wide : SelectorBank {
        width: 100%;
        options: StripSpec.voicings;
        selected-index: root.voicing;
        segment-width: (root.width - 4px) / 4;
        tooltip: root.hint-text;
        selected(index) => { root.picked(index); }
    }
}

// DRIVE: the input stage, and the voicing selector beside it.
//
// One row, which is what Adam's redraw asks for -- *"preamp at top, knob
// beside selector"* -- rather than the selector on a row of its own.
export component StripDrivePage inherits Rectangle {
    in property <StripRow> strip;
    in property <bool> wide;
    /// Which track this is drawing, for the lamps `StripMeters` publishes.
    in property <int> track: -1;
    callback moved(int, float);
    callback switched(int, bool);
    callback voicing-picked(int);

    VerticalLayout {
        spacing: 3px;
        StripSectionHead {
            label: "DRIVE";
            on: root.strip.pre-in;
            hint: "Run this track's input stage. Out is out: the samples are not touched.";
            toggled => { root.switched(StripSpec.pre-in, !root.strip.pre-in); }
        }
        HorizontalLayout {
            spacing: 4px;
            height: root.wide ? StripMetrics.knob-major-wide : StripMetrics.knob-major;
            // Centred on the rack column, where the knob is alone in the
            // row; **stretch** on the mixer strip, where the voicing chip
            // is beside it and has to be squeezed into the 52px left over.
            // `start` there asked for the chip's preferred width and clipped
            // it to nothing -- the trap `reference-slint-layout-gotchas`
            // records as "alignment: start makes a layout's minimum the sum
            // of its children's preferred sizes".
            alignment: root.wide ? LayoutAlignment.center : LayoutAlignment.stretch;
            StripKnob {
                param: StripSpec.drive-db;
                natural: root.strip.drive-db;
                bipolar-value: true;
                size: root.wide ? StripMetrics.knob-major-wide : StripMetrics.knob-major;
                enabled: root.strip.pre-in;
                hint: "Gain into the voicing's curve. The profiles are stated at the "
                    + "-12 dBFS operating level, so 0 dB is where a voicing measures true. "
                    + "Turning it down re-balances the colour as well as reducing it.";
                changed(v) => { root.moved(StripSpec.drive-db, v); }
            }
            // Beside the knob on the mixer strip, where it is a chip naming
            // one voicing; **under** it on the rack column, where it is the
            // four-way bank and wants the column's whole width. Sharing a
            // row there left it 100px for four names and clipped `PUNCH`.
            if !root.wide : StripVoicingPicker {
                horizontal-stretch: 1;
                y: (parent.height - self.height) / 2;
                height: 18px;
                voicing: root.strip.voicing;
                picked(index) => { root.voicing-picked(index); }
            }
        }
        if root.wide : StripVoicingPicker {
            height: 22px;
            voicing: root.strip.voicing;
            wide: true;
            picked(index) => { root.voicing-picked(index); }
        }
    }
}

// EQ: four bands, read **left to right and top to bottom** -- high shelf,
// high mid, low mid, low shelf.
//
// That reading order is this layout's whole rule, and it is stated here
// because the next person to look at four stacked rows will assume the order
// means something else. Adam, 2026-09-09: *"this has been annoying ppl since
// EQs were invented. there's no good way to lay it out. i chose ltr ttb."*
//
// A row is `gain, frequency, Q` with the gain drawn largest, which is the
// order and the hierarchy of the redrawn face: gain is what you reach for,
// and the frequency knob picks one of the band's positions rather than a
// value.
//
// The icon at the left of a row is the curve that band *is*, and on the two
// outer bands it is also the switch between a bell and that band's shelf.
export component StripEqPage inherits Rectangle {
    in property <StripRow> strip;
    in property <bool> wide;
    /// Which track this is drawing, for the lamps `StripMeters` publishes.
    in property <int> track: -1;
    callback moved(int, float);
    callback switched(int, bool);
    /// A point dragged on the plot, as a band and the hertz and decibels it
    /// was dragged to.
    ///
    /// Hertz rather than a position, because snapping to the nearest one is
    /// `StripEqTable::nearest`'s job and teaching the markup to do it would
    /// be that arithmetic written twice -- in log distance, which is the
    /// part that would drift.
    callback point-dragged(int, float, float);

    private property <length> major: root.wide
        ? StripMetrics.knob-major-wide : StripMetrics.knob-major;
    private property <length> minor: root.wide
        ? StripMetrics.knob-minor-wide : StripMetrics.knob-minor;

    VerticalLayout {
        spacing: 2px;
        StripSectionHead {
            label: "EQ";
            on: root.strip.eq-in;
            hint: "Run this track's EQ. A band at 0 dB is not run at all, and a "
                + "section that is out does not touch the samples.";
            toggled => { root.switched(StripSpec.eq-in, !root.strip.eq-in); }
        }
        // **No plot in here, on either face.** On the 92px mixer strip
        // there was never room -- Adam: *"no scopes on the mixer. that's
        // partly the point."* On the rack row it was 72px above four band
        // rows that needed 200 in a 224px face, so the fourth band was
        // drawn *below* the panel: *"the EQ section in the rack version
        // doesnt really fit. we dont really need the graah on the eq. only
        // other thing we could do is move it."* Moved: `StripSections`
        // gives it the room going spare under DRIVE, where it is taller and
        // reads better than it did as a letterbox.
        //
        // Which column is which, once at the top rather than under every
        // knob: the mockup's own `G F Q`.
        HorizontalLayout {
            spacing: 1px;
            height: StripMetrics.caption;
            // Left at 84px, where every pixel is spoken for; centred under
            // the plot on a face with room to spare.
            alignment: root.wide ? LayoutAlignment.center : LayoutAlignment.start;
            Rectangle { width: StripMetrics.row-label; }
            Text {
                width: root.major;
                text: "G";
                color: Theme.text-faint;
                font-size: Theme.text-sm;
                horizontal-alignment: center;
            }
            Text {
                width: root.minor;
                text: "F";
                color: Theme.text-faint;
                font-size: Theme.text-sm;
                horizontal-alignment: center;
            }
            Text {
                width: root.minor;
                text: "Q";
                color: Theme.text-faint;
                font-size: Theme.text-sm;
                horizontal-alignment: center;
            }
        }
        for band[index] in root.strip.band-gain-db : HorizontalLayout {
            spacing: 1px;
            height: root.major + 2px;
            alignment: root.wide ? LayoutAlignment.center : LayoutAlignment.start;
            // The band's own shape, and on the outer two the switch that
            // changes it. A mid band is a bell always, so its icon is a
            // label rather than a control and says nothing about being
            // clickable.
            shape := Rectangle {
                width: StripMetrics.row-label;
                // The outer two bands have a choice; the mids are bells
                // always, so their icon is a label rather than a control.
                property <bool> switchable: index == 0
                    || index == root.strip.band-gain-db.length - 1;
                Path {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: StripMetrics.row-label;
                    height: StripMetrics.row-label;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: !root.strip.band-shelf[index]
                        ? StripIcons.bell
                        : index == 0 ? StripIcons.high-shelf : StripIcons.low-shelf;
                    stroke: root.strip.eq-in ? Theme.accent : Theme.text-faint;
                    stroke-width: 1.2px;
                    fill: transparent;
                }
                if shape.switchable : TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.switched(StripSpec.band(index, StripSpec.band-kind),
                            !root.strip.band-shelf[index]);
                    }
                    changed has-hover => {
                        if (self.has-hover) {
                            StatusHint.show("Switch this band between a bell and the shelf "
                                + "it is nearest: the top band to a high shelf, the bottom "
                                + "one to a low shelf.");
                        } else { StatusHint.clear(""); }
                    }
                }
                Tooltip {
                    text: @markdown("\{StripSpec.band-names[index]}");
                }
            }
            StripKnob {
                param: StripSpec.band(index, StripSpec.band-gain);
                natural: band;
                bipolar-value: true;
                size: root.major;
                enabled: root.strip.eq-in;
                hint: StripSpec.band-names[index] + ": boost or cut. At exactly zero the "
                    + "band is not run at all.";
                changed(v) => { root.moved(self.param, v); }
            }
            StripKnob {
                param: StripSpec.band(index, StripSpec.band-frequency);
                // The position, stepped: the knob has as many stops as the
                // band has, and what each one is worth in hertz is the
                // voicing's to decide.
                natural: root.strip.band-position[index];
                readout: NoteFormat.frequency-value(root.strip.band-frequency-hz[index]);
                size: root.minor;
                enabled: root.strip.eq-in;
                hint: StripSpec.band-names[index] + ": which of this band's frequencies is "
                    + "selected. The voicing decides what each position is worth, so the "
                    + "same stop moves when it changes.";
                changed(v) => { root.moved(self.param, v); }
            }
            StripKnob {
                param: StripSpec.band(index, StripSpec.band-q);
                natural: root.strip.band-q[index];
                size: root.minor;
                enabled: root.strip.eq-in;
                hint: StripSpec.band-names[index] + ": Q as a bell, slope as a shelf -- how "
                    + "abruptly the band gives way.";
                changed(v) => { root.moved(self.param, v); }
            }
        }
    }
}

// COMP: the strip's own compressor. Adam: *"this is a totally different comp
// than the one built in as a device. w/d is just a wet/dry balance control
// for parallel per strip."*
//
// Threshold and ratio are drawn large and the timing small, which is the
// hierarchy of the redrawn face. The lamp beside the header reads gain
// reduction -- which is what a scope would have told you and costs 9px
// instead of 80.
export component StripCompPage inherits Rectangle {
    in property <StripRow> strip;
    in property <bool> wide;
    /// Which track this is drawing, for the lamps `StripMeters` publishes.
    in property <int> track: -1;
    callback moved(int, float);
    callback switched(int, bool);

    private property <length> major: root.wide
        ? StripMetrics.knob-major-wide : StripMetrics.knob-major;
    private property <length> minor: root.wide
        ? StripMetrics.knob-minor-wide : StripMetrics.knob-minor;

    VerticalLayout {
        spacing: 2px;
        StripSectionHead {
            label: "COMP";
            on: root.strip.comp-in;
            // Full at 12 dB, which is where the strip's own rail tops out:
            // the lamp is there to show the first few decibels arriving, and
            // a scale set by the extreme leaves ordinary reduction barely
            // visible.
            glow: root.strip.comp-in
                ? clamp(StripMeters.reduction(root.track) / 12, 0, 1)
                : 0;
            hint: "Run this track's compressor. Out is out: the samples are not touched.";
            toggled => { root.switched(StripSpec.comp-in, !root.strip.comp-in); }
        }
        // No scope here either, for the same reason -- the lamp above is the
        // feedback, and the curve is on the rack row.
        if root.wide : DynamicsCurveDisplay {
            // 72, not 80: the section is head + curve + three knob rows in
            // 224px, and at 80 the last row was eight pixels over.
            height: 72px;
            mode: 1;
            threshold-db: root.strip.threshold-db;
            ratio: root.strip.ratio;
            knee-db: root.strip.knee-db;
            extra-db: root.strip.makeup-db;
            curve-db: root.strip.curve-db;
            gain-reduction-db: -StripMeters.reduction(root.track);
            opacity: root.strip.comp-in ? 1.0 : 0.45;
            threshold-dragged(db) => { root.moved(StripSpec.threshold-db, db); }
        }
        HorizontalLayout {
            spacing: 2px;
            alignment: center;
            StripKnobCell {
                param: StripSpec.threshold-db;
                natural: root.strip.threshold-db;
                size: root.major;
                caption: "T";
                enabled: root.strip.comp-in;
                hint: "Threshold: the level above which the compressor starts working.";
                changed(v) => { root.moved(self.param, v); }
            }
            StripKnobCell {
                param: StripSpec.ratio;
                natural: root.strip.ratio;
                size: root.major;
                caption: "R";
                enabled: root.strip.comp-in;
                hint: "Ratio at the knee. Above it the voicing decides how the line bends.";
                changed(v) => { root.moved(self.param, v); }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            alignment: center;
            StripKnobCell {
                param: StripSpec.attack-ms;
                natural: root.strip.attack-ms;
                size: root.minor;
                caption: "A";
                enabled: root.strip.comp-in;
                hint: "Attack: how fast the detector rises.";
                changed(v) => { root.moved(self.param, v); }
            }
            StripKnobCell {
                param: StripSpec.release-ms;
                natural: root.strip.release-ms;
                size: root.minor;
                caption: "R";
                enabled: root.strip.comp-in;
                hint: "Release: how fast it lets go. The voicing's programme dependence is "
                    + "measured against this, so a long passage releases slower than a "
                    + "short one.";
                changed(v) => { root.moved(self.param, v); }
            }
            StripKnobCell {
                param: StripSpec.knee-db;
                natural: root.strip.knee-db;
                size: root.minor;
                caption: "K";
                enabled: root.strip.comp-in;
                hint: "Knee: the width of the soft corner around the threshold. Zero is a "
                    + "hard corner.";
                changed(v) => { root.moved(self.param, v); }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            alignment: center;
            StripKnobCell {
                param: StripSpec.mix;
                natural: root.strip.mix;
                size: root.minor;
                caption: "W";
                enabled: root.strip.comp-in;
                hint: "Wet/dry: a parallel balance. At zero this is the signal as it "
                    + "arrived, exactly.";
                changed(v) => { root.moved(self.param, v); }
            }
            StripKnobCell {
                param: StripSpec.makeup-db;
                natural: root.strip.makeup-db;
                size: root.minor;
                caption: "M";
                enabled: root.strip.comp-in;
                hint: "Makeup: level put back after the compressor, which does not move "
                    + "the detector.";
                changed(v) => { root.moved(self.param, v); }
            }
        }
    }
}

// All three sections stacked, which is the strip's own page: no tabs, and
// every section's `in` switch visible at once.
//
// Adam's redraw took the tab row out with the scopes -- four tabs across
// 84px could not carry `COMP` or `SENDS`, and what they were paging between
// fits once the plots are gone. `wide` is what the rack row passes: the same
// components, the plots back, and the sections side by side instead of
// stacked.
export component StripSections inherits Rectangle {
    in property <StripRow> strip;
    in property <bool> wide;
    /// Which track this is drawing, for the lamps `StripMeters` publishes.
    in property <int> track: -1;
    callback moved(int, float);
    callback switched(int, bool);
    callback voicing-picked(int);
    callback point-dragged(int, float, float);

    if !root.wide : VerticalLayout {
        spacing: 8px;
        StripDrivePage {
            // Each section is as tall as its own controls, and the spacer
            // below takes what is left: without this the three of them
            // shared the strip's height equally and the compressor's rows
            // drifted apart down a column of empty space.
            vertical-stretch: 0;
            strip: root.strip;
            moved(id, value) => { root.moved(id, value); }
            switched(id, on) => { root.switched(id, on); }
            voicing-picked(index) => { root.voicing-picked(index); }
        }
        StripEqPage {
            vertical-stretch: 0;
            strip: root.strip;
            moved(id, value) => { root.moved(id, value); }
            switched(id, on) => { root.switched(id, on); }
            point-dragged(band, hz, gain) => { root.point-dragged(band, hz, gain); }
        }
        StripCompPage {
            vertical-stretch: 0;
            strip: root.strip;
            track: root.track;
            moved(id, value) => { root.moved(id, value); }
            switched(id, on) => { root.switched(id, on); }
        }
        Rectangle { vertical-stretch: 1; }
    }

    if root.wide : HorizontalLayout {
        spacing: 6px;
        // **Widths from the contents, not two stretches.** `EQ` and `COMP`
        // both used to take `horizontal-stretch: 1`, which splits the
        // *slack* and so handed them 232px and 212px for clusters 96px and
        // 76px wide. Two unequal boxes with a small huddle of knobs in the
        // middle of each is what Adam read as the compressor being pinned
        // over -- *"the area itself seems pinned to the left of the channel
        // strip, so the buttons are off center."* Measured, the knobs were
        // dead centre; the box was simply twice the width of what was in
        // it, which is the same fault as the face being a unit too wide.
        VerticalLayout {
            width: 150px;
            spacing: 6px;
            Rectangle {
                vertical-stretch: 0;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px;
                    StripDrivePage {
                        strip: root.strip;
                        wide: true;
                        moved(id, value) => { root.moved(id, value); }
                        switched(id, on) => { root.switched(id, on); }
                        voicing-picked(index) => { root.voicing-picked(index); }
                    }
                }
            }
            // The EQ's own response, in the room the input stage does not
            // want. It is the only drawing of what a voicing does to the Q
            // law, and the only place a band can be dragged rather than
            // dialled, so "we dont really need the graah" is answered by
            // moving it rather than by deleting it -- and 138x100 reads
            // better than the 232x72 letterbox it was.
            Rectangle {
                vertical-stretch: 1;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    SectionLabel {
                        // "CURVE", not "RESPONSE": the label is letter-spaced
                        // and the column is 138px, where the longer word
                        // wrapped to "RESPO NSE".
                        text: "CURVE";
                        // No in-and-out switch, because there is nothing
                        // here to switch: that absence is what says this
                        // row is a display and not a fourth section.
                        color: Theme.text-faint;
                    }
                    EqResponseDisplay {
                        vertical-stretch: 1;
                        band-data: root.strip.band-data;
                        curve-db: root.strip.eq-curve-db;
                        selected-target: -1;
                        spectrum-visible: false;
                        opacity: root.strip.eq-in ? 1.0 : 0.45;
                        point-dragged(band, frequency, gain) => {
                            root.point-dragged(band,
                                20 * pow(1000, clamp(frequency, 0, 1)), gain * 36 - 18);
                        }
                    }
                }
            }
        }
        Rectangle {
            // Row label, gain, frequency, Q and their gutters. The band rows
            // are the widest thing in here and nothing else in the section
            // wants more, so the number is that sum rather than a share.
            width: StripMetrics.row-label + StripMetrics.knob-major-wide
                + 2 * StripMetrics.knob-minor-wide + 3px + 12px;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            VerticalLayout {
                padding: 6px;
                StripEqPage {
                    strip: root.strip;
                    wide: true;
                    moved(id, value) => { root.moved(id, value); }
                    switched(id, on) => { root.switched(id, on); }
                    point-dragged(band, hz, gain) => { root.point-dragged(band, hz, gain); }
                }
            }
        }
        Rectangle {
            // The compressor takes what is left, which its curve wants and
            // its three knob rows do not: the widest of them is A/R/K at
            // 76px, so anything past that is the plot's.
            horizontal-stretch: 1;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            VerticalLayout {
                padding: 6px;
                StripCompPage {
                    strip: root.strip;
                    track: root.track;
                    wide: true;
                    moved(id, value) => { root.moved(id, value); }
                    switched(id, on) => { root.switched(id, on); }
                }
            }
        }
    }
}
