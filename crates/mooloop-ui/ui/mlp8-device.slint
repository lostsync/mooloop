import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { KnobField, ParameterKnob, SectionLabel, SelectorBank, SyncMiniKnob, ToolButton, ValueScale } from "controls.slint";
import { DevicePageButton } from "device-rack.slint";
import { EnvelopeEditor } from "envelope.slint";
import { FilterResponseDisplay, OscillatorTrace } from "device-displays.slint";

import { GainMath } from "gain.slint";

// One authored internal route, as the face needs it.
//
// The id is the route's durable identity, not its position: every edit names
// it, so a row that moves because a neighbour was removed still edits the
// route it was drawn for.
export struct MlP8RouteRow {
    id: int,
    source: int,
    dest: int,
    // Signed percent of the destination's full range, `[-100, 100]`.
    amount: float,
    // What the destination is called, resolved from its descriptor by Rust so
    // the face does not carry a second copy of the parameter table.
    dest-name: string,
    // Whether the source swings both ways about zero. A property of the
    // source rather than a control on the route: a unipolar source rests at
    // zero and the amount's sign chooses which way it goes from there.
    bipolar: bool,
}

// A chip that opens a list and reports the index picked.
//
// The route list needs two of these against models of six and thirty-one
// entries, which is past what a cycling chip or a segmented bank can carry.
component PickerChip inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index;
    in property <string> tooltip;
    in property <color> text-color: Theme.text;
    callback picked(int);

    height: 18px;
    background: touch.has-hover ? Theme.surface-active : Theme.surface;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;

    Text {
        x: 5px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.options[root.selected-index];
        color: root.text-color;
        font-size: 9px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 12px;
        width: 10px;
        height: parent.height;
        text: "\u{25be}";
        color: Theme.text-faint;
        font-size: 8px;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: max(root.width, 132px);
        height: min(220px, list.preferred-height + 8px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            ScrollView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                list := VerticalLayout {
                    spacing: 1px;
                    for option[index] in root.options : Rectangle {
                        height: 18px;
                        border-radius: Theme.radius-sm;
                        background: index == root.selected-index
                            ? Theme.surface-active
                            : row-touch.has-hover ? Theme.surface-active : transparent;
                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: option;
                            color: index == root.selected-index ? Theme.accent : Theme.text;
                            font-size: 9px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                menu.close();
                                root.picked(index);
                            }
                        }
                    }
                }
            }
        }
    }
}

// One row of the route list: what it reads, what it moves, how much, and a
// way to take it back out.
//
// Polarity is shown rather than chosen. It is a property of the *source* --
// the LFO and Key swing both ways, an envelope and velocity rest at zero --
// and the amount's sign already decides which direction a unipolar source
// travels. A per-route polarity switch would be a second answer to a question
// the source list has already settled.
component RouteRow inherits Rectangle {
    in property <MlP8RouteRow> route;
    in property <[string]> source-names;
    in property <[string]> dest-names;
    callback source-picked(int);
    callback dest-picked(int);
    callback amount-changed(float);
    callback removed();

    height: 20px;

    HorizontalLayout {
        spacing: 4px;
        y: 1px;
        height: 18px;
        PickerChip {
            width: 72px;
            options: root.source-names;
            selected-index: root.route.source;
            tooltip: "What this route reads";
            text-color: Theme.accent;
            picked(index) => { root.source-picked(index); }
        }
        Text {
            width: 10px;
            height: parent.height;
            text: "\u{2192}";
            color: Theme.text-faint;
            font-size: 9px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        PickerChip {
            horizontal-stretch: 1;
            options: root.dest-names;
            selected-index: root.route.dest;
            tooltip: "What this route moves";
            picked(index) => { root.dest-picked(index); }
        }
        Text {
            width: 24px;
            height: parent.height;
            text: root.route.bipolar ? "BI" : "UNI";
            color: Theme.text-faint;
            font-size: 7px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        KnobField {
            diameter: 18px;
            label-width: 0px;
            field-width: 48px;
            label: "";
            tooltip: "Depth, as a share of the destination's range";
            value: root.route.amount;
            minimum: -100; maximum: 100; default-value: 0; bipolar: true;
            display-text: (root.route.amount > 0 ? "+" : "") + round(root.route.amount) + "%";
            changed(v) => { root.amount-changed(v); }
        }
        ToolButton {
            text: "\u{00d7}";
            tooltip: "Remove this route";
            min-width: 18px;
            max-width: 18px;
            clicked => { root.removed(); }
        }
    }
}

// One directed relationship in the oscillator network: drag to set, signed
// percent, zero at the middle.
//
// The interaction is a `ParameterKnob` with its dial turned off rather than a
// second draggable control, because arming a modulation source changes what
// every gesture *means* -- a drag edits route depth, a double-click clears it
// -- and a hand-rolled cell would be a second place that has to agree about
// that. What it draws instead of a dial is a bar growing from the centre, so
// the sign of a route is a direction on screen rather than a minus sign to
// read.
component NetworkCell inherits Rectangle {
    in property <string> tooltip;
    // The diagonal: an oscillator modulating itself. The same operation on
    // the same one-sample state as a pair route, which is why it lives in the
    // grid rather than in a Feedback panel somewhere else.
    in property <bool> self-route;
    // A mix level: this source into the output. Unipolar and in dB, so it
    // fills from the floor rather than from the middle -- a level has no
    // sign to show, and drawing it like one would be a lie about what the
    // control does.
    in property <bool> level;
    // A relationship this device does not have. The sub is derived from an
    // oscillator and cannot modulate one, so its route cells are drawn as
    // absent rather than as zero: nothing to turn up.
    in property <bool> inert;
    in property <int> param-id;
    in-out property <float> value;
    in property <bool> modulation-armed;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback changed(float);
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);

    // A level's travel is its dB range; a route's is its signed percent.
    private property <float> db: GainMath.linear-to-db(root.value);
    private property <float> magnitude: root.level
        ? clamp((root.db + 60) / 60, 0, 1)
        : abs(root.value) / 100;
    private property <bool> live: root.level ? root.db > -59.5 : abs(root.value) > 0.5;

    min-height: 22px;
    border-radius: Theme.radius-sm;
    background: root.inert ? Theme.surface : Theme.panel;
    border-width: 1px;
    border-color: root.inert ? Theme.border.with-alpha(0.35)
        : knob.hovered ? Theme.accent.with-alpha(0.55)
        : root.self-route ? Theme.accent.with-alpha(0.3) : Theme.border;

    // The datum a fill grows from: the middle for a signed route, the floor
    // for a level. Drawn even at zero so an idle cell still reads as a
    // control rather than as a gap in the grid.
    if !root.inert : Rectangle {
        y: root.level ? parent.height - 1px : parent.height / 2;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
    if !root.inert : Rectangle {
        x: 1px;
        width: parent.width - 2px;
        y: root.level
            ? parent.height - 1px - (parent.height - 2px) * root.magnitude
            : root.value >= 0
                ? parent.height / 2 - (parent.height / 2 - 1px) * root.magnitude
                : parent.height / 2;
        height: root.level
            ? (parent.height - 2px) * root.magnitude
            : (parent.height / 2 - 1px) * root.magnitude;
        background: Theme.accent.with-alpha(root.level ? 0.34 : root.value >= 0 ? 0.42 : 0.24);
    }
    Text {
        width: 100%;
        height: 100%;
        text: root.inert ? "-"
            : root.level ? (root.live ? round(root.db) + "" : "-inf")
            : root.live ? (root.value > 0 ? "+" : "") + round(root.value)
            : "";
        color: root.inert || !root.live ? Theme.text-faint : Theme.text;
        font-family: "monospace";
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    knob := ParameterKnob {
        width: 100%;
        height: 100%;
        visible: !root.inert;
        show-label: false;
        show-value-text: false;
        show-dial: false;
        label: root.tooltip;
        tooltip: root.tooltip;
        // A level drags in dB and stores linear, like every other mix control
        // on this face; `mlp8::is_gain_param` is the other half of it.
        value: root.level ? root.db : root.value;
        minimum: root.level ? -60 : -100;
        maximum: root.level ? 0 : 100;
        default-value: root.level ? -60 : 0;
        bipolar: !root.level;
        value-text: root.level
            ? GainMath.format-db(root.db)
            : (root.value > 0 ? "+" : "") + round(root.value) + "%";
        modulation-armed: root.modulation-armed;
        modulation-allowed: root.allowed[root.param-id];
        modulation-depth: root.depths[root.param-id];
        modulation-offset: root.offsets[root.param-id];
        modulation-route-count: root.route-counts[root.param-id];
        changed(v) => {
            root.value = root.level ? GainMath.db-to-linear(v) : v;
            root.changed(root.value);
        }
        modulation-depth-changed(v) => { root.route-depth-changed(root.param-id, v); }
        modulation-edit-started => { root.route-edit-started(root.param-id); }
        modulation-edit-finished => { root.route-edit-finished(root.param-id); }
    }
}

// Which oscillator hard-syncs this column's oscillator. Click cycles; the
// column's own oscillator is missing from its cycle, because an oscillator
// syncing itself is a stuck phase rather than a topology.
component SyncChip inherits Rectangle {
    in property <int> destination;
    in-out property <int> source;
    callback changed(int);

    pure function skip-self(candidate: int) -> int {
        return candidate == root.destination + 1 ? candidate + 1 : candidate;
    }

    min-height: 18px;
    border-radius: Theme.radius-sm;
    background: root.source == 0 ? Theme.panel : Theme.accent.with-alpha(0.22);
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent.with-alpha(0.5)
        : root.source == 0 ? Theme.border : Theme.accent.with-alpha(0.45);
    accessible-role: button;
    accessible-label: "Hard sync source";

    Text {
        width: 100%;
        height: 100%;
        text: root.source == 0 ? "--" : "OSC " + root.source;
        color: root.source == 0 ? Theme.text-faint : Theme.text;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            let stepped = root.skip-self(root.source + 1);
            root.source = stepped > 3 ? 0 : stepped;
            root.changed(root.source);
        }
    }
}

// One tab in the oscillator selector.
component OscTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> audible;
    callback clicked();

    width: 22px;
    height: 18px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.accent.with-alpha(0.25) : Theme.panel;
    border-width: 1px;
    border-color: root.active ? Theme.accent.with-alpha(0.6)
        : touch.has-hover ? Theme.border : Theme.border.with-alpha(0.6);
    accessible-role: button;
    accessible-label: "Oscillator " + root.text;

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        // A muted oscillator is still wired in, so the tab distinguishes
        // audible from silent rather than active from inactive.
        color: root.active ? Theme.text : root.audible ? Theme.text-muted : Theme.text-faint;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// One oscillator's own controls. Written once and shown for whichever tab is
// selected, because the network beside it is what has to stay visible: in this
// instrument the relationships are the subject and the tunings are detail.
component OscEditor inherits Rectangle {
    in property <int> index;
    in-out property <int> wave;
    in-out property <float> semitones;
    in-out property <float> cents;
    in-out property <float> level;
    in-out property <float> pulse-width;
    in property <bool> modulation-armed;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback wave-changed(int);
    callback semitones-changed(float);
    callback cents-changed(float);
    callback level-changed(float);
    callback pulse-width-changed(float);
    callback text-committed(int, string);
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);

    // ML-P8's oscillator blocks are five ids wide from zero, not the shared
    // synths' `100 + n * 10`.
    private property <int> base: root.index * 5;

    VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: 40px;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            OscillatorTrace {
                x: 4px;
                y: 3px;
                width: parent.width - 8px;
                height: parent.height - 6px;
                wave: root.wave;
                semitones: root.semitones;
                cents: root.cents;
                level: root.level;
                pulse-width: root.pulse-width;
            }
        }
        SelectorBank {
            options: ["SIN", "TRI", "SAW", "PLS"];
            selected-index <=> root.wave;
            segment-width: 34px;
            tooltip: "Oscillator waveform";
            selected(i) => { root.wave-changed(i); }
        }
        KnobField {
            diameter: 24px;
            label-width: 30px;
            field-width: 52px;
            label: "SEMI";
            tooltip: "Coarse tuning";
            value <=> root.semitones; minimum: -48; maximum: 48; default-value: 0; step: 1;
            display-text: (root.semitones > 0 ? "+" : "") + round(root.semitones) + " st";
            modulation-armed: root.modulation-armed;
            modulation-allowed: root.allowed[root.base + 1];
            modulation-depth: root.depths[root.base + 1];
            modulation-offset: root.offsets[root.base + 1];
            modulation-route-count: root.route-counts[root.base + 1];
            changed(v) => { root.semitones-changed(v); }
            text-committed(t) => { root.text-committed(root.base + 1, t); }
            modulation-depth-changed(v) => { root.route-depth-changed(root.base + 1, v); }
            modulation-edit-started => { root.route-edit-started(root.base + 1); }
            modulation-edit-finished => { root.route-edit-finished(root.base + 1); }
        }
        KnobField {
            diameter: 24px;
            label-width: 30px;
            field-width: 52px;
            label: "FINE";
            tooltip: "Fine tuning";
            value <=> root.cents; minimum: -100; maximum: 100; default-value: 0; step: 1;
            display-text: (root.cents > 0 ? "+" : "") + round(root.cents) + " ct";
            modulation-armed: root.modulation-armed;
            modulation-allowed: root.allowed[root.base + 2];
            modulation-depth: root.depths[root.base + 2];
            modulation-offset: root.offsets[root.base + 2];
            modulation-route-count: root.route-counts[root.base + 2];
            changed(v) => { root.cents-changed(v); }
            text-committed(t) => { root.text-committed(root.base + 2, t); }
            modulation-depth-changed(v) => { root.route-depth-changed(root.base + 2, v); }
            modulation-edit-started => { root.route-edit-started(root.base + 2); }
            modulation-edit-finished => { root.route-edit-finished(root.base + 2); }
        }
        KnobField {
            diameter: 24px;
            label-width: 30px;
            field-width: 52px;
            label: "WIDTH";
            tooltip: "Pulse width";
            value <=> root.pulse-width; minimum: 0.05; maximum: 0.95; default-value: 0.5;
            display-text: round(root.pulse-width * 100) + "%";
            modulation-armed: root.modulation-armed;
            modulation-allowed: root.allowed[root.base + 4];
            modulation-depth: root.depths[root.base + 4];
            modulation-offset: root.offsets[root.base + 4];
            modulation-route-count: root.route-counts[root.base + 4];
            changed(v) => { root.pulse-width-changed(v); }
            text-committed(t) => { root.text-committed(root.base + 4, t); }
            modulation-depth-changed(v) => { root.route-depth-changed(root.base + 4, v); }
            modulation-edit-started => { root.route-edit-started(root.base + 4); }
            modulation-edit-finished => { root.route-edit-finished(root.base + 4); }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

// The ML-P8's face. One screen, not a stack of pages.
//
// The centre is a grid of every relationship in the voice: rows are sources,
// columns are the oscillators they reach, the diagonal is an oscillator on
// itself, and hard sync is the row underneath because it is the same kind of
// fact -- one oscillator acting on another. Twelve amounts in a knob row said
// nothing about which of them were wired to what; as a grid the topology is
// the picture, and reading it costs a glance instead of twelve labels.
//
// The filter and its envelope are step 03 of the plan, ML-P8's own LFO and
// internal routes step 04, and allocation and the finishers step 05; each
// gets a column here rather than a page behind a button.
export component MlP8DeviceFace inherits Rectangle {
    // Which oscillator the left column is editing. Face state, not a device
    // parameter: nothing about it is saved, automatable, or sent to the engine.
    in-out property <int> source-selected;
    in-out property <int> osc1-wave; in-out property <float> osc1-semitones; in-out property <float> osc1-cents; in-out property <float> osc1-level; in-out property <float> osc1-pulse-width;
    in-out property <int> osc2-wave; in-out property <float> osc2-semitones; in-out property <float> osc2-cents; in-out property <float> osc2-level; in-out property <float> osc2-pulse-width;
    in-out property <int> osc3-wave; in-out property <float> osc3-semitones; in-out property <float> osc3-cents; in-out property <float> osc3-level; in-out property <float> osc3-pulse-width;
    in-out property <float> attack; in-out property <float> decay; in-out property <float> sustain; in-out property <float> release; in-out property <float> glide;
    in-out property <float> sub-level; in-out property <int> sub-octave; in-out property <int> sub-wave; in-out property <int> sub-source;
    in-out property <float> noise-level; in-out property <float> noise-color;
    in-out property <float> xmod12; in-out property <float> xmod13; in-out property <float> xmod21; in-out property <float> xmod23; in-out property <float> xmod31; in-out property <float> xmod32;
    in-out property <float> noise-osc1; in-out property <float> noise-osc2; in-out property <float> noise-osc3;
    in-out property <float> feedback1; in-out property <float> feedback2; in-out property <float> feedback3;
    in-out property <int> sync1; in-out property <int> sync2; in-out property <int> sync3;
    in-out property <int> filter-mode;
    in-out property <float> filter-cutoff; in-out property <float> filter-resonance; in-out property <float> filter-env; in-out property <float> drive;
    in-out property <float> keytrack; in-out property <float> amp-velocity; in-out property <float> filter-velocity; in-out property <float> voice-feedback;
    in-out property <float> filter-attack; in-out property <float> filter-decay; in-out property <float> filter-sustain; in-out property <float> filter-release;
    // Step 05. Unison and Chorus are indices into their own selectors; the
    // other three are unit values read as percentages.
    in-out property <float> drift; in-out property <int> unison; in-out property <float> detune; in-out property <float> spread; in-out property <int> chorus;
    /// `MlP8Unison::note_polyphony()` for each option, in `MlP8Unison::ALL`
    /// order. Supplied by Rust rather than derived here: eight over the group
    /// size is the pool's own arithmetic, and a face that restates it is a
    /// second place for it to be wrong.
    in property <[int]> unison-note-counts;
    // 0 is the instrument -- SOURCE, NETWORK, VOICE on one screen -- and 1 is
    // its own modulation. Two pages rather than one screen because step 04
    // adds a whole second surface, and squeezing it into the first would cost
    // the network grid the room that makes it readable.
    in-out property <int> page;
    in-out property <int> lfo-wave;
    in-out property <bool> lfo-synced;
    in-out property <float> lfo-rate-hz;
    in-out property <int> lfo-division;
    in-out property <float> lfo-phase;
    in-out property <float> lfo-warp;
    in-out property <float> lfo-slew;
    in-out property <int> lfo-retrigger;
    in property <[MlP8RouteRow]> routes;
    /// `MlP8ModSource::ALL` and `MlP8ModDest::ALL`, labelled by Rust so the
    /// face holds no second copy of either list.
    in property <[string]> route-source-names;
    in property <[string]> route-dest-names;
    /// True when the patch has reached the compiler's measured ceiling. The
    /// add affordance stops offering itself rather than failing on click.
    in property <bool> routes-full;
    in property <string> routes-status;
    callback lfo-wave-changed(int);
    callback lfo-sync-changed(bool);
    callback lfo-rate-changed(float);
    callback lfo-division-changed(int);
    callback lfo-phase-changed(float);
    callback lfo-warp-changed(float);
    callback lfo-slew-changed(float);
    callback lfo-retrigger-changed(int);
    /// Every route edit names the route's durable id, never its row.
    callback route-source-changed(int, int);
    callback route-dest-changed(int, int);
    callback route-amount-changed(int, float);
    callback route-removed(int);
    callback route-added();
    in property <bool> modulation-armed;
    // Indexed by descriptor id. ML-P8's ids are its own namespace starting at
    // zero (`mlp8.rs` in mooloop-core), not the shared `SYNTH_PARAM_*` ones
    // the other synth faces index with.
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    callback osc1-wave-changed(int); callback osc1-semitones-changed(float); callback osc1-cents-changed(float); callback osc1-level-changed(float); callback osc1-pulse-width-changed(float);
    callback osc2-wave-changed(int); callback osc2-semitones-changed(float); callback osc2-cents-changed(float); callback osc2-level-changed(float); callback osc2-pulse-width-changed(float);
    callback osc3-wave-changed(int); callback osc3-semitones-changed(float); callback osc3-cents-changed(float); callback osc3-level-changed(float); callback osc3-pulse-width-changed(float);
    callback attack-changed(float); callback decay-changed(float); callback sustain-changed(float); callback release-changed(float); callback glide-changed(float);
    callback sub-level-changed(float); callback sub-octave-changed(int); callback sub-wave-changed(int); callback sub-source-changed(int);
    callback noise-level-changed(float); callback noise-color-changed(float);
    callback xmod12-changed(float); callback xmod13-changed(float); callback xmod21-changed(float); callback xmod23-changed(float); callback xmod31-changed(float); callback xmod32-changed(float);
    callback noise-osc1-changed(float); callback noise-osc2-changed(float); callback noise-osc3-changed(float);
    callback feedback1-changed(float); callback feedback2-changed(float); callback feedback3-changed(float);
    callback sync1-changed(int); callback sync2-changed(int); callback sync3-changed(int);
    callback filter-mode-changed(int);
    callback filter-cutoff-changed(float); callback filter-resonance-changed(float); callback filter-env-changed(float); callback drive-changed(float);
    callback keytrack-changed(float); callback amp-velocity-changed(float); callback filter-velocity-changed(float); callback voice-feedback-changed(float);
    callback filter-attack-changed(float); callback filter-decay-changed(float); callback filter-sustain-changed(float); callback filter-release-changed(float);
    callback drift-changed(float); callback unison-changed(int); callback detune-changed(float); callback spread-changed(float); callback chorus-changed(int);
    callback text-committed(int, string);
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);

    // One surface divided by rules, left to right along the signal path,
    // rather than bordered cards floating on it.
    //
    // SOURCE, NETWORK, VOICE. The left column's five tabs are the network
    // grid's five rows, in the same order and with the same names: pick a
    // source there, see everything it reaches here. That is why the sub's
    // octave and the noise's colour live under a tab rather than in a panel
    // of their own -- they are what those two sources *are*, and the grid
    // already says where they go.
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 3px;
            DevicePageButton { text: "INSTRUMENT"; active: root.page == 0; clicked => { root.page = 0; } }
            // Not plain MOD. The common device frame's MOD opens the
            // *channel* shelf, and a saved instrument route being mistaken
            // for a channel route is exactly the confusion the plan asks
            // this name to prevent.
            DevicePageButton { text: "ML-P8 MOD"; active: root.page == 1; clicked => { root.page = 1; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { height: 1px; background: Theme.border; }

        if root.page == 0 : HorizontalLayout {
            vertical-stretch: 1;
                padding: 1px;
            spacing: 0px;

            // --- The five sources ---------------------------------------------
            VerticalLayout {
                width: 140px;
                spacing: 4px;
                SectionLabel { text: "SOURCE"; }
                HorizontalLayout {
                    spacing: 2px;
                        OscTab {
                            text: "1";
                            width: 20px;
                            active: root.source-selected == 0;
                            audible: root.osc1-level > 0.0001;
                            clicked => { root.source-selected = 0; }
                        }
                        OscTab {
                            text: "2";
                            width: 20px;
                            active: root.source-selected == 1;
                            audible: root.osc2-level > 0.0001;
                            clicked => { root.source-selected = 1; }
                        }
                        OscTab {
                            text: "3";
                            width: 20px;
                            active: root.source-selected == 2;
                            audible: root.osc3-level > 0.0001;
                            clicked => { root.source-selected = 2; }
                        }
                        OscTab {
                            text: "SUB";
                            width: 30px;
                            active: root.source-selected == 3;
                            audible: root.sub-level > 0.0001;
                            clicked => { root.source-selected = 3; }
                        }
                        OscTab {
                            text: "NSE";
                            width: 30px;
                            active: root.source-selected == 4;
                            audible: root.noise-level > 0.0001;
                            clicked => { root.source-selected = 4; }
                        }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.source-selected == 0 : OscEditor {
                    index: 0;
                    wave <=> root.osc1-wave;
                    semitones <=> root.osc1-semitones;
                    cents <=> root.osc1-cents;
                    level <=> root.osc1-level;
                    pulse-width <=> root.osc1-pulse-width;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    wave-changed(v) => { root.osc1-wave-changed(v); }
                    semitones-changed(v) => { root.osc1-semitones-changed(v); }
                    cents-changed(v) => { root.osc1-cents-changed(v); }
                    level-changed(v) => { root.osc1-level-changed(v); }
                    pulse-width-changed(v) => { root.osc1-pulse-width-changed(v); }
                    text-committed(p, t) => { root.text-committed(p, t); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                if root.source-selected == 1 : OscEditor {
                    index: 1;
                    wave <=> root.osc2-wave;
                    semitones <=> root.osc2-semitones;
                    cents <=> root.osc2-cents;
                    level <=> root.osc2-level;
                    pulse-width <=> root.osc2-pulse-width;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    wave-changed(v) => { root.osc2-wave-changed(v); }
                    semitones-changed(v) => { root.osc2-semitones-changed(v); }
                    cents-changed(v) => { root.osc2-cents-changed(v); }
                    level-changed(v) => { root.osc2-level-changed(v); }
                    pulse-width-changed(v) => { root.osc2-pulse-width-changed(v); }
                    text-committed(p, t) => { root.text-committed(p, t); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                if root.source-selected == 2 : OscEditor {
                    index: 2;
                    wave <=> root.osc3-wave;
                    semitones <=> root.osc3-semitones;
                    cents <=> root.osc3-cents;
                    level <=> root.osc3-level;
                    pulse-width <=> root.osc3-pulse-width;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    wave-changed(v) => { root.osc3-wave-changed(v); }
                    semitones-changed(v) => { root.osc3-semitones-changed(v); }
                    cents-changed(v) => { root.osc3-cents-changed(v); }
                    level-changed(v) => { root.osc3-level-changed(v); }
                    pulse-width-changed(v) => { root.osc3-pulse-width-changed(v); }
                    text-committed(p, t) => { root.text-committed(p, t); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                // The sub is derived, so it has no tuning of its own: what it has
                // is which oscillator it divides and by how much.
                if root.source-selected == 3 : VerticalLayout {
                    spacing: 4px;
                    SelectorBank {
                        options: ["-1 OCT", "-2 OCT"];
                        selected-index <=> root.sub-octave;
                        segment-width: 50px;
                        tooltip: "How far below its source the sub sits";
                        selected(i) => { root.sub-octave-changed(i); }
                    }
                    SelectorBank {
                        options: ["SINE", "SQR"];
                        selected-index <=> root.sub-wave;
                        segment-width: 50px;
                        tooltip: "Sub waveform";
                        selected(i) => { root.sub-wave-changed(i); }
                    }
                    SelectorBank {
                        options: ["OSC 1", "OSC 2", "OSC 3"];
                        selected-index <=> root.sub-source;
                        segment-width: 40px;
                        tooltip: "Which oscillator the sub divides";
                        selected(i) => { root.sub-source-changed(i); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                if root.source-selected == 4 : VerticalLayout {
                    spacing: 4px;
                    KnobField {
                        diameter: 24px;
                        label-width: 40px;
                        field-width: 62px;
                        label: "COLOR";
                        tooltip: "Dark through white to bright";
                        value <=> root.noise-color; minimum: -100; maximum: 100; default-value: 0; bipolar: true;
                        display-text: root.noise-color < -1 ? round(-root.noise-color) + "% dark"
                            : root.noise-color > 1 ? round(root.noise-color) + "% bright" : "white";
                        modulation-armed: root.modulation-armed;
                        modulation-allowed: root.modulation-allowed[26];
                        modulation-depth: root.modulation-depths[26];
                        modulation-offset: root.modulation-offsets[26];
                        modulation-route-count: root.modulation-route-counts[26];
                        changed(v) => { root.noise-color-changed(v); }
                        text-committed(t) => { root.text-committed(26, t); }
                        modulation-depth-changed(v) => { root.modulation-depth-changed(26, v); }
                        modulation-edit-started => { root.modulation-edit-started(26); }
                        modulation-edit-finished => { root.modulation-edit-finished(26); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            Rectangle { width: 6px; }
            Rectangle { width: 1px; background: Theme.border; }
            Rectangle { width: 6px; }

            // --- The network ----------------------------------------------------
            //
            // Every route out of every source, including the one to the mixer: a
            // level is "this source into the output", which is the same kind of
            // fact as "this source into that oscillator". The MIX column is
            // unipolar and reads in dB; the route columns are signed.
            //
            // Placed rather than laid out, and every dimension is a constant. A
            // cell's interaction is a full-size `ParameterKnob`, and a knob sizes
            // its insides from its width -- so the moment a layout asks a cell how
            // wide it would like to be, the answer depends on the answer.
            VerticalLayout {
                spacing: 0px;
                SectionLabel { text: "NETWORK"; }
                grid := Rectangle {
                    property <length> label-w: 40px;
                    property <length> cell-w: 46px;
                    property <length> cell-h: 27px;
                    property <length> gap: 3px;
                    property <length> header-h: 14px;
                    property <length> mix-x: self.label-w + 3 * (self.cell-w + self.gap) + 10px;
                    property <length> sync-y: self.header-h + 5 * (self.cell-h + self.gap) + 4px;

                    horizontal-stretch: 0;
                    width: self.mix-x + self.cell-w;
                    height: self.sync-y + 18px;

                    // The rule between "into another oscillator" and "into the
                    // output". Two kinds of destination, one grid.
                    Rectangle {
                        x: grid.mix-x - 6px;
                        y: 0;
                        width: 1px;
                        height: grid.sync-y + 14px;
                        background: Theme.text-faint.with-alpha(0.5);
                    }
                    Text {
                        x: grid.mix-x;
                        y: 0;
                        width: grid.cell-w;
                        height: grid.header-h;
                        text: "MIX";
                        color: Theme.text-faint;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Text {
                        x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                        y: 0;
                        width: grid.cell-w;
                        height: grid.header-h;
                        text: "OSC 1";
                        color: Theme.text-faint;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Text {
                        x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                        y: 0;
                        width: grid.cell-w;
                        height: grid.header-h;
                        text: "OSC 2";
                        color: Theme.text-faint;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Text {
                        x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                        y: 0;
                        width: grid.cell-w;
                        height: grid.header-h;
                        text: "OSC 3";
                        color: Theme.text-faint;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 0;
                        y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                        width: grid.label-w;
                        height: grid.cell-h;
                        text: "OSC 1";
                        color: Theme.text-muted;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                    NetworkCell {
                        x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 1 self-feedback";
                        self-route: true;
                        param-id: 36;
                        value <=> root.feedback1;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.feedback1-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 1 phase-modulates 2";
                        param-id: 27;
                        value <=> root.xmod12;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.xmod12-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 1 phase-modulates 3";
                        param-id: 28;
                        value <=> root.xmod13;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.xmod13-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.mix-x;
                        y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 1 into the mix";
                        level: true;
                        param-id: 3;
                        value <=> root.osc1-level;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.osc1-level-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    Text {
                        x: 0;
                        y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                        width: grid.label-w;
                        height: grid.cell-h;
                        text: "OSC 2";
                        color: Theme.text-muted;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                    NetworkCell {
                        x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 2 phase-modulates 1";
                        param-id: 29;
                        value <=> root.xmod21;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.xmod21-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 2 self-feedback";
                        self-route: true;
                        param-id: 37;
                        value <=> root.feedback2;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.feedback2-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 2 phase-modulates 3";
                        param-id: 30;
                        value <=> root.xmod23;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.xmod23-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.mix-x;
                        y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 2 into the mix";
                        level: true;
                        param-id: 8;
                        value <=> root.osc2-level;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.osc2-level-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    Text {
                        x: 0;
                        y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                        width: grid.label-w;
                        height: grid.cell-h;
                        text: "OSC 3";
                        color: Theme.text-muted;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                    NetworkCell {
                        x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 3 phase-modulates 1";
                        param-id: 31;
                        value <=> root.xmod31;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.xmod31-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 3 phase-modulates 2";
                        param-id: 32;
                        value <=> root.xmod32;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.xmod32-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 3 self-feedback";
                        self-route: true;
                        param-id: 38;
                        value <=> root.feedback3;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.feedback3-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.mix-x;
                        y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Oscillator 3 into the mix";
                        level: true;
                        param-id: 13;
                        value <=> root.osc3-level;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.osc3-level-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    Text {
                        x: 0;
                        y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                        width: grid.label-w;
                        height: grid.cell-h;
                        text: "SUB";
                        color: Theme.text-muted;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                    NetworkCell {
                        x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "The sub is derived from an oscillator and cannot modulate one";
                        inert: true;
                    }
                    NetworkCell {
                        x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "The sub is derived from an oscillator and cannot modulate one";
                        inert: true;
                    }
                    NetworkCell {
                        x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "The sub is derived from an oscillator and cannot modulate one";
                        inert: true;
                    }
                    NetworkCell {
                        x: grid.mix-x;
                        y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Sub into the mix";
                        level: true;
                        param-id: 20;
                        value <=> root.sub-level;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.sub-level-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    Text {
                        x: 0;
                        y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                        width: grid.label-w;
                        height: grid.cell-h;
                        text: "NOISE";
                        color: Theme.text-muted;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                    NetworkCell {
                        x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Noise phase-modulates oscillator 1";
                        param-id: 33;
                        value <=> root.noise-osc1;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.noise-osc1-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Noise phase-modulates oscillator 2";
                        param-id: 34;
                        value <=> root.noise-osc2;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.noise-osc2-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                        y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Noise phase-modulates oscillator 3";
                        param-id: 35;
                        value <=> root.noise-osc3;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.noise-osc3-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    NetworkCell {
                        x: grid.mix-x;
                        y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                        width: grid.cell-w;
                        height: grid.cell-h;
                        tooltip: "Noise into the mix";
                        level: true;
                        param-id: 25;
                        value <=> root.noise-level;
                        modulation-armed: root.modulation-armed;
                        allowed: root.modulation-allowed;
                        depths: root.modulation-depths;
                        offsets: root.modulation-offsets;
                        route-counts: root.modulation-route-counts;
                        changed(v) => { root.noise-level-changed(v); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    Text {
                        x: 0;
                        y: grid.sync-y;
                        width: grid.label-w;
                        height: 18px;
                        text: "SYNC";
                        color: Theme.text-muted;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                    SyncChip {
                        x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                        y: grid.sync-y;
                        width: grid.cell-w;
                        height: 18px;
                        destination: 0;
                        source <=> root.sync1;
                        changed(v) => { root.sync1-changed(v); }
                    }
                    SyncChip {
                        x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                        y: grid.sync-y;
                        width: grid.cell-w;
                        height: 18px;
                        destination: 1;
                        source <=> root.sync2;
                        changed(v) => { root.sync2-changed(v); }
                    }
                    SyncChip {
                        x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                        y: grid.sync-y;
                        width: grid.cell-w;
                        height: 18px;
                        destination: 2;
                        source <=> root.sync3;
                        changed(v) => { root.sync3-changed(v); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }

            Rectangle { width: 6px; }
            Rectangle { width: 1px; background: Theme.border; }
            Rectangle { width: 6px; }

            // --- The voice the network feeds ------------------------------------
            //
            // The filter and the amplifier are one stage of the instrument, not
            // two devices, so they share a region and their two envelopes sit side
            // by side where the difference between them is the point: a pluck is a
            // fast filter decay under a flat amplitude.
            //
            // Voice Feedback lives here rather than beside the oscillators' own
            // feedback. Both are feedback, but this one is a loop around the
            // *filter* and its character comes from the drive inside it, which is
            // the knob directly above it.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 4px;
                    SectionLabel { text: "VOICE"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    SelectorBank {
                        options: ["LP12", "LP24", "BP", "HP"];
                        selected-index <=> root.filter-mode;
                        segment-width: 32px;
                        tooltip: "Filter response";
                        selected(i) => { root.filter-mode-changed(i); }
                    }
                }
                FilterResponseDisplay {
                    height: 38px;
                    // The display's vocabulary is low/band/high plus a slope,
                    // which is two of this device's four modes folded into one
                    // picture: LP24 is the same response one stage steeper.
                    mode: root.filter-mode == 2 ? 1 : root.filter-mode == 3 ? 2 : 0;
                    slope: root.filter-mode == 1 ? 1.0 : 0.0;
                    cutoff: root.filter-cutoff;
                    resonance: root.filter-resonance;
                    env-amount: root.filter-env;
                    point-dragged(x, y) => {
                        root.filter-cutoff = clamp(x, 0, 1);
                        root.filter-cutoff-changed(root.filter-cutoff);
                        root.filter-resonance = clamp(y, 0, 1);
                        root.filter-resonance-changed(root.filter-resonance);
                    }
                    point-scrolled(d) => {
                        root.filter-resonance = clamp(root.filter-resonance + d, 0, 1);
                        root.filter-resonance-changed(root.filter-resonance);
                    }
                }
                HorizontalLayout {
                    spacing: 5px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        SectionLabel { text: "AMP ENV"; }
                        EnvelopeEditor {
                            height: 30px;
                            attack: root.attack / 2; decay: root.decay / 2; sustain <=> root.sustain; release: root.release / 2;
                            attack-text: round(root.attack * 1000) + " ms"; decay-text: round(root.decay * 1000) + " ms";
                            sustain-text: round(root.sustain * 100) + "%"; release-text: round(root.release * 1000) + " ms";
                            attack-changed(v) => { root.attack = v * 2; root.attack-changed(root.attack); }
                            decay-changed(v) => { root.decay = v * 2; root.decay-changed(root.decay); }
                            sustain-changed(v) => { root.sustain-changed(v); }
                            release-changed(v) => { root.release = v * 2; root.release-changed(root.release); }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        SectionLabel { text: "FILTER ENV"; }
                        EnvelopeEditor {
                            height: 30px;
                            attack: root.filter-attack / 2; decay: root.filter-decay / 2;
                            sustain <=> root.filter-sustain; release: root.filter-release / 2;
                            attack-text: round(root.filter-attack * 1000) + " ms";
                            decay-text: round(root.filter-decay * 1000) + " ms";
                            sustain-text: round(root.filter-sustain * 100) + "%";
                            release-text: round(root.filter-release * 1000) + " ms";
                            attack-changed(v) => { root.filter-attack = v * 2; root.filter-attack-changed(root.filter-attack); }
                            decay-changed(v) => { root.filter-decay = v * 2; root.filter-decay-changed(root.filter-decay); }
                            sustain-changed(v) => { root.filter-sustain-changed(v); }
                            release-changed(v) => { root.filter-release = v * 2; root.filter-release-changed(root.filter-release); }
                        }
                    }
                }
                // Two columns of a shorter knob rather than four of a
                // taller one. Four fit the height the page bar left, but
                // not the width: this region is the first thing a narrow
                // window clips, and at 960px four of them clipped.
                HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        spacing: 0px;
                        KnobField {
                            diameter: 20px;
                            label-width: 48px;
                            field-width: 40px;
                            label: "ENV AMT";
                            tooltip: "How far the filter envelope sweeps the cutoff";
                            value <=> root.filter-env; minimum: -1; maximum: 1; default-value: 0; bipolar: true;
                            display-text: (root.filter-env > 0 ? "+" : "") + round(root.filter-env * 100) + "%";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[45];
                            modulation-depth: root.modulation-depths[45];
                            modulation-offset: root.modulation-offsets[45];
                            modulation-route-count: root.modulation-route-counts[45];
                            changed(v) => { root.filter-env-changed(v); }
                            text-committed(t) => { root.text-committed(45, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(45, v); }
                            modulation-edit-started => { root.modulation-edit-started(45); }
                            modulation-edit-finished => { root.modulation-edit-finished(45); }
                        }
                        KnobField {
                            diameter: 20px;
                            label-width: 48px;
                            field-width: 40px;
                            label: "DRIVE";
                            tooltip: "Pre-filter drive, inside the feedback loop";
                            value <=> root.drive; minimum: 0; maximum: 1; default-value: 0;
                            display-text: round(root.drive * 100) + "%";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[46];
                            modulation-depth: root.modulation-depths[46];
                            modulation-offset: root.modulation-offsets[46];
                            modulation-route-count: root.modulation-route-counts[46];
                            changed(v) => { root.drive-changed(v); }
                            text-committed(t) => { root.text-committed(46, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(46, v); }
                            modulation-edit-started => { root.modulation-edit-started(46); }
                            modulation-edit-finished => { root.modulation-edit-finished(46); }
                        }
                        KnobField {
                            diameter: 20px;
                            label-width: 48px;
                            field-width: 40px;
                            label: "FEEDBACK";
                            tooltip: "Filter output back into its input, bounded by the drive";
                            value <=> root.voice-feedback; minimum: -1; maximum: 1; default-value: 0; bipolar: true;
                            display-text: (root.voice-feedback > 0 ? "+" : "") + round(root.voice-feedback * 100) + "%";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[54];
                            modulation-depth: root.modulation-depths[54];
                            modulation-offset: root.modulation-offsets[54];
                            modulation-route-count: root.modulation-route-counts[54];
                            changed(v) => { root.voice-feedback-changed(v); }
                            text-committed(t) => { root.text-committed(54, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(54, v); }
                            modulation-edit-started => { root.modulation-edit-started(54); }
                            modulation-edit-finished => { root.modulation-edit-finished(54); }
                        }
                        KnobField {
                            diameter: 20px;
                            label-width: 48px;
                            field-width: 40px;
                            label: "KEYTRACK";
                            tooltip: "Cutoff per played octave; 100% is one for one";
                            value <=> root.keytrack; minimum: 0; maximum: 2; default-value: 0;
                            display-text: round(root.keytrack * 100) + "%";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[47];
                            modulation-depth: root.modulation-depths[47];
                            modulation-offset: root.modulation-offsets[47];
                            modulation-route-count: root.modulation-route-counts[47];
                            changed(v) => { root.keytrack-changed(v); }
                            text-committed(t) => { root.text-committed(47, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(47, v); }
                            modulation-edit-started => { root.modulation-edit-started(47); }
                            modulation-edit-finished => { root.modulation-edit-finished(47); }
                        }
                    }
                    VerticalLayout {
                        spacing: 0px;
                        KnobField {
                            diameter: 20px;
                            label-width: 48px;
                            field-width: 40px;
                            label: "AMP VEL";
                            tooltip: "How much velocity scales the VCA";
                            value <=> root.amp-velocity; minimum: 0; maximum: 1; default-value: 1;
                            display-text: round(root.amp-velocity * 100) + "%";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[52];
                            modulation-depth: root.modulation-depths[52];
                            modulation-offset: root.modulation-offsets[52];
                            modulation-route-count: root.modulation-route-counts[52];
                            changed(v) => { root.amp-velocity-changed(v); }
                            text-committed(t) => { root.text-committed(52, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(52, v); }
                            modulation-edit-started => { root.modulation-edit-started(52); }
                            modulation-edit-finished => { root.modulation-edit-finished(52); }
                        }
                        KnobField {
                            diameter: 20px;
                            label-width: 48px;
                            field-width: 40px;
                            label: "FILT VEL";
                            tooltip: "How much velocity adds to the filter envelope depth";
                            value <=> root.filter-velocity; minimum: -1; maximum: 1; default-value: 0; bipolar: true;
                            display-text: (root.filter-velocity > 0 ? "+" : "") + round(root.filter-velocity * 100) + "%";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[53];
                            modulation-depth: root.modulation-depths[53];
                            modulation-offset: root.modulation-offsets[53];
                            modulation-route-count: root.modulation-route-counts[53];
                            changed(v) => { root.filter-velocity-changed(v); }
                            text-committed(t) => { root.text-committed(53, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(53, v); }
                            modulation-edit-started => { root.modulation-edit-started(53); }
                            modulation-edit-finished => { root.modulation-edit-finished(53); }
                        }
                        KnobField {
                            diameter: 20px;
                            label-width: 48px;
                            field-width: 40px;
                            label: "GLIDE";
                            tooltip: "Portamento between reused voices";
                            value <=> root.glide; minimum: 0; maximum: 2; default-value: 0;
                            display-text: round(root.glide * 1000) + " ms";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[19];
                            modulation-depth: root.modulation-depths[19];
                            modulation-offset: root.modulation-offsets[19];
                            modulation-route-count: root.modulation-route-counts[19];
                            changed(v) => { root.glide-changed(v); }
                            text-committed(t) => { root.text-committed(19, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(19, v); }
                            modulation-edit-started => { root.modulation-edit-started(19); }
                            modulation-edit-finished => { root.modulation-edit-finished(19); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                    // Allocation, character, and the finisher: two more
                    // columns of the same knob row rather than a band under
                    // the region, because the region has no height left.
                    // Narrower knobs than the two columns to their left,
                    // because the width they cost is what took the face from
                    // three rack units to four and the margin at four is
                    // twenty pixels, not two hundred.
                    VerticalLayout {
                        spacing: 0px;
                        KnobField {
                            diameter: 20px;
                            label-width: 40px;
                            field-width: 32px;
                            label: "DETUNE";
                            value <=> root.detune; minimum: 0; maximum: 1; default-value: 0;
                            display-text: round(root.detune * 100) + "%";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[66];
                            modulation-depth: root.modulation-depths[66];
                            modulation-offset: root.modulation-offsets[66];
                            modulation-route-count: root.modulation-route-counts[66];
                            changed(v) => { root.detune-changed(v); }
                            text-committed(t) => { root.text-committed(66, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(66, v); }
                            modulation-edit-started => { root.modulation-edit-started(66); }
                            modulation-edit-finished => { root.modulation-edit-finished(66); }
                        }
                        KnobField {
                            diameter: 20px;
                            label-width: 40px;
                            field-width: 32px;
                            label: "DRIFT";
                            value <=> root.drift; minimum: 0; maximum: 1; default-value: 0;
                            display-text: round(root.drift * 100) + "%";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[64];
                            modulation-depth: root.modulation-depths[64];
                            modulation-offset: root.modulation-offsets[64];
                            modulation-route-count: root.modulation-route-counts[64];
                            changed(v) => { root.drift-changed(v); }
                            text-committed(t) => { root.text-committed(64, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(64, v); }
                            modulation-edit-started => { root.modulation-edit-started(64); }
                            modulation-edit-finished => { root.modulation-edit-finished(64); }
                        }
                        KnobField {
                            diameter: 20px;
                            label-width: 40px;
                            field-width: 32px;
                            label: "SPREAD";
                            value <=> root.spread; minimum: 0; maximum: 1; default-value: 0;
                            display-text: round(root.spread * 100) + "%";
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[67];
                            modulation-depth: root.modulation-depths[67];
                            modulation-offset: root.modulation-offsets[67];
                            modulation-route-count: root.modulation-route-counts[67];
                            changed(v) => { root.spread-changed(v); }
                            text-committed(t) => { root.text-committed(67, t); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(67, v); }
                            modulation-edit-started => { root.modulation-edit-started(67); }
                            modulation-edit-finished => { root.modulation-edit-finished(67); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                    // Eight is instrument information, not a control: it is
                    // the pool, and nothing on this face can change it. What
                    // Unison chooses is how much of it one note takes, so the
                    // number that moves is the one beside it -- how many
                    // notes are left to play.
                    VerticalLayout {
                        spacing: 1px;
                        HorizontalLayout {
                            spacing: 3px;
                            SectionLabel { text: "VOICES 8"; }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                // Silent rather than wrong when the
                                // vocabulary has not been installed: a "0
                                // NOTES" on a working instrument would be a
                                // face inventing a number it was not given.
                                text: root.unison-note-counts.length > root.unison
                                    ? root.unison-note-counts[root.unison] + (root.unison-note-counts[root.unison] == 1 ? " NOTE" : " NOTES")
                                    : "";
                                color: Theme.text-muted;
                                font-size: 9px;
                                height: 12px;
                            }
                        }
                        SelectorBank {
                            options: ["1x", "2x", "4x", "8x"];
                            selected-index <=> root.unison;
                            segment-width: 24px;
                            tooltip: "Unison";
                            selected(i) => { root.unison-changed(i); }
                        }
                        SectionLabel { text: "CHORUS"; }
                        SelectorBank {
                            options: ["OFF", "I", "II", "ENS"];
                            selected-index <=> root.chorus;
                            segment-width: 24px;
                            tooltip: "Chorus";
                            selected(i) => { root.chorus-changed(i); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        // --- The instrument's own modulation --------------------------------
        //
        // The LFO on the left, the routes it and the five per-voice sources
        // reach through on the right. One surface, in the order a patch is
        // built: pick a shape, then say where it lands.
        if root.page == 1 : HorizontalLayout {
            vertical-stretch: 1;
            padding: 1px;
            spacing: 0px;

            VerticalLayout {
                width: 216px;
                spacing: 4px;
                SectionLabel { text: "ML-P8 LFO"; }
                SelectorBank {
                    options: ["SIN", "TRI", "RMP", "PLS", "S&H", "CHA"];
                    selected-index <=> root.lfo-wave;
                    segment-width: 33px;
                    tooltip: "LFO shape";
                    selected(i) => { root.lfo-wave-changed(i); }
                }
                HorizontalLayout {
                    spacing: 4px;
                    SyncMiniKnob {
                        label: "RATE";
                        free-value: root.lfo-rate-hz;
                        free-minimum: 0.01;
                        free-maximum: 100;
                        free-default: 2;
                        free-scale: ValueScale.logarithmic;
                        free-value-text: root.lfo-rate-hz < 10
                            ? round(root.lfo-rate-hz * 100) / 100 + " Hz"
                            : round(root.lfo-rate-hz * 10) / 10 + " Hz";
                        synced: root.lfo-synced;
                        division: root.lfo-division;
                        free-changed(v) => { root.lfo-rate-changed(v); }
                        sync-changed(on) => { root.lfo-sync-changed(on); }
                        division-changed(d) => { root.lfo-division-changed(d); }
                    }
                    VerticalLayout {
                        spacing: 1px;
                        y: 8px;
                        height: 45px;
                        KnobField {
                            diameter: 20px;
                            label-width: 42px;
                            field-width: 42px;
                            label: "PHASE";
                            tooltip: "Where the shape is read from, in cycles";
                            value <=> root.lfo-phase; minimum: 0; maximum: 1; default-value: 0;
                            display-text: round(root.lfo-phase * 360) + "\u{b0}";
                            changed(v) => { root.lfo-phase-changed(v); }
                            text-committed(t) => { root.text-committed(59, t); }
                        }
                        KnobField {
                            diameter: 20px;
                            label-width: 42px;
                            field-width: 42px;
                            label: "WARP";
                            // Two honest meanings, decided by the wave rather
                            // than by a second knob, so the tooltip says which
                            // one is live.
                            tooltip: root.lfo-wave >= 4
                                ? "Bias: toward the rails, or toward the centre"
                                : "Shape skew: which side of the cycle the pivot sits on";
                            value <=> root.lfo-warp; minimum: -1; maximum: 1; default-value: 0; bipolar: true;
                            display-text: (root.lfo-warp > 0 ? "+" : "") + round(root.lfo-warp * 100) + "%";
                            changed(v) => { root.lfo-warp-changed(v); }
                            text-committed(t) => { root.text-committed(60, t); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                KnobField {
                    diameter: 20px;
                    label-width: 42px;
                    field-width: 42px;
                    label: "SLEW";
                    tooltip: "Rounding, as a share of the cycle";
                    value <=> root.lfo-slew; minimum: 0; maximum: 1; default-value: 0;
                    display-text: round(root.lfo-slew * 100) + "%";
                    changed(v) => { root.lfo-slew-changed(v); }
                    text-committed(t) => { root.text-committed(61, t); }
                }
                SelectorBank {
                    options: ["FREE", "CHORD", "NOTE"];
                    selected-index <=> root.lfo-retrigger;
                    segment-width: 66px;
                    tooltip: "When the LFO restarts";
                    selected(i) => { root.lfo-retrigger-changed(i); }
                }
                Rectangle { vertical-stretch: 1; }
            }

            Rectangle { width: 6px; }
            Rectangle { width: 1px; background: Theme.border; }
            Rectangle { width: 6px; }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 4px;
                    SectionLabel { text: "ROUTES"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.routes-status;
                        color: Theme.text-faint;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                    // The affordance stops offering itself at the ceiling
                    // rather than failing on click.
                    if !root.routes-full : ToolButton {
                        text: "+ ADD ROUTE";
                        tooltip: "Add an internal modulation route";
                        min-width: 88px;
                        max-width: 88px;
                        clicked => { root.route-added(); }
                    }
                }
                if root.routes.length == 0 : Text {
                    height: 22px;
                    text: "No internal routes. This patch moves only where its knobs are set.";
                    color: Theme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 1px;
                        for row in root.routes : RouteRow {
                            route: row;
                            source-names: root.route-source-names;
                            dest-names: root.route-dest-names;
                            source-picked(index) => { root.route-source-changed(row.id, index); }
                            dest-picked(index) => { root.route-dest-changed(row.id, index); }
                            amount-changed(v) => { root.route-amount-changed(row.id, v); }
                            removed => { root.route-removed(row.id); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }
    }
}
