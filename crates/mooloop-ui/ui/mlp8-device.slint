                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.sync-y;
                    width: grid.cell-w;
                    height: 18px;
                    destination: 0;
                    source <=> root.sync1;
                    changed(v) => { root.sync1-changed(v); }
