import { Theme } from "theme.slint";
import { KnobField, ParameterKnob, SectionLabel, SelectorBank, InstrumentModule } from "controls.slint";
import { EnvelopeEditor } from "envelope.slint";
import { OscillatorTrace } from "device-displays.slint";
import { GainMath } from "gain.slint";

// One directed relationship in the oscillator network: drag to set, signed
// percent, zero at the middle.
//
// The interaction is a `ParameterKnob` with its dial turned off rather than a
// second draggable control, because arming a modulation source changes what
// every gesture *means* -- a drag edits route depth, a double-click clears it
// -- and a hand-rolled cell would be a second place that has to agree about
// that. What it draws instead of a dial is a bar growing from the centre, so
// the sign of a route is a direction on screen rather than a minus sign to
// read.
component NetworkCell inherits Rectangle {
    in property <string> tooltip;
    // The diagonal: an oscillator modulating itself. The same operation on
    // the same one-sample state as a pair route, which is why it lives in the
    // grid rather than in a Feedback panel somewhere else.
    in property <bool> self-route;
    in property <int> param-id;
    in-out property <float> value;
    in property <bool> modulation-armed;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback changed(float);
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);

    private property <float> magnitude: abs(root.value) / 100;
    private property <bool> live: abs(root.value) > 0.5;

    min-height: 26px;
    border-radius: Theme.radius-sm;
    background: Theme.panel;
    border-width: 1px;
    border-color: knob.hovered ? Theme.accent.with-alpha(0.5)
        : root.self-route ? Theme.accent.with-alpha(0.3) : Theme.border;

    // Zero, drawn once, so an empty cell still reads as a control rather than
    // as a gap in the grid.
    Rectangle {
        y: parent.height / 2;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
    Rectangle {
        x: 1px;
        width: parent.width - 2px;
        y: root.value >= 0
            ? parent.height / 2 - (parent.height / 2 - 1px) * root.magnitude
            : parent.height / 2;
        height: (parent.height / 2 - 1px) * root.magnitude;
        background: Theme.accent.with-alpha(root.value >= 0 ? 0.42 : 0.24);
    }
    Text {
        width: 100%;
        height: 100%;
        text: root.live ? (root.value > 0 ? "+" : "") + round(root.value) : "";
        color: Theme.text;
        font-family: "monospace";
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    knob := ParameterKnob {
        width: 100%;
        height: 100%;
        show-label: false;
        show-value-text: false;
        show-dial: false;
        label: root.tooltip;
        tooltip: root.tooltip;
        value <=> root.value;
        minimum: -100;
        maximum: 100;
        default-value: 0;
        bipolar: true;
        value-text: (root.value > 0 ? "+" : "") + round(root.value) + "%";
        modulation-armed: root.modulation-armed;
        modulation-allowed: root.allowed[root.param-id];
        modulation-depth: root.depths[root.param-id];
        modulation-offset: root.offsets[root.param-id];
        modulation-route-count: root.route-counts[root.param-id];
        changed(v) => { root.changed(v); }
        modulation-depth-changed(v) => { root.route-depth-changed(root.param-id, v); }
        modulation-edit-started => { root.route-edit-started(root.param-id); }
        modulation-edit-finished => { root.route-edit-finished(root.param-id); }
    }
}

// Which oscillator hard-syncs this column's oscillator. Click cycles; the
// column's own oscillator is missing from its cycle, because an oscillator
// syncing itself is a stuck phase rather than a topology.
component SyncChip inherits Rectangle {
    in property <int> destination;
    in-out property <int> source;
    callback changed(int);

    pure function skip-self(candidate: int) -> int {
        return candidate == root.destination + 1 ? candidate + 1 : candidate;
    }

    min-height: 18px;
    border-radius: Theme.radius-sm;
    background: root.source == 0 ? Theme.panel : Theme.accent.with-alpha(0.22);
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent.with-alpha(0.5)
        : root.source == 0 ? Theme.border : Theme.accent.with-alpha(0.45);
    accessible-role: button;
    accessible-label: "Hard sync source";

    Text {
        width: 100%;
        height: 100%;
        text: root.source == 0 ? "--" : "OSC " + root.source;
        color: root.source == 0 ? Theme.text-faint : Theme.text;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            let stepped = root.skip-self(root.source + 1);
            root.source = stepped > 3 ? 0 : stepped;
            root.changed(root.source);
        }
    }
}

// One tab in the oscillator selector.
component OscTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> audible;
    callback clicked();

    width: 22px;
    height: 18px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.accent.with-alpha(0.25) : Theme.panel;
    border-width: 1px;
    border-color: root.active ? Theme.accent.with-alpha(0.6)
        : touch.has-hover ? Theme.border : Theme.border.with-alpha(0.6);
    accessible-role: button;
    accessible-label: "Oscillator " + root.text;

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        // A muted oscillator is still wired in, so the tab distinguishes
        // audible from silent rather than active from inactive.
        color: root.active ? Theme.text : root.audible ? Theme.text-muted : Theme.text-faint;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// One oscillator's own controls. Written once and shown for whichever tab is
// selected, because the network beside it is what has to stay visible: in this
// instrument the relationships are the subject and the tunings are detail.
component OscEditor inherits Rectangle {
    in property <int> index;
    in-out property <int> wave;
    in-out property <float> semitones;
    in-out property <float> cents;
    in-out property <float> level;
    in-out property <float> pulse-width;
    in property <bool> modulation-armed;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback wave-changed(int);
    callback semitones-changed(float);
    callback cents-changed(float);
    callback level-changed(float);
    callback pulse-width-changed(float);
    callback text-committed(int, string);
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);

    // ML-P8's oscillator blocks are five ids wide from zero, not the shared
    // synths' `100 + n * 10`.
    private property <int> base: root.index * 5;

    VerticalLayout {
        spacing: 4px;
        Rectangle {
            vertical-stretch: 1;
            min-height: 40px;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            OscillatorTrace {
                x: 4px;
                y: 3px;
                width: parent.width - 8px;
                height: parent.height - 6px;
                wave: root.wave;
                semitones: root.semitones;
                cents: root.cents;
                level: root.level;
                pulse-width: root.pulse-width;
            }
        }
        SelectorBank {
            options: ["SIN", "TRI", "SAW", "PLS"];
            selected-index <=> root.wave;
            segment-width: 34px;
            tooltip: "Oscillator waveform";
            selected(i) => { root.wave-changed(i); }
        }
        KnobField {
            diameter: 24px;
            label: "SEMI";
            tooltip: "Coarse tuning";
            value <=> root.semitones; minimum: -48; maximum: 48; default-value: 0; step: 1;
            display-text: (root.semitones > 0 ? "+" : "") + round(root.semitones) + " st";
            modulation-armed: root.modulation-armed;
            modulation-allowed: root.allowed[root.base + 1];
            modulation-depth: root.depths[root.base + 1];
            modulation-offset: root.offsets[root.base + 1];
            modulation-route-count: root.route-counts[root.base + 1];
            changed(v) => { root.semitones-changed(v); }
            text-committed(t) => { root.text-committed(root.base + 1, t); }
            modulation-depth-changed(v) => { root.route-depth-changed(root.base + 1, v); }
            modulation-edit-started => { root.route-edit-started(root.base + 1); }
            modulation-edit-finished => { root.route-edit-finished(root.base + 1); }
        }
        KnobField {
            diameter: 24px;
            label: "FINE";
            tooltip: "Fine tuning";
            value <=> root.cents; minimum: -100; maximum: 100; default-value: 0; step: 1;
            display-text: (root.cents > 0 ? "+" : "") + round(root.cents) + " ct";
            modulation-armed: root.modulation-armed;
            modulation-allowed: root.allowed[root.base + 2];
            modulation-depth: root.depths[root.base + 2];
            modulation-offset: root.offsets[root.base + 2];
            modulation-route-count: root.route-counts[root.base + 2];
            changed(v) => { root.cents-changed(v); }
            text-committed(t) => { root.text-committed(root.base + 2, t); }
            modulation-depth-changed(v) => { root.route-depth-changed(root.base + 2, v); }
            modulation-edit-started => { root.route-edit-started(root.base + 2); }
            modulation-edit-finished => { root.route-edit-finished(root.base + 2); }
        }
        KnobField {
            diameter: 24px;
            label: "LEVEL";
            tooltip: "Mix level -- a muted oscillator still modulates and still syncs";
            // Drags and reads in dB while the parameter stays linear: a level
            // is a gain, and a linear 0..1 knob spends nine tenths of its
            // travel above -20 dB. `mlp8::is_gain_param` is the other half of
            // this, so what gets typed into the field is read as dB too.
            value: GainMath.linear-to-db(root.level);
            minimum: -60; maximum: 0; default-value: -60;
            display-text: GainMath.format-db(GainMath.linear-to-db(root.level));
            modulation-armed: root.modulation-armed;
            modulation-allowed: root.allowed[root.base + 3];
            modulation-depth: root.depths[root.base + 3];
            modulation-offset: root.offsets[root.base + 3];
            modulation-route-count: root.route-counts[root.base + 3];
            changed(v) => { root.level = GainMath.db-to-linear(v); root.level-changed(root.level); }
            text-committed(t) => { root.text-committed(root.base + 3, t); }
            modulation-depth-changed(v) => { root.route-depth-changed(root.base + 3, v); }
            modulation-edit-started => { root.route-edit-started(root.base + 3); }
            modulation-edit-finished => { root.route-edit-finished(root.base + 3); }
        }
        KnobField {
            diameter: 24px;
            label: "WIDTH";
            tooltip: "Pulse width";
            value <=> root.pulse-width; minimum: 0.05; maximum: 0.95; default-value: 0.5;
            display-text: round(root.pulse-width * 100) + "%";
            modulation-armed: root.modulation-armed;
            modulation-allowed: root.allowed[root.base + 4];
            modulation-depth: root.depths[root.base + 4];
            modulation-offset: root.offsets[root.base + 4];
            modulation-route-count: root.route-counts[root.base + 4];
            changed(v) => { root.pulse-width-changed(v); }
            text-committed(t) => { root.text-committed(root.base + 4, t); }
            modulation-depth-changed(v) => { root.route-depth-changed(root.base + 4, v); }
            modulation-edit-started => { root.route-edit-started(root.base + 4); }
            modulation-edit-finished => { root.route-edit-finished(root.base + 4); }
        }
    }
}

// The ML-P8's face. One screen, not a stack of pages.
//
// The centre is a grid of every relationship in the voice: rows are sources,
// columns are the oscillators they reach, the diagonal is an oscillator on
// itself, and hard sync is the row underneath because it is the same kind of
// fact -- one oscillator acting on another. Twelve amounts in a knob row said
// nothing about which of them were wired to what; as a grid the topology is
// the picture, and reading it costs a glance instead of twelve labels.
//
// The filter and its envelope are step 03 of the plan, ML-P8's own LFO and
// internal routes step 04, and allocation and the finishers step 05; each
// gets a column here rather than a page behind a button.
export component MlP8DeviceFace inherits Rectangle {
    // Which oscillator the left column is editing. Face state, not a device
    // parameter: nothing about it is saved, automatable, or sent to the engine.
    in-out property <int> osc-selected;
    in-out property <int> osc1-wave; in-out property <float> osc1-semitones; in-out property <float> osc1-cents; in-out property <float> osc1-level; in-out property <float> osc1-pulse-width;
    in-out property <int> osc2-wave; in-out property <float> osc2-semitones; in-out property <float> osc2-cents; in-out property <float> osc2-level; in-out property <float> osc2-pulse-width;
    in-out property <int> osc3-wave; in-out property <float> osc3-semitones; in-out property <float> osc3-cents; in-out property <float> osc3-level; in-out property <float> osc3-pulse-width;
    in-out property <float> attack; in-out property <float> decay; in-out property <float> sustain; in-out property <float> release; in-out property <float> glide;
    in-out property <float> sub-level; in-out property <int> sub-octave; in-out property <int> sub-wave; in-out property <int> sub-source;
    in-out property <float> noise-level; in-out property <float> noise-color;
    in-out property <float> xmod12; in-out property <float> xmod13; in-out property <float> xmod21; in-out property <float> xmod23; in-out property <float> xmod31; in-out property <float> xmod32;
    in-out property <float> noise-osc1; in-out property <float> noise-osc2; in-out property <float> noise-osc3;
    in-out property <float> feedback1; in-out property <float> feedback2; in-out property <float> feedback3;
    in-out property <int> sync1; in-out property <int> sync2; in-out property <int> sync3;
    in property <bool> modulation-armed;
    // Indexed by descriptor id. ML-P8's ids are its own namespace starting at
    // zero (`mlp8.rs` in mooloop-core), not the shared `SYNTH_PARAM_*` ones
    // the other synth faces index with.
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    callback osc1-wave-changed(int); callback osc1-semitones-changed(float); callback osc1-cents-changed(float); callback osc1-level-changed(float); callback osc1-pulse-width-changed(float);
    callback osc2-wave-changed(int); callback osc2-semitones-changed(float); callback osc2-cents-changed(float); callback osc2-level-changed(float); callback osc2-pulse-width-changed(float);
    callback osc3-wave-changed(int); callback osc3-semitones-changed(float); callback osc3-cents-changed(float); callback osc3-level-changed(float); callback osc3-pulse-width-changed(float);
    callback attack-changed(float); callback decay-changed(float); callback sustain-changed(float); callback release-changed(float); callback glide-changed(float);
    callback sub-level-changed(float); callback sub-octave-changed(int); callback sub-wave-changed(int); callback sub-source-changed(int);
    callback noise-level-changed(float); callback noise-color-changed(float);
    callback xmod12-changed(float); callback xmod13-changed(float); callback xmod21-changed(float); callback xmod23-changed(float); callback xmod31-changed(float); callback xmod32-changed(float);
    callback noise-osc1-changed(float); callback noise-osc2-changed(float); callback noise-osc3-changed(float);
    callback feedback1-changed(float); callback feedback2-changed(float); callback feedback3-changed(float);
    callback sync1-changed(int); callback sync2-changed(int); callback sync3-changed(int);
    callback text-committed(int, string);
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);

    HorizontalLayout {
        padding: 6px;
        spacing: 5px;

        // --- Oscillators ---------------------------------------------------
        InstrumentModule {
            width: 196px;
            HorizontalLayout {
                spacing: 3px;
                SectionLabel { text: "OSC"; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                OscTab {
                    text: "1";
                    active: root.osc-selected == 0;
                    audible: root.osc1-level > 0.0001;
                    clicked => { root.osc-selected = 0; }
                }
                OscTab {
                    text: "2";
                    active: root.osc-selected == 1;
                    audible: root.osc2-level > 0.0001;
                    clicked => { root.osc-selected = 1; }
                }
                OscTab {
                    text: "3";
                    active: root.osc-selected == 2;
                    audible: root.osc3-level > 0.0001;
                    clicked => { root.osc-selected = 2; }
                }
            }
            if root.osc-selected == 0 : OscEditor {
                index: 0;
                wave <=> root.osc1-wave;
                semitones <=> root.osc1-semitones;
                cents <=> root.osc1-cents;
                level <=> root.osc1-level;
                pulse-width <=> root.osc1-pulse-width;
                modulation-armed: root.modulation-armed;
                allowed: root.modulation-allowed;
                depths: root.modulation-depths;
                offsets: root.modulation-offsets;
                route-counts: root.modulation-route-counts;
                wave-changed(v) => { root.osc1-wave-changed(v); }
                semitones-changed(v) => { root.osc1-semitones-changed(v); }
                cents-changed(v) => { root.osc1-cents-changed(v); }
                level-changed(v) => { root.osc1-level-changed(v); }
                pulse-width-changed(v) => { root.osc1-pulse-width-changed(v); }
                text-committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                route-edit-started(p) => { root.modulation-edit-started(p); }
                route-edit-finished(p) => { root.modulation-edit-finished(p); }
            }
            if root.osc-selected == 1 : OscEditor {
                index: 1;
                wave <=> root.osc2-wave;
                semitones <=> root.osc2-semitones;
                cents <=> root.osc2-cents;
                level <=> root.osc2-level;
                pulse-width <=> root.osc2-pulse-width;
                modulation-armed: root.modulation-armed;
                allowed: root.modulation-allowed;
                depths: root.modulation-depths;
                offsets: root.modulation-offsets;
                route-counts: root.modulation-route-counts;
                wave-changed(v) => { root.osc2-wave-changed(v); }
                semitones-changed(v) => { root.osc2-semitones-changed(v); }
                cents-changed(v) => { root.osc2-cents-changed(v); }
                level-changed(v) => { root.osc2-level-changed(v); }
                pulse-width-changed(v) => { root.osc2-pulse-width-changed(v); }
                text-committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                route-edit-started(p) => { root.modulation-edit-started(p); }
                route-edit-finished(p) => { root.modulation-edit-finished(p); }
            }
            if root.osc-selected == 2 : OscEditor {
                index: 2;
                wave <=> root.osc3-wave;
                semitones <=> root.osc3-semitones;
                cents <=> root.osc3-cents;
                level <=> root.osc3-level;
                pulse-width <=> root.osc3-pulse-width;
                modulation-armed: root.modulation-armed;
                allowed: root.modulation-allowed;
                depths: root.modulation-depths;
                offsets: root.modulation-offsets;
                route-counts: root.modulation-route-counts;
                wave-changed(v) => { root.osc3-wave-changed(v); }
                semitones-changed(v) => { root.osc3-semitones-changed(v); }
                cents-changed(v) => { root.osc3-cents-changed(v); }
                level-changed(v) => { root.osc3-level-changed(v); }
                pulse-width-changed(v) => { root.osc3-pulse-width-changed(v); }
                text-committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                route-edit-started(p) => { root.modulation-edit-started(p); }
                route-edit-finished(p) => { root.modulation-edit-finished(p); }
            }
        }

        // --- The network ----------------------------------------------------
        InstrumentModule {
            // Fixed, because the grid inside it is. Stretching the panel and
            // not its contents just moves empty space around.
            horizontal-stretch: 0;
            title: "NETWORK";
            // Placed rather than laid out, and every dimension is a constant.
            //
            // A cell's interaction is a full-size `ParameterKnob`, and that
            // knob sizes its own insides from its width -- so the moment a
            // layout asks a cell how wide it would like to be, the answer
            // depends on the answer. `KnobField` sidesteps the same problem
            // the same way. A grid of uniform cells has nothing to negotiate
            // anyway: the numbers below *are* the layout.
            grid := Rectangle {
                property <length> label-w: 42px;
                property <length> cell-w: 54px;
                property <length> cell-h: 26px;
                property <length> gap: 3px;
                property <length> header-h: 14px;
                property <length> sync-y: self.header-h + 4 * (self.cell-h + self.gap) + 5px;

                horizontal-stretch: 0;
                width: self.label-w + 3 * (self.cell-w + self.gap);
                height: self.sync-y + 18px;

                Text {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: 0;
                    width: grid.cell-w;
                    height: grid.header-h;
                    text: "OSC 1";
                    color: Theme.text-faint;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: 0;
                    width: grid.cell-w;
                    height: grid.header-h;
                    text: "OSC 2";
                    color: Theme.text-faint;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: 0;
                    width: grid.cell-w;
                    height: grid.header-h;
                    text: "OSC 3";
                    color: Theme.text-faint;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    x: 0;
                    y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                    width: grid.label-w;
                    height: grid.cell-h;
                    text: "OSC 1";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                NetworkCell {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 1 self-feedback";
                    self-route: true;
                    param-id: 36;
                    value <=> root.feedback1;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.feedback1-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 1 phase-modulates 2";
                    self-route: false;
                    param-id: 27;
                    value <=> root.xmod12;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod12-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 1 phase-modulates 3";
                    self-route: false;
                    param-id: 28;
                    value <=> root.xmod13;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod13-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    x: 0;
                    y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                    width: grid.label-w;
                    height: grid.cell-h;
                    text: "OSC 2";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                NetworkCell {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 2 phase-modulates 1";
                    self-route: false;
                    param-id: 29;
                    value <=> root.xmod21;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod21-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 2 self-feedback";
                    self-route: true;
                    param-id: 37;
                    value <=> root.feedback2;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.feedback2-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 2 phase-modulates 3";
                    self-route: false;
                    param-id: 30;
                    value <=> root.xmod23;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod23-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    x: 0;
                    y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                    width: grid.label-w;
                    height: grid.cell-h;
                    text: "OSC 3";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                NetworkCell {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 3 phase-modulates 1";
                    self-route: false;
                    param-id: 31;
                    value <=> root.xmod31;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod31-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 3 phase-modulates 2";
                    self-route: false;
                    param-id: 32;
                    value <=> root.xmod32;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod32-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 3 self-feedback";
                    self-route: true;
                    param-id: 38;
                    value <=> root.feedback3;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.feedback3-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    x: 0;
                    y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                    width: grid.label-w;
                    height: grid.cell-h;
                    text: "NOISE";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                NetworkCell {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Noise phase-modulates oscillator 1";
                    self-route: false;
                    param-id: 33;
                    value <=> root.noise-osc1;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.noise-osc1-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Noise phase-modulates oscillator 2";
                    self-route: false;
                    param-id: 34;
                    value <=> root.noise-osc2;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.noise-osc2-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Noise phase-modulates oscillator 3";
                    self-route: false;
                    param-id: 35;
                    value <=> root.noise-osc3;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.noise-osc3-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    x: 0;
                    y: grid.sync-y;
                    width: grid.label-w;
                    height: 18px;
                    text: "SYNC";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                SyncChip {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.sync-y;
                    width: grid.cell-w;
                    height: 18px;
                    destination: 0;
                    source <=> root.sync1;
                    changed(v) => { root.sync1-changed(v); }
                }
                SyncChip {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.sync-y;
                    width: grid.cell-w;
                    height: 18px;
                    destination: 1;
                    source <=> root.sync2;
                    changed(v) => { root.sync2-changed(v); }
                }
                SyncChip {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.sync-y;
                    width: grid.cell-w;
                    height: 18px;
                    destination: 2;
                    source <=> root.sync3;
                    changed(v) => { root.sync3-changed(v); }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        // --- Amplitude, and the two sources that are not oscillators --------
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 214px;
            spacing: 5px;
            InstrumentModule {
                title: "AMP";
                EnvelopeEditor {
                    vertical-stretch: 1;
                    min-height: 38px;
                    attack: root.attack / 2; decay: root.decay / 2; sustain <=> root.sustain; release: root.release / 2;
                    attack-text: round(root.attack * 1000) + " ms"; decay-text: round(root.decay * 1000) + " ms";
                    sustain-text: round(root.sustain * 100) + "%"; release-text: round(root.release * 1000) + " ms";
                    attack-changed(v) => { root.attack = v * 2; root.attack-changed(root.attack); }
                    decay-changed(v) => { root.decay = v * 2; root.decay-changed(root.decay); }
                    sustain-changed(v) => { root.sustain-changed(v); }
                    release-changed(v) => { root.release = v * 2; root.release-changed(root.release); }
                }
                KnobField {
                    diameter: 24px;
                    label: "GLIDE";
                    tooltip: "Portamento between reused voices";
                    value <=> root.glide; minimum: 0; maximum: 2; default-value: 0;
                    display-text: round(root.glide * 1000) + " ms";
                    modulation-armed: root.modulation-armed;
                    modulation-allowed: root.modulation-allowed[19];
                    modulation-depth: root.modulation-depths[19];
                    modulation-offset: root.modulation-offsets[19];
                    modulation-route-count: root.modulation-route-counts[19];
                    changed(v) => { root.glide-changed(v); }
                    text-committed(t) => { root.text-committed(19, t); }
                    modulation-depth-changed(v) => { root.modulation-depth-changed(19, v); }
                    modulation-edit-started => { root.modulation-edit-started(19); }
                    modulation-edit-finished => { root.modulation-edit-finished(19); }
                }
            }
            InstrumentModule {
                title: "SUB / NOISE";
                HorizontalLayout {
                    spacing: 3px;
                    SelectorBank {
                        options: ["-1", "-2"];
                        selected-index <=> root.sub-octave;
                        segment-width: 26px;
                        tooltip: "Sub octave";
                        selected(i) => { root.sub-octave-changed(i); }
                    }
                    SelectorBank {
                        options: ["SIN", "SQR"];
                        selected-index <=> root.sub-wave;
                        segment-width: 32px;
                        tooltip: "Sub waveform";
                        selected(i) => { root.sub-wave-changed(i); }
                    }
                    SelectorBank {
                        options: ["1", "2", "3"];
                        selected-index <=> root.sub-source;
                        segment-width: 22px;
                        tooltip: "Which oscillator the sub divides";
                        selected(i) => { root.sub-source-changed(i); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                KnobField {
                    diameter: 24px;
                    label: "LEVEL";
                    tooltip: "Sub mix level";
                    // dB on the control, linear in the parameter; see the
                    // oscillator level above and `mlp8::is_gain_param`.
                    value: GainMath.linear-to-db(root.sub-level);
                    minimum: -60; maximum: 0; default-value: -60;
                    display-text: GainMath.format-db(GainMath.linear-to-db(root.sub-level));
                    modulation-armed: root.modulation-armed;
                    modulation-allowed: root.modulation-allowed[20];
                    modulation-depth: root.modulation-depths[20];
                    modulation-offset: root.modulation-offsets[20];
                    modulation-route-count: root.modulation-route-counts[20];
                    changed(v) => { root.sub-level = GainMath.db-to-linear(v); root.sub-level-changed(root.sub-level); }
                    text-committed(t) => { root.text-committed(20, t); }
                    modulation-depth-changed(v) => { root.modulation-depth-changed(20, v); }
                    modulation-edit-started => { root.modulation-edit-started(20); }
                    modulation-edit-finished => { root.modulation-edit-finished(20); }
                }
                KnobField {
                    diameter: 24px;
                    label: "NOISE";
                    tooltip: "Noise mix level, independent of what noise modulates";
                    // dB on the control, linear in the parameter; see the
                    // oscillator level above and `mlp8::is_gain_param`.
                    value: GainMath.linear-to-db(root.noise-level);
                    minimum: -60; maximum: 0; default-value: -60;
                    display-text: GainMath.format-db(GainMath.linear-to-db(root.noise-level));
                    modulation-armed: root.modulation-armed;
                    modulation-allowed: root.modulation-allowed[25];
                    modulation-depth: root.modulation-depths[25];
                    modulation-offset: root.modulation-offsets[25];
                    modulation-route-count: root.modulation-route-counts[25];
                    changed(v) => { root.noise-level = GainMath.db-to-linear(v); root.noise-level-changed(root.noise-level); }
                    text-committed(t) => { root.text-committed(25, t); }
                    modulation-depth-changed(v) => { root.modulation-depth-changed(25, v); }
                    modulation-edit-started => { root.modulation-edit-started(25); }
                    modulation-edit-finished => { root.modulation-edit-finished(25); }
                }
                KnobField {
                    diameter: 24px;
                    label: "COLOR";
                    tooltip: "Dark through white to bright";
                    value <=> root.noise-color; minimum: -100; maximum: 100; default-value: 0; bipolar: true;
                    display-text: root.noise-color < -1 ? round(-root.noise-color) + "% dark"
                        : root.noise-color > 1 ? round(root.noise-color) + "% bright" : "white";
                    modulation-armed: root.modulation-armed;
                    modulation-allowed: root.modulation-allowed[26];
                    modulation-depth: root.modulation-depths[26];
                    modulation-offset: root.modulation-offsets[26];
                    modulation-route-count: root.modulation-route-counts[26];
                    changed(v) => { root.noise-color-changed(v); }
                    text-committed(t) => { root.text-committed(26, t); }
                    modulation-depth-changed(v) => { root.modulation-depth-changed(26, v); }
                    modulation-edit-started => { root.modulation-edit-started(26); }
                    modulation-edit-finished => { root.modulation-edit-finished(26); }
                }
            }
        }
    }
}
