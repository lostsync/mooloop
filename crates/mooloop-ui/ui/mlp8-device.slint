import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Divisions, KnobField, KnobStack, ParameterKnob, PickerChip, SectionLabel, SelectorBank, ToolButton, ValueScale } from "controls.slint";
import { DevicePageButton } from "device-rack.slint";
import { EnvelopeEditor } from "envelope.slint";
import { FilterResponseDisplay, OscillatorTrace } from "device-displays.slint";

import { GainMath } from "gain.slint";

// One authored internal route, as the face needs it.
//
// The id is the route's durable identity, not its position: every edit names
// it, so a row that moves because a neighbour was removed still edits the
// route it was drawn for.
export struct MlP8RouteRow {
    id: int,
    source: int,
    dest: int,
    // Signed percent of the destination's full range, `[-100, 100]`.
    amount: float,
    // What the destination is called, resolved from its descriptor by Rust so
    // the face does not carry a second copy of the parameter table.
    dest-name: string,
    // Whether the source swings both ways about zero. A property of the
    // source rather than a control on the route: a unipolar source rests at
    // zero and the amount's sign chooses which way it goes from there.
    bipolar: bool,
}

// One row of the route list: what it reads, what it moves, how much, and a
// way to take it back out.
//
// Polarity is shown rather than chosen. It is a property of the *source* --
// the LFO and Key swing both ways, an envelope and velocity rest at zero --
// and the amount's sign already decides which direction a unipolar source
// travels. A per-route polarity switch would be a second answer to a question
// the source list has already settled.
component RouteRow inherits Rectangle {
    in property <MlP8RouteRow> route;
    in property <[string]> source-names;
    in property <[string]> dest-names;
    callback source-picked(int);
    callback dest-picked(int);
    callback amount-changed(float);
    callback removed();

    height: 20px;

    HorizontalLayout {
        spacing: 4px;
        y: 1px;
        height: 18px;
        PickerChip {
            width: 72px;
            options: root.source-names;
            selected-index: root.route.source;
            tooltip: "What this route reads";
            text-color: Theme.accent;
            picked(index) => { root.source-picked(index); }
        }
        Text {
            width: 10px;
            height: parent.height;
            text: "\u{2192}";
            color: Theme.text-faint;
            font-size: 9px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        PickerChip {
            horizontal-stretch: 1;
            options: root.dest-names;
            selected-index: root.route.dest;
            tooltip: "What this route moves";
            picked(index) => { root.dest-picked(index); }
        }
        Text {
            width: 24px;
            height: parent.height;
            text: root.route.bipolar ? "BI" : "UNI";
            color: Theme.text-faint;
            font-size: 7px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        KnobField {
            diameter: 18px;
            label-width: 0px;
            field-width: 48px;
            label: "";
            tooltip: "Depth, as a share of the destination's range";
            value: root.route.amount;
            minimum: -100; maximum: 100; default-value: 0; bipolar: true;
            display-text: (root.route.amount > 0 ? "+" : "") + round(root.route.amount) + "%";
            changed(v) => { root.amount-changed(v); }
        }
        ToolButton {
            text: "\u{00d7}";
            tooltip: "Remove this route";
            min-width: 18px;
            max-width: 18px;
            clicked => { root.removed(); }
        }
    }
}

// One directed relationship in the oscillator network: drag to set, signed
// percent, zero at the middle.
//
// The interaction is a `ParameterKnob` with its dial turned off rather than a
// second draggable control, because arming a modulation source changes what
// every gesture *means* -- a drag edits route depth, a double-click clears it
// -- and a hand-rolled cell would be a second place that has to agree about
// that. What it draws instead of a dial is a bar growing from the centre, so
// the sign of a route is a direction on screen rather than a minus sign to
// read.
component NetworkCell inherits Rectangle {
    in property <string> tooltip;
    // The diagonal: an oscillator modulating itself. The same operation on
    // the same one-sample state as a pair route, which is why it lives in the
    // grid rather than in a Feedback panel somewhere else.
    in property <bool> self-route;
    // A mix level: this source into the output. Unipolar and in dB, so it
    // fills from the floor rather than from the middle -- a level has no
    // sign to show, and drawing it like one would be a lie about what the
    // control does.
    in property <bool> level;
    // A relationship this device does not have. The sub is derived from an
    // oscillator and cannot modulate one, so its route cells are drawn as
    // absent rather than as zero: nothing to turn up.
    in property <bool> inert;
    in property <int> param-id;
    in-out property <float> value;
    in property <bool> modulation-armed;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback changed(float);
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);

    // A level's travel is its dB range; a route's is its signed percent.
    private property <float> db: GainMath.linear-to-db(root.value);
    private property <float> magnitude: root.level
        ? clamp((root.db + 60) / 60, 0, 1)
        : abs(root.value) / 100;
    private property <bool> live: root.level ? root.db > -59.5 : abs(root.value) > 0.5;

    min-height: 22px;
    border-radius: Theme.radius-sm;
    background: root.inert ? Theme.surface : Theme.panel;
    border-width: 1px;
    border-color: root.inert ? Theme.border.with-alpha(0.35)
        : knob.hovered ? Theme.accent.with-alpha(0.55)
        : root.self-route ? Theme.accent.with-alpha(0.3) : Theme.border;

    // The datum a fill grows from: the middle for a signed route, the floor
    // for a level. Drawn even at zero so an idle cell still reads as a
    // control rather than as a gap in the grid.
    if !root.inert : Rectangle {
        y: root.level ? parent.height - 1px : parent.height / 2;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
    if !root.inert : Rectangle {
        x: 1px;
        width: parent.width - 2px;
        y: root.level
            ? parent.height - 1px - (parent.height - 2px) * root.magnitude
            : root.value >= 0
                ? parent.height / 2 - (parent.height / 2 - 1px) * root.magnitude
                : parent.height / 2;
        height: root.level
            ? (parent.height - 2px) * root.magnitude
            : (parent.height / 2 - 1px) * root.magnitude;
        background: Theme.accent.with-alpha(root.level ? 0.34 : root.value >= 0 ? 0.42 : 0.24);
    }
    Text {
        width: 100%;
        height: 100%;
        text: root.inert ? "-"
            : root.level ? (root.live ? round(root.db) + "" : "-inf")
            : root.live ? (root.value > 0 ? "+" : "") + round(root.value)
            : "";
        color: root.inert || !root.live ? Theme.text-faint : Theme.text;
        font-family: "monospace";
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    knob := ParameterKnob {
        width: 100%;
        height: 100%;
        visible: !root.inert;
        show-label: false;
        show-value-text: false;
        show-dial: false;
        label: root.tooltip;
        tooltip: root.tooltip;
        // A level drags in dB and stores linear, like every other mix control
        // on this face; `mlp8::is_gain_param` is the other half of it.
        value: root.level ? root.db : root.value;
        minimum: root.level ? -60 : -100;
        maximum: root.level ? 0 : 100;
        default-value: root.level ? -60 : 0;
        bipolar: !root.level;
        value-text: root.level
            ? GainMath.format-db(root.db)
            : (root.value > 0 ? "+" : "") + round(root.value) + "%";
        modulation-armed: root.modulation-armed;
        modulation-allowed: root.allowed[root.param-id];
        modulation-depth: root.depths[root.param-id];
        modulation-offset: root.offsets[root.param-id];
        modulation-route-count: root.route-counts[root.param-id];
        changed(v) => {
            root.value = root.level ? GainMath.db-to-linear(v) : v;
            root.changed(root.value);
        }
        modulation-depth-changed(v) => { root.route-depth-changed(root.param-id, v); }
        modulation-edit-started => { root.route-edit-started(root.param-id); }
        modulation-edit-finished => { root.route-edit-finished(root.param-id); }
    }
}

// Which oscillator hard-syncs this column's oscillator. Click cycles; the
// column's own oscillator is missing from its cycle, because an oscillator
// syncing itself is a stuck phase rather than a topology.
component SyncChip inherits Rectangle {
    in property <int> destination;
    in-out property <int> source;
    callback changed(int);

    pure function skip-self(candidate: int) -> int {
        return candidate == root.destination + 1 ? candidate + 1 : candidate;
    }

    min-height: 18px;
    border-radius: Theme.radius-sm;
    background: root.source == 0 ? Theme.panel : Theme.accent.with-alpha(0.22);
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent.with-alpha(0.5)
        : root.source == 0 ? Theme.border : Theme.accent.with-alpha(0.45);
    accessible-role: button;
    accessible-label: "Hard sync source";

    Text {
        width: 100%;
        height: 100%;
        text: root.source == 0 ? "--" : "OSC " + root.source;
        color: root.source == 0 ? Theme.text-faint : Theme.text;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            let stepped = root.skip-self(root.source + 1);
            root.source = stepped > 3 ? 0 : stepped;
            root.changed(root.source);
        }
    }
}

// One tab in the oscillator selector.

// One knob on this face: 34px, stacked, and typed into.
//
// Every control here goes through it, so a page is written as a list of
// parameters rather than as ten lines of modulation plumbing repeated per
// knob. The id is the whole address -- the modulation arrays are indexed by
// descriptor id, so a knob that knows its id knows everything else.
component P8Knob inherits KnobStack {
    in property <int> param;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);
    callback committed(int, string);

    modulation-allowed: root.allowed[root.param];
    modulation-depth: root.depths[root.param];
    modulation-offset: root.offsets[root.param];
    modulation-route-count: root.route-counts[root.param];
    text-committed(t) => { root.committed(root.param, t); }
    modulation-depth-changed(v) => { root.route-depth-changed(root.param, v); }
    modulation-edit-started => { root.route-edit-started(root.param); }
    modulation-edit-finished => { root.route-edit-finished(root.param); }
}

// A bounded group. Every module on every page has the same padding, the same
// title row and the same corner, so nothing on this face is aligned by eye.
component Module inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    background: Theme.panel;
    border-radius: Theme.radius-sm;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        HorizontalLayout {
            height: 12px;
            spacing: 6px;
            SectionLabel { text: root.title; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.caption;
                color: Theme.text-muted;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
        @children
    }
}

// One oscillator: what it sounds like, then what it is tuned to.
//
// Four knobs across is exactly a quarter of the face, which is what sets the
// OSC page's four equal columns. Level appears here *and* in the network
// grid's MIX column on purpose -- it is this oscillator's loudness and it is
// this source's route to the output, and both readings are true.
component OscEditor inherits Rectangle {
    in property <int> index;
    in property <string> title;
    in-out property <int> wave;
    in-out property <float> semitones;
    in-out property <float> cents;
    in-out property <float> level;
    in-out property <float> pulse-width;
    in property <bool> modulation-armed;
    in property <[float]> depths;
    in property <[bool]> allowed;
    in property <[float]> offsets;
    in property <[int]> route-counts;
    callback wave-changed(int);
    callback semitones-changed(float);
    callback cents-changed(float);
    callback level-changed(float);
    callback pulse-width-changed(float);
    callback text-committed(int, string);
    callback route-depth-changed(int, float);
    callback route-edit-started(int);
    callback route-edit-finished(int);

    // ML-P8's oscillator blocks are five ids wide from zero, not the shared
    // synths' `100 + n * 10`.
    private property <int> base: root.index * 5;

    background: Theme.panel;
    border-radius: Theme.radius-sm;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        SectionLabel { text: root.title; }
        SelectorBank {
            options: ["SIN", "TRI", "SAW", "PLS"];
            selected-index <=> root.wave;
            segment-width: 44px;
            tooltip: "Waveform";
            selected(i) => { root.wave-changed(i); }
        }
        // Scales by level on purpose: an oscillator muted in the mix draws
        // flat, so the page says which of the three you are hearing.
        OscillatorTrace {
            vertical-stretch: 1;
            wave: root.wave;
            semitones: root.semitones;
            cents: root.cents;
            level: root.level;
            pulse-width: root.pulse-width;
        }
        HorizontalLayout {
            P8Knob {
                label: "SEMI"; tooltip: "Coarse tuning";
                param: root.base + 1;
                value <=> root.semitones; minimum: -48; maximum: 48; default-value: 0; step: 1;
                display-text: (root.semitones > 0 ? "+" : "") + round(root.semitones) + " st";
                modulation-armed: root.modulation-armed;
                depths: root.depths; allowed: root.allowed; offsets: root.offsets; route-counts: root.route-counts;
                changed(v) => { root.semitones-changed(v); }
                committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.route-depth-changed(p, v); }
                route-edit-started(p) => { root.route-edit-started(p); }
                route-edit-finished(p) => { root.route-edit-finished(p); }
            }
            P8Knob {
                label: "FINE"; tooltip: "Fine tuning";
                param: root.base + 2;
                value <=> root.cents; minimum: -100; maximum: 100; default-value: 0; step: 1;
                display-text: (root.cents > 0 ? "+" : "") + round(root.cents) + " ct";
                modulation-armed: root.modulation-armed;
                depths: root.depths; allowed: root.allowed; offsets: root.offsets; route-counts: root.route-counts;
                changed(v) => { root.cents-changed(v); }
                committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.route-depth-changed(p, v); }
                route-edit-started(p) => { root.route-edit-started(p); }
                route-edit-finished(p) => { root.route-edit-finished(p); }
            }
            P8Knob {
                label: "LEVEL"; tooltip: "Mix level";
                param: root.base + 3;
                value <=> root.level; minimum: 0; maximum: 1; default-value: 0;
                display-text: root.level <= 0 ? "-inf" : round(GainMath.linear-to-db(root.level) * 10) / 10 + " dB";
                modulation-armed: root.modulation-armed;
                depths: root.depths; allowed: root.allowed; offsets: root.offsets; route-counts: root.route-counts;
                changed(v) => { root.level-changed(v); }
                committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.route-depth-changed(p, v); }
                route-edit-started(p) => { root.route-edit-started(p); }
                route-edit-finished(p) => { root.route-edit-finished(p); }
            }
            P8Knob {
                label: "WIDTH"; tooltip: "Pulse width";
                param: root.base + 4;
                value <=> root.pulse-width; minimum: 0.05; maximum: 0.95; default-value: 0.5;
                display-text: round(root.pulse-width * 100) + "%";
                modulation-armed: root.modulation-armed;
                depths: root.depths; allowed: root.allowed; offsets: root.offsets; route-counts: root.route-counts;
                changed(v) => { root.pulse-width-changed(v); }
                committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.route-depth-changed(p, v); }
                route-edit-started(p) => { root.route-edit-started(p); }
                route-edit-finished(p) => { root.route-edit-finished(p); }
            }
        }
    }
}
export component MlP8DeviceFace inherits Rectangle {
    in-out property <int> osc1-wave; in-out property <float> osc1-semitones; in-out property <float> osc1-cents; in-out property <float> osc1-level; in-out property <float> osc1-pulse-width;
    in-out property <int> osc2-wave; in-out property <float> osc2-semitones; in-out property <float> osc2-cents; in-out property <float> osc2-level; in-out property <float> osc2-pulse-width;
    in-out property <int> osc3-wave; in-out property <float> osc3-semitones; in-out property <float> osc3-cents; in-out property <float> osc3-level; in-out property <float> osc3-pulse-width;
    in-out property <float> attack; in-out property <float> decay; in-out property <float> sustain; in-out property <float> release; in-out property <float> glide;
    in-out property <float> sub-level; in-out property <int> sub-octave; in-out property <int> sub-wave; in-out property <int> sub-source;
    in-out property <float> noise-level; in-out property <float> noise-color;
    in-out property <float> xmod12; in-out property <float> xmod13; in-out property <float> xmod21; in-out property <float> xmod23; in-out property <float> xmod31; in-out property <float> xmod32;
    in-out property <float> noise-osc1; in-out property <float> noise-osc2; in-out property <float> noise-osc3;
    in-out property <float> feedback1; in-out property <float> feedback2; in-out property <float> feedback3;
    in-out property <int> sync1; in-out property <int> sync2; in-out property <int> sync3;
    in-out property <int> filter-mode;
    in-out property <float> filter-cutoff; in-out property <float> filter-resonance; in-out property <float> filter-env; in-out property <float> drive;
    in-out property <float> keytrack; in-out property <float> amp-velocity; in-out property <float> filter-velocity; in-out property <float> voice-feedback;
    in-out property <float> filter-attack; in-out property <float> filter-decay; in-out property <float> filter-sustain; in-out property <float> filter-release;
    // Step 05. Unison and Chorus are indices into their own selectors; the
    // other three are unit values read as percentages.
    in-out property <float> drift; in-out property <int> unison; in-out property <float> detune; in-out property <float> spread; in-out property <int> chorus;
    // The device's own output stage, which is the base every voice's level
    // and pan route offsets from.
    in-out property <float> master-volume; in-out property <float> master-pan;
    /// `MlP8Unison::note_polyphony()` for each option, in `MlP8Unison::ALL`
    /// order. Supplied by Rust rather than derived here: eight over the group
    /// size is the pool's own arithmetic, and a face that restates it is a
    /// second place for it to be wrong.
    in property <[int]> unison-note-counts;
    // OSC, NETWORK, FILTER, AMP, MOD. Five pages rather than one dense
    // screen: at four rack units the one-screen face fitted its controls only
    // by shrinking them to a 20px dial and a 9px caption, which is unreadable
    // on a laptop. Pages cost a click and buy a knob you can see.
    in-out property <int> page;
    in-out property <int> lfo-wave;
    in-out property <bool> lfo-synced;
    in-out property <float> lfo-rate-hz;
    in-out property <int> lfo-division;
    in-out property <float> lfo-phase;
    in-out property <float> lfo-warp;
    in-out property <float> lfo-slew;
    in-out property <int> lfo-retrigger;
    in property <[MlP8RouteRow]> routes;
    /// `MlP8ModSource::ALL` and `MlP8ModDest::ALL`, labelled by Rust so the
    /// face holds no second copy of either list.
    in property <[string]> route-source-names;
    in property <[string]> route-dest-names;
    /// True when the patch has reached the compiler's measured ceiling. The
    /// add affordance stops offering itself rather than failing on click.
    in property <bool> routes-full;
    in property <string> routes-status;
    callback lfo-wave-changed(int);
    callback lfo-sync-changed(bool);
    callback lfo-rate-changed(float);
    callback lfo-division-changed(int);
    callback lfo-phase-changed(float);
    callback lfo-warp-changed(float);
    callback lfo-slew-changed(float);
    callback lfo-retrigger-changed(int);
    /// Every route edit names the route's durable id, never its row.
    callback route-source-changed(int, int);
    callback route-dest-changed(int, int);
    callback route-amount-changed(int, float);
    callback route-removed(int);
    callback route-added();
    in property <bool> modulation-armed;
    // Indexed by descriptor id. ML-P8's ids are its own namespace starting at
    // zero (`mlp8.rs` in mooloop-core), not the shared `SYNTH_PARAM_*` ones
    // the other synth faces index with.
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    callback osc1-wave-changed(int); callback osc1-semitones-changed(float); callback osc1-cents-changed(float); callback osc1-level-changed(float); callback osc1-pulse-width-changed(float);
    callback osc2-wave-changed(int); callback osc2-semitones-changed(float); callback osc2-cents-changed(float); callback osc2-level-changed(float); callback osc2-pulse-width-changed(float);
    callback osc3-wave-changed(int); callback osc3-semitones-changed(float); callback osc3-cents-changed(float); callback osc3-level-changed(float); callback osc3-pulse-width-changed(float);
    callback attack-changed(float); callback decay-changed(float); callback sustain-changed(float); callback release-changed(float); callback glide-changed(float);
    callback sub-level-changed(float); callback sub-octave-changed(int); callback sub-wave-changed(int); callback sub-source-changed(int);
    callback noise-level-changed(float); callback noise-color-changed(float);
    callback xmod12-changed(float); callback xmod13-changed(float); callback xmod21-changed(float); callback xmod23-changed(float); callback xmod31-changed(float); callback xmod32-changed(float);
    callback noise-osc1-changed(float); callback noise-osc2-changed(float); callback noise-osc3-changed(float);
    callback feedback1-changed(float); callback feedback2-changed(float); callback feedback3-changed(float);
    callback sync1-changed(int); callback sync2-changed(int); callback sync3-changed(int);
    callback filter-mode-changed(int);
    callback filter-cutoff-changed(float); callback filter-resonance-changed(float); callback filter-env-changed(float); callback drive-changed(float);
    callback keytrack-changed(float); callback amp-velocity-changed(float); callback filter-velocity-changed(float); callback voice-feedback-changed(float);
    callback filter-attack-changed(float); callback filter-decay-changed(float); callback filter-sustain-changed(float); callback filter-release-changed(float);
    callback drift-changed(float); callback unison-changed(int); callback detune-changed(float); callback spread-changed(float); callback chorus-changed(int);
    callback master-volume-changed(float); callback master-pan-changed(float);
    callback text-committed(int, string);
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);


    // Five pages, each a few large controls inside modules that share one
    // chrome. The shipped face was one screen at four rack units and paid for
    // it in dial size; `docs/plans/poly-synth-v2/mockups/` is the argument.
    //
    // What did not change is the network grid: rows are sources, columns the
    // oscillators they reach, the diagonal is an oscillator on itself, and a
    // MIX column carries the levels because a level is a route to the output.
    // It simply gets a page to itself, and four times the column width.
    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 3px;
            DevicePageButton { text: "OSC"; active: root.page == 0; clicked => { root.page = 0; } }
            DevicePageButton { text: "NETWORK"; active: root.page == 1; clicked => { root.page = 1; } }
            DevicePageButton { text: "FILTER"; active: root.page == 2; clicked => { root.page = 2; } }
            DevicePageButton { text: "AMP"; active: root.page == 3; clicked => { root.page = 3; } }
            // Not plain MOD. The common device frame's MOD opens the *channel*
            // shelf, and a saved instrument route being mistaken for a channel
            // route is exactly the confusion this name prevents.
            DevicePageButton { text: "ML-P8 MOD"; active: root.page == 4; clicked => { root.page = 4; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { height: 1px; background: Theme.border; }


        // ---- OSC ---------------------------------------------------------
        if root.page == 0 : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            OscEditor {
                horizontal-stretch: 1; index: 0; title: "OSC 1";
                wave <=> root.osc1-wave; semitones <=> root.osc1-semitones; cents <=> root.osc1-cents;
                level <=> root.osc1-level; pulse-width <=> root.osc1-pulse-width;
                modulation-armed: root.modulation-armed;
                depths: root.modulation-depths; allowed: root.modulation-allowed;
                offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                wave-changed(v) => { root.osc1-wave-changed(v); }
                semitones-changed(v) => { root.osc1-semitones-changed(v); }
                cents-changed(v) => { root.osc1-cents-changed(v); }
                level-changed(v) => { root.osc1-level-changed(v); }
                pulse-width-changed(v) => { root.osc1-pulse-width-changed(v); }
                text-committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                route-edit-started(p) => { root.modulation-edit-started(p); }
                route-edit-finished(p) => { root.modulation-edit-finished(p); }
            }
            OscEditor {
                horizontal-stretch: 1; index: 1; title: "OSC 2";
                wave <=> root.osc2-wave; semitones <=> root.osc2-semitones; cents <=> root.osc2-cents;
                level <=> root.osc2-level; pulse-width <=> root.osc2-pulse-width;
                modulation-armed: root.modulation-armed;
                depths: root.modulation-depths; allowed: root.modulation-allowed;
                offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                wave-changed(v) => { root.osc2-wave-changed(v); }
                semitones-changed(v) => { root.osc2-semitones-changed(v); }
                cents-changed(v) => { root.osc2-cents-changed(v); }
                level-changed(v) => { root.osc2-level-changed(v); }
                pulse-width-changed(v) => { root.osc2-pulse-width-changed(v); }
                text-committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                route-edit-started(p) => { root.modulation-edit-started(p); }
                route-edit-finished(p) => { root.modulation-edit-finished(p); }
            }
            OscEditor {
                horizontal-stretch: 1; index: 2; title: "OSC 3";
                wave <=> root.osc3-wave; semitones <=> root.osc3-semitones; cents <=> root.osc3-cents;
                level <=> root.osc3-level; pulse-width <=> root.osc3-pulse-width;
                modulation-armed: root.modulation-armed;
                depths: root.modulation-depths; allowed: root.modulation-allowed;
                offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                wave-changed(v) => { root.osc3-wave-changed(v); }
                semitones-changed(v) => { root.osc3-semitones-changed(v); }
                cents-changed(v) => { root.osc3-cents-changed(v); }
                level-changed(v) => { root.osc3-level-changed(v); }
                pulse-width-changed(v) => { root.osc3-pulse-width-changed(v); }
                text-committed(p, t) => { root.text-committed(p, t); }
                route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                route-edit-started(p) => { root.modulation-edit-started(p); }
                route-edit-finished(p) => { root.modulation-edit-finished(p); }
            }
            // The two sources that are not oscillators, and the device's own
            // output. Their *levels* stay in the network grid's MIX column
            // with every other source's.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    SectionLabel { text: "SUB"; }
                    HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 6px;
                                SectionLabel { text: "OCT"; width: 34px; vertical-alignment: center; }
                                SelectorBank {
                                    options: ["-1", "-2"];
                                    selected-index <=> root.sub-octave;
                                    segment-width: 42px;
                                    tooltip: "Sub octave";
                                    selected(i) => { root.sub-octave-changed(i); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                SectionLabel { text: "WAVE"; width: 34px; vertical-alignment: center; }
                                SelectorBank {
                                    options: ["SIN", "SQR"];
                                    selected-index <=> root.sub-wave;
                                    segment-width: 42px;
                                    tooltip: "Sub waveform";
                                    selected(i) => { root.sub-wave-changed(i); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                SectionLabel { text: "FROM"; width: 34px; vertical-alignment: center; }
                                SelectorBank {
                                    options: ["1", "2", "3"];
                                    selected-index <=> root.sub-source;
                                    segment-width: 28px;
                                    tooltip: "Which oscillator the sub follows";
                                    selected(i) => { root.sub-source-changed(i); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        // NOISE owns exactly one control, so it is a captioned
                        // knob rather than a section of its own.
                        VerticalLayout {
                            spacing: 2px;
                            SectionLabel { text: "NOISE"; horizontal-alignment: center; }
                            P8Knob {
                                label: "COLOUR"; tooltip: "Noise tilt: dark, white, bright";
                                param: 26;
                                value <=> root.noise-color; minimum: -100; maximum: 100; default-value: 0; bipolar: true;
                                display-text: (root.noise-color > 0 ? "+" : "") + round(root.noise-color) + "%";
                                modulation-armed: root.modulation-armed;
                                depths: root.modulation-depths; allowed: root.modulation-allowed;
                                offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                                changed(v) => { root.noise-color-changed(v); }
                                committed(p, t) => { root.text-committed(p, t); }
                                route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                                route-edit-started(p) => { root.modulation-edit-started(p); }
                                route-edit-finished(p) => { root.modulation-edit-finished(p); }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    SectionLabel { text: "OUTPUT"; }
                    HorizontalLayout {
                        alignment: center;
                        P8Knob {
                            label: "VOLUME"; tooltip: "Device output level";
                            param: 69;
                            value <=> root.master-volume; minimum: 0; maximum: 1; default-value: 1;
                            display-text: root.master-volume <= 0 ? "-inf" : round(GainMath.linear-to-db(root.master-volume) * 10) / 10 + " dB";
                            modulation-armed: root.modulation-armed;
                            depths: root.modulation-depths; allowed: root.modulation-allowed;
                            offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                            changed(v) => { root.master-volume-changed(v); }
                            committed(p, t) => { root.text-committed(p, t); }
                            route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            route-edit-started(p) => { root.modulation-edit-started(p); }
                            route-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                        P8Knob {
                            label: "PAN"; tooltip: "Device position";
                            param: 70;
                            value <=> root.master-pan; minimum: -1; maximum: 1; default-value: 0; bipolar: true;
                            display-text: abs(root.master-pan) < 0.005 ? "C"
                                : (root.master-pan > 0 ? "R" : "L") + round(abs(root.master-pan) * 100);
                            modulation-armed: root.modulation-armed;
                            depths: root.modulation-depths; allowed: root.modulation-allowed;
                            offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                            changed(v) => { root.master-pan-changed(v); }
                            committed(p, t) => { root.text-committed(p, t); }
                            route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                            route-edit-started(p) => { root.modulation-edit-started(p); }
                            route-edit-finished(p) => { root.modulation-edit-finished(p); }
                        }
                    }
                }
            }
        }

        // ---- NETWORK -----------------------------------------------------
        if root.page == 1 : HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;
        VerticalLayout {
            spacing: 0px;
            SectionLabel { text: "NETWORK  ·  ROW MODULATES COLUMN"; }
            grid := Rectangle {
                property <length> label-w: 62px;
                property <length> cell-w: 176px;
                property <length> cell-h: 26px;
                property <length> gap: 4px;
                property <length> header-h: 16px;
                property <length> mix-x: self.label-w + 3 * (self.cell-w + self.gap) + 10px;
                property <length> sync-y: self.header-h + 5 * (self.cell-h + self.gap) + 4px;

                horizontal-stretch: 0;
                width: self.mix-x + self.cell-w;
                height: self.sync-y + 18px;

                // The rule between "into another oscillator" and "into the
                // output". Two kinds of destination, one grid.
                Rectangle {
                    x: grid.mix-x - 6px;
                    y: 0;
                    width: 1px;
                    height: grid.sync-y + 14px;
                    background: Theme.text-faint.with-alpha(0.5);
                }
                Text {
                    x: grid.mix-x;
                    y: 0;
                    width: grid.cell-w;
                    height: grid.header-h;
                    text: "MIX";
                    color: Theme.text-faint;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: 0;
                    width: grid.cell-w;
                    height: grid.header-h;
                    text: "OSC 1";
                    color: Theme.text-faint;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: 0;
                    width: grid.cell-w;
                    height: grid.header-h;
                    text: "OSC 2";
                    color: Theme.text-faint;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: 0;
                    width: grid.cell-w;
                    height: grid.header-h;
                    text: "OSC 3";
                    color: Theme.text-faint;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    x: 0;
                    y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                    width: grid.label-w;
                    height: grid.cell-h;
                    text: "OSC 1";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                NetworkCell {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 1 self-feedback";
                    self-route: true;
                    param-id: 36;
                    value <=> root.feedback1;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.feedback1-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 1 phase-modulates 2";
                    param-id: 27;
                    value <=> root.xmod12;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod12-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 1 phase-modulates 3";
                    param-id: 28;
                    value <=> root.xmod13;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod13-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.mix-x;
                    y: grid.header-h + 0 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 1 into the mix";
                    level: true;
                    param-id: 3;
                    value <=> root.osc1-level;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.osc1-level-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    x: 0;
                    y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                    width: grid.label-w;
                    height: grid.cell-h;
                    text: "OSC 2";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                NetworkCell {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 2 phase-modulates 1";
                    param-id: 29;
                    value <=> root.xmod21;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod21-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 2 self-feedback";
                    self-route: true;
                    param-id: 37;
                    value <=> root.feedback2;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.feedback2-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 2 phase-modulates 3";
                    param-id: 30;
                    value <=> root.xmod23;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod23-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.mix-x;
                    y: grid.header-h + 1 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 2 into the mix";
                    level: true;
                    param-id: 8;
                    value <=> root.osc2-level;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.osc2-level-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    x: 0;
                    y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                    width: grid.label-w;
                    height: grid.cell-h;
                    text: "OSC 3";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                NetworkCell {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 3 phase-modulates 1";
                    param-id: 31;
                    value <=> root.xmod31;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod31-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 3 phase-modulates 2";
                    param-id: 32;
                    value <=> root.xmod32;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.xmod32-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 3 self-feedback";
                    self-route: true;
                    param-id: 38;
                    value <=> root.feedback3;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.feedback3-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.mix-x;
                    y: grid.header-h + 2 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Oscillator 3 into the mix";
                    level: true;
                    param-id: 13;
                    value <=> root.osc3-level;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.osc3-level-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    x: 0;
                    y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                    width: grid.label-w;
                    height: grid.cell-h;
                    text: "SUB";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                NetworkCell {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "The sub is derived from an oscillator and cannot modulate one";
                    inert: true;
                }
                NetworkCell {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "The sub is derived from an oscillator and cannot modulate one";
                    inert: true;
                }
                NetworkCell {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "The sub is derived from an oscillator and cannot modulate one";
                    inert: true;
                }
                NetworkCell {
                    x: grid.mix-x;
                    y: grid.header-h + 3 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Sub into the mix";
                    level: true;
                    param-id: 20;
                    value <=> root.sub-level;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.sub-level-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    x: 0;
                    y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                    width: grid.label-w;
                    height: grid.cell-h;
                    text: "NOISE";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                NetworkCell {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Noise phase-modulates oscillator 1";
                    param-id: 33;
                    value <=> root.noise-osc1;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.noise-osc1-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Noise phase-modulates oscillator 2";
                    param-id: 34;
                    value <=> root.noise-osc2;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.noise-osc2-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Noise phase-modulates oscillator 3";
                    param-id: 35;
                    value <=> root.noise-osc3;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.noise-osc3-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                NetworkCell {
                    x: grid.mix-x;
                    y: grid.header-h + 4 * (grid.cell-h + grid.gap);
                    width: grid.cell-w;
                    height: grid.cell-h;
                    tooltip: "Noise into the mix";
                    level: true;
                    param-id: 25;
                    value <=> root.noise-level;
                    modulation-armed: root.modulation-armed;
                    allowed: root.modulation-allowed;
                    depths: root.modulation-depths;
                    offsets: root.modulation-offsets;
                    route-counts: root.modulation-route-counts;
                    changed(v) => { root.noise-level-changed(v); }
                    route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                    route-edit-started(p) => { root.modulation-edit-started(p); }
                    route-edit-finished(p) => { root.modulation-edit-finished(p); }
                }
                Text {
                    x: 0;
                    y: grid.sync-y;
                    width: grid.label-w;
                    height: 18px;
                    text: "SYNC";
                    color: Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                SyncChip {
                    x: grid.label-w + 0 * (grid.cell-w + grid.gap);
                    y: grid.sync-y;
                    width: grid.cell-w;
                    height: 18px;
                    destination: 0;
                    source <=> root.sync1;
                    changed(v) => { root.sync1-changed(v); }
                }
                SyncChip {
                    x: grid.label-w + 1 * (grid.cell-w + grid.gap);
                    y: grid.sync-y;
                    width: grid.cell-w;
                    height: 18px;
                    destination: 1;
                    source <=> root.sync2;
                    changed(v) => { root.sync2-changed(v); }
                }
                SyncChip {
                    x: grid.label-w + 2 * (grid.cell-w + grid.gap);
                    y: grid.sync-y;
                    width: grid.cell-w;
                    height: 18px;
                    destination: 2;
                    source <=> root.sync3;
                    changed(v) => { root.sync3-changed(v); }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        }

        // ---- FILTER ------------------------------------------------------
        // Two peers at the same size: the response, and the contour that
        // moves it. The response sits beside its knobs rather than above
        // them, because a 420px-wide picture of one curve is not four times
        // the information of a 100px one.
        if root.page == 2 : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            Module {
                width: 430px;
                title: "FILTER";
                SelectorBank {
                    options: ["LP12", "LP24", "BP", "HP"];
                    selected-index <=> root.filter-mode;
                    segment-width: 60px;
                    tooltip: "Filter response";
                    selected(i) => { root.filter-mode-changed(i); }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 6px;
                    FilterResponseDisplay {
                        horizontal-stretch: 1;
                        mode: root.filter-mode == 2 ? 1 : root.filter-mode == 3 ? 2 : 0;
                        slope: root.filter-mode == 1 ? 1.0 : 0.0;
                        cutoff: root.filter-cutoff;
                        resonance: root.filter-resonance;
                        env-amount: root.filter-env;
                        point-dragged(x, y) => {
                            root.filter-cutoff = clamp(x, 0, 1);
                            root.filter-cutoff-changed(root.filter-cutoff);
                            root.filter-resonance = clamp(y, 0, 1);
                            root.filter-resonance-changed(root.filter-resonance);
                        }
                        point-scrolled(d) => {
                            root.filter-resonance = clamp(root.filter-resonance + d, 0, 1);
                            root.filter-resonance-changed(root.filter-resonance);
                        }
                    }
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                    P8Knob {
                        label: "CUTOFF"; tooltip: "Filter cutoff";
                        param: 43;
                        value <=> root.filter-cutoff; minimum: 0; maximum: 1; default-value: 1; 
                        display-text: round(root.filter-cutoff * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.filter-cutoff-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "RESO"; tooltip: "Filter resonance";
                        param: 44;
                        value <=> root.filter-resonance; minimum: 0; maximum: 1; default-value: 0; 
                        display-text: round(root.filter-resonance * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.filter-resonance-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                        }
                        HorizontalLayout {
                    P8Knob {
                        label: "DRIVE"; tooltip: "Pre-filter drive, inside the feedback loop";
                        param: 46;
                        value <=> root.drive; minimum: 0; maximum: 1; default-value: 0; 
                        display-text: round(root.drive * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.drive-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "FEEDBACK"; tooltip: "Filter output back into its input";
                        param: 54;
                        value <=> root.voice-feedback; minimum: -1; maximum: 1; default-value: 0; bipolar: true; 
                        display-text: (root.voice-feedback > 0 ? "+" : "") + round(root.voice-feedback * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.voice-feedback-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                        }
                    }
                }
            }
            Module {
                horizontal-stretch: 1;
                title: "FILTER ENV";
                EnvelopeEditor {
                    vertical-stretch: 1;
                    attack: root.filter-attack / 2; decay: root.filter-decay / 2;
                    sustain <=> root.filter-sustain; release: root.filter-release / 2;
                    attack-text: round(root.filter-attack * 1000) + " ms";
                    decay-text: round(root.filter-decay * 1000) + " ms";
                    sustain-text: round(root.filter-sustain * 100) + "%";
                    release-text: round(root.filter-release * 1000) + " ms";
                    attack-changed(v) => { root.filter-attack = v * 2; root.filter-attack-changed(root.filter-attack); }
                    decay-changed(v) => { root.filter-decay = v * 2; root.filter-decay-changed(root.filter-decay); }
                    sustain-changed(v) => { root.filter-sustain-changed(v); }
                    release-changed(v) => { root.filter-release = v * 2; root.filter-release-changed(root.filter-release); }
                }
                // The handles on the curve stay; these are the same four
                // values as numbers you can read and dial exactly.
                HorizontalLayout {
                    alignment: center;
                    P8Knob {
                        label: "ATTACK"; tooltip: "Filter attack";
                        param: 48;
                        value <=> root.filter-attack; minimum: 0; maximum: 2; default-value: 0.005; 
                        display-text: round(root.filter-attack * 1000) + " ms";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.filter-attack-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "DECAY"; tooltip: "Filter decay";
                        param: 49;
                        value <=> root.filter-decay; minimum: 0; maximum: 2; default-value: 0.2; 
                        display-text: round(root.filter-decay * 1000) + " ms";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.filter-decay-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "SUSTAIN"; tooltip: "Filter sustain";
                        param: 50;
                        value <=> root.filter-sustain; minimum: 0; maximum: 1; default-value: 0.7; 
                        display-text: round(root.filter-sustain * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.filter-sustain-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "RELEASE"; tooltip: "Filter release";
                        param: 51;
                        value <=> root.filter-release; minimum: 0; maximum: 2; default-value: 0.15; 
                        display-text: round(root.filter-release * 1000) + " ms";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.filter-release-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "ENV AMT"; tooltip: "How far the envelope sweeps the cutoff";
                        param: 45;
                        value <=> root.filter-env; minimum: -1; maximum: 1; default-value: 0; bipolar: true; 
                        display-text: (root.filter-env > 0 ? "+" : "") + round(root.filter-env * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.filter-env-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "KEYTRACK"; tooltip: "Cutoff per played octave";
                        param: 47;
                        value <=> root.keytrack; minimum: 0; maximum: 2; default-value: 0; 
                        display-text: round(root.keytrack * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.keytrack-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "VELOCITY"; tooltip: "How much velocity adds to the envelope depth";
                        param: 53;
                        value <=> root.filter-velocity; minimum: -1; maximum: 1; default-value: 0; bipolar: true; 
                        display-text: (root.filter-velocity > 0 ? "+" : "") + round(root.filter-velocity * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.filter-velocity-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                }
            }
        }

        // ---- AMP ---------------------------------------------------------
        if root.page == 3 : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            Module {
                horizontal-stretch: 1;
                title: "AMP ENV";
                EnvelopeEditor {
                    vertical-stretch: 1;
                    attack: root.attack / 2; decay: root.decay / 2;
                    sustain <=> root.sustain; release: root.release / 2;
                    attack-text: round(root.attack * 1000) + " ms";
                    decay-text: round(root.decay * 1000) + " ms";
                    sustain-text: round(root.sustain * 100) + "%";
                    release-text: round(root.release * 1000) + " ms";
                    attack-changed(v) => { root.attack = v * 2; root.attack-changed(root.attack); }
                    decay-changed(v) => { root.decay = v * 2; root.decay-changed(root.decay); }
                    sustain-changed(v) => { root.sustain-changed(v); }
                    release-changed(v) => { root.release = v * 2; root.release-changed(root.release); }
                }
                HorizontalLayout {
                    alignment: center;
                    P8Knob {
                        label: "ATTACK"; tooltip: "Amplitude attack";
                        param: 15;
                        value <=> root.attack; minimum: 0; maximum: 2; default-value: 0.005; 
                        display-text: round(root.attack * 1000) + " ms";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.attack-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "DECAY"; tooltip: "Amplitude decay";
                        param: 16;
                        value <=> root.decay; minimum: 0; maximum: 2; default-value: 0.2; 
                        display-text: round(root.decay * 1000) + " ms";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.decay-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "SUSTAIN"; tooltip: "Amplitude sustain";
                        param: 17;
                        value <=> root.sustain; minimum: 0; maximum: 1; default-value: 0.7; 
                        display-text: round(root.sustain * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.sustain-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "RELEASE"; tooltip: "Amplitude release";
                        param: 18;
                        value <=> root.release; minimum: 0; maximum: 2; default-value: 0.15; 
                        display-text: round(root.release * 1000) + " ms";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.release-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "VELOCITY"; tooltip: "How much velocity scales the VCA";
                        param: 52;
                        value <=> root.amp-velocity; minimum: 0; maximum: 1; default-value: 1; 
                        display-text: round(root.amp-velocity * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.amp-velocity-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                }
            }
            Module {
                width: 430px;
                title: "VOICES  ·  8";
                caption: root.unison-note-counts.length > root.unison
                    ? root.unison-note-counts[root.unison] + (root.unison-note-counts[root.unison] == 1 ? " NOTE" : " NOTES")
                    : "";
                HorizontalLayout {
                    spacing: 6px;
                    SectionLabel { text: "UNISON"; width: 52px; vertical-alignment: center; }
                    SelectorBank {
                        options: ["1x", "2x", "4x", "8x"];
                        selected-index <=> root.unison;
                        segment-width: 44px;
                        tooltip: "Unison";
                        selected(i) => { root.unison-changed(i); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    SectionLabel { text: "CHORUS"; width: 52px; vertical-alignment: center; }
                    SelectorBank {
                        options: ["OFF", "I", "II", "ENS"];
                        selected-index <=> root.chorus;
                        segment-width: 44px;
                        tooltip: "Chorus";
                        selected(i) => { root.chorus-changed(i); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: start;
                    P8Knob {
                        label: "DETUNE"; tooltip: "Symmetric detune across a unison group";
                        param: 66;
                        value <=> root.detune; minimum: 0; maximum: 1; default-value: 0; 
                        display-text: round(root.detune * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.detune-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "SPREAD"; tooltip: "How far voices spread across the field";
                        param: 67;
                        value <=> root.spread; minimum: 0; maximum: 1; default-value: 0; 
                        display-text: round(root.spread * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.spread-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "DRIFT"; tooltip: "Stable per-slot character";
                        param: 64;
                        value <=> root.drift; minimum: 0; maximum: 1; default-value: 0; 
                        display-text: round(root.drift * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.drift-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                    P8Knob {
                        label: "GLIDE"; tooltip: "Portamento between reused voices";
                        param: 19;
                        value <=> root.glide; minimum: 0; maximum: 2; default-value: 0;
                        display-text: round(root.glide * 1000) + " ms";
                        modulation-armed: root.modulation-armed;
                        depths: root.modulation-depths; allowed: root.modulation-allowed;
                        offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                        changed(v) => { root.glide-changed(v); }
                        committed(p, t) => { root.text-committed(p, t); }
                        route-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                        route-edit-started(p) => { root.modulation-edit-started(p); }
                        route-edit-finished(p) => { root.modulation-edit-finished(p); }
                    }
                }
            }
        }
        if root.page == 4 : HorizontalLayout {
            vertical-stretch: 1;
            padding: 1px;
            spacing: 0px;

            VerticalLayout {
                width: 420px;
                spacing: 4px;
                SectionLabel { text: "ML-P8 LFO"; }
                SelectorBank {
                    options: ["SIN", "TRI", "RMP", "PLS", "S&H", "CHA"];
                    selected-index <=> root.lfo-wave;
                    segment-width: 52px;
                    tooltip: "LFO shape";
                    selected(i) => { root.lfo-wave-changed(i); }
                }
                // The shape, beside the controls that make it. Two of the
                // six waves are not periodic and the trace cannot draw them,
                // so it shows the ones it can and stands down for the rest
                // rather than drawing a lie.
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 6px;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.panel;
                        border-radius: Theme.radius-sm;
                        if root.lfo-wave < 4 : OscillatorTrace {
                            x: 4px;
                            y: 3px;
                            width: parent.width - 8px;
                            height: parent.height - 6px;
                            wave: root.lfo-wave;
                            level: 1.0;
                            pulse-width: 0.5;
                        }
                        if root.lfo-wave >= 4 : Text {
                            width: 100%;
                            height: 100%;
                            text: root.lfo-wave == 4 ? "sample & hold" : "chaos";
                            color: Theme.text-faint;
                            font-size: 9px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        VerticalLayout {
                            alignment: center;
                            P8Knob {
                                label: "PHASE"; tooltip: "Where the shape is read from, in cycles";
                                param: 59;
                                value <=> root.lfo-phase; minimum: 0; maximum: 1; default-value: 0;
                                display-text: round(root.lfo-phase * 360) + "\u{b0}";
                                depths: root.modulation-depths; allowed: root.modulation-allowed;
                                offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                                changed(v) => { root.lfo-phase-changed(v); }
                                committed(pp, t) => { root.text-committed(pp, t); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            P8Knob {
                                label: "WARP";
                                // Two honest meanings, decided by the wave
                                // rather than by a second knob, so the tooltip
                                // says which one is live.
                                tooltip: root.lfo-wave >= 4
                                    ? "Bias: toward the rails, or toward the centre"
                                    : "Shape skew: which side of the cycle the pivot sits on";
                                param: 60;
                                value <=> root.lfo-warp; minimum: -1; maximum: 1; default-value: 0; bipolar: true;
                                display-text: (root.lfo-warp > 0 ? "+" : "") + round(root.lfo-warp * 100) + "%";
                                depths: root.modulation-depths; allowed: root.modulation-allowed;
                                offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                                changed(v) => { root.lfo-warp-changed(v); }
                                committed(pp, t) => { root.text-committed(pp, t); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            P8Knob {
                                label: "SLEW"; tooltip: "How much of a cycle the shape is rounded off by";
                                param: 61;
                                value <=> root.lfo-slew; minimum: 0; maximum: 1; default-value: 0;
                                display-text: round(root.lfo-slew * 100) + "%";
                                depths: root.modulation-depths; allowed: root.modulation-allowed;
                                offsets: root.modulation-offsets; route-counts: root.modulation-route-counts;
                                changed(v) => { root.lfo-slew-changed(v); }
                                committed(pp, t) => { root.text-committed(pp, t); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            // Rate is the one timing control here, so it
                            // carries the shared sync LED: dark leaves the
                            // knob continuous Hz, lit turns the same gesture
                            // into a musical division. Same geometry as its
                            // neighbours, which is the whole point of putting
                            // the LED on `KnobStack` rather than keeping a
                            // second, smaller knob for it.
                            KnobStack {
                                label: "RATE";
                                tooltip: "LFO rate";
                                show-sync: true;
                                synced: root.lfo-synced;
                                value: root.lfo-synced ? root.lfo-division * 1.0 : root.lfo-rate-hz;
                                minimum: root.lfo-synced ? 0 : 0.01;
                                maximum: root.lfo-synced ? 20 : 100;
                                default-value: root.lfo-synced ? 7 : 2;
                                step: root.lfo-synced ? 1 : 0;
                                scale: root.lfo-synced ? ValueScale.linear : ValueScale.logarithmic;
                                display-text: root.lfo-synced
                                    ? Divisions.label(root.lfo-division)
                                    : (root.lfo-rate-hz < 10
                                        ? round(root.lfo-rate-hz * 100) / 100 + " Hz"
                                        : round(root.lfo-rate-hz * 10) / 10 + " Hz");
                                changed(v) => {
                                    if (root.lfo-synced) {
                                        root.lfo-division-changed(round(v));
                                    } else {
                                        root.lfo-rate-changed(v);
                                    }
                                }
                                sync-toggled(on) => { root.lfo-sync-changed(on); }
                                text-committed(t) => { root.text-committed(57, t); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    SectionLabel { text: "RETRIG"; width: 44px; vertical-alignment: center; }
                    SelectorBank {
                        options: ["FREE", "CHORD", "NOTE"];
                        selected-index <=> root.lfo-retrigger;
                        segment-width: 66px;
                        tooltip: "When the LFO restarts";
                        selected(i) => { root.lfo-retrigger-changed(i); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            Rectangle { width: 6px; }
            Rectangle { width: 1px; background: Theme.border; }
            Rectangle { width: 6px; }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 4px;
                    SectionLabel { text: "ROUTES"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.routes-status;
                        color: Theme.text-faint;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                    // The affordance stops offering itself at the ceiling
                    // rather than failing on click.
                    if !root.routes-full : ToolButton {
                        text: "+ ADD ROUTE";
                        tooltip: "Add an internal modulation route";
                        min-width: 88px;
                        max-width: 88px;
                        clicked => { root.route-added(); }
                    }
                }
                if root.routes.length == 0 : Text {
                    height: 22px;
                    text: "No internal routes. This patch moves only where its knobs are set.";
                    color: Theme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 1px;
                        for row in root.routes : RouteRow {
                            route: row;
                            source-names: root.route-source-names;
                            dest-names: root.route-dest-names;
                            source-picked(index) => { root.route-source-changed(row.id, index); }
                            dest-picked(index) => { root.route-dest-changed(row.id, index); }
                            amount-changed(v) => { root.route-amount-changed(row.id, v); }
                            removed => { root.route-removed(row.id); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }
    }
}
