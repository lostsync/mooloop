import { HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ParameterFader, SectionLabel, SegmentedControl, ToolButton } from "controls.slint";
import { NameField, StepperField } from "toolbar.slint";
import { DeviceRackMetrics } from "device-rack.slint";
import { MockupCatalog, MockupKind, MockupSpecimen } from "mockup-catalog.slint";

// One placed instance on the mockup canvas. Every kind reuses the same
// struct - a design mockup does not need each control's full parameter set,
// only enough to look and behave roughly like the real thing while it is
// dragged, resized and captioned.
//
// Position in `MockupCanvas.items` is paint order, so z-order needs no field
// of its own and survives a save/load without a second source of truth.
export struct MockupItem {
    kind: int,
    x: length,
    y: length,
    width: length,
    height: length,
    label: string,
    value: float,
    text: string,
    // Rack units for a `device-units` kind; 0 for everything else. Width is
    // computed from these, never stored, so a device mockup cannot drift off
    // the geometry the real rack lays out.
    units: int,
    half-unit: bool,
    locked: bool,
}

// One row of the left sidebar's palette, flattened in Rust: Slint has no
// `contains` for arrays, and grouping a many-to-many membership into headed
// sections is work the model side should have already done.
export struct MockupPaletteRow {
    header: bool,
    label: string,
    detail: string,
    kind: int,
    enabled: bool,
}

component PaletteEntry inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> enabled: true;
    callback clicked;
    min-height: 26px;
    border-radius: Theme.radius-md;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.surface-active
        : touch.has-hover ? Theme.surface-raised : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-faint;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.detail;
            color: Theme.text-faint;
            font-size: 8px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component LayerRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> locked;
    callback clicked;
    height: 22px;
    border-radius: Theme.radius-md;
    background: root.selected ? Theme.accent-active
        : touch.has-hover ? Theme.surface-raised : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        Text {
            text: root.locked ? "\u{1f512}" : "";
            color: Theme.text-faint;
            font-size: 8px;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.detail;
            color: root.selected ? Theme.text-muted : Theme.text-faint;
            font-size: 8px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One placed widget: a drag handle / label tab, the live control body, and
// a resize grip. Dragging the tab (once selected) or the body (always)
// moves the item; dragging the grip resizes it. Clicking the body selects
// it for the property panel; the body otherwise ignores plain clicks so a
// button, toggle, or LED never fires from an idle click in the layout -
// hold control to reach the real widget underneath.
component PlacedItem inherits Rectangle {
    in property <MockupItem> item;
    in property <bool> selected;
    callback select;
    // Deltas plus whether the gesture asked to bypass the snap grid.
    callback moved(length, length, bool);
    callback resized(length, length, bool);
    callback remove;
    callback value-changed(float);
    callback text-changed(string);

    private property <MockupKind> kind: MockupCatalog.kinds[root.item.kind];
    private property <length> press-x;
    private property <length> press-y;
    private property <bool> overlay-ctrl;
    private property <bool> overlay-alt;
    private property <float> overlay-start-value;
    private property <bool> overlay-moved;
    // Knob, mini knob, both faders, the mixer fader, and the trim knob all
    // read plain drags as value changes internally, so a body drag can never
    // reach `moved` through them - the overlay below claims the gesture
    // first and decides move vs. value-adjust from the modifier at press
    // time instead.
    private property <bool> drag-kind: root.kind.behavior == 1;
    // Discrete on/off controls: a held-control click (not a drag) flips them
    // instead of a plain click doing it, so clicking through a layout can
    // never accidentally fire a button.
    private property <bool> toggle-kind: root.kind.behavior == 2;
    // Discrete multi-option controls: a held-control click picks the option
    // under the pointer.
    private property <bool> index-kind: root.kind.behavior == 3;
    // The sticky note's text is mockup metadata, not a widget under test, so
    // it keeps taking plain clicks to place the caret - no overlay needed.
    private property <bool> note-kind: root.kind.behavior == 4;
    // A device is sized by the rack-unit picker, so it has no grip at all.
    private property <bool> resizable: !root.kind.device-units && !root.item.locked;

    x: item.x;
    y: item.y;
    width: item.width;
    height: item.height;

    if root.selected: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-width: 1px;
        border-color: root.item.locked ? Theme.warning : Theme.focus;
        border-radius: Theme.radius-md;
    }

    // File-folder tab: sits flush above the item's top edge and only
    // renders once selected, so an unselected layout reads as clean widgets
    // rather than a field of label chrome.
    strip := Rectangle {
        y: -14px;
        height: 14px;
        visible: root.selected;
        background: Theme.focus.with-alpha(0.3);
        border-radius: Theme.radius-sm;
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 2px;
            Text {
                text: root.kind.name;
                color: Theme.text-faint;
                font-size: 7px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "\u{2715}";
                color: Theme.text-faint;
                font-size: 8px;
                vertical-alignment: center;
                TouchArea { clicked => { root.remove(); } }
            }
        }
        strip-touch := TouchArea {
            mouse-cursor: move;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.select();
                    root.press-x = self.mouse-x;
                    root.press-y = self.mouse-y;
                    root.overlay-alt = e.modifiers.alt;
                } else if (e.kind == PointerEventKind.move && self.pressed && !root.item.locked) {
                    root.moved(self.mouse-x - root.press-x, self.mouse-y - root.press-y,
                        root.overlay-alt);
                }
            }
        }
    }

    body := Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;

        MockupSpecimen {
            width: 100%;
            height: 100%;
            kind: root.item.kind;
            label: root.item.label;
            value: root.item.value;
            text: root.item.text;
            note-edited(t) => { root.text-changed(t); }
            note-clicked => { root.select(); }
        }

        // Sits above the live control so a plain drag always moves the
        // item; holding control reaches through to the real widget instead -
        // adjusting its value on a knob or fader, or firing its click on a
        // button, toggle, or LED (only once release lands without much
        // movement, so a control ctrl-dragged out of the way doesn't also
        // fire). Holding alt drags free of the snap grid.
        if !root.note-kind: TouchArea {
            mouse-cursor: move;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.select();
                    root.press-x = self.mouse-x;
                    root.press-y = self.mouse-y;
                    root.overlay-ctrl = e.modifiers.control;
                    root.overlay-alt = e.modifiers.alt;
                    root.overlay-start-value = root.item.value;
                    root.overlay-moved = false;
                } else if (e.kind == PointerEventKind.move && self.pressed) {
                    if (abs((self.mouse-x - root.press-x) / 1px) > 2
                            || abs((self.mouse-y - root.press-y) / 1px) > 2) {
                        root.overlay-moved = true;
                    }
                    if (root.drag-kind && root.overlay-ctrl) {
                        root.value-changed(clamp(root.overlay-start-value
                            + (root.kind.drag-horizontal
                                ? (self.mouse-x - root.press-x) / 150px
                                : (root.press-y - self.mouse-y) / 150px), 0, 1));
                    } else if (!root.item.locked) {
                        root.moved(self.mouse-x - root.press-x, self.mouse-y - root.press-y,
                            root.overlay-alt);
                    }
                } else if (e.kind == PointerEventKind.up) {
                    if (root.overlay-ctrl && !root.overlay-moved) {
                        if (root.toggle-kind) {
                            root.value-changed(root.item.value > 0.5 ? 0 : 1);
                        } else if (root.index-kind) {
                            root.value-changed(clamp(floor(self.mouse-x / root.width * 3), 0, 2) / 2.0);
                        }
                    }
                }
            }
            double-clicked => { if (root.drag-kind) { root.value-changed(0.5); } }
            scroll-event(e) => {
                if (root.drag-kind) {
                    root.value-changed(clamp(root.item.value - e.delta-y / 600px, 0, 1));
                    accept
                } else {
                    reject
                }
            }
        }
    }

    if root.resizable: Rectangle {
        x: parent.width - 8px;
        y: parent.height - 8px;
        width: 8px;
        height: 8px;
        background: root.selected ? Theme.focus : Theme.text-faint;
        opacity: root.selected ? 1 : 0.5;
        grip-touch := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.select();
                    root.press-x = self.mouse-x;
                    root.press-y = self.mouse-y;
                    root.overlay-alt = e.modifiers.alt;
                } else if (e.kind == PointerEventKind.move && self.pressed) {
                    root.resized(self.mouse-x - root.press-x, self.mouse-y - root.press-y,
                        root.overlay-alt);
                }
            }
        }
    }
}

// A labelled block in the properties panel. Five of these in a column is the
// whole panel, so the caption and its spacing live in one place.
component PropertySection inherits VerticalLayout {
    in property <string> title;
    spacing: 4px;
    vertical-stretch: 0;
    SectionLabel { text: root.title; }
    @children
}

export component MockupCanvas inherits Window {
    title: "mooloop mockup";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.background;
    forward-focus: canvas-keys;

    in-out property <[MockupItem]> items: [];
    in-out property <int> selected-index: -1;
    in-out property <string> status-text;
    // Flattened by Rust from the catalog plus the build-time audit; see
    // `palette-query-changed`.
    in property <[MockupPaletteRow]> palette-rows: [];
    in-out property <int> palette-axis: 0;
    in-out property <string> palette-filter: "";
    in-out property <int> sidebar-tab: 0;
    in-out property <string> layout-name: "layout";
    in-out property <bool> snap-enabled: true;
    // Index into `grid-steps`, not the pixel count, so the segmented control
    // and the drawn grid agree without a second lookup.
    in-out property <int> grid-index: 0;
    out property <[length]> grid-steps: [4px, 8px, 10px, 20px, 40px];
    out property <length> grid-step: root.grid-steps[root.grid-index];

    callback save-requested(string);
    callback load-requested(string);
    // Adding, removing and reordering rows needs a real Vec, which only Rust
    // can splice into the model - .slint arrays have no push/remove of their
    // own, and array order is this tool's z-order.
    callback add-item(int);
    callback remove-item(int);
    callback duplicate-item(int);
    callback raise-item(int);
    callback lower-item(int);
    callback front-item(int);
    callback back-item(int);
    // Rust rebuilds `palette-rows` from `palette-axis` and `palette-filter`.
    callback palette-query-changed();

    private property <int> count: root.items.length;
    private property <bool> has-selection:
        root.selected-index >= 0 && root.selected-index < root.count;
    private property <MockupKind> selected-kind:
        MockupCatalog.kinds[root.has-selection ? root.items[root.selected-index].kind : 0];
    // Below about 10px a line every step is a wash rather than a grid, so the
    // fine settings draw a coarser multiple. Snapping still uses `grid-step`.
    private property <length> grid-draw-step:
        root.grid-step < 10px ? root.grid-step * 5 : root.grid-step;
    private property <int> grid-columns: 1600px / root.grid-draw-step;
    private property <int> grid-rows: 1100px / root.grid-draw-step;

    public function snap(value: length, bypass: bool) -> length {
        (!root.snap-enabled || bypass)
            ? value
            : round(value / root.grid-step) * root.grid-step
    }

    // Rack width is derived, never stored, so the unit picker is the only way
    // a device changes size and it can only land on geometry the rack builds.
    function apply-units(index: int, units: int, half: bool) {
        root.items[index].units = units;
        root.items[index].half-unit = half;
        root.items[index].width = MockupCatalog.unit-width(units, half);
        root.items[index].height = DeviceRackMetrics.face-height;
    }

    function nudge(dx: length, dy: length) {
        if (root.has-selection && !root.items[root.selected-index].locked) {
            root.items[root.selected-index].x = max(0px, root.items[root.selected-index].x + dx);
            root.items[root.selected-index].y = max(0px, root.items[root.selected-index].y + dy);
        }
    }

    VerticalBox {
        spacing: 0px;
        Rectangle {
            height: 40px;
            background: Theme.surface;
            HorizontalBox {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: "MOOLOOP / MOCKUP";
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle { width: 8px; }
                ToolButton {
                    text: "Snap";
                    width: 52px;
                    tooltip: "Snap to the grid (hold Alt while dragging to bypass)";
                    active: root.snap-enabled;
                    clicked => { root.snap-enabled = !root.snap-enabled; }
                }
                StepperField {
                    horizontal-stretch: 0;
                    label: "GRID";
                    tooltip: "Grid size";
                    value <=> root.grid-index;
                    minimum: 0;
                    maximum: root.grid-steps.length - 1;
                    display-text: round(root.grid-steps[root.grid-index] / 1px) + " px";
                    value-width: 36px;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.status-text;
                    color: Theme.text-faint;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                NameField {
                    horizontal-stretch: 0;
                    text <=> root.layout-name;
                    placeholder: "layout";
                    tooltip: "Layout name, saved under the UI settings directory";
                }
                ToolButton { text: "Load"; width: 52px; clicked => { root.load-requested(root.layout-name); } }
                ToolButton { text: "Save"; width: 52px; clicked => { root.save-requested(root.layout-name); } }
            }
        }

        HorizontalLayout {
            Rectangle {
                width: 190px;
                background: Theme.panel;
                VerticalBox {
                    padding: 6px;
                    spacing: 4px;
                    SegmentedControl {
                        height: 26px;
                        options: ["PALETTE", "LAYERS"];
                        selected-index <=> root.sidebar-tab;
                    }

                    if root.sidebar-tab == 0: SegmentedControl {
                        height: 26px;
                        options: ["Role", "Module", "A-Z"];
                        selected-index <=> root.palette-axis;
                        selected(i) => { root.palette-query-changed(); }
                    }
                    if root.sidebar-tab == 0: NameField {
                        width: 100%;
                        text <=> root.palette-filter;
                        placeholder: "Filter";
                        tooltip: "Filter the palette by name";
                        edited(t) => { root.palette-query-changed(); }
                    }
                    if root.sidebar-tab == 0: ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-right: 4px;
                            spacing: 1px;
                            for row in root.palette-rows: Rectangle {
                                height: row.header ? 22px : 26px;
                                if row.header: SectionLabel {
                                    x: 2px;
                                    y: 8px;
                                    text: row.label;
                                }
                                if !row.header: PaletteEntry {
                                    width: 100%;
                                    height: 100%;
                                    text: row.label;
                                    detail: row.detail;
                                    enabled: row.enabled;
                                    clicked => { root.add-item(row.kind); }
                                }
                            }
                            Rectangle { min-height: 4px; vertical-stretch: 1; }
                        }
                    }

                    // Top-most first, which is the array read backwards -
                    // no Rust-side display model needed for this one.
                    if root.sidebar-tab == 1: ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-right: 4px;
                            spacing: 1px;
                            for n in root.count: LayerRow {
                                property <int> idx: root.count - 1 - n;
                                text: MockupCatalog.kinds[root.items[self.idx].kind].name;
                                detail: root.items[self.idx].label;
                                locked: root.items[self.idx].locked;
                                selected: root.selected-index == self.idx;
                                clicked => { root.selected-index = self.idx; }
                            }
                            Rectangle { min-height: 4px; vertical-stretch: 1; }
                        }
                    }
                    if root.sidebar-tab == 1 && root.count == 0: Text {
                        text: "Nothing placed yet.";
                        color: Theme.text-faint;
                        font-size: 10px;
                        vertical-stretch: 1;
                    }
                }
            }

            canvas-keys := FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.Delete || e.text == Key.Backspace) {
                        if (root.has-selection) { root.remove-item(root.selected-index); }
                        accept
                    } else if (e.text == Key.LeftArrow) {
                        root.nudge(e.modifiers.shift ? -root.grid-step : -1px, 0px);
                        accept
                    } else if (e.text == Key.RightArrow) {
                        root.nudge(e.modifiers.shift ? root.grid-step : 1px, 0px);
                        accept
                    } else if (e.text == Key.UpArrow) {
                        root.nudge(0px, e.modifiers.shift ? -root.grid-step : -1px);
                        accept
                    } else if (e.text == Key.DownArrow) {
                        root.nudge(0px, e.modifiers.shift ? root.grid-step : 1px);
                        accept
                    } else if (e.modifiers.control && root.has-selection) {
                        if (e.text == "]") {
                            if (e.modifiers.shift) {
                                root.front-item(root.selected-index);
                            } else {
                                root.raise-item(root.selected-index);
                            }
                            accept
                        } else if (e.text == "[") {
                            if (e.modifiers.shift) {
                                root.back-item(root.selected-index);
                            } else {
                                root.lower-item(root.selected-index);
                            }
                            accept
                        } else {
                            reject
                        }
                    } else {
                        reject
                    }
                }

                canvas-scroll := ScrollView {
                    viewport-width: 1600px;
                    viewport-height: 1100px;
                    Rectangle {
                        width: 1600px;
                        height: 1100px;
                        background: Theme.background;

                        // Faint grid, purely a placement aid. Follows the snap
                        // setting so what is drawn is what a drag lands on.
                        for gx in root.grid-columns: Rectangle {
                            x: gx * root.grid-draw-step;
                            width: 1px;
                            height: 100%;
                            background: Theme.panel;
                        }
                        for gy in root.grid-rows: Rectangle {
                            y: gy * root.grid-draw-step;
                            height: 1px;
                            width: 100%;
                            background: Theme.panel;
                        }

                        background-touch := TouchArea {
                            clicked => { root.selected-index = -1; canvas-keys.focus(); }
                        }

                        for item[i] in root.items: PlacedItem {
                            item: item;
                            selected: root.selected-index == i;
                            select => { root.selected-index = i; canvas-keys.focus(); }
                            moved(dx, dy, bypass) => {
                                root.items[i].x = max(0px, root.snap(item.x + dx, bypass));
                                root.items[i].y = max(0px, root.snap(item.y + dy, bypass));
                            }
                            resized(dx, dy, bypass) => {
                                root.items[i].width = max(16px, root.snap(item.width + dx, bypass));
                                root.items[i].height = max(16px, root.snap(item.height + dy, bypass));
                            }
                            remove => { root.remove-item(i); }
                            value-changed(v) => { root.items[i].value = v; }
                            text-changed(t) => { root.items[i].text = t; }
                        }
                    }
                }
            }

            Rectangle {
                width: 240px;
                background: Theme.panel;
                if root.has-selection: ScrollView {
                    VerticalBox {
                        padding: 8px;
                        spacing: 10px;

                        PropertySection {
                            title: "IDENTITY";
                            Text {
                                text: root.selected-kind.name;
                                color: Theme.text;
                                font-size: 11px;
                            }
                            Text {
                                text: root.selected-kind.component + "  \u{2022}  "
                                    + root.selected-kind.module;
                                color: Theme.text-faint;
                                font-size: 8px;
                                overflow: elide;
                            }
                        }

                        PropertySection {
                            title: "GEOMETRY";
                            HorizontalLayout {
                                spacing: 4px;
                                StepperField {
                                    label: "X";
                                    value: root.items[root.selected-index].x / 1px;
                                    minimum: 0;
                                    maximum: 1600;
                                    step: root.grid-step / 1px;
                                    changed(v) => { root.items[root.selected-index].x = v * 1px; }
                                }
                                StepperField {
                                    label: "Y";
                                    value: root.items[root.selected-index].y / 1px;
                                    minimum: 0;
                                    maximum: 1100;
                                    step: root.grid-step / 1px;
                                    changed(v) => { root.items[root.selected-index].y = v * 1px; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                StepperField {
                                    label: "W";
                                    enabled: !root.selected-kind.device-units
                                        && !root.items[root.selected-index].locked;
                                    value: root.items[root.selected-index].width / 1px;
                                    minimum: 8;
                                    maximum: 1600;
                                    step: root.grid-step / 1px;
                                    changed(v) => { root.items[root.selected-index].width = v * 1px; }
                                }
                                StepperField {
                                    label: "H";
                                    enabled: !root.selected-kind.device-units
                                        && !root.items[root.selected-index].locked;
                                    value: root.items[root.selected-index].height / 1px;
                                    minimum: 8;
                                    maximum: 1100;
                                    step: root.grid-step / 1px;
                                    changed(v) => { root.items[root.selected-index].height = v * 1px; }
                                }
                            }
                        }

                        if root.selected-kind.device-units: PropertySection {
                            title: "RACK SIZE";
                            SegmentedControl {
                                height: 26px;
                                options: ["\u{00bd}U", "1U", "2U", "3U"];
                                selected-index: root.items[root.selected-index].half-unit
                                    ? 0 : root.items[root.selected-index].units;
                                selected(i) => {
                                    root.apply-units(root.selected-index, i == 0 ? 1 : i, i == 0);
                                }
                            }
                            Text {
                                text: round(root.items[root.selected-index].width / 1px) + " \u{00d7} "
                                    + round(root.items[root.selected-index].height / 1px) + " px";
                                color: Theme.text-faint;
                                font-size: 8px;
                            }
                        }

                        PropertySection {
                            title: "CONTENT";
                            NameField {
                                width: 100%;
                                text: root.items[root.selected-index].label;
                                placeholder: "Label";
                                tooltip: "Label";
                                edited(t) => { root.items[root.selected-index].label = t; }
                            }
                            if root.selected-kind.behavior >= 1 && root.selected-kind.behavior <= 3:
                            ParameterFader {
                                label: "VALUE";
                                width: 100%;
                                value: root.items[root.selected-index].value;
                                changed(v) => { root.items[root.selected-index].value = v; }
                            }
                            if root.selected-kind.behavior == 4: Rectangle {
                                height: 60px;
                                background: Theme.surface;
                                border-radius: Theme.radius-sm;
                                TextInput {
                                    x: 4px;
                                    y: 4px;
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    color: Theme.text;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                    single-line: false;
                                    text: root.items[root.selected-index].text;
                                    edited => { root.items[root.selected-index].text = self.text; }
                                }
                            }
                        }

                        PropertySection {
                            title: "ORDER";
                            HorizontalLayout {
                                spacing: 4px;
                                ToolButton {
                                    text: "\u{21c8}";
                                    tooltip: "Bring to front (Ctrl+Shift+])";
                                    clicked => { root.front-item(root.selected-index); }
                                }
                                ToolButton {
                                    text: "\u{2191}";
                                    tooltip: "Bring forward (Ctrl+])";
                                    clicked => { root.raise-item(root.selected-index); }
                                }
                                ToolButton {
                                    text: "\u{2193}";
                                    tooltip: "Send backward (Ctrl+[)";
                                    clicked => { root.lower-item(root.selected-index); }
                                }
                                ToolButton {
                                    text: "\u{21ca}";
                                    tooltip: "Send to back (Ctrl+Shift+[)";
                                    clicked => { root.back-item(root.selected-index); }
                                }
                            }
                            Text {
                                text: (root.selected-index + 1) + " of " + root.count;
                                color: Theme.text-faint;
                                font-size: 8px;
                            }
                        }

                        PropertySection {
                            title: "OPERATIONS";
                            HorizontalLayout {
                                spacing: 4px;
                                ToolButton {
                                    text: "Duplicate";
                                    clicked => { root.duplicate-item(root.selected-index); }
                                }
                                ToolButton {
                                    text: root.items[root.selected-index].locked ? "Unlock" : "Lock";
                                    tooltip: "A locked item still selects, but ignores move and resize";
                                    active: root.items[root.selected-index].locked;
                                    clicked => {
                                        root.items[root.selected-index].locked
                                            = !root.items[root.selected-index].locked;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                ToolButton {
                                    text: "Reset size";
                                    tooltip: "Back to the catalog's default size";
                                    clicked => {
                                        if (root.selected-kind.device-units) {
                                            root.apply-units(root.selected-index, 1, false);
                                        } else {
                                            root.items[root.selected-index].width
                                                = root.selected-kind.default-width;
                                            root.items[root.selected-index].height
                                                = root.selected-kind.default-height;
                                        }
                                    }
                                }
                                ToolButton {
                                    text: "Delete";
                                    text-color: Theme.destructive;
                                    clicked => { root.remove-item(root.selected-index); }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                if !root.has-selection: VerticalBox {
                    padding: 8px;
                    Text {
                        text: "Click a palette item to place it. Drag it to move, the corner dot to resize; hold Alt to ignore the snap grid. Arrow keys nudge, Shift+arrow by a grid step, Delete removes. Ctrl+] and Ctrl+[ reorder, with Shift for front and back. Hold Ctrl and drag a knob or fader to change its value, or Ctrl-click a button, toggle, or LED to fire it.";
                        color: Theme.text-faint;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
