import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton, MiniKnob, ToolButton, TrimKnob } from "controls.slint";
import { ChannelMeter } from "meters.slint";

export global DeviceRackMetrics {
    out property <length> unit-width: 220px;
    out property <length> half-gap: 4px;
    out property <length> face-height: 268px;
    out property <length> header-height: 28px;
    // The shared device shell owns these two narrow action rails. Faces keep
    // their working controls in the central rectangle, so future devices get
    // the same chain affordances without duplicating chrome.
    out property <length> rail-width: 30px;
    // The arrow between two rack rows. A constant here rather than a literal
    // in `main.slint` because the drag has to know a row's full pitch --
    // face, rails and join -- to open a gap the dragged row fits in.
    out property <length> join-width: 20px;
    // Vertical room around a face, and the height of the strip that holds
    // one. A container's box is drawn in this padding: it has to enclose the
    // faces rather than sit inside them, and four levels of nesting step
    // inward 5px each. `enclosure-reach` is short of the padding on purpose,
    // so the outermost box has a margin instead of running flush into the
    // rack panel's own edges and reading as a clip.
    out property <length> rack-padding: 20px;
    out property <length> enclosure-reach: 14px;
    out property <length> rack-height: root.face-height + root.rack-padding * 2;
}

// Live state of a rack reorder, written by the dragged row's header handle
// and read by every row.
//
// A global rather than properties threaded through the rack, because the two
// halves of a drag sit in different places and neither contains the other:
// the *grab* is in the device shell, which knows which row it is and nothing
// about the rack's geometry, and the *landing* is worked out by whichever row
// the pointer is currently over, which knows its own bounds and nothing about
// the grab.
export global RackDrag {
    // Rack index of the row being dragged, or -1.
    in-out property <int> source: -1;
    // Rack index the pointer is currently over. Set by the row itself from
    // its own bounds, so a four-unit face counts as four units wide -- the
    // reorder used to divide the pointer's travel by a nominal one-unit
    // pitch, which meant a drag past a wide device landed short of it.
    in-out property <int> target: -1;
    // Pointer travel since the grab, applied to the dragged row's face.
    //
    // Derived from window coordinates rather than from the handle's own
    // `mouse-x`, and that is not a preference. `mouse-x` is relative to the
    // touch area, the touch area rides on the face, and the face is what this
    // value moves -- so `mouse-x - pressed-x` measures the pointer against a
    // ruler the previous frame already slid, and reports each move's
    // increment instead of the travel. The face would twitch and stay put.
    // `absolute-position + mouse-x` is the pointer in window coordinates
    // whatever the element under it is doing.
    in-out property <length> dx: 0px;
    // Where the grab started and where the pointer is now, both in window
    // coordinates -- the frame every row's `absolute-position` is already in.
    in-out property <length> grab-x: 0px;
    in-out property <length> pointer-x: 0px;
    // Full pitch of the dragged row, which is the width of the gap the rows
    // between the grab and the landing open up.
    in-out property <length> source-width: 0px;
    in-out property <bool> active: false;

    public function end() {
        active = false;
        source = -1;
        target = -1;
        dx = 0px;
    }
}

// One nesting level of a container's box, drawn behind a row's face.
//
// This is the container's *own chrome, extended* -- the same surface, border
// and corner radius a device frame has, stretched across the whole run --
// rather than a separate coloured tray laid under it. The first cut was a
// tray in the accent colour and Adam's verdict on it was that it put green
// everywhere and still did not read as containment. It did not, and the
// reason is that a wash under a row of opaque cards is a *backdrop*: the
// cards stay cards, and a backdrop behind them says "these are related", not
// "these are inside".
//
// So the cards go instead. A contained `DeviceFrame` draws no background and
// no border (`DeviceFrame::contained`), and this draws the one that used to
// be theirs, once, around all of them. What is left inside is rails, headers
// and faces sitting directly on the container's surface -- which is what a
// device inside a device looks like.
//
// Each row draws its own slice and the caps close themselves: a row is the
// box's *head* when it is the container, and its right edge when the row
// after it is shallower. `docs/plans/containers/04` argued for stripes over a
// frame because "the rack is a horizontal sheet that wraps" -- it does not.
// `rack-row` is one `HorizontalLayout` in a horizontally scrolling viewport,
// so a run is always contiguous and a box is always one box.
export component ContainerEnclosure inherits Rectangle {
    in property <int> level;          // 1..4, outermost first
    in property <bool> head;          // this row is the container itself
    in property <bool> cap-right;     // the run ends here
    property <length> inset: (root.level - 1) * 5px;

    y: -DeviceRackMetrics.enclosure-reach + root.inset;
    height: DeviceRackMetrics.face-height
        + DeviceRackMetrics.enclosure-reach * 2 - root.inset * 2;
    // Nesting steps up the surface ramp rather than through a colour per
    // level: the ramp is already the app's depth vocabulary, and it does not
    // run out the way a palette of container colours would.
    background: root.level == 1 ? Theme.surface
        : root.level == 2 ? Theme.surface-raised
        : Theme.surface-active;
    property <color> line: Theme.text-faint;
    border-top-left-radius: root.head ? Theme.radius-md : 0;
    border-bottom-left-radius: root.head ? Theme.radius-md : 0;
    border-top-right-radius: root.cap-right ? Theme.radius-md : 0;
    border-bottom-right-radius: root.cap-right ? Theme.radius-md : 0;

    Rectangle { y: 0; width: parent.width; height: 1px; background: root.line; }
    Rectangle {
        y: parent.height - 1px; width: parent.width;
        height: 1px; background: root.line;
    }
    if root.head : Rectangle {
        x: 0; width: 1px; height: parent.height; background: root.line;
    }
    if root.cap-right : Rectangle {
        x: parent.width - 1px; width: 1px;
        height: parent.height; background: root.line;
    }
}

// One row in the effect-type picker (see EffectTypeMenu). Left-aligned,
// sized to its own label rather than a fixed column, since the menu itself
// grows to fit whichever entry is widest.
component EffectTypeRow inherits Rectangle {
    in property <string> text;
    in property <string> tooltip: root.text;
    callback selected;

    preferred-width: label.preferred-width + 20px;
    height: 22px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.surface-active : transparent;

    label := Text {
        x: 10px;
        text: root.text;
        color: Theme.text;
        font-size: 11px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }

    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// The effect-type list shared by every "insert effect" trigger (the rail
// `+` on each device, and the end-of-chain add slot). Kept as one
// component so the catalog is edited in a single place.
component EffectTypeMenu inherits VerticalLayout {
    callback kind-selected(int);
    padding: 4px;
    spacing: 1px;
    EffectTypeRow { text: "Filter"; tooltip: "Insert a low/high-pass filter"; selected => { root.kind-selected(0); } }
    EffectTypeRow { text: "Drive"; tooltip: "Insert saturation or distortion"; selected => { root.kind-selected(1); } }
    EffectTypeRow { text: "Bitcrush"; tooltip: "Insert bit and rate reduction"; selected => { root.kind-selected(2); } }
    EffectTypeRow { text: "Delay"; tooltip: "Insert a delay"; selected => { root.kind-selected(3); } }
    EffectTypeRow { text: "Gate"; tooltip: "Insert a noise gate"; selected => { root.kind-selected(4); } }
    EffectTypeRow { text: "Comp"; tooltip: "Insert a compressor"; selected => { root.kind-selected(5); } }
    EffectTypeRow { text: "Limiter"; tooltip: "Insert a limiter"; selected => { root.kind-selected(6); } }
    EffectTypeRow { text: "EQ"; tooltip: "Insert a parametric equalizer"; selected => { root.kind-selected(7); } }
    EffectTypeRow { text: "Reverb"; tooltip: "Insert a spacious feedback-delay-network hall"; selected => { root.kind-selected(8); } }
    EffectTypeRow { text: "Plate"; tooltip: "Insert a lightweight comb/allpass reverb"; selected => { root.kind-selected(10); } }
    EffectTypeRow { text: "Mod"; tooltip: "Insert chorus, flange, phaser, ensemble, or ADT"; selected => { root.kind-selected(9); } }
    EffectTypeRow { text: "Buffer"; tooltip: "Insert a retained-audio buffer"; selected => { root.kind-selected(11); } }
    // Not an effect: a container holds a run of the others and mixes it
    // against what went in. Last in the list because it is a different kind
    // of thing, and in the list at all because inserting one is how a chain
    // that has no devices yet gets its first box.
    EffectTypeRow { text: "Chain"; tooltip: "Insert a container to hold and blend a run of devices"; selected => { root.kind-selected(12); } }
}

export component DeviceFrame inherits Rectangle {
    in property <bool> insertion-enabled: true;
    in property <bool> removal-enabled: false;
    callback effect-kind-selected(int);
    callback remove-requested();
    // Per-device presets: the entries saved for this device's kind, offered
    // from the left rail. Generator and effect alike -- a preset's unit is a
    // device, so it is saved and loaded from the device rather than from a
    // toolbar above the chain. Off for a frame whose device has no preset
    // store of its own, which is the bus output stage.
    in property <bool> preset-enabled: false;
    in property <[string]> preset-options;
    callback preset-selected(int);   // index into preset-options
    callback save-preset-requested();
    in property <bool> bypassed: false;
    in property <bool> bypass-enabled: false;
    callback bypass-toggled();
    // Trims are dB from unity at both ends of every device, delivered by the
    // same TrimKnob class; the Rust boundary converts to linear gain.
    in property <bool> input-trim-enabled: false;
    in-out property <float> input-trim: 0;
    callback input-trim-changed(float);
    // The shell deliberately owns the narrow, always-in-the-same-place
    // controls from the device sketch. A face opts in only when its DSP has a
    // real parameter to receive the value; an absent control is preferable to
    // a convincing but inert one.
    in property <bool> output-trim-enabled: false;
    in-out property <float> output-trim: 0;
    callback output-trim-changed(float);
    in property <bool> wet-dry-enabled: false;
    in-out property <float> wet-dry: 1.0;
    in property <string> wet-dry-text: "100% wet";
    callback wet-dry-changed(float);
    // These are the currently edited chain endpoint's live bus readings. The
    // engine publishes a held peak per bus, so the frame never invents a
    // per-effect reading it cannot measure yet.
    in property <float> input-left-db: -60;
    in property <float> input-right-db: -60;
    in property <float> output-left-db: -60;
    in property <float> output-right-db: -60;
    out property <length> content-width: root.width - DeviceRackMetrics.rail-width * 2;

    // --- Containers -------------------------------------------------------
    //
    // Whether this row is a container, and how many rows are inside it.
    // Only the wording of three tooltips: the box around the run is drawn by
    // the rack cell, which is the only thing wide enough to hold it and the
    // only thing that can see the row after this one.
    in property <bool> is-container: false;
    in property <int> container-children: 0;
    in property <bool> wrap-enabled: false;
    in property <bool> unwrap-enabled: false;
    callback wrap-requested();
    callback unwrap-requested();
    // The device the keyboard's copy/cut/paste/duplicate act on. Drawn as the
    // frame's own border rather than as an overlay: the border is already
    // here, it is the one line that reads at a glance across a wrapped sheet
    // of devices, and it costs no layout.
    in property <bool> selected: false;
    in property <bool> duplicate-enabled: false;
    callback duplicate-requested();

    // A contained device has no card of its own: the container's chrome is
    // already drawn around it, so a second background and border inside that
    // one reads as a box in a box rather than a device in a container.
    in property <bool> contained: false;

    background: root.contained ? transparent : Theme.surface;
    border-width: root.selected ? 2px : (root.contained ? 0px : 1px);
    border-color: root.selected ? Theme.accent : Theme.border;
    border-radius: Theme.radius-md;
    clip: true;

    // These are deliberately a shell rather than a per-effect header: source,
    // inserts, and future buffer devices all get stable insertion/preset/mix
    // territory, in the same two rail positions whatever the device is.
    Rectangle {
        x: 0px;
        width: DeviceRackMetrics.rail-width;
        height: parent.height;
        background: Theme.surface-raised;
        Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.border; }
        VerticalLayout {
            padding: 2px;
            spacing: 2px;
            IconButton {
                text: "+"; size: 24px; enabled: root.insertion-enabled;
                tooltip: "Insert effect";
                clicked => { insert-menu.show(); }

                insert-menu := PopupWindow {
                    x: 0px;
                    y: parent.height + 2px;
                    width: menu-content.preferred-width;
                    height: menu-content.preferred-height;
                    close-policy: close-on-click;
                    Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-md;
                        menu-content := EffectTypeMenu {
                            kind-selected(kind) => {
                                insert-menu.close();
                                root.effect-kind-selected(kind);
                            }
                        }
                    }
                }
            }
            IconButton {
                text: "⌑"; size: 24px; enabled: root.preset-enabled;
                tooltip: "Save this device's settings as a preset";
                clicked => { root.save-preset-requested(); }
            }
            IconButton {
                text: "▱"; size: 24px;
                enabled: root.preset-enabled && root.preset-options.length > 0;
                tooltip: root.preset-options.length > 0
                    ? "Load a preset for this device"
                    : "No presets saved for this device yet";
                clicked => { preset-menu.show(); }
            }
            // Fourth deliberately, under the three that were here first:
            // `tests/effect_preset_menu.rs` drives this rail by computed
            // coordinates, and insert/save/load keeping theirs is worth more
            // than a container gesture being at the top.
            IconButton {
                text: "❏"; size: 24px; enabled: root.wrap-enabled;
                tooltip: "Wrap this device in a container";
                clicked => { root.wrap-requested(); }
            }
            // Fifth, under wrap, for the reason wrap is fourth: the preset
            // rail test drives this column by computed coordinates, so new
            // buttons go at the bottom.
            IconButton {
                text: "⧉"; size: 24px; enabled: root.duplicate-enabled;
                tooltip: root.is-container
                    ? "Duplicate this container and the " + root.container-children + " devices in it"
                    : "Duplicate this device";
                clicked => { root.duplicate-requested(); }
            }

            Rectangle { vertical-stretch: 1; }
            Text { text: "IN"; color: Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
            ChannelMeter {
                width: 22px;
                height: 58px;
                segments: 12;
                left-db: root.input-left-db;
                right-db: root.input-right-db;
                held-left-db: root.input-left-db;
                held-right-db: root.input-right-db;
            }
            if root.input-trim-enabled : Text { text: "TRIM"; color: Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
            if root.input-trim-enabled : TrimKnob {
                width: 22px;
                height: 22px;
                diameter: 22px;
                label: "Input trim";
                value <=> root.input-trim;
                changed(v) => { root.input-trim-changed(v); }
            }
        }
    }

    Rectangle {
        x: parent.width - DeviceRackMetrics.rail-width;
        width: DeviceRackMetrics.rail-width;
        height: parent.height;
        background: Theme.surface-raised;
        VerticalLayout {
            padding: 2px;
            spacing: 3px;
            IconButton {
                text: "✕"; size: 24px; enabled: root.removal-enabled;
                tooltip: root.is-container
                    ? "Remove this container and the " + root.container-children + " devices in it"
                    : "Remove device";
                clicked => { root.remove-requested(); }
            }
            // Only a container has one, and it is what makes "removing a box
            // removes its contents" safe to have: getting the devices back
            // out is one click rather than N drags.
            if root.unwrap-enabled : IconButton {
                text: "⇱"; size: 24px;
                tooltip: "Remove the container, keep what is inside it";
                clicked => { root.unwrap-requested(); }
            }
            Rectangle { vertical-stretch: 1; }
            Text { text: "OUT"; color: Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
            ChannelMeter {
                width: 22px; height: 58px; segments: 12;
                left-db: root.output-left-db; right-db: root.output-right-db;
                held-left-db: root.output-left-db; held-right-db: root.output-right-db;
            }
            if root.output-trim-enabled : Text { text: "TRIM"; color: Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
            if root.output-trim-enabled : TrimKnob {
                width: 22px;
                height: 22px;
                diameter: 22px;
                label: "Output trim";
                value <=> root.output-trim;
                changed(v) => { root.output-trim-changed(v); }
            }
        }
    }

    // Click-to-select on the header, for a device whose face is not an
    // `EffectDeviceShell` and so has no drag handle doing it already. That is
    // the generator: it heads the chain rather than sitting in it, so it can
    // be neither reordered nor contained -- but it is still the thing a rack
    // gesture can be *about*, and it was the one row a click could not name.
    //
    // Opt-in, because for an effect the shell's drag handle owns this press,
    // and two areas over the same pixels would mean one of them silently lost
    // it.
    in property <bool> header-select-enabled: false;
    callback header-clicked();
    if root.header-select-enabled : TouchArea {
        x: DeviceRackMetrics.rail-width;
        y: 0px;
        z: 90;
        width: root.width - DeviceRackMetrics.rail-width * 2 - 52px;
        height: DeviceRackMetrics.header-height;
        mouse-cursor: pointer;
        clicked => { root.header-clicked(); }
    }

    // Host controls live in the header, exactly where they can be compared
    // across a horizontal chain without stealing working area from a face.
    if root.bypass-enabled : IconButton {
        x: root.width - DeviceRackMetrics.rail-width - 52px;
        // IconButton's size property only sets its layout constraints.  This
        // control is absolutely positioned, so give the Rectangle a real box
        // as well; otherwise its active background fills the remaining face.
        y: 3px; z: 100; width: 22px; height: 22px; size: 22px;
        text: root.bypassed ? "○" : "●";
        active: !root.bypassed;
        tooltip: root.bypassed ? "Enable this device" : "Bypass this device";
        clicked => { root.bypass-toggled(); }
    }
    if root.wet-dry-enabled : MiniKnob {
        x: root.width - DeviceRackMetrics.rail-width - 26px;
        y: 3px;
        z: 100;
        width: 22px;
        diameter: 22px;
        label: "Wet/dry";
        value <=> root.wet-dry;
        default-value: 1.0;
        value-text: root.wet-dry-text;
        changed(v) => { root.wet-dry-changed(v); }
    }

    // The preset list, scrolled rather than grown, because this one fills
    // from disk: a user with forty saved filters must not get a menu taller
    // than the window. That is why it mirrors `MenuField` in the toolbar
    // instead of the insert menu above, whose entries are a fixed twelve.
    //
    // Placed beside the rail rather than over it, at the button's own y:
    // three 24px buttons from a 2px inset with 2px between them.
    preset-menu := PopupWindow {
        x: DeviceRackMetrics.rail-width;
        y: 80px;
        width: 220px;
        height: min(root.preset-options.length, 12) * 22px + 8px;
        close-policy: close-on-click;

        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;

            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                viewport-height: root.preset-options.length * 22px;
                VerticalLayout {
                    for option[i] in root.preset-options : Rectangle {
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: row-touch.has-hover ? Theme.surface-active : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: option;
                                color: Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            // Deliberately no `preset-menu.close()` before the
                            // callback: `close-policy` already dismisses the
                            // popup on this click, and closing it here first
                            // tears down the repeater item whose handler is
                            // still running, so the callback never lands.
                            // `MenuField` in the toolbar leaves it to the
                            // policy for the same reason.
                            clicked => { root.preset-selected(i); }
                        }

                    }
                }
            }
        }
    }

}


export component DeviceHeader inherits Rectangle {
    in property <string> name;
    in property <string> kind;
    // The preset these settings came from, shown beside the device name as
    // "Filter | Telephone". Empty when the row has not been loaded from one.
    in property <string> preset;
    in property <color> device-color: Theme.accent;
    in property <bool> enabled: true;
    // Right-edge role tag: "SOURCE" for generators, "FX" for effects.
    in property <string> role: "SOURCE";

    height: DeviceRackMetrics.header-height;
    background: Theme.surface-raised;
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
    HorizontalBox {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;
        Rectangle {
            width: 4px;
            height: 16px;
            border-radius: Theme.radius-sm;
            background: root.enabled ? root.device-color : Theme.text-faint;
        }
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: Theme.radius-lg;
            background: root.enabled ? root.device-color : Theme.text-faint;
        }
        Text {
            text: root.name;
            color: Theme.text;
            font-size: 11px;
            vertical-alignment: center;
        }
        if root.preset != "" : Text {
            text: "| " + root.preset;
            color: Theme.text-muted;
            font-size: 10px;
            vertical-alignment: center;
            // A long preset name must not push the kind tag and the role off
            // the end of a 220px rack unit.
            max-width: 104px;
            overflow: elide;
        }
        Text {
            text: root.kind;
            color: Theme.text-faint;
            font-size: 8px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.role;
            color: Theme.text-faint;
            font-size: 8px;
            vertical-alignment: center;
        }
    }
}

// Shared shell for every effect face: the header strip (name, kind tag,
// bypass state) plus drag-to-reorder on the header. The face's working
// controls are its @children, painted below the header. Adding an effect
// kind means writing only its controls inside this shell; the chrome is
// inherited, not repeated. Bypass/remove live on the host DeviceFrame
// around the face, not in here.
export component EffectDeviceShell inherits Rectangle {
    in property <string> name;
    in property <string> kind;
    in property <int> slot-index;
    in property <int> slot-count;
    in property <bool> bypassed;
    // Forwarded to the header. Every face inherits this shell, so a face
    // gets the preset label without knowing anything about presets.
    in property <string> preset-name;
    callback reorder-requested(int);  // target slot index
    // A press on the header that did not move far enough to be a reorder.
    // Selection rides on the drag handle rather than getting a TouchArea of
    // its own because the two gestures start identically, and a second area
    // over the same pixels would have to win or lose the press outright.
    callback select-requested();

    // Modulation state for every effect face, indexed by descriptor id so a
    // knob reads its own overlay with the same stable number it already uses
    // to address the parameter. Declared once here rather than per face:
    // every device in the rack answers the same assignment contract, and the
    // ids mirror the `*_PARAM_*` constants in mooloop-core.
    in property <bool> modulation-armed;
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);

    @children

    DeviceHeader {
        x: 0px;
        y: 0px;
        width: parent.width;
        name: root.name;
        kind: root.kind;
        preset: root.preset-name;
        role: "FX";
        device-color: Theme.warning;
        enabled: !root.bypassed;

    }

    // Drag-to-reorder handle: covers the header left of the host frame's
    // bypass/wet-dry controls.
    //
    // This publishes the grab into `RackDrag` and reads the landing back out
    // of it. It does not work the landing out itself, and that is the fix
    // rather than an indirection: it used to divide the pointer's travel by
    // `unit-width + 20px`, a *nominal* one-unit pitch, so dragging across a
    // four-unit EQ or a two-unit compressor landed short of it by the
    // difference. The rack's rows now report which one the pointer is over
    // from their own bounds, which is right for any width.
    drag := TouchArea {
        x: 0px;
        y: 0px;
        z: 10;
        width: parent.width - 52px;
        height: DeviceRackMetrics.header-height;
        mouse-cursor: move;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                RackDrag.source = root.slot-index;
                RackDrag.target = root.slot-index;
                RackDrag.dx = 0px;
                // Seeded here as well as in `moved`, so the rows do not
                // decide who is under the pointer from the last drag's
                // position before this one has moved at all.
                RackDrag.grab-x = self.absolute-position.x + self.mouse-x;
                RackDrag.pointer-x = RackDrag.grab-x;
                // Face, both rails and the join: the pitch of a whole row,
                // which is the width of the gap the rows in between open.
                RackDrag.source-width = root.width
                    + DeviceRackMetrics.rail-width * 2
                    + DeviceRackMetrics.join-width;
                RackDrag.active = true;
            }
            if event.kind == PointerEventKind.up {
                // A press that never left this row is a selection. No
                // distance threshold: the row under the pointer *is* the
                // answer, so staying on your own row already means "no
                // move" however far the pointer wandered inside it.
                if RackDrag.target != root.slot-index && RackDrag.target >= 0 {
                    root.reorder-requested(clamp(RackDrag.target, 0, root.slot-count - 1));
                } else {
                    root.select-requested();
                }
                RackDrag.end();
            }
        }
        moved => {
            RackDrag.pointer-x = self.absolute-position.x + self.mouse-x;
            RackDrag.dx = RackDrag.pointer-x - RackDrag.grab-x;
        }
    }
}

export component DeviceJoin inherits Rectangle {
    width: 20px;
    height: DeviceRackMetrics.face-height;
    Text {
        text: "\u{2192}";
        color: Theme.text-muted;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component DeviceAddSlot inherits Rectangle {
    callback kind-selected(int);
    in property <bool> enabled: true;
    width: 50px;
    height: DeviceRackMetrics.face-height;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;
    background: add-touch.has-hover && root.enabled ? Theme.surface : transparent;
    Text {
        text: "+";
        color: root.enabled ? Theme.text-muted : Theme.text-faint;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    add-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { insert-menu.show(); }
    }
    Tooltip { text: @markdown("Add a device"); }

    insert-menu := PopupWindow {
        x: 0px;
        y: parent.height + 2px;
        width: menu-content.preferred-width;
        height: menu-content.preferred-height;
        close-policy: close-on-click;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            menu-content := EffectTypeMenu {
                kind-selected(kind) => {
                    insert-menu.close();
                    root.kind-selected(kind);
                }
            }
        }
    }
}

export component DevicePageButton inherits ToolButton {
    min-width: 52px;
    max-width: 76px;
    min-height: 22px;
    max-height: 22px;
}
