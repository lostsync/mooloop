import { Theme } from "theme.slint";
import { ParameterKnob, SelectorBank, TrimKnob } from "controls.slint";
import { GainMath } from "gain.slint";
import { OscillatorTrace } from "device-displays.slint";

// The three-oscillator front end all three synth faces share. Defined once
// here rather than copied into each face: it was duplicated verbatim between
// the mono and poly faces, which is two places to fix a knob and two places
// for them to drift apart.
export component OscillatorDeviceStrip inherits Rectangle {
    in property <string> title;
    in-out property <int> wave;
    in-out property <float> semitones;
    in-out property <float> cents;
    in-out property <float> level;
    in-out property <float> pulse-width;
    callback wave-changed(int);
    callback semitones-changed(float);
    callback cents-changed(float);
    callback level-changed(float);
    callback pulse-width-changed(float);
    // Oscillator parameter ids are `100 + oscillator * 10 + offset`
    // (`synth_osc_param` in mooloop-core), so the strip takes its own base and
    // derives each knob's destination from it rather than being written out
    // three times.
    in property <int> param-base;
    in property <bool> modulation-armed;
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);

    background: Theme.panel;
    border-radius: Theme.radius-sm;
    VerticalLayout {
        padding: 5px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 4px;
            Text { text: root.title; color: Theme.text-muted; font-size: 9px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            SelectorBank {
                options: ["S", "T", "W", "P"];
                selected-index <=> root.wave;
                segment-width: 30px;
                tooltip: "Oscillator waveform";
                selected(i) => { root.wave-changed(i); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 28px;
            OscillatorTrace {
                x: 5px; y: 4px; width: parent.width - 10px; height: parent.height - 8px;
                wave: root.wave;
                semitones: root.semitones;
                cents: root.cents;
                level: root.level;
                pulse-width: root.pulse-width;
            }
        }
        HorizontalLayout {
            spacing: 0px;
            ParameterKnob {
                width: 48px; diameter: 36px; label: "Semi"; tooltip: "Coarse tuning";
                value <=> root.semitones; minimum: -48; maximum: 48; default-value: 0; step: 1;
                value-text: (root.semitones > 0 ? "+" : "") + round(root.semitones) + " st";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[root.param-base + 1];
                modulation-depth: root.modulation-depths[root.param-base + 1];
                modulation-offset: root.modulation-offsets[root.param-base + 1];
                modulation-route-count: root.modulation-route-counts[root.param-base + 1];
                changed(v) => { root.semitones-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(root.param-base + 1, v); }
                modulation-edit-started => { root.modulation-edit-started(root.param-base + 1); }
                modulation-edit-finished => { root.modulation-edit-finished(root.param-base + 1); }
            }
            ParameterKnob {
                width: 48px; diameter: 36px; label: "Fine"; tooltip: "Fine tuning";
                value <=> root.cents; minimum: -100; maximum: 100; default-value: 0; step: 1;
                value-text: (root.cents > 0 ? "+" : "") + round(root.cents) + " ct";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[root.param-base + 2];
                modulation-depth: root.modulation-depths[root.param-base + 2];
                modulation-offset: root.modulation-offsets[root.param-base + 2];
                modulation-route-count: root.modulation-route-counts[root.param-base + 2];
                changed(v) => { root.cents-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(root.param-base + 2, v); }
                modulation-edit-started => { root.modulation-edit-started(root.param-base + 2); }
                modulation-edit-finished => { root.modulation-edit-finished(root.param-base + 2); }
            }
            TrimKnob {
                width: 48px; diameter: 36px; label: "Level";
                value: GainMath.linear-to-db(root.level);
                maximum: 0;
                default-value: -60;
                changed(v) => {
                    // The knob works in dB but `level` is the stored linear
                    // value; restate it so the scope and the face property
                    // track the drag immediately instead of waiting for the
                    // engine's params to come back.
                    root.level = GainMath.db-to-linear(v);
                    root.level-changed(root.level);
                }
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[root.param-base + 3];
                modulation-depth: root.modulation-depths[root.param-base + 3];
                modulation-offset: root.modulation-offsets[root.param-base + 3];
                modulation-route-count: root.modulation-route-counts[root.param-base + 3];
                modulation-depth-changed(v) => { root.modulation-depth-changed(root.param-base + 3, v); }
                modulation-edit-started => { root.modulation-edit-started(root.param-base + 3); }
                modulation-edit-finished => { root.modulation-edit-finished(root.param-base + 3); }
            }
            ParameterKnob {
                width: 48px; diameter: 36px; label: "Width"; tooltip: "Pulse width";
                value <=> root.pulse-width; minimum: 0.05; maximum: 0.95; default-value: 0.5;
                enabled: root.wave == 3;
                value-text: round(root.pulse-width * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[root.param-base + 4];
                modulation-depth: root.modulation-depths[root.param-base + 4];
                modulation-offset: root.modulation-offsets[root.param-base + 4];
                modulation-route-count: root.modulation-route-counts[root.param-base + 4];
                changed(v) => { root.pulse-width-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(root.param-base + 4, v); }
                modulation-edit-started => { root.modulation-edit-started(root.param-base + 4); }
                modulation-edit-finished => { root.modulation-edit-finished(root.param-base + 4); }
            }
        }
    }
}
