import { Theme } from "theme.slint";
import { GainMath } from "gain.slint";
import { Icons } from "icons.slint";
import { AudioOrientation, MuteButton, ParameterKnob, PeakMeter, SoloButton, ToolButton, TrimKnob } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";
import { ReorderMath } from "reorder.slint";

// The layer's sizes. The face is as wide as what it holds -- the branch list
// beside the selected branch's controls -- and not a count of rack units
// (Adam, 2026-09-30); the rack sizes a layer's cell from `face-width`.
export global LayerMetrics {
    out property <length> padding: 6px;
    out property <length> list-width: 150px;
    out property <length> controls-width: 124px;
    out property <length> face-width:
        root.list-width + root.controls-width + root.padding * 3;
    // The layer's own Gain and Mix, at the far end of its box: after the
    // devices of the branch it shows, before its output rail.
    out property <length> end-width: 64px;
    // One branch row: 22px at 100%, growing with the text above it (MOO-333,
    // the rule MOO-278 gave menu rows). The list is a layout of these with
    // `row-spacing` between, so its pitch, which a drag steps by, follows.
    out property <length> row-height: 22px * Theme.row-growth;
    out property <length> row-spacing: 1px;
}

// Live state of a branch row being dragged along its layer's list. A global
// for `RackDrag`'s reason (`reorder.slint`): the rows that slide aside are
// not inside the one being carried. `layer` scopes it, since two layers'
// lists can be on screen at once and must not slide each other's rows.
export global BranchDrag {
    in-out property <int> layer: -1;
    in-out property <int> source: -1;
    in-out property <int> target: -1;
    in-out property <length> dy;
}

// One branch of a layer, as the layer's face lists it. `slot` is the rack
// index of the branch's head -- the number every callback about the branch
// wants -- and not the row's position in the list, which is the `lvl`/`level`
// trap `docs/plans/archive/containers/09` warns about.
export struct LayerBranchRow {
    slot: int,
    // The branch's preset name if it has one, otherwise the first device
    // inside it, otherwise its kind. Worked out in Rust.
    name: string,
    // Whether the head is a container, which is what has Level, Mute and
    // Solo. A leaf directly inside a layer sums at unity with no switches.
    controls: bool,
}

// One row of the branch list: the name, a badge when the branch is
// bypassed, S, M and a level meter, in Bitwig's FX Layer order. The row's
// state is the branch head's own row, read by the caller from `effect-slots`,
// so nothing here is a copy that has to be republished when the branch
// changes. Dragging the row along the list moves the branch.
export component LayerBranchListRow inherits Rectangle {
    in property <string> name;
    in property <bool> controls;
    in property <bool> selected;
    in property <bool> muted;
    in property <bool> soloed;
    // The branch head is bypassed: it passes its input on dry, so it is not
    // silent, and a badge says so rather than the dimming that means muted.
    in property <bool> bypassed;
    in property <float> level-db: GainMath.min-db;
    // The layer's rack index, which scopes the drag to this list, and the
    // row's place in it and the list's length, which bound where it lands.
    in property <int> layer: -1;
    in property <int> index;
    in property <int> count;
    callback select-requested();
    callback mute-toggled();
    callback solo-toggled();
    // The row was dropped at this place in the list, counting from 0.
    callback move-requested(int);
    // The row's menu: take the branch and everything in it out of the layer.
    callback remove-requested();

    property <bool> dragging: BranchDrag.layer == root.layer && BranchDrag.source == root.index;
    property <length> pitch: LayerMetrics.row-height + LayerMetrics.row-spacing;
    // Remove-then-insert, as every list here reorders: the rows the carried
    // one passes close up behind it, and the gap is where it will land.
    property <length> offset: root.dragging
        ? BranchDrag.dy
        : BranchDrag.layer == root.layer
            ? ReorderMath.shift(root.index, BranchDrag.source, BranchDrag.target, root.pitch)
            : 0px;

    height: LayerMetrics.row-height;

    // The press, the drag and the menu. Not inside `body`, which moves with
    // the drag: an area that moved under its own pointer would measure the
    // drag against itself.
    pick := TouchArea {
        // Whether this press has turned into a drag, so its release is a
        // drop and not a click.
        property <bool> carried;
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                branch-menu.show();
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                self.carried = false;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && self.carried) {
                if (BranchDrag.target >= 0 && BranchDrag.target != root.index) {
                    root.move-requested(BranchDrag.target);
                }
                BranchDrag.source = -1;
                BranchDrag.target = -1;
                BranchDrag.layer = -1;
                BranchDrag.dy = 0px;
            }
        }
        moved => {
            if (self.pressed && !self.carried && abs(self.mouse-y - self.pressed-y) > 4px) {
                self.carried = true;
                BranchDrag.layer = root.layer;
                BranchDrag.source = root.index;
                BranchDrag.target = root.index;
            }
            if (self.carried) {
                BranchDrag.dy = self.mouse-y - self.pressed-y;
                BranchDrag.target = max(0, min(root.count - 1,
                    root.index + round(BranchDrag.dy / root.pitch)));
            }
        }
        clicked => {
            if (!self.carried) {
                root.select-requested();
            }
        }
    }

    branch-menu := PopupWindow {
        x: 0px;
        y: parent.height;
        // 140px, or wider when its row needs it (MOO-326, the rule MOO-278
        // gave the other menus): at a large text size "Remove branch" is.
        width: max(140px, menu-frame.preferred-width);
        height: menu-frame.preferred-height;
        close-policy: close-on-click;
        menu-frame := Rectangle {
            background: Theme.surface;
            border-width: Theme.hairline;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            VerticalLayout {
                padding: 4px;
                Rectangle {
                    // 22px at 100%, growing with the text above it (MOO-326);
                    // the popup takes its height from this layout and its
                    // width from this row's, so it grows with the row.
                    height: 22px * Theme.row-growth;
                    preferred-width: remove-label.preferred-width + 20px;
                    border-radius: Theme.radius-md;
                    background: remove-touch.has-hover ? Theme.surface-active : transparent;
                    remove-label := Text {
                        x: 10px;
                        text: "Remove branch";
                        color: Theme.text;
                        font-size: Theme.text-xl;
                        vertical-alignment: center;
                    }
                    remove-touch := TouchArea {
                        mouse-cursor: pointer;
                        // The callback first and the close after: closing
                        // tears this row down, and a handler written after
                        // `close()` never lands (`dupe-audit popup-close-order`).
                        clicked => {
                            root.remove-requested();
                            branch-menu.close();
                        }
                    }
                }
            }
        }
    }

    body := Rectangle {
        y: root.offset;
        height: root.height;
        border-radius: Theme.radius-sm;
        background: root.dragging || root.selected ? Theme.surface-raised : transparent;
        drop-shadow-blur: root.dragging ? 8px : 0px;
        drop-shadow-color: #000000aa;

        // The selected row wears the bracket's colour on its left edge: it is
        // the branch the rack is showing to the right.
        if root.selected : Rectangle {
            x: 0px;
            width: 2px;
            height: parent.height;
            background: Theme.accent;
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 2px;
            spacing: 2px;
            alignment: stretch;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                text: root.name;
                color: root.muted ? Theme.text-faint : root.selected ? Theme.text : Theme.text-muted;
                font-size: Theme.text-md;
            }
            if root.bypassed : VerticalLayout {
                alignment: center;
                Rectangle {
                    width: byp.preferred-width + 6px;
                    height: byp.preferred-height + 2px;
                    border-radius: Theme.radius-sm;
                    border-width: Theme.hairline;
                    border-color: Theme.warning;
                    byp := Text {
                        text: "BYP";
                        color: Theme.warning;
                        font-size: Theme.text-xs;
                        letter-spacing: 0.5px;
                    }
                }
            }
            if root.controls : VerticalLayout {
                alignment: center;
                SoloButton {
                    soloed: root.soloed;
                    tooltip: "Solo this branch within the layer";
                    clicked => { root.solo-toggled(); }
                }
            }
            if root.controls : VerticalLayout {
                alignment: center;
                MuteButton {
                    muted: root.muted;
                    tooltip: "Mute this branch";
                    clicked => { root.mute-toggled(); }
                }
            }
            VerticalLayout {
                padding-top: 3px;
                padding-bottom: 3px;
                PeakMeter {
                    width: 5px;
                    min-height: 0px;
                    orientation: AudioOrientation.vertical;
                    level-db: root.level-db;
                    held-db: root.level-db;
                }
            }
        }
    }
}

// The selected branch's controls, beside the list: what its Chain's face and
// rails offered before a branch stopped being drawn as a device -- Level and
// Mix, bypass, input and output trim, and its presets. Every value is the
// branch head's own row; every callback is the caller's to send to it.
export component LayerBranchControls inherits Rectangle {
    // A Chain branch is selected. A bare device straight in the layer has
    // none of these: its own face is in the rack.
    in property <bool> available;
    in property <string> name;
    // Normalized fader travel through the mixer's taper (`ParamCurve::Fader`,
    // 0.75 is unity), and Mix a ratio: the Chain's own parameters 1 and 0.
    in-out property <float> branch-level: 0.75;
    in-out property <float> branch-mix: 1.0;
    in property <bool> bypassed;
    // dB from unity, as every trim in the rack.
    in-out property <float> input-trim-db;
    in-out property <float> output-trim-db;
    in property <[string]> preset-options;
    in property <string> preset-name;
    callback level-changed(float);
    callback mix-changed(float);
    callback bypass-toggled();
    callback input-trim-changed(float);
    callback output-trim-changed(float);
    // An index into `preset-options`.
    callback preset-selected(int);
    callback save-preset-requested();

    background: Theme.panel;
    border-radius: Theme.radius-sm;

    if !root.available : Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: center;
        wrap: word-wrap;
        text: "No branch to set";
        color: Theme.text-faint;
        font-size: Theme.text-md;
    }

    if root.available : VerticalLayout {
        padding: 6px;
        spacing: 6px;
        alignment: start;

        HorizontalLayout {
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                text: root.name;
                color: Theme.text;
                font-size: Theme.text-md;
            }
            ToolButton {
                width: 22px;
                height: 18px;
                icon: Icons.on;
                active: !root.bypassed;
                tooltip: root.bypassed ? "Enable" : "Bypass";
                hint: root.bypassed ? "Enable this branch" : "Bypass this branch: its input passes on dry";
                clicked => { root.bypass-toggled(); }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            ParameterKnob {
                width: 56px;
                diameter: 34px;
                label: "Level";
                tooltip: "Level of this branch, before it is summed";
                value <=> root.branch-level;
                default-value: 0.75;
                value-text: GainMath.format-db(GainMath.fader-position-to-db(root.branch-level));
                changed(v) => { root.level-changed(v); }
            }
            ParameterKnob {
                width: 56px;
                diameter: 34px;
                label: "Mix";
                tooltip: "Dry/wet across this branch";
                value <=> root.branch-mix;
                default-value: 1.0;
                value-text: round(root.branch-mix * 100) + "%";
                changed(v) => { root.mix-changed(v); }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: center;
            VerticalLayout {
                spacing: 2px;
                Text { text: "IN"; color: Theme.text-faint; font-size: Theme.text-xs; horizontal-alignment: center; }
                TrimKnob {
                    width: 22px;
                    height: 22px;
                    diameter: 22px;
                    label: "Input trim";
                    value <=> root.input-trim-db;
                    changed(v) => { root.input-trim-changed(v); }
                }
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: "OUT"; color: Theme.text-faint; font-size: Theme.text-xs; horizontal-alignment: center; }
                TrimKnob {
                    width: 22px;
                    height: 22px;
                    diameter: 22px;
                    label: "Output trim";
                    value <=> root.output-trim-db;
                    changed(v) => { root.output-trim-changed(v); }
                }
            }
        }

        HorizontalLayout {
            spacing: 4px;
            ToolButton {
                height: 18px;
                horizontal-stretch: 1;
                text: "Save";
                tooltip: "Save preset";
                hint: "Save this branch as a Chain preset";
                clicked => { root.save-preset-requested(); }
            }
            ToolButton {
                height: 18px;
                horizontal-stretch: 1;
                text: "Load";
                enabled: root.preset-options.length > 0;
                tooltip: root.preset-options.length > 0
                    ? "Load a Chain preset into this branch"
                    : "No Chain presets saved yet";
                clicked => { preset-menu.show(); }
            }
        }
        if root.preset-name != "" : Text {
            text: root.preset-name;
            overflow: elide;
            color: Theme.text-muted;
            font-size: Theme.text-sm;
        }
    }

    // The branch's presets, scrolled rather than grown, as the rail's list
    // is: it fills from disk.
    preset-menu := PopupWindow {
        x: 0px;
        y: parent.height - self.height;
        width: 200px;
        property <length> row-height: 22px * Theme.row-growth;
        height: min(root.preset-options.length, 10) * self.row-height + 8px;
        close-policy: close-on-click;

        Rectangle {
            background: Theme.surface;
            border-width: Theme.hairline;
            border-color: Theme.border;
            border-radius: Theme.radius-md;

            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                content-height: root.preset-options.length * preset-menu.row-height;
                VerticalLayout {
                    for option[i] in root.preset-options : Rectangle {
                        height: preset-menu.row-height;
                        border-radius: Theme.radius-sm;
                        background: row-touch.has-hover ? Theme.surface-active : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: option;
                                color: Theme.text-muted;
                                font-size: Theme.text-xl;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            // No `close()` here: `close-policy` dismisses the
                            // popup on this click, and closing it first would
                            // tear down this row while its handler is still
                            // running (`dupe-audit popup-close-order`).
                            clicked => { root.preset-selected(i); }
                        }
                    }
                }
            }
        }
    }
}

// The layer's face (`docs/plans/archive/containers/09`, after Bitwig's FX Layer):
// the list of its branches with `+` under it, and the selected branch's
// controls beside it. The layer's own Gain and Mix are `LayerEndPanel`, at
// the far end of its box. The rows are the caller's children, because each
// reads its branch head's row out of the rack model, which a face cannot see;
// so are the controls' values, for the same reason.
export component LayerDeviceFace inherits EffectDeviceShell {
    kind: "FX";
    in property <int> branch-count;
    in property <bool> branch-available;
    in property <string> branch-name;
    in property <float> branch-level: 0.75;
    in property <float> branch-mix: 1.0;
    in property <bool> branch-bypassed;
    in property <float> branch-input-trim-db;
    in property <float> branch-output-trim-db;
    in property <[string]> branch-preset-options;
    in property <string> branch-preset-name;
    callback add-branch-requested();
    callback branch-level-changed(float);
    callback branch-mix-changed(float);
    callback branch-bypass-toggled();
    callback branch-input-trim-changed(float);
    callback branch-output-trim-changed(float);
    callback branch-preset-selected(int);
    callback branch-save-preset-requested();

    HorizontalLayout {
        padding: LayerMetrics.padding;
        padding-top: DeviceRackMetrics.header-height + LayerMetrics.padding;
        spacing: LayerMetrics.padding;

        Rectangle {
            width: LayerMetrics.list-width;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            clip: true;

            VerticalLayout {
                padding: 3px;
                spacing: LayerMetrics.row-spacing;
                alignment: start;
                @children
                if root.branch-count == 0 : Text {
                    height: LayerMetrics.row-height;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    text: "no branches";
                    color: Theme.text-faint;
                    font-size: Theme.text-md;
                }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 3px;
                    ToolButton {
                        text: "+";
                        tooltip: "Add a branch";
                        width: 22px;
                        height: 18px;
                        clicked => { root.add-branch-requested(); }
                    }
                }
            }
        }

        LayerBranchControls {
            width: LayerMetrics.controls-width;
            available: root.branch-available;
            name: root.branch-name;
            branch-level: root.branch-level;
            branch-mix: root.branch-mix;
            bypassed: root.branch-bypassed;
            input-trim-db: root.branch-input-trim-db;
            output-trim-db: root.branch-output-trim-db;
            preset-options: root.branch-preset-options;
            preset-name: root.branch-preset-name;
            level-changed(v) => { root.branch-level-changed(v); }
            mix-changed(v) => { root.branch-mix-changed(v); }
            bypass-toggled => { root.branch-bypass-toggled(); }
            input-trim-changed(v) => { root.branch-input-trim-changed(v); }
            output-trim-changed(v) => { root.branch-output-trim-changed(v); }
            preset-selected(i) => { root.branch-preset-selected(i); }
            save-preset-requested => { root.branch-save-preset-requested(); }
        }
    }
}

// The layer's own Gain and Mix, standing at the far end of its box: after the
// devices of the branch it shows, before its output rail, so the controls
// that act on the summed branches sit where the sum comes out.
export component LayerEndPanel inherits Rectangle {
    // Normalized 0..1: Mix is a ratio, and Gain is fader travel through the
    // mixer's taper (`ParamCurve::Fader`).
    in-out property <float> mix;
    in-out property <float> gain;
    callback mix-changed(float);
    callback gain-changed(float);

    width: LayerMetrics.end-width;

    VerticalLayout {
        padding-top: DeviceRackMetrics.header-height + LayerMetrics.padding;
        padding-bottom: LayerMetrics.padding;
        spacing: 6px;
        alignment: start;
        Text {
            text: "LAYER";
            horizontal-alignment: center;
            color: Theme.text-faint;
            font-size: Theme.text-xs;
            letter-spacing: 0.5px;
        }
        HorizontalLayout {
            alignment: center;
            ParameterKnob {
                width: 56px;
                diameter: 34px;
                label: "Gain";
                tooltip: "The summed branches' level, before Mix";
                value <=> root.gain;
                // Unity: three-quarter travel on the mixer's taper. A literal
                // so `slint_face_agreement.rs` can hold it to the table.
                default-value: 0.75;
                value-text: GainMath.format-db(GainMath.fader-position-to-db(root.gain));
                changed(v) => { root.gain-changed(v); }
            }
        }
        HorizontalLayout {
            alignment: center;
            ParameterKnob {
                width: 56px;
                diameter: 34px;
                label: "Mix";
                tooltip: "Dry/wet across the whole layer";
                value <=> root.mix;
                default-value: 1.0;
                value-text: round(root.mix * 100) + "%";
                changed(v) => { root.mix-changed(v); }
            }
        }
    }
}

// The bar over the branch a layer is showing, one slice per row the way
// `ContainerEnclosure` is drawn: the first row turns its left end down and
// the last its right, so the slices read as one bracket over the branch.
// Drawn in the rack's top padding, above the enclosures.
export component LayerBracket inherits Rectangle {
    in property <bool> start;
    in property <bool> end;
    property <length> thickness: 3px;
    property <length> drop: 6px;

    y: -DeviceRackMetrics.rack-padding + 2px;
    height: root.thickness + root.drop;

    Rectangle {
        y: 0px;
        width: parent.width;
        height: root.thickness;
        background: Theme.accent;
        border-top-left-radius: root.start ? 2px : 0px;
        border-top-right-radius: root.end ? 2px : 0px;
    }
    if root.start : Rectangle {
        x: 0px;
        width: root.thickness;
        height: root.thickness + root.drop;
        background: Theme.accent;
    }
    if root.end : Rectangle {
        x: parent.width - root.thickness;
        width: root.thickness;
        height: root.thickness + root.drop;
        background: Theme.accent;
    }
}
