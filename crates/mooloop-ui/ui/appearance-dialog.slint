import { ComboBox, HorizontalBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";
import { Theme, Motion, StatusHint } from "theme.slint";
import { MeterPrefs } from "meters.slint";
import { AudioOrientation, IconButton, ParameterFader, SectionLabel, SegmentedControl, ToggleButton, ToolButton } from "controls.slint";
import { AudioDriverCopy, DriverControlSurface, OutputTargetRow } from "audio-preferences.slint";
// The swatch rows beside the colour fields offer colours from the scheme in
// force, so they use the same `ColorChoice` the channel picker does -- one
// struct, because both halves of it come from Rust for the same reason: Slint
// cannot turn a hex string into a colour.
import { ColorChoice } from "color-picker.slint";
export { AudioDriverCopy, OutputTargetRow }

// One selectable theme in Preferences > Appearance. The three colours are the
// variant the current mode resolves to, so the list repaints when Light/Dark/
// Auto moves and a row shows what choosing it would actually do.
//
// They are colours rather than hex strings because Slint cannot turn a hex
// string into a colour -- Rust sends the text it round-trips and the swatch
// colour to draw, and this struct is where the two meet.
export struct AppearanceSchemeRow {
    name: string,
    description: string,
    base: color,
    accent: color,
    alert: color,
    is-user: bool,
    // The variant on this side of the light/dark line was worked out rather
    // than written down. Said out loud because a derived Snow Storm is not
    // Snow Storm.
    derived: bool,
}


// Label, quick swatches, and a hex field for one seed color. Every path here
// writes `value` and then raises `changed`, so the caller has a single place
// to push a live preview from.
component ColorField inherits VerticalBox {
    in property <string> label;
    in property <string> description;
    in property <[ColorChoice]> choices;
    in-out property <string> value;
    in property <color> resolved;
    callback changed();

    padding: 0px;
    spacing: 2px;

    HorizontalBox {
        padding: 0px;
        spacing: 6px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.text-xl;
            vertical-alignment: center;
            width: 54px;
        }
        for choice in root.choices : Rectangle {
            width: 22px;
            height: 22px;
            border-radius: Theme.radius-md;
            background: choice.tint;
            border-width: choice.value == root.value ? Theme.stroke-emphasis : Theme.hairline;
            border-color: choice.value == root.value ? Theme.text : Theme.border;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.value = choice.value;
                    root.changed();
                }
            }
        }
        LineEdit {
            width: 96px;
            text <=> root.value;
            placeholder-text: "#RRGGBB";
            edited => { root.changed(); }
        }
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: Theme.radius-md;
            background: root.resolved;
            border-width: Theme.hairline;
            border-color: Theme.border;
        }
        Rectangle { horizontal-stretch: 1; }
    }
    Text {
        x: 60px;
        text: root.description;
        color: Theme.text-muted;
        font-size: Theme.text-lg;
    }
}

component PreferenceNavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback selected-page();

    height: 28px;
    border-radius: Theme.radius-md;
    // The selected page is marked by the whole row's fill, the way
    // `OutputTargetItem` marks the chosen output target. It used to be a 2px
    // accent bar instead, which never reached the row's left edge: a child of
    // a plain Rectangle with no `x` is *centred*, so the marker drew as a
    // hairline down the middle of the tab, behind the label. Every other
    // edge bar in this UI writes `x: 0` for that reason -- but a bar beside a
    // fill is for a second meaning, as the channel plates' colour is, and
    // selection is the only thing this row has to say.
    background: tap.pressed ? Theme.surface-active
        : root.selected ? Theme.accent-active
        : transparent;
    Text {
        x: 10px;
        width: parent.width - 18px;
        text: root.text;
        color: root.selected ? Theme.text : Theme.text-muted;
        font-size: Theme.text-xl;
        vertical-alignment: center;
    }
    tap := TouchArea { mouse-cursor: pointer; clicked => { root.selected-page(); } }
}

// One row of the action registry (`actions.rs`), as shown in the
// Preferences > Shortcuts page. `is-first-in-category` marks a section
// boundary in the flat `shortcut-rows` list, computed in Rust so this file
// doesn't need adjacency logic over a `for` loop.
export struct ShortcutRow {
    id: string,
    label: string,
    category: string,
    chord: string,
    // Where the chord applies, from `actions.rs`'s `Scope::label`, and empty
    // for an action that fires anywhere. Filled in Rust so the page never
    // has to know which actions are contextual -- and drawn at all because
    // a chord that does nothing where you pressed it is otherwise
    // indistinguishable from a chord that is broken.
    context: string,
    is-default: bool,
    is-first-in-category: bool,
}

// One row of the gesture registry (`gestures.rs`), as shown at the foot of
// the Preferences > Shortcuts page. These are modifiers rather than chords,
// so they get a picker instead of the key recorder below.
export struct GestureRow {
    id: string,
    label: string,
    description: string,
    choice-index: int,
    is-default: bool,
}

export component GestureRowView inherits Rectangle {
    in property <GestureRow> entry;
    in property <[string]> choices;
    callback picked(int);

    height: 34px;
    HorizontalBox {
        padding: 4px;
        spacing: 8px;
        VerticalLayout {
            width: 190px;
            spacing: 0px;
            alignment: center;
            Text {
                text: root.entry.label;
                color: Theme.text;
                font-size: Theme.text-xl;
            }
            Text {
                text: root.entry.description;
                color: Theme.text-muted;
                font-size: Theme.text-md;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        ComboBox {
            width: 120px;
            height: 24px;
            model: root.choices;
            current-index: root.entry.choice-index;
            selected(value) => { root.picked(self.current-index); }
        }
        Text {
            text: root.entry.is-default ? "" : "changed";
            color: Theme.text-faint;
            font-size: Theme.text-md;
            width: 50px;
            vertical-alignment: center;
        }
    }
}

export component ShortcutRowView inherits Rectangle {
    in property <ShortcutRow> entry;
    in property <bool> capturing;
    callback record-clicked();
    callback reset-clicked();
    callback key-captured(string, bool, bool, bool, bool);
    callback capture-cancelled();

    height: 30px;
    border-radius: Theme.radius-md;
    background: capture-focus.has-focus ? Theme.surface-active : transparent;

    HorizontalBox {
        padding: 4px;
        spacing: 8px;
        Text {
            text: root.entry.label;
            color: Theme.text;
            font-size: Theme.text-xl;
            vertical-alignment: center;
            width: 150px;
        }
        Text {
            text: root.capturing ? "Press keys... (Esc cancels)" : (root.entry.chord == "" ? "Not set" : root.entry.chord);
            color: root.capturing ? Theme.accent : (root.entry.chord == "" ? Theme.text-faint : Theme.text-muted);
            font-size: Theme.text-lg;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.entry.context;
            color: Theme.text-faint;
            font-size: Theme.text-md;
            width: 96px;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
        ToolButton {
            text: root.capturing ? "Cancel" : "Record";
            clicked => {
                if (root.capturing) {
                    root.capture-cancelled();
                } else {
                    root.record-clicked();
                    capture-focus.focus();
                }
            }
        }
        ToolButton {
            text: "Reset";
            enabled: !root.entry.is-default;
            clicked => { root.reset-clicked(); }
        }
    }

    // Captures the next raw key event while `capturing` is true. This is
    // deliberately its own small `FocusScope` rather than reusing
    // `main.slint`'s root one: that one is disabled outright while
    // Preferences is open (see the comment there), specifically so a row
    // like this can own the next keypress instead. The decode chain below
    // has to match `main.slint`'s `keys := FocusScope` exactly (same
    // backend, same Ctrl+letter-as-control-character quirk) -- kept in
    // sync by hand since Slint has no clean way to share it across files
    // without risking an unproven language feature in a rarely-exercised
    // path.
    capture-focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (!root.capturing) {
                reject
            } else if (event.text == Key.Escape) {
                root.capture-cancelled();
                accept
            } else if (event.text == " ") {
                root.key-captured("space", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.LeftArrow) {
                root.key-captured("left", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.RightArrow) {
                root.key-captured("right", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.UpArrow) {
                root.key-captured("up", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.DownArrow) {
                root.key-captured("down", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.Delete) {
                root.key-captured("delete", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.Backspace) {
                root.key-captured("backspace", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.Tab) {
                root.key-captured("tab", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.Return) {
                root.key-captured("return", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.Home) {
                root.key-captured("home", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.End) {
                root.key-captured("end", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.PageUp) {
                root.key-captured("pageup", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.PageDown) {
                root.key-captured("pagedown", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == Key.Insert) {
                root.key-captured("insert", event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            // See the matching guard in `main.slint`'s `keys := FocusScope`:
            // a bare modifier keypress reports its own key code, which
            // collides with the Ctrl+P..Ctrl+X sentinel range below.
            } else if (event.text == Key.Shift || event.text == Key.Control
                    || event.text == Key.Alt || event.text == Key.AltGr
                    || event.text == Key.CapsLock || event.text == Key.ShiftR
                    || event.text == Key.ControlR || event.text == Key.Meta
                    || event.text == Key.MetaR) {
                reject
            } else if (event.text == "\u{1}") {
                root.key-captured("a", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{2}") {
                root.key-captured("b", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{3}") {
                root.key-captured("c", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{4}") {
                root.key-captured("d", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{5}") {
                root.key-captured("e", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{6}") {
                root.key-captured("f", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{7}") {
                root.key-captured("g", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{b}") {
                root.key-captured("k", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{c}") {
                root.key-captured("l", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{d}") {
                root.key-captured("m", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{e}") {
                root.key-captured("n", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{f}") {
                root.key-captured("o", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{10}") {
                root.key-captured("p", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{11}") {
                root.key-captured("q", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{12}") {
                root.key-captured("r", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{13}") {
                root.key-captured("s", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{14}") {
                root.key-captured("t", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{15}") {
                root.key-captured("u", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{16}") {
                root.key-captured("v", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{17}") {
                root.key-captured("w", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{18}") {
                root.key-captured("x", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{19}") {
                root.key-captured("y", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            } else if (event.text == "\u{1a}") {
                root.key-captured("z", true, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            // Everything else, including an unmodified key. This required
            // a modifier until 2026-09-14, which made a shipped default
            // unrecordable: `transport.loop-toggle` is a bare L and the
            // roll's tools are bare digits, so Reset followed by Record
            // could not put back what the registry had. `actions.rs`'s
            // `the_recorder_decodes_what_the_dispatcher_does` now fails if
            // this ladder and `main.slint`'s drift apart again.
            } else {
                root.key-captured(event.text.to-lowercase(), event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                accept
            }
        }
    }
}

// The Appearance page's body, exported so it can be rendered unclipped in a
// snapshot test. The dialog only ever shows it through a ScrollView, which
// crops it to the fixed dialog height.
export component AppearancePage inherits VerticalLayout {
    in-out property <string> theme;
    in-out property <bool> customized;
    // 0 dark, 1 light, 2 follow the desktop.
    in-out property <int> mode;
    in-out property <[AppearanceSchemeRow]> schemes;
    in-out property <[color]> ramp;
    in-out property <bool> variant-derived;
    in-out property <float> text-ratio: 1.0;
    in-out property <float> accent-ratio: 1.0;
    // Quick swatches for the three fields. Base offers the built-in themes'
    // backgrounds for the variant in force; accent and alert offer the hues of
    // the scheme in force, so the row stops suggesting a lime while Nord is on
    // screen.
    in property <[ColorChoice]> base-choices;
    in property <[ColorChoice]> hue-choices;
    in-out property <string> base;
    in-out property <string> accent;
    in-out property <string> alert;
    in-out property <float> contrast;
    in-out property <float> roundness;
    in-out property <float> type-scale;
    in-out property <float> density;
    in-out property <string> font-family;
    in-out property <string> font-family-mono;
    in-out property <int> font-weight;
    in-out property <float> hairline;
    in-out property <float> stroke-emphasis;
    in-out property <string> theme-name;
    in-out property <bool> smooth-curves;
    /// The meter falloff rows, passed straight down from the dialog. See the
    /// note on its copy of this property.
    in property <[string]> meter-falloff-options;
    in property <string> validation-error;
    callback preview-changed();
    // Its own callback rather than another `preview-changed`: flipping the
    // variant has to re-project the three colour pickers onto the new one,
    // and a generic preview cannot tell that apart from somebody having
    // edited a colour -- which means Custom.
    callback mode-changed(int);
    callback select-theme(string);
    callback save-theme(string);
    callback remove-theme(string);

    spacing: Theme.pad-lg;
    // Children keep their preferred heights and stack from the top, so any
    // slack collects at the bottom rather than inflating the ColorFields,
    // which inherit VerticalBox and would otherwise absorb it as layouts do.
    alignment: start;

    Text { text: "Appearance"; color: Theme.text; font-size: Theme.text-3xl; height: 20px; }

    SectionLabel { text: "THEME"; }
    HorizontalBox {
        height: 30px;
        padding: 0px;
        spacing: Theme.pad-lg;
        Text {
            text: "Variant";
            color: Theme.text;
            font-size: Theme.text-xl;
            vertical-alignment: center;
            width: 54px;
        }
        SegmentedControl {
            options: ["Dark", "Light", "Auto"];
            max-width: 240px;
            hint: "Auto follows the desktop's own light/dark setting.";
            selected-index <=> root.mode;
            changed selected-index => { root.mode-changed(self.selected-index); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    Rectangle {
        height: 132px;
        background: Theme.background;
        border-width: Theme.hairline;
        border-color: Theme.border;
        border-radius: Theme.radius-md;
        ScrollView {
            VerticalLayout {
                padding: Theme.pad-sm;
                spacing: Theme.pad-xs;
                for scheme in root.schemes : Rectangle {
                    height: 26px;
                    border-radius: Theme.radius-sm;
                    // Highlighted only while the theme is what is actually
                    // being drawn. An edited palette is Custom, and a row
                    // still marked selected would be claiming otherwise.
                    background: scheme.name == root.theme && !root.customized
                        ? Theme.surface-raised
                        : scheme-tap.has-hover ? Theme.surface : transparent;
                    scheme-tap := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select-theme(scheme.name); }
                        changed has-hover => {
                            if (self.has-hover) { StatusHint.show(scheme.description); }
                            else { StatusHint.clear(scheme.description); }
                        }
                    }
                    HorizontalBox {
                        padding: Theme.pad-sm;
                        spacing: Theme.pad-md;
                        for tint in [scheme.base, scheme.accent, scheme.alert] : Rectangle {
                            width: 14px;
                            height: 14px;
                            y: (parent.height - 14px) / 2;
                            border-radius: Theme.radius-sm;
                            background: tint;
                            border-width: Theme.hairline;
                            border-color: Theme.border;
                        }
                        Text {
                            text: scheme.name;
                            color: scheme.name == root.theme && !root.customized
                                ? Theme.text
                                : Theme.text-muted;
                            font-size: Theme.text-xl;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if scheme.derived : Text {
                            text: "derived";
                            color: Theme.text-faint;
                            font-size: Theme.text-md;
                            vertical-alignment: center;
                        }
                        if scheme.is-user : ToolButton {
                            text: "Remove";
                            tooltip: "Delete"; hint: "Delete the " + scheme.name + " theme";
                            min-width: 56px;
                            min-height: 20px;
                            clicked => { root.remove-theme(scheme.name); }
                        }
                    }
                }
            }
        }
    }
    // The ramp in force, all sixteen slots. Read-only on purpose: a ramp is
    // edited by editing its file, and the three pickers below are the in-app
    // way to change colours.
    HorizontalLayout {
        height: 14px;
        spacing: 1px;
        for slot in root.ramp : Rectangle {
            background: slot;
            border-radius: Theme.radius-xs;
        }
    }
    Text {
        text: root.customized && root.theme != ""
            ? "Custom, from " + root.theme + " — save it to keep it."
            : root.theme == ""
                ? "Custom — save it to keep it."
                : root.variant-derived
                    ? root.theme + " does not ship this variant; it is derived from the other one."
                    : root.theme;
        color: Theme.text-muted;
        font-size: Theme.text-lg;
        height: 14px;
    }
    HorizontalBox {
        padding: 0px;
        spacing: Theme.pad-md;
        LineEdit {
            horizontal-stretch: 1;
            text <=> root.theme-name;
            placeholder-text: "New theme name";
        }
        ToolButton {
            text: "Save Theme";
            tooltip: "Save";
            hint: "Write the current colours, type and metrics out as a theme file";
            min-width: 88px;
            clicked => { root.save-theme(root.theme-name); }
        }
    }

    SectionLabel { text: "COLORS"; }
    ColorField {
        label: "Base";
        description: "Seeds every neutral: background, panels, borders, and text.";
        value <=> root.base;
        resolved: Theme.background;
        choices: root.base-choices;
        changed => { root.preview-changed(); }
    }
    ColorField {
        label: "Accent";
        description: "State: selection, focus, and meters in their safe range.";
        value <=> root.accent;
        resolved: Theme.accent;
        choices: root.hue-choices;
        changed => { root.preview-changed(); }
    }
    ColorField {
        label: "Alert";
        description: "Attention: warnings, meter headroom, out-of-range values.";
        value <=> root.alert;
        resolved: Theme.warning;
        choices: root.hue-choices;
        changed => { root.preview-changed(); }
    }
    Text { text: root.validation-error; color: Theme.destructive; font-size: Theme.text-lg; height: 18px; }

    // The contrast report. The palette derivation has been able to compute
    // this since it was first written and nothing ever asked it, so a user
    // could pick seeds that produced an unreadable interface and this page
    // would show it to them without comment. 4.5 is WCAG AA for small text;
    // 3.0 is its bar for a non-text interface element, which is what an
    // accent is.
    HorizontalBox {
        height: 16px;
        padding: 0px;
        spacing: Theme.pad-md;
        Text {
            text: "Text " + round(root.text-ratio * 10) / 10 + ":1";
            color: root.text-ratio >= 4.5 ? Theme.text-muted : Theme.warning;
            font-size: Theme.text-lg;
            vertical-alignment: center;
        }
        Text {
            text: "Accent " + round(root.accent-ratio * 10) / 10 + ":1";
            color: root.accent-ratio >= 3.0 ? Theme.text-muted : Theme.warning;
            font-size: Theme.text-lg;
            vertical-alignment: center;
        }
        Text {
            text: root.text-ratio >= 4.5 && root.accent-ratio >= 3.0
                ? "Clears WCAG AA."
                : "Below WCAG AA — raise Contrast, or pick a stronger colour.";
            color: Theme.text-faint;
            font-size: Theme.text-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    SectionLabel { text: "INTERFACE"; }
    ParameterFader {
        label: "Roundness";
        tooltip: "Corner radius across the whole interface";
        label-width: 54px;
        minimum: 0;
        maximum: 3;
        step: 0.05;
        value <=> root.roundness;
        value-text: round(root.roundness * 100) + "%";
        changed(v) => { root.preview-changed(); }
    }
    ParameterFader {
        label: "Contrast";
        tooltip: "Spread between the background, surfaces, and text";
        label-width: 54px;
        minimum: 0.6;
        maximum: 1.4;
        step: 0.02;
        value <=> root.contrast;
        value-text: round(root.contrast * 100) + "%";
        changed(v) => { root.preview-changed(); }
    }
    // The accessibility control. The working range of this interface is
    // 7-11px, and before the type tokens existed turning it up meant editing
    // three hundred literals.
    ParameterFader {
        label: "Text size";
        tooltip: "Scales every label, readout and heading together";
        label-width: 54px;
        minimum: 0.75;
        maximum: 2.0;
        step: 0.05;
        value <=> root.type-scale;
        value-text: round(root.type-scale * 100) + "%";
        changed(v) => { root.preview-changed(); }
    }
    ParameterFader {
        label: "Density";
        tooltip: "Control heights, padding and spacing";
        label-width: 54px;
        minimum: 0.75;
        maximum: 1.75;
        step: 0.05;
        value <=> root.density;
        value-text: round(root.density * 100) + "%";
        changed(v) => { root.preview-changed(); }
    }
    ParameterFader {
        label: "Borders";
        tooltip: "Hairline width. Zero gives a borderless interface.";
        label-width: 54px;
        minimum: 0;
        maximum: 3;
        step: 0.5;
        value <=> root.hairline;
        value-text: root.hairline == 0 ? "None" : root.hairline + " px";
        changed(v) => { root.preview-changed(); }
    }
    ParameterFader {
        label: "Emphasis";
        tooltip: "The heavier stroke: selection, focus and the active border";
        label-width: 54px;
        minimum: 0;
        maximum: 5;
        step: 0.5;
        value <=> root.stroke-emphasis;
        value-text: root.stroke-emphasis + " px";
        changed(v) => { root.preview-changed(); }
    }

    // A theme names a font; it cannot ship one. Slint 1.17.1 has no runtime
    // font registration, so a family is resolved from what is installed and a
    // name nobody has falls back to the platform default without a word --
    // which is why the hint says so rather than the interface pretending.
    SectionLabel { text: "TYPE"; }
    HorizontalBox {
        height: 26px;
        padding: 0px;
        spacing: Theme.pad-md;
        Text {
            text: "Interface";
            color: Theme.text;
            font-size: Theme.text-xl;
            vertical-alignment: center;
            width: 54px;
        }
        LineEdit {
            horizontal-stretch: 1;
            text <=> root.font-family;
            placeholder-text: "System default";
            edited => { root.preview-changed(); }
        }
    }
    HorizontalBox {
        height: 26px;
        padding: 0px;
        spacing: Theme.pad-md;
        Text {
            text: "Readouts";
            color: Theme.text;
            font-size: Theme.text-xl;
            vertical-alignment: center;
            width: 54px;
        }
        LineEdit {
            horizontal-stretch: 1;
            text <=> root.font-family-mono;
            placeholder-text: "monospace";
            edited => { root.preview-changed(); }
        }
    }
    Text {
        text: "A font that is not installed falls back to the platform default.";
        color: Theme.text-muted;
        font-size: Theme.text-lg;
        height: 14px;
    }
    ParameterFader {
        label: "Weight";
        tooltip: "Body weight. Anything above 500 at 9px is a smudge.";
        label-width: 54px;
        minimum: 100;
        maximum: 900;
        step: 100;
        // One-way, because the weight is an `int` and a fader is a `float`;
        // the round trip happens in `changed` instead of in a binding.
        value: root.font-weight;
        value-text: root.font-weight;
        changed(v) => { root.font-weight = round(v); root.preview-changed(); }
    }

    SectionLabel { text: "GRAPHICS"; }
    HorizontalBox {
        height: 36px;
        padding: 0px;
        spacing: 8px;
        VerticalBox {
            spacing: 0px;
            padding: 0px;
            Text { text: "Smooth curves"; color: Theme.text; font-size: Theme.text-xl; }
            Text { text: "Antialias device graphs and filter curves"; color: Theme.text-muted; font-size: Theme.text-lg; }
        }
        Rectangle { horizontal-stretch: 1; }
        ToggleButton {
            text: root.smooth-curves ? "On" : "Off";
            tooltip: "Smooth"; hint: "Draw smooth antialiased curves";
            max-width: 72px;
            checked <=> root.smooth-curves;
        }
    }

    // Motion writes straight into the shared Motion global, so every
    // animated panel answers live; Apply persists the indices by name.
    SectionLabel { text: "MOTION"; }
    HorizontalBox {
        height: 36px;
        padding: 0px;
        spacing: 8px;
        VerticalBox {
            spacing: 0px;
            padding: 0px;
            Text { text: "Speed"; color: Theme.text; font-size: Theme.text-xl; }
            Text { text: "How long panel hide/show moves take"; color: Theme.text-muted; font-size: Theme.text-lg; }
        }
        Rectangle { horizontal-stretch: 1; }
        SegmentedControl {
            options: ["Instant", "Fast", "Normal", "Slow"];
            max-width: 240px;
            selected-index <=> Motion.speed;
        }
    }
    HorizontalBox {
        height: 36px;
        padding: 0px;
        spacing: 8px;
        VerticalBox {
            spacing: 0px;
            padding: 0px;
            Text { text: "Easing"; color: Theme.text; font-size: Theme.text-xl; }
            Text { text: "The curve the move follows"; color: Theme.text-muted; font-size: Theme.text-lg; }
        }
        Rectangle { horizontal-stretch: 1; }
        SegmentedControl {
            options: ["Linear", "Ease out", "In-out", "Overshoot"];
            max-width: 240px;
            selected-index <=> Motion.easing;
        }
    }

    // Metering, on the same terms as Motion above: written straight into the
    // shared global so the mixer answers while the dialog is still open, and
    // persisted by name on Apply.
    SectionLabel { text: "METERING"; }
    HorizontalBox {
        height: 36px;
        padding: 0px;
        spacing: 8px;
        VerticalBox {
            spacing: 0px;
            padding: 0px;
            Text { text: "Falloff"; color: Theme.text; font-size: Theme.text-xl; }
            Text {
                text: "How fast a meter falls back after a peak";
                color: Theme.text-muted;
                font-size: Theme.text-lg;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        SegmentedControl {
            options: root.meter-falloff-options;
            max-width: 240px;
            hint: "Meter fall rate. 12 dB/s is the broadcast standard.";
            selected-index <=> MeterPrefs.falloff;
        }
    }

    SectionLabel { text: "PREVIEW"; }
    Rectangle {
        height: 64px;
        background: Theme.background;
        border-width: Theme.hairline;
        border-color: Theme.border;
        border-radius: Theme.radius-md;
        HorizontalBox {
            padding: 10px;
            spacing: 8px;
            VerticalBox {
                padding: 0px;
                spacing: 1px;
                Text { text: "Value"; color: Theme.text; font-size: Theme.text-xl; }
                Text { text: "Label"; color: Theme.text-muted; font-size: Theme.text-lg; }
                Text { text: "Hint"; color: Theme.text-faint; font-size: Theme.text-lg; }
            }
            ToolButton { text: "Selected"; active: true; }
            ToolButton { text: "Idle"; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle { width: 44px; height: 10px; y: (parent.height - 10px) / 2; background: Theme.accent; border-radius: Theme.radius-sm; }
            Rectangle { width: 22px; height: 10px; y: (parent.height - 10px) / 2; background: Theme.warning; border-radius: Theme.radius-sm; }
            Rectangle { width: 12px; height: 10px; y: (parent.height - 10px) / 2; background: Theme.destructive; border-radius: Theme.radius-sm; }
        }
    }
}

// One binding in the map, as the Preferences > MIDI page draws it. Every
// field is already resolved on the Rust side -- the target's name comes from
// the project and `unresolved` from the ports that exist right now -- because
// neither question can be asked from here.
export struct MidiBindingRow {
    // Position in the map, and the handle every callback takes. Not the row's
    // position in this model: the two are the same today and a filter would
    // part them, and the handle has to keep meaning the binding.
    index: int,
    source: string,
    target: string,
    mode: string,
    // Whether this binding has a takeover to switch at all. A toggle or a
    // relative encoder does not, and the switch is left off the row rather
    // than drawn dead.
    has-takeover: bool,
    jump: bool,
    inverted: bool,
    // The named port is not plugged in, so this binding does nothing this
    // run. Said out loud rather than dropped: a controller that is not
    // plugged in is not a mistake.
    unresolved: bool,
}

// One transport gesture and whatever is mapped to it. The whole list is
// always drawn, bound or not: it is the menu as well as the map, which is
// what `TransportControl::ALL` exists to be.
export struct MidiTransportRow {
    // Position in `TransportControl::ALL`.
    gesture: int,
    label: string,
    // The control mapped to it, or empty for one nothing reaches.
    source: string,
    // This gesture is the learn gesture currently waiting for a control.
    listening: bool,
    // The binding's position in the map, or -1 when there is none.
    binding: int,
}

component MidiBindingRowView inherits Rectangle {
    in property <MidiBindingRow> entry;
    callback relearn();
    callback removed();
    callback takeover-toggled();
    callback invert-toggled();

    height: 30px;
    HorizontalBox {
        padding: 3px;
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            width: 160px;
            alignment: center;
            Text {
                text: root.entry.source;
                color: root.entry.unresolved ? Theme.warning : Theme.text;
                font-size: Theme.text-xl;
                overflow: elide;
            }
        }
        VerticalLayout {
            width: 200px;
            alignment: center;
            Text {
                text: root.entry.target;
                color: Theme.text-muted;
                font-size: Theme.text-xl;
                overflow: elide;
            }
        }
        VerticalLayout {
            width: 96px;
            alignment: center;
            Text {
                text: root.entry.unresolved ? "not plugged in" : root.entry.mode;
                color: root.entry.unresolved ? Theme.warning : Theme.text-faint;
                font-size: Theme.text-lg;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        // The takeover cell is kept even when the row has no takeover to
        // switch, so RELEARN and the remove cross line up down the list. A
        // toggle and an absolute knob otherwise draw their buttons at
        // different x, and the column reads as three ragged rows.
        Rectangle {
            width: 60px;
            if root.entry.has-takeover : ToolButton {
                width: 60px;
                text: root.entry.jump ? "JUMP" : "PICKUP";
                tooltip: root.entry.jump
                    ? "The parameter jumps to the control's position"
                    : "The control takes over where it passes the value";
                active: root.entry.jump;
                clicked => { root.takeover-toggled(); }
            }
        }
        ToolButton {
            width: 34px;
            text: "INV";
            tooltip: "Run the control's range backwards";
            active: root.entry.inverted;
            clicked => { root.invert-toggled(); }
        }
        ToolButton {
            width: 58px;
            text: "RELEARN";
            tooltip: "Move another control to take this mapping over";
            clicked => { root.relearn(); }
        }
        ToolButton {
            width: 24px;
            text: "\u{00d7}";
            tooltip: "Remove this mapping";
            text-color: Theme.destructive;
            clicked => { root.removed(); }
        }
    }
}

component MidiTransportRowView inherits Rectangle {
    in property <MidiTransportRow> entry;
    callback learn();
    callback removed();

    height: 30px;
    HorizontalBox {
        padding: 3px;
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            width: 140px;
            alignment: center;
            Text { text: root.entry.label; color: Theme.text; font-size: Theme.text-xl; }
        }
        VerticalLayout {
            width: 240px;
            alignment: center;
            Text {
                text: root.entry.listening
                    ? "move a control on your controller"
                    : root.entry.source == "" ? "not mapped" : root.entry.source;
                color: root.entry.listening ? Theme.focus
                    : root.entry.source == "" ? Theme.text-faint : Theme.text-muted;
                font-size: Theme.text-xl;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        ToolButton {
            width: 72px;
            text: root.entry.listening ? "CANCEL" : "LEARN";
            tooltip: root.entry.listening
                ? "Stop waiting for a control"
                : "Wait for a control, then map it to this gesture";
            active: root.entry.listening;
            clicked => { root.learn(); }
        }
        ToolButton {
            width: 24px;
            text: "\u{00d7}";
            tooltip: "Remove this mapping";
            enabled: root.entry.binding >= 0;
            text-color: Theme.destructive;
            clicked => { root.removed(); }
        }
    }
}

// The MIDI page's body, exported for the same reason `AppearancePage` is: the
// dialog only ever shows it through a ScrollView, which crops it to the fixed
// dialog height, and a snapshot wants to see the whole thing.
export component MidiPage inherits VerticalLayout {
    in property <[string]> ports;
    in property <string> port-note;
    in property <[MidiBindingRow]> bindings;
    in property <[MidiTransportRow]> transport-rows;
    in-out property <bool> learn-binds-port;
    callback learn-binds-port-toggled(bool);
    callback binding-removed(int);
    callback binding-takeover-toggled(int);
    callback binding-inverted-toggled(int);
    callback binding-relearn(int);
    callback transport-learn(int);

    spacing: 8px;
    // Children keep their preferred heights and stack from the top, the way
    // the appearance page does, so the ScrollView above decides the scroll
    // rather than a layout stretching rows to fill it.
    alignment: start;

    Text { text: "MIDI"; color: Theme.text; font-size: Theme.text-3xl; height: 20px; }

    SectionLabel { text: "MIDI INPUTS"; }
    if root.ports.length == 0 : Text {
        text: "No MIDI input is connected.";
        color: Theme.text-faint;
        font-size: Theme.text-xl;
    }
    for port in root.ports : Text {
        text: port;
        color: Theme.text-muted;
        font-size: Theme.text-xl;
        height: 16px;
    }
    if root.port-note != "" : Text {
        text: root.port-note;
        color: Theme.text-faint;
        font-size: Theme.text-lg;
        wrap: word-wrap;
    }

    SectionLabel { text: "CONTROLLER MAPPING"; }
    Text {
        text: "Turn on LEARN beside the transport, press a knob or fader, "
            + "then move the control you want it to follow.";
        color: Theme.text-faint;
        font-size: Theme.text-lg;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: start;
        height: 24px;
        ToggleButton {
            // Stated, because `ToolButton`'s preferred width is 44px and this
            // label is six times that: left to its own size the button draws
            // a 44px box with the text hanging out of both ends of it.
            width: 210px;
            text: "Bind to the controller it hears";
            checked: root.learn-binds-port;
            tooltip: "On, a mapping only listens to the controller that taught "
                + "it. Off, any controller sending the same control drives it.";
            toggled(value) => { root.learn-binds-port-toggled(value); }
        }
    }
    if root.bindings.length == 0 : Text {
        text: "Nothing is mapped.";
        color: Theme.text-faint;
        font-size: Theme.text-xl;
    }
    for entry in root.bindings : MidiBindingRowView {
        entry: entry;
        relearn => { root.binding-relearn(entry.index); }
        removed => { root.binding-removed(entry.index); }
        takeover-toggled => { root.binding-takeover-toggled(entry.index); }
        invert-toggled => { root.binding-inverted-toggled(entry.index); }
    }

    SectionLabel { text: "TRANSPORT"; }
    Text {
        text: "A transport gesture has no control to press, so it is learned "
            + "from here. Start, Stop and Continue from an external sequencer "
            + "work without being mapped.";
        color: Theme.text-faint;
        font-size: Theme.text-lg;
        wrap: word-wrap;
    }
    for entry in root.transport-rows : MidiTransportRowView {
        entry: entry;
        learn => { root.transport-learn(entry.gesture); }
        removed => { root.binding-removed(entry.binding); }
    }
}

export component PreferencesDialog inherits Rectangle {
    in-out property <bool> open;
    in-out property <string> appearance-theme;
    in-out property <bool> appearance-customized;
    in-out property <int> appearance-mode;
    in-out property <[AppearanceSchemeRow]> appearance-schemes;
    in-out property <[color]> appearance-ramp;
    in-out property <bool> appearance-variant-derived;
    in-out property <float> appearance-text-ratio: 1.0;
    in-out property <float> appearance-accent-ratio: 1.0;
    in-out property <[ColorChoice]> appearance-base-choices;
    in-out property <[ColorChoice]> appearance-hue-choices;
    in-out property <string> appearance-base;
    in-out property <string> appearance-accent;
    in-out property <string> appearance-alert;
    in-out property <float> appearance-contrast;
    in-out property <float> appearance-roundness;
    in-out property <float> appearance-type-scale: 1.0;
    in-out property <float> appearance-density: 1.0;
    in-out property <string> appearance-font-family;
    in-out property <string> appearance-font-family-mono: "monospace";
    in-out property <int> appearance-font-weight: 400;
    in-out property <float> appearance-hairline: 1.0;
    in-out property <float> appearance-stroke-emphasis: 2.0;
    in-out property <string> appearance-theme-name;
    in-out property <bool> developer-mode;
    in-out property <bool> smooth-curves;
    // Applied the moment it is toggled rather than on OK, like the audio page:
    // a diagnostic is wanted for the very next thing the user does, and making
    // them confirm a dialog first is one more step between a problem and the
    // record of it.
    in property <bool> log-to-file;
    in property <string> log-path;
    in property <string> validation-error;
    in property <[OutputTargetRow]> audio-output-targets;
    in property <int> audio-buffer-size-index;
    in property <string> audio-sample-rate-text;
    in property <bool> audio-auto-reconnect;
    in property <string> audio-error;
    in property <AudioDriverCopy> audio-driver;
    in property <[ShortcutRow]> shortcut-rows;
    in-out property <string> shortcut-capturing-id;
    in property <[GestureRow]> gesture-rows;
    in property <[string]> gesture-choices;
    /// The Super-key readings, in `SuperKeyMode::ALL` order, named in Rust
    /// for the same reason `meter-falloff-options` is: the option list is
    /// the enum, and a second copy here would be the one that drifts.
    in property <[string]> shortcut-super-key-choices;
    in-out property <int> shortcut-super-key;
    callback shortcut-super-key-changed(int);
    /// The falloff rows, labelled with the rate each one is. Handed over by
    /// Rust from `meter::FALLOFF_DB_PER_SECOND` rather than typed out here:
    /// the label *is* the number, so a copy in the markup would be a number
    /// written twice with nothing able to notice the two drifting apart.
    in property <[string]> meter-falloff-options;
    in property <[string]> midi-ports;
    in property <string> midi-port-note;
    in property <[MidiBindingRow]> midi-bindings;
    in property <[MidiTransportRow]> midi-transport-rows;
    in-out property <bool> midi-learn-binds-port;
    callback midi-learn-binds-port-toggled(bool);
    callback midi-binding-removed(int);
    callback midi-binding-takeover-toggled(int);
    callback midi-binding-inverted-toggled(int);
    callback midi-binding-relearn(int);
    callback midi-transport-learn(int);
    // No arguments. Every value either callback needs is one of the two-way
    // bound properties above, and Rust reads them back through
    // `window_appearance`; passing fourteen of them positionally would be
    // fourteen chances to swap two.
    callback appearance-preview();
    callback appearance-mode-changed(int);
    callback appearance-select-theme(string);
    callback appearance-save-theme(string);
    callback appearance-remove-theme(string);
    callback save() -> bool;
    callback cancelled;
    callback audio-refresh-targets();
    callback audio-select-output(string, string, string);
    callback audio-select-buffer-size(int);
    callback audio-auto-reconnect-toggled(bool);
    callback shortcut-rebind-key(string, string, bool, bool, bool, bool);
    callback shortcut-reset(string);
    callback shortcut-reset-all();
    callback gesture-rebound(string, int);
    // Off unless the build compiled the mockup tool in; see main.slint.
    in property <bool> mockup-tool-available;
    callback open-mockup-tool();
    callback log-to-file-toggled(bool);

    private property <int> page: 0;

    // Every appearance edit funnels through here so the live preview and the
    // Apply/OK payload can never drift apart.
    function preview-appearance() {
        root.appearance-preview();
    }
    visible: root.open;
    background: #00000099;
    z: 100;
    TouchArea { }

    Rectangle {
        width: min(parent.width - 24px, 840px);
        height: min(parent.height - 24px, 540px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        border-width: Theme.hairline;
        border-color: Theme.border;
        border-radius: Theme.radius-sm;

        VerticalBox {
            spacing: 0px;
            Rectangle {
                height: 40px;
                background: Theme.panel;
                border-width: 0px;
                HorizontalBox {
                    padding: 10px;
                    Text { text: "Preferences"; color: Theme.text; font-size: Theme.text-3xl; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        icon: "M 4 4 L 12 12 M 12 4 L 4 12";
                        tooltip: "Close";
                        size: 24px;
                        clicked => { root.cancelled(); root.open = false; }
                    }
                }
            }
            HorizontalBox {
                spacing: 0px;
                Rectangle {
                    width: 132px;
                    background: Theme.background;
                    border-width: 0px;
                    VerticalBox {
                        padding: 4px;
                        spacing: 0px;
                        PreferenceNavItem { text: "General"; selected: root.page == 0; selected-page => { root.page = 0; } }
                        PreferenceNavItem { text: "Audio"; selected: root.page == 1; selected-page => { root.page = 1; } }
                        PreferenceNavItem { text: "MIDI"; selected: root.page == 2; selected-page => { root.page = 2; } }
                        PreferenceNavItem { text: "Appearance"; selected: root.page == 3; selected-page => { root.page = 3; } }
                        PreferenceNavItem { text: "Shortcuts"; selected: root.page == 4; selected-page => { root.page = 4; } }
                        if root.developer-mode : PreferenceNavItem { text: "Developer"; selected: root.page == 5; selected-page => { root.page = 5; } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.surface;
                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;
                        if root.page == 0 : VerticalBox {
                            spacing: 8px;
                            Text { text: "General"; color: Theme.text; font-size: Theme.text-3xl; height: 20px; }
                            SectionLabel { text: "APPLICATION"; }
                            HorizontalBox {
                                height: 36px;
                                spacing: 8px;
                                VerticalBox {
                                    spacing: 0px;
                                    Text { text: "Developer mode"; color: Theme.text; font-size: Theme.text-xl; }
                                    Text { text: "Show developer tools and diagnostics"; color: Theme.text-muted; font-size: Theme.text-lg; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ToggleButton { text: "Enabled"; tooltip: "Show developer preferences"; checked <=> root.developer-mode; }
                            }
                        }
                        if root.page == 1 : ScrollView {
                            // The JACK control surface's content length is not
                            // fixed (a future ALSA surface may need more or
                            // less), so this page scrolls internally instead
                            // of assuming everything fits the dialog's fixed
                            // body height the way the shorter pages do.
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: parent.width - 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text { text: "Audio"; color: Theme.text; font-size: Theme.text-3xl; height: 20px; }
                                SectionLabel { text: "DRIVER"; }
                                HorizontalBox {
                                    spacing: 8px;
                                    padding: 0px;
                                    SegmentedControl { width: 96px; options: [root.audio-driver.name]; selected-index: 0; }
                                    Text { text: root.audio-driver.note; color: Theme.text-faint; font-size: Theme.text-lg; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                HorizontalBox {
                                    spacing: 8px;
                                    padding: 0px;
                                    Text { text: "Device in"; color: Theme.text; font-size: Theme.text-xl; vertical-alignment: center; }
                                    Text {
                                        text: "input capture isn't implemented yet";
                                        color: Theme.text-faint;
                                        font-size: Theme.text-lg;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    ToolButton { text: "None"; enabled: false; }
                                }
                                DriverControlSurface {
                                    output-targets: root.audio-output-targets;
                                    buffer-size-index: root.audio-buffer-size-index;
                                    sample-rate-text: root.audio-sample-rate-text;
                                    auto-reconnect: root.audio-auto-reconnect;
                                    error: root.audio-error;
                                    driver: root.audio-driver;
                                    refresh-targets => { root.audio-refresh-targets(); }
                                    select-output(client, port-l, port-r) => { root.audio-select-output(client, port-l, port-r); }
                                    select-buffer-size(i) => { root.audio-select-buffer-size(i); }
                                    auto-reconnect-toggled(v) => { root.audio-auto-reconnect-toggled(v); }
                                }
                            }
                        }
                        if root.page == 2 : ScrollView {
                            // Like the audio page: the mapping list has no
                            // bound on its length, so this one scrolls rather
                            // than growing the dialog. The viewport height is
                            // a constant for the reason the appearance page
                            // states -- binding it to the page's own
                            // preferred height is circular -- except that
                            // here the content's length is known, so it is
                            // computed from the row counts rather than
                            // written down and left to drift.
                            vertical-stretch: 1;
                            viewport-width: self.visible-width;
                            viewport-height: max(
                                self.visible-height,
                                470px + (root.midi-bindings.length + root.midi-ports.length) * 30px);
                            MidiPage {
                                width: parent.visible-width - 8px;
                                ports: root.midi-ports;
                                port-note: root.midi-port-note;
                                bindings: root.midi-bindings;
                                transport-rows: root.midi-transport-rows;
                                learn-binds-port: root.midi-learn-binds-port;
                                learn-binds-port-toggled(v) => { root.midi-learn-binds-port-toggled(v); }
                                binding-removed(i) => { root.midi-binding-removed(i); }
                                binding-takeover-toggled(i) => { root.midi-binding-takeover-toggled(i); }
                                binding-inverted-toggled(i) => { root.midi-binding-inverted-toggled(i); }
                                binding-relearn(i) => { root.midi-binding-relearn(i); }
                                transport-learn(i) => { root.midi-transport-learn(i); }
                            }
                        }
                        if root.page == 3 : ScrollView {
                            // The page is taller than the dialog body, so it
                            // scrolls. `viewport-height` must be a constant:
                            // binding it to the page's own preferred height is
                            // circular (the child is sized by the viewport it
                            // would define) and Slint breaks that loop by
                            // collapsing everything below the fold. Keep the
                            // constant in step with the page's content height.
                            vertical-stretch: 1;
                            viewport-width: self.visible-width;
                            viewport-height: 684px;
                            appearance-page := AppearancePage {
                                width: parent.visible-width - 8px;
                                theme <=> root.appearance-theme;
                                customized <=> root.appearance-customized;
                                mode <=> root.appearance-mode;
                                schemes <=> root.appearance-schemes;
                                ramp <=> root.appearance-ramp;
                                variant-derived <=> root.appearance-variant-derived;
                                text-ratio <=> root.appearance-text-ratio;
                                accent-ratio <=> root.appearance-accent-ratio;
                                base-choices: root.appearance-base-choices;
                                hue-choices: root.appearance-hue-choices;
                                base <=> root.appearance-base;
                                accent <=> root.appearance-accent;
                                alert <=> root.appearance-alert;
                                contrast <=> root.appearance-contrast;
                                roundness <=> root.appearance-roundness;
                                type-scale <=> root.appearance-type-scale;
                                density <=> root.appearance-density;
                                font-family <=> root.appearance-font-family;
                                font-family-mono <=> root.appearance-font-family-mono;
                                font-weight <=> root.appearance-font-weight;
                                hairline <=> root.appearance-hairline;
                                stroke-emphasis <=> root.appearance-stroke-emphasis;
                                theme-name <=> root.appearance-theme-name;
                                smooth-curves <=> root.smooth-curves;
                                meter-falloff-options: root.meter-falloff-options;
                                validation-error: root.validation-error;
                                preview-changed => { root.preview-appearance(); }
                                mode-changed(m) => { root.appearance-mode-changed(m); }
                                select-theme(name) => { root.appearance-select-theme(name); }
                                save-theme(name) => { root.appearance-save-theme(name); }
                                remove-theme(name) => { root.appearance-remove-theme(name); }
                            }
                        }
                        if root.page == 4 : VerticalBox {
                            spacing: 8px;
                            HorizontalBox {
                                padding: 0px;
                                Text { text: "Shortcuts"; color: Theme.text; font-size: Theme.text-3xl; height: 20px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                ToolButton { text: "Reset All"; clicked => { root.shortcut-reset-all(); } }
                            }
                            Text {
                                text: "Click Record, then press the key combination to assign. "
                                    + "A chord with a context on the right only acts there; "
                                    + "\"Focused panel\" means it asks what you last clicked.";
                                color: Theme.text-muted;
                                font-size: Theme.text-lg;
                                wrap: word-wrap;
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding-right: 10px;
                                    spacing: 2px;
                                    for row in root.shortcut-rows : VerticalLayout {
                                        spacing: 2px;
                                        if row.is-first-in-category : SectionLabel { text: row.category; }
                                        ShortcutRowView {
                                            entry: row;
                                            capturing: root.shortcut-capturing-id == row.id;
                                            record-clicked => { root.shortcut-capturing-id = row.id; }
                                            reset-clicked => { root.shortcut-reset(row.id); }
                                            capture-cancelled => { root.shortcut-capturing-id = ""; }
                                            key-captured(key, ctrl, shift, alt, meta) => {
                                                root.shortcut-capturing-id = "";
                                                root.shortcut-rebind-key(row.id, key, ctrl, shift, alt, meta);
                                            }
                                        }
                                    }
                                    SectionLabel { text: "EDITOR GESTURES"; }
                                    Text {
                                        text: "Which modifier each piano-roll drag answers to. "
                                            + "Roles compose: holding copy and snap override together does both. "
                                            + "Alt is offered but never a default, since some window managers "
                                            + "take Alt+drag before the app sees it.";
                                        color: Theme.text-muted;
                                        font-size: Theme.text-lg;
                                        wrap: word-wrap;
                                    }
                                    for row in root.gesture-rows : GestureRowView {
                                        entry: row;
                                        choices: root.gesture-choices;
                                        picked(index) => { root.gesture-rebound(row.id, index); }
                                    }
                                    // A page-wide reading of one key rather
                                    // than a binding, so it sits with the
                                    // gestures at the foot of the page and
                                    // not in the rows it changes the reach
                                    // of.
                                    SectionLabel { text: "MODIFIER KEYS"; }
                                    Text {
                                        text: "How a Super press is read. A desktop that keeps Alt for its "
                                            + "own window commands can leave Super as the only spare "
                                            + "modifier, and a keyboard with the two the wrong way round "
                                            + "wants them exchanged. No chord above moves either way -- "
                                            + "only which key presses it.";
                                        color: Theme.text-muted;
                                        font-size: Theme.text-lg;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        height: 26px;
                                        SegmentedControl {
                                            // Stated, because the segments
                                            // size from the panel otherwise
                                            // and these three labels are
                                            // sentences rather than words.
                                            width: 320px;
                                            options: root.shortcut-super-key-choices;
                                            hint: "Which physical key means Alt in a shortcut.";
                                            selected-index <=> root.shortcut-super-key;
                                            changed selected-index => { root.shortcut-super-key-changed(self.selected-index); }
                                        }
                                    }
                                }
                            }
                        }
                        if root.page == 5 && root.developer-mode : VerticalBox {
                            spacing: 8px;
                            Text { text: "Developer"; color: Theme.text; font-size: Theme.text-3xl; height: 20px; }
                            if root.mockup-tool-available : SectionLabel { text: "DEVELOPER TOOLS"; }
                            if root.mockup-tool-available : HorizontalBox {
                                height: 36px;
                                spacing: 8px;
                                VerticalBox {
                                    spacing: 0px;
                                    Text { text: "UI mockup"; color: Theme.text; font-size: Theme.text-xl; }
                                    Text { text: "Compose layouts from the real controls"; color: Theme.text-muted; font-size: Theme.text-lg; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ToolButton { text: "Open"; clicked => { root.open-mockup-tool(); } }
                            }
                            SectionLabel { text: "DIAGNOSTICS"; }
                            HorizontalBox {
                                height: 36px;
                                spacing: 8px;
                                VerticalBox {
                                    spacing: 0px;
                                    Text { text: "Write a log file"; color: Theme.text; font-size: Theme.text-xl; }
                                    Text { text: "Keep what the console reports, so a problem can be read back later"; color: Theme.text-muted; font-size: Theme.text-lg; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ToggleButton {
                                    text: "Enabled";
                                    tooltip: "Log to file"; hint: "Mirror the diagnostic log to a file";
                                    checked: root.log-to-file;
                                    toggled(v) => { root.log-to-file-toggled(v); }
                                }
                            }
                            // Wrapped so it picks up the same horizontal
                            // padding as the rows above; a bare child of the
                            // column sits against the panel edge instead.
                            HorizontalBox {
                                // Selectable rather than a plain label:
                                // someone being asked for their log has to get
                                // the path into a file manager or a message,
                                // and retyping it is where that goes wrong.
                                TextInput {
                                    text: root.log-path;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    color: Theme.text-muted;
                                    font-size: Theme.text-lg;
                                    font-family: Theme.font-family-mono;
                                    selection-background-color: Theme.accent;
                                }
                            }
                        }
                        // Pads out the short, non-scrolling pages. A page
                        // that scrolls must not share the body height with
                        // it: two siblings at vertical-stretch 1 split the
                        // space evenly, which halves the scroll viewport and
                        // hides everything past the fold.
                        if root.page != 1 && root.page != 2 && root.page != 3 : Rectangle { vertical-stretch: 1; }
                    }
                }
            }
            Rectangle {
                height: 40px;
                background: Theme.panel;
                border-width: 0px;
                HorizontalBox {
                    padding: 8px;
                    spacing: 6px;
                    Rectangle { horizontal-stretch: 1; }
                    ToolButton { text: "Cancel"; clicked => { root.cancelled(); root.open = false; } }
                    ToolButton {
                        text: "Apply";
                        clicked => {
                            root.save();
                        }
                    }
                    ToolButton {
                        text: "OK";
                        active: true;
                        clicked => {
                            if (root.save()) {
                                root.open = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
