import { Theme } from "theme.slint";
import { ParameterKnob, ToolButton } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";

// A momentary trigger: it reports press and release separately rather than
// a click, so a gated event can hold for exactly as long as the control is
// down. Modelled on ToolButton's look so it sits with the latching triggers.
component HeldButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip: root.text;
    callback pressed;
    callback released;

    min-width: 44px;
    min-height: 24px;
    border-radius: Theme.radius-md;
    border-width: tap.has-hover ? Theme.hairline : 0px;
    border-color: Theme.border;
    background: tap.pressed ? Theme.accent-active : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.tooltip;

    Text {
        text: root.text;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.text-xl;
    }

    tap := TouchArea {
        mouse-cursor: pointer;
        // A pointer leaving while down still releases: otherwise the head
        // would latch on indefinitely after a drag off the control.
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.pressed(); }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.released();
            }
        }
    }

    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// One retained-audio buffer insert.
//
// Two surfaces, because the device has two kinds of control. POSITION and
// XFADE are standing parameters: descriptor-addressed, so an automation lane
// or the modulation matrix can drive them like any other knob. Sweeping
// POSITION is a scrub — the head chases it and the closing speed *is* the
// playback rate — and a position written once is an edit that finishes, after
// which the head free-runs at Rate.
//
// **Rate and Freeze have no knob here yet.** They are published parameters and
// reachable from a lane; the face that shows them is this plan's step 6, where
// Buffer becomes 2U. A knob each in the meantime would be two knobs to move.
//
// The three buttons are gestures, which a curve cannot express: they fire a
// complete event tuple that creates a head with its own window and repeat
// count. They remain a debug surface standing in for the note-mapping and
// parameter-lock layers, and go through the same `TriggerBuffer` command
// those will. A running gesture outranks POSITION, which re-asserts itself on
// the next control tick after the gesture ends.
export component BufferDeviceFace inherits EffectDeviceShell {
    name: "Buffer";
    kind: "BUFFER / 1U";
    // Running count of forced returns to live: the writer overtaking a
    // detached head. Monotonic, so a collision landing between two GUI
    // frames still shows up.
    in property <int> collisions;
    // Normalized 0..1 against the descriptor tables in mooloop-core.
    // Position is *already* normalized there — 0 is the oldest retained
    // sample and 1 is now — so it is the one control on this face with no
    // second spelling of a range to get wrong.
    in-out property <float> position;
    in-out property <float> crossfade; // 0.5..50 ms
    callback position-changed(float);
    callback crossfade-changed(float);
    // Index into the fixed debug event table, matching TRIGGERS below.
    callback trigger(int);

    private property <float> crossfade-ms: 0.5 * pow(100, root.crossfade);
    // Reverse is held rather than latched: it runs while the control is down.
    callback reverse-pressed();
    callback reverse-released();

    VerticalLayout {
        padding: 6px;
        padding-top: DeviceRackMetrics.header-height + 6px;
        spacing: 6px;

        Rectangle {
            height: 34px;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding: 6px;
                spacing: 6px;
                Text {
                    text: "COLLISIONS";
                    color: Theme.text-faint;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.collisions;
                    // A nonzero count is not an error — a forced return is
                    // the specified behaviour — so it reads as attention,
                    // not as a fault.
                    color: root.collisions > 0 ? Theme.warning : Theme.text-muted;
                    font-size: Theme.text-2xl;
                    font-family: Theme.font-family-mono;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            ParameterKnob {
                width: 52px;
                diameter: 36px;
                label: "Position";
                tooltip: "Where in the retained history the read head is";
                value <=> root.position;
                default-value: 1;
                // The top of the travel is the write head, which is live.
                value-text: root.position > 0.9995
                    ? "live"
                    : round(root.position * 1000) / 10 + " %";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[0];
                modulation-depth: root.modulation-depths[0];
                modulation-offset: root.modulation-offsets[0];
                modulation-route-count: root.modulation-route-counts[0];
                changed(v) => { root.position-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(0, v); }
                modulation-edit-started => { root.modulation-edit-started(0); }
                modulation-edit-finished => { root.modulation-edit-finished(0); }
            }
            ParameterKnob {
                width: 52px;
                diameter: 36px;
                label: "Xfade";
                tooltip: "Crossfade applied when the head detaches or returns";
                value <=> root.crossfade;
                default-value: 0.349485;
                value-text: round(root.crossfade-ms * 10) / 10 + " ms";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[1];
                modulation-depth: root.modulation-depths[1];
                modulation-offset: root.modulation-offsets[1];
                modulation-route-count: root.modulation-route-counts[1];
                changed(v) => { root.crossfade-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(1, v); }
                modulation-edit-started => { root.modulation-edit-started(1); }
                modulation-edit-finished => { root.modulation-edit-finished(1); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            height: 26px;
            spacing: 4px;
            ToolButton {
                text: "JUMP";
                tooltip: "−1 beat, 1.0x";
                clicked => { root.trigger(0); }
            }
            HeldButton {
                text: "REV";
                tooltip: "hold: reverse, 2-bar loop";
                pressed => { root.reverse-pressed(); }
                released => { root.reverse-released(); }
            }
            ToolButton {
                text: "STUT";
                tooltip: "−1/16, window 1/16, 8x";
                clicked => { root.trigger(2); }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
