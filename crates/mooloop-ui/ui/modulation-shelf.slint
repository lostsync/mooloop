import { Theme } from "theme.slint";
import { ParameterKnob, SelectorBank, ToggleButton, ToolButton, ValueScale } from "controls.slint";

// The channel-owned source collection. `slot` is today's bounded runtime
// locator; the UI deliberately presents only occupied entries, never four
// permanent empty bays (docs/MODULATOR_SYSTEM_SPEC.md).
export struct ModulationSourceRow {
    slot: int,
    name: string,
    waveform: int,
    rate: float,
    depth: float,
    phase: float,
    retrigger: bool,
    selected: bool,
}

// A route remains explicit even when it is currently parked at zero depth or
// aimed at a destination that later becomes unavailable. The owner token is
// an adapter for Slint: -1 means the source device, -2 the channel strip, and
// a non-negative value is an effect slot.
export struct ModulationRouteRow {
    route-index: int,
    source-slot: int,
    owner: int,
    param: int,
    destination: string,
    depth: float,
    polarity: int, // 0 = bipolar, 1 = unipolar
    allowed: bool,
}

// The rack reserves room for the shelf, so both files must agree on its
// height. A global keeps that agreement in one place instead of two literals.
export global ModulationShelfMetrics {
    out property <length> closed-height: 30px;
    out property <length> open-height: 104px;
}

component SourceChip inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    callback clicked();

    width: 64px;
    height: 24px;
    border-radius: Theme.radius-md;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.accent;
    background: tap.pressed ? Theme.surface-active
        : root.selected ? Theme.surface-raised : Theme.surface;
    Text {
        text: root.name;
        color: root.selected ? Theme.accent : Theme.text-muted;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    tap := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component RouteRow inherits Rectangle {
    in property <string> destination;
    in property <float> depth;
    in property <int> polarity;
    in property <bool> allowed;
    callback polarity-selected(int);
    callback removed();

    height: 24px;
    background: tap.has-hover ? Theme.surface-raised : transparent;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 4px;
        Text {
            width: 132px;
            text: root.destination;
            color: root.allowed ? Theme.text : Theme.text-faint;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 40px;
            text: (root.depth > 0 ? "+" : "") + round(root.depth * 100) + "%";
            color: root.depth == 0 ? Theme.text-faint : Theme.accent;
            font-family: "monospace";
            font-size: 10px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        ToolButton {
            text: root.polarity == 0 ? "±" : "↑";
            tooltip: root.polarity == 0 ? "Bipolar: swings around the base value" : "Unipolar: base value is the floor";
            min-width: 26px;
            max-width: 26px;
            min-height: 20px;
            max-height: 20px;
            clicked => { root.polarity-selected(root.polarity == 0 ? 1 : 0); }
        }
        ToolButton {
            text: "×";
            tooltip: "Remove this modulation route";
            min-width: 24px;
            max-width: 24px;
            min-height: 20px;
            max-height: 20px;
            text-color: Theme.text-muted;
            clicked => { root.removed(); }
        }
    }
    tap := TouchArea { }
}

// The one modulation shelf belongs below the entire device rack. It holds
// sources and the destination-first route inspector; device faces only expose
// marked controls that enter this same collection.
export component ModulationShelf inherits Rectangle {
    in property <bool> open;
    in property <[ModulationSourceRow]> sources;
    in property <[ModulationRouteRow]> routes;
    in property <int> armed-slot: -1;
    // The armed source's own controls. Scalars rather than a row looked up
    // from `sources`: exactly one source is armed, so the editor is one
    // widget, not one per source with all but a single copy hidden.
    in property <int> armed-waveform;
    in property <float> armed-rate;
    in property <float> armed-depth;
    in property <float> armed-phase;
    in property <bool> armed-retrigger;
    // Capacity is an engine protocol boundary, not a UI layout constant
    // (docs/MODULATOR_SYSTEM_SPEC.md), so Rust reports it.
    in property <int> max-sources: 0;
    callback toggled();
    callback source-selected(int);
    callback lfo-added();
    callback lfo-wave-changed(int, int);
    callback lfo-rate-changed(int, float);
    callback lfo-depth-changed(int, float);
    callback lfo-phase-changed(int, float);
    callback lfo-retrigger-changed(int, bool);
    callback route-polarity-changed(int, int);
    callback route-removed(int);

    // A source editor must not steal height from the rack's fixed 268 px
    // device face. The open shelf is a chip row above one compact editor
    // row. Keep OPEN-HEIGHT in step with the rack height in main.slint.
    height: root.open ? ModulationShelfMetrics.open-height : ModulationShelfMetrics.closed-height;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    clip: true;

    VerticalLayout {
        // An explicit layout, not manual `y` offsets: the body must always
        // start below the header, whatever height the shelf is given.
        spacing: 0px;

        header := Rectangle {
            height: 29px;
            background: header-touch.has-hover ? Theme.surface-raised : Theme.panel;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                Text {
                    width: 30px;
                    text: "MOD";
                    color: root.open ? Theme.accent : Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.sources.length == 0 ? "Add a source to begin"
                        : root.routes.length + " route" + (root.routes.length == 1 ? "" : "s");
                    color: Theme.text-faint;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.open ? "⌃" : "⌄";
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            header-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(); }
            }
        }

        if root.open : Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                padding: 6px;
                spacing: 8px;

                // Chips and the armed source's editor share one row: the
                // rack's fixed 268px device face leaves the shelf about one
                // control row, not two. No source is hard-coded into a device
                // face; the first usable kind happens to be LFO.
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            width: 46px;
                            height: 24px;
                            text: "SOURCES";
                            color: Theme.text-faint;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                    }
                    for source in root.sources : VerticalLayout {
                        alignment: center;
                        SourceChip {
                            name: source.name;
                            selected: source.selected;
                            clicked => { root.source-selected(source.slot); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        ToolButton {
                            text: "+ LFO";
                            tooltip: "Add an LFO to this channel";
                            enabled: root.sources.length < root.max-sources;
                            min-width: 50px;
                            max-width: 50px;
                            min-height: 24px;
                            max-height: 24px;
                            clicked => { root.lfo-added(); }
                        }
                    }

                    if root.armed-slot < 0 : Text {
                        width: 186px;
                        height: 24px;
                        text: root.sources.length == 0
                            ? "Add an LFO, then select it to arm eligible controls."
                            : "Select a source to arm eligible controls.";
                        color: Theme.text-muted;
                        font-size: 10px;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }

                    // One editor, for whichever source is armed.
                    if root.armed-slot >= 0 : VerticalLayout {
                        alignment: center;
                        SelectorBank {
                            options: ["SIN", "TRI", "SAW", "SQR", "RND"];
                            selected-index: root.armed-waveform;
                            segment-width: 30px;
                            min-height: 24px;
                            max-height: 24px;
                            tooltip: "LFO waveform";
                            selected(index) => { root.lfo-wave-changed(root.armed-slot, index); }
                        }
                    }
                    if root.armed-slot >= 0 : ParameterKnob {
                        width: 44px;
                        diameter: 30px;
                        label: "Rate";
                        tooltip: "LFO rate";
                        value: root.armed-rate;
                        minimum: 0.05;
                        maximum: 20;
                        default-value: 1;
                        scale: ValueScale.logarithmic;
                        value-text: round(root.armed-rate * 10) / 10 + " Hz";
                        changed(value) => { root.lfo-rate-changed(root.armed-slot, value); }
                    }
                    if root.armed-slot >= 0 : ParameterKnob {
                        width: 44px;
                        diameter: 30px;
                        label: "Level";
                        tooltip: "LFO source depth";
                        value: root.armed-depth;
                        default-value: 1;
                        value-text: round(root.armed-depth * 100) + "%";
                        changed(value) => { root.lfo-depth-changed(root.armed-slot, value); }
                    }
                    if root.armed-slot >= 0 : ParameterKnob {
                        width: 44px;
                        diameter: 30px;
                        label: "Phase";
                        tooltip: "LFO reset phase";
                        value: root.armed-phase;
                        default-value: 0;
                        value-text: round(root.armed-phase * 360) + "\u{b0}";
                        changed(value) => { root.lfo-phase-changed(root.armed-slot, value); }
                    }
                    if root.armed-slot >= 0 : VerticalLayout {
                        alignment: center;
                        ToggleButton {
                            text: "RE";
                            tooltip: "Restart the LFO on note-on";
                            checked: root.armed-retrigger;
                            min-width: 34px;
                            max-width: 34px;
                            min-height: 24px;
                            max-height: 24px;
                            toggled(value) => { root.lfo-retrigger-changed(root.armed-slot, value); }
                        }
                    }
                }

                Rectangle { width: 1px; background: Theme.border; }

                // The compact destination-first inspector. A knob marker will
                // focus this same list; there is no separate matrix editor.
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    Text {
                        text: "ROUTES";
                        color: Theme.text-faint;
                        font-size: 9px;
                        height: 12px;
                    }
                    if root.routes.length == 0 : Text {
                        text: root.armed-slot < 0
                            ? "Select a source, then drag a highlighted control."
                            : "Drag any highlighted control to create a route.";
                        color: Theme.text-muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    for route in root.routes : RouteRow {
                        destination: route.destination;
                        depth: route.depth;
                        polarity: route.polarity;
                        allowed: route.allowed;
                        polarity-selected(value) => {
                            root.route-polarity-changed(route.route-index, value);
                        }
                        removed => { root.route-removed(route.route-index); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
