import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NameField } from "toolbar.slint";
import { PatchCanvas } from "patch-canvas.slint";
import { Divisions, LedIndicator, MiniKnob, SelectorBank, SyncMiniKnob, ToggleButton, ToolButton, ValueScale } from "controls.slint";

// One module in the song. `slot` is its index in the session's list of
// sources (modules first, then every channel's outlets and keyboard), which
// is what every callback from the pane carries back.
export struct ModulationSourceRow {
    slot: int,
    name: string,
    // `ModulatorKind::to_index`: 0 LFO, 1 envelope, 2 step, 3 random, 4 math.
    kind: int,
    waveform: int,
    // Step-only: the sixteen values and how many of them play. The tile
    // draws the pattern itself rather than a generic staircase glyph.
    steps: [float],
    step-length: int,
    // Math-only: the operator, which is the whole face a math tile has.
    math-op: int,
    // The module's current `-1..1` output, refreshed on the pump tick. This
    // is telemetry, unlike the parameter-derived face above it.
    output: float,
    rate: float,
    depth: float,
    phase: float,
    pulse-width: float,
    preview-fade-cycles: float,
    preview-smoothing-cycles: float,
    preview-attack: float,
    preview-decay: float,
    preview-sustain: float,
    preview-release: float,
    retrigger: bool,
    selected: bool,
}

// One control outlet the channel's generator publishes, as the picker offers
// it. Not a module: it has no editor, cannot be added, removed or reordered,
// and its number is a device-interface id rather than a position, so the chip
// shows its name and never a slot. `slot` is where it sits in the same flat
// control address space a module occupies, which is what lets one selection
// and one assignment gesture serve both (docs/MODULATION.md).
export struct ModulationOutletRow {
    slot: int,
    name: string,
    // A heading row: `name` is the channel whose outlets follow, and the row
    // is a label rather than a chip. The band lists every channel's outlets,
    // grouped, so the grouping travels as rows rather than as nesting.
    heading: bool,
    // Whether the signal swings both ways, which is what decides whether the
    // chip's live fill grows from the centre or from the left.
    bipolar: bool,
    // Live value, telemetry exactly like a module tile's meter.
    output: float,
    selected: bool,
}

// One of the selected source's routes. `route-index` is the route's place
// in the song's list, which the polarity and remove callbacks carry back;
// `destination` names the chain, the device and the parameter, since the
// route may land on any channel or track. A route stays listed when it is
// parked at zero depth or aimed at a destination that has gone.
export struct ModulationRouteRow {
    route-index: int,
    param: int,
    destination: string,
    depth: float,
    polarity: int, // 0 = bipolar, 1 = unipolar
    allowed: bool,
    // The destination is kept and drives nothing because it is no longer
    // there: a plugin parameter the plugin stopped listing (MOO-74). Drawn
    // greyed with an italic name, and still removable. Not plugin-specific:
    // any kept-but-inert address can set it.
    missing: bool,
}

// The outlet band's geometry. One column, beside the module grid rather than
// under it: an outlet is named, not numbered -- "Filter Envelope" has to stay
// readable, and a chip narrow enough to sit four-across would elide it. Beside
// also costs the grid no height, so publishing outlets never takes a row of
// modules off the screen.
global OutletBand {
    out property <length> chip-width: 112px;
    out property <length> chip-height: 16px;
    out property <length> gap: 4px;

    public pure function height-for(count: int) -> length {
        return count * root.chip-height + (count - 1) * root.gap;
    }
}

global RandomParam {
    out property <int> rate: 0;
    out property <int> tempo-sync: 1;
    out property <int> rate-division: 2;
    out property <int> trigger: 3;
    out property <int> bipolar: 4;
    out property <int> probability: 5;
    out property <int> quantize: 6;
    out property <int> drunk: 7;
    out property <int> walk: 8;
}

// One published outlet in the picker. A module tile draws the signal it is
// configured to produce; an outlet has no configuration to draw, so the chip
// shows its name over the live value instead. The fill *is* the meter rather
// than a bar under the name, which is what lets a chip be one line tall and
// the whole band fit beside the grid.
component OutletChip inherits Rectangle {
    in property <string> name;
    in property <bool> bipolar;
    in property <float> output;
    in property <bool> selected;
    in property <bool> armed;
    callback clicked();

    width: OutletBand.chip-width;
    height: OutletBand.chip-height;
    border-radius: Theme.radius-sm;
    border-width: root.selected ? Theme.hairline : 0px;
    border-color: root.armed ? Theme.focus : Theme.accent;
    background: tap.pressed ? Theme.surface-active
        : root.selected ? Theme.surface-raised : Theme.surface;
    clip: true;

    // Centre-origin for a bipolar signal and left-origin for the rest, so a
    // gate reads as filling and an LFO reads as swinging.
    Rectangle {
        x: root.bipolar ? parent.width / 2 + min(0, clamp(root.output, -1, 1)) * parent.width / 2 : 0px;
        width: root.bipolar
            ? abs(clamp(root.output, -1, 1)) * parent.width / 2
            : clamp(root.output, 0, 1) * parent.width;
        height: parent.height;
        background: root.armed ? Theme.focus : Theme.accent;
        opacity: 0.28;
    }
    Text {
        text: root.name;
        color: root.selected ? Theme.text : Theme.text-muted;
        font-size: Theme.text-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 4px;
        x: 2px;
    }
    tap := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component RouteRow inherits Rectangle {
    in property <string> destination;
    in property <float> depth;
    in property <int> polarity;
    in property <bool> allowed;
    in property <bool> missing;
    callback polarity-selected(int);
    callback removed();

    height: 25px;
    background: tap.has-hover ? Theme.surface-raised : transparent;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 3px;
        spacing: 3px;
        Text {
            horizontal-stretch: 1;
            text: root.destination;
            color: root.allowed && !root.missing ? Theme.text : Theme.text-faint;
            font-size: Theme.text-md;
            font-italic: root.missing;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 38px;
            text: (root.depth > 0 ? "+" : "") + round(root.depth * 100) + "%";
            color: root.depth == 0 ? Theme.text-faint : Theme.accent;
            font-family: Theme.font-family-mono;
            font-size: Theme.text-md;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        ToolButton {
            text: root.polarity == 0 ? "±" : "↑";
            tooltip: root.polarity == 0 ? "Bipolar" : "Unipolar"; hint: root.polarity == 0 ? "Bipolar: swings around the base value" : "Unipolar: base value is the floor";
            min-width: 24px;
            max-width: 24px;
            min-height: 20px;
            max-height: 20px;
            clicked => { root.polarity-selected(root.polarity == 0 ? 1 : 0); }
        }
        ToolButton {
            text: "×";
            tooltip: "Remove"; hint: "Remove this modulation route";
            min-width: 22px;
            max-width: 22px;
            min-height: 20px;
            max-height: 20px;
            text-color: Theme.text-muted;
            clicked => { root.removed(); }
        }
    }
    tap := TouchArea { }
}


// The one modulation shelf belongs below the complete device rack. Its three
// modules deliberately separate the collection, the selected source's own
// control surface, and that channel's explicit destinations. This is the rack
// view of a control graph; it does not introduce patch cords or a second route
// language.
export component ModulationShelf inherits Rectangle {
    // The selected module's name, which its header edits.
    in property <string> selected-name;
    in property <[ModulationSourceRow]> sources;
    in property <[ModulationRouteRow]> routes;
    in property <int> selected-slot: -1;
    in property <int> selected-kind: -1;
    in property <int> armed-slot: -1;
    // The selected box's parameters, indexed by descriptor id; read only
    // for the signal it is spelled with in the header.
    in property <[float]> selected-values;
    // Whether the assignment gesture is armed with any source in the song,
    // which a module seated on another channel is without a slot here.
    in property <bool> assigning;
    // The channel generator's published control outlets, and what to call the
    // device that publishes them. Empty for a generator that publishes
    // nothing, and the band is then absent rather than empty: an outlet is
    // designed, not discovered, so there is nothing to show a placeholder for.
    in property <[ModulationOutletRow]> outlets;
    // What the armed source is called. A module's badge and slot number, or an
    // outlet's name -- resolved in Rust because only one of the two is a
    // position, and the header should not have to know which it is holding.
    in property <string> armed-name;
    // The selected outlet's declaration, when the selection is an outlet.
    // Empty means a module (or nothing) is selected, which is what gates the
    // module header, the jack strip, and the empty state below.
    in property <string> selected-outlet-name;
    in property <string> selected-outlet-signal;
    callback source-selected(int);
    // (rack slot, target position in the grid). The rack compacts as it
    // reorders, so the destination is a grid position rather than a slot.
    callback source-moved(int, int);
    callback assignment-toggled();
    callback source-removed(int);
    // (source, new name). An empty name is refused by the session.
    callback source-renamed(int, string);
    // A module's input is a jack bound to a dynamic list, not a descriptor
    callback route-polarity-changed(int, int);
    callback route-removed(int);

    pure function kind-name(kind: int) -> string {
        return kind == 0 ? "LFO" : kind == 1 ? "ENVELOPE" : kind == 2 ? "STEP"
            : kind == 3 ? "RANDOM" : "MATH";
    }
    pure function kind-signal(kind: int) -> string {
        return kind == 1 ? "UNIPOLAR"
            : kind == 2 ? "STEPPED"
            : kind == 3 ? (root.selected-values[RandomParam.bipolar] > 0.5 ? "STEPPED" : "STEPPED UNIPOLAR")
            : "BIPOLAR";
    }
    border-width: Theme.hairline;
    border-color: root.assigning ? Theme.accent : Theme.border;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        header := Rectangle {
            height: 24px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 7px;
                Text {
                    text: root.sources.length + " module" + (root.sources.length == 1 ? "" : "s")
                        + "  ·  " + root.routes.length + " route" + (root.routes.length == 1 ? "" : "s")
                        + (root.routes.length > 0 ? " from the selected source" : "");
                    color: Theme.text-faint;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.assigning : Rectangle {
                    width: 140px;
                    height: 18px;
                    border-radius: Theme.radius-sm;
                    background: Theme.accent-active;
                    Text {
                        text: "ASSIGN · " + root.armed-name;
                        color: Theme.focus;
                        font-size: Theme.text-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;

                // The work area: every module in the song, the outlets every
                // channel publishes, and what can be added. The song patch
                // canvas is meant to replace the grid here later, so the add
                // list and the surface below do not depend on it.
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 6px;

                // The patch (song patch step 03): every box in the song where
                // the song put it, the tags at the patch's edges, an
                // assignment tag for each route from a box, and the wires.
                PatchCanvas {
                    horizontal-stretch: 1;
                    min-width: 120px;
                }

                // The control outlets every channel's generator publishes,
                // grouped under the channel's name. Nothing here can be added,
                // removed or reordered: they belong to whichever device each
                // channel holds. No channel publishing any means no band at
                // all rather than an empty one -- an outlet is designed, not
                // discovered, so there is nothing to hold a place for.
                if root.outlets.length > 0 : Rectangle {
                    width: OutletBand.chip-width + 10px;
                    border-width: Theme.hairline;
                    border-color: Theme.border;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 3px;
                        HorizontalLayout {
                            height: 10px;
                            Text { text: "OUTLETS"; color: Theme.text-faint; font-size: Theme.text-sm; vertical-alignment: center; }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            width: OutletBand.chip-width + 2px;
                            content-width: OutletBand.chip-width;
                            content-height: OutletBand.height-for(root.outlets.length);
                            Rectangle {
                                width: OutletBand.chip-width;
                                height: OutletBand.height-for(root.outlets.length);
                                for outlet[index] in root.outlets : Rectangle {
                                    y: index * (OutletBand.chip-height + OutletBand.gap);
                                    width: OutletBand.chip-width;
                                    height: OutletBand.chip-height;
                                    if outlet.heading : Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: outlet.name;
                                        color: Theme.text-faint;
                                        font-size: Theme.text-sm;
                                        vertical-alignment: bottom;
                                        overflow: elide;
                                    }
                                    if !outlet.heading : OutletChip {
                                        name: outlet.name;
                                        bipolar: outlet.bipolar;
                                        output: outlet.output;
                                        selected: outlet.selected;
                                        armed: root.armed-slot == outlet.slot;
                                        clicked => { root.source-selected(outlet.slot); }
                                    }
                                }
                            }
                        }
                    }
                }
                }

                // Below the work area: the selected source's surface and the
                // routes it drives, wherever in the song they land.
                HorizontalLayout {
                    height: 112px;
                    spacing: 6px;

                // The selected module, expanded: one header and one jack
                // strip for every kind, then that kind's own knob surface,
                // with its destinations underneath.
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Rectangle {
                        vertical-stretch: 1;
                        border-width: Theme.hairline;
                        border-color: root.assigning ? Theme.accent : Theme.border;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 3px;
                            if root.selected-slot >= 0 && root.selected-outlet-name == "" : HorizontalLayout {
                                height: 20px;
                                spacing: 5px;
                                // A song has many LFOs, so a module's name is
                                // its own and is edited here.
                                NameField {
                                    width: 120px;
                                    height: 20px;
                                    text: root.selected-name;
                                    placeholder: root.kind-name(root.selected-kind);
                                    tooltip: "Rename this module";
                                    edited(value) => { root.source-renamed(root.selected-slot, value); }
                                }
                                Text {
                                    text: root.kind-name(root.selected-kind) + "  ·  " + root.kind-signal(root.selected-kind);
                                    color: Theme.text-faint;
                                    font-size: Theme.text-xs;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ToggleButton {
                                    text: root.assigning ? "ASSIGNING" : "ASSIGN";
                                    tooltip: root.assigning
                                        ? "Stop assigning routes and edit base values"
                                        : "Assign this module to highlighted controls";
                                    checked: root.assigning;
                                    min-width: 82px; max-width: 82px; min-height: 15px; max-height: 15px;
                                    toggled(value) => { root.assignment-toggled(); }
                                }
                                ToolButton {
                                    text: "×";
                                    tooltip: "Remove"; hint: "Remove this module and its routes";
                                    min-width: 22px; max-width: 22px; min-height: 15px; max-height: 15px;
                                    text-color: Theme.text-muted;
                                    clicked => { root.source-removed(root.selected-slot); }
                                }
                            }
                            // A selected outlet, which has no surface to
                            // open: the device that publishes it owns its
                            // behaviour, so what the pane shows instead is
                            // the declaration -- shape, rate and latency --
                            // and the arm button that is the reason an outlet
                            // is in the picker at all.
                            if root.selected-outlet-name != "" : HorizontalLayout {
                                height: 15px;
                                spacing: 5px;
                                Text {
                                    text: root.selected-outlet-name;
                                    color: Theme.text;
                                    font-size: Theme.text-lg;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.selected-outlet-signal;
                                    color: Theme.text-faint;
                                    font-size: Theme.text-xs;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ToggleButton {
                                    text: root.assigning ? "ASSIGNING" : "ASSIGN";
                                    tooltip: root.assigning
                                        ? "Stop assigning routes and edit base values"
                                        : "Assign this outlet to highlighted controls";
                                    checked: root.assigning;
                                    min-width: 82px; max-width: 82px; min-height: 15px; max-height: 15px;
                                    toggled(value) => { root.assignment-toggled(); }
                                }
                            }
                            if root.selected-outlet-name != "" : Text {
                                vertical-stretch: 1;
                                text: "Its channel's device publishes this. It has no controls of its "
                                    + "own: arm it, then drag a knob to route it.";
                                color: Theme.text-muted;
                                font-size: Theme.text-lg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            // The module pane is a layout now, so the empty
                            // state takes its width from the layout rather
                            // than reading it back off its parent.
                            if root.selected-outlet-name == "" : Text {
                                vertical-stretch: 1;
                                text: root.selected-slot >= 0
                                    ? "Its settings are on its face: open the box with its arrow."
                                    : root.sources.length == 0
                                    ? "Double-click the canvas to type a box."
                                    : "Select a box to see its routes.";
                                color: Theme.text-muted;
                                font-size: Theme.text-lg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                    }
            // The selected source's routes, wherever in the song they land:
            // a module that drives three channels is listed in one place.
            Rectangle {
                width: 320px;
                border-width: Theme.hairline;
                border-color: Theme.border;
                background: Theme.panel;
                VerticalLayout {
                    padding: 3px;
                    spacing: 3px;
                    HorizontalLayout {
                        height: 10px;
                        Text { text: "DESTINATIONS"; color: Theme.text-faint; font-size: Theme.text-sm; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.routes.length + " ROUTES"; color: Theme.text-faint; font-size: Theme.text-sm; vertical-alignment: center; }
                    }
                    if root.routes.length == 0 : Text {
                        text: root.assigning
                            ? "Drag a highlighted parameter to create a route."
                            : root.selected-slot < 0
                                ? "Select a source to inspect or assign it."
                                : "Choose Assign, then drag a destination.";
                        color: Theme.text-muted;
                        font-size: Theme.text-md;
                        wrap: word-wrap;
                    }
                    if root.routes.length > 0 : ScrollView {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, root.routes.length * 25px);
                        VerticalLayout {
                            spacing: 1px;
                            for route in root.routes : RouteRow {
                                destination: route.destination;
                                depth: route.depth;
                                polarity: route.polarity;
                                allowed: route.allowed;
                                missing: route.missing;
                                polarity-selected(value) => {
                                    root.route-polarity-changed(route.route-index, value);
                                }
                                removed => { root.route-removed(route.route-index); }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    }
                }
                }
            }
        }
    }
}
