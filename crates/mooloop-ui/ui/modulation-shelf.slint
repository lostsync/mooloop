import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { LedIndicator, MiniKnob, SelectorBank, ToggleButton, ToolButton, ValueScale } from "controls.slint";

// The channel-owned source collection. `slot` is today's bounded runtime
// locator; the UI deliberately presents only occupied entries, never four
// permanent empty bays (docs/MODULATOR_SYSTEM_SPEC.md).
export struct ModulationSourceRow {
    slot: int,
    name: string,
    // `ModulatorKind::to_index`: 0 LFO, 1 envelope, 2 step, 3 random, 4 math.
    kind: int,
    waveform: int,
    // Step-only: the sixteen values and how many of them play. The tile
    // draws the pattern itself rather than a generic staircase glyph.
    steps: [float],
    step-length: int,
    // Math-only: the operator, which is the whole face a math tile has.
    math-op: int,
    // The module's current `-1..1` output, refreshed on the pump tick. This
    // is telemetry, unlike the parameter-derived face above it.
    output: float,
    rate: float,
    depth: float,
    phase: float,
    pulse-width: float,
    preview-fade-cycles: float,
    preview-smoothing-cycles: float,
    preview-attack: float,
    preview-decay: float,
    preview-sustain: float,
    preview-release: float,
    retrigger: bool,
    selected: bool,
}

// A route remains explicit even when it is currently parked at zero depth or
// aimed at a destination that later becomes unavailable. The owner token is
// an adapter for Slint: -1 means the source device, -2 the channel strip, and
// a non-negative value is an effect slot.
export struct ModulationRouteRow {
    route-index: int,
    source-slot: int,
    owner: int,
    param: int,
    destination: string,
    depth: float,
    polarity: int, // 0 = bipolar, 1 = unipolar
    allowed: bool,
}

// The rack reserves room for the shelf, so both files must agree on its
// height. The expanded surface is one compact 104px module row beneath the
// header; it does not steal height from the fixed device faces above it.
export global ModulationShelfMetrics {
    out property <length> closed-height: 30px;
    // The grid is two rows of modules beside the selected module's full
    // surface. The rack derives its own height from this, so the shelf pays
    // for its own space rather than the layout guessing at it.
    out property <length> open-height: 240px;
}

// Grid geometry in one place. Capacity is an engine protocol boundary, so
// the grid wraps at a fixed column count and grows downward rather than the
// layout being retuned every time a slot is added.
global ModuleGrid {
    out property <int> columns: 4;
    out property <length> tile-width: 58px;
    out property <length> tile-height: 70px;
    out property <length> gap: 4px;
    out property <int> rows: 2;
    // Stated rather than measured from the children: an overlay sized off a
    // container that is itself sized by its children is a binding loop.
    out property <length> row-width: root.columns * root.tile-width + (root.columns - 1) * root.gap;
    out property <length> column-height: root.rows * root.tile-height + (root.rows - 1) * root.gap;
}

// Descriptor ids, mirroring mooloop-core's `LFO_PARAM_*` and `ENV_PARAM_*`
// tables. Each editor control reads `selected-values[id]` and reports edits
// as `param-changed(slot, id, value)`; these numbers are the wire contract
// and are never renumbered.
global LfoParam {
    out property <int> rate: 0;
    out property <int> depth: 1;
    out property <int> waveform: 2;
    out property <int> phase: 3;
    out property <int> tempo-sync: 4;
    out property <int> rate-division: 5;
    out property <int> retrigger: 6;
    out property <int> fade-in: 7;
    out property <int> fade-sync: 8;
    out property <int> fade-division: 9;
    out property <int> smoothing: 10;
    out property <int> pulse-width: 11;
}

global EnvParam {
    out property <int> attack: 0;
    out property <int> attack-sync: 1;
    out property <int> attack-division: 2;
    out property <int> decay: 3;
    out property <int> decay-sync: 4;
    out property <int> decay-division: 5;
    out property <int> sustain: 6;
    out property <int> release: 7;
    out property <int> release-sync: 8;
    out property <int> release-division: 9;
    out property <int> amount: 10;
}

global StepParam {
    out property <int> length: 0;
    out property <int> division: 1;
    out property <int> glide: 2;
    out property <int> trigger: 3;
    // The sixteen step values are one contiguous block from here, so the
    // editor addresses step `n` as `value-base + n` rather than naming it.
    out property <int> value-base: 4;
}

global RandomParam {
    out property <int> rate: 0;
    out property <int> tempo-sync: 1;
    out property <int> rate-division: 2;
    out property <int> trigger: 3;
    out property <int> bipolar: 4;
    out property <int> probability: 5;
    out property <int> quantize: 6;
    out property <int> drunk: 7;
    out property <int> walk: 8;
}

global MathParam {
    out property <int> input-slot: 0;
    out property <int> op: 1;
    out property <int> operand: 2;
    out property <int> clamp-low: 3;
    out property <int> clamp-high: 4;
}

// The shared musical grid, spelled once. Both the sync knob and the step
// sequencer's rate knob carry `ModTimeDivision` indices, so neither gets to
// invent its own names for them.
global Divisions {
    public pure function label(index: int) -> string {
        return index == 0 ? "4/1" : index == 1 ? "2/1" : index == 2 ? "1/1"
            : index == 3 ? "1/2D" : index == 4 ? "1/2" : index == 5 ? "1/2T"
            : index == 6 ? "1/4D" : index == 7 ? "1/4" : index == 8 ? "1/4T"
            : index == 9 ? "1/8D" : index == 10 ? "1/8" : index == 11 ? "1/8T"
            : index == 12 ? "1/16D" : index == 13 ? "1/16" : index == 14 ? "1/16T"
            : index == 15 ? "1/32D" : index == 16 ? "1/32" : index == 17 ? "1/32T"
            : index == 18 ? "1/64D" : index == 19 ? "1/64" : "1/64T";
    }
}

// The math operators, in `ModMathOp::ALL` order.
global MathOps {
    out property <[string]> labels: ["+", "\u{2212}", "\u{d7}", "\u{f7}", "MIN", "MAX", "CLMP"];
    out property <int> clamp-index: 6;
}

// A small source-shape view gives every collapsed source a recognizable face.
// It is parameter-derived, not telemetry, and therefore makes no promise that
// the line is phase-synchronized with the audio thread.
component ModulatorShape inherits Rectangle {
    in property <int> kind;
    in property <int> waveform;
    in property <float> amount: 1;
    in property <float> phase;
    in property <float> pulse-width: 0.5;
    // LFO time controls are expressed relative to one displayed cycle.
    in property <float> fade-cycles;
    in property <float> smoothing-cycles;
    // Envelope stage durations are effective seconds (tempo divisions have
    // already been resolved by Rust). The display compresses their range but
    // preserves their relative lengths and the exact zero-time edges.
    in property <float> attack;
    in property <float> decay;
    in property <float> sustain: 0.7;
    in property <float> release;
    // Step-only: the pattern itself, and how much of it plays.
    in property <[float]> steps;
    in property <int> step-length: 16;
    // Math-only: the operator index, which is this kind's whole face.
    in property <int> math-op;
    in property <color> line-color: Theme.accent;
    private property <bool> curve-kind: root.kind == 0 || root.kind == 1 || root.kind == 3;
    private property <float> attack-weight: root.attack <= 0 ? 0 : root.attack / (root.attack + 0.35);
    private property <float> decay-weight: root.decay <= 0 ? 0 : root.decay / (root.decay + 0.35);
    private property <float> release-weight: root.release <= 0 ? 0 : root.release / (root.release + 0.35);
    private property <float> hold-weight: 0.22;
    private property <float> envelope-total: max(0.001, root.attack-weight + root.decay-weight + root.hold-weight + root.release-weight);
    private property <float> attack-end: root.attack-weight / root.envelope-total;
    private property <float> decay-end: (root.attack-weight + root.decay-weight) / root.envelope-total;
    private property <float> hold-end: (root.attack-weight + root.decay-weight + root.hold-weight) / root.envelope-total;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    if root.curve-kind : Rectangle {
        x: 3px;
        y: root.kind == 1 ? parent.height - 4px : parent.height / 2;
        width: parent.width - 6px;
        height: 1px;
        background: Theme.border;
    }
    if root.kind == 1 && root.attack <= 0.0001 && root.amount > 0 : Rectangle {
        x: 3px;
        y: 4px + (1 - min(1, root.amount)) * (parent.height - 8px);
        width: 2px;
        height: min(1, root.amount) * (parent.height - 8px);
        background: root.line-color;
    }
    // A random module wears the same stepped face the LFO's hidden
    // sample-and-hold wore, which is what it was promoted from.
    if root.curve-kind : Rectangle {
        width: parent.width;
        height: parent.height;
    for point in 40 : Rectangle {
        private property <float> unit: point * 1.0 / 39.0;
        private property <float> cycle: mod(self.unit + root.phase, 1);
        private property <float> held: mod(point + round(root.phase * 40), 13) < 3 ? 0.65
            : mod(point + round(root.phase * 40), 13) < 7 ? -0.35
            : mod(point + round(root.phase * 40), 13) < 10 ? 0.2 : -0.72;
        private property <float> raw-lfo: root.kind == 3
            ? self.held
            : root.waveform == 0
            ? sin(self.cycle * 360deg)
            : root.waveform == 1
                ? 1 - 4 * abs(mod(self.cycle + 0.25, 1) - 0.5)
                : root.waveform == 2
                    ? 2 * mod(self.cycle + 0.5, 1) - 1
                    : root.waveform == 3
                        ? (self.cycle < root.pulse-width ? 1 : -1)
                        : self.held;
        private property <float> soft-lfo: root.waveform == 3
            ? sin((self.cycle - root.pulse-width / 2) * 360deg)
            : sin(self.cycle * 360deg);
        private property <float> smoothing: min(1, max(0, root.smoothing-cycles * 4));
        private property <float> fade: root.fade-cycles <= 0
            ? 1 : min(1, self.unit / max(0.001, min(1, root.fade-cycles)));
        private property <float> lfo-value: (self.raw-lfo * (1 - self.smoothing) + self.soft-lfo * self.smoothing)
            * min(1, max(0, root.amount)) * self.fade;
        private property <float> envelope-value: self.unit <= root.attack-end
            ? (root.attack-end <= 0.0001 ? 1 : self.unit / root.attack-end)
            : self.unit <= root.decay-end
                ? 1 - (1 - root.sustain) * (self.unit - root.attack-end) / max(0.0001, root.decay-end - root.attack-end)
                : self.unit <= root.hold-end
                    ? root.sustain
                    : root.sustain * (1 - (self.unit - root.hold-end) / max(0.0001, 1 - root.hold-end));
        private property <float> shaped: root.kind == 1
            ? min(1, max(0, self.envelope-value)) * min(1, max(0, root.amount))
            : self.lfo-value;
        x: 3px + self.unit * (parent.width - 7px);
        y: root.kind == 1
            ? parent.height - 4px - self.shaped * (parent.height - 8px)
            : parent.height * 0.5 - self.shaped * (parent.height - 8px) * 0.38;
        width: max(1px, (parent.width - 6px) / 39);
        height: 2px;
        background: root.line-color;
    }
    }
    // A step pattern draws itself: sixteen columns, the ones past `length`
    // dimmed rather than hidden, so shortening a pattern reads as hiding
    // steps rather than deleting them.
    if root.kind == 2 : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: 3px;
            y: parent.height / 2;
            width: parent.width - 6px;
            height: 1px;
            background: Theme.border;
        }
        for column in 16 : Rectangle {
            private property <float> level: clamp(root.steps[column], -1, 1);
            private property <bool> playing: column < root.step-length;
            x: 3px + column * (parent.width - 6px) / 16;
            y: 0px;
            width: max(1px, (parent.width - 6px) / 16 - 1px);
            height: parent.height;
            Rectangle {
                x: 0px;
                y: parent.height / 2 - max(0, parent.level) * (parent.height / 2 - 3px);
                width: parent.width;
                height: max(1px, abs(parent.level) * (parent.height / 2 - 3px));
                background: parent.playing ? root.line-color : Theme.text-faint;
            }
        }
    }
    // A math module has no waveform to show; the operator is the face.
    if root.kind == 4 : Text {
        width: parent.width;
        height: parent.height;
        text: MathOps.labels[root.math-op];
        color: root.line-color;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Sixteen draggable columns. One touch area rather than sixteen, so a drag
// paints across the pattern the way a step sequencer is expected to behave.
component StepBank inherits Rectangle {
    // The shelf's descriptor-indexed value array, read from `offset`: the
    // step block is contiguous, so no second model has to be built for it.
    in property <[float]> values;
    in property <int> offset;
    in property <int> length: 16;
    in property <color> line-color: Theme.accent;
    callback changed(int, float);
    callback edit-started();
    callback edit-finished();

    private property <length> gap: 2px;
    private property <length> column-width: (self.width - root.gap * 15) / 16;

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-sm;

    function paint(px: length, py: length) {
        let column = clamp(floor(px / (root.column-width + root.gap)), 0, 15);
        let level = clamp(1 - 2 * (py / max(1px, root.height)), -1, 1);
        root.changed(column, level);
    }

    Rectangle {
        x: 2px;
        y: parent.height / 2;
        width: parent.width - 4px;
        height: 1px;
        background: Theme.border;
    }
    for column in 16 : Rectangle {
        private property <float> level: clamp(root.values[root.offset + column], -1, 1);
        private property <bool> playing: column < root.length;
        x: 2px + column * (root.column-width + root.gap);
        y: 2px;
        width: root.column-width;
        height: parent.height - 4px;
        background: self.playing ? Theme.surface-raised : Theme.surface;
        border-radius: 1px;
        Rectangle {
            x: 0px;
            y: parent.height / 2 - max(0, parent.level) * parent.height / 2;
            width: parent.width;
            height: max(1px, abs(parent.level) * parent.height / 2);
            background: parent.playing ? root.line-color : Theme.text-faint;
        }
    }
    touch := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.edit-started();
                root.paint(touch.mouse-x - 2px, touch.mouse-y);
            } else if (event.kind == PointerEventKind.move && touch.pressed) {
                root.paint(touch.mouse-x - 2px, touch.mouse-y);
            } else if (event.kind == PointerEventKind.up) {
                root.edit-finished();
            }
        }
    }
}

// One module in the grid: its parameter-derived face, its name, and a live
// output meter fed from `ModulatorMeters`.
component ModuleTile inherits Rectangle {
    in property <string> name;
    in property <int> waveform;
    in property <int> kind;
    in property <float> pulse-width: 0.5;
    in property <float> amount: 1;
    in property <float> phase;
    in property <float> fade-cycles;
    in property <float> smoothing-cycles;
    in property <float> attack;
    in property <float> decay;
    in property <float> sustain: 0.7;
    in property <float> release;
    in property <[float]> steps;
    in property <int> step-length: 16;
    in property <int> math-op;
    in property <float> output;
    in property <bool> selected;
    in property <bool> armed;
    // Position in the grid, which is what a drag names. The rack slot behind
    // it is the caller's business.
    in property <int> position;
    in property <int> count;
    callback clicked();
    callback reorder-requested(int);

    width: ModuleGrid.tile-width;
    height: ModuleGrid.tile-height;
    border-radius: Theme.radius-md;
    border-width: root.selected ? 1px : 0px;
    border-color: root.armed ? Theme.focus : Theme.accent;
    background: tap.pressed ? Theme.surface-active
        : root.selected ? Theme.surface-raised : Theme.surface;

    VerticalLayout {
        padding: 2px;
        spacing: 2px;
        ModulatorShape {
            height: 22px;
            waveform: root.waveform;
            kind: root.kind;
            amount: root.amount;
            phase: root.phase;
            pulse-width: root.pulse-width;
            fade-cycles: root.fade-cycles;
            smoothing-cycles: root.smoothing-cycles;
            attack: root.attack;
            decay: root.decay;
            sustain: root.sustain;
            release: root.release;
            steps: root.steps;
            step-length: root.step-length;
            math-op: root.math-op;
            line-color: root.armed ? Theme.focus : Theme.accent;
        }
        Text {
            height: 12px;
            text: root.name;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-size: 8px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        // Live output, centre-origin: this is the one part of a tile that is
        // telemetry rather than a preview of the configured signal.
        Rectangle {
            height: 5px;
            background: Theme.surface;
            border-radius: 1px;
            Rectangle {
                x: parent.width / 2 + min(0, clamp(root.output, -1, 1)) * parent.width / 2;
                width: max(1px, abs(clamp(root.output, -1, 1)) * parent.width / 2);
                height: parent.height;
                border-radius: 1px;
                background: root.armed ? Theme.focus : Theme.accent;
            }
        }
    }
    // One gesture for both jobs, the way the effect rack's header handle
    // works: on release, a movement past half a cell moves the module and
    // anything smaller is a plain selection.
    tap := TouchArea {
        mouse-cursor: root.selected ? move : pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                let across = round((tap.mouse-x - tap.pressed-x) / (ModuleGrid.tile-width + ModuleGrid.gap));
                let down = round((tap.mouse-y - tap.pressed-y) / (ModuleGrid.tile-height + ModuleGrid.gap));
                let target = clamp(root.position + across + down * ModuleGrid.columns, 0, root.count - 1);
                if (target == root.position) {
                    root.clicked();
                } else {
                    root.reorder-requested(target);
                }
            }
        }
    }
}

component RouteRow inherits Rectangle {
    in property <string> destination;
    in property <float> depth;
    in property <int> polarity;
    in property <bool> allowed;
    callback polarity-selected(int);
    callback removed();

    height: 25px;
    background: tap.has-hover ? Theme.surface-raised : transparent;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 3px;
        spacing: 3px;
        Text {
            horizontal-stretch: 1;
            text: root.destination;
            color: root.allowed ? Theme.text : Theme.text-faint;
            font-size: 9px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 38px;
            text: (root.depth > 0 ? "+" : "") + round(root.depth * 100) + "%";
            color: root.depth == 0 ? Theme.text-faint : Theme.accent;
            font-family: "monospace";
            font-size: 9px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        ToolButton {
            text: root.polarity == 0 ? "±" : "↑";
            tooltip: root.polarity == 0 ? "Bipolar: swings around the base value" : "Unipolar: base value is the floor";
            min-width: 24px;
            max-width: 24px;
            min-height: 20px;
            max-height: 20px;
            clicked => { root.polarity-selected(root.polarity == 0 ? 1 : 0); }
        }
        ToolButton {
            text: "×";
            tooltip: "Remove this modulation route";
            min-width: 22px;
            max-width: 22px;
            min-height: 20px;
            max-height: 20px;
            text-color: Theme.text-muted;
            clicked => { root.removed(); }
        }
    }
    tap := TouchArea { }
}

// A continuously draggable knob becomes a stepped musical-division knob when
// its adjacent LED is lit. The tiny clickable lamp is intentionally the
// "O." gesture: timing mode stays visible without spending a selector row on
// every sync-capable control.
component SyncMiniKnob inherits Rectangle {
    in property <string> label;
    in property <string> free-value-text;
    in property <float> free-value;
    in property <float> free-minimum;
    in property <float> free-maximum;
    in property <float> free-default;
    in property <ValueScale> free-scale: ValueScale.linear;
    in property <bool> synced;
    in property <int> division: 7;
    callback free-changed(float);
    callback sync-changed(bool);
    callback division-changed(int);
    callback edit-started();
    callback edit-finished();

    width: 46px;
    height: 51px;


    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 9px;
        text: root.label;
        color: Theme.text-muted;
        font-size: 7px;
        horizontal-alignment: center;
    }
    MiniKnob {
        x: 9px;
        y: 10px;
        diameter: 22px;
        label: root.label;
        value: root.synced ? root.division * 1.0 : root.free-value;
        minimum: root.synced ? 0 : root.free-minimum;
        maximum: root.synced ? 20 : root.free-maximum;
        default-value: root.synced ? 7 : root.free-default;
        step: root.synced ? 1 : 0;
        scale: root.synced ? ValueScale.linear : root.free-scale;
        value-text: root.synced ? Divisions.label(root.division) : root.free-value-text;
        changed(value) => {
            if (root.synced) {
                root.division-changed(round(value));
            } else {
                root.free-changed(value);
            }
        }
        edit-started => { root.edit-started(); }
        edit-finished => { root.edit-finished(); }
    }
    sync-light := Rectangle {
        x: 33px;
        y: 17px;
        width: 11px;
        height: 11px;
        accessible-role: button;
        accessible-label: "Tempo sync " + root.label;
        LedIndicator {
            x: 1px;
            y: 1px;
            diameter: 9px;
            on: root.synced;
            tooltip: root.synced ? "Tempo sync on" : "Tempo sync off";
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.sync-changed(!root.synced); }
        }
    }
    Text {
        x: 0px;
        y: 35px;
        width: parent.width;
        height: 12px;
        text: root.synced ? Divisions.label(root.division) : root.free-value-text;
        color: root.synced ? Theme.focus : Theme.accent;
        font-size: 7px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// A labelled lamp: the same tiny clickable "O." gesture SyncMiniKnob spends
// on tempo sync, for flags that do not deserve a selector row of their own.
component LedToggle inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <string> tooltip;
    callback toggled(bool);

    height: 12px;
    accessible-role: button;
    accessible-label: root.label;

    LedIndicator {
        x: 0px;
        y: 2px;
        diameter: 8px;
        on: root.on;
        tooltip: root.tooltip;
    }
    Text {
        x: 12px;
        y: 0px;
        width: parent.width - 12px;
        height: 12px;
        text: root.label;
        color: root.on ? Theme.accent : Theme.text-muted;
        font-size: 7px;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

// The one modulation shelf belongs below the complete device rack. Its three
// modules deliberately separate the collection, the selected source's own
// control surface, and that channel's explicit destinations. This is the rack
// view of a control graph; it does not introduce patch cords or a second route
// language.
export component ModulationShelf inherits Rectangle {
    in property <bool> open;
    in property <[ModulationSourceRow]> sources;
    in property <[ModulationRouteRow]> routes;
    in property <int> selected-slot: -1;
    in property <int> selected-kind: -1;
    in property <int> armed-slot: -1;
    // The selected source's parameters, indexed by descriptor id (`LfoParam`
    // / `EnvParam` per `selected-kind`). Enums and divisions travel as
    // indices, booleans as 0/1; ids the kind lacks read 0.
    in property <[float]> selected-values;
    in property <float> selected-preview-fade-cycles;
    in property <float> selected-preview-smoothing-cycles;
    in property <[string]> input-channels;
    in property <int> selected-envelope-input-channel;
    in property <float> selected-envelope-preview-attack;
    in property <float> selected-envelope-preview-decay;
    in property <float> selected-envelope-preview-release;
    // Capacity is an engine protocol boundary, not a UI layout constant
    // (docs/MODULATOR_SYSTEM_SPEC.md), so Rust reports it. The slot names the
    // math jack picks from come from the same place, so growing the rack
    // stays a protocol edit rather than a UI one.
    in property <int> max-sources: 0;
    in property <[string]> slot-names;
    callback toggled();
    callback source-selected(int);
    // (rack slot, target position in the grid). The rack compacts as it
    // reorders, so the destination is a grid position rather than a slot.
    callback source-moved(int, int);
    callback assignment-toggled();
    // One add verb for every kind, carrying `ModulatorKind::to_index`. The
    // menu grew from two entries to five without growing the contract.
    callback source-added(int);
    // One descriptor-addressed edit path: (slot, id, value). The edit-started
    // / edit-finished pair brackets knob drags so a gesture lands as one undo
    // step; discrete edits arrive bare and record individually.
    callback param-changed(int, int, float);
    callback param-edit-started();
    callback param-edit-finished();
    callback source-removed(int);
    // The envelope's gate input is an input jack bound to a dynamic channel
    // list, not a descriptor id; it keeps its dedicated verb.
    callback envelope-input-channel-changed(int, int);
    callback route-polarity-changed(int, int);
    callback route-removed(int);

    private property <bool> add-source-menu-open: false;
    private property <bool> assigning: root.armed-slot >= 0;

    pure function kind-name(kind: int) -> string {
        return kind == 0 ? "LFO" : kind == 1 ? "ENVELOPE" : kind == 2 ? "STEP"
            : kind == 3 ? "RANDOM" : "MATH";
    }
    pure function kind-signal(kind: int) -> string {
        return kind == 1 ? "UNIPOLAR"
            : kind == 2 ? "STEPPED"
            : kind == 3 ? (root.selected-values[RandomParam.bipolar] > 0.5 ? "STEPPED" : "STEPPED UNIPOLAR")
            : "BIPOLAR";
    }
    // What a module's one input is called, and what it is worth saying about
    // it once it is connected.
    pure function jack-label(kind: int) -> string {
        return kind == 0 ? "RESET" : kind == 1 ? "GATE" : kind == 4 ? "INPUT" : "CLOCK";
    }
    pure function jack-note(kind: int) -> string {
        if (kind == 1) { return "CHANNEL NOTE GATE"; }
        if (kind == 4) {
            return round(root.selected-values[MathParam.input-slot]) < root.selected-slot
                ? "READS THIS TICK" : "READS THE PREVIOUS TICK";
        }
        return "";
    }
    pure function kind-badge(kind: int) -> string {
        return kind == 0 ? "LFO" : kind == 1 ? "ENV" : kind == 2 ? "STEP"
            : kind == 3 ? "RND" : "MATH";
    }
    pure function kind-tooltip(kind: int) -> string {
        return kind == 0 ? "Add a low-frequency oscillator"
            : kind == 1 ? "Add a gate-driven ADSR envelope"
            : kind == 2 ? "Add a clocked step pattern"
            : kind == 3 ? "Add a sample-and-hold random source"
            : "Add a math module that reads another slot";
    }

    height: root.open ? ModulationShelfMetrics.open-height : ModulationShelfMetrics.closed-height;
    border-width: 1px;
    border-color: root.assigning ? Theme.accent : Theme.border;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        header := Rectangle {
            height: 29px;
            background: header-touch.has-hover ? Theme.surface-raised : Theme.panel;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 7px;
                Text {
                    width: 68px;
                    text: "MODULATION";
                    color: root.open || root.assigning ? Theme.accent : Theme.text-muted;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.sources.length + " source" + (root.sources.length == 1 ? "" : "s")
                        + "  ·  " + root.routes.length + " route" + (root.routes.length == 1 ? "" : "s");
                    color: Theme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.assigning : Rectangle {
                    width: 108px;
                    height: 18px;
                    border-radius: Theme.radius-sm;
                    background: Theme.accent-active;
                    Text {
                        text: "ASSIGN · " + root.kind-badge(root.selected-kind) + " " + (root.armed-slot + 1);
                        color: Theme.focus;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.open ? "⌃" : "⌄";
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            header-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(); }
            }
        }

        if root.open : Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                padding: 6px;
                spacing: 6px;

                // The grid. Every module is one tile with its own face and a
                // live output meter; the rack underneath is unchanged, which
                // is what keeps this a presentation rather than an engine
                // step (docs/plans/modulator-modules/03-the-grid.md).
                Rectangle {
                    width: ModuleGrid.row-width + 10px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 3px;
                        HorizontalLayout {
                            height: 10px;
                            Text { text: "MODULES"; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.sources.length + "/" + root.max-sources; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            width: ModuleGrid.row-width;
                            for source[index] in root.sources : ModuleTile {
                                x: mod(index, ModuleGrid.columns) * (ModuleGrid.tile-width + ModuleGrid.gap);
                                y: floor(index / ModuleGrid.columns) * (ModuleGrid.tile-height + ModuleGrid.gap);
                                name: source.name;
                                kind: source.kind;
                                waveform: source.waveform;
                                pulse-width: source.pulse-width;
                                amount: source.depth;
                                phase: source.phase;
                                fade-cycles: source.preview-fade-cycles;
                                smoothing-cycles: source.preview-smoothing-cycles;
                                attack: source.preview-attack;
                                decay: source.preview-decay;
                                sustain: source.preview-sustain;
                                release: source.preview-release;
                                steps: source.steps;
                                step-length: source.step-length;
                                math-op: source.math-op;
                                output: source.output;
                                selected: source.selected;
                                armed: root.armed-slot == source.slot;
                                position: index;
                                count: root.sources.length;
                                clicked => {
                                    root.add-source-menu-open = false;
                                    root.source-selected(source.slot);
                                }
                                reorder-requested(target) => {
                                    root.add-source-menu-open = false;
                                    root.source-moved(source.slot, target);
                                }
                            }
                            // The add affordance takes the next free cell, so
                            // the grid reads as filling rather than as a wall
                            // of permanent empty bays.
                            if root.sources.length < root.max-sources && !root.add-source-menu-open : ToolButton {
                                x: mod(root.sources.length, ModuleGrid.columns) * (ModuleGrid.tile-width + ModuleGrid.gap);
                                y: floor(root.sources.length / ModuleGrid.columns) * (ModuleGrid.tile-height + ModuleGrid.gap);
                                width: ModuleGrid.tile-width;
                                height: ModuleGrid.tile-height;
                                text: "+";
                                tooltip: "Add a control module";
                                clicked => { root.add-source-menu-open = true; }
                            }
                            if root.add-source-menu-open : Rectangle {
                                x: 0px;
                                y: 0px;
                                width: ModuleGrid.row-width;
                                height: ModuleGrid.column-height;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.accent;
                                border-radius: Theme.radius-sm;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 3px;
                                    HorizontalLayout {
                                        height: 10px;
                                        Text { text: "ADD MODULE"; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        ToolButton {
                                            text: "×";
                                            tooltip: "Cancel";
                                            min-width: 18px; max-width: 18px; min-height: 10px; max-height: 10px;
                                            text-color: Theme.text-muted;
                                            clicked => { root.add-source-menu-open = false; }
                                        }
                                    }
                                    for row in [{ left: 0, right: 1 }, { left: 2, right: 3 }, { left: 4, right: -1 }] : HorizontalLayout {
                                        spacing: 4px;
                                        ToolButton {
                                            text: root.kind-badge(row.left);
                                            tooltip: root.kind-tooltip(row.left);
                                            clicked => {
                                                root.add-source-menu-open = false;
                                                root.source-added(row.left);
                                            }
                                        }
                                        if row.right >= 0 : ToolButton {
                                            text: root.kind-badge(row.right);
                                            tooltip: root.kind-tooltip(row.right);
                                            clicked => {
                                                root.add-source-menu-open = false;
                                                root.source-added(row.right);
                                            }
                                        }
                                        if row.right < 0 : Rectangle { }
                                    }
                                }
                            }
                        }
                    }
                }

                // The selected module, expanded: one header and one jack
                // strip for every kind, then that kind's own knob surface,
                // with its destinations underneath.
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Rectangle {
                        vertical-stretch: 1;
                        border-width: 1px;
                        border-color: root.assigning ? Theme.accent : Theme.border;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 3px;
                            if root.selected-slot >= 0 : HorizontalLayout {
                                height: 15px;
                                spacing: 5px;
                                Text {
                                    text: root.kind-name(root.selected-kind) + " " + (root.selected-slot + 1);
                                    color: Theme.text;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.kind-signal(root.selected-kind) + "  ·  32 FRAME";
                                    color: Theme.text-faint;
                                    font-size: 7px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ToggleButton {
                                    text: root.assigning ? "ASSIGNING" : "ASSIGN";
                                    tooltip: root.assigning
                                        ? "Stop assigning routes and edit base values"
                                        : "Assign this module to highlighted controls";
                                    checked: root.assigning;
                                    min-width: 82px; max-width: 82px; min-height: 15px; max-height: 15px;
                                    toggled(value) => { root.assignment-toggled(); }
                                }
                                ToolButton {
                                    text: "×";
                                    tooltip: "Remove this module and its routes";
                                    min-width: 22px; max-width: 22px; min-height: 15px; max-height: 15px;
                                    text-color: Theme.text-muted;
                                    clicked => { root.source-removed(root.selected-slot); }
                                }
                            }
                            // Inputs are jacks, not knobs. A module's gate,
                            // clock, or source slot is what it is patched to,
                            // so it reads as a connection rather than as one
                            // more parameter in the row.
                            if root.selected-slot >= 0 : Rectangle {
                                height: 22px;
                                background: Theme.surface;
                                border-radius: Theme.radius-sm;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    spacing: 5px;
                                    alignment: start;
                                    Text {
                                        width: 46px;
                                        text: root.jack-label(root.selected-kind);
                                        color: Theme.text-faint;
                                        font-size: 7px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        width: 9px;
                                        text: "\u{25c0}";
                                        color: root.selected-kind == 0 && root.selected-values[LfoParam.retrigger] < 0.5
                                            ? Theme.text-faint : Theme.accent;
                                        font-size: 8px;
                                        vertical-alignment: center;
                                    }
                                    if root.selected-kind == 0 : SelectorBank {
                                        height: 16px;
                                        options: ["FREE", "NOTE ON"];
                                        selected-index: root.selected-values[LfoParam.retrigger] > 0.5 ? 1 : 0;
                                        segment-width: 54px;
                                        tooltip: "Input signal that restarts this LFO";
                                        selected(index) => { root.param-changed(root.selected-slot, LfoParam.retrigger, index); }
                                    }
                                    if root.selected-kind == 1 : gate-input := ComboBox {
                                        width: 150px;
                                        height: 18px;
                                        model: root.input-channels;
                                        current-index: root.selected-envelope-input-channel;
                                        selected(value) => { root.envelope-input-channel-changed(root.selected-slot, gate-input.current-index); }
                                    }
                                    if root.selected-kind == 2 : SelectorBank {
                                        height: 16px;
                                        options: ["TRANSPORT", "NOTE ON"];
                                        selected-index: round(root.selected-values[StepParam.trigger]);
                                        segment-width: 62px;
                                        tooltip: "Advance from the transport clock, or one step per note";
                                        selected(index) => { root.param-changed(root.selected-slot, StepParam.trigger, index); }
                                    }
                                    if root.selected-kind == 3 : SelectorBank {
                                        height: 16px;
                                        options: ["TRANSPORT", "NOTE ON"];
                                        selected-index: round(root.selected-values[RandomParam.trigger]);
                                        segment-width: 62px;
                                        tooltip: "Draw on the clock, or once per note";
                                        selected(index) => { root.param-changed(root.selected-slot, RandomParam.trigger, index); }
                                    }
                                    if root.selected-kind == 4 : SelectorBank {
                                        height: 16px;
                                        options: root.slot-names;
                                        selected-index: round(root.selected-values[MathParam.input-slot]);
                                        segment-width: 26px;
                                        tooltip: "Module this one reads. A lower slot resolves this tick; itself or a higher one reads the previous tick";
                                        selected(index) => { root.param-changed(root.selected-slot, MathParam.input-slot, index); }
                                    }
                                    Text {
                                        text: root.jack-note(root.selected-kind);
                                        color: Theme.text-faint;
                                        font-size: 7px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            // The module pane is a layout now, so the empty
                            // state takes its width from the layout rather
                            // than reading it back off its parent.
                            if root.selected-slot < 0 : Text {
                                vertical-stretch: 1;
                                text: root.sources.length == 0
                                    ? "Add a module to begin."
                                    : "Select a module to open its surface.";
                                color: Theme.text-muted;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                if root.selected-slot >= 0 && root.selected-kind == 0 : VerticalLayout {
                    padding: 3px;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 4px;
                        ModulatorShape {
                            width: 68px;
                            height: 40px;
                            waveform: round(root.selected-values[LfoParam.waveform]);
                            kind: 0;
                            amount: root.selected-values[LfoParam.depth];
                            phase: root.selected-values[LfoParam.phase];
                            pulse-width: root.selected-values[LfoParam.pulse-width];
                            fade-cycles: root.selected-preview-fade-cycles;
                            smoothing-cycles: root.selected-preview-smoothing-cycles;
                            line-color: root.assigning ? Theme.focus : Theme.accent;
                        }
                        VerticalLayout {
                            width: 154px;
                            spacing: 2px;
                            HorizontalLayout {
                                height: 19px;
                                spacing: 3px;
                                Text { width: 30px; text: "SHAPE"; color: Theme.text-faint; font-size: 7px; vertical-alignment: center; }
                                SelectorBank {
                                    options: ["SIN", "TRI", "SAW", "SQR", "RND"];
                                    selected-index: round(root.selected-values[LfoParam.waveform]);
                                    segment-width: 24px;
                                    min-height: 18px;
                                    max-height: 18px;
                                    tooltip: "LFO waveform";
                                    selected(index) => { root.param-changed(root.selected-slot, LfoParam.waveform, index); }
                                }
                            }
                        }
                        SyncMiniKnob {
                            label: "RATE";
                            free-value: root.selected-values[LfoParam.rate];
                            free-minimum: 0.05;
                            free-maximum: 20;
                            free-default: 1;
                            free-scale: ValueScale.logarithmic;
                            free-value-text: round(root.selected-values[LfoParam.rate] * 10) / 10 + " Hz";
                            synced: root.selected-values[LfoParam.tempo-sync] > 0.5;
                            division: round(root.selected-values[LfoParam.rate-division]);
                            free-changed(value) => { root.param-changed(root.selected-slot, LfoParam.rate, value); }
                            sync-changed(value) => { root.param-changed(root.selected-slot, LfoParam.tempo-sync, value ? 1 : 0); }
                            division-changed(value) => { root.param-changed(root.selected-slot, LfoParam.rate-division, value); }
                            edit-started => { root.param-edit-started(); }
                            edit-finished => { root.param-edit-finished(); }
                        }
                        SyncMiniKnob {
                            label: "FADE";
                            free-value: root.selected-values[LfoParam.fade-in];
                            free-minimum: 0;
                            free-maximum: 16;
                            free-default: 0;
                            free-value-text: root.selected-values[LfoParam.fade-in] < 1
                                ? round(root.selected-values[LfoParam.fade-in] * 1000) + " ms"
                                : round(root.selected-values[LfoParam.fade-in] * 10) / 10 + " s";
                            synced: root.selected-values[LfoParam.fade-sync] > 0.5;
                            division: round(root.selected-values[LfoParam.fade-division]);
                            free-changed(value) => { root.param-changed(root.selected-slot, LfoParam.fade-in, value); }
                            sync-changed(value) => { root.param-changed(root.selected-slot, LfoParam.fade-sync, value ? 1 : 0); }
                            division-changed(value) => { root.param-changed(root.selected-slot, LfoParam.fade-division, value); }
                            edit-started => { root.param-edit-started(); }
                            edit-finished => { root.param-edit-finished(); }
                        }
                        VerticalLayout {
                            width: 40px;
                            height: 51px;
                            spacing: 1px;
                            alignment: center;
                            Text { height: 8px; text: "AMOUNT"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "LFO source amount";
                                value: root.selected-values[LfoParam.depth];
                                default-value: 1;
                                value-text: round(root.selected-values[LfoParam.depth] * 100) + "%";
                                diameter: 20px;
                                changed(value) => { root.param-changed(root.selected-slot, LfoParam.depth, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[LfoParam.depth] * 100) + "%"; color: Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 40px;
                            height: 51px;
                            spacing: 1px;
                            alignment: center;
                            Text { height: 8px; text: "PHASE"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "LFO reset phase";
                                value: root.selected-values[LfoParam.phase];
                                default-value: 0;
                                value-text: round(root.selected-values[LfoParam.phase] * 360) + "\u{b0}";
                                diameter: 20px;
                                changed(value) => { root.param-changed(root.selected-slot, LfoParam.phase, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[LfoParam.phase] * 360) + "\u{b0}"; color: Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 40px;
                            height: 51px;
                            spacing: 1px;
                            alignment: center;
                            Text { height: 8px; text: "SMOOTH"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "LFO smoothing";
                                value: root.selected-values[LfoParam.smoothing];
                                minimum: 0;
                                maximum: 2;
                                default-value: 0;
                                value-text: root.selected-values[LfoParam.smoothing] <= 0.0001 ? "OFF"
                                    : round(root.selected-values[LfoParam.smoothing] * 1000) + " ms";
                                diameter: 20px;
                                changed(value) => { root.param-changed(root.selected-slot, LfoParam.smoothing, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: root.selected-values[LfoParam.smoothing] <= 0.0001 ? "OFF" : round(root.selected-values[LfoParam.smoothing] * 1000) + "ms"; color: Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 40px;
                            height: 51px;
                            spacing: 1px;
                            alignment: center;
                            Text { height: 8px; text: "P WIDTH"; color: round(root.selected-values[LfoParam.waveform]) == 3 ? Theme.text-muted : Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Square pulse width";
                                value: root.selected-values[LfoParam.pulse-width];
                                minimum: 0.01;
                                maximum: 0.99;
                                default-value: 0.5;
                                enabled: round(root.selected-values[LfoParam.waveform]) == 3;
                                value-text: round(root.selected-values[LfoParam.pulse-width] * 100) + "%";
                                diameter: 20px;
                                changed(value) => { root.param-changed(root.selected-slot, LfoParam.pulse-width, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[LfoParam.pulse-width] * 100) + "%"; color: round(root.selected-values[LfoParam.waveform]) == 3 ? Theme.accent : Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                if root.selected-slot >= 0 && root.selected-kind == 1 : VerticalLayout {
                    padding: 3px;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 4px;
                        ModulatorShape {
                            width: 68px;
                            height: 40px;
                            kind: 1;
                            waveform: 0;
                            amount: root.selected-values[EnvParam.amount];
                            attack: root.selected-envelope-preview-attack;
                            decay: root.selected-envelope-preview-decay;
                            sustain: root.selected-values[EnvParam.sustain];
                            release: root.selected-envelope-preview-release;
                            line-color: root.assigning ? Theme.focus : Theme.accent;
                        }
                        SyncMiniKnob {
                            label: "ATTACK"; free-value: root.selected-values[EnvParam.attack]; free-minimum: 0; free-maximum: 16; free-default: 0.01;
                            free-value-text: root.selected-values[EnvParam.attack] < 1 ? round(root.selected-values[EnvParam.attack] * 1000) + " ms" : round(root.selected-values[EnvParam.attack] * 10) / 10 + " s";
                            synced: root.selected-values[EnvParam.attack-sync] > 0.5;
                            division: round(root.selected-values[EnvParam.attack-division]);
                            free-changed(value) => { root.param-changed(root.selected-slot, EnvParam.attack, value); }
                            sync-changed(value) => { root.param-changed(root.selected-slot, EnvParam.attack-sync, value ? 1 : 0); }
                            division-changed(value) => { root.param-changed(root.selected-slot, EnvParam.attack-division, value); }
                            edit-started => { root.param-edit-started(); }
                            edit-finished => { root.param-edit-finished(); }
                        }
                        SyncMiniKnob {
                            label: "DECAY"; free-value: root.selected-values[EnvParam.decay]; free-minimum: 0; free-maximum: 16; free-default: 0.2;
                            free-value-text: root.selected-values[EnvParam.decay] < 1 ? round(root.selected-values[EnvParam.decay] * 1000) + " ms" : round(root.selected-values[EnvParam.decay] * 10) / 10 + " s";
                            synced: root.selected-values[EnvParam.decay-sync] > 0.5;
                            division: round(root.selected-values[EnvParam.decay-division]);
                            free-changed(value) => { root.param-changed(root.selected-slot, EnvParam.decay, value); }
                            sync-changed(value) => { root.param-changed(root.selected-slot, EnvParam.decay-sync, value ? 1 : 0); }
                            division-changed(value) => { root.param-changed(root.selected-slot, EnvParam.decay-division, value); }
                            edit-started => { root.param-edit-started(); }
                            edit-finished => { root.param-edit-finished(); }
                        }
                        VerticalLayout {
                            width: 40px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "SUSTAIN"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Envelope sustain";
                                value: root.selected-values[EnvParam.sustain];
                                default-value: 0.7;
                                value-text: round(root.selected-values[EnvParam.sustain] * 100) + "%";
                                diameter: 20px;
                                changed(value) => { root.param-changed(root.selected-slot, EnvParam.sustain, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[EnvParam.sustain] * 100) + "%"; color: Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        SyncMiniKnob {
                            label: "RELEASE"; free-value: root.selected-values[EnvParam.release]; free-minimum: 0; free-maximum: 16; free-default: 0.4;
                            free-value-text: root.selected-values[EnvParam.release] < 1 ? round(root.selected-values[EnvParam.release] * 1000) + " ms" : round(root.selected-values[EnvParam.release] * 10) / 10 + " s";
                            synced: root.selected-values[EnvParam.release-sync] > 0.5;
                            division: round(root.selected-values[EnvParam.release-division]);
                            free-changed(value) => { root.param-changed(root.selected-slot, EnvParam.release, value); }
                            sync-changed(value) => { root.param-changed(root.selected-slot, EnvParam.release-sync, value ? 1 : 0); }
                            division-changed(value) => { root.param-changed(root.selected-slot, EnvParam.release-division, value); }
                            edit-started => { root.param-edit-started(); }
                            edit-finished => { root.param-edit-finished(); }
                        }
                        VerticalLayout {
                            width: 40px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "AMOUNT"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Envelope amount";
                                value: root.selected-values[EnvParam.amount];
                                default-value: 1;
                                value-text: round(root.selected-values[EnvParam.amount] * 100) + "%";
                                diameter: 20px;
                                changed(value) => { root.param-changed(root.selected-slot, EnvParam.amount, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[EnvParam.amount] * 100) + "%"; color: Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                if root.selected-slot >= 0 && root.selected-kind == 2 : VerticalLayout {
                    padding: 3px;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 4px;
                        StepBank {
                            horizontal-stretch: 1;
                            height: 51px;
                            values: root.selected-values;
                            offset: StepParam.value-base;
                            length: round(root.selected-values[StepParam.length]);
                            line-color: root.assigning ? Theme.focus : Theme.accent;
                            changed(column, level) => {
                                root.param-changed(root.selected-slot, StepParam.value-base + column, level);
                            }
                            edit-started => { root.param-edit-started(); }
                            edit-finished => { root.param-edit-finished(); }
                        }
                        VerticalLayout {
                            width: 44px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "RATE"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Step rate";
                                value: root.selected-values[StepParam.division];
                                minimum: 0;
                                maximum: 20;
                                default-value: 13;
                                step: 1;
                                diameter: 22px;
                                value-text: Divisions.label(round(root.selected-values[StepParam.division]));
                                changed(value) => { root.param-changed(root.selected-slot, StepParam.division, round(value)); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: Divisions.label(round(root.selected-values[StepParam.division])); color: Theme.focus; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 40px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "LENGTH"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Steps played";
                                value: root.selected-values[StepParam.length];
                                minimum: 1;
                                maximum: 16;
                                default-value: 8;
                                step: 1;
                                diameter: 20px;
                                value-text: round(root.selected-values[StepParam.length]) + "";
                                changed(value) => { root.param-changed(root.selected-slot, StepParam.length, round(value)); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[StepParam.length]) + " STEPS"; color: Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 40px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "GLIDE"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Step glide";
                                value: root.selected-values[StepParam.glide];
                                default-value: 0;
                                diameter: 20px;
                                value-text: root.selected-values[StepParam.glide] <= 0.0001 ? "OFF"
                                    : round(root.selected-values[StepParam.glide] * 100) + "%";
                                changed(value) => { root.param-changed(root.selected-slot, StepParam.glide, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: root.selected-values[StepParam.glide] <= 0.0001 ? "OFF" : round(root.selected-values[StepParam.glide] * 100) + "%"; color: Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                if root.selected-slot >= 0 && root.selected-kind == 3 : VerticalLayout {
                    padding: 3px;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 4px;
                        ModulatorShape {
                            width: 68px;
                            height: 46px;
                            kind: 3;
                            line-color: root.assigning ? Theme.focus : Theme.accent;
                        }
                        SyncMiniKnob {
                            label: "RATE";
                            free-value: root.selected-values[RandomParam.rate];
                            free-minimum: 0.05;
                            free-maximum: 20;
                            free-default: 2;
                            free-scale: ValueScale.logarithmic;
                            free-value-text: round(root.selected-values[RandomParam.rate] * 100) / 100 + " Hz";
                            synced: root.selected-values[RandomParam.tempo-sync] > 0.5;
                            division: round(root.selected-values[RandomParam.rate-division]);
                            free-changed(value) => { root.param-changed(root.selected-slot, RandomParam.rate, value); }
                            sync-changed(value) => { root.param-changed(root.selected-slot, RandomParam.tempo-sync, value ? 1 : 0); }
                            division-changed(value) => { root.param-changed(root.selected-slot, RandomParam.rate-division, value); }
                            edit-started => { root.param-edit-started(); }
                            edit-finished => { root.param-edit-finished(); }
                        }
                        VerticalLayout {
                            width: 42px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "CHANCE"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Chance a due draw lands";
                                value: root.selected-values[RandomParam.probability];
                                default-value: 1;
                                diameter: 20px;
                                value-text: round(root.selected-values[RandomParam.probability] * 100) + "%";
                                changed(value) => { root.param-changed(root.selected-slot, RandomParam.probability, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[RandomParam.probability] * 100) + "%"; color: Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 42px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "QUANT"; color: Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Levels a draw snaps to";
                                value: root.selected-values[RandomParam.quantize];
                                minimum: 0;
                                maximum: 16;
                                default-value: 0;
                                step: 1;
                                diameter: 20px;
                                value-text: round(root.selected-values[RandomParam.quantize]) < 2 ? "OFF"
                                    : round(root.selected-values[RandomParam.quantize]) + "";
                                changed(value) => { root.param-changed(root.selected-slot, RandomParam.quantize, round(value)); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[RandomParam.quantize]) < 2 ? "OFF" : round(root.selected-values[RandomParam.quantize]) + " LVL"; color: Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 42px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "WALK"; color: root.selected-values[RandomParam.drunk] > 0.5 ? Theme.text-muted : Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Largest drunk step";
                                value: root.selected-values[RandomParam.walk];
                                minimum: 0.01;
                                maximum: 1;
                                default-value: 0.25;
                                enabled: root.selected-values[RandomParam.drunk] > 0.5;
                                diameter: 20px;
                                value-text: round(root.selected-values[RandomParam.walk] * 100) + "%";
                                changed(value) => { root.param-changed(root.selected-slot, RandomParam.walk, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[RandomParam.walk] * 100) + "%"; color: root.selected-values[RandomParam.drunk] > 0.5 ? Theme.accent : Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 132px; height: 51px; spacing: 1px;
                            // Two lamps on one row: the panel has 51px to
                            // spend and a clipped flag is worse than a
                            // tighter one.
                            HorizontalLayout {
                                height: 12px;
                                spacing: 4px;
                            LedToggle {
                                width: 60px;
                                label: "BIPOLAR";
                                on: root.selected-values[RandomParam.bipolar] > 0.5;
                                tooltip: "Draw across −1..1 rather than 0..1";
                                toggled(value) => { root.param-changed(root.selected-slot, RandomParam.bipolar, value ? 1 : 0); }
                            }
                            LedToggle {
                                width: 56px;
                                label: "DRUNK";
                                on: root.selected-values[RandomParam.drunk] > 0.5;
                                tooltip: "Walk from the held value instead of jumping";
                                toggled(value) => { root.param-changed(root.selected-slot, RandomParam.drunk, value ? 1 : 0); }
                            }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                if root.selected-slot >= 0 && root.selected-kind == 4 : VerticalLayout {
                    padding: 3px;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 4px;
                        VerticalLayout {
                            width: 218px; height: 51px; spacing: 2px;
                            Text { height: 8px; text: "OPERATOR"; color: Theme.text-muted; font-size: 7px; }
                            SelectorBank {
                                height: 20px;
                                options: MathOps.labels;
                                selected-index: round(root.selected-values[MathParam.op]);
                                segment-width: 30px;
                                tooltip: "What this module does to its input";
                                selected(index) => { root.param-changed(root.selected-slot, MathParam.op, index); }
                            }
                            Text {
                                height: 10px;
                                text: round(root.selected-values[MathParam.op]) == MathOps.clamp-index
                                    ? "SLOT " + (round(root.selected-values[MathParam.input-slot]) + 1)
                                        + " → " + round(root.selected-values[MathParam.clamp-low] * 100) / 100
                                        + "…" + round(root.selected-values[MathParam.clamp-high] * 100) / 100
                                    : "SLOT " + (round(root.selected-values[MathParam.input-slot]) + 1)
                                        + " " + MathOps.labels[round(root.selected-values[MathParam.op])]
                                        + " " + round(root.selected-values[MathParam.operand] * 100) / 100;
                                color: Theme.accent;
                                font-size: 7px;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            width: 44px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "OPERAND"; color: round(root.selected-values[MathParam.op]) == MathOps.clamp-index ? Theme.text-faint : Theme.text-muted; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Constant operand";
                                value: root.selected-values[MathParam.operand];
                                minimum: -4;
                                maximum: 4;
                                default-value: 1;
                                bipolar: true;
                                enabled: round(root.selected-values[MathParam.op]) != MathOps.clamp-index;
                                diameter: 22px;
                                value-text: round(root.selected-values[MathParam.operand] * 100) / 100 + "";
                                changed(value) => { root.param-changed(root.selected-slot, MathParam.operand, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[MathParam.operand] * 100) / 100 + ""; color: round(root.selected-values[MathParam.op]) == MathOps.clamp-index ? Theme.text-faint : Theme.accent; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 42px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "LOW"; color: round(root.selected-values[MathParam.op]) == MathOps.clamp-index ? Theme.text-muted : Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Clamp floor";
                                value: root.selected-values[MathParam.clamp-low];
                                minimum: -1;
                                maximum: 1;
                                default-value: -1;
                                bipolar: true;
                                enabled: round(root.selected-values[MathParam.op]) == MathOps.clamp-index;
                                diameter: 20px;
                                value-text: round(root.selected-values[MathParam.clamp-low] * 100) / 100 + "";
                                changed(value) => { root.param-changed(root.selected-slot, MathParam.clamp-low, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[MathParam.clamp-low] * 100) / 100 + ""; color: round(root.selected-values[MathParam.op]) == MathOps.clamp-index ? Theme.accent : Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            width: 42px; height: 51px; spacing: 1px; alignment: center;
                            Text { height: 8px; text: "HIGH"; color: round(root.selected-values[MathParam.op]) == MathOps.clamp-index ? Theme.text-muted : Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
                            MiniKnob {
                                label: "Clamp ceiling";
                                value: root.selected-values[MathParam.clamp-high];
                                minimum: -1;
                                maximum: 1;
                                default-value: 1;
                                bipolar: true;
                                enabled: round(root.selected-values[MathParam.op]) == MathOps.clamp-index;
                                diameter: 20px;
                                value-text: round(root.selected-values[MathParam.clamp-high] * 100) / 100 + "";
                                changed(value) => { root.param-changed(root.selected-slot, MathParam.clamp-high, value); }
                                edit-started => { root.param-edit-started(); }
                                edit-finished => { root.param-edit-finished(); }
                            }
                            Text { height: 8px; text: round(root.selected-values[MathParam.clamp-high] * 100) / 100 + ""; color: round(root.selected-values[MathParam.op]) == MathOps.clamp-index ? Theme.accent : Theme.text-faint; font-size: 7px; horizontal-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                        }
                    }
            // Destination-first route inspector. More routes scroll in
            // this same module; a matrix is not required for ordinary use.
            Rectangle {
                horizontal-stretch: 1;
                min-width: 170px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.panel;
                VerticalLayout {
                    padding: 3px;
                    spacing: 3px;
                    HorizontalLayout {
                        height: 10px;
                        Text { text: "DESTINATIONS"; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.routes.length + " ROUTES"; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
                    }
                    if root.routes.length == 0 : Text {
                        text: root.assigning
                            ? "Drag a highlighted parameter to create a route."
                            : root.selected-slot < 0
                                ? "Select a source to inspect or assign it."
                                : "Choose Assign, then drag a destination.";
                        color: Theme.text-muted;
                        font-size: 9px;
                        wrap: word-wrap;
                    }
                    if root.routes.length > 0 : ScrollView {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        viewport-width: self.visible-width;
                        viewport-height: max(self.visible-height, root.routes.length * 25px);
                        VerticalLayout {
                            spacing: 1px;
                            for route in root.routes : RouteRow {
                                destination: route.destination;
                                depth: route.depth;
                                polarity: route.polarity;
                                allowed: route.allowed;
                                polarity-selected(value) => {
                                    root.route-polarity-changed(route.route-index, value);
                                }
                                removed => { root.route-removed(route.route-index); }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    }
                }
                }
            }
        }
    }
}
