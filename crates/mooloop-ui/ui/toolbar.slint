import { StatusHint, Theme } from "theme.slint";
import { BbtText, Gesture } from "controls.slint";
import { Icon } from "icons.slint";

// Toolbar vocabulary.
//
// The bar had been assembled from bare Text elements with TouchAreas glued on,
// so tempo did not read as a control and unrelated clusters carried equal
// visual weight. These are the pieces it should have been built from: every
// field is the same height, numerics are tabular, and grouping is explicit.

// The toolbar's own names for three of `Theme`'s tokens. Kept as an alias
// rather than swept away so the bar's call sites stay readable -- `value-size`
// says what the number is for, where `text-2xl` says only how big it is.
export global ToolbarMetrics {
    out property <length> control-height: Theme.control-height;
    out property <length> label-size: Theme.text-md;
    out property <length> value-size: Theme.text-2xl;
}

// Hairline group separator. Grouping is the whole point of the bar, so it gets
// a real element rather than another anonymous spacer Rectangle.
export component ToolbarRule inherits Rectangle {
    width: 9px;
    Rectangle {
        x: 4px;
        width: 1px;
        height: parent.height * 0.62;
        y: (parent.height - self.height) / 2;
        background: Theme.border;
    }
}

export component ToolbarLabel inherits Text {
    color: Theme.text-faint;
    font-size: ToolbarMetrics.label-size;
    vertical-alignment: center;
    letter-spacing: 0.5px;
}

// A small square repeat-free arrow used by the steppers.
component StepperArrow inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    /// True when the click carried Shift, so the caller can move by its
    /// coarse step. Reported rather than decided here: an arrow does not
    /// know what a coarse step is worth.
    callback clicked(bool);

    width: 16px;
    background: touch.pressed && root.enabled ? Theme.surface-active
        : touch.has-hover && root.enabled ? Theme.surface-raised : transparent;
    border-radius: Theme.radius-sm;

    Text {
        text: root.glyph;
        color: root.enabled ? Theme.text-muted : Theme.text-faint;
        font-size: Theme.text-lg;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.clicked(e.modifiers.shift);
            }
        }
    }
}

// Integer field with prev/next arrows and vertical drag on the value. Replaces
// the stock SpinBox, which was the one control in the app that ignored the
// theme entirely.
export component StepperField inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    /// The sentence explaining the field, for the status bar. The tooltip
    /// above stays a label; see `StatusHint`.
    in property <string> hint;
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 999;
    in property <int> step: 1;
    /// What Shift moves by, when that is worth more than the ordinary step.
    /// Adam, of getting a pattern from sixteen steps to thirty-two: "maybe
    /// shift click moves by 4 or something". Zero leaves Shift alone.
    in property <int> coarse-step: 0;
    in property <bool> enabled: true;
    /// Whether the owner writes `value`; see `ParameterKnob.controlled` in
    /// `controls.slint`, whose default this shares.
    in property <bool> controlled: true;
    in property <string> display-text: root.value;
    in property <length> value-width: 30px;
    in property <brush> field-background: Theme.surface-raised;
    callback changed(int);

    private property <int> pressed-value;

    height: ToolbarMetrics.control-height;
    width: layout.preferred-width;
    border-radius: Theme.radius-md;
    background: root.field-background;
    opacity: root.enabled ? 1.0 : 0.45;
    accessible-role: spinbox;
    accessible-label: root.tooltip;
    accessible-value: root.display-text;

    pure function move(coarse: bool) -> int {
        return coarse && root.coarse-step > 0 ? root.coarse-step : root.step;
    }

    function apply(next: int) {
        if (!root.enabled) { return; }
        let clamped = clamp(next, root.minimum, root.maximum);
        if (clamped != root.value) {
            if (!root.controlled) { root.value = clamped; }
            root.changed(clamped);
        }
    }

    layout := HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        spacing: 1px;

        if root.label != "" : ToolbarLabel {
            text: root.label;
            vertical-alignment: center;
        }
        if root.label != "" : Rectangle { width: 4px; }

        StepperArrow {
            glyph: "‹";
            enabled: root.enabled && root.value > root.minimum;
            clicked(coarse) => { root.apply(root.value - root.move(coarse)); }
        }
        // `value-width` is pinned so the field does not jitter as the number
        // changes, and every caller measured its pin at 13px text. So the pin
        // grows with the text rather than clipping it -- at the 115% base
        // (MOO-286) and above -- and never shrinks under what was asked for.
        Rectangle {
            width: max(root.value-width, root.value-width * ToolbarMetrics.value-size / 13px);
            Text {
                text: root.display-text;
                color: root.enabled ? Theme.text : Theme.text-faint;
                font-size: ToolbarMetrics.value-size;
                font-family: Theme.font-family-mono;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            // Dragging the number is faster than clicking an arrow 16 times.
            drag := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? ns-resize : default;
                changed has-hover => {
                    if (self.has-hover) { StatusHint.show(root.hint); }
                    else { StatusHint.clear(root.hint); }
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.pressed-value = root.value;
                        Gesture.begin();
                    } else if (e.kind == PointerEventKind.move && self.pressed) {
                        root.apply(root.pressed-value
                            + round((self.pressed-y - self.mouse-y) / 4px) * root.step);
                    } else if (e.kind == PointerEventKind.up) {
                        Gesture.end();
                    }
                }
                scroll-event(e) => {
                    let by = root.move(e.modifiers.shift);
                    root.apply(root.value + (e.delta-y > 0 ? by : -by));
                    accept
                }
            }
        }
        StepperArrow {
            glyph: "›";
            enabled: root.enabled && root.value < root.maximum;
            clicked(coarse) => { root.apply(root.value + root.move(coarse)); }
        }
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// Current value plus a drop-down list. Used for snap and for jumping straight
// to a pattern, so neither needs a strip of chips that grows without bound.
export component MenuField inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    in property <string> hint;
    in property <[string]> options;
    in-out property <int> selected-index;
    in property <string> display-text: root.selected-index >= 0
        && root.selected-index < root.options.length
        ? root.options[root.selected-index] : "";
    in property <length> field-width: 54px;
    in property <length> menu-width: 150px;
    in property <int> visible-rows: 10;
    in property <bool> enabled: true;
    in property <brush> field-background: Theme.surface-raised;
    /// Whether the owner writes `selected-index`; see
    /// `ParameterKnob.controlled` in `controls.slint`.
    in property <bool> controlled: true;
    callback selected(int);

    height: ToolbarMetrics.control-height;
    width: menu-layout.preferred-width;
    border-radius: Theme.radius-md;
    background: !root.enabled ? Theme.surface
        : touch.has-hover ? Theme.surface-active : root.field-background;
    accessible-role: combobox;
    accessible-label: root.tooltip;
    accessible-value: root.display-text;

    menu-layout := HorizontalLayout {
        padding-left: 5px;
        padding-right: 4px;
        spacing: 4px;
        if root.label != "" : ToolbarLabel { text: root.label; }
        Rectangle {
            width: root.field-width;
            Text {
                text: root.display-text;
                // A disabled field reads as disabled. The background already
                // said so and the value did not, which is not enough for a
                // control that is drawn because the setting will exist rather
                // than because it does -- the channel sidebar's MIDI rows.
                color: root.enabled ? Theme.text : Theme.text-faint;
                font-size: ToolbarMetrics.value-size;
                horizontal-alignment: left;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                overflow: elide;
            }
        }
        Text {
            text: "▾";
            color: Theme.text-faint;
            font-size: Theme.text-md;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { menu.show(); }
        changed has-hover => {
            if (self.has-hover) { StatusHint.show(root.hint); }
            else { StatusHint.clear(root.hint); }
        }
    }

    menu := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.menu-width;
        height: min(root.options.length, root.visible-rows) * 22px + 8px;
        close-policy: close-on-click;

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: Theme.hairline;
            border-color: Theme.border;

            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                content-height: root.options.length * 22px;
                VerticalLayout {
                    for option[i] in root.options : Rectangle {
                        height: 22px;
                        // A row a screen reader -- and a test -- can find by
                        // what it says.
                        accessible-role: list-item;
                        accessible-label: option;
                        accessible-item-selectable: true;
                        accessible-item-selected: i == root.selected-index;
                        border-radius: Theme.radius-sm;
                        background: row-touch.has-hover ? Theme.surface-active
                            : i == root.selected-index ? Theme.accent-active : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: option;
                                color: i == root.selected-index ? Theme.text : Theme.text-muted;
                                font-size: Theme.text-xl;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (!root.controlled) { root.selected-index = i; }
                                root.selected(i);
                            }
                        }
                    }
                }
            }
        }
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// Editable single-line field. Every rename in the application is one of
// these -- patterns in the transport toolbar, tracks on the bus face,
// channels on the device-chain header -- plus the mockup tool's filter.
export component NameField inherits Rectangle {
    // What the app says the name is. Deliberately `in`, and deliberately not
    // bound two-way to the input below.
    //
    // A `TextInput`'s `text` is an ordinary property, so typing into it does
    // not update a binding -- it *replaces* it. Wired `text <=> input.text`,
    // this field tracked whatever the app pushed until the first keystroke
    // and never again: rename a pattern, switch to another pattern, and the
    // box still showed what you had typed while the toolbar, the menu and the
    // playlist all showed the real name. So the app drives the input through
    // `changed`, the input reports back through `edited`, and the only writer
    // of `text` is the app.
    in property <string> text;
    in property <string> placeholder;
    in property <string> tooltip: "Rename";
    // What is actually in the box right now, which is `text` only between
    // edits. Exists so a test can ask the field what it is showing without
    // reading pixels, and so the placeholder condition has one source.
    out property <string> current-text: input.text;
    /// Whether the caret is in this field, which is also whether Space types
    /// a space rather than starting the transport. Exists for the same reason
    /// `current-text` does: so a test can ask, rather than read pixels.
    out property <bool> editing: input.has-focus;
    /// Whether Tab and Shift+Tab leave this field asking to move on, rather
    /// than walking the window's focus chain. The step rack's inline rename
    /// sets it, so a run of channels can be named from the keyboard the way
    /// a column of cells is (MOO-224). Off everywhere else.
    in property <bool> tabs: false;
    callback edited(string);
    /// Tab (`backwards` false) or Shift+Tab (true) in a field with `tabs`.
    /// Fires before the caret leaves, so a listener can say where it goes
    /// next and act on `left`.
    callback tabbed(bool /* backwards */);
    /// The caret has left and the editing session is closed: fired from the
    /// same handler that ends the gesture, and after it. A field that takes
    /// itself away on leaving does it here, never on `editing` -- a field
    /// torn down before its own focus handler runs would leave its gesture
    /// open, and the next edit anywhere would join this one's undo step.
    callback left();

    /// Puts the caret in the field with its text selected, so typing
    /// replaces the name rather than appending to it.
    public function edit-all() {
        input.focus();
        input.select-all();
    }

    // Guarded, because re-assigning a `TextInput`'s text moves the cursor. An
    // accepted rename comes straight back as the value already in the box.
    changed text => {
        if (input.text != root.text) { input.text = root.text; }
    }

    height: ToolbarMetrics.control-height;
    width: 104px;
    border-radius: Theme.radius-md;
    background: input.has-focus ? Theme.surface : Theme.surface-raised;
    border-width: Theme.hairline;
    border-color: input.has-focus ? Theme.focus : transparent;
    accessible-role: text-input;
    accessible-label: root.tooltip;
    forward-focus: input;

    // Asks the box what is in it, not the app what it thinks is in it: the
    // two differ for every keystroke between typing and acceptance, and a
    // placeholder that reappeared under half-typed text would be the visible
    // half of the bug above.
    if root.current-text == "" && !input.has-focus : Text {
        x: 6px;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.text-xl;
        vertical-alignment: center;
        height: 100%;
    }

    input := TextInput {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        // **A keystroke is not an edit.** `edited` fires on every one of
        // them, so a rename recorded per callback is one undo step per
        // character: "Kick" to "Kick Bus" would be eight entries and eight
        // Ctrl+Z. The gesture for a typed field is the *editing session* --
        // it opens when the caret arrives and closes when the caret leaves,
        // by Enter, by Escape or by a click elsewhere -- and a session that
        // typed nothing records nothing.
        //
        // Escape is a way out of the field rather than an undo: the app has
        // already been written on every keystroke, so what is in the
        // document when the caret leaves is what the person typed. A field
        // that could really abandon an edit would close its gesture by
        // discarding; this one has nothing to discard.
        changed has-focus => {
            if (self.has-focus) { Gesture.begin(); }
            else { Gesture.end(); root.left(); }
        }
        // The initial value only; `changed text` above owns it from then on.
        text: root.text;
        color: Theme.text;
        font-size: Theme.text-xl;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.edited(self.text); self.clear-focus(); }
        // **A field needs a way out that is not Enter.** Without one,
        // clicking into this and then clicking away leaves the caret
        // here, and while it is here Space types a space instead of
        // starting the transport -- right for a field somebody is
        // editing, wrong for one nobody is. The 2026-09-07 focus pass
        // made every *control* transparent to shortcuts and left text
        // fields as the remaining case; this is the way out it wanted.
        //
        // `reject` for everything else, so the input's own handling of
        // every other key is untouched.
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                self.clear-focus();
                return EventResult.accept;
            }
            // Shift+Tab arrives as Backtab from most platforms and as Tab
            // with Shift from some; the window's own focus walk takes both.
            if (root.tabs && (event.text == Key.Tab || event.text == Key.Backtab)) {
                root.tabbed(event.text == Key.Backtab || event.modifiers.shift);
                self.clear-focus();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// A search box: a placeholder while empty, Escape to clear it and leave. Not
// a `NameField`, whose editing session is an undo gesture -- typing a filter
// edits nothing (MOO-9).
export component SearchField inherits Rectangle {
    in property <string> text;
    in property <string> placeholder: "Filter";
    in property <string> tooltip: root.placeholder;
    callback edited(string);

    height: 20px;
    border-radius: Theme.radius-md;
    background: search-input.has-focus ? Theme.surface : Theme.surface-raised;
    border-width: Theme.hairline;
    border-color: search-input.has-focus ? Theme.focus : Theme.border;
    accessible-role: text-input;
    accessible-label: root.tooltip;
    accessible-value: search-input.text;

    // Driven by the app through `changed`, never bound: typing into a
    // `TextInput` replaces a binding on its `text` (see `NameField`).
    changed text => {
        if (search-input.text != root.text) { search-input.text = root.text; }
    }

    if search-input.text == "" && !search-input.has-focus : Text {
        x: 6px;
        height: 100%;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.text-md;
        vertical-alignment: center;
    }
    search-input := TextInput {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        text: root.text;
        color: Theme.text;
        font-size: Theme.text-md;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { self.clear-focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                self.text = "";
                root.edited("");
                self.clear-focus();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// Tool-mode button. Latched state is a filled accent so the active tool is
// unmistakable - getting this wrong means dragging the wrong edit across a row.
export component ToolModeButton inherits Rectangle {
    in property <string> glyph;
    in property <string> icon;
    in property <string> name;
    in property <string> hint;
    in property <bool> active;
    callback clicked;

    width: 28px;
    height: ToolbarMetrics.control-height;
    border-radius: Theme.radius-md;
    background: root.active ? Theme.accent-active
        : touch.pressed ? Theme.surface-active
        : touch.has-hover ? Theme.surface-raised : transparent;
    border-width: root.active ? Theme.hairline : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.name;
    accessible-checked: root.active;

    if root.icon != "" : Icon {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        icon: root.icon;
        tint: root.active ? Theme.text : Theme.text-muted;
        outline: true;
    }
    if root.icon == "" : Text {
        text: root.glyph;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: Theme.text-2xl;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover) { StatusHint.show(root.hint); }
            else { StatusHint.clear(root.hint); }
        }
    }
    // The name is the tooltip; what the tool does is a sentence, and a
    // sentence belongs in the status bar.
    Tooltip { text: @markdown("**\{root.name}**"); }
}

// Transport position, as bar:beat:tick. Tabular so the digits do not shuffle
// while the transport runs.
export component PositionReadout inherits Rectangle {
    in property <int> bar: 1;
    in property <int> beat: 1;
    in property <int> tick;
    out property <bool> hovered: readout-touch.has-hover;

    height: ToolbarMetrics.control-height;
    width: 92px;
    border-radius: Theme.radius-md;
    background: Theme.background;

    BbtText {
        bar: root.bar;
        beat: root.beat;
        tick: root.tick;
        color: Theme.text;
        font-size: ToolbarMetrics.value-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        // The readout's own size, spelled rather than `100%`: a child at
        // 100% hands its constraints up to the parent, so the text's width
        // was re-measured, and the toolbar's layout re-solved, every tick
        // the position moved (MOO-258). The readout is a fixed size anyway.
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }
    readout-touch := TouchArea {}
}

// Tempo. Drag to change, double-click to type.
export component TempoField inherits Rectangle {
    in-out property <int> bpm: 120;
    in property <int> minimum: 20;
    in property <int> maximum: 999;
    out property <bool> hovered: tempo-touch.has-hover;
    /// Whether the owner writes `bpm`; see `ParameterKnob.controlled` in
    /// `controls.slint`. Tempo is the document's.
    in property <bool> controlled: true;
    callback changed(int);

    private property <int> pressed-bpm;
    private property <bool> editing;

    height: ToolbarMetrics.control-height;
    width: 76px;
    border-radius: Theme.radius-md;
    background: root.editing ? Theme.surface : tempo-touch.has-hover ? Theme.surface-active : Theme.surface-raised;
    accessible-role: spinbox;
    accessible-label: "Tempo";
    accessible-value: root.bpm;

    function apply(next: int) {
        let clamped = clamp(next, root.minimum, root.maximum);
        if (clamped != root.bpm) {
            if (!root.controlled) { root.bpm = clamped; }
            root.changed(clamped);
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 3px;
        if !root.editing : Text {
            text: root.bpm;
            color: Theme.text;
            font-size: ToolbarMetrics.value-size;
            font-family: Theme.font-family-mono;
            vertical-alignment: center;
            horizontal-stretch: 1;
            horizontal-alignment: right;
        }
        if root.editing : TextInput {
            text: root.bpm;
            color: Theme.text;
            font-size: ToolbarMetrics.value-size;
            font-family: Theme.font-family-mono;
            vertical-alignment: center;
            horizontal-alignment: right;
            horizontal-stretch: 1;
            single-line: true;
            input-type: number;
            accepted => {
                root.apply(self.text.to-float());
                root.editing = false;
            }
            // Escape leaves the field without applying, which for this one is
            // a real cancel: the tempo is only committed on `accepted`, so
            // dropping out of edit mode discards whatever was typed. See
            // `NameField`'s input above for why a field needs an exit at all.
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.editing = false;
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }
        ToolbarLabel { text: "BPM"; }
    }

    tempo-touch := TouchArea {
        enabled: !root.editing;
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pressed-bpm = root.bpm;
            } else if (e.kind == PointerEventKind.move && self.pressed) {
                root.apply(root.pressed-bpm + round((self.pressed-y - self.mouse-y) / 3px));
            }
        }
        double-clicked => { root.editing = true; }
        scroll-event(e) => {
            root.apply(root.bpm + (e.delta-y > 0 ? 1 : -1));
            accept
        }
    }
}

// Beat position lamps, one per beat in the bar.
export component BeatLamps inherits Rectangle {
    in property <int> beats: 4;
    in property <int> current;
    in property <bool> running;

    height: ToolbarMetrics.control-height;
    width: root.beats * 12px;

    HorizontalLayout {
        spacing: 4px;
        alignment: center;
        for i in root.beats : Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - 8px) / 2;
            border-radius: Theme.radius-lg;
            // The downbeat stays distinguishable when the transport is idle.
            background: root.running && root.current == i
                ? (i == 0 ? Theme.accent : Theme.text)
                : i == 0 ? Theme.border.brighter(0.6) : Theme.border;
        }
    }
}
