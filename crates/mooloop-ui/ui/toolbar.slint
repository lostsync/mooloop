import { Theme } from "theme.slint";

// Toolbar vocabulary.
//
// The bar had been assembled from bare Text elements with TouchAreas glued on,
// so tempo did not read as a control and unrelated clusters carried equal
// visual weight. These are the pieces it should have been built from: every
// field is the same height, numerics are tabular, and grouping is explicit.

// Tool icons are drawn rather than set as text. The pencil and scissors glyphs
// resolve through font fallback, so each one arrived at a different weight and
// baseline; as line art on a shared 16x16 grid they stay one family.
export global ToolIcons {
    out property <string> select:
        "M 3.5 2.5 L 3.5 13 L 6.4 10.2 L 8.2 13.6 L 9.9 12.7 L 8.1 9.4 L 12 9.4 Z";
    out property <string> paint:
        "M 3 13 L 3.9 10.1 L 10.5 3.5 L 12.5 5.5 L 5.9 12.1 Z M 9.4 4.6 L 11.4 6.6";
    out property <string> slice:
        "M 2.5 5 L 13.5 5 L 13.5 11 L 2.5 11 Z M 6.2 5 L 6.2 11 M 9.8 5 L 9.8 11";
    out property <string> stretch:
        "M 2.5 8 L 13.5 8 M 5 5.5 L 2.5 8 L 5 10.5 M 11 5.5 L 13.5 8 L 11 10.5";
    // Panel toggles: the outline is the window, the inner rule marks the
    // pane each button reveals.
    out property <string> panel-left:
        "M 2.5 3 L 13.5 3 L 13.5 13 L 2.5 13 Z M 6.5 3 L 6.5 13";
    out property <string> panel-bottom:
        "M 2.5 3 L 13.5 3 L 13.5 13 L 2.5 13 Z M 2.5 9.5 L 13.5 9.5";
}

export global ToolbarMetrics {
    out property <length> control-height: 24px;
    out property <length> label-size: 9px;
    out property <length> value-size: 12px;
}

// Hairline group separator. Grouping is the whole point of the bar, so it gets
// a real element rather than another anonymous spacer Rectangle.
export component ToolbarRule inherits Rectangle {
    width: 9px;
    Rectangle {
        x: 4px;
        width: 1px;
        height: parent.height * 0.62;
        y: (parent.height - self.height) / 2;
        background: Theme.border;
    }
}

export component ToolbarLabel inherits Text {
    color: Theme.text-faint;
    font-size: ToolbarMetrics.label-size;
    vertical-alignment: center;
    letter-spacing: 0.5px;
}

// A small square repeat-free arrow used by the steppers.
component StepperArrow inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked;

    width: 16px;
    background: touch.pressed && root.enabled ? Theme.surface-active
        : touch.has-hover && root.enabled ? Theme.surface-raised : transparent;
    border-radius: Theme.radius-sm;

    Text {
        text: root.glyph;
        color: root.enabled ? Theme.text-muted : Theme.text-faint;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Integer field with prev/next arrows and vertical drag on the value. Replaces
// the stock SpinBox, which was the one control in the app that ignored the
// theme entirely.
export component StepperField inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 999;
    in property <int> step: 1;
    in property <bool> enabled: true;
    in property <string> display-text: root.value;
    in property <length> value-width: 30px;
    in property <brush> field-background: Theme.surface-raised;
    callback changed(int);

    private property <int> pressed-value;

    height: ToolbarMetrics.control-height;
    width: layout.preferred-width;
    border-radius: Theme.radius-md;
    background: root.field-background;
    opacity: root.enabled ? 1.0 : 0.45;
    accessible-role: spinbox;
    accessible-label: root.tooltip;
    accessible-value: root.display-text;

    function apply(next: int) {
        if (!root.enabled) { return; }
        let clamped = clamp(next, root.minimum, root.maximum);
        if (clamped != root.value) {
            root.value = clamped;
            root.changed(clamped);
        }
    }

    layout := HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        spacing: 1px;

        if root.label != "" : ToolbarLabel {
            text: root.label;
            vertical-alignment: center;
        }
        if root.label != "" : Rectangle { width: 4px; }

        StepperArrow {
            glyph: "‹";
            enabled: root.enabled && root.value > root.minimum;
            clicked => { root.apply(root.value - root.step); }
        }
        Rectangle {
            width: root.value-width;
            Text {
                text: root.display-text;
                color: Theme.text;
                font-size: ToolbarMetrics.value-size;
                font-family: "monospace";
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            // Dragging the number is faster than clicking an arrow 16 times.
            drag := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? ns-resize : default;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.pressed-value = root.value;
                    } else if (e.kind == PointerEventKind.move && self.pressed) {
                        root.apply(root.pressed-value
                            + round((self.pressed-y - self.mouse-y) / 4px) * root.step);
                    }
                }
                scroll-event(e) => {
                    root.apply(root.value + (e.delta-y > 0 ? root.step : -root.step));
                    accept
                }
            }
        }
        StepperArrow {
            glyph: "›";
            enabled: root.enabled && root.value < root.maximum;
            clicked => { root.apply(root.value + root.step); }
        }
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// Current value plus a drop-down list. Used for snap and for jumping straight
// to a pattern, so neither needs a strip of chips that grows without bound.
export component MenuField inherits Rectangle {
    in property <string> label;
    in property <string> tooltip: root.label;
    in property <[string]> options;
    in-out property <int> selected-index;
    in property <string> display-text: root.selected-index >= 0
        && root.selected-index < root.options.length
        ? root.options[root.selected-index] : "";
    in property <length> field-width: 54px;
    in property <length> menu-width: 150px;
    in property <int> visible-rows: 10;
    in property <brush> field-background: Theme.surface-raised;
    callback selected(int);

    height: ToolbarMetrics.control-height;
    width: menu-layout.preferred-width;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.surface-active : root.field-background;
    accessible-role: combobox;
    accessible-label: root.tooltip;
    accessible-value: root.display-text;

    menu-layout := HorizontalLayout {
        padding-left: 5px;
        padding-right: 4px;
        spacing: 4px;
        if root.label != "" : ToolbarLabel { text: root.label; }
        Rectangle {
            width: root.field-width;
            Text {
                text: root.display-text;
                color: Theme.text;
                font-size: ToolbarMetrics.value-size;
                horizontal-alignment: left;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                overflow: elide;
            }
        }
        Text {
            text: "▾";
            color: Theme.text-faint;
            font-size: 9px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }

    menu := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.menu-width;
        height: min(root.options.length, root.visible-rows) * 22px + 8px;
        close-policy: close-on-click;

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;

            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                viewport-height: root.options.length * 22px;
                VerticalLayout {
                    for option[i] in root.options : Rectangle {
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: row-touch.has-hover ? Theme.surface-active
                            : i == root.selected-index ? Theme.accent-active : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: option;
                                color: i == root.selected-index ? Theme.text : Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = i;
                                root.selected(i);
                            }
                        }
                    }
                }
            }
        }
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// Editable single-line field, for the pattern name.
export component NameField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> tooltip: "Rename";
    callback edited(string);

    height: ToolbarMetrics.control-height;
    width: 104px;
    border-radius: Theme.radius-md;
    background: input.has-focus ? Theme.surface : Theme.surface-raised;
    border-width: 1px;
    border-color: input.has-focus ? Theme.focus : transparent;
    accessible-role: text-input;
    accessible-label: root.tooltip;
    forward-focus: input;

    if root.text == "" && !input.has-focus : Text {
        x: 6px;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: 11px;
        vertical-alignment: center;
        height: 100%;
    }

    input := TextInput {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        text <=> root.text;
        color: Theme.text;
        font-size: 11px;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.edited(self.text); self.clear-focus(); }
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

// Tool-mode button. Latched state is a filled accent so the active tool is
// unmistakable - getting this wrong means dragging the wrong edit across a row.
export component ToolModeButton inherits Rectangle {
    in property <string> glyph;
    in property <string> icon;
    in property <string> name;
    in property <string> hint;
    in property <bool> active;
    callback clicked;

    width: 28px;
    height: ToolbarMetrics.control-height;
    border-radius: Theme.radius-md;
    background: root.active ? Theme.accent-active
        : touch.pressed ? Theme.surface-active
        : touch.has-hover ? Theme.surface-raised : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.name;
    accessible-checked: root.active;

    if root.icon != "" : Path {
        width: 16px;
        height: 16px;
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.icon;
        stroke: root.active ? Theme.text : Theme.text-muted;
        stroke-width: 1.3px;
        fill: transparent;
    }
    if root.icon == "" : Text {
        text: root.glyph;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("**\{root.name}** \{root.hint}"); }
}

// Transport position, as bar:beat:tick. Tabular so the digits do not shuffle
// while the transport runs.
export component PositionReadout inherits Rectangle {
    in property <int> bar: 1;
    in property <int> beat: 1;
    in property <int> tick;
    out property <bool> hovered: readout-touch.has-hover;

    height: ToolbarMetrics.control-height;
    width: 92px;
    border-radius: Theme.radius-md;
    background: Theme.background;

    pure function pad(value: int, width: int) -> string {
        return value < 10 && width >= 2 ? (width >= 3 ? "00" + value : "0" + value)
            : value < 100 && width >= 3 ? "0" + value : value;
    }

    Text {
        text: root.pad(root.bar, 3) + ":" + root.beat + ":" + root.pad(root.tick, 3);
        color: Theme.text;
        font-size: ToolbarMetrics.value-size;
        font-family: "monospace";
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    readout-touch := TouchArea {}
}

// Tempo. Drag to change, double-click to type.
export component TempoField inherits Rectangle {
    in-out property <int> bpm: 120;
    in property <int> minimum: 20;
    in property <int> maximum: 999;
    out property <bool> hovered: tempo-touch.has-hover;
    callback changed(int);

    private property <int> pressed-bpm;
    private property <bool> editing;

    height: ToolbarMetrics.control-height;
    width: 76px;
    border-radius: Theme.radius-md;
    background: root.editing ? Theme.surface : tempo-touch.has-hover ? Theme.surface-active : Theme.surface-raised;
    accessible-role: spinbox;
    accessible-label: "Tempo";
    accessible-value: root.bpm;

    function apply(next: int) {
        let clamped = clamp(next, root.minimum, root.maximum);
        if (clamped != root.bpm) {
            root.bpm = clamped;
            root.changed(clamped);
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 3px;
        if !root.editing : Text {
            text: root.bpm;
            color: Theme.text;
            font-size: ToolbarMetrics.value-size;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-stretch: 1;
            horizontal-alignment: right;
        }
        if root.editing : TextInput {
            text: root.bpm;
            color: Theme.text;
            font-size: ToolbarMetrics.value-size;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: right;
            horizontal-stretch: 1;
            single-line: true;
            input-type: number;
            accepted => {
                root.apply(self.text.to-float());
                root.editing = false;
            }
        }
        ToolbarLabel { text: "BPM"; }
    }

    tempo-touch := TouchArea {
        enabled: !root.editing;
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pressed-bpm = root.bpm;
            } else if (e.kind == PointerEventKind.move && self.pressed) {
                root.apply(root.pressed-bpm + round((self.pressed-y - self.mouse-y) / 3px));
            }
        }
        double-clicked => { root.editing = true; }
        scroll-event(e) => {
            root.apply(root.bpm + (e.delta-y > 0 ? 1 : -1));
            accept
        }
    }
}

// Beat position lamps, one per beat in the bar.
export component BeatLamps inherits Rectangle {
    in property <int> beats: 4;
    in property <int> current;
    in property <bool> running;

    height: ToolbarMetrics.control-height;
    width: root.beats * 12px;

    HorizontalLayout {
        spacing: 4px;
        alignment: center;
        for i in root.beats : Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - 8px) / 2;
            border-radius: Theme.radius-lg;
            // The downbeat stays distinguishable when the transport is idle.
            background: root.running && root.current == i
                ? (i == 0 ? Theme.accent : Theme.text)
                : i == 0 ? Theme.border.brighter(0.6) : Theme.border;
        }
    }
}
