import { Theme } from "theme.slint";
import { NoteFormat, ParameterKnob, SelectorBank, ToggleButton, TrimKnob, ValueScale } from "controls.slint";
import { GainMath } from "gain.slint";
import { StepperField } from "toolbar.slint";
import { DevicePageButton } from "device-rack.slint";
import { FilterResponseDisplay } from "device-displays.slint";
import { EnvelopeEditor } from "envelope.slint";
import { OscillatorDeviceStrip } from "device-oscillator.slint";

export component PolyDeviceFace inherits Rectangle {
    in-out property <int> page;
    in-out property <int> osc1-wave; in-out property <float> osc1-semitones; in-out property <float> osc1-cents; in-out property <float> osc1-level; in-out property <float> osc1-pulse-width;
    in-out property <int> osc2-wave; in-out property <float> osc2-semitones; in-out property <float> osc2-cents; in-out property <float> osc2-level; in-out property <float> osc2-pulse-width;
    in-out property <int> osc3-wave; in-out property <float> osc3-semitones; in-out property <float> osc3-cents; in-out property <float> osc3-level; in-out property <float> osc3-pulse-width;
    in-out property <float> glide; in-out property <float> attack; in-out property <float> decay; in-out property <float> sustain; in-out property <float> release;
    in-out property <float> filter-cutoff; in-out property <float> filter-resonance; in-out property <float> filter-env; in-out property <float> drive;
    in property <bool> modulation-armed;
    // Indexed by descriptor id, mirroring `SYNTH_PARAM_*` in mooloop-core, so
    // every eligible control on this face routes through one path.
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    in-out property <int> lfo-wave; in-out property <float> lfo-rate; in-out property <bool> lfo-retrigger;
    in-out property <float> lfo-pitch; in-out property <float> lfo-filter; in-out property <float> lfo-pulse-width; in-out property <float> lfo-amp;
    in-out property <int> polyphony; in-out property <float> spread;
    callback osc1-wave-changed(int); callback osc1-semitones-changed(float); callback osc1-cents-changed(float); callback osc1-level-changed(float); callback osc1-pulse-width-changed(float);
    callback osc2-wave-changed(int); callback osc2-semitones-changed(float); callback osc2-cents-changed(float); callback osc2-level-changed(float); callback osc2-pulse-width-changed(float);
    callback osc3-wave-changed(int); callback osc3-semitones-changed(float); callback osc3-cents-changed(float); callback osc3-level-changed(float); callback osc3-pulse-width-changed(float);
    callback glide-changed(float); callback attack-changed(float); callback decay-changed(float); callback sustain-changed(float); callback release-changed(float);
    callback filter-cutoff-changed(float); callback filter-resonance-changed(float); callback filter-env-changed(float); callback drive-changed(float);
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);
    callback lfo-wave-changed(int); callback lfo-rate-changed(float); callback lfo-retrigger-changed(bool);
    callback lfo-pitch-changed(float); callback lfo-filter-changed(float); callback lfo-pulse-width-changed(float); callback lfo-amp-changed(float);
    callback polyphony-changed(int); callback spread-changed(float);

    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 3px;
            DevicePageButton { text: "OSC"; active: root.page == 0; clicked => { root.page = 0; } }
            DevicePageButton { text: "AMP/FILTER"; active: root.page == 1; clicked => { root.page = 1; } }
            DevicePageButton { text: "MOD"; active: root.page == 2; clicked => { root.page = 2; } }
            DevicePageButton { text: "VOICE"; active: root.page == 3; clicked => { root.page = 3; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { height: 1px; background: Theme.border; }

        if root.page == 0 : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 5px;
            OscillatorDeviceStrip {
                horizontal-stretch: 1; title: "OSC 1";
                param-base: 100;
                modulation-armed: root.modulation-armed;
                modulation-depths: root.modulation-depths;
                modulation-allowed: root.modulation-allowed;
                modulation-offsets: root.modulation-offsets;
                modulation-route-counts: root.modulation-route-counts;
                modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                modulation-edit-started(p) => { root.modulation-edit-started(p); }
                modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                wave <=> root.osc1-wave; semitones <=> root.osc1-semitones; cents <=> root.osc1-cents; level <=> root.osc1-level; pulse-width <=> root.osc1-pulse-width;
                wave-changed(v) => { root.osc1-wave-changed(v); } semitones-changed(v) => { root.osc1-semitones-changed(v); } cents-changed(v) => { root.osc1-cents-changed(v); } level-changed(v) => { root.osc1-level-changed(v); } pulse-width-changed(v) => { root.osc1-pulse-width-changed(v); }
            }
            OscillatorDeviceStrip {
                horizontal-stretch: 1; title: "OSC 2";
                param-base: 110;
                modulation-armed: root.modulation-armed;
                modulation-depths: root.modulation-depths;
                modulation-allowed: root.modulation-allowed;
                modulation-offsets: root.modulation-offsets;
                modulation-route-counts: root.modulation-route-counts;
                modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                modulation-edit-started(p) => { root.modulation-edit-started(p); }
                modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                wave <=> root.osc2-wave; semitones <=> root.osc2-semitones; cents <=> root.osc2-cents; level <=> root.osc2-level; pulse-width <=> root.osc2-pulse-width;
                wave-changed(v) => { root.osc2-wave-changed(v); } semitones-changed(v) => { root.osc2-semitones-changed(v); } cents-changed(v) => { root.osc2-cents-changed(v); } level-changed(v) => { root.osc2-level-changed(v); } pulse-width-changed(v) => { root.osc2-pulse-width-changed(v); }
            }
            OscillatorDeviceStrip {
                horizontal-stretch: 1; title: "OSC 3";
                param-base: 120;
                modulation-armed: root.modulation-armed;
                modulation-depths: root.modulation-depths;
                modulation-allowed: root.modulation-allowed;
                modulation-offsets: root.modulation-offsets;
                modulation-route-counts: root.modulation-route-counts;
                modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
                modulation-edit-started(p) => { root.modulation-edit-started(p); }
                modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
                wave <=> root.osc3-wave; semitones <=> root.osc3-semitones; cents <=> root.osc3-cents; level <=> root.osc3-level; pulse-width <=> root.osc3-pulse-width;
                wave-changed(v) => { root.osc3-wave-changed(v); } semitones-changed(v) => { root.osc3-semitones-changed(v); } cents-changed(v) => { root.osc3-cents-changed(v); } level-changed(v) => { root.osc3-level-changed(v); } pulse-width-changed(v) => { root.osc3-pulse-width-changed(v); }
            }
        }

        if root.page == 1 : HorizontalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 5;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 5px; spacing: 4px;
                    Text { text: "AMPLITUDE"; color: Theme.text-faint; font-size: 8px; }
                    EnvelopeEditor {
                        vertical-stretch: 1;
                        min-height: 50px;
                        attack: root.attack / 2; decay: root.decay / 2; sustain <=> root.sustain; release: root.release / 2;
                        attack-text: round(root.attack * 1000) + " ms"; decay-text: round(root.decay * 1000) + " ms"; sustain-text: round(root.sustain * 100) + "%"; release-text: round(root.release * 1000) + " ms";
                        attack-changed(v) => { root.attack = v * 2; root.attack-changed(root.attack); }
                        decay-changed(v) => { root.decay = v * 2; root.decay-changed(root.decay); }
                        sustain-changed(v) => { root.sustain-changed(v); }
                        release-changed(v) => { root.release = v * 2; root.release-changed(root.release); }
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        ParameterKnob { width: 52px; diameter: 36px; label: "Glide"; tooltip: "Portamento time"; value <=> root.glide; minimum: 0; maximum: 2; default-value: 0; value-text: round(root.glide * 1000) + " ms"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[0]; modulation-depth: root.modulation-depths[0]; modulation-offset: root.modulation-offsets[0]; modulation-route-count: root.modulation-route-counts[0]; changed(v) => { root.glide-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(0, v); } modulation-edit-started => { root.modulation-edit-started(0); } modulation-edit-finished => { root.modulation-edit-finished(0); } }
                        ParameterKnob { width: 52px; diameter: 36px; label: "Attack"; tooltip: "Amplitude attack"; value <=> root.attack; minimum: 0; maximum: 2; default-value: 0.005; value-text: round(root.attack * 1000) + " ms"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[1]; modulation-depth: root.modulation-depths[1]; modulation-offset: root.modulation-offsets[1]; modulation-route-count: root.modulation-route-counts[1]; changed(v) => { root.attack-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(1, v); } modulation-edit-started => { root.modulation-edit-started(1); } modulation-edit-finished => { root.modulation-edit-finished(1); } }
                        ParameterKnob { width: 52px; diameter: 36px; label: "Decay"; tooltip: "Amplitude decay"; value <=> root.decay; minimum: 0; maximum: 2; default-value: 0.2; value-text: round(root.decay * 1000) + " ms"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[2]; modulation-depth: root.modulation-depths[2]; modulation-offset: root.modulation-offsets[2]; modulation-route-count: root.modulation-route-counts[2]; changed(v) => { root.decay-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(2, v); } modulation-edit-started => { root.modulation-edit-started(2); } modulation-edit-finished => { root.modulation-edit-finished(2); } }
                        ParameterKnob { width: 52px; diameter: 36px; label: "Sustain"; tooltip: "Amplitude sustain"; value <=> root.sustain; default-value: 0.7; value-text: round(root.sustain * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[3]; modulation-depth: root.modulation-depths[3]; modulation-offset: root.modulation-offsets[3]; modulation-route-count: root.modulation-route-counts[3]; changed(v) => { root.sustain-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(3, v); } modulation-edit-started => { root.modulation-edit-started(3); } modulation-edit-finished => { root.modulation-edit-finished(3); } }
                        ParameterKnob { width: 52px; diameter: 36px; label: "Release"; tooltip: "Amplitude release"; value <=> root.release; minimum: 0; maximum: 2; default-value: 0.15; value-text: round(root.release * 1000) + " ms"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[4]; modulation-depth: root.modulation-depths[4]; modulation-offset: root.modulation-offsets[4]; modulation-route-count: root.modulation-route-counts[4]; changed(v) => { root.release-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(4, v); } modulation-edit-started => { root.modulation-edit-started(4); } modulation-edit-finished => { root.modulation-edit-finished(4); } }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 4;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                VerticalLayout {
                    padding: 5px; spacing: 4px;
                    Text { text: "FILTER / DRIVE"; color: Theme.text-faint; font-size: 8px; }
                    FilterResponseDisplay {
                        vertical-stretch: 1;
                        min-height: 50px;
                        mode: 0;
                        cutoff: root.filter-cutoff;
                        resonance: root.filter-resonance;
                        env-amount: root.filter-env;
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        ParameterKnob {
                            width: 52px; diameter: 36px; label: "Cutoff"; tooltip: "Low-pass cutoff";
                            value <=> root.filter-cutoff; default-value: 1;
                            modulation-armed: root.modulation-armed;
                            modulation-allowed: root.modulation-allowed[5];
                            modulation-depth: root.modulation-depths[5];
                            modulation-offset: root.modulation-offsets[5];
                            modulation-route-count: root.modulation-route-counts[5];
                            value-text: NoteFormat.frequency-value(20 * pow(1000, root.filter-cutoff));
                            changed(v) => { root.filter-cutoff-changed(v); }
                            modulation-depth-changed(v) => { root.modulation-depth-changed(5, v); }
                            modulation-edit-started => { root.modulation-edit-started(5); }
                            modulation-edit-finished => { root.modulation-edit-finished(5); }
                        }
                        ParameterKnob { width: 52px; diameter: 36px; label: "Reso"; tooltip: "Filter resonance"; value <=> root.filter-resonance; default-value: 0; value-text: round(root.filter-resonance * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[6]; modulation-depth: root.modulation-depths[6]; modulation-offset: root.modulation-offsets[6]; modulation-route-count: root.modulation-route-counts[6]; changed(v) => { root.filter-resonance-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(6, v); } modulation-edit-started => { root.modulation-edit-started(6); } modulation-edit-finished => { root.modulation-edit-finished(6); } }
                        ParameterKnob { width: 52px; diameter: 36px; label: "Env"; tooltip: "Envelope depth"; value <=> root.filter-env; minimum: -1; maximum: 1; default-value: 0; bipolar: true; value-text: (root.filter-env > 0 ? "+" : "") + round(root.filter-env * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[7]; modulation-depth: root.modulation-depths[7]; modulation-offset: root.modulation-offsets[7]; modulation-route-count: root.modulation-route-counts[7]; changed(v) => { root.filter-env-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(7, v); } modulation-edit-started => { root.modulation-edit-started(7); } modulation-edit-finished => { root.modulation-edit-finished(7); } }
                        ParameterKnob { width: 52px; diameter: 36px; label: "Drive"; tooltip: "Soft saturation"; value <=> root.drive; default-value: 0; value-text: round(root.drive * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[8]; modulation-depth: root.modulation-depths[8]; modulation-offset: root.modulation-offsets[8]; modulation-route-count: root.modulation-route-counts[8]; changed(v) => { root.drive-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(8, v); } modulation-edit-started => { root.modulation-edit-started(8); } modulation-edit-finished => { root.modulation-edit-finished(8); } }
                    }
                }
            }
        }

        if root.page == 2 : Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding: 8px; spacing: 8px;
                VerticalLayout {
                    width: 214px; spacing: 6px;
                    Text { text: "LFO SHAPE"; color: Theme.text-faint; font-size: 8px; }
                    SelectorBank {
                        options: ["Sin", "Tri", "Saw", "Sq", "S&H"];
                        selected-index <=> root.lfo-wave;
                        segment-width: 40px;
                        tooltip: "LFO waveform";
                        selected(i) => { root.lfo-wave-changed(i); }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 40px;
                        Path {
                            x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px;
                            viewbox-width: 200; viewbox-height: 70;
                            commands: "M 0 35 C 25 0 50 0 75 35 C 100 70 125 70 150 35 C 168 10 186 12 200 35";
                            stroke: Theme.accent; stroke-width: 1.5px; fill: transparent;
                        }
                    }
                    ToggleButton { text: "RETRIGGER"; checked <=> root.lfo-retrigger; toggled(on) => { root.lfo-retrigger-changed(on); } }
                }
                Rectangle { width: 1px; background: Theme.border; }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    alignment: space-around;
                    ParameterKnob { label: "Rate"; tooltip: "LFO speed"; value <=> root.lfo-rate; minimum: 0.01; maximum: 20; default-value: 5; scale: ValueScale.logarithmic; value-text: root.lfo-rate < 1 ? round(root.lfo-rate * 100) / 100 + " Hz" : round(root.lfo-rate * 10) / 10 + " Hz"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[10]; modulation-depth: root.modulation-depths[10]; modulation-offset: root.modulation-offsets[10]; modulation-route-count: root.modulation-route-counts[10]; changed(v) => { root.lfo-rate-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(10, v); } modulation-edit-started => { root.modulation-edit-started(10); } modulation-edit-finished => { root.modulation-edit-finished(10); } }
                    ParameterKnob { label: "Pitch"; tooltip: "Pitch modulation"; value <=> root.lfo-pitch; minimum: -24; maximum: 24; default-value: 0; bipolar: true; value-text: (root.lfo-pitch > 0 ? "+" : "") + round(root.lfo-pitch * 10) / 10 + " st"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[11]; modulation-depth: root.modulation-depths[11]; modulation-offset: root.modulation-offsets[11]; modulation-route-count: root.modulation-route-counts[11]; changed(v) => { root.lfo-pitch-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(11, v); } modulation-edit-started => { root.modulation-edit-started(11); } modulation-edit-finished => { root.modulation-edit-finished(11); } }
                    ParameterKnob { label: "Cutoff"; tooltip: "Filter modulation"; value <=> root.lfo-filter; minimum: -4; maximum: 4; default-value: 0; bipolar: true; value-text: (root.lfo-filter > 0 ? "+" : "") + round(root.lfo-filter * 10) / 10 + " oct"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[12]; modulation-depth: root.modulation-depths[12]; modulation-offset: root.modulation-offsets[12]; modulation-route-count: root.modulation-route-counts[12]; changed(v) => { root.lfo-filter-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(12, v); } modulation-edit-started => { root.modulation-edit-started(12); } modulation-edit-finished => { root.modulation-edit-finished(12); } }
                    ParameterKnob { label: "Width"; tooltip: "Pulse-width modulation"; value <=> root.lfo-pulse-width; minimum: -0.45; maximum: 0.45; default-value: 0; bipolar: true; value-text: (root.lfo-pulse-width > 0 ? "+" : "") + round(root.lfo-pulse-width * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[13]; modulation-depth: root.modulation-depths[13]; modulation-offset: root.modulation-offsets[13]; modulation-route-count: root.modulation-route-counts[13]; changed(v) => { root.lfo-pulse-width-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(13, v); } modulation-edit-started => { root.modulation-edit-started(13); } modulation-edit-finished => { root.modulation-edit-finished(13); } }
                    ParameterKnob { label: "Trem"; tooltip: "Amplitude modulation"; value <=> root.lfo-amp; default-value: 0; value-text: round(root.lfo-amp * 100) + "%"; modulation-armed: root.modulation-armed; modulation-allowed: root.modulation-allowed[14]; modulation-depth: root.modulation-depths[14]; modulation-offset: root.modulation-offsets[14]; modulation-route-count: root.modulation-route-counts[14]; changed(v) => { root.lfo-amp-changed(v); } modulation-depth-changed(v) => { root.modulation-depth-changed(14, v); } modulation-edit-started => { root.modulation-edit-started(14); } modulation-edit-finished => { root.modulation-edit-finished(14); } }
                }
            }
        }

        if root.page == 3 : Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding: 8px; spacing: 8px;
                alignment: space-around;
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    StepperField {
                        label: "POLYPHONY";
                        tooltip: "Active voice count";
                        value <=> root.polyphony;
                        minimum: 1;
                        maximum: 16;
                        step: 1;
                        value-width: 18px;
                        changed(v) => { root.polyphony-changed(v); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    ParameterKnob {
                        label: "Spread";
                        tooltip: "Stereo spread across voices";
                        value <=> root.spread;
                        default-value: 0;
                        value-text: round(root.spread * 100) + "%";
                        modulation-armed: root.modulation-armed;
                        modulation-allowed: root.modulation-allowed[16];
                        modulation-depth: root.modulation-depths[16];
                        modulation-offset: root.modulation-offsets[16];
                        modulation-route-count: root.modulation-route-counts[16];
                        changed(v) => { root.spread-changed(v); }
                        modulation-depth-changed(v) => { root.modulation-depth-changed(16, v); }
                        modulation-edit-started => { root.modulation-edit-started(16); }
                        modulation-edit-finished => { root.modulation-edit-finished(16); }
                    }
                }
            }
        }
    }
}
