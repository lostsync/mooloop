// The Slint half of the shared gain vocabulary. `mooloop-core/src/gain.rs`
// is the authority: these functions mirror it, and an agreement test in
// `crates/mooloop-ui/tests/gain_slint_agreement.rs` fails when the fader
// breakpoint lists below drift from `gain.rs::FADER_BREAKPOINTS`.
//
// Slint has no infinity literal: -99999.0 stands in for -inf dB and
// `format-db` spells it "-inf" like any other floor value.
export global GainMath {
    // Colour thresholds for peak meters, mirroring
    // mooloop_core::gain::{METER_WARNING_DB, METER_HOT_DB} (the agreement
    // test in gain_slint_agreement.rs checks these too).
    in property <float> meter-warning-db: -10.0;
    in property <float> meter-hot-db: -3.0;

    // The floor, mirroring mooloop_core::gain::MIN_DB. At or below it a
    // control is silent and a meter is empty, so it is both the bottom of
    // every meter scale and the resting value of every meter reading.
    //
    // It was spelled out twenty-six times in markup before it lived here --
    // four times in the two functions below and twenty-two across
    // `meters.slint` and `controls.slint` -- while the two colour thresholds
    // beside it were held to their Rust constants by
    // `gain_slint_agreement.rs`. That test now checks this too.
    //
    // `out` rather than `in`: a meter may legitimately declare a different
    // scale bottom, but it does so by overriding its own `minimum-db`, not by
    // moving the floor for everybody.
    out property <float> min-db: -60.0;

    // The operating level, mirroring mooloop_core::gain::REFERENCE_PEAK_DBFS.
    // A control that hands a full-scale source its headroom starts here.
    in property <float> reference-peak-dbfs: -12.0;

    // The mixer fader taper, (travel, dB) pairs, linear in dB between
    // breakpoints. Unity at three-quarter travel, +6 dB at full throw.
    // Mirrors `mooloop_core::gain::FADER_BREAKPOINTS`, which
    // `gain_slint_agreement.rs` checks these two lists against.
    //
    // **The functions below read these rather than spelling the numbers again.**
    // They used to spell all seven breakpoints inline, which made the agreement
    // test guard a pair of lists the application never read: changing the Rust
    // table would have failed the test, been fixed by editing these lists, and
    // left the taper the faders actually run exactly as it was.
    //
    // `out` so the faders can read the top of the throw from the same place
    // instead of spelling `6.0` a fourth time.
    out property <[float]> fader-travel: [1.0, 0.75, 0.5, 0.3, 0.15, 0.05, 0.0];
    out property <[float]> fader-db: [6.0, 0.0, -12.0, -24.0, -40.0, -60.0, -99999.0];

    // At or below the floor is silence, not residual gain.
    public pure function db-to-linear(db: float) -> float {
        return db <= root.min-db ? 0.0 : pow(10, db / 20);
    }

    public pure function linear-to-db(linear: float) -> float {
        return linear <= 0.0 ? root.min-db : max(20 * log(linear, 10), root.min-db);
    }

    public pure function fader-position-to-db(position: float) -> float {
        if (position <= root.fader-travel[6]) { return root.fader-db[6]; }
        if (position >= root.fader-travel[0]) { return root.fader-db[0]; }
        if (position <= root.fader-travel[5]) { return root.fader-db[5]; }
        if (position <= root.fader-travel[4]) { return between(position, root.fader-travel[4], root.fader-db[4], root.fader-travel[5], root.fader-db[5]); }
        if (position <= root.fader-travel[3]) { return between(position, root.fader-travel[3], root.fader-db[3], root.fader-travel[4], root.fader-db[4]); }
        if (position <= root.fader-travel[2]) { return between(position, root.fader-travel[2], root.fader-db[2], root.fader-travel[3], root.fader-db[3]); }
        if (position <= root.fader-travel[1]) { return between(position, root.fader-travel[1], root.fader-db[1], root.fader-travel[2], root.fader-db[2]); }
        return between(position, root.fader-travel[0], root.fader-db[0], root.fader-travel[1], root.fader-db[1]);
    }

    public pure function fader-db-to-position(db: float) -> float {
        // The bottom breakpoint is Slint's stand-in for -inf, so anything near
        // it is silence. `+ 1.0` keeps the comparison off the sentinel itself,
        // which is what the literal -99998.0 here used to do.
        if (db <= root.fader-db[6] + 1.0) { return root.fader-travel[6]; }
        if (db >= root.fader-db[0]) { return root.fader-travel[0]; }
        if (db <= root.fader-db[5]) { return root.fader-travel[5]; }
        if (db <= root.fader-db[4]) { return inverse(db, root.fader-travel[4], root.fader-db[4], root.fader-travel[5], root.fader-db[5]); }
        if (db <= root.fader-db[3]) { return inverse(db, root.fader-travel[3], root.fader-db[3], root.fader-travel[4], root.fader-db[4]); }
        if (db <= root.fader-db[2]) { return inverse(db, root.fader-travel[2], root.fader-db[2], root.fader-travel[3], root.fader-db[3]); }
        if (db <= root.fader-db[1]) { return inverse(db, root.fader-travel[1], root.fader-db[1], root.fader-travel[2], root.fader-db[2]); }
        return inverse(db, root.fader-travel[0], root.fader-db[0], root.fader-travel[1], root.fader-db[1]);
    }

    // Linear interpolation in dB between a segment's endpoints.
    pure function between(p: float, top-travel: float, top-db: float, bottom-travel: float, bottom-db: float) -> float {
        return bottom-db + (p - bottom-travel) / (top-travel - bottom-travel) * (top-db - bottom-db);
    }

    pure function inverse(db: float, top-travel: float, top-db: float, bottom-travel: float, bottom-db: float) -> float {
        return bottom-travel + (db - bottom-db) / (top-db - bottom-db) * (top-travel - bottom-travel);
    }

    // The one dB readout format: "-inf", "±0.0 dB", "+3.0 dB", "-12.4 dB".
    //
    // Always one decimal place, spelled out by hand because Slint's
    // number-to-string drops a trailing zero: `round(db * 10) / 10` renders
    // 6.0 as "6". So a fader read "+6 dB" at full throw and "-12.4 dB" a
    // nudge below unity -- two conventions on one strip, and a readout that
    // changed width while it was being dragged. "±0.0 dB" had always spelled
    // its tenth out; so does the Rust side, which formats dB with `{:.1}`.
    public pure function format-db(db: float) -> string {
        return GainMath.format-db-value(db) + (db <= -59.95 ? "" : " dB");
    }

    // The same number without its unit, for a readout too narrow to carry one:
    // the master meter's, which sits under a scale already labelled in dB.
    // Sharing it is the point. That readout spelled the number itself, and had
    // drifted to a bare `round(db * 10) / 10` -- so a peak at -12 read "-12"
    // and a peak at -12.4 read "-12.4", and the field, which is right-aligned,
    // changed width as the peak moved.
    public pure function format-db-value(db: float) -> string {
        if (db <= -59.95) { return "-inf"; }
        if (abs(db) < 0.05) { return "±0.0"; }
        return (db > 0 ? "+" : "-") + GainMath.one-decimal(abs(db));
    }

    // A dB number that is *not* a gain: one decimal, its natural sign, and no
    // floor. Thresholds, a knee width, a gate's range and a limiter ceiling
    // all read in dB and none of them is a level, which is why they cannot
    // share `format-db`: a `+` on a knee width is meaningless, and a ceiling
    // parked at full scale reading "±0.0 dB" says something about a signal
    // rather than about a setting. None of the five crosses zero -- the
    // descriptor tables give them -80..0, -60..0, 0..24 and -24..0 -- so the
    // sign here is carried rather than announced, and "0.0" is unsigned.
    //
    // What it is for is the *width*. Six readouts spelled their own
    // `round(x * 10) / 10`, which drops the tenth on a whole value, so a
    // limiter ceiling read "-0.3 dB" at one knob position and "-1 dB" at the
    // next and the field changed width under the pointer. That is the same
    // jitter `format-db` was written to take out of the faders.
    public pure function format-plain-db(db: float) -> string {
        if (abs(db) < 0.05) { return "0.0"; }
        return (db < 0 ? "-" : "") + GainMath.one-decimal(abs(db));
    }

    // A non-negative number to exactly one decimal place. The tenth is
    // rounded first and the whole part taken from it, so a tenth that rounds
    // up carries: 12.96 is "13.0", where taking the two halves separately
    // would read "12.10".
    pure function tenths(v: float) -> float {
        return round(v * 10);
    }

    pure function one-decimal(v: float) -> string {
        return floor(GainMath.tenths(v) / 10) + "." + mod(GainMath.tenths(v), 10);
    }
}
