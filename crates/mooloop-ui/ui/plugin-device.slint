import { Theme } from "theme.slint";
import { IconButton, ParameterKnob, SegmentedControl } from "controls.slint";
import { Icons } from "icons.slint";
import { DevicePageButton, DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";

// One parameter of a hosted plugin, as the face draws it
// (`docs/plans/plugin-hosting/08-the-plugin-face.md`, MOO-83).
//
// `index` is the parameter's position in the plugin's own list, dense from
// zero, and it is the only number that crosses back to Rust: a plugin's id
// can be any `u32`, four billion included, and a Slint `int` cannot carry
// it (`session/src/plugin_params.rs`). Everything here is the plugin's, read
// from the list it reported, so the face declares no range of its own.
export struct PluginParamRow {
    index: int,
    name: string,
    // The plugin's own words for the value, refreshed when it moves.
    text: string,
    // Where it sits in its range, 0..1, and where its default sits.
    value: float,
    default-value: float,
    // Positions for a stepped parameter, 0 for a continuous one.
    steps: int,
    // False while the plugin is not running: a missing plugin's face shows
    // what the song remembers of it and moves nothing.
    enabled: bool,
    // Where the control sits on the face: its page, its row on that page,
    // its first column and how many columns it takes. Rust's
    // (`plugin_ui::pack`), because a selector takes a whole row and every
    // control after it moves (MOO-229). Rows come in the plugin's order, so
    // the last row's page is the last page.
    page: int,
    row: int,
    column: int,
    span: int,
    // A stepped parameter the face draws as a selector: the plugin's own
    // word for each position, and the position it is at. Empty for a knob.
    // The same model from one tick to the next, so an unchanged row stays
    // equal and is not republished (`PluginFaces::options`).
    options: [string],
    position: int,
    // The plugin's group (its CLAP `module` path) as a caption over a run
    // of controls, on the control that starts the run on its row, and how
    // many columns the run covers there. Empty everywhere else.
    caption: string,
    caption-span: int,
}

// One plugin's face as a whole, for a face that is not a row of the chain:
// a channel's plugin instrument (MOO-304, MOO-316). Rust's
// (`PluginFaces::face_row`), the same fields a chain row's `plugin-*` carry.
export struct PluginFaceRow {
    name: string,
    units: int,
    status: string,
    params: [PluginParamRow],
    has-gui: bool,
    gui-open: bool,
}

// The face of a plugin with no GUI of its own: its parameters, in the
// order the plugin lists them, as the knobs every native device uses.
//
// Adam, 2026-09-16: plugins with no GUI need handling, Airwindows being the
// named case, and for those *this face is the device*. A generic plugin has
// nothing to show but its parameters, and it has already chosen their names
// and their order, so the face is a grid of them and nothing more -- two
// rows, a page at a time, with the page buttons only when there is more
// than one page.
//
// This is the face under its header, so the one design serves both places a
// plugin sits: `PluginDeviceFace` puts it in an insert's shell, and the
// source area puts it under a channel's source header, for an instrument.
export component PluginFaceBody inherits Rectangle {
    // Room left at the top for a header this body is drawn under.
    in property <length> header-inset;
    in property <int> units: 2;
    // Why the plugin is not playing -- missing, failed, refused its state --
    // or empty when it is.
    in property <string> status;
    in property <[PluginParamRow]> params;
    // The plugin has a GUI of its own (step 11, MOO-302), and whether it is
    // open. The control that opens it is drawn only when it has one: a
    // plugin without a GUI has this face and nothing else.
    in property <bool> has-gui;
    in property <bool> gui-open;
    // Open the plugin's window, or bring it to the front when it is open.
    callback gui-requested();
    // The modulation overlays are indexed here by a parameter's dense index
    // (`PluginParamRow.index`), never its id, which may not fit an `int`.
    // They stay apart from the rows because the offsets move every tick a
    // modulator does, and a row carries text that would be re-measured with
    // them (MOO-258); Rust writes them in place.
    in property <bool> modulation-armed;
    in property <[float]> modulation-depths;
    in property <[bool]> modulation-allowed;
    in property <[float]> modulation-offsets;
    in property <[int]> modulation-route-counts;
    callback modulation-depth-changed(int, float);
    callback modulation-edit-started(int);
    callback modulation-edit-finished(int);
    callback param-changed(int /* index */, float /* normalized */);

    property <int> columns: root.units <= 1 ? 3 : 6;
    property <int> pages: root.params.length == 0 ? 1 : root.params[root.params.length - 1].page + 1;
    // The face's own view state: which page is showing. Resets when the
    // rack is rebuilt, the way a scroll position would.
    property <int> page: 0;
    property <int> shown-page: min(root.page, root.pages - 1);
    property <length> cell-width: (root.width - 12px) / root.columns;
    // A row of controls: a band for its group caption, then the control.
    // Two fit under the header with the page buttons below them.
    property <length> caption-height: 12px;
    property <length> row-pitch: 96px;

    VerticalLayout {
        padding: 6px;
        padding-top: root.header-inset + 4px;
        spacing: 4px;

        // The badge: why this device is not playing, in the plugin host's
        // own words. A missing plugin keeps its place, its lanes and its
        // saved state, and plays dry until it is installed again.
        if root.status != "" : Rectangle {
            height: 34px;
            border-radius: Theme.radius-sm;
            background: Theme.panel;
            border-width: Theme.hairline;
            border-color: Theme.warning;
            accessible-role: text;
            accessible-label: root.status;
            Text {
                x: 6px;
                width: parent.width - 12px;
                text: root.status;
                color: Theme.warning;
                font-size: Theme.text-md;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        grid := Rectangle {
            vertical-stretch: 1;
            if root.params.length == 0 : Text {
                width: parent.width;
                height: parent.height;
                text: root.status != "" ? "" : "This plugin has no parameters";
                color: Theme.text-faint;
                font-size: Theme.text-md;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // A control off this page is not built at all, rather than built
            // and hidden: a hidden element is a 0x0 clip that FemtoVG
            // tessellates on every frame (MOO-256), and a big plugin has a
            // hundred parameters. Slint takes no `if` as a `for` body, so
            // each parameter gets a bare cell the size of the grid.
            for param in root.params : cell := Rectangle {
                property <bool> shown: param.page == root.shown-page;
                property <length> row-top: param.row * root.row-pitch;
                // The group's caption, over the run of controls it names.
                if cell.shown && param.caption != "" : Rectangle {
                    x: param.column * root.cell-width + 4px;
                    y: cell.row-top;
                    width: param.caption-span * root.cell-width - 8px;
                    height: root.caption-height;
                    Text {
                        x: 0;
                        width: parent.width;
                        text: param.caption;
                        color: Theme.text-faint;
                        font-size: Theme.text-sm;
                        overflow: elide;
                        vertical-alignment: top;
                    }
                    Rectangle {
                        y: parent.height - 2px;
                        height: Theme.hairline;
                        background: Theme.border;
                    }
                }
                if cell.shown && param.options.length == 0 : ParameterKnob {
                    x: param.column * root.cell-width + (root.cell-width - self.width) / 2;
                    y: cell.row-top + root.caption-height;
                    width: min(root.cell-width, 69px);
                    diameter: 36px;
                    label: param.name;
                    tooltip: param.name;
                    value: param.value;
                    default-value: param.default-value;
                    // A stepped parameter lands on its positions and nowhere
                    // between them, as a lane on it does.
                    step: param.steps > 1 ? 1 / (param.steps - 1) : 0;
                    value-text: param.text;
                    enabled: param.enabled;
                    // The plugin's own flags decide, through the same
                    // policy the engine asks (`Session::modulation_policy`).
                    modulation-armed: root.modulation-armed;
                    modulation-allowed: root.modulation-allowed[param.index];
                    modulation-depth: root.modulation-depths[param.index];
                    modulation-offset: root.modulation-offsets[param.index];
                    modulation-route-count: root.modulation-route-counts[param.index];
                    changed(v) => { root.param-changed(param.index, v); }
                    modulation-depth-changed(v) => { root.modulation-depth-changed(param.index, v); }
                    // Also how the knob names itself for a lane or a MIDI
                    // mapping (`ControlRequest`), so it is forwarded even
                    // for a parameter no route may reach.
                    modulation-edit-started => { root.modulation-edit-started(param.index); }
                    modulation-edit-finished => { root.modulation-edit-finished(param.index); }
                }
                // A stepped parameter with a few named positions: a segment
                // for each, labelled with the plugin's own word for it
                // (MOO-229), across a whole row because eight labels do not
                // fit a knob's cell. `plugin_ui::selector_options` decides,
                // and it trusts the names over the count (LSP).
                if cell.shown && param.options.length > 0 : VerticalLayout {
                    x: param.column * root.cell-width + 4px;
                    y: cell.row-top + root.caption-height + 14px;
                    width: param.span * root.cell-width - 8px;
                    height: 48px;
                    spacing: 4px;
                    Text {
                        text: param.name;
                        color: Theme.text-muted;
                        font-size: Theme.text-md;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    SegmentedControl {
                        options: param.options;
                        selected-index: param.position;
                        enabled: param.enabled;
                        hint: param.name;
                        selected(i) => {
                            root.param-changed(param.index, i / max(1, param.options.length - 1));
                        }
                    }
                }
            }
        }

        // The foot: the plugin's own window at the left, when it has one,
        // and the page buttons centred. The spacer on the right matches the
        // window button, so the pages sit centred with it or without it.
        if root.pages > 1 || root.has-gui : HorizontalLayout {
            spacing: 4px;
            if root.has-gui : IconButton {
                size: 22px;
                icon: Icons.open-window;
                active: root.gui-open;
                tooltip: root.gui-open ? "Bring the plugin's window to the front" : "Open the plugin's window";
                hint: "The plugin's own interface, in a window of its own";
                clicked => { root.gui-requested(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.pages > 1 : HorizontalLayout {
                spacing: 4px;
                DevicePageButton {
                    text: "<";
                    tooltip: "Previous parameters";
                    enabled: root.shown-page > 0;
                    clicked => { root.page = max(root.shown-page - 1, 0); }
                }
                Text {
                    text: (root.shown-page + 1) + " / " + root.pages;
                    color: Theme.text-muted;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                }
                DevicePageButton {
                    text: ">";
                    tooltip: "More parameters";
                    enabled: root.shown-page < root.pages - 1;
                    clicked => { root.page = min(root.shown-page + 1, root.pages - 1); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.has-gui : Rectangle { width: 22px; }
        }
    }
}

// A plugin on a chain: its face in an insert's shell, which draws the
// header, takes the reorder drag and carries the modulation overlays.
export component PluginDeviceFace inherits EffectDeviceShell {
    in property <string> plugin-name;
    in property <int> units: 2;
    in property <string> status;
    in property <[PluginParamRow]> params;
    in property <bool> has-gui;
    in property <bool> gui-open;
    callback gui-requested();
    callback param-changed(int /* index */, float /* normalized */);

    name: root.plugin-name;
    kind: "CLAP / " + root.units + "U";

    PluginFaceBody {
        width: parent.width;
        height: parent.height;
        header-inset: DeviceRackMetrics.header-height;
        units: root.units;
        status: root.status;
        params: root.params;
        has-gui: root.has-gui;
        gui-open: root.gui-open;
        modulation-armed: root.modulation-armed;
        modulation-depths: root.modulation-depths;
        modulation-allowed: root.modulation-allowed;
        modulation-offsets: root.modulation-offsets;
        modulation-route-counts: root.modulation-route-counts;
        gui-requested => { root.gui-requested(); }
        param-changed(p, v) => { root.param-changed(p, v); }
        modulation-depth-changed(p, v) => { root.modulation-depth-changed(p, v); }
        modulation-edit-started(p) => { root.modulation-edit-started(p); }
        modulation-edit-finished(p) => { root.modulation-edit-finished(p); }
    }
}
