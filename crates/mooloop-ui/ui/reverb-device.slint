import { Theme } from "theme.slint";
import { ParameterKnob } from "controls.slint";
import { DeviceRackMetrics, EffectDeviceShell } from "device-rack.slint";

// A parameter-derived view of the network's response, not decoration. Time
// runs left to right across the panel:
//
//   Pre      shifts the whole tail right, leaving real silence before it
//   Size     spaces the arrivals, and sets how far the tail reaches
//   Decay    sets the envelope the arrivals fade along
//   Diffuse  fills the gaps between them, so a diffuse hall reads as a wash
//            and a sparse one as discrete echoes
//   Damp     shortens the bright inner stroke faster than the arrival itself,
//            which is exactly what a lowpass in the feedback loop does
//   Mod      displaces the arrivals vertically, the visual analogue of the
//            delay lines drifting against each other
component HallResponse inherits Rectangle {
    in property <float> size;
    in property <float> decay;
    in property <float> damping;
    in property <float> diffusion;
    in property <float> modulation;
    in property <float> predelay;   // normalized, not milliseconds
    in property <string> readout;

    private property <length> plot-left: 8px + root.predelay * 46px;
    private property <length> plot-width: root.width - root.plot-left - 8px;
    // Arrivals are spaced by size but bunch up over time, the way echo
    // density genuinely rises through a room's response.
    private property <float> density: 0.52 + root.diffusion * 0.30;
    private property <float> retention: 0.80 + root.decay * 0.185;

    background: Theme.panel;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    Text {
        x: 5px;
        y: 3px;
        text: "HALL RESPONSE";
        color: Theme.text-faint;
        font-size: 8px;
    }
    Text {
        x: parent.width - self.width - 5px;
        y: 3px;
        text: root.readout;
        color: Theme.accent;
        font-size: 9px;
    }

    // Baseline, and the pre-delay gap before the tail starts.
    Rectangle {
        x: 8px;
        y: parent.height - 15px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.border;
    }
    Rectangle {
        x: 8px;
        y: parent.height - 15px;
        width: root.plot-left - 8px;
        height: 1px;
        background: Theme.focus.with-alpha(0.75);
    }
    Text {
        x: 8px;
        y: parent.height - 12px;
        text: "PRE";
        color: Theme.text-faint;
        font-size: 7px;
    }

    for tap in 28 : Rectangle {
        // pow(<1) spreads the early arrivals and crowds the late ones.
        private property <float> position: pow((tap + 1) / 28, root.density);
        private property <float> level: pow(root.retention, tap * (1.6 - root.size));
        private property <length> arrival-height: max(2px, (parent.height - 26px) * self.level);
        // Every third arrival leans the other way, so the modulation offset
        // reads as lines drifting apart rather than the whole tail sliding.
        private property <length> drift: root.modulation * ((Math.mod(tap, 3) - 1) * 8px);

        x: root.plot-left + self.position * root.plot-width;
        y: parent.height - 16px - self.arrival-height + self.drift;
        width: 2px;
        height: self.arrival-height;
        border-radius: Theme.radius-xs;
        background: Theme.accent.with-alpha(0.30 + 0.55 * self.level);

        // The bright core is the high-frequency content still in that
        // arrival. Damping compounds per bounce, so it shrinks along the
        // tail rather than uniformly.
        Rectangle {
            x: 0px;
            width: parent.width;
            height: parent.height * pow(1 - root.damping * 0.42, tap);
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-xs;
            background: Theme.text.with-alpha(0.62);
        }
    }
}

// One "Reverb" in a channel's device rack: an eight-line feedback delay
// network with a diffused input stage, the spacious counterpart to
// PlateDeviceFace's small dense box. Seven continuous controls, no selectors
// — every one of them is a legal modulation destination, which the previous
// generated-room convolution reverb could not offer at all.
//
// Two different indexing schemes meet on each knob below, and they do not
// agree here the way they do on the other faces. `effect-param-changed` and
// `slot.pN` are keyed by a parameter's *position* in the descriptor table
// (0..7), while the modulation overlays are keyed by its stable *descriptor
// id* (8..15, because this device's original eight ids are retired and must
// never be reused). See REVERB_DESCRIPTORS in mooloop-core.
export component ReverbDeviceFace inherits EffectDeviceShell {
    name: "Reverb";
    kind: "FX / 3U";
    in-out property <float> size;        // normalized 0..1
    in-out property <float> decay;       // normalized 0..1 (0.2 .. 20 s)
    in-out property <float> damping;     // normalized 0..1
    in-out property <float> predelay;    // normalized 0..1 (1 .. 200 ms)
    in-out property <float> diffusion;   // normalized 0..1
    // Named width-value, not width: `width` is the element's own geometry
    // property, same reason PlateDeviceFace names its own that way.
    in-out property <float> width-value; // normalized 0..1
    in-out property <float> modulation;  // normalized 0..1
    in-out property <float> low-cut;     // normalized 0..1 (20 .. 500 Hz)
    callback size-changed(float);
    callback decay-changed(float);
    callback damping-changed(float);
    callback predelay-changed(float);
    callback diffusion-changed(float);
    callback width-changed(float);
    callback modulation-changed(float);
    callback low-cut-changed(float);

    // Normalized -> natural, matching REVERB_DESCRIPTORS in mooloop-core:
    // decay and pre-delay are exponential, the rest linear.
    private property <float> decay-s: 0.2 * pow(100, root.decay);
    private property <float> predelay-ms: pow(200, root.predelay);
    private property <float> low-cut-hz: 20 * pow(25, root.low-cut);

    VerticalLayout {
        padding: 6px;
        padding-top: DeviceRackMetrics.header-height + 6px;
        spacing: 6px;

        HallResponse {
            height: 112px;
            size: root.size;
            decay: root.decay;
            damping: root.damping;
            diffusion: root.diffusion;
            modulation: root.modulation;
            predelay: root.predelay;
            readout: (root.decay-s >= 10
                    ? round(root.decay-s)
                    : round(root.decay-s * 10) / 10) + " s RT60  /  8x FDN";
        }

        HorizontalLayout {
            spacing: 0px;
            alignment: start;
            ParameterKnob {
                width: 81px;
                diameter: 40px;
                label: "Size";
                tooltip: "How far apart the network's reflections sit: small chamber to cathedral";
                value <=> root.size;
                default-value: 0.5;
                value-text: round(root.size * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[8];
                modulation-depth: root.modulation-depths[8];
                modulation-offset: root.modulation-offsets[8];
                modulation-route-count: root.modulation-route-counts[8];
                changed(v) => { root.size-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(8, v); }
                modulation-edit-started => { root.modulation-edit-started(8); }
                modulation-edit-finished => { root.modulation-edit-finished(8); }
            }
            ParameterKnob {
                width: 81px;
                diameter: 40px;
                label: "Decay";
                tooltip: "How long the tail takes to fade";
                value <=> root.decay;
                default-value: 0.5396;
                value-text: root.decay-s >= 10
                    ? round(root.decay-s) + " s"
                    : round(root.decay-s * 10) / 10 + " s";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[9];
                modulation-depth: root.modulation-depths[9];
                modulation-offset: root.modulation-offsets[9];
                modulation-route-count: root.modulation-route-counts[9];
                changed(v) => { root.decay-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(9, v); }
                modulation-edit-started => { root.modulation-edit-started(9); }
                modulation-edit-finished => { root.modulation-edit-finished(9); }
            }
            ParameterKnob {
                width: 81px;
                diameter: 40px;
                label: "Damp";
                tooltip: "High-frequency loss per bounce: open hall to dark room";
                value <=> root.damping;
                default-value: 0.38;
                value-text: round(root.damping * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[10];
                modulation-depth: root.modulation-depths[10];
                modulation-offset: root.modulation-offsets[10];
                modulation-route-count: root.modulation-route-counts[10];
                changed(v) => { root.damping-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(10, v); }
                modulation-edit-started => { root.modulation-edit-started(10); }
                modulation-edit-finished => { root.modulation-edit-finished(10); }
            }
            ParameterKnob {
                width: 81px;
                diameter: 40px;
                label: "Pre";
                tooltip: "Silence before the tail starts, which sets the room's apparent distance";
                value <=> root.predelay;
                default-value: 0.4690;
                value-text: round(root.predelay-ms) + " ms";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[11];
                modulation-depth: root.modulation-depths[11];
                modulation-offset: root.modulation-offsets[11];
                modulation-route-count: root.modulation-route-counts[11];
                changed(v) => { root.predelay-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(11, v); }
                modulation-edit-started => { root.modulation-edit-started(11); }
                modulation-edit-finished => { root.modulation-edit-finished(11); }
            }
            ParameterKnob {
                width: 81px;
                diameter: 40px;
                label: "Diffuse";
                tooltip: "How much the input is smeared before it reaches the network";
                value <=> root.diffusion;
                default-value: 0.72;
                value-text: round(root.diffusion * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[12];
                modulation-depth: root.modulation-depths[12];
                modulation-offset: root.modulation-offsets[12];
                modulation-route-count: root.modulation-route-counts[12];
                changed(v) => { root.diffusion-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(12, v); }
                modulation-edit-started => { root.modulation-edit-started(12); }
                modulation-edit-finished => { root.modulation-edit-finished(12); }
            }
            ParameterKnob {
                width: 81px;
                diameter: 40px;
                label: "Width";
                tooltip: "Stereo spread of the tail";
                value <=> root.width-value;
                default-value: 1.0;
                value-text: round(root.width-value * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[13];
                modulation-depth: root.modulation-depths[13];
                modulation-offset: root.modulation-offsets[13];
                modulation-route-count: root.modulation-route-counts[13];
                changed(v) => { root.width-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(13, v); }
                modulation-edit-started => { root.modulation-edit-started(13); }
                modulation-edit-finished => { root.modulation-edit-finished(13); }
            }
            ParameterKnob {
                width: 81px;
                diameter: 40px;
                label: "Mod";
                tooltip: "Slow drift between the delay lines, which keeps a long tail from ringing";
                value <=> root.modulation;
                default-value: 0.3;
                value-text: round(root.modulation * 100) + "%";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[14];
                modulation-depth: root.modulation-depths[14];
                modulation-offset: root.modulation-offsets[14];
                modulation-route-count: root.modulation-route-counts[14];
                changed(v) => { root.modulation-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(14, v); }
                modulation-edit-started => { root.modulation-edit-started(14); }
                modulation-edit-finished => { root.modulation-edit-finished(14); }
            }
            ParameterKnob {
                width: 81px;
                diameter: 40px;
                label: "Low Cut";
                tooltip: "Highpass on the way in, which keeps a long tail from turning to mud";
                value <=> root.low-cut;
                default-value: 0.2311;
                value-text: round(root.low-cut-hz) + " Hz";
                modulation-armed: root.modulation-armed;
                modulation-allowed: root.modulation-allowed[15];
                modulation-depth: root.modulation-depths[15];
                modulation-offset: root.modulation-offsets[15];
                modulation-route-count: root.modulation-route-counts[15];
                changed(v) => { root.low-cut-changed(v); }
                modulation-depth-changed(v) => { root.modulation-depth-changed(15, v); }
                modulation-edit-started => { root.modulation-edit-started(15); }
                modulation-edit-finished => { root.modulation-edit-finished(15); }
            }
        }
    }
}
