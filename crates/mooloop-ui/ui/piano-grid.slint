import { Theme } from "theme.slint";

// One note event on the piano roll's canvas, as the Rust side publishes it.
// Declared here rather than in `main.slint` because this component owns the
// note canvas and its hit test; `main.slint` imports both structs back.
export struct NoteCell {
    id: int,
    start-tick: int,
    duration-ticks: int,
    note: int,
    velocity: int,
    selected: bool,
}

// Result of asking Rust which note (if any) covers a given tick/MIDI-note
// cell. The search itself lives in Rust because Slint's imperative language
// has no loop or recursion construct that survives its binding-loop checker
// (a self-recursive `pure function` is flagged as a cyclic binding even
// when it terminates), so there is no way to scan a variable-length note
// list from within .slint code.
export struct NoteHit {
    found: bool,
    id: int,
    start-tick: int,
    duration-ticks: int,
}

// One gesture role's modifier requirement, as resolved from the registry in
// `gestures.rs` plus the user's overrides.
//
// Booleans rather than a bitmask because Slint's expression language has no
// bitwise operators: `has-gesture` below tests the requirement by
// implication instead.
export struct GestureMod {
    ctrl: bool,
    shift: bool,
    alt: bool,
    meta: bool,
}

// Every remappable piano-roll drag role.
export struct PianoGestures {
    snap-override: GestureMod,
    add-to-selection: GestureMod,
    subtract-from-selection: GestureMod,
    copy-drag: GestureMod,
}

// The piano roll's note canvas: row shading, grid divisions, the note
// rectangles, and the single hit area that owns every grid gesture.
//
// This lives inside the roll's `ScrollView` viewport. It does not own the
// scroll offsets -- the parent does, because the zoom scrollbars and the
// keyboard gutter read them too -- so panning is requested through `pan()`
// and the current offsets arrive back as `scroll-x`/`scroll-y`.
export component PianoGrid inherits Rectangle {
    in property <int> pattern-length;
    in property <[NoteCell]> notes;
    in property <int> low-note;
    in property <int> high-note;
    in property <int> note-count;
    in property <int> snap-ticks;
    in property <bool> snap-enabled;
    // 0 select, 1 draw, 2 paint, 3 slice, 4 erase.
    in property <int> tool;
    // Zoom is two-way: the wheel handler below writes these, and so do the
    // parent's zoom scrollbars and the View > Zoom actions.
    in-out property <length> step-width;
    in-out property <length> row-height;
    // Full scrollable extent, and the viewport that shows part of it.
    in property <length> content-w;
    in property <length> content-h;
    in property <length> scroll-x;
    in property <length> scroll-y;
    in property <length> visible-w;
    in property <length> visible-h;
    in property <PianoGestures> gestures;
    in property <int> selection-count;
    in property <int> selection-start-tick;
    in property <int> selection-end-tick;
    in property <int> selection-low-note;
    in property <int> selection-high-note;
    in-out property <string> hover-hint;

    pure callback note-hit-test(int, int) -> NoteHit; // tick, MIDI note
    callback gesture-begin();
    callback gesture-end();
    callback note-created(int, int, int) -> int;      // start tick, note, duration -> id
    callback note-selected(int, int);                 // id, 0 replace / 1 add / 2 remove
    callback note-moved(int, int, int);               // id, start tick, note
    callback selection-duplicated(int) -> int;        // anchor id -> copy of anchor
    callback note-resized(int, int);                  // id, duration ticks
    callback note-start-resized(int, int);            // id, start tick (end held)
    callback note-removed(int);                       // id
    callback pan(length, length);                     // requested scroll-x, scroll-y
    callback marquee-begin(int);                      // 0 replace / 1 add / 2 remove
    callback marquee-updated(int, int, int, int);     // start tick, end tick, low note, high note
    callback note-sliced(int, int);                   // id, tick to cut at
    callback selection-joined();
    callback scale-begin(bool);                       // true for the left handle
    callback selection-scaled(float);
    callback cell-painted(int, int, int);             // start tick, note, duration

    x: 0px;
    width: root.pattern-length * root.step-width;
    height: root.note-count * root.row-height;
    background: Theme.surface;


    // Tick/note <-> pixel conversions and note
    // hit-testing, shared by the cursor and the
    // single hit area below. Kept as functions
    // (not per-note state) so a drag never reads
    // geometry that moved out from under it: see
    // piano-touch for why per-note TouchAreas
    // cannot support a drag at all.
    // True when the modifiers currently held satisfy `want`.
    //
    // A subset test, not an exact one: the roles are meant to compose, so
    // holding copy (Ctrl) together with snap-override (Shift) has to do both
    // rather than falling through to neither. Where two roles overlap --
    // add-to-selection is Ctrl and remove-from-selection is Ctrl+Shift --
    // the caller tests the more specific one first.
    //
    // An unbound role wants nothing, and `Not set` therefore has to turn the
    // gesture off rather than matching every drag.
    pure function has-gesture(want: GestureMod, ctrl: bool, shift: bool,
            alt: bool, meta: bool) -> bool {
        if (!want.ctrl && !want.shift && !want.alt && !want.meta) {
            return false;
        }
        return (!want.ctrl || ctrl) && (!want.shift || shift)
            && (!want.alt || alt) && (!want.meta || meta);
    }
    // The selection frame's extent, in canvas pixels. Only meaningful when
    // more than one note is selected -- a single note already has its own
    // edge grabs, and a frame around it would just cover them.
    pure function frame-shown() -> bool {
        return root.selection-count > 1;
    }
    pure function frame-left() -> length {
        return root.note-x(root.selection-start-tick);
    }
    pure function frame-right() -> length {
        return root.note-x(root.selection-end-tick);
    }
    pure function frame-top() -> length {
        return (root.high-note - root.selection-high-note) * root.row-height;
    }
    pure function frame-bottom() -> length {
        return (root.high-note - root.selection-low-note + 1) * root.row-height;
    }
    // 0 none, 1 left handle, 2 right handle. Tested before the note grabs,
    // so a handle sitting over a note's edge still scales rather than
    // resizing that one note.
    pure function scale-handle-at(x: length, y: length) -> int {
        if (!root.frame-shown()) {
            return 0;
        }
        if (y < root.frame-top() || y > root.frame-bottom()) {
            return 0;
        }
        if (abs(x - root.frame-left()) <= 4px) {
            return 1;
        }
        if (abs(x - root.frame-right()) <= 4px) {
            return 2;
        }
        return 0;
    }

    // Lays one note at the pointer's cell, unless that cell is the one the
    // stroke last painted or already holds a note. Called from the press and
    // from every move frame; the dedupe is what makes a slow sweep across
    // one cell produce one note rather than a stack of them.
    function paint-at(x: length, y: length, quantise: bool) {
        let tick = root.tick-at(x);
        let note = root.note-at(y);
        let start = clamp(
            quantise ? floor(tick / root.snap-ticks) * root.snap-ticks : tick,
            0, max(0, root.pattern-length * 24 - root.snap-ticks));
        if (start == piano-touch.painted-tick && note == piano-touch.painted-note) {
            return;
        }
        piano-touch.painted-tick = start;
        piano-touch.painted-note = note;
        if (root.note-hit-test(start, note).found) {
            return;
        }
        root.cell-painted(start, note,
            min(root.snap-ticks, root.pattern-length * 24 - start));
    }

    // Whether this gesture should quantise, given the toggle and whatever
    // the snap-override role is holding.
    //
    // The override inverts rather than only defeating, so it reads the same
    // way in both directions: with snap on it frees the drag, with snap off
    // it snaps just this one. That is the Live/Bitwig convention, and it
    // means the existing Shift-drag habit keeps its old meaning.
    pure function snapping(ctrl: bool, shift: bool, alt: bool, meta: bool) -> bool {
        return root.has-gesture(root.gestures.snap-override, ctrl, shift, alt, meta)
            ? !root.snap-enabled : root.snap-enabled;
    }

    // 0 replace, 1 add, 2 remove. Tested most-specific first, because the
    // roles overlap by design: remove is Ctrl+Shift and add is Shift, so a
    // subset test alone would resolve Ctrl+Shift to whichever was asked
    // about first.
    //
    // Copy-drag counts as "add" even though it is not a selection role. The
    // whole selection is what a copy-drag duplicates, so collapsing the
    // selection onto the pressed note would mean a copy-drag could only ever
    // duplicate one note.
    pure function selection-mode(ctrl: bool, shift: bool, alt: bool, meta: bool) -> int {
        if (root.has-gesture(root.gestures.subtract-from-selection, ctrl, shift, alt, meta)) {
            return 2;
        }
        if (root.has-gesture(root.gestures.add-to-selection, ctrl, shift, alt, meta)
                || root.has-gesture(root.gestures.copy-drag, ctrl, shift, alt, meta)) {
            return 1;
        }
        return 0;
    }
    pure function note-x(start: int) -> length {
        return start * root.step-width / 24;
    }
    pure function note-width(duration: int) -> length {
        return max(root.snap-ticks * root.step-width / 24,
            duration * root.step-width / 24);
    }
    pure function tick-at(x: length) -> int {
        return floor(x * 24 / root.step-width);
    }
    pure function note-at(y: length) -> int {
        return clamp(root.high-note - floor(y / root.row-height),
            root.low-note, root.high-note);
    }
    // 0 = empty grid, 1 = note body (move), 2 = right edge (lengthen),
    // 3 = left edge (move the start, hold the end).
    // The edge zones scale with the note so they stay
    // grabbable on a minimum-width note instead of the
    // fixed 5px that used to eat the whole note. Right wins
    // where the two would overlap on a very short note, since
    // lengthening is much the more common of the pair.
    pure function grab-mode-at(x: length, y: length) -> int {
        let hit = root.note-hit-test(self.tick-at(x), self.note-at(y));
        if (!hit.found) {
            return 0;
        }
        let width = self.note-width(hit.duration-ticks);
        // A fifth rather than a quarter, now that both ends are taken: at a
        // quarter each the body was only half the note, and the body is the
        // part you reach for most.
        let edge = clamp(width / 5, 3px, 7px);
        let left = self.note-x(hit.start-tick);
        if (x >= left + width - edge) {
            return 2;
        }
        if (x <= left + edge) {
            return 3;
        }
        return 1;
    }

    for key in root.note-count : Rectangle {
        y: key * root.row-height;
        height: root.row-height;
        width: parent.width;
        property <int> note-number: root.high-note - key;
        background: (mod(note-number, 12) == 1
            || mod(note-number, 12) == 3
            || mod(note-number, 12) == 6
            || mod(note-number, 12) == 8
            || mod(note-number, 12) == 10)
            ? Theme.surface : Theme.surface-raised;
    }

    for division in root.pattern-length * 24 / root.snap-ticks : Rectangle {
        x: division * root.snap-ticks
            * root.step-width / 24;
        width: 1px;
        height: parent.height;
        background: mod(division * root.snap-ticks, 24) == 0
            ? Theme.text-faint : Theme.border;
        opacity: mod(division * root.snap-ticks, 24) == 0
            ? 0.8 : 0.5;
    }

    for cell in root.notes : Rectangle {
        x: cell.start-tick * root.step-width / 24;
        y: (root.high-note - cell.note) * root.row-height;
        width: max(root.snap-ticks * root.step-width / 24,
            cell.duration-ticks * root.step-width / 24);
        height: root.row-height;
        background: cell.selected ? Theme.focus : Theme.accent;
        opacity: 0.55 + 0.45 * cell.velocity / 127;
        border-width: cell.selected ? 1px : 0px;
        border-color: Theme.text;
    }

    // The selection frame. A multi-selection is one object for the purposes
    // of moving and scaling, so it gets one outline and a grab handle at
    // each time edge rather than the user having to infer its extent from
    // which notes happen to be tinted.
    if root.frame-shown() : Rectangle {
        x: root.frame-left();
        y: root.frame-top();
        width: max(1px, root.frame-right() - root.frame-left());
        height: root.frame-bottom() - root.frame-top();
        background: transparent;
        border-width: 1px;
        border-color: Theme.focus.transparentize(0.4);

        for side in 2 : Rectangle {
            x: side == 0 ? -3px : parent.width - 3px;
            width: 6px;
            height: parent.height;
            background: Theme.focus.transparentize(
                piano-touch.scaling != 0
                    && piano-touch.scaling == (side == 0 ? 1 : 2) ? 0.2 : 0.55);
        }
    }

    // The rubber band. Drawn above the notes and in the same canvas
    // coordinates the gesture measures in, so it does not slide under the
    // pointer as the selection it is building changes underneath.
    if piano-touch.marqueeing
            && (abs(piano-touch.marquee-x - piano-touch.marquee-anchor-x) > 3px
                || abs(piano-touch.marquee-y - piano-touch.marquee-anchor-y) > 3px)
        : Rectangle {
        x: min(piano-touch.marquee-anchor-x, piano-touch.marquee-x);
        y: min(piano-touch.marquee-anchor-y, piano-touch.marquee-y);
        width: abs(piano-touch.marquee-x - piano-touch.marquee-anchor-x);
        height: abs(piano-touch.marquee-y - piano-touch.marquee-anchor-y);
        background: Theme.focus.transparentize(0.85);
        border-width: 1px;
        border-color: Theme.focus;
    }

    // ONE hit area for the whole note grid, exactly
    // like the rack's grid-touch. A TouchArea living
    // inside a per-note Rectangle whose x/width is
    // bound to that note's own tick/duration moves out
    // from under the cursor as soon as the drag updates
    // the model, so mouse-x re-measures against the
    // moved rectangle and the delta collapses to zero
    // after one snap step. Hit-testing from here instead,
    // in this Rectangle's stable coordinates, means the
    // origin never moves during a drag.
    piano-touch := TouchArea {
        property <int> grabbed-id: -1;
        property <int> grab-mode: 0; // 0 none, 1 move, 2 resize
        property <length> origin-x;
        property <length> origin-y;
        property <int> original-start;
        property <int> original-note;
        property <int> original-duration;
        // A Ctrl-drag duplicates once, at the
        // first move rather than on press:
        // Ctrl-click still has to be able to
        // mean "toggle selection".
        property <bool> copied;
        property <bool> create-click-armed;
        property <length> create-click-x;
        property <length> create-click-y;
        property <int> create-click-start;
        property <int> create-click-note;
        property <int> create-click-duration;
        // A sweep that deletes whatever it crosses: the erase tool, and a
        // right-drag in every other tool.
        property <bool> erasing;
        // Paint lays one note per newly-crossed cell. The last cell is
        // remembered so re-crossing it does nothing rather than stacking
        // duplicates on top of each other.
        property <bool> painting;
        property <int> painted-tick: -1;
        property <int> painted-note: -1;
        // Rubber-band selection, in canvas coordinates so the band does not
        // move under the pointer while the model changes beneath it.
        // 0 none, 1 dragging the left handle, 2 the right one. The anchor
        // is the opposite edge, held still.
        property <int> scaling;
        property <length> scale-anchor-x;
        // Where the grabbed edge started. Cached, because the frame follows
        // the model and reading it live would divide by a span the previous
        // frame already scaled -- the factor would compound instead of
        // measuring against the original.
        property <length> scale-origin-x;
        property <bool> marqueeing;
        property <length> marquee-anchor-x;
        property <length> marquee-anchor-y;
        property <length> marquee-x;
        property <length> marquee-y;
        create-click-timeout := Timer {
            interval: 350ms;
            running: false;
            triggered => {
                self.running = false;
                piano-touch.create-click-armed = false;
            }
        }
        // One binding, not one per cursor arm: `grab-mode-at` calls into
        // Rust, and the cursor used to pay for that twice on every pointer
        // move. A binding re-evaluates once when `mouse-x`/`mouse-y` change
        // and caches until they do.
        property <int> hover-mode: root.scale-handle-at(self.mouse-x, self.mouse-y) != 0
            ? 2 : root.grab-mode-at(self.mouse-x, self.mouse-y);
        mouse-cursor: self.hover-mode == 2 || self.hover-mode == 3 ? ew-resize
            : self.hover-mode == 1 ? move
            : crosshair;

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                // Opened before anything is edited, so the note a
                // double-click creates belongs to the same gesture as the
                // length drag that immediately follows it.
                root.gesture-begin();
                // `pressed` is a left-button notion, so a right-drag sweep
                // cannot lean on it and these flags are the only record that
                // a gesture is in flight. Clear them here as well as on
                // release, so a press whose matching release never arrived
                // cannot leave a sweep armed.
                self.erasing = false;
                self.painting = false;
                self.marqueeing = false;
                self.scaling = 0;
                let tick = root.tick-at(self.mouse-x);
                let note = root.note-at(self.mouse-y);
                let hit = root.note-hit-test(tick, note);
                let quantise = root.snapping(e.modifiers.control,
                    e.modifiers.shift, e.modifiers.alt, e.modifiers.meta);
                let handle = e.button == PointerEventButton.left
                    ? root.scale-handle-at(self.mouse-x, self.mouse-y) : 0;
                if (handle != 0) {
                    // Claimed before the tools and before the note grabs: a
                    // handle sits on top of whatever note is at the
                    // selection's edge, and that note's own resize would
                    // otherwise win and there would be no way to scale.
                    self.create-click-armed = false;
                    create-click-timeout.running = false;
                    self.scaling = handle;
                    self.scale-anchor-x = handle == 1
                        ? root.frame-right() : root.frame-left();
                    self.scale-origin-x = handle == 1
                        ? root.frame-left() : root.frame-right();
                    root.scale-begin(handle == 1);
                } else if (e.button == PointerEventButton.right || root.tool == 4) {
                    // A right-drag erases whatever it crosses, in every
                    // tool. Sweeping is the only reason erase needs a mode
                    // of its own; a single delete never did.
                    self.create-click-armed = false;
                    create-click-timeout.running = false;
                    self.erasing = true;
                    if (hit.found) {
                        root.note-removed(hit.id);
                    }
                } else if (e.button != PointerEventButton.left) {
                    // Middle button and the rest stay unclaimed.
                } else if (root.tool == 3) {
                    // Slice, or join when the add-to-selection role is held:
                    // one tool for "make this two notes" and its inverse.
                    self.create-click-armed = false;
                    create-click-timeout.running = false;
                    if (root.has-gesture(root.gestures.add-to-selection,
                            e.modifiers.control, e.modifiers.shift,
                            e.modifiers.alt, e.modifiers.meta)) {
                        root.selection-joined();
                    } else if (hit.found) {
                        let cut = quantise
                            ? round(tick / root.snap-ticks) * root.snap-ticks
                            : tick;
                        // A cut at either end would produce a zero-length
                        // half, which is a delete the user did not ask for.
                        if (cut > hit.start-tick
                                && cut < hit.start-tick + hit.duration-ticks) {
                            root.note-sliced(hit.id, cut);
                        }
                    }
                } else if (root.tool == 2) {
                    self.create-click-armed = false;
                    create-click-timeout.running = false;
                    self.painting = true;
                    self.painted-tick = -1;
                    self.painted-note = -1;
                    root.paint-at(self.mouse-x, self.mouse-y, quantise);
                } else if (hit.found) {
                    // Pressing an existing note moves or resizes it in every
                    // tool except erase and slice, which claimed the press
                    // above. Draw and paint would otherwise have no way to
                    // adjust what they just laid down.
                    self.create-click-armed = false;
                    create-click-timeout.running = false;
                    root.note-selected(hit.id, root.selection-mode(
                        e.modifiers.control, e.modifiers.shift,
                        e.modifiers.alt, e.modifiers.meta));
                    self.grabbed-id = hit.id;
                    self.copied = false;
                    self.grab-mode = root.grab-mode-at(self.mouse-x, self.mouse-y);
                    self.origin-x = self.mouse-x;
                    self.origin-y = self.mouse-y;
                    self.original-start = hit.start-tick;
                    self.original-note = note;
                    self.original-duration = hit.duration-ticks;
                } else {
                    let start-tick = clamp(
                        quantise
                            ? floor(tick / root.snap-ticks) * root.snap-ticks
                            : tick,
                        0, max(0, root.pattern-length * 24
                            - root.snap-ticks));
                    let duration = min(root.snap-ticks,
                        root.pattern-length * 24 - start-tick);
                    // Draw creates on the first click. Select needs a second
                    // one, so that a press on empty grid is free to start a
                    // marquee instead.
                    let draw-now = root.tool == 1
                        || (self.create-click-armed
                            && abs(self.mouse-x - self.create-click-x) <= 6px
                            && abs(self.mouse-y - self.create-click-y) <= 6px
                            && self.create-click-start == start-tick
                            && self.create-click-note == note);
                    if (draw-now) {
                        let id = root.note-created(start-tick, note, duration);
                        self.grabbed-id = id;
                        self.copied = false;
                        self.grab-mode = 2;
                        self.origin-x = self.mouse-x;
                        self.origin-y = self.mouse-y;
                        self.original-start = start-tick;
                        self.original-note = note;
                        self.original-duration = duration;
                        self.create-click-armed = false;
                        create-click-timeout.running = false;
                    } else {
                        self.create-click-armed = true;
                        self.create-click-x = self.mouse-x;
                        self.create-click-y = self.mouse-y;
                        self.create-click-start = start-tick;
                        self.create-click-note = note;
                        self.create-click-duration = duration;
                        create-click-timeout.running = true;
                        // The marquee only commits once the pointer travels;
                        // a click that turns out to be the first half of a
                        // double-click must not clear the selection.
                        self.marqueeing = true;
                        self.marquee-anchor-x = self.mouse-x;
                        self.marquee-anchor-y = self.mouse-y;
                        self.marquee-x = self.mouse-x;
                        self.marquee-y = self.mouse-y;
                    }
                }
            } else if (e.kind == PointerEventKind.move && self.scaling != 0) {
                let span = self.mouse-x - self.scale-anchor-x;
                let original = self.scale-origin-x - self.scale-anchor-x;
                // A zero-width original has no factor to speak of, and a
                // handle dragged through its anchor would flip the selection
                // inside out rather than scaling it.
                if (abs(original) > 0.5px && span / original > 0.02) {
                    root.selection-scaled(span / original);
                }
            } else if (e.kind == PointerEventKind.move && self.erasing) {
                let hit = root.note-hit-test(root.tick-at(self.mouse-x),
                    root.note-at(self.mouse-y));
                if (hit.found) {
                    root.note-removed(hit.id);
                }
            } else if (e.kind == PointerEventKind.move && self.painting) {
                root.paint-at(self.mouse-x, self.mouse-y,
                    root.snapping(e.modifiers.control, e.modifiers.shift,
                        e.modifiers.alt, e.modifiers.meta));
            } else if (e.kind == PointerEventKind.move && self.marqueeing) {
                self.marquee-x = self.mouse-x;
                self.marquee-y = self.mouse-y;
                // The band has to travel before it means anything: a press
                // that becomes the second half of a double-click would
                // otherwise clear the selection on its way to creating a
                // note.
                if (abs(self.marquee-x - self.marquee-anchor-x) > 3px
                        || abs(self.marquee-y - self.marquee-anchor-y) > 3px) {
                    if (self.create-click-armed) {
                        self.create-click-armed = false;
                        create-click-timeout.running = false;
                        root.marquee-begin(root.selection-mode(
                            e.modifiers.control, e.modifiers.shift,
                            e.modifiers.alt, e.modifiers.meta));
                    }
                    // Overlap, not containment: a marquee that clipped a
                    // long note's tail should still catch it, which is what
                    // every other editor does.
                    root.marquee-updated(
                        root.tick-at(min(self.marquee-anchor-x, self.marquee-x)),
                        root.tick-at(max(self.marquee-anchor-x, self.marquee-x)),
                        root.note-at(max(self.marquee-anchor-y, self.marquee-y)),
                        root.note-at(min(self.marquee-anchor-y, self.marquee-y)));
                }
            } else if (e.kind == PointerEventKind.move
                    && self.pressed && self.grabbed-id >= 0) {
                // A free drag leaves the grid on both axes' time component,
                // matching the automation lane.
                let free = !root.snapping(e.modifiers.control, e.modifiers.shift,
                    e.modifiers.alt, e.modifiers.meta);
                let raw-ticks = (self.mouse-x - self.origin-x)
                    * 24 / root.step-width;
                let delta-ticks = free
                    ? round(raw-ticks)
                    : round(raw-ticks / root.snap-ticks)
                        * root.snap-ticks;
                if (self.grab-mode == 2) {
                    let max-duration = max(root.snap-ticks,
                        root.pattern-length * 24 - self.original-start);
                    let duration = clamp(
                        self.original-duration + delta-ticks,
                        free
                            ? 1
                            : min(root.snap-ticks, max-duration),
                        max-duration);
                    root.note-resized(self.grabbed-id, duration);
                } else if (self.grab-mode == 3) {
                    // The end tick is what stays put, so the start can only
                    // travel as far as leaving a note behind.
                    let floor-length = free ? 1 : min(root.snap-ticks,
                        self.original-duration);
                    let start = clamp(self.original-start + delta-ticks,
                        0, self.original-start + self.original-duration - floor-length);
                    root.note-start-resized(self.grabbed-id, start);
                } else {
                    if (root.has-gesture(root.gestures.copy-drag,
                            e.modifiers.control, e.modifiers.shift,
                            e.modifiers.alt, e.modifiers.meta)
                            && !self.copied) {
                        self.copied = true;
                        let copy = root.selection-duplicated(
                            self.grabbed-id);
                        if (copy >= 0) {
                            self.grabbed-id = copy;
                        }
                    }
                    let tick = clamp(self.original-start + delta-ticks,
                        0, max(0, root.pattern-length * 24 - self.original-duration));
                    let note = clamp(self.original-note
                            + round((self.origin-y - self.mouse-y)
                                / root.row-height),
                        root.low-note, root.high-note);
                    root.note-moved(self.grabbed-id, tick, note);
                }
            } else if (e.kind == PointerEventKind.up) {
                self.grabbed-id = -1;
                self.grab-mode = 0;
                self.copied = false;
                self.erasing = false;
                self.painting = false;
                self.marqueeing = false;
                self.scaling = 0;
                root.gesture-end();
            }
        }
        // Ctrl+wheel zooms pitch under the pointer.
        // Add Shift to zoom time instead. Ordinary wheel
        // input is left to ScrollView for panning.
        scroll-event(e) => {
            if (e.modifiers.control && e.delta-y != 0px) {
                let factor = e.delta-y < 0px ? 1.15 : 0.87;
                if (e.modifiers.shift) {
                    let old-width = root.step-width;
                    let next-width = clamp(old-width * factor, 20px, 72px);
                    let content-x = self.mouse-x - root.scroll-x;
                    root.step-width = next-width;
                    root.pan(clamp(
                        self.mouse-x - content-x * next-width / old-width,
                        min(0px, root.visible-w - root.content-w),
                        0px), root.scroll-y);
                } else {
                    let old-height = root.row-height;
                    let next-height = clamp(old-height * factor, 5px, 16px);
                    let content-y = self.mouse-y - root.scroll-y;
                    root.row-height = next-height;
                    root.pan(root.scroll-x, clamp(
                        self.mouse-y - content-y * next-height / old-height,
                        min(0px, root.visible-h - root.content-h),
                        0px));
                }
                accept
            } else { reject }
        }
        // A Tooltip here would hover-linger for as long as
        // the piano roll is in use, since this one TouchArea
        // covers the whole note canvas. Use the status bar
        // instead, which clears the moment the pointer moves
        // to something else.
        changed has-hover => {
            root.hover-hint = self.has-hover
                ? "Drag moves the selection. Ctrl+drag copies, Shift+drag defeats snap. Ctrl+wheel zooms pitch, Ctrl+Shift+wheel zooms time."
                : root.hover-hint == "Drag moves the selection. Ctrl+drag copies, Shift+drag defeats snap. Ctrl+wheel zooms pitch, Ctrl+Shift+wheel zooms time."
                    ? "" : root.hover-hint;
        }
    }
}
