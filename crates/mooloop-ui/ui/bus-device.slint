import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ConsoleButton, MixerFader, MiniKnob, MuteButton, ParameterFader, PickerChip, SectionLabel, SoloButton, ToolButton } from "controls.slint";
import { NameField } from "toolbar.slint";
import { GainMath } from "gain.slint";
import { ChannelMeter } from "meters.slint";
import { DeviceHeader, DeviceRackMetrics } from "device-rack.slint";
// `send-feed-count` below is the *incoming* count, which is why this
// face still knows the word: the sends it once edited are the
// outgoing ones, and they live in the channel sidebar now.
import { BusPicker } from "mixer.slint";
import { StripRow, StripSections } from "strip.slint";

// The track's channel strip as a row in its own device rack.
//
// Adam, 2026-09-10, asking for the strip's processing to be reachable from
// the rack: *"own row, pinned, but we should be able to just move the pin or
// morph what is drawn."* Where the row sits is
// `mooloop_core::mixer::STRIP_PIN` -- the same statement the engine's block
// loop reads, so the drawing and the audio agree by construction rather than
// by anyone remembering.
//
// **It has no rails.** Every other row draws an insert menu on one side and
// a remove on the other; this one can be neither inserted nor removed, so
// offering the affordances would be offering gestures that do nothing. That
// absence is what says "pinned" without a word for it.
export component StripRackRow inherits Rectangle {
    in property <StripRow> strip;
    /// Which track this row belongs to, for the lamps `StripMeters`
    /// publishes.
    in property <int> track: -1;
    in property <string> name;
    in property <bool> muted;
    callback moved(int, float);
    callback switched(int, bool);
    callback voicing-picked(int);
    callback point-dragged(int, float, float);

    // **Two units.** It was three while the EQ carried a response plot over
    // its band rows and the two right-hand panels split the slack between
    // them; with the plot moved under DRIVE the three columns add up to
    // 150 + 118 + what is left, and the third unit was empty margin either
    // side of two small knob clusters. Adam: *"there's a ton of space
    // between the start of the rack area and the first device in a chain.
    // i feel like we could come up with a more compact layout."* This is
    // 220px of that, and the bus face beside it is the rest.
    width: DeviceRackMetrics.unit-width * 2 + DeviceRackMetrics.half-gap;
    height: DeviceRackMetrics.face-height;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;

    StripSections {
        x: 8px;
        y: DeviceRackMetrics.header-height + 8px;
        width: parent.width - 16px;
        height: parent.height - DeviceRackMetrics.header-height - 16px;
        strip: root.strip;
        track: root.track;
        wide: true;
        moved(id, value) => { root.moved(id, value); }
        switched(id, on) => { root.switched(id, on); }
        voicing-picked(index) => { root.voicing-picked(index); }
        point-dragged(band, hz, gain) => { root.point-dragged(band, hz, gain); }
    }

    DeviceHeader {
        x: 0px;
        y: 0px;
        width: parent.width;
        name: root.name + " strip";
        kind: "STRIP / 2U";
        role: "STRIP";
        device-color: Theme.accent;
        enabled: !root.muted;
    }
}

// The head of a bus's device chain, standing where a channel's source face
// stands. A bus has no generator, so what occupies that position is the thing
// a bus actually is: an output stage and a destination.
export component BusDeviceFace inherits Rectangle {
    in property <string> name;
    in property <bool> is-master;
    in property <bool> muted;
    in property <float> volume;
    in property <float> pan;
    in property <int> output;
    in property <int> index;
    in property <int> feed-count;
    // Sends reaching this track. Counted apart from `feed-count` because
    // being fed by channels and being fed by sends are different facts -- the
    // second is what makes a track a return, and a track can be both.
    in property <int> send-feed-count;
    in property <[string]> bus-names;
    in property <[bool]> allowed;
    in property <bool> console;
    in property <bool> polarity;
    in property <bool> solo;
    in property <bool> can-remove: true;
    // Which tracks this one may send to. The same mask the output picker
    // uses, because a send and an output are legal under the same rule.
    in property <[bool]> send-allowed;
    callback renamed(string);
    callback removed();
    callback output-picked(int);
    callback console-toggled();
    callback polarity-toggled();

    VerticalLayout {
        padding: 8px;
        padding-top: DeviceRackMetrics.header-height + 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;

            Rectangle {
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                horizontal-stretch: 1;
                // Takes the whole face now. It used to give its slack to the
                // sends area below, and with the sends in the sidebar there
                // is nothing under it -- a panel that kept its old
                // `vertical-stretch: 0` left the bottom half of this face as
                // empty bordered space, which `UI_DESIGN.md` calls a defect
                // rather than a style.
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        height: 18px;
                        SectionLabel {
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            text: "ROUTING";
                        }
                        // Polarity stays at the head while the fader moved to
                        // the tail, and the difference is not cosmetic: it is
                        // applied at the **top** of the track's block, so
                        // everything after it sees the flipped signal --
                        // including a pre-fader send. It is an input control
                        // and this is the input end.
                        ToolButton {
                            text: "\u{00f8}";
                            tooltip: root.polarity ? "Inverted" : "Normal";
                            hint: "Invert this track's polarity. It acts on the way in, so "
                                + "everything after it -- including a pre-fader send -- is flipped.";
                            active: root.polarity;
                            min-width: 20px;
                            max-width: 20px;
                            min-height: 18px;
                            max-height: 18px;
                            clicked => { root.polarity-toggled(); }
                        }
                    }
                    Text {
                        text: (root.feed-count == 0 && root.send-feed-count == 0)
                                ? "Nothing feeds this track yet"
                            : root.feed-count == 0
                                ? (root.send-feed-count == 1
                                    ? "1 send feeds this track" : root.send-feed-count + " sends feed this track")
                            : root.send-feed-count == 0
                                ? (root.feed-count == 1
                                    ? "1 channel feeds this track" : root.feed-count + " channels feed this track")
                            : root.feed-count + (root.feed-count == 1 ? " channel and " : " channels and ")
                                + root.send-feed-count + (root.send-feed-count == 1 ? " send" : " sends")
                                + " feed this track";
                        color: (root.feed-count == 0 && root.send-feed-count == 0)
                            ? Theme.text-faint : Theme.text-muted;
                        font-size: 9px;
                        wrap: word-wrap;
                    }
                    // The master is the end of the chain, so it offers no
                    // destination rather than a disabled-looking one.
                    if !root.is-master : HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        // "Output", not "Sends to": a send is a specific
                        // thing now and this is not one. A track's output is
                        // where all of it goes; a send is a copy of some of
                        // it, and the two must not wear one word.
                        Text {
                            text: "Output";
                            color: Theme.text-muted;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                        BusPicker {
                            bus-names: root.bus-names;
                            value: root.output;
                            allowed: root.allowed;
                            tooltip: "Track this one's output feeds";
                            picked(i) => { root.output-picked(i); }
                        }
                        Text {
                            text: root.bus-names[root.output];
                            color: Theme.text;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                        // The same control the mixer strip carries, in the
                        // same place relative to the destination: how this
                        // bus reaches the next one belongs beside which one
                        // that is.
                        ConsoleButton {
                            on: root.console;
                            tooltip: "Analog sum";
                            hint: "Sum this bus into its destination through the analog summing "
                                + "curve, together with everything else feeding it that has this on.";
                            toggled(v) => { root.console-toggled(); }
                        }
                        Text {
                            text: root.console ? "analog sum" : "linear";
                            color: root.console ? Theme.accent : Theme.text-faint;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                    }
                    // Rename and remove live here rather than on the mixer
                    // strip: this is where a track's chain is edited, there is
                    // room for a field, and the strip stays compact. The name
                    // has always saved and loaded and nothing could set it --
                    // the gap `LOOSE_ENDS.md` had been carrying.
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: "Name";
                            color: Theme.text-muted;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                        NameField {
                            text: root.name;
                            placeholder: "Track";
                            tooltip: "Rename this track";
                            edited(value) => { root.renamed(value); }
                        }
                        if !root.is-master : ToolButton {
                            text: "Remove";
                            tooltip: "Remove this track";
                            hint: "Remove this track. Anything routed to it falls back to the master.";
                            enabled: root.can-remove;
                            clicked => { root.removed(); }
                        }
                    }
                    if root.is-master : Text {
                        text: "Feeds the audio outputs";
                        color: Theme.text-muted;
                        font-size: 9px;
                    }
                    if root.is-master : Rectangle { vertical-stretch: 1; }
                }
            }

            }
        }
    }

    DeviceHeader {
        x: 0px;
        y: 0px;
        width: parent.width;
        name: root.name;
        kind: "BUS / 2U";
        role: "BUS";
        device-color: root.is-master ? Theme.warning : Theme.accent;
        enabled: !root.muted;
    }
}

/// A track's output stage, as the **last** row of its rack.
///
/// **This used to be drawn first, and the engine has always run it last.**
/// `StripPin`'s own doc states the order -- `pre -> eq -> comp -> devices ->
/// fader` -- and the fader sat in the head face because that face occupies the
/// seat a channel's *generator* has, which is the start of a channel's signal
/// path and the wrong place for a track's output. Adam, 2026-09-13: *"why is
/// the fader at the beginning? it seems like the fx should be inserts between
/// the strip section and the fader section so the fader would be at the end."*
/// Nothing sounded wrong; the picture was.
///
/// Polarity deliberately stays behind on the head face. It is applied at the
/// **top** of the track's block -- everything downstream sees the flipped
/// signal, including a pre-fader send -- so it is an input control and drawing
/// it here would make the same mistake in the other direction.
export component BusFaderRow inherits Rectangle {
    in property <string> name;
    in property <bool> is-master;
    in property <float> volume: 1.0;
    in property <float> pan;
    in property <bool> muted;
    in property <bool> solo;
    in property <float> left-db: GainMath.min-db;
    in property <float> right-db: GainMath.min-db;
    /// Peak hold and the clip latch, from the same `MeterReading` the mixer
    /// strip reads. They were absent until 2026-09-14, so this row drew a
    /// clip lamp that could not light and a peak marker pinned to the level
    /// -- one track with two faces whose meters behaved differently, with the
    /// data in hand and thrown away.
    in property <float> held-left-db: GainMath.min-db;
    in property <float> held-right-db: GainMath.min-db;
    in property <bool> clipping;
    callback clip-reset();
    callback volume-changed(float);
    callback pan-changed(float);
    callback mute-toggled();
    callback solo-toggled();

    // One unit, where the strip beside it takes two: this is a fader, a pan
    // and three buttons, and the rack is short of width at the head already.
    width: DeviceRackMetrics.unit-width;
    height: DeviceRackMetrics.face-height;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;

    VerticalLayout {
        x: 8px;
        y: DeviceRackMetrics.header-height + 8px;
        width: parent.width - 16px;
        height: parent.height - DeviceRackMetrics.header-height - 16px;
        spacing: 4px;

        // The vertical order is the mixer strip's own -- pan over solo, mute
        // -- so the two faces read the same way round.
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            MiniKnob {
                label: "Pan";
                value: root.pan;
                minimum: -1;
                maximum: 1;
                default-value: 0;
                bipolar: true;
                value-text: abs(root.pan) < 0.01 ? "Center"
                    : root.pan < 0 ? "L " + round(abs(root.pan) * 100)
                    : "R " + round(root.pan * 100);
                changed(v) => { root.pan-changed(v); }
            }
            MuteButton {
                muted: root.muted;
                clicked => { root.mute-toggled(); }
            }
            if !root.is-master : SoloButton {
                soloed: root.solo;
                clicked => { root.solo-toggled(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 1;
            alignment: center;
            ChannelMeter {
                width: 22px;
                segments: 16;
                left-db: root.left-db;
                right-db: root.right-db;
                held-left-db: root.held-left-db;
                held-right-db: root.held-right-db;
                clipping: root.clipping;
                clip-reset => { root.clip-reset(); }
            }
            MixerFader {
                width: 30px;
                value: root.volume;
                maximum: GainMath.db-to-linear(GainMath.fader-db[0]);
                default-value: 1.0;
                tooltip: root.name + " level";
                value-text: GainMath.format-db(GainMath.linear-to-db(root.volume));
                changed(v) => { root.volume-changed(v); }
            }
        }
    }

    DeviceHeader {
        x: 0px;
        y: 0px;
        width: parent.width;
        name: "Fader";
        kind: "OUT / 1U";
        role: "OUT";
        device-color: root.is-master ? Theme.warning : Theme.accent;
        enabled: !root.muted;
    }
}
