// The channel rack's shared vocabulary.
//
// `device-rack.slint` is the same thing for the device rack, and this file
// exists for the same two reasons: the rack's drag state has to be reachable
// from two places that do not contain each other, and a test harness has to
// be able to import it without pulling in the whole of `main.slint`.

import { Theme } from "theme.slint";
import { ToolButton } from "controls.slint";
import { MenuRow } from "menubar.slint";

// Live state of a channel-rack reorder.
//
// The third global of this shape, and deliberately the same shape:
// `RackDrag` reorders devices along a row and this reorders channels down a
// column, so it is `RackDrag` with `y` where the `x` is. The two halves sit
// in different places for the same reason -- the **grab** is the name plate,
// which knows which channel it is and nothing about the rack's geometry, and
// the **landing** is worked out by whichever row the pointer is over, which
// knows its own bounds and nothing about the grab.
//
// `absolute-position.y + mouse-y`, never `mouse-y - pressed-y`. That lesson
// is recorded twice already, in `RackDrag.dx` and in `PaneDrag`: a touch
// area's `mouse-y` is measured against a ruler the previous frame already
// slid, so the difference reports each move's increment instead of the
// travel, and the face twitches and stays put.
export global ChannelDrag {
    // Channel index being dragged, or -1.
    in-out property <int> source: -1;
    // Channel index the pointer is currently over. Set by the row itself
    // from its own bounds, so a row that is taller than its neighbours still
    // counts as its own height.
    in-out property <int> target: -1;
    // Pointer travel since the grab, applied to the dragged row's contents.
    in-out property <length> dy: 0px;
    // Where the grab started and where the pointer is now, both in window
    // coordinates -- the frame every row's `absolute-position` is in.
    in-out property <length> grab-y: 0px;
    in-out property <length> pointer-y: 0px;
    // Full pitch of the dragged row, which is the size of the gap the rows
    // between the grab and the landing open up. Published by the row itself
    // rather than assumed, for the reason `RackDrag.source-width` gives.
    in-out property <length> source-height: 0px;
    in-out property <bool> active: false;

    public function end() {
        active = false;
        source = -1;
        target = -1;
        dy = 0px;
    }
}

// The source devices a channel can run, in the order the interface offers
// them -- which is the order `device_kind_to_int` encodes and
// `root.source-kind` dispatches on, so a label's position in this list *is*
// its kind's number.
//
// One list because there are two places that offer a source, and for four
// devices they disagreed: the rack's add-channel menu still offered the four
// kinds that existed when it was written, so a channel could be switched to
// the ML-M1, the ML-P8, the DS-01 or Aux In but never started as one. Both
// read this now, and `tests/source_kind_menu.rs` holds it against
// `DeviceKind::label()` -- the guard a list spelled in markup had never had.
export global SourceKinds {
    out property <[string]> labels: [
        "Sampler", "Drum Synth", "Mono Synth", "Poly Synth",
        "ML-M1", "ML-P8", "DS-01", "Aux In"
    ];
    // The sources no longer offered, by the same positions. A new channel
    // cannot start as one and a channel cannot be switched to one; a song
    // that already uses one loads and plays as it did, and its channel's
    // picker still names it. The Mono Synth and Poly Synth, retired
    // 2026-09-22 -- Adam: the ML-M1 and ML-P8 do everything they did.
    // `tests/source_kind_menu.rs` holds this to `RETIRED_SOURCE_KINDS`.
    out property <[bool]> retired: [
        false, false, true, true,
        false, false, false, false
    ];
}

// The rack's `+`: the button that offers every source device, and reports
// the one chosen as its position in `SourceKinds.labels`.
//
// It lives here rather than inline in `main.slint` for the second reason
// this file exists. A menu row is only correct if clicking it *arrives*, and
// the only way to know that is a real pointer event on the real markup;
// `tests/add_source_menu.rs` imports this and clicks it, which it could not
// do to a popup nested twelve levels inside `MainWindow`. The list it was
// held to before was spelled right the whole time the menu did nothing.
export component AddSourceButton inherits ToolButton {
    // The chosen row's position in `SourceKinds.labels` -- the number
    // `device_kind_from_int` decodes on the Rust side.
    callback picked(int);

    text: "+";
    tooltip: "Add channel";
    min-width: 28px;
    max-width: 28px;
    min-height: 24px;
    max-height: 24px;
    clicked => { menu.show(); }

    menu := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: 156px;
        // As tall as the rows it has. The 108px it held was four of them, so
        // a fifth source would have been drawn outside the menu it was in.
        height: frame.preferred-height;
        close-policy: close-on-click;
        frame := Rectangle {
            background: Theme.surface;
            border-width: Theme.hairline;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            VerticalLayout {
                padding: 4px;
                // `MenuRow`, not `ToolButton`: this is a menu, and the rest
                // of the interface's menus read down a left edge. Eight
                // centred captions of different widths had no edge to read
                // down at all.
                //
                // A retired source is an empty layout rather than a row:
                // this layout has no spacing, so it takes no room, and each
                // row still reports its position in `SourceKinds.labels`.
                for label[i] in SourceKinds.labels : VerticalLayout {
                    if !SourceKinds.retired[i] : MenuRow {
                        text: "Add " + label;
                        // Report, and let `close-policy` dismiss the menu.
                        //
                        // Closing it here first is the whole of MOO-53:
                        // closing a popup tears down the repeater item whose
                        // handler is still running, so the call after it
                        // never lands. The menu opened, drew all eight
                        // sources, and added no channel. This is the fourth
                        // time that sequence has been found -- `BusPicker`,
                        // `DeviceFrame`'s preset menu, `PickerChip`'s
                        // `MenuField`, and here -- and
                        // `scripts/dupe-audit popup-close-order` now looks
                        // for the fifth.
                        selected => { root.picked(i); }
                    }
                }
            }
        }
    }
}
