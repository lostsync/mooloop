// The song patch canvas (docs/plans/song-patch/03-the-canvas.md).
//
// Everything here is drawn from what Rust lays out (`patch_canvas.rs`):
// node places, jack places and each wire's path. Nothing is hit tested in
// Slint. One TouchArea covers the canvas and reports press, move and release
// in canvas units, the way the piano roll's grid does, because a touch area
// on each box would move out from under the pointer as its box is dragged.
import { ScrollView } from "std-widgets.slint";
import { Theme, DisplayPrefs } from "theme.slint";
import { MiniKnob } from "controls.slint";

// A box, a tag, or a route's assignment tag.
export struct PatchNodeRow {
    x: length,
    y: length,
    width: length,
    height: length,
    is-box: bool,
    // A box's text, in the mono face: `lfo`, `* -0.5`.
    spelling: string,
    // A box whose name this build does not know: it keeps its text and
    // does nothing, and its edge says so (Slint draws no dashes).
    unknown: bool,
    // A tag's pieces: `gate  Kick 1`, or `Cutoff  ML-M1 9  +40%`.
    kind: string,
    name: string,
    depth: string,
    // A tag points right when its outlet is at its point (a source), left
    // when its inlet is (a sink, an assignment).
    points-right: bool,
    note: bool,
    // Bound to nothing: the `[ ]` slot shows what it expects.
    unbound: bool,
    // What it was bound to when its patch preset was saved, shown dim in
    // the empty slot: `[ Kick · gate ]` (song patch step 09).
    hint: string,
    // The box or tag it draws, -1 for an assignment tag.
    node-id: int,
    // A notes-out tag that just refused a note (song patch step 07): its
    // link held all it can, or its channel's list was full.
    refused: bool,
    selected: bool,
    // Armed for the assignment gesture.
    armed: bool,
    // A box's face is open under its spelling (song patch step 05); its
    // knobs are `PatchView.knobs`. `empty-face` is an open box with none.
    open: bool,
    empty-face: bool,
}

// One knob on an open box's face, at the top-left of its cell. `value` and
// `default-value` are 0..1 along the setting's range; `steps` is how many
// detents a stepped setting has, 0 for a continuous one.
export struct PatchKnobRow {
    x: length,
    y: length,
    module: int,
    param: int,
    label: string,
    value-text: string,
    value: float,
    default-value: float,
    steps: int,
    // Whether the armed source may be routed here: not a stepped setting,
    // and not the box's own outlet.
    allowed: bool,
    offset: float,
    routes: int,
    // The armed source's depth onto this knob.
    depth: float,
}

// One jack, at the point its wire meets.
export struct PatchJackRow {
    x: length,
    y: length,
    note: bool,
    outlet: bool,
    // A tag's jack is a dot at its point; a box's is a bar on its edge.
    dot: bool,
    name: string,
    // The name shows above an inlet, below an outlet; `right` ends it at the
    // jack, for a box's last inlet, so a box's names spread outward.
    named: bool,
    right: bool,
    // A loose wire is over this inlet, and the song would take it (`hot`)
    // or would not (`refused`).
    hot: bool,
    refused: bool,
}

export struct PatchWireRow {
    // SVG path commands in canvas units, corners rounded.
    d: string,
    note: bool,
    selected: bool,
    // It reads its outlet a tick late, marked at its inlet end.
    delayed: bool,
    mark-x: length,
    mark-y: length,
    // Cable activity (step 05): the node the wire leaves, `-1` for none;
    // a control wire's level, `0..1`; how many pump ticks a note wire stays
    // thick for a note just sent, and the NoteOn count it last saw.
    source: int,
    level: float,
    flash: int,
    seen: int,
}

// One name the box being typed could be, as the completion list shows it.
export struct PatchWordRow {
    name: string,
    says: string,
}

export global PatchView {
    in property <[PatchNodeRow]> nodes;
    in property <[PatchJackRow]> jacks;
    in property <[PatchWireRow]> wires;
    in property <length> canvas-width: 1200px;
    in property <length> canvas-height: 600px;
    in property <bool> empty: true;
    // The wire being drawn, to the pointer; empty when none is.
    in property <string> loose-wire;
    in property <bool> loose-refused;
    in property <bool> marquee;
    in property <length> marquee-x;
    in property <length> marquee-y;
    in property <length> marquee-width;
    in property <length> marquee-height;
    // The canvas's one menu: what can feed the inlet that was clicked, what
    // an inlet tag reads, or which tag to make where the canvas was
    // right-clicked.
    in property <bool> menu-open;
    in property <string> menu-title;
    in property <[string]> menu-options;
    in property <int> menu-current: -1;
    in property <length> menu-x;
    in property <length> menu-y;
    // (x, y, shift) in canvas units.
    callback pressed(length, length, bool);
    callback moved(length, length);
    callback released(length, length);
    // A key while the canvas has the focus; true when the canvas used it.
    callback key(string) -> bool;
    callback picked(int);
    callback menu-closed();
    // A right-click at (x, y) in canvas units.
    callback context(length, length);
    // Typing a box (song patch step 04): a field at (typing-x, typing-y),
    // and below it the names that start with what is typed.
    in property <bool> typing;
    in property <length> typing-x;
    in property <length> typing-y;
    in-out property <string> typing-text;
    in property <[PatchWordRow]> words;
    in property <int> word-active;
    // A double-click on the canvas at (x, y): on empty canvas it types a new
    // box, on a box it retypes that box.
    callback double-clicked(length, length);
    callback typing-edited(string);
    // Up, Down, Tab or Escape in the field; true when the canvas used it.
    callback typing-key(string) -> bool;
    callback typing-accepted(string);
    callback word-picked(int);
    // Open faces (song patch step 05): every knob on show, and whether a
    // source is armed, which makes a drag on a knob set its depth.
    in property <[PatchKnobRow]> knobs;
    in property <bool> assigning;
    // (module, param, value 0..1)
    callback knob-changed(int, int, float);
    callback knob-depth-started();
    callback knob-depth-changed(int, int, float);
    callback knob-depth-finished();
}

global PatchColors {
    out property <color> box: #33333a;
    out property <color> edge: #5a5a65;
    out property <color> wire: #6f6f7a;
    out property <color> armed-fill: #84cc1633;
}

component PatchTag inherits Rectangle {
    in property <PatchNodeRow> node;
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        fill: root.node.armed ? PatchColors.armed-fill : PatchColors.box;
        stroke: root.node.selected || root.node.armed ? Theme.accent
            : root.node.refused ? Theme.destructive
            : root.node.unbound ? Theme.text-faint : PatchColors.edge;
        stroke-width: root.node.selected ? 2px : 1px;
        commands: root.node.points-right
            ? "M 0.5 0.5 L \{root.width / 1px - 13} 0.5 L \{root.width / 1px - 0.5} \{root.height / 2px} L \{root.width / 1px - 13} \{root.height / 1px - 0.5} L 0.5 \{root.height / 1px - 0.5} Z"
            : "M 13 0.5 L \{root.width / 1px - 0.5} 0.5 L \{root.width / 1px - 0.5} \{root.height / 1px - 0.5} L 13 \{root.height / 1px - 0.5} L 0.5 \{root.height / 2px} Z";
    }
    HorizontalLayout {
        padding-left: root.node.points-right ? 10px : 22px;
        padding-right: root.node.points-right ? 22px : 10px;
        spacing: 7px;
        alignment: start;
        // A source reads kind then name (`gate  Kick 1`), an assignment
        // name then device (`Cutoff  ML-M1 9`).
        if root.node.points-right : Text {
            text: root.node.kind;
            color: root.node.note ? Theme.warning : Theme.text-muted;
            font-size: Theme.text-xl;
            vertical-alignment: center;
        }
        if root.node.name != "" : Text {
            text: root.node.name;
            color: Theme.text;
            font-size: Theme.text-2xl;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.node.unbound : Rectangle {
            y: (parent.height - 16px) / 2;
            width: root.node.hint == "" ? 26px : hint-text.preferred-width + 12px;
            height: 16px;
            border-width: 1px;
            border-color: Theme.text-faint;
            border-radius: Theme.radius-sm;
            hint-text := Text {
                text: root.node.hint;
                color: Theme.text-faint;
                font-size: Theme.text-xl;
                font-italic: true;
            }
        }
        if !root.node.points-right && root.node.kind != "" : Text {
            text: root.node.kind;
            color: root.node.note ? Theme.warning : Theme.text-muted;
            font-size: Theme.text-xl;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.node.depth != "" : Rectangle {
            y: (parent.height - 15px) / 2;
            height: 15px;
            width: depth-text.preferred-width + 8px;
            background: PatchColors.armed-fill;
            border-radius: Theme.radius-sm;
            depth-text := Text {
                text: root.node.depth;
                color: Theme.accent;
                font-family: Theme.font-family-mono;
                font-size: Theme.text-lg;
            }
        }
    }
}

export component PatchCanvas inherits Rectangle {
    background: Theme.panel;
    border-width: Theme.hairline;
    border-color: Theme.border;
    clip: true;

    view := ScrollView {
        width: parent.width;
        height: parent.height;
        content-width: PatchView.canvas-width;
        content-height: PatchView.canvas-height;

        world := Rectangle {
            width: PatchView.canvas-width;
            height: PatchView.canvas-height;

            for wire in PatchView.wires : Path {
                x: 0;
                y: 0;
                width: world.width;
                height: world.height;
                viewbox-width: world.width / 1px;
                viewbox-height: world.height / 1px;
                commands: wire.d;
                fill: transparent;
                // Cable activity: a control wire tints toward the accent with
                // its level, a note wire thickens for a note; Subtle is 30 %
                // of Full, Off draws plain wires.
                property <float> amount: DisplayPrefs.cable-activity == 2 ? 1.0
                    : DisplayPrefs.cable-activity == 1 ? 0.3 : 0.0;
                stroke: wire.selected ? Theme.accent
                    : wire.note ? Theme.warning.transparentize(0.35)
                    : Theme.accent.mix(PatchColors.wire, clamp(wire.level, 0, 1) * self.amount);
                stroke-width: wire.selected ? 2.5px
                    : wire.note && wire.flash > 0 ? 1.5px + 3px * self.amount
                    : 1.5px;
            }
            // A wire that reads a tick late carries a short bar across it
            // just above its inlet.
            for wire in PatchView.wires : Rectangle {
                if wire.delayed : Rectangle {
                    x: wire.mark-x - 5px;
                    y: wire.mark-y - 10px;
                    width: 10px;
                    height: 2px;
                    background: Theme.warning;
                }
            }
            if PatchView.loose-wire != "" : Path {
                x: 0;
                y: 0;
                width: world.width;
                height: world.height;
                viewbox-width: world.width / 1px;
                viewbox-height: world.height / 1px;
                commands: PatchView.loose-wire;
                fill: transparent;
                stroke: PatchView.loose-refused ? Theme.destructive : Theme.accent;
                stroke-width: 1.5px;
            }

            for node in PatchView.nodes : Rectangle {
                x: node.x;
                y: node.y;
                width: node.width;
                height: node.height;
                if node.is-box : Rectangle {
                    background: PatchColors.box;
                    border-width: node.selected || node.armed ? 2px : Theme.hairline;
                    border-color: node.selected || node.armed ? Theme.accent
                        : node.unknown ? Theme.destructive : PatchColors.edge;
                    border-radius: Theme.radius-md;
                    Text {
                        x: 12px;
                        y: 0;
                        width: parent.width - 16px - 18px;
                        height: 28px;
                        text: node.spelling;
                        font-family: Theme.font-family-mono;
                        font-size: Theme.text-2xl;
                        color: node.unknown ? Theme.text-muted : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // The fold arrow, which opens the face; the canvas's
                    // pointer finds it (`patch_canvas.rs`, `Hit::Fold`).
                    Text {
                        x: parent.width - 20px;
                        y: 0;
                        width: 18px;
                        height: 28px;
                        text: node.open ? "\u{25be}" : "\u{25b8}";
                        color: Theme.text-muted;
                        font-size: Theme.text-xl;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if node.open : Rectangle {
                        x: 1px;
                        y: 28px;
                        width: parent.width - 2px;
                        height: 1px;
                        background: PatchColors.edge;
                    }
                    if node.empty-face : Text {
                        x: 12px;
                        y: 28px;
                        width: parent.width - 16px;
                        height: 22px;
                        text: "No settings";
                        color: Theme.text-faint;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                    }
                }
                if !node.is-box : PatchTag {
                    width: node.width;
                    height: node.height;
                    node: node;
                }
            }

            for jack in PatchView.jacks : Rectangle {
                x: jack.x;
                y: jack.y;
                width: 0;
                height: 0;
                property <color> fill: jack.hot ? Theme.accent : jack.refused ? Theme.destructive
                    : jack.note ? Theme.warning : Theme.text-faint;
                if jack.dot : Rectangle {
                    x: -4.5px;
                    y: -4.5px;
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: parent.fill;
                }
                if !jack.dot : Rectangle {
                    x: -6px;
                    y: jack.outlet ? -3px : -1px;
                    width: 12px;
                    height: 4px;
                    background: parent.fill;
                }
                if jack.named : Text {
                    x: jack.right ? 8px - self.width : -8px;
                    y: jack.outlet ? 4px : -15px;
                    width: 90px;
                    horizontal-alignment: jack.right ? right : left;
                    text: jack.name;
                    font-family: Theme.font-family-mono;
                    font-size: Theme.text-xs;
                    color: jack.refused ? Theme.destructive : Theme.accent;
                }
            }

            if PatchView.marquee : Rectangle {
                x: PatchView.marquee-x;
                y: PatchView.marquee-y;
                width: PatchView.marquee-width;
                height: PatchView.marquee-height;
                background: Theme.focus.transparentize(0.85);
                border-width: Theme.hairline;
                border-color: Theme.focus;
            }

            focus := FocusScope {
                key-pressed(event) => {
                    if PatchView.key(event.text) {
                        return accept;
                    }
                    return reject;
                }
            }

            touch := TouchArea {
                // Named so a test can find where the canvas is on screen.
                accessible-role: groupbox;
                accessible-label: "Patch canvas";
                mouse-cursor: default;
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        focus.focus();
                        PatchView.context(self.mouse-x, self.mouse-y);
                        return;
                    }
                    if event.button != PointerEventButton.left {
                        return;
                    }
                    if event.kind == PointerEventKind.down {
                        focus.focus();
                        PatchView.pressed(self.mouse-x, self.mouse-y, event.modifiers.shift);
                    } else if event.kind == PointerEventKind.up {
                        PatchView.released(self.mouse-x, self.mouse-y);
                    }
                }
                moved => {
                    PatchView.moved(self.mouse-x, self.mouse-y);
                }
                double-clicked => {
                    PatchView.double-clicked(self.mouse-x, self.mouse-y);
                }
            }

            // The knobs of every open face, over the canvas's pointer so they
            // take their own drags. A drag sets the setting, or, with a
            // source armed, that source's depth onto it.
            for knob in PatchView.knobs : Rectangle {
                x: knob.x;
                y: knob.y;
                width: 46px;
                height: 52px;
                Text {
                    y: 3px;
                    width: parent.width;
                    height: 10px;
                    text: knob.label;
                    color: Theme.text-faint;
                    font-size: Theme.text-xs;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                MiniKnob {
                    x: (parent.width - self.width) / 2;
                    y: 15px;
                    diameter: 22px;
                    label: knob.label;
                    hint: knob.label + " " + knob.value-text;
                    value-text: knob.value-text;
                    value: knob.value;
                    default-value: knob.default-value;
                    step: knob.steps > 0 ? 1 / knob.steps : 0;
                    travel: knob.steps > 0 ? max(40px, min(150px, knob.steps * 12px)) : 150px;
                    modulation-armed: PatchView.assigning;
                    modulation-allowed: knob.allowed;
                    modulation-depth: knob.depth;
                    modulation-offset: knob.offset;
                    modulation-route-count: knob.routes;
                    changed(value) => { PatchView.knob-changed(knob.module, knob.param, value); }
                    modulation-edit-started => { PatchView.knob-depth-started(); }
                    modulation-depth-changed(depth) => { PatchView.knob-depth-changed(knob.module, knob.param, depth); }
                    modulation-edit-finished => { PatchView.knob-depth-finished(); }
                }
                Text {
                    y: 39px;
                    width: parent.width;
                    height: 11px;
                    text: knob.value-text;
                    color: Theme.text-muted;
                    font-family: Theme.font-family-mono;
                    font-size: Theme.text-xs;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            // The box being typed: a field where the double-click was (or
            // over the box being retyped), and the names it could be.
            if PatchView.typing : Rectangle {
                x: min(PatchView.typing-x, world.width - 260px);
                y: PatchView.typing-y;
                width: 260px;
                height: typing-list.preferred-height;
                TouchArea { }
                typing-list := VerticalLayout {
                    spacing: 4px;
                    Rectangle {
                        height: 28px;
                        width: 180px;
                        background: PatchColors.box;
                        border-width: 1px;
                        border-color: Theme.accent;
                        border-radius: Theme.radius-md;
                        typing-keys := FocusScope {
                            x: 10px;
                            width: parent.width - 16px;
                            height: parent.height;
                            capture-key-pressed(event) => {
                                // Escape is the field's own: it leaves.
                                if event.text != Key.Escape && PatchView.typing-key(event.text) {
                                    // Tab may have completed the name: type on
                                    // after it, not where the cursor was.
                                    typing-input.set-selection-offsets(
                                        typing-input.text.character-count,
                                        typing-input.text.character-count);
                                    return accept;
                                }
                                return reject;
                            }
                            typing-input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> PatchView.typing-text;
                                font-family: Theme.font-family-mono;
                                font-size: Theme.text-2xl;
                                color: Theme.text;
                                vertical-alignment: center;
                                single-line: true;
                                accessible-role: text-input;
                                accessible-label: "Box";
                                init => {
                                    self.focus();
                                    self.set-selection-offsets(0, self.text.character-count);
                                }
                                edited => {
                                    PatchView.typing-edited(self.text);
                                }
                                accepted => {
                                    PatchView.typing-accepted(self.text);
                                }
                                // Escape makes nothing and gives the keys back
                                // to the canvas, so Space plays again.
                                key-pressed(event) => {
                                    if event.text == Key.Escape {
                                        PatchView.typing-key(event.text);
                                        self.clear-focus();
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                    }
                    if PatchView.words.length > 0 : Rectangle {
                        background: Theme.surface-raised;
                        border-width: Theme.hairline;
                        border-color: PatchColors.edge;
                        border-radius: Theme.radius-lg;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000060;
                        height: word-list.preferred-height;
                        word-list := VerticalLayout {
                            padding: 4px;
                            spacing: 1px;
                            for word[index] in PatchView.words : Rectangle {
                                height: 20px;
                                border-radius: Theme.radius-sm;
                                background: index == PatchView.word-active || word-touch.has-hover
                                    ? Theme.surface-active : transparent;
                                Text {
                                    x: 6px;
                                    width: 56px;
                                    height: parent.height;
                                    text: word.name;
                                    color: Theme.text;
                                    font-family: Theme.font-family-mono;
                                    font-size: Theme.text-lg;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: 66px;
                                    width: parent.width - 72px;
                                    height: parent.height;
                                    text: word.says;
                                    color: Theme.text-muted;
                                    font-size: Theme.text-md;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                word-touch := TouchArea {
                                    clicked => { PatchView.word-picked(index); }
                                }
                            }
                        }
                    }
                }
            }

            // The menu, over the canvas where it was opened. Its rows take
            // their own clicks; a press anywhere else on the canvas closes it.
            if PatchView.menu-open : Rectangle {
                x: min(PatchView.menu-x, world.width - self.width - 4px);
                y: max(4px, PatchView.menu-y - self.height - 6px);
                width: 190px;
                height: menu-list.preferred-height;
                background: Theme.surface-raised;
                border-width: Theme.hairline;
                border-color: PatchColors.edge;
                border-radius: Theme.radius-lg;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000060;
                TouchArea { }
                menu-list := VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    Text {
                        height: 16px;
                        text: PatchView.menu-title;
                        color: Theme.text-muted;
                        font-family: Theme.font-family-mono;
                        font-size: Theme.text-xs;
                        vertical-alignment: center;
                    }
                    for option[index] in PatchView.menu-options : Rectangle {
                        height: 20px;
                        border-radius: Theme.radius-sm;
                        background: row-touch.has-hover ? Theme.surface-active : transparent;
                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: option;
                            color: index == PatchView.menu-current ? Theme.accent : Theme.text;
                            font-size: Theme.text-lg;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        row-touch := TouchArea {
                            clicked => { PatchView.picked(index); }
                        }
                    }
                }
            }
        }
    }

    if PatchView.empty : Text {
        width: root.width;
        height: root.height;
        text: "No boxes yet. Double-click to type one: lfo, counter 4, * -0.5. Right-click for a song inlet.";
        color: Theme.text-muted;
        font-size: Theme.text-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
